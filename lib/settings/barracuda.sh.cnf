###----------------------------------------###
### VALKEY LISTEN MODE                      ###
###----------------------------------------###
###
### By default this option is set to SOCKET
### to improve caching backend performance.
###
### If set to PORT (old default) Valkey will
### listen on standard port and 127.0.0.1 IP.
###
### When set to any other IP address, it will
### switch ALL your Ægir Satellite Instances
### along with your Ægir Master Instance from
### local Valkey server to the remote Valkey
### server you have installed in your network.
### It will also permanently disable your
### local Valkey server. Make sure to specify
### correct IP when using this mode and also
### modify /etc/csf/csf.conf to allow outgoing
### TCP connections via port 6379.
###
_VALKEY_LISTEN_MODE=SOCKET


###----------------------------------------###
### VALKEY MAJOR RELEASE                    ###
###----------------------------------------###
###
### Supported values: 9, 8, 7
###
_VALKEY_MAJOR_RELEASE=9


###----------------------------------------###
### REDIS LISTEN MODE                      ###
###----------------------------------------###
###
### By default this option is set to SOCKET
### to improve caching backend performance.
###
### If set to PORT (old default) Redis will
### listen on standard port and 127.0.0.1 IP.
###
### When set to any other IP address, it will
### switch ALL your Ægir Satellite Instances
### along with your Ægir Master Instance from
### local Redis server to the remote Redis
### server you have installed in your network.
### It will also permanently disable your
### local Redis server. Make sure to specify
### correct IP when using this mode and also
### modify /etc/csf/csf.conf to allow outgoing
### TCP connections via port 6379.
###
_REDIS_LISTEN_MODE=SOCKET


###----------------------------------------###
### REDIS MAJOR RELEASE                    ###
###----------------------------------------###
###
### Supported values: 5, 6 or 7
###
_REDIS_MAJOR_RELEASE=7


###----------------------------------------###
### SSH CUSTOM PORT                        ###
###----------------------------------------###
###
### Change this if you want to use non-default
### port for SSH and SFTP connections.
###
### Changing the port will alter also your
### server firewall (csf) settings, both on
### install and upgrade, unless you are using
### _CUSTOM_CONFIG_CSF=YES option.
###
_SSH_PORT=22


###----------------------------------------###
### LOCAL DEVUAN or DEBIAN MIRROR          ###
###----------------------------------------###
###
### Modify this if you prefer to use some
### mirror you know is the best / the fastest
### in your server location. For example:
###
### _LOCAL_DEVUAN_MIRROR=http://devuan.keff.org
### _LOCAL_DEBIAN_MIRROR=http://ftp.au.debian.org
###
### Note that your custom mirror address MUST
### include the protocol it supports, http/https
###
### To search for the fastest mirror around
### the globe, use empty variables:
###
### _LOCAL_DEVUAN_MIRROR=""
### _LOCAL_DEBIAN_MIRROR=""
###
### Note that searching around the globe is
### no longer enabled by default!
###
### Note also that it may hang and later cause
### broken upgrades if some tested mirror
### responds with unexpected delay instead of
### just respond or not, so it is better
### to use reliable mirrors you know,
### or leave default values.
###
_LOCAL_DEVUAN_MIRROR=""
_LOCAL_DEBIAN_MIRROR=""


###----------------------------------------###
### FORCE PREFERRED GIT REPOSITORY         ###
###----------------------------------------###
###
### Use this when you are experiencing issues
### trying to connect to the default github
### repository. Valid options:
###
### _FORCE_GIT_MIRROR=github
### _FORCE_GIT_MIRROR=gitlab
###
### Note: with forced mirror the script will
### not try to connect and then switch to
### alternate mirror. It will simply fail
### if the forced mirror doesn't respond.
###
### We recommend github - it is much faster.
###
_FORCE_GIT_MIRROR=""


###----------------------------------------###
### DNS MANUAL CONFIG                      ###
###----------------------------------------###
###
### Starting with release 0.4-alpha9 Ægir
### requires proper DNS configuration
### of your server. Your hostname has to be
### FQDN and has to match your server IP.
###
### This script is trying to discover your
### DNS details and allow or deny the install,
### if something doesn't look right.
###
### This script will also use your FQDN
### hostname as a web address of your Ægir
### frontend (control panel) by default.
###
### You may want to change the automatic
### defaults by setting up your IP address,
### your FQDN hostname and your Ægir frontend
### web address below - it is recommended!
###
### It may be useful when you are using local
### environment with custom settings in your
### /etc/hosts, when you have more than one
### public IPs on eth0 and you wish to use
### non-default (first) IP address, or when
### you want to use non-hostname (sub)domain
### to access your Ægir frontend.
###
### It is also useful when you plan to use
### available in Barracuda optional installs,
### since they will use subdomains in the
### server hostname and it will not work
### when your hostname domain DNS is not
### under your control (like many default
### hostnames and reverse DNS provided by
### VPS hosting companies).
###
### Please change *all 3 values* if you wish
### to customize this automatic setup.
###
### Example:
###
### _MY_OWNIP=192.168.0.108
### _MY_HOSTN=server.mydomain.com
### _MY_FRONT=aegir.mydomain.com
###
### NOTE:
###
### If you will use your custom DNS settings,
### they will be still validated, therefore
### make sure your _MY_HOSTN and _MY_FRONT
### both matches your _MY_OWNIP or the script
### will fail to install Ægir (unless you
### will disable the DNS test completely
### below in _DNS_SETUP_TEST).
###
_MY_OWNIP=""
_MY_HOSTN=""
_MY_FRONT=""


###----------------------------------------###
### DNS SETUP TEST                         ###
###----------------------------------------###
###
### If you don't want to test your DNS
### because of some custom local setup
### you know is correct (like DynDNS)
### but the script can't validate it with its
### standard remote tests, set this to:
###
### _DNS_SETUP_TEST=NO
###
### There is no guarantee it will work.
###
_DNS_SETUP_TEST=YES


###----------------------------------------###
### DATABASE DEFAULT HOST                  ###
###----------------------------------------###
###
### If you prefer, you can set the database
### to be connected via FQDN pointing to your
### public IP instead of default "localhost",
### but it will make it harder to migrate
### sites with DB grants tied to the system
### unique hostname.
###
### Note: the "FQDN" is a keyword. It will be
### automatically replaced with your system
### real hostname when used.
###
### NOTE: This distinction is very important,
### because if you will specify your system
### local hostname literally, BOA will use
### the "Remote DB Server Mode" instead, as
### explained further below.
###
### For local or Amazon based installs with
### local/dynamic IP address it is recommended
### to use default "localhost" option.
###
### Supported options:
###
### _THIS_DB_HOST=localhost
### _THIS_DB_HOST=FQDN
###
_THIS_DB_HOST=localhost


###----------------------------------------###
### REMOTE DB SERVER MODE                  ###
###----------------------------------------###
###
### WARNING !!!
###
### THIS IS **HIGHLY EXPERIMENTAL** FEATURE.
### EXPECT YOUR SYSTEM TO *EXPLODE* IF USED.
###
### Note: We may refer to the DB server
###       also by using term 'DB head'
###
### If you will specify some remote DB server
### name (not IP) or even local hostname, but
### literally instead of via 'localhost' or
### 'FQDN' keyword, it will turn on and use
### the special REMOTE DB SERVER MODE.
###
### This mode will work only if the remote DB
### server has been already configured with
### the same default dummy mysql root password
### as your Ægir system you are about to
### install, and if the mysql port 3306 is
### already open for incoming and outgoing
### TCP connections on all servers expected
### to communicate in this mode.
###
### HINT: you may want to add WEB head (Ægir)
### IP as allowed on the DB head with standard
### command: 'csf -a 12.34.56.789 my web head'
###
### Note that if the remote DB server defined
### as hostname with a valid DNS entry will be
### used, BOA will never change mysql root
### password and also on initial install will
### use this dummy password:
###
###   sCWL4tgEpyS5cLZITshxSTWRjhsUOeR6
###
### The same password will be used for the
### Ægir special DB user 'aegir_root'.
###
### Furthermore, BOA will not create separate
### special DB users per Octopus instance
### and all instances will use the same
### 'aegir_root' DB user to manage databases
### for hosted sites.
###
### You can later change this password for
### both mysql 'root' and 'aegir_root' users
### on the remote DB server, but you will
### have to manually update them in every
### Ægir instance (Master and Satellites)
### db server node settings.
###
### However, BOA will always check and use
### the password it will find in the standard
### file /root/.my.cnf during Master
### and Satellite instances upgrade.
###
### If you will change the mysql root password
### you **must** update it also in two files:
###
###   /root/.my.pass.txt
###   /root/.my.cnf
###
### When installing BOA on a machine expected
### to work as a remote DB server, you should
### create a special file containing your
### WEB head (Ægir) hostname:
###
###  /root/.remote.web.head.txt
###
### BOA will use this file to add required
### DB GRANT for 'aegir_root' on the DB head
### so the WEB head (Ægir) hosted on the
### machine with hostname specified in this
### file will be able to manage databases
### remotely. Make sure that this file
### is present only on the DB head, though.
###
### WARNING !!!
###
### Make sure that there is no remote, public,
### unrestricted access via port 3306 to any
### DB server used in this special mode!
###
### Available non-default option:
###
### _THIS_DB_HOST=remote.db.server.name
###
_THIS_DB_HOST=localhost


###----------------------------------------###
### SMTP CONNECTION TEST                   ###
###----------------------------------------###
###
### If you don't want to test outgoing SMTP
### connections, change _SMTP_RELAY_TEST
### value to "NO".
###
_SMTP_RELAY_TEST=YES


###----------------------------------------###
### SMTP RELAY HOST - ONLY WHEN REQUIRED   ###
###----------------------------------------###
###
### _SMTP_RELAY_HOST="smtp.your.relay.net"
###
_SMTP_RELAY_HOST=""


###----------------------------------------###
### LOCALHOST ON LOCAL NETWORK             ###
###----------------------------------------###
###
### When enabled, it will force your Nginx web
### server to listen only on local IP with
### local, non-FQDN hostname, for example:
###
### _LOCAL_NETWORK_IP=10.10.80.80
### _LOCAL_NETWORK_HN=aegir.local
###
### In this example "aegir.local" will be used
### as your hostname and all connections and
### grants will use "aegir.local" instead of
### FQDN. Also your Ægir Master Instance
### will be available at http://aegir.local
###
### This option is useful when your server is
### available only in your local network
### without any public IP address assigned/
### available on any eth interface. This also
### means it should work as a handy local
### setup on your wirelessly connected laptop
### or netbook, with improved DNS cache
### support - unbound will save results in file.
###
### In this case you could use 127.0.1.1 as
### _LOCAL_NETWORK_IP to avoid issues with
### DHCP changing your assigned IP on the fly
### and to avoid conflicts with some other
### services listening on 127.0.0.1
###
### This option works only with initial
### install and is disabled on upgrade.
###
### When used, it will override all defined
### above _MY_OWNIP, _MY_HOSTN and _MY_FRONT
### values.
###
### It will also disable all DNS and SMTP
### relay tests automatically.
###
_LOCAL_NETWORK_IP=""
_LOCAL_NETWORK_HN=""


###----------------------------------------###
### ADVANCED CONFIGURATION OPTIONS         ###
###----------------------------------------###

###
### Change to NO if you prefer the running
### daily script to not fix permissions on all
### files belonging to hosted sites an their
### platforms (and any shared code).
###
### Note that this feature is again enabled
### by default, because with current low
### CPU and I/O priority it should not cause
### any issues, even on weak systems.
###
_PERMISSIONS_FIX=YES

###
### Change to NO if you prefer the skip running
### weekly script to enable/disable modules in
### all hosted sites without '.testing.' or
### '.temporary.' keywords in their main name,
### as listed in the docs/MODULES.md
###
### This options is now smart enough to check
### if the module is defined as required by any
### other module or feature and will skip such
### module automatically, to avoid disabling
### innocent modules via feature or any other
### dependency.
###
_MODULES_FIX=YES

###
### List modules to never disable via running
### daily script to enable/disable modules in
### all hosted sites without 'dev.' in their
### main domain name, as listed in the
### docs/MODULES.md
###
### Requires: _MODULES_FIX=YES
###
### Example: _MODULES_SKIP="dblog update"
###
### While any module detected as required
### will not be disabled anyway, this option
### allows you to whitelist modules which
### otherwise would get disabled.
###
_MODULES_SKIP=""

###
### Control if boost caches should be deleted
### by BOA. By default they are cleared daily.
### Change to NO if you prefer to never clear
### the boost cache files.
###
### If you choose NO make sure that boost cron
### and/or expire module are removing the boost
### caches when needed.
###
_CLEAR_BOOST="YES"


###
### Use YES only if both "randpass 64 esc"
### and "randpass 64 alnum" commands produce
### well looking, strong passwords and not
### some binary garbage, which is typically
### a sign of unreliable /dev/urandom.
### See: https://drupal.org/node/1952042
###
### Configurable length: 32-128 or automatic
### with keywords: YES (64), NO (32).
###
_STRONG_PASSWORDS=YES

###
### Extra packages to install. Useful to
### specify packages not included by default.
###
_EXTRA_PACKAGES=""

###
### Use YES to avoid overwriting configuration
### for listed services on upgrade.
###
_CUSTOM_CONFIG_CSF=NO
_CUSTOM_CONFIG_LSHELL=NO
_CUSTOM_CONFIG_VALKEY=NO
_CUSTOM_CONFIG_REDIS=NO
_CUSTOM_CONFIG_SQL=NO

###
### The Backdrop CMS system tools (bee,
### Drush extension, lshell exposure) are
### installed by default. To skip them on
### this system, change this to NO.
###
### _BACKDROP_SUPPORT=NO
###
_BACKDROP_SUPPORT=YES

###
### You can define custom list of functions
### to disable besides those already denied
### in the system level 'disable_functions'.
###
### Note: If this option is left empty, BOA
### will deny access also to function:
###
###   passthru
###
### If _PHP_FPM_DENY is *not* empty, its value
### will *replace* default 'passthru', so any
### denied function must be listed explicitly.
###
### WARNING! Do not add here 'shell_exec'
### or you will break cron for all sites
### including all hosted on all Satellite
### Instances. The 'shell_exec' function is
### also required by Collectd Graph Panel,
### if installed.
###
### This option affects only Ægir Master
### Instance plus all scripts running outside
### of Octopus Satellite Instances.
###
### Example:
###
### _PHP_FPM_DENY="passthru,popen,system"
###
### Note that while it will improve security
### it will also break modules which rely
### on any of disabled functions.
###
_PHP_FPM_DENY=""

###
### We highly recommend to enable this option
### to improve system security when certain
### PHP functions, especially: exec, passthru,
### shell_exec,system,proc_open,popen are not
### disabled via option _PHP_FPM_DENY above.
###
### WARNING! This option is very aggressive
### and can break any extra service or binary
### you have installed which BOA doesn't
### manage and the binary has system group
### set to 'root'. BOA will not touch any
### binary which has non-root group or has
### setgid or setuid permissions.
###
_STRICT_BIN_PERMISSIONS=YES

###
### On modern systems (Devuan Daedalus and
### Excalibur, Debian Bookworm and Trixie) BOA
### keeps the operating system security updates
### applied automatically between BOA upgrades.
### It uses an archive-based, security-only origin,
### so no general upgrades are pulled in, and the
### stack BOA builds itself (Nginx, PHP, Percona)
### is excluded. A new security kernel is activated
### only through BOA's own graceful reboot flow,
### with the existing reboot gating left unchanged.
###
### Enabled by default. Set it to NO if you prefer
### to manage OS security updates yourself; opting
### out only stops BOA from managing them and does
### not remove anything already configured.
###
_SYSTEM_AUTO_SECURITY=YES

###
### Define the amount of RAM you want to keep
### reserved for other services installed which
### are not controlled by BOA, so it will
### assume that available RAM is the value of
### ${_RAM} - ${_RESERVED_RAM} (in MB).
###
### Example for 256MB: _RESERVED_RAM=256
###
### If not specified, BOA will auto-reserve
### 1/4 of RAM to make sure that the system
### doesn't experience frequent OOM incidents
### when running heavy tasks like backups.
###
_RESERVED_RAM=0

###
### CiviCRM 4.2 and newer requires more SQL
### privileges (the SUPER which can't be added
### for obvious security reasons) or binary
### logging disabled. Otherwise almost all
### Ægir tasks against any site with CiviCRM
### system active will fail, so we disable
### binary logging by default. It will also
### improve system performance on servers
### with slower/lower disks I/O.
###
### You can still enable it, if you prefer,
### by changing it to _DB_BINARY_LOG=YES
### below or in the /root/.barracuda.cnf file,
### but you must first stop mysql service
### and delete or move away all existing files
### from the /var/log/mysql/ directory, so it
### will start fresh logs after it has been
### disabled during previous system upgrade.
###
### Note: this option is ignored if the option
### _CUSTOM_CONFIG_SQL is set to YES.
###
_DB_BINARY_LOG=NO

###
### Optional per-knob tuning pins. Each accepts a plain
### integer only: megabytes for the memory pins, a count
### for _SQL_MAX_CONNECTIONS_FORCE. Anything else, incl.
### unit suffixes like 32G, is rejected and the derived
### value stays. Unset or empty means AUTO (derived).
### Unlike _CUSTOM_CONFIG_SQL=YES, the system keeps
### managing everything else in my.cnf, and pins survive
### major database upgrades. A buffer pool pin alone does
### not force a database restart (the log file size keeps
### deriving from the unpinned base unless pinned too).
### _SQL_MAX_CONNECTIONS_FORCE and _SQL_LOG_FILE_SIZE_FORCE
### take effect only with a database restart on the next
### planned maintenance. _VALKEY_MAXMEM_FORCE also covers
### Redis on legacy systems. _SOLR_HEAP_FORCE caps the JVM
### heap -Xmx for Solr 7 and Solr 9 alike (not jetty/solr4).
### Pins have no effect on Galera cluster nodes.
###
_SQL_BUFFER_POOL_FORCE=""
_SQL_TMP_TABLE_FORCE=""
_SQL_KEY_BUFFER_FORCE=""
_SQL_LOG_FILE_SIZE_FORCE=""
_SQL_MAX_CONNECTIONS_FORCE=""
_VALKEY_MAXMEM_FORCE=""
_SOLR_HEAP_FORCE=""

###
### Log-only SQL sensor (sqlprobe monitor): one lightweight sample
### every 5 minutes feeding the memorytuner advisory and keeping the
### datadir/valkey measurement stores fresh between upgrades. It never
### changes any setting. Set to NO to disable on this system.
###
_USE_SQLPROBE=YES

###
### Batch storm guard (batch_guard monitor): detects a local self-DoS
### where the background_process+background_batch module pair floods
### the box's own address with /bgp-start/ POSTs — a pinned pool turns
### them into a 499 wall at ANY box-wide load, and the guard arms on
### that storm signal, never on load level — confirms the looping
### batches are dead across two passes, and deletes only their
### transient rows so the loop drains without any restart. Set
### to NO to disable on this system; _BATCH_GUARD_DETECT_ONLY=YES
### keeps the detection and alerts but never deletes anything.
###
_USE_BATCH_GUARD=YES

###
### Crashed-task reaper (task_guard monitor): a task runner killed
### without reaching its own shutdown handler (reboot, an interrupted
### upgrade swapping the live code trees, a signal) leaves its
### hosting_task row at PROCESSING forever, and each such corpse is
### counted against the dispatch concurrency budget for 8h — one can
### wedge an instance's whole queue. The reaper marks a row failed
### only when it is past a grace window AND its instance user has no
### live task runner and no live provision backend. Set to NO to
### disable on this system; _TASK_GUARD_DETECT_ONLY=YES keeps the
### detection and alerts but never writes anything.
###
_USE_TASK_GUARD=YES

###
### Permanent health/attack archive (XDR9000): a read-only harvester
### copies attack bans, auto-heal incidents, backup outcomes and metric
### samples into an append-only archive under /var/log/boa/xdr9000/
### before routine log cleanup can erase them; the root-only xdr9000
### command reads it. It never bans, kills or restarts anything. The
### archive is never pruned (past months are compressed). Set to NO
### to stop recording on this system; anything already archived is
### kept.
###
_XDR9000=YES

###
### Converted control-file toggles. Each replaces a former presence-
### marker file under /etc/boa or /root; the marker is still honoured
### for one release while the fleet converges, but the variable is the
### supported switch. They all default to off.
###
### Off-switch during the transition: set the variable to NO *and*
### remove the marker file. While the marker exists it wins and is
### re-asserted on every upgrade pass, exactly as it did before the
### conversion.
###
### Keeps the New Relic server monitor (nrsysmond) running; when off,
### the guard actively stops it. Off by default because sysmond
### exposes system-level details in the New Relic control panel.
### Replaces /etc/boa/.enable.newrelic.sysmond.cnf
_ENABLE_NEWRELIC_SYSMOND=NO

###
### Enables the self-service run-php-fpm-reload.pid sentinel on this
### host regardless of the per-account plan gate.
### Replaces /etc/boa/.allow.php.fpm.reload.cnf
_ALLOW_PHP_FPM_RELOAD=NO

###
### Runs codebasecheck once per platform in the nightly sweep.
### Replaces /etc/boa/.allow-codebasecheck.cnf
_ALLOW_CODEBASECHECK=NO

###
### Adds an immediate csf temp ban on ports 80/443 for offenders the
### web IDS decides to ban, ahead of the guest-fire pipeline; needs
### csf installed to have any effect.
### Replaces /etc/boa/.instant.csf.block.cnf
_INSTANT_CSF_BLOCK=NO
###
### Tears down the Jetty 9 service on the next self-update pass:
### deregisters it, parks its init script in /var/backups and kills the
### daemon. The teardown does not reverse itself.
### Replaces /etc/boa/.deny.jetty9.cnf
_DENY_JETTY9=NO
###
### Same teardown for Solr 7.
### Replaces /etc/boa/.deny.solr7.cnf
_DENY_SOLR7=NO
###
### Same teardown for Solr 9.
### Replaces /etc/boa/.deny.solr9.cnf
_DENY_SOLR9=NO
###
### Enables the self-service run-nginx-restart.pid sentinel box-wide,
### beside the qualifying-plan gate rather than replacing it.
### Replaces /etc/boa/.allow.nginx.restart.cnf
_ALLOW_NGINX_RESTART=NO
###
### Enables the self-service cache-restart sentinel box-wide. One key
### covers both the valkey- and redis-named markers it replaces.
### Replaces /etc/boa/.allow.valkey.restart.cnf or .allow.redis.restart.cnf
_ALLOW_VALKEY_RESTART=NO
###
### Redirects the daily usage report to the internal debug inbox instead
### of the account owner.
### Replaces /etc/boa/.debug.email.txt
_DEBUG_EMAIL=NO
###
### Nightly GoAccess builds the aggregate ALL-sites report as well as
### the per-site ones. Needs GoAccess itself switched on.
### Replaces /etc/boa/.goaccess.all.cnf
_GOACCESS_ALL=NO
###
### Space-separated visitor IPs or dash-ranges like 1.2.3.4-1.2.3.9
### (IPv4/IPv6; CIDR is not honoured by GoAccess and is refused) left out
### of every GoAccess report, so operator/monitoring visits do not skew
### the stats.
_GOACCESS_EXCLUDE_IPS=""
###
### Nightly GoAccess also builds one report per standalone vhost defined
### in /etc/nginx/sites-enabled, plus the box-wide ALL aggregate, into
### /var/log/boa/xdr9000/goaccess/. Needs GoAccess itself switched on.
_GOACCESS_VHOSTS=NO
###
### Suppresses the already-up-to-date notice AND re-runs an Octopus
### upgrade that would otherwise be skipped.
### Replaces /etc/boa/.silent-octopus-upgrade.cnf
_OCTOPUS_UPGRADE_RERUN_SILENT=NO
###
### Adds a second saturation detector to the mysql monitor: besides the syslog
### scan it asks the server directly each pass and treats a "Too many
### connections" reply as the trigger. It does NOT restart -- that reply proves
### the server is answering, and the restart path returns without acting on any
### server that answers. It relieves saturation instead: flush-hosts and the
### long-query sweep, skipped while a Provision task is in flight.
### Replaces /etc/boa/.instant.busy.mysql.action.cnf
_INSTANT_BUSY_MYSQL_ACTION=NO
###
### Keeps the slow-query log and the mysqladmin process-list monitor on.
### When off, the monitor turns slow_query_log off and deletes the
### collected logs.
### Replaces /etc/boa/.mysqladmin.monitor.cnf
_MYSQLADMIN_MONITOR=NO
###
### Leaves sendmail executable for tenants and points Postfix at direct
### delivery instead of the relay. Off by default.
### Replaces /etc/boa/.allow.sendmail.cnf
_ALLOW_SENDMAIL=NO
###
### Stops BOA refreshing /etc/sysctl.conf and the system limits on
### upgrade passes.
### Replaces /root/.no.sysctl.update.cnf
_NO_SYSCTL_UPDATE=NO
###
### Purges the reusable /opt/tmp build tree at the start of every
### wrapper run, forcing a full re-download.
### Replaces /root/.debug-purge-build-tree.cnf
_DEBUG_PURGE_BUILD_TREE=NO
###
### Adds a verbose line per drush call to the nightly maintenance log.
### Replaces /root/.debug_daily.info
_DEBUG_DAILY=NO
###
### Stops auditd writing logs. When off, BOA re-asserts write_logs = yes
### on every pass.
### Replaces /root/.disable.auditd.logs.cnf
_DISABLE_AUDITD_LOGS=NO
###
### Drops the decorated root login banner and its packages (toilet,
### figlet, screenfetch).
### Replaces /root/.dont.use.fancy.bash.login.cnf
_DONT_USE_FANCY_BASH_LOGIN=NO
###
### Includes the newest supported PHP version in multi-version installs.
### Replaces /root/.include-php-latest.cnf
_INCLUDE_PHP_LATEST=NO
###
### Restarts MySQL gracefully after the monthly OPTIMIZE pass.
### Replaces /root/.my.restart_after_optimize.cnf
_MY_RESTART_AFTER_OPTIMIZE=NO
###
### Keeps Java/Solr/Jetty off this box; the installer skips the Solr stack
### and the updater tears down any installed Solr/Jetty init scripts.
### Replaces /root/.deny.java.cnf
_DENY_JAVA=NO
###
### Skips the nightly per-platform permissions pass (the codebase lock);
### the box-wide sweep keeps its own gate.
### Replaces /etc/boa/.dont.touch.permissions.cnf
_SKIP_PERMISSIONS_PASS=NO
###
### Allows the automatic Aegir task queue on a CI-classified box.
### Replaces /etc/boa/.allow.aegir.queue.cnf
_ALLOW_AEGIR_QUEUE=NO
###
### Disables the hourly database cleanup run and the four nightly
### giant-table truncations in the backup pass.
### Replaces /etc/boa/.disable_mysql_cleanup.cnf
_DISABLE_MYSQL_CLEANUP=NO
###
### Enables the abuse-guard scorer's debug instrumentation, including its
### shell trace on manual runs.
### Replaces /etc/boa/.debug.monitor.cnf
_DEBUG_MONITOR=NO
###
### Keeps the du command available in the restricted client shell.
### Replaces /etc/boa/.allow.du.cnf
_ALLOW_DU=NO
###
### Suppresses the wildcard chmod pass over client home directories.
### Replaces /etc/boa/.home.no.wildcard.chmod.cnf
_HOME_NO_WILDCARD_CHMOD=NO
###
### Keeps ClamAV services registered and monitored on this box.
### Replaces /root/.allow.clamav.cnf
_ALLOW_CLAMAV=NO
###
### Overrides an allow and forces ClamAV services deregistered.
### Replaces /root/.deny.clamav.cnf
_DENY_CLAMAV=NO
###
### Forces the CI box classification (queue policy, monitor cadence,
### usage accounting, the Jenkins-era java symlink set).
### Replaces /etc/boa/.look.like.jenkins.cnf
_FORCE_CI_BOX=NO
###
### Suppresses the automatic cron service start/reload at the three
### upgrade-finale sites that honour it.
### Replaces /root/.upstart.cnf
_NO_CRON_AUTOSTART=NO

###
### Set max 1 min load per CPU core before killing
### all running PHP, Drush, Wget and Curl processes
### until the load stabilizes.
###
### This shouldn't affect any innocent Ægir tasks,
### including cron for sites, because the system
### never starts them anyway, if the average load
### in the last minute is higher than 3.1
###
_CPU_CRIT_RATIO=8.1

###
### Set max 1 min load per CPU core before disabling
### Nginx temporarily, until the load stabilizes.
###
_CPU_MAX_RATIO=6.1

###
### Define max 1 min load per CPU core before
### launching task queue for Octopus instances.
###
_CPU_TASK_RATIO=3.1

###
### Set max 1 min load per CPU core before blocking
### spiders temporarily, until the load stabilizes.
###
_CPU_SPIDER_RATIO=2.1

###
### Nightly maintenance (owl.sh) per-account parallelism. The default NO
### processes Octopus accounts one at a time (serial), exactly as before. Set
### to YES to process accounts in parallel, up to _NIGHT_MAX_PARALLEL at once,
### each launch still gated by the per-core load ceiling (_CPU_TASK_RATIO).
###
_NIGHT_PARALLEL=NO

###
### Max Octopus accounts owl.sh processes in parallel when _NIGHT_PARALLEL=YES.
### AUTO will default to the CPU core count.
###
_NIGHT_MAX_PARALLEL=AUTO

###
### Nightly global files-symlink auto-fix (updatesymlinks --auto-fix). The
### default NO leaves symlink maintenance manual. Set to YES to enable a nightly
### run (retried hourly at :47 through the night until it completes) that
### converts any not-yet-symlinked site files/private dirs into the per-account
### static store and self-heals partly-symlinked sites. The run is skipped
### while backups, provision tasks, or high load are active.
###
_AUTOSYMLINK_NIGHTLY=NO

###
### Daily ghost/orphaned files-directory email report (updatesymlinks
### --orphan-report), run from the same nightly cron entry as the auto-fix
### above. The default NO disables it. Set to YES to email _MY_EMAIL a report
### ONLY when orphaned static/files entries (storage with no matching active
### site) are detected. Read-only: never converts or deletes.
###
_ORPHAN_FILES_REPORT=NO

###
### Nightly cleanup of unused SHARED codebases (legacy D6/D7 core/contrib under
### /data/all). The default NO only detects and logs them (dry-run). Set to YES
### to move a shared codebase no longer referenced by any platform aside into a
### codebases-cleanup backup dir during nightly maintenance.
###
_SHARED_CODEBASES_CLEANUP=NO

###
### Nightly cleanup of GHOST codebases (orphaned trees under distro/ with no
### detectable Drupal docroot at root or web/docroot/html). The default NO only
### detects and logs them (dry-run). Set to YES to move a ghost codebase aside
### into a ghost-codebases-cleanup backup dir during nightly maintenance.
###
_GHOST_CODEBASES_CLEANUP=NO

###
### Nightly cleanup of GHOST/empty platform registrations (Drush alias files
### whose platform root has no detectable Drupal docroot). The default NO only
### detects and logs them (dry-run). Set to YES to move the stale alias aside
### into the undo/ dir during nightly maintenance. Can also be enabled per
### Octopus account in /root/.<user>.octopus.cnf.
###
_GHOST_PLATFORMS_CLEANUP=NO

###
### Nightly cleanup of GHOST nginx vhosts (a vhost.d server block with no
### matching site Drush alias). The default NO only detects and logs them
### (dry-run). Set to YES to move the orphaned vhost aside into the undo/ dir.
### Can also be enabled per Octopus account in /root/.<user>.octopus.cnf.
###
_GHOST_VHOSTS_CLEANUP=NO

###
### Nightly cleanup of GHOST site registrations (a site Drush alias whose site
### directory is gone -- no settings/files/private). The default NO only detects
### and logs them (dry-run). Set to YES to move the stale alias and its vhost
### aside into the undo/ dir. Per Octopus account override in octopus.cnf.
###
_GHOST_SITES_CLEANUP=NO

###
### Also move a ghost site's leftover files directory (site data, not just the
### registration) when _GHOST_SITES_CLEANUP acts. Kept separate and default NO
### because it touches data. Per Octopus account override in octopus.cnf.
###
_GHOST_SITE_FILES_CLEANUP=NO

###
### Cleanup of stale per-site Drush alias copies in the limited-shell (FTPS)
### user tree, on the 3-minute manage_ltd_users.sh cadence. The default NO
### only detects and logs them (dry-run). Set to YES to move a stale alias
### aside: each candidate is held 48h from its first sighting (the marker is
### cleared by any valid sighting and only accumulates while YES, so enabling
### never mass-reaps a backlog), and aegir/distro front-end companion aliases
### are never touched here. Per Octopus account override in octopus.cnf.
###
_GHOST_ALIASES_CLEANUP=NO

###
### Minimum age in days of a converted account's log/proxied.pid before
### xtrim will agree to shrink it -- the proxy must prove itself quiet
### first. Hard floor of 7 is enforced by the tool regardless.
###
_XTRIM_MIN_DAYS=14

###
### Warn the admin when the earliest certificate behind a retained
### migration-proxy vhost expires within this many days AND the daily
### mirror could not refresh it (migration_proxy_certs.sh).
###
_MIGRATION_PROXY_CERT_WARN_DAYS=21

###
### Default number of access.log lines to check.
###
_NGINX_DOS_LINES=1999

###
### Set max allowed page views from one IP
### out of last 1999. Note that it will lock
### the access completely for 1 hour on the
### firewall level in /etc/csf/csf.deny
###
_NGINX_DOS_LIMIT=399

###
### Default Nginx DoS-guard mode which automatically
### increases the counter +1 for every POST request.
### When changed to 1 will increase the counter:
###
###  +5 for POST request to /user and /node/add
###  +5 for GET request to /node/add
###  +5 for GET request to /search
###
_NGINX_DOS_MODE=2

###
### Logging mode, can be SILENT, NORMAL or VERBOSE.
### Absorbs the former /etc/boa/.debug.monitor.log.cnf marker: while that
### file exists the upgrade pass ensures NORMAL here (an explicit NORMAL or
### VERBOSE wins). Off = remove the marker *and* set SILENT. This key is
### seed-only on retunes -- a value set here survives fleet DOS retunes,
### unlike the other _NGINX_DOS_* keys, which retunes reset to defaults.
###
_NGINX_DOS_LOG=SILENT

###
### Will make the request ignored when the keyword
### is detected in the access.log -- can use regex
### like _NGINX_DOS_IGNORE="foo|bar|etc"
###
_NGINX_DOS_IGNORE="doccomment"

###
### Adds the full _NGINX_DOS_LIMIT to the IP counter (an immediate
### ban) when a request line matches this regex in the access.log --
### the default catches blind-timing and encoded SQL-injection probes
###
_NGINX_DOS_STOP="WAITFOR.DELAY|DECLARE.*@x|/\*\*/|%27.*%29.*%3B|0x[0-9a-f]{6}"

###
### Divisor applied to _NGINX_DOS_LIMIT to derive the per-hit counter
### increment step used by the web IDS; the short-window step uses
### twice this divisor. Positive integer.
###
_NGINX_DOS_DIV_INC_NR=40

###
### Minimum allowed counter increment step for the web IDS, used when
### the divisor-derived step would fall below it. Positive integer.
###
_NGINX_DOS_INC_MIN=3

###
### Nginx Headers More support is available
### via third-party Nginx module. To enable
### change this option to _NGINX_HEADERS=YES
### below or in the /root/.barracuda.cnf file.
###
_NGINX_HEADERS=NO

###
### Experimental LDAP support is available
### via third-party Nginx module. To enable
### change this option to _NGINX_LDAP=YES
### below or in the /root/.barracuda.cnf file.
###
_NGINX_LDAP=NO

###
### NAXSI means Nginx Anti XSS & SQL Injection
### and is a third-party Nginx module not used
### by default. If you want to test / use it,
### change this option to _NGINX_NAXSI=YES
### below or in the /root/.barracuda.cnf file.
###
_NGINX_NAXSI=NO

###
### When set to YES, it will also force
### OpenSSL (packages) and cURL (sources)
### upgrade / re-install.
###
_NGINX_SPDY=YES

###
### When set to YES, it will also force
### OpenSSL (packages) and cURL (sources)
### upgrade / re-install.
###
_NGINX_FORWARD_SECRECY=YES

###
### Kernel TLS (KTLS) offload in Nginx. The default YES keeps KTLS
### active. Set to NO to disable KTLS server-wide -- useful where
### OpenSSL 3.2+ kernel kTLS RX aborts TLS connections mid-request
### with recv() Input/output error alerts.
###
_NGINX_KTLS=YES

###
### Use this only when you need to always
### compile in some extra/custom module(s).
###
_NGINX_EXTRA_CONF=""

###
### Use this only when you need to always
### compile in some extra PHP extension.
###
_PHP_EXTRA_CONF=""

###
### Change to YES to enable ionCube.
###
_PHP_IONCUBE=NO

###
### Change to YES to always compile in
### MongoDB driver.
### mongo.so for PHP < 7.0
### mongodb.so for PHP 7.0
###
_PHP_MONGODB=NO

###
### When set to YES the heavy stack components
### (OpenSSL, cURL, ICU, PHP) are installed from
### prebuilt per-release packages published on
### the BOA mirrors, with automatic fallback to
### the source build for any component that has
### no matching package. NO always builds from
### sources. On Devuan Daedalus it defaults to
### YES unless set explicitly in the cnf file,
### which always wins, both ways.
###
_USE_PREBUILT_PKGS=NO

###
### When set to YES it will force OpenSSH
### armoured configuration for the BOA-built
### OpenSSH.
###
_SSH_ARMOUR=NO

###
### Generate statistics with GoAccess when YES
###
_ENABLE_GOACCESS=NO

###
### AUTO will default to values calculated
### on the fly and based on available RAM.
### You can force workers number for Nginx
### and PHP-FPM here.
###
_NGINX_WORKERS=AUTO
_PHP_FPM_WORKERS=AUTO

###
### Max default TTL for Speed Booster Cache.
### It will affect all Ægir Instances, but
### it is used only for spiders and with not
### enabled by default control file per site
### or per platform modules/cache_hour/YES.txt
###
_SPEED_VALID_MAX=3600

###
### Can be completely silenced by setting to OFF or NO
###
### When set to ALL it will start sending
### many e-mail reports on various incidents
### detected and handled by auto-healing.
###
### Minimalized globally with MINI by default.
###
### Legacy values:
###   NO  becomes OFF (see below)
###   YES becomes MINI (see below)
###
### Current values:
###   OFF  == Total silence, no email alerts
###   ALL  == Very noisy, good for debugging
###   MINI == Only the most important alerts (default)
###   CRIT == Only critical if _lvl=ALERT
###
_INCIDENT_REPORT=MINI

###
### Per-client Let's Encrypt renewal failure notices. When a site's HTTPS
### certificate renewal fails -- almost always because the domain or one of its
### aliases no longer points to this server, or its DNS is missing -- owl.sh
### emails the affected account's client (_CLIENT_EMAIL) an actionable notice,
### throttled to once per 7 days per site, so they can fix DNS or disable
### Encryption on dead clones that fail the check every night for no reason. The
### server admin (_MY_EMAIL) always gets the full per-account report regardless.
### Default YES (enabled). Set to NO here to disable client notices fleet-wide,
### or per-account in /root/.<user>.octopus.cnf.
###
_LE_CLIENT_NOTIFY=YES

###
### When the nightly maintenance confirms a ghost site -- a registration
### (Drush alias + nginx vhost) whose site directory no longer exists, left
### behind by a failed or rolled-back install/clone -- it emails the affected
### account's client (_CLIENT_EMAIL) an actionable notice, throttled to once
### per 30 days per site, so they can remove the dead record in their own
### Aegir control panel (the only place it can be removed; the backend
### leftovers alone grow back on the next task run). Default YES (enabled).
### Set to NO here to disable fleet-wide, or per-account in
### /root/.<user>.octopus.cnf.
###
_GHOST_CLIENT_NOTIFY=YES

###
### Max TTL for mysql process per user (seconds)
###
### This value is authoritative: the watchdog sources this file before its
### built-in fallback can fire, so the value set here is what the kill test
### uses. The historical /root/.high_load.cnf and /root/.big_db.cnf markers
### are inert and their installer retune was retired -- set the ceiling you
### want here explicitly.
###
_SQL_MAX_TTL=3600

###
### Max TTL for mysql process per problematic user
### listed in the /etc/boa/.sql.problematic.users.cnf
### file -- one per line.
###
_SQL_LOW_MAX_TTL=60


###----------------------------------------###
### DON'T EDIT ANYTHING BELOW THIS LINE    ###
###----------------------------------------###


_AEGIR_VERSION=AUTO
_AEGIR_XTS_VRN=AUTO
_BRANCH_BOA=AUTO
_BRANCH_PRN=AUTO
_X_VERSION=AUTO
_BOA_REPO_NAME="boa"
_BOA_REPO_GIT_URL="${_gitHub}"

export _tRee=pro
export _xSrl=588855proT01


###
### Commands shortcuts
###
_aptAllow="--allow-unauthenticated"
_dstUpArg="-fuy -q ${_aptAllow} --config-file /opt/apt/apt.conf.noi.dist"
_nrmUpArg="-fuy -q ${_aptAllow} --config-file /opt/apt/apt.conf.noi.nrml"
_INITINS="/usr/bin/apt-get ${_aptAllow} -y install"
_INSTALL_DIST="/usr/bin/apt-get ${_dstUpArg} install"
_INSTALL_NRML="/usr/bin/apt-get ${_nrmUpArg} install"
_aptYesUnth="-y ${_aptAllow}"
if [ ! -e "/var/aegir/.drush/hm.alias.drushrc.php" ]; then
  _INSTAPP="${_INSTALL_DIST}"
fi


###
### Determine correct _APT_UPDATE
###
_os_detection_minimal() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _os_detection_minimal in barracuda"
  fi
  _APT_UPDATE="apt-get update"
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  _OS_LIST="excalibur daedalus chimaera beowulf buster bullseye bookworm trixie"
  for e in ${_OS_LIST}; do
    if [ "${e}" = "${_OS_CODE}" ]; then
      _APT_UPDATE="apt-get update --allow-releaseinfo-change"
    fi
  done
}
_os_detection_minimal


###
### Apt cleanup
###
_apt_clean_update() {
  ${_APT_UPDATE} -qq 2>/dev/null
  _CALLER_SCRIPT="$(basename "${BASH_SOURCE[-1]}")"
  _CALLER_SCRIPT="${_CALLER_SCRIPT//[^a-zA-Z0-9._-]/_}"
  date +%s > "/run/_latest_apt_clean_update.${_CALLER_SCRIPT}.pid"
}


###
### Find the fastest mirror to use for downloads
###
_find_fast_mirror_cnf() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _find_fast_mirror_cnf in barracuda"
  fi
  _isNetc="$(which netcat)"
  if [ ! -x "${_isNetc}" ] || [ -z "${_isNetc}" ]; then
    if [ ! -e "/etc/apt/apt.conf.d/00sandboxoff" ] \
      && [ -e "/etc/apt/apt.conf.d" ]; then
      echo "APT::Sandbox::User \"root\";" > /etc/apt/apt.conf.d/00sandboxoff
    fi
    _apt_clean_update
    apt-get install netcat-traditional ${_aptYesUnth} 2> /dev/null
  fi
  _ffMirr=/opt/local/bin/ffmirror
  if [ -x "${_ffMirr}" ]; then
    _ffList="/var/backups/boa-mirrors-2026-07.txt"
    [ -d "/var/backups" ] || mkdir -p /var/backups
    if [ ! -e "${_ffList}" ]; then
      echo "files.boa.io"  > ${_ffList}
      echo "files.o8.io" >> ${_ffList}
      echo "files.host8.biz" >> ${_ffList}
      echo "files.aegir.biz" >> ${_ffList}
      echo "files.aoboshi.com" >> ${_ffList}
    fi
    if [ -e "${_ffList}" ]; then
      _BROKEN_FFMIRR_TEST=$(grep "stuff" ${_ffMirr} 2>&1)
      if [[ "${_BROKEN_FFMIRR_TEST}" =~ "stuff" ]]; then
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        export _USE_MIR="${_CHECK_MIRROR}"
        [[ "${_USE_MIR}" =~ "printf" ]] && export _USE_MIR="files.boa.io"
      else
        export _USE_MIR="files.boa.io"
      fi
    else
      export _USE_MIR="files.boa.io"
    fi
  else
    export _USE_MIR="files.boa.io"
  fi
  export _urlDev="https://${_USE_MIR}/dev"
  export _urlHmr="https://${_USE_MIR}/versions/${_tRee}/boa/aegir"
}


###
### Function to verify BOA keys
###
_verify_boa_keys() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _verify_boa_keys in barracuda"
  fi
  if [ "${_tRee}" = "pro" ] || [ "${_tRee}" = "dev" ]; then
    _allw=NO
    _urlEnc="https://${_USE_MIR}/enc/2024"
    _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
    _encName=$(echo ${_hName} \
      | openssl md5 \
      | awk '{ print $2}' \
      | tr -d "\n" 2>&1)
    if [[ "${_hName}" =~ ".aegir.cc"($) ]] \
      || [[ "${_hName}" =~ ".o8.io"($) ]] \
      || [[ "${_hName}" =~ ".boa.io"($) ]]; then
      _allw=YES
    fi
    mkdir -p /var/opt
    rm -f /var/opt/_encN*
    curl ${_crlGet} "${_urlEnc}/${_encName}" -o /var/opt/_encN.${_encName}.tmp
    wait
    echo "${_hName}.${_encName}" > /var/opt/_encN_local.${_encName}.tmp
    wait
    if [ -e "/var/opt/_encN.${_encName}.tmp" ] && [ -e "/var/opt/_encN_local.${_encName}.tmp" ]; then
      _diffTestIf=$(diff -w -B /var/opt/_encN.${_encName}.tmp /var/opt/_encN_local.${_encName}.tmp 2>&1)
      if [ ! -z "${_diffTestIf}" ] && [ "${_allw}" = "NO" ]; then
        echo
        echo "Your system requires valid license for upgrade to ${_rLsn}-${_tRee}"
        echo "Please visit https://omega8.cc/licenses to purchase your own"
        echo
        if [ -e "/var/aegir/.drush/hm.alias.drushrc.php" ] \
          && [ ! -e "/var/aegir/key/barracuda_key.txt" ]; then
          mkdir -p /var/aegir/key
          cat /var/opt/_encN_local.${_encName}.tmp > /var/aegir/key/barracuda_key.txt
        fi
        rm -f /var/opt/_encN*
        _clean_pid_exit _verify_boa_keys_a
      else
        if [ -e "/var/aegir/.drush/hm.alias.drushrc.php" ] \
          && [ ! -e "/var/aegir/key/barracuda_key.txt" ]; then
          mkdir -p /var/aegir/key
          cat /var/opt/_encN_local.${_encName}.tmp > /var/aegir/key/barracuda_key.txt
        fi
      fi
    else
      echo
      echo "Your system requires valid license to use this BOA version (${_tRee})"
      echo "Unfortunately it was not possible to verify your system status"
      echo "Please contact our support but visit https://omega8.cc/licenses first"
      echo
      exit 0
    fi
  fi
}


###
### Extract archive
###
_extract_archive_pre() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _extract_archive_pre in barracuda"
  fi
  if [ ! -z "${1}" ]; then
    case $1 in
      *.tar.bz2)   tar xjf ${1}    ;;
      *.tar.gz)    tar xzf ${1}    ;;
      *.tar.xz)    tar xvf ${1}    ;;
      *.bz2)       bunzip2 ${1}    ;;
      *.rar)       unrar x ${1}    ;;
      *.gz)        gunzip -q ${1}  ;;
      *.tar)       tar xf ${1}     ;;
      *.tbz2)      tar xjf ${1}    ;;
      *.tgz)       tar xzf ${1}    ;;
      *.zip)       unzip -qq ${1}  ;;
      *.Z)         uncompress ${1} ;;
      *.7z)        7z x ${1}       ;;
      *)           echo "'${1}' cannot be extracted via >extract<" ;;
    esac
    [ -z "${2}" ] && rm -f "${1}"
  fi
}


###
### Download and extract archive from dev/src mirror
###
_get_dev_src_pre() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _get_dev_src_pre in barracuda"
  fi
  if [ ! -z "${1}" ]; then
    curl ${_crlGet} "${_urlDev}/src/$1" -o "$1"
    if [ -e "$1" ]; then
      _extract_archive_pre "$1"
    else
      echo "OOPS: $1 failed download from ${_urlDev}/src/$1"
    fi
  fi
}


#
# Extract archive.
_extract_archive() {
  if [ ! -z "${1}" ]; then
    case $1 in
      *.tar.bz2)   tar xjf ${1}    ;;
      *.tar.gz)    tar xzf ${1}    ;;
      *.tar.xz)    tar xvf ${1}    ;;
      *.bz2)       bunzip2 ${1}    ;;
      *.rar)       unrar x ${1}    ;;
      *.gz)        gunzip -q ${1}  ;;
      *.tar)       tar xf ${1}     ;;
      *.tbz2)      tar xjf ${1}    ;;
      *.tgz)       tar xzf ${1}    ;;
      *.zip)       unzip -qq ${1}  ;;
      *.Z)         uncompress ${1} ;;
      *.7z)        7z x ${1}       ;;
      *)           echo "'${1}' cannot be extracted via >extract<" ;;
    esac
    [ -z "${2}" ] && rm -f "${1}"
  fi
}


#
# Download and extract from dev/version mirror.
_get_dev_ext() {
  if [ ! -z "${1}" ]; then
    _max_attempts=10
    _attempt_num=1
    _success=0
    while [ ${_attempt_num} -le ${_max_attempts} ]; do
      [ "${_DEBUG_MODE}" = "YES" ] && echo "DNLD: Attempt ${_attempt_num} of ${_max_attempts}: Downloading $1..."
      if curl ${_crlGet} "${_urlDev}/${_tRee}/$1" -o "$1"; then
        _success=1
        break
      else
        [ "${_DEBUG_MODE}" = "YES" ] && echo "DNLD: Attempt ${_attempt_num} failed."
        _attempt_num=$((_attempt_num+1))
        if [ "${_attempt_num}" -le "${_max_attempts}" ]; then
          [ "${_DEBUG_MODE}" = "YES" ] && echo "DNLD: Retrying in 9 seconds..."
          sleep 9
        fi
      fi
    done
    if [ "${_success}" -eq 1 ]; then
      if [ ! -z "${2}" ]; then
        _extract_archive "${1}" "${2}"
      else
        _extract_archive "${1}"
      fi
    else
      echo "OOPS: Failed to download ${_urlDev}/${_tRee}/$1 after ${_max_attempts} attempts"
      return 1  # Exit the function but continue the script
    fi
  fi
}


###
### Cleanup for boa code
###
_cleanup_boa_code() {
  mkdir -p /opt/tmp
  cd /opt/tmp
  [ -e "/opt/tmp/boa.tar.gz" ] && rm -f /opt/tmp/boa.tar.gz
  # The lib probe catches a tree truncated mid-extraction: install aborts
  # no longer purge /opt/tmp, so re-fetch-by-sentinel is the only self-heal
  # for a broken tree and it must see more than the helpers directory
  if [ ! -e "/opt/tmp/boa/aegir/helpers/apt.conf.noi.nrml" ] \
    || [ ! -e "/opt/tmp/boa/aegir/helpers/apt.conf.noi.dist" ] \
    || [ ! -e "/opt/tmp/boa/lib/functions/helper.sh.inc" ]; then
    rm -rf /opt/tmp/boa
  fi
}


###
### Download boa code
###
_boa_code_tree_is_root_owned() {
  # Cheap detector for a tree that some other identity owns. Stops at the
  # first foreign entry, so it costs nothing on a healthy tree. This decides
  # whether ownership needs RESTORING -- never whether the tree may be reused.
  local _foreignEnt=""
  [ -d "/opt/tmp/boa" ] || return 1
  _foreignEnt=$(find /opt/tmp/boa ! -user root -print -quit 2>/dev/null)
  [ -z "${_foreignEnt}" ]
}


_download_boa_code() {
  # See _cleanup_boa_code: the lib probe is the broken-tree self-heal now
  # that install aborts no longer purge /opt/tmp
  if [ ! -e "/opt/tmp/boa/aegir/helpers/apt.conf.noi.nrml" ] \
    || [ ! -e "/opt/tmp/boa/aegir/helpers/apt.conf.noi.dist" ] \
    || [ ! -e "/opt/tmp/boa/lib/functions/helper.sh.inc" ]; then
    rm -rf /opt/tmp/boa
    mkdir -p /opt/tmp
    cd /opt/tmp
    _get_dev_ext "boa.tar.gz"
    # This tree is created entirely by this run, so assert the ownership
    # rather than inheriting whatever uids the archive happened to carry.
    [ -d "/opt/tmp/boa" ] && chown -R root:root /opt/tmp/boa &> /dev/null
  fi
  # Restore ownership rather than discarding the tree. Octopus batch upgrades
  # walk many instances against one fetched tree and must not re-fetch between
  # them, so ownership cannot be allowed to decide reuse -- the archives stay
  # put and only the ownership is corrected. An older satellite pass can still
  # hand the tree to its instance user; take it back before root sources it.
  if ! _boa_code_tree_is_root_owned; then
    echo "NOTE: Build tree was not owned by root -- restoring root ownership"
    chown -R root:root /opt/tmp/boa &> /dev/null
  fi
  if [ -e "/opt/tmp/boa/aegir/helpers/apt.conf.noi.nrml" ] \
    && [ -e "/opt/tmp/boa/aegir/helpers/apt.conf.noi.dist" ] \
    && [ -e "/opt/tmp/boa/lib/functions/helper.sh.inc" ]; then
    [ -e "/opt/tmp/boa.tar.gz" ] && rm -f /opt/tmp/boa.tar.gz
  fi
}


###
### Download helpers and libs
###
_download_helpers_libs() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _download_helpers_libs in barracuda"
  fi
  _find_fast_mirror_cnf
  _verify_boa_keys
  if [ "${_DL_MODE}" = "BATCH" ]; then
    _download_boa_code
  elif [ "${_DL_MODE}" = "GIT" ]; then
    _isGit="$(which git)"
    if [ -z "${_isGit}" ] || [ ! -x "${_isGit}" ]; then
      _apt_clean_update
      echo "git install"      | dpkg --set-selections &> /dev/null
      echo "git-core install" | dpkg --set-selections &> /dev/null
      echo "git-man install"  | dpkg --set-selections &> /dev/null
      apt-get install git-core ${_aptYesUnth} -qq &> /dev/null
      apt-get install git ${_aptYesUnth} -qq &> /dev/null
      apt-get install git-man ${_aptYesUnth} -qq &> /dev/null
      _isGit="$(which git)"
    fi
    _gCb="${_isGit} clone --branch"
    if [ -x "${_isGit}" ]; then
      _cleanup_boa_code
      ${_gCb} ${_BRANCH_BOA} ${_BOA_REPO_GIT_URL}/${_BOA_REPO_NAME}.git ${_bldPth} &> /dev/null
    else
      echo "ERROR: ${_isGit} is missing or broken, exit now"
      echo "Bye"
      _clean_pid_exit _download_helpers_libs_a
    fi
  else
    _download_boa_code
  fi
  #
  if [ ! -e "${_bldPth}/aegir/helpers/apt.conf.noi.nrml" ] \
    || [ ! -e "${_bldPth}/aegir/helpers/apt.conf.noi.dist" ]; then
    echo " "
    echo "EXIT on error due to missing helpers"
    echo "Please try to run this script again in a few minutes"
    echo "Also, make sure that the outgoing connections via port 443 work"
    echo "Bye"
    echo " "
    _clean_pid_exit _download_helpers_libs_b
  fi
  # Get apt helpers
  rm -f apt.conf.noi*
  cp -af ${_bldPth}/aegir/helpers/apt.conf.noi.nrml ./
  cp -af ${_bldPth}/aegir/helpers/apt.conf.noi.dist ./
  mkdir -p /opt/apt/
  cp -af ${_bldPth}/aegir/helpers/apt.conf.noi.nrml /opt/apt/
  cp -af ${_bldPth}/aegir/helpers/apt.conf.noi.dist /opt/apt/
  #
  # Create tmp stuff
  if [ ! -e "/var/aegir/.drush/hm.alias.drushrc.php" ]; then
    export _LOG_INFO=${_vBs}/barracuda-install-${_NOW}.log
    export _LOG_ERRR=${_vBs}/barracuda-install-errors-${_NOW}.log
  else
    export _LOG_INFO=${_vBs}/barracuda-upgrade-${_NOW}.log
    export _LOG_ERRR=${_vBs}/barracuda-upgrade-errors-${_NOW}.log
  fi
  touch ${_LOG_INFO} ${_LOG_ERRR}
  chmod 600 ${_LOG_INFO} ${_LOG_ERRR}
  mkdir -p /var/opt
  rm -rf /var/opt/*
  _SRCDIR="/opt/tmp/files"
  mkdir -p ${_SRCDIR}
  cd ${_SRCDIR}
}
