#%PAM-1.0

# PAM configuration for Pure-FTPd, deployed by Barracuda to
# /etc/pam.d/pure-ftpd. Carries the pam_unix form BOA has always
# produced on the box: upstream's sample calls an obsolete Red-Hat-era
# stacking module that never existed in Linux-PAM, and _fix_ftps_pam
# remains the healer for copies restored from upstream form. Wording
# note: _fix_ftps_pam's seds run over this whole file, so comments here
# must never contain the literal module names those seds rewrite.

auth       required     pam_listfile.so item=user sense=deny file=/etc/ftpusers onerr=succeed
auth       required     pam_shells.so
auth       required     pam_nologin.so

account    required     pam_unix.so

password   required     pam_unix.so

session    required     pam_unix.so
