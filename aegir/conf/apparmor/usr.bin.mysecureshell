# AppArmor profile for MySecureShell
# This profile restricts MySecureShell (mysecureshell) to essential operations only.

#include <tunables/global>

/usr/bin/mysecureshell flags=(complain) {

  # Include common AppArmor abstractions
  include <abstractions/authentication>
  include <abstractions/base>
  include <abstractions/bash>
  include <abstractions/consoles>
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/python>
  include <abstractions/wutmp>

  # Read access to its own config and logs
  /etc/ssh/sftp_config r,
  /etc/lshell.conf r,
  /var/backups/ltd/status/* r,
  /var/log/lsh/ r,
  /var/log/lsh/* rw,
  /opt/php*/lib/php.ini r,

  # Allow read access to necessary libraries
  /lib/** mr,
  /lib/x86_64-linux-gnu/** mr,
  /lib64/** mr,
  /opt/php*/lib/php/** mr,
  /usr/lib/** mr,
  /usr/lib/x86_64-linux-gnu/** mr,
  /usr/libexec/** mr,
  /usr/local/include/** mr,
  /usr/local/ioncube/ioncube_loader_lin_*.so mr,
  /usr/local/lib/** mr,
  /usr/local/ssl/** mr,
  /usr/local/ssl3/** mr,

  # Allow MySecureShell to access /proc and /sys for necessary information
  /proc/ r,
  /proc/** r,
  /sys/ r,
  /sys/** r,

  # Read/write access to user home
  /home/*/ r,
  /home/*/** rwk,

  # Read/write access to SSH client files
  /home/*/.ssh/ r,
  /home/*/.ssh/** rw,

  # Read-only access to Drush aliases and php.ini files
  /home/*/.drush/ r,
  /home/*/.drush/** r,

  # Drush access
  /opt/tools/drush/** mrix,
  /usr/local/bin/cv.phar mrix,

  # Read-only access to Octopus directories
  /data/disk/*/.drush/ r,
  /data/disk/*/.drush/** r,
  /data/disk/*/backups/ r,
  /data/disk/*/backups/** r,
  /data/disk/*/clients/ r,
  /data/disk/*/clients/** r,
  /data/disk/*/distro/** r,
  /data/disk/*/static/ r,
  /data/disk/*/static/** r,

  # Allow write access to Octopus user directories and files
  /data/disk/*/distro/** rwk,
  owner /data/disk/*/static/ r,
  /data/disk/*/static/** rwk,
  owner /opt/user/npm/*/** rw,
  owner /opt/user/gems/*/** rw,
  owner /opt/user/gems/*/bin/** k,

  # Read/write access to Drush cache
  /home/*/.drush/cache/ r,
  /home/*/.drush/cache/** rw,

  # Deny access to critical system files
  deny /etc/shadow* rwlx,
  deny /etc/sudo.conf r,
  # No sudoers line names a login, and what asks only wants to know
  deny /usr/bin/sudo x,

  # Allow read access to user information files
  /etc/passwd r,
  /etc/group r,
  /etc/nsswitch.conf r,
  /etc/hosts r,

  # Allow read-only access to resolv.conf for DNS resolution
  /etc/resolv.conf r,

  # Temporary files and directories
  /home/*/.tmp/ r,
  /home/*/.tmp/** rwk,

  # Deny execution of any shell or command not explicitly allowed
  deny /{,usr/}bin/bash x,
  deny /usr/bin/perl x,

  # Allow execution of necessary binaries
  /{,usr/}bin/dash mrix,
  /opt/local/bin/websh mrix,
  /usr/bin/mysecureshell mrix,
  /usr/bin/python* mrix,

  /usr/share/s4cmd/ r,
  /usr/share/s4cmd/** r,

  # MySecureShell starts as root by its setuid bit and writes the log its settings name
  capability chown,
  capability dac_override,
  capability dac_read_search,
  /var/log/sftp-server.log rwk,

  # What lshell, websh and the tools a login is offered start and read. A real login stays in
  # this profile: what it starts has no profile of its own under ix.
  /{,usr/}bin/cut mrix,
  /{,usr/}bin/dirname mrix,
  /{,usr/}bin/gawk mrix,
  /{,usr/}bin/head mrix,
  /{,usr/}bin/mawk mrix,
  /{,usr/}bin/readlink mrix,
  /{,usr/}bin/sort mrix,
  /{,usr/}bin/stat mrix,
  /{,usr/}bin/tail mrix,
  /{,usr/}bin/tr mrix,
  /{,usr/}bin/whoami mrix,
  /{,usr/}bin/xargs mrix,
  /{,usr/}bin/xz mrix,
  /{,usr/}sbin/ldconfig mrix,
  /opt/local/bin/bee mrix,
  /opt/local/bin/grav mrix,
  /opt/tools/bee/ r,
  /opt/tools/bee/** mr,
  /usr/bin/cvs mrix,
  /usr/bin/git mrix,
  /usr/bin/mc mrix,
  /usr/bin/mydumper mrix,
  /usr/bin/myloader mrix,
  /usr/bin/svn mrix,
  /usr/lib/git-core/ r,
  /usr/lib/git-core/** mrix,
  /usr/local/bin/bundle mrix,
  /usr/local/bin/bundler mrix,
  /usr/local/bin/bzr mrix,
  /usr/local/bin/myloader.bin mrix,
  /usr/local/bin/ruby mrix,
  /usr/local/bin/ssh-add mrix,
  /usr/local/libexec/git-core/ r,
  /usr/local/libexec/git-core/** mrix,
  /usr/local/ssl/bin/openssl mrix,
  /usr/local/ssl3/bin/openssl mrix,
  /usr/share/s4cmd/s4cmd.py mrix,

  /data/all/ r,
  /data/all/** r,
  /data/conf/ r,
  /data/conf/** r,
  /data/disk/*/distro/ r,
  /data/disk/all/ r,
  /data/disk/all/** r,
  /etc/ImageMagick-*/ r,
  /etc/ImageMagick-*/** r,
  /etc/mc/ r,
  /etc/mc/** r,
  /etc/mydumper.cnf r,
  /etc/subversion/ r,
  /etc/subversion/* r,
  /etc/vim/ r,
  /etc/vim/** r,
  /etc/wgetrc r,
  /mnt/**/files/*/static/files/ r,
  /mnt/**/files/*/static/files/** rwk,

  # BOA's own folders at a store's root (.backups, .backup-exports, .archived) are no site's
  deny /data/disk/*/static/files/.*/** wkl,
  deny /mnt/**/files/*/static/files/.*/** wkl,
  /tmp/ r,
  /tmp/** rwk,
  /usr/local/share/git-core/templates/ r,
  /usr/local/share/git-core/templates/** r,
  /usr/share/ImageMagick-*/ r,
  /usr/share/ImageMagick-*/** r,
  /usr/share/mc/ r,
  /usr/share/mc/** r,
  /usr/share/mysql/ r,
  /usr/share/mysql/** r,
  /usr/share/vim/ r,
  /usr/share/vim/** r,
  /var/backups/ltd/.cli/*/* r,
  /var/tmp/fpm/ r,
  /var/tmp/fpm/** r,

  # The local database socket
  /etc/mysql/conf.d/ r,
  /etc/mysql/conf.d/* r,
  /etc/mysql/my.cnf r,
  /run/mysqld/mysqld.sock rw,

  # ping is setuid root and opens a raw socket
  capability net_raw,
  capability setuid,
  network inet raw,
  network inet6 raw,
  /usr/local/bin/lshell mrix,

  # Additional binaries allowed in Limited Shell
  /{,usr/}bin/bzip2 mrix,
  /{,usr/}bin/cat mrix,
  /{,usr/}bin/chmod mrix,
  /{,usr/}bin/cp mrix,
  /{,usr/}bin/echo mrix,
  /{,usr/}bin/egrep mrix,
  /{,usr/}bin/grep mrix,
  /{,usr/}bin/gunzip mrix,
  /{,usr/}bin/gzip mrix,
  /{,usr/}bin/ls mrix,
  /{,usr/}bin/mkdir mrix,
  /{,usr/}bin/mv mrix,
  /{,usr/}bin/nano mrix,
  /{,usr/}bin/ping mrix,
  /{,usr/}bin/pwd mrix,
  /{,usr/}bin/rm mrix,
  /{,usr/}bin/rmdir mrix,
  /{,usr/}bin/sed mrix,
  /{,usr/}bin/stty mrix,
  /{,usr/}bin/tar mrix,
  /{,usr/}bin/touch mrix,
  /{,usr/}bin/true mrix,
  /data/disk/*/tools/drush/drush.php mrix,
  /opt/local/bin/checkmyperms mrix,
  /opt/local/bin/mybackup mrix,
  /opt/local/bin/sqlmagic mrix,
  /opt/php*/bin/php mrix,
  /usr/bin/diff mrix,
  /usr/bin/du mrix,
  /usr/bin/env mrix,
  /usr/bin/find mrix,
  /usr/bin/id mrix,
  /usr/bin/mysql mrix,
  /usr/bin/mysqldump mrix,
  /usr/bin/node mrix,
  /usr/bin/openssl mrix,
  /usr/bin/passwd Px -> boa_passwd,
  /usr/bin/patch mrix,
  /usr/bin/rsync mrix,
  /usr/bin/vim.* mrix,
  /usr/bin/tput mrix,
  /usr/bin/unzip mrix,
  /usr/bin/wget mrix,
  /usr/bin/which.debianutils mrix,
  /usr/bin/zstd mrix,
  /usr/lib/node_modules/npm/bin/** mrix,
  /usr/local/bin/composer mrix,
  /usr/local/bin/curl mrix,
  /usr/local/bin/gem mrix,
  /usr/local/bin/git mrix,
  /usr/local/bin/git-receive-pack mrix,
  /usr/local/bin/git-upload-archive mrix,
  /usr/local/bin/git-upload-pack mrix,
  /usr/local/bin/mydumper mrix,
  /usr/local/bin/myloader mrix,
  /usr/local/bin/scp mrix,
  /usr/local/bin/sftp mrix,
  /usr/local/bin/ssh mrix,
  /usr/local/bin/ssh-keygen mrix,
  owner /opt/user/gems/*/** mrix,
  owner /opt/user/npm/*/** mrix,

  # Deny execution of any other binaries
  #deny /** rwklx,
}
