# AppArmor profile for PHP-FPM
# This profile restricts the PHP-FPM (php56) to essential operations only.

#include <tunables/global>

/opt/php56/sbin/php-fpm flags=(attach_disconnected) {

  # Include common AppArmor abstractions
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/php>
  include <abstractions/mysql>

  # Capabilities needed by PHP-FPM
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability kill,
  capability setgid,
  capability setuid,
  capability sys_resource,
  # The master reads a slow child's stack for the slow log
  capability sys_ptrace,
  ptrace (trace, tracedby, read, readby) peer=/opt/php*/sbin/php-fpm,

  # Allow PHP-FPM to accept signal from PHP-CLI processes
  signal (receive) peer=/opt/php*/bin/php,
  signal (receive) peer=boa_sudo_cmd,

  network inet stream,
  network inet6 stream,

  # Allow PHP-FPM to execute its own binary
  /opt/php56/sbin/php-fpm mrix,

  # Allow PHP-FPM to read its configuration files
  /data/conf/ r,
  /data/conf/** r,
  /etc/ImageMagick-6/log.xml r,
  /etc/ImageMagick-6/policy.xml r,
  /etc/ImageMagick-*/ r,
  /etc/ImageMagick-*/** r,
  /usr/share/ImageMagick-*/ r,
  /usr/share/ImageMagick-*/** r,
  /etc/ld.so.cache r,
  /etc/mailname r,
  /etc/newrelic/upgrade_please.key r,
  /etc/postfix/dynamicmaps.cf r,
  /etc/postfix/dynamicmaps.cf.d/ r,
  /etc/postfix/dynamicmaps.cf.d/* r,
  /etc/postfix/main.cf r,
  /home/*/.drush/** r,
  /opt/etc/fpm/** r,
  /var/spool/postfix/maildrop/ r,
  /var/spool/postfix/maildrop/* rw,
  /opt/php56/** r,

  # Allow PHP-FPM to execute some other binaries
  /{,usr/}bin/dash mrix,
  /opt/local/bin/websh mrix,
  /usr/bin/advdef mrix,
  /usr/bin/advpng mrix,
  /usr/bin/chromium mrix,
  /usr/bin/convert mrix,
  /usr/bin/id mrix,
  /usr/bin/jpegoptim mrix,
  /usr/bin/jpegtran mrix,
  /usr/bin/magick mrix,
  /usr/bin/optipng mrix,
  /usr/bin/pngcrush mrix,
  /usr/bin/pngquant mrix,
  /usr/lib/postfix/sbin/smtpd mrix,
  /usr/local/bin/curl mrix,
  /usr/local/bin/wkhtmltoimage mrix,
  /usr/local/bin/wkhtmltopdf mrix,
  /usr/sbin/postdrop mrix,
  /usr/sbin/sendmail mrix,
  /usr/bin/env mrix,
  /usr/bin/which mrix,
  /usr/bin/which.debianutils mrix,
  /usr/local/bin/git mrix,
  /usr/local/libexec/git-core/** mrix,

  # The tools BOA's own list opens to a web account, by the file each really is: convert and
  # magick are links to a versioned program, and the kernel judges the file. Everything else
  # in /usr/bin is closed to a web account by its mode, root:users 750.
  /usr/bin/clamdscan mrix,
  /usr/bin/clamscan mrix,
  /usr/bin/convert-im[67].q16* mrix,
  /usr/bin/ffmpeg mrix,
  /usr/bin/ffprobe mrix,
  /usr/bin/gs mrix,
  /usr/bin/magick-im[67].q16* mrix,
  /usr/bin/node mrix,
  /usr/bin/wget mrix,
  /usr/lib/chromium/** mrix,

  # What those tools read
  /etc/chromium.d/ r,
  /etc/chromium.d/* r,
  /etc/chromium/ r,
  /etc/chromium/** r,
  /etc/clamav/ r,
  /etc/clamav/** r,
  /etc/fonts/ r,
  /etc/fonts/** r,
  /etc/ghostscript/ r,
  /etc/ghostscript/** r,
  /etc/java-*/ r,
  /etc/java-*/** r,
  /etc/ldap/ldap.conf r,
  /etc/wgetrc r,
  /usr/local/share/fonts/ r,
  /usr/local/share/fonts/** r,
  /usr/share/chromium/ r,
  /usr/share/chromium/** r,
  /usr/share/fonts/ r,
  /usr/share/fonts/** r,
  /usr/share/ghostscript/ r,
  /usr/share/ghostscript/** r,
  /var/cache/fontconfig/ r,
  /var/cache/fontconfig/** r,
  /var/lib/clamav/ r,
  /var/lib/clamav/** r,
  /var/lib/ghostscript/ r,
  /var/lib/ghostscript/** r,

  # A master's maps of /dev/zero name /, one line each start, and it keeps them either way
  deny / rw,

  # The data those tools read: fontconfig's own, colour profiles, PDF character maps, time zones
  /etc/magic r,
  /etc/paperspecs r,
  /etc/ssl/openssl.cnf r,
  /etc/vulkan/ r,
  /etc/vulkan/** r,
  /etc/papersize r,
  /etc/udev/udev.conf r,
  /usr/share/color/ r,
  /usr/share/color/** r,
  /usr/share/file/ r,
  /usr/share/file/** r,
  /usr/share/fontconfig/ r,
  /usr/share/fontconfig/** r,
  /usr/share/glib-2.0/schemas/ r,
  /usr/share/glib-2.0/schemas/** r,
  /usr/share/javascript/mathjax/ r,
  /usr/share/javascript/mathjax/** r,
  /usr/share/poppler/ r,
  /usr/share/poppler/** r,
  /usr/share/publicsuffix/ r,
  /usr/share/publicsuffix/** r,
  /usr/share/zoneinfo/ r,
  /usr/share/zoneinfo/** r,

  # A browser asks these of its own processes
  /dev/dri/ r,
  /var/tmp/ r,
  deny /usr/lib/chromium/extensions/ w,
  owner /proc/*/clear_refs w,
  owner /proc/*/coredump_filter rw,
  owner /proc/*/oom_score_adj rw,

  /{,usr/}bin/gawk mrix,
  /{,usr/}bin/mawk mrix,

  # What a browser keeps in the web account's home
  owner /home/*.web/.config/ rw,
  owner /home/*.web/.config/** rwk,
  owner /home/*.web/.local/ rw,
  owner /home/*.web/.local/** rwk,

  # The rest of that list. A shell a site starts stays in this profile, as dash does.
  /{,usr/}bin/bash mrix,
  /opt/jdk/ r,
  /opt/jdk/** mr,
  /opt/jdk/*/bin/java mrix,
  /opt/jdk/*/lib/jspawnhelper mrix,
  /usr/bin/gpg mrix,
  /usr/bin/gpgv mrix,
  /usr/bin/logger mrix,
  /usr/bin/pdf* mrix,
  /usr/bin/rrdtool mrix,
  /usr/bin/wkhtmltoimage{,-0.12.4} mrix,
  /usr/bin/wkhtmltopdf{,-0.12.4} mrix,
  /usr/lib/jvm/*/bin/java mrix,
  /usr/lib/jvm/*/lib/jspawnhelper mrix,
  /usr/lib/node_modules/npm/bin/** mrix,
  /usr/local/bin/compass mrix,
  /usr/local/bin/gem mrix,
  /usr/local/bin/ruby mrix,
  /usr/local/bin/sass mrix,
  /usr/local/bin/sass-convert mrix,
  /usr/local/bin/scss mrix,

  # More of what those tools read
  /opt/jetty9/lib/ r,
  /opt/jetty9/lib/** r,
  /opt/tika*/ r,
  /opt/tika*/** r,
  /usr/share/java/ r,
  /usr/share/java/** r,
  /usr/share/pdftk/ r,
  /usr/share/pdftk/** r,

  # A files store moved to attached storage: the kernel judges the file a link resolves to
  /mnt/**/files/*/static/files/ r,
  /mnt/**/files/*/static/files/** rwk,

  # Allow PHP-FPM to access some /dev
  /dev/null rw,
  /dev/random r,
  /dev/tty wr,
  /dev/urandom r,

  # Allow PHP-FPM to access its run directory
  /run/** rw,

  # Allow PHP-FPM to use tmp files
  /home/*/.tmp/ r,
  /home/*/.tmp/** rwk,
  /tmp/ r,
  /tmp/** rwk,
  /var/tmp/** rwk,

  # Allow read access to necessary libraries
  /lib/** mr,
  /lib/x86_64-linux-gnu/** mr,
  /lib64/** mr,
  /opt/php*/lib/php/** mr,
  /usr/lib/** mr,
  /usr/lib/x86_64-linux-gnu/** mr,
  /usr/libexec/** mr,
  /usr/local/include/** mr,
  /usr/local/ioncube/ioncube_loader_lin_*.so mr,
  /usr/local/lib/** mr,
  /usr/local/ssl/** mr,
  /usr/local/ssl3/** mr,

  # Allow PHP-FPM to read and write its log files
  /var/log/newrelic/php_agent.log rw,
  /var/log/php/** rw,

  # Allow PHP-FPM to access /proc and /sys for necessary information
  /proc/** r,
  /sys/** r,

  # Allow PHP-FPM to use /dev/shm for temporary storage
  /dev/shm/ r,
  /dev/shm/** rwk,

  # Deny execution of binaries from these directories
  deny /home/*/.tmp/** m,
  deny /home/*/** m,
  deny /tmp/** m,
  deny /var/tmp/** m,

  # Allow PHP-FPM to read and write in the custom web root directories

  /var/www/** r,

  /var/aegir/host_master/** r,
  /var/aegir/platforms/** r,

  /data/disk/*/aegir/** r,
  /data/disk/*/distro/** r,
  /data/disk/*/platforms/** r,
  /data/disk/*/static/** r,
  /data/disk/*/tools/le/** r,

  # The panel's download of a backup export reads it here
  /data/disk/*/backup-exports/ r,
  /data/disk/*/backup-exports/* r,
  /var/aegir/backup-exports/ r,
  /var/aegir/backup-exports/* r,

  /data/all/ r,
  /data/all/* r,
  /data/all/** r,
  /data/conf/ r,
  /data/conf/* r,
  /data/conf/** r,

  owner /var/aegir/host_master/** rwk,
  owner /var/aegir/platforms/** rwk,

  owner /data/disk/*/aegir/** rwk,
  owner /data/disk/*/distro/** rwk,
  owner /data/disk/*/platforms/** rwk,
  owner /data/disk/*/static/** rwk,
  owner /var/www/** rwk,

  # A site's writable folders are <user>:<web group> 02775: PHP-FPM writes there by group, on
  # files the backend user owns, never by being their owner, so these cannot be owner rules.
  # A rule here cannot name the account: until the account that owns a folder is at web group
  # phase A, its group is the shared www-data, and only that group keeps accounts apart.
  /data/disk/*/static/files/*/ r,
  /data/disk/*/static/files/*/** rwk,
  /data/disk/*/{aegir,distro,platforms,static}/**/sites/*/{assets,backup,cache,files,images,logs,private,tmp,user}/ rw,
  /data/disk/*/{aegir,distro,platforms,static}/**/sites/*/{assets,backup,cache,files,images,logs,private,tmp,user}/** rwk,
  /data/disk/*/{aegir,distro,platforms,static}/**/sites/*/admin/plugins/ rw,
  /data/disk/*/{aegir,distro,platforms,static}/**/sites/*/admin/plugins/** rwk,
  /data/disk/*/{aegir,distro,platforms,static}/**/sites/*/public/{files,images,themes}/ rw,
  /data/disk/*/{aegir,distro,platforms,static}/**/sites/*/public/{files,images,themes}/** rwk,
  /var/aegir/{host_master,platforms}/**/sites/*/{files,private}/ rw,
  /var/aegir/{host_master,platforms}/**/sites/*/{files,private}/** rwk,

  # BOA's own folders at a store's root (.backups, .backup-exports, .archived) are no site's
  deny /data/disk/*/static/files/.*/** wkl,
  deny /mnt/**/files/*/static/files/.*/** wkl,

  /home/*.web/.aws/ r,
  /home/*.web/.aws/* rw,
  /home/*.web/.drush/ r,
  /home/*.web/.drush/* r,
  /home/*.web/.tmp/ r,
  /home/*.web/.tmp/* rwk,

  # Deny access to various sensitive directories and files
  deny /boot/** mrwklx,
  deny /etc/shadow* rwlx,
  deny /root/** mrwklx,

  # Catchall to deny everything else
  #deny /** rwklx,

  # Site-specific additions and overrides can be added below
}
