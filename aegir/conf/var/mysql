#!/bin/bash
### BEGIN INIT INFO
# Provides:          mysql
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start and stop Percona MySQL server
# Description:       Manage the Percona MySQL server daemon
### END INIT INFO

# Path to Percona MySQL executable
DAEMON=/usr/sbin/mysqld
MYSQL_OPTS=""

# PID file location
PIDFILE=/run/mysqld/mysqld.pid

# Configuration file location
MYCNF=/etc/mysql/my.cnf

# Logging
LOGFILE=/var/log/mysql/mysql.log
ERRORLOG=/var/log/mysql/error.log

# Memory allocator: _SQL_MALLOC in the barracuda config, read at every start.
# Under transparent huge pages "always" the kernel backs jemalloc's partly
# used extents with whole huge pages and keeps memory resident that jemalloc
# has given back, as with Valkey, which runs on jemalloc with disable-thp.
# thp:never takes huge pages off jemalloc's own mappings only: the buffer
# pool chunks are mapped apart and keep the system mode.
BARCNF=/root/.barracuda.cnf
JEMALLOC=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
JEMALLOC_CONF="thp:never"

# Ensure the Percona MySQL directory exists
[ -d /run/mysqld ] || mkdir -p /run/mysqld
chown mysql:mysql /run/mysqld

# Sets _MALLOC_LIB to the library to preload, or empty for glibc, and
# _MALLOC_WHY to the reason a requested jemalloc is not used. Any value other
# than jemalloc means glibc. The config is read in a subshell the way the
# barracuda run reads it, so both see the same value and nothing else of it
# reaches this script.
pick_malloc() {
    _MALLOC_LIB=""
    _MALLOC_WHY=""
    _MALLOC_SET=""
    [ -r "$BARCNF" ] && _MALLOC_SET=$(unset _SQL_MALLOC; . "$BARCNF" > /dev/null 2>&1; echo "$_SQL_MALLOC")
    if [ "$_MALLOC_SET" = "jemalloc" ]; then
        if [ -r "$JEMALLOC" ]; then
            _MALLOC_LIB="$JEMALLOC"
        else
            _MALLOC_WHY="_SQL_MALLOC=jemalloc, but $JEMALLOC is missing"
        fi
    elif [ -n "$_MALLOC_SET" ] && [ "$_MALLOC_SET" != "glibc" ]; then
        _MALLOC_WHY="_SQL_MALLOC=$_MALLOC_SET is not glibc or jemalloc"
    fi
}

# One error log line naming the allocator the started server runs on, read
# from its own memory map, and the transparent huge pages mode it started
# under.
log_malloc() {
    _PID=$(pgrep -x mysqld | head -n 1)
    [ -n "$_PID" ] || return 0
    _THP=$(sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/kernel/mm/transparent_hugepage/enabled 2> /dev/null)
    if grep -q libjemalloc "/proc/$_PID/maps" 2> /dev/null; then
        _ALLOC="jemalloc ($JEMALLOC_CONF)"
    else
        [ -n "$_MALLOC_LIB" ] && _MALLOC_WHY="$_MALLOC_LIB did not load"
        _ALLOC="glibc malloc"
        [ -n "$_MALLOC_WHY" ] && _ALLOC="$_ALLOC ($_MALLOC_WHY)"
    fi
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) BOA: mysqld $_PID started on $_ALLOC, transparent huge pages ${_THP:-unknown}" >> "$ERRORLOG"
}

# Start Percona MySQL Server
start_mysql() {
    echo "Starting MySQL"
    if [ -f $PIDFILE ]; then
        echo "Percona MySQL is already running."
        return 1
    fi
    # The pid file appears only when the server is ready to serve. A server
    # converting a 5.7 datadir, or recovering, runs for minutes to hours
    # without one, and a second server started beside it would fight it for
    # the datadir.
    if pgrep -x mysqld > /dev/null 2>&1; then
        echo "Percona MySQL is already running: starting up, no PID file yet."
        return 1
    fi

    # The server writes its startup messages to the error log once it has
    # read that directive; before that, and when the directive is missing,
    # they go to stderr. Keep them: a start nobody can read cannot be
    # diagnosed. The file is created as the server itself creates it.
    [ -d "$(dirname $ERRORLOG)" ] || mkdir -p "$(dirname $ERRORLOG)"
    if [ ! -e "$ERRORLOG" ]; then
        touch "$ERRORLOG"
        chown mysql:adm "$ERRORLOG" 2> /dev/null
        chmod 0640 "$ERRORLOG"
    fi

    # Start MySQL. The preload is set on the server's own command line, so
    # it reaches no other process: the mysql client, mysql_upgrade and every
    # script started after this one keep glibc.
    pick_malloc
    if [ -n "$_MALLOC_LIB" ]; then
        LD_PRELOAD="$_MALLOC_LIB" MALLOC_CONF="$JEMALLOC_CONF" $DAEMON --defaults-file=$MYCNF $MYSQL_OPTS > /dev/null 2>> "$ERRORLOG" &
    else
        $DAEMON --defaults-file=$MYCNF $MYSQL_OPTS > /dev/null 2>> "$ERRORLOG" &
    fi
    sleep 5
    log_malloc

    if [ -f $PIDFILE ]; then
        echo "Percona MySQL started successfully."
    elif pgrep -x mysqld > /dev/null 2>&1; then
        echo "Percona MySQL is starting; no PID file yet. A data dictionary upgrade"
        echo "or a crash recovery may be running, minutes to hours on a large datadir:"
        echo "follow $ERRORLOG and do not stop or kill mysqld."
    else
        echo "Percona MySQL failed to start, see $ERRORLOG."
        return 1
    fi
}

# Stop Percona MySQL Server
stop_mysql() {
    echo "Stopping MySQL"
    if [ ! -f $PIDFILE ]; then
        echo "Percona MySQL is not running."
        return 1
    fi

    kill `cat $PIDFILE`
    # A clean shutdown flushes the buffer pool: seconds on a small server,
    # minutes on a large one. Wait for the process to go, so that a restart
    # never starts the next server beside the old one (the start refuses a
    # server that is still running).
    _i=0
    while pgrep -x mysqld > /dev/null 2>&1 && [ $_i -lt 600 ]; do
        sleep 1
        _i=$((_i + 1))
    done

    if pgrep -x mysqld > /dev/null 2>&1; then
        echo "Percona MySQL failed to stop within 10 minutes."
        return 1
    else
        # a server that was killed hard leaves its pid file behind
        rm -f $PIDFILE
        echo "Percona MySQL stopped successfully."
    fi
}

# Restart Percona MySQL Server
restart_mysql() {
    stop_mysql
    start_mysql
}

# Status of Percona MySQL Server
status_mysql() {
    if [ -f $PIDFILE ]; then
        echo "Percona MySQL is running (PID: `cat $PIDFILE`)."
    else
        echo "Percona MySQL is not running."
        return 1
    fi
}

case "$1" in
    start)
        start_mysql
        ;;
    stop)
        stop_mysql
        ;;
    restart)
        restart_mysql
        ;;
    status)
        status_mysql
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
esac

exit 0
