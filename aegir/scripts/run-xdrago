#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=dev

_H_USER=EDIT_USER

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    ionice -c2 -n7 -p $$
    renice 9 -p $$
    chmod a+w /dev/null
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
}
_check_root

# Every lock this script takes lives in a directory only root can enter:
# flock needs no more than read access, so a lock file another identity can
# open is one it can hold for good, stopping this account's runner or its
# store ticks.
_XDRAGO_LOCKS="/run/run-xdrago"
_xdrago_lock_dir() {
  [[ -L "${_XDRAGO_LOCKS}" ]] && return 1
  if [[ ! -d "${_XDRAGO_LOCKS}" ]]; then
    ( umask 077; mkdir -p "${_XDRAGO_LOCKS}" ) 2> /dev/null || return 1
  fi
  [[ "$(stat -c '%u' "${_XDRAGO_LOCKS}" 2> /dev/null)" = "0" ]] || return 1
  chmod 0700 "${_XDRAGO_LOCKS}" 2> /dev/null
}

# A Grav store (KahunaCart) needs its worker every minute: it sends the order
# mail a request did not get to, mints download grants and runs the sweeps,
# the reminders and the renewals. Each enabled site of this instance whose
# capsule carries KahunaCart and names its database in drushrc.php gets one
# `bin/plugin kahunacart work`, the one job KahunaCart registers with Grav's
# scheduler (its add-ons work through its queue). Grav's whole scheduler is
# never run: it would also run the custom jobs a site's admins can define,
# which are shell commands. A store kept in its own SQLite file is left
# alone: the copy safeguards (signing key, pause, hold) act on the database
# on record. A copy of a store (its capsule carries .boa-copy) is left alone
# too until Cutover makes it the live store or the account releases it with
# static/control/kahunacart-run.<domain>.info: a copy must not mail or bill
# the source's customers. Only a release file newer than the copy's marker
# counts: it is keyed by the domain alone, and an older one, left by an
# earlier copy at the same staging domain, must not release a new copy.
#
# The worker runs inside the site's own PHP-FPM pool: root sends one FastCGI
# request straight to the pool's socket (never through the web server) for
# an entry script BOA keeps in /data/conf, so the worker runs as the pool
# user under the pool's own limits, exactly as a web request of the site
# does. Nothing the pool cannot already do is handed to the plugin code it
# loads from the web-writable user/ tree. The instance user reads the
# account's site aliases, a capsule's drushrc.php and hold and the site's
# vhost (never root, which could be pointed at another account's file or a
# device), and root passes the validated database settings as request
# parameters, as the site's vhost does, never on a command line.
#
# The scan runs in a detached pass with a lock of its own, started before
# this script's own lock, so a long Aegir task never holds a store's queue,
# and takes the stores in a new order every minute; each store's tick is
# detached again under a lock of its own, so one slow store never delays
# another. A tick takes one of its pool's tick slots before it is sent, one
# on a pool of fewer than eight children and two on a larger one, so the
# sites on that pool keep children for their visitors; a tick that finds them
# taken waits up to about two minutes, then leaves its store to the next
# minute. The entry script runs only a request sent within the last fifteen
# seconds: the pool ends a request 180 seconds after it starts, plus the few
# seconds between its own checks, and root waits 200, so one that waited
# longer in a busy pool could run beside the next minute's tick. The
# instance user's reads are size-bound and never follow a link or wait on a
# FIFO.

# The entry script of this instance's ticks: each instance keeps its own, so
# instances whose runners come from different BOA releases never replace
# each other's.
_GRAV_TICK_ENTRY="/data/conf/grav-store-tick-${_H_USER}.php"

# Write the entry script, kept identical to the copy below, only when it
# differs: root's, readable by the pools (/data/conf is in each one's
# open_basedir).
_grav_tick_entry() {
  local _new="/data/conf/.grav-store-tick-${_H_USER}.php.new" _php
  [[ -d /data/conf ]] && [[ ! -L /data/conf ]] || return 1
  _php="$(cat <<'PHP'
<?php
/**
 * BOA: one KahunaCart worker tick for a Grav store.
 *
 * Sent by BOA's minute runner (run-xdrago) straight to the site's own PHP-FPM
 * pool socket, never through the web server, so the worker runs as the site's
 * pool user under the pool's own limits. The store's database settings arrive
 * as request parameters, as the site's vhost passes them. Written by
 * run-xdrago; an edit here is overwritten.
 */
if (PHP_SAPI !== 'fpm-fcgi' || !isset($_SERVER['BOA_GRAV_TICK_ROOT'])) {
  exit;
}
// Only a request sent within the last fifteen seconds runs: one that waited
// longer in a busy pool could still run beside the next minute's tick.
$sent = isset($_SERVER['BOA_GRAV_TICK_SENT']) ? (int) $_SERVER['BOA_GRAV_TICK_SENT'] : 0;
if ($sent <= 0 || time() - $sent > 15) {
  exit;
}
$root = (string) $_SERVER['BOA_GRAV_TICK_ROOT'];
if (!preg_match('#^/data/disk/[a-z0-9]+/[A-Za-z0-9._/-]+$#', $root) || strpos($root, '..') !== FALSE) {
  exit;
}
if (!is_file($root . '/system/defines.php') || !is_file($root . '/bin/plugin')
  || !is_file($root . '/user/plugins/kahunacart/kahunacart.php') || !@chdir($root)) {
  exit;
}
// BOA's pools disable getmypid(), and KahunaCart names its worker and its
// leases with it. A stand-in for this request only, never the real pid (the
// pool keeps that hidden), lets the worker run here.
if (!function_exists('getmypid')) {
  function getmypid() {
    static $id = 0;
    if ($id === 0) {
      $id = random_int(100000, 2147483646);
    }
    return $id;
  }
}
foreach (array('STDIN' => 'r', 'STDOUT' => 'w', 'STDERR' => 'w') as $name => $mode) {
  if (!defined($name)) {
    define($name, fopen('php://' . strtolower($name), $mode));
  }
}
$argv = array('bin/plugin', 'kahunacart', 'work', '--quiet');
$argc = count($argv);
$_SERVER['argv'] = $argv;
$_SERVER['argc'] = $argc;
require $root . '/bin/plugin';
PHP
)" || return 1
  if [[ -f "${_GRAV_TICK_ENTRY}" ]] && [[ ! -L "${_GRAV_TICK_ENTRY}" ]] \
    && printf '%s\n' "${_php}" | cmp -s - "${_GRAV_TICK_ENTRY}"; then
    return 0
  fi
  ( umask 022; printf '%s\n' "${_php}" > "${_new}" ) || return 1
  chmod 0644 "${_new}" && mv -f "${_new}" "${_GRAV_TICK_ENTRY}"
}

# The pool socket one site's PHP runs on: $1, the one its vhost passes PHP to
# (as provision last rendered it, read by the instance user), else the pool
# the Grav vhost template picks now: the first socket among 8.4, 8.5, 8.6 and
# 8.3, else the bare one. Sets _GRAV_SOCK.
_grav_site_socket() {
  local _sock="${1}" _v
  _GRAV_SOCK=""
  if [[ "${_sock}" =~ ^/run/${_H_USER}(\.8[3-6])?\.fpm\.socket$ ]] && [[ -S "${_sock}" ]]; then
    _GRAV_SOCK="${_sock}"
    return 0
  fi
  for _v in 84 85 86 83; do
    if [[ -S "/run/${_H_USER}.${_v}.fpm.socket" ]]; then
      _GRAV_SOCK="/run/${_H_USER}.${_v}.fpm.socket"
      return 0
    fi
  done
  if [[ -S "/run/${_H_USER}.fpm.socket" ]]; then
    _GRAV_SOCK="/run/${_H_USER}.fpm.socket"
    return 0
  fi
  return 1
}

# One store's tick: $1 the capsule, $2 its domain. Runs in a subshell of its
# own, so the environment it clears and the exports below reach nothing else.
_grav_store_tick() {
  local _sp="${1}" _uri="${2}" _rc _rcd _vs _n _u _p _h _o _v _k _e
  # As the instance user: the hold, drushrc.php, then after a separator line
  # the PHP socket line of the site's vhost.
  _rc="$(timeout 20 su -s /bin/bash "${_H_USER}" -c "cd -P -- '${_sp}' 2>/dev/null || exit 1; if [ -e .boa-copy ] && ! [ '/data/disk/${_H_USER}/static/control/kahunacart-run.${_uri}.info' -nt .boa-copy ]; then exit 3; fi; [ -f drushrc.php ] && [ ! -L drushrc.php ] || exit 1; timeout 10 dd if=./drushrc.php iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none || exit 1; echo; echo '#boa-grav-vhost'; timeout 10 dd if='/data/disk/${_H_USER}/config/server_master/nginx/vhost.d/${_uri}' iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2>/dev/null | grep -m1 -o 'fastcgi_pass unix:/run/${_H_USER}[.0-9]*\.fpm\.socket;'; exit 0" 2> /dev/null < /dev/null 6>&- 7>&-)" || return 0
  _rcd="$(printf '%s\n' "${_rc}" | sed '/^#boa-grav-vhost$/,$d')"
  _vs="$(printf '%s\n' "${_rc}" | sed -n '/^#boa-grav-vhost$/,$p' | sed -n 's/^fastcgi_pass unix:\(.*\);$/\1/p' | head -1)"
  _rc=""
  _grav_site_socket "${_vs}" || return 0
  _n="$(printf '%s\n' "${_rcd}" | sed -n "s/^.*\$options\['db_name'\] = '\([^']*\)';.*$/\1/p" | head -1)"
  _u="$(printf '%s\n' "${_rcd}" | sed -n "s/^.*\$options\['db_user'\] = '\([^']*\)';.*$/\1/p" | head -1)"
  _p="$(printf '%s\n' "${_rcd}" | sed -n "s/^.*\$options\['db_passwd'\] = '\([^']*\)';.*$/\1/p" | head -1)"
  _h="$(printf '%s\n' "${_rcd}" | sed -n "s/^.*\$options\['db_host'\] = '\([^']*\)';.*$/\1/p" | head -1)"
  _o="$(printf '%s\n' "${_rcd}" | sed -n "s/^.*\$options\['db_port'\] = '\([^']*\)';.*$/\1/p" | head -1)"
  _rcd=""
  [[ -n "${_n}" ]] && [[ -n "${_u}" ]] && [[ -n "${_p}" ]] || return 0
  [[ -n "${_o}" ]] || _o=3306
  [[ -n "${_h}" ]] || _h=localhost
  if [[ "${_h}" = "localhost" ]] && [[ "${_o}" != "3306" ]]; then
    _h=127.0.0.1
  fi
  for _v in "${_n}" "${_u}" "${_p}" "${_h}" "${_o}"; do
    [[ "${_v}" =~ ^[A-Za-z0-9._:-]+$ ]] || return 0
  done
  _grav_tick_slot "${_GRAV_SOCK}" || return 0
  # A wait for the slot can outlast the hold read above: an owner may hold
  # the copy again meanwhile, so read the hold once more.
  if [[ "${_GRAV_SLOT_WAITED}" = "YES" ]]; then
    timeout 20 su -s /bin/bash "${_H_USER}" -c "cd -P -- '${_sp}' 2>/dev/null || exit 1; if [ -e .boa-copy ] && ! [ '/data/disk/${_H_USER}/static/control/kahunacart-run.${_uri}.info' -nt .boa-copy ]; then exit 3; fi; exit 0" > /dev/null 2>&1 < /dev/null 6>&- 7>&- || return 0
  fi
  # cgi-fcgi sends its whole environment as the request's parameters: only
  # what the entry script and the store need reaches the pool.
  for _e in $(compgen -e); do
    unset "${_e}"
  done
  export PATH=/usr/bin:/bin
  export SCRIPT_FILENAME="${_GRAV_TICK_ENTRY}"
  export SCRIPT_NAME=/grav-store-tick.php
  export REQUEST_METHOD=GET
  export QUERY_STRING=
  export BOA_GRAV_TICK_ROOT="${_sp}"
  _k="GRAV_CONFIG__plugins__kahunacart__database__"
  export GRAV_CONFIG=1
  export "${_k}type=mysql"
  export "${_k}auto_migrate=manual"
  export "${_k}mysql__host=${_h}"
  export "${_k}mysql__port=${_o}"
  export "${_k}mysql__dbname=${_n}"
  export "${_k}mysql__username=${_u}"
  export "${_k}mysql__password=${_p}"
  BOA_GRAV_TICK_SENT="$(date +%s)"
  export BOA_GRAV_TICK_SENT
  /usr/bin/timeout 200 /usr/bin/cgi-fcgi -bind -connect "${_GRAV_SOCK}" \
    > /dev/null 2>&1 < /dev/null 6>&- 7>&-
}

# The tick slots of the pool behind socket $1, read from its pool file
# (root's own, /opt/phpNN/etc/pool.d/<pool>.conf): one on a pool of fewer
# than eight children, two on a larger one.
_grav_tick_slots() {
  local _pool="${1#/run/}" _f _n=""
  _pool="${_pool%.fpm.socket}"
  for _f in /opt/php*/etc/pool.d/"${_pool}".conf; do
    [[ -f "${_f}" ]] && [[ ! -L "${_f}" ]] || continue
    _n="$(sed -n 's/^pm\.max_children = \([0-9]*\)$/\1/p' "${_f}" 2> /dev/null | tail -n 1)"
    break
  done
  if [[ "${_n}" =~ ^[0-9]+$ ]] && [[ "${_n}" -ge 8 ]]; then
    echo 2
  else
    echo 1
  fi
}

# Take one of the tick slots of the pool behind socket $1 on fd 6, held until
# the tick's subshell ends. All taken: try again every two seconds for up to
# 110, then leave this store to the next minute. Sets _GRAV_SLOT_WAITED to
# YES when it had to wait.
_grav_tick_slot() {
  local _pool="${1#/run/}" _max _i _t=0 _sl
  _pool="${_pool%.fpm.socket}"
  _GRAV_SLOT_WAITED=NO
  _max="$(_grav_tick_slots "${1}")"
  for (( _i = 1; _i <= _max; _i++ )); do
    ( umask 077; : >> "${_XDRAGO_LOCKS}/grav-slot-${_pool}-${_i}.lock" ) 2> /dev/null || return 1
  done
  while [[ "${_t}" -lt 110 ]]; do
    for (( _i = 1; _i <= _max; _i++ )); do
      _sl="${_XDRAGO_LOCKS}/grav-slot-${_pool}-${_i}.lock"
      exec 6>"${_sl}"
      if flock -n 6; then
        return 0
      fi
      exec 6>&-
    done
    _GRAV_SLOT_WAITED=YES
    sleep 2
    _t=$(( _t + 2 ))
  done
  return 1
}

_grav_store_ticks() {
  local _sp _uri _lk _shuf
  _grav_tick_entry || return 0
  _shuf="$(command -v shuf || echo cat)"
  # One pass over every alias, listed by the instance user (the account's
  # .drush is its own, so root opens no name there), one separator line
  # before each file: an enabled site's site_path and uri, each a whole
  # quoted value on its own two-space-indented line, the first match per
  # file, in a new order every minute so that busy stores never keep the
  # same others waiting for a slot.
  while IFS=$'\t' read -r _sp _uri; do
    [[ "${_sp}" =~ ^/data/disk/${_H_USER}/[A-Za-z0-9._/-]+$ ]] || continue
    [[ "${_sp}" != *..* ]] || continue
    [[ "${_uri}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || continue
    [[ -f "${_sp}/system/defines.php" ]] || continue
    [[ -f "${_sp}/user/plugins/kahunacart/kahunacart.php" ]] || continue
    _lk="${_XDRAGO_LOCKS}/grav-tick-${_H_USER}-${_uri}.lock"
    ( umask 077; : >> "${_lk}" ) 2> /dev/null || continue
    (
      exec 8>&-
      exec 7>"${_lk}"
      flock -n 7 || exit 0
      _grav_store_tick "${_sp}" "${_uri}"
    ) < /dev/null > /dev/null 2>&1 &
  done < <(timeout 60 su -s /bin/bash "${_H_USER}" -c "cd -P -- '/data/disk/${_H_USER}/.drush' 2>/dev/null || exit 0; for _f in *.alias.drushrc.php; do [ -f \"\${_f}\" ] && [ ! -L \"\${_f}\" ] || continue; echo; echo '#boa-alias-file'; timeout 10 dd if=\"./\${_f}\" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none; done" 2> /dev/null < /dev/null 7>&- 8>&- \
    | awk -v q="'" '
      function val(line, key,   p, v) {
        p = "  " q key q " => " q
        if (index(line, p) != 1) return ""
        v = substr(line, length(p) + 1)
        if (substr(v, length(v) - 1) != q ",") return ""
        v = substr(v, 1, length(v) - 2)
        if (index(v, q) > 0) return ""
        return v
      }
      function emit() {
        if (ctx == "site" && en == "true" && sp != "" && uri != "") print sp "\t" uri
        ctx = ""; en = ""; sp = ""; uri = ""
      }
      $0 == "#boa-alias-file" { emit(); next }
      $0 == "  " q "context_type" q " => " q "site" q "," { ctx = "site" }
      $0 == "  " q "site_enabled" q " => true," && en == "" { en = "true" }
      $0 == "  " q "site_enabled" q " => false," && en == "" { en = "false" }
      sp == "" { v = val($0, "site_path"); if (v != "") sp = v }
      uri == "" { v = val($0, "uri"); if (v != "") uri = v }
      END { emit() }
    ' 2> /dev/null | "${_shuf}" 2> /dev/null)
  touch /var/log/boa/grav-ticks-${_H_USER}
}

_grav_store_ticks_detached() {
  local _gl="${_XDRAGO_LOCKS}/grav-ticks-${_H_USER}.lock"
  [[ -e "/run/boa_wait.pid" ]] && return 0
  grep -q "^_GRAV_SUPPORT=YES" "/root/.${_H_USER}.octopus.cnf" 2>/dev/null || return 0
  [[ -x "/opt/local/bin/grav" ]] || return 0
  [[ -x "/usr/bin/cgi-fcgi" ]] || return 0
  command -v flock > /dev/null 2>&1 || return 0
  _xdrago_lock_dir || return 0
  ( umask 077; : >> "${_gl}" ) 2>/dev/null || return 0
  # Started from a command substitution so this script's own bare `wait`
  # calls never wait for it (it is never one of this shell's jobs).
  _GRAV_TICKS_PID="$( (
    exec 8>"${_gl}"
    flock -n 8 || exit 0
    _grav_store_ticks
  ) < /dev/null > /dev/null 2>&1 & echo "$!" )"
}
_grav_store_ticks_detached

# Serialise per instance. Overlapping cron runner.sh passes, the fast-schedule
# loop, and the accelerated install/upgrade loop can all invoke run-xdrago for
# the same instance at once; each would fire hosting-dispatch and waste a parallel
# "drush cc drush" storm. The front-end dispatcher is the authoritative guard
# against duplicate launches; this is best-effort de-duplication. Take a
# non-blocking per-user lock on fd 9 (released automatically on exit, no stale
# lockfile); a concurrent run exits cleanly. If the lockfile cannot be created
# (e.g. /run not writable) fall through and run unlocked rather than stall.
_runLock="${_XDRAGO_LOCKS}/run-xdrago-${_H_USER}.lock"
if command -v flock >/dev/null 2>&1 && _xdrago_lock_dir \
  && ( umask 077; : >> "${_runLock}" ) 2>/dev/null; then
  exec 9>"${_runLock}"
  flock -n 9 || exit 0
fi

# The account's static/control is its main login's and oN owns the rest of
# /data/disk/oN: either can put a link or a FIFO at any name there, or swap
# the directory itself for a link. Run "$@" inside the real directory $1
# only (every name below /data/disk a real directory), so ./name never
# leads out of the account.
_run_in_real_dir() {
  local _d="${1}" _want
  shift
  _want="$(cd -P -- /data/disk 2> /dev/null && pwd -P)${_d#/data/disk}"
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_want}" ] && "$@" )
}

# backups is oN's too, and a link by design once the backups mover has put
# it on the files store (static/files/.backups). Run "$@" inside the
# directory $1 resolves to, only when that lies in the account's own tree or
# its own files store moved onto attached storage
# (/mnt/<mount>/files/<oN>/static/files, the mount itself possibly nested,
# with no directory named files or static between /mnt and the mount, as
# migratefs makes it and the nightly decides it).
_run_in_own_store() {
  local _a _r _m
  _a=$(realpath -e -- "/data/disk/${_H_USER}" 2> /dev/null) || return 1
  _r=$(realpath -e -- "${1}" 2> /dev/null) || return 1
  shift
  case "${_r}" in
    ""|*[!A-Za-z0-9._/-]*) return 1 ;;
    "${_a}"/?*) ;;
    /mnt/?*/files/"${_H_USER}"/static/files/?*)
      _m="${_r%%/files/"${_H_USER}"/static/files/*}"
      case "${_m}" in
        */files/*|*/static/*) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
  ( cd -P -- "${_r}" 2> /dev/null && [ "$(pwd -P)" = "${_r}" ] && "$@" )
}

# The uids root's walks over the account $1's trees act on, comma-separated:
# root's own (0, what root wrote there for the account) and those of every
# identity of the account as passwd names them: oN and oN.<name>, that is
# its .ftp login, its client sub-accounts oN.<client> and oN.<client>-dev
# and its PHP-FPM users oN.web and oN.<ver>.web. An account name holds no
# dot, so the match is exact: o1 never takes o10's. Status 1, and nothing,
# unless the account itself is in passwd. The walks also take a uid no passwd
# entry names as the account's own: a login removed before the limited-shell
# worker handed its files to the account at removal left those. Nothing
# records which account a freed number served, so such an entry is taken
# wherever it came from. A lookup that fails, rather than finding no such
# user, leaves the entry another user's.
_acct_walk_uids() {
  local _a="${1}" _n _p _u _r _x="0" _self=NO
  case "${_a}" in
    ""|*[!a-z0-9-]*) return 1 ;;
  esac
  while IFS=: read -r _n _p _u _r; do
    [[ "${_n}" =~ ^${_a}(\.[a-z0-9]+(-dev)?|\.[0-9]+\.web)?$ ]] || continue
    [[ "${_u}" =~ ^[1-9][0-9]*$ ]] || continue
    _x="${_x},${_u}"
    [ "${_n}" = "${_a}" ] && _self=YES
  done < <(getent passwd 2> /dev/null)
  [ "${_self}" = "YES" ] || return 1
  echo "${_x}"
}
# Root's removals in an account's trees, run inside the directory they act in:
# only what the uids given second own (_acct_walk_uids), or a uid no passwd
# entry names (sub own), is removed or unlocked, and nothing below a directory
# another named uid owns. The account's identities can rename into their own
# trees what another account left group-writable, a whole directory with
# everything nested in it, so such a directory stays whole. Nothing is done
# unless the current directory and every directory above it, up to /, are
# owned by those uids or by one no passwd entry names, read through '..' from
# where the walk stands. A directory is entered through a handle opened
# without following a link, only as the directory lstat saw, and its entries
# are acted on by name from inside it. The first argument is the act, on the
# names after the third:
#   r  each removed, a directory depth first, then itself once empty
#   u  each unlocked (+i cleared through a handle), a directory with
#      everything below it the walk reaches
#   h  each removed unless it is a directory (find's hits)
# or, the third argument a number of days, on the current directory:
#   d  every entry below it older than that (find -mtime +N) removed as r
#      removes it, younger directories searched alike, top-level dot
#      names kept
#   a  as d, the top-level dot names included
#   f  as d, regular files only, every directory searched
# Prints dev:ino of each entry left because another uid owns it, and of
# the directory another uid owns above the place when the walk refuses
# it; status 3 when one was, 1 when a removal failed.
_ACCT_RM_OWN_PL='use Fcntl;
my ($op, $ul, $days, @f) = @ARGV;
my %own = map { $_ => 1 } grep { /^[0-9]+$/ } split(/,/, defined($ul) ? $ul : "");
sub own { my $u = shift; unless (exists $own{$u}) { local $! = 0; $own{$u} = defined(getpwuid($u)) ? 0 : ($! == 0 || $!{ENOENT} || $!{ESRCH} || $!{EBADF} || $!{EPERM}) ? 1 : 0; } return $own{$u}; }
my ($left, $bad, $now) = (0, 0, time);
sub left { my ($l) = @_; print "$l->[0]:$l->[1]\n"; $left++; }
sub done { exit($bad ? 1 : $left ? 3 : 0); }
my ($p, $ok, @d, @x) = (".", 0);
for (1 .. 256) {
  @x = stat($p) or last;
  last unless own($x[4]);
  if (@d && $x[0] == $d[0] && $x[1] == $d[1]) { $ok = 1; last; }
  @d = @x;
  $p .= "/..";
}
unless ($ok) { left(\@x) if @x && !own($x[4]); $left = 1; done(); }
sub kids {
  opendir(my $h, ".") or do { $bad = 1; return (); };
  my @n = grep { $_ ne "." && $_ ne ".." } readdir($h);
  closedir($h);
  return @n;
}
sub into {
  my ($n, $l, $cb) = @_;
  sysopen(my $up, ".", O_RDONLY | O_DIRECTORY) or do { $bad = 1; return 0; };
  sysopen(my $dn, $n, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_NONBLOCK)
    or do { $bad = 1; return 0; };
  my @s = stat($dn);
  unless (@s && $s[0] == $l->[0] && $s[1] == $l->[1] && chdir($dn)) {
    $bad = 1;
    return 0;
  }
  close($dn);
  $cb->();
  chdir($up) or die "no way back\n";
  return 1;
}
sub rmown {
  my ($n) = @_;
  my @l = lstat($n) or return;
  unless (own($l[4])) { left(\@l); return; }
  if (-d _) {
    into($n, \@l, sub { rmown($_) for kids(); }) or return;
    rmdir($n) or $!{ENOTEMPTY} or $!{EEXIST} or $bad = 1;
  } else {
    unlink($n) or $bad = 1;
  }
}
sub noimm {
  my ($n, $l) = @_;
  sysopen(my $h, $n, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
  my @s = stat($h);
  if (@s && $s[0] == $l->[0] && $s[1] == $l->[1] && own($s[4])) {
    my $b = pack("L", 0);
    if (ioctl($h, 0x80086601, $b)) {
      my $fl = unpack("L", $b);
      ioctl($h, 0x40086602, pack("L", $fl & ~0x10)) if $fl & 0x10;
    }
  }
  close($h);
}
sub unown {
  my ($n) = @_;
  my @l = lstat($n) or return;
  return unless own($l[4]);
  if (-d _) {
    noimm($n, \@l);
    into($n, \@l, sub { unown($_) for kids(); });
  } elsif (-f _ && $l[3] == 1) {
    noimm($n, \@l);
  }
}
sub aged { return int(($now - $_[0]->[9]) / 86400) > $days; }
sub sel {
  my ($n, $top) = @_;
  return if $top && $op ne "a" && substr($n, 0, 1) eq ".";
  my @l = lstat($n) or return;
  unless (own($l[4])) { left(\@l); return; }
  if ($op eq "f") {
    if (-d _) {
      into($n, \@l, sub { sel($_, 0) for kids(); });
    } elsif (-f _ && aged(\@l)) {
      unlink($n) or $bad = 1;
    }
  } elsif (aged(\@l)) {
    rmown($n);
  } elsif (-d _) {
    into($n, \@l, sub { sel($_, 0) for kids(); });
  }
}
if ($op eq "r") {
  rmown($_) for @f;
} elsif ($op eq "u") {
  unown($_) for @f;
} elsif ($op eq "h") {
  for my $n (@f) {
    my @l = lstat($n) or next;
    next if -d _;
    if (own($l[4])) { unlink($n) or $bad = 1; } else { left(\@l); }
  }
} elsif ($op =~ /^[adf]$/ && defined($days) && $days =~ /^[0-9]+$/) {
  sel($_, 1) for kids();
} else {
  exit 2;
}
done();'

# Empty the current (pinned) .tmp: the glob expands here, and rm -rf removes
# a link itself, never what it points at.
_run_tmp_clear_here() {
  rm -rf -- ./*
}

_run_cleanup() {
  _buildTest="1"
  _tpDir="/data/disk/${_H_USER}/.tmp"
  _ceDir="${_tpDir}/cache"
  _gtDir="${_ceDir}/git"
  _ctDir="/data/disk/${_H_USER}/static/control"
  _exDir="/data/disk/${_H_USER}/backups/tmp_expim"
  _exCtr="${_exDir}/metadata"
  if [ -e "${_tpDir}" ]; then
    # listed, and emptied below, only inside the real .tmp: oN owns it and
    # can swap it, or cache/ in it, for a link to anywhere
    _buildTest=$(_run_in_real_dir "${_tpDir}" ls | grep "_tmp_" | wc -l | tr -d "\n" 2>&1)
    _buildTest=${_buildTest//[^0-9]/}
    # A _tmp_ dir with no live Drush behind it is an orphan left by a crashed
    # build/verify, not an active build. Do not let it wedge the queue: this is
    # re-evaluated every run and deletes nothing (cleanup stays with the
    # clear-drush-cache.info path above).
    if [ "${_buildTest:-0}" -ge 1 ] \
      && ! pgrep -u "${_H_USER}" -f "drush.php" > /dev/null 2>&1; then
      _buildTest="0"
    fi
  fi
  # the trigger counts, and is removed, only in the real control directory
  if _run_in_real_dir "${_ctDir}" test -e ./clear-drush-cache.info; then
    if [ -e "${_exCtr}" ]; then
      # only root's or the account's own (_ACCT_RM_OWN_PL): the account's
      # backups link can lead tmp_expim into a directory another account
      # left group-writable and moved into the account's tree
      _run_in_own_store "${_exDir}" perl -e "${_ACCT_RM_OWN_PL}" -- h \
        "$(_acct_walk_uids "${_H_USER}")" - ./metadata
      _run_in_real_dir "${_ctDir}" rm -f -- ./clear-drush-cache.info
      _buildTest="0"
    fi
    if [ -e "${_gtDir}" ] || [ "${_buildTest}" -ge 1 ]; then
      _run_in_real_dir "${_tpDir}" _run_tmp_clear_here
      _run_in_real_dir "${_ctDir}" rm -f -- ./clear-drush-cache.info
      _buildTest="0"
    fi
  fi
  if [ "${_buildTest}" = "0" ] && [ -e "${_gtDir}" ]; then
    _run_in_real_dir "${_ceDir}" rm -rf -- ./git ./download
  fi
}
_run_cleanup

# Remove dangerous stuff from the string.
_sanitize_string() {
  echo "$1" | sed 's/[\\\/\^\?\>\`\#\"\{\(\&\|\*]//g; s/\(['"'"'\]\)//g'
}

# The new password is delivered in the account's static/control, which the
# tenant owns. Run in the real directory: the file is made first, as a fresh
# name (0600, the main login's), the password is set only once that file
# exists, and the file is renamed over the name only once the password is
# set -- never through a link or FIFO put at the name, never readable by
# another account, and never a password set that cannot be delivered. The
# fresh file is created, written, handed to the main login and moded
# through one handle opened O_EXCL|O_NOFOLLOW (_ACCT_PUT_PL), never chowned
# by name: a hard link renamed over the temp name in between would have
# been handed to the main login. Its group stays the one it was created
# with, as before. $1 = the password.
_ACCT_PUT_PL='use Fcntl; my ($n, $u, $g, $m) = @ARGV; local $/; my $d = <STDIN>; sysopen(my $h, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; (print {$h} $d) or exit 1; chown($u, $g, $h) or exit 1; chmod(oct($m) & 0666, $h) or exit 1; close($h) or exit 1; exit 0'
_sftp_password_set_here() {
  local _t="./.new-${_sftpUser}-password.txt.put.$$.${RANDOM}" _uid
  _uid=$(id -u -- "${_sftpUser}" 2> /dev/null)
  [[ "${_uid}" =~ ^[0-9]+$ ]] || return 1
  rm -f -- "${_t}"
  # a directory at the name would refuse the rename after the change
  if [ ! -d "./new-${_sftpUser}-password.txt" ] \
    || [ -L "./new-${_sftpUser}-password.txt" ]; then
    if printf '%s\n' "${1}" \
      | perl -e "${_ACCT_PUT_PL}" "${_t}" "${_uid}" -1 600; then
      chage -I -1 -m 0 -M 99999 -E -1 "${_sftpUser}"
      if echo "${_sftpUser}:${1}" | chpasswd; then
        chage -M 90 "${_sftpUser}"
        chage -W 7 "${_sftpUser}"
        chage -d "$(date +%Y-%m-%d)" "${_sftpUser}"
        # the password is set now: the file stays even if the rename fails
        mv -f -T -- "${_t}" "./new-${_sftpUser}-password.txt"
        return
      fi
    fi
  fi
  rm -f -- "${_t}"
  return 1
}

# Generate new sftp password and update expiration date
_if_sftp_password_update() {
  local _ctl="/data/disk/${_H_USER}/static/control"
  # the trigger counts, is removed, and the password is changed and
  # delivered only in the real control directory, never one reached
  # through a link
  if _run_in_real_dir "${_ctl}" test -e ./run-sftp-password-update.pid; then
    _sftpUser="${_H_USER}.ftp"
    _run_in_real_dir "${_ctl}" rm -f -- ./run-sftp-password-update.pid
    _PWD_CHARS=64
    _RANDPASS_TEST=$(randpass -V 2>&1)
    if [[ "${_RANDPASS_TEST}" =~ "alnum" ]]; then
      _ESC_PASS=$(randpass "${_PWD_CHARS}" alnum 2>&1)
    else
      _ESC_PASS=$(shuf -zer -n64 {A..Z} {a..z} {0..9} % @ | tr -d '\0' 2>&1)
      _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
      _ESC_PASS=$(_sanitize_string "${_ESC_PASS}" 2>&1)
    fi
    _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
    _LEN_PASS=$(echo ${#_ESC_PASS} 2>&1)
    if [ -z "${_ESC_PASS}" ] || [ "${_LEN_PASS}" -lt 9 ]; then
      _ESC_PASS=$(shuf -zer -n64 {A..Z} {a..z} {0..9} % @ | tr -d '\0' 2>&1)
      _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
      _ESC_PASS=$(_sanitize_string "${_ESC_PASS}" 2>&1)
    fi
    _LEN_PASS=$(echo ${#_ESC_PASS} 2>&1)
    if [ ! -z "${_ESC_PASS}" ] && [ "${_LEN_PASS}" -gt 9 ]; then
      _run_in_real_dir "${_ctl}" _sftp_password_set_here "${_ESC_PASS}"
    fi
  fi
}

# An upgrade is queued in the current (pinned) control directory.
_run_upgrade_queued_here() {
  [ -e ./platforms.info ] && [ -e ./run-upgrade.pid ]
}

# Put the upgrade trigger back in the current (pinned) control directory:
# created exclusively, so a link or FIFO put at the name since it was
# removed is never followed or opened (the name is the tenant's).
_run_upgrade_keep_here() {
  ( umask 022
    dd of=./run-upgrade.pid conv=excl status=none < /dev/null 2> /dev/null )
}

_if_octopus_upgrade() {
  local _ctl="/data/disk/${_H_USER}/static/control"
  # Defer, never consume-and-lose: while an install/upgrade is in flight the
  # octopus wrapper refuses to start, so deleting the trigger before a launch
  # that cannot succeed would silently drop the tenant's queued upgrade --
  # leave it in place and let the next runner tick retry
  if [ -e "/run/octopus_install_run.pid" ] \
    || [ -e "/run/boa_run.pid" ]; then
    return 0
  fi
  # queued, consumed and put back only in the real control directory, never
  # one reached through a link
  if _run_in_real_dir "${_ctl}" _run_upgrade_queued_here; then
    # A proxied account is served elsewhere: octopus refuses it with an ALRT
    # and exits at once, the kept-trigger branch below puts the trigger back,
    # and the next tick does it again -- a refusal, a wrapper log and an
    # alert mail every tick until the account is promoted or its runner
    # removed. Leave the trigger where it is and say nothing: a promotion
    # removes proxied.pid and the queued upgrade runs on the next quiet tick.
    if [ -e "/data/disk/${_H_USER}/log/proxied.pid" ]; then
      return 0
    fi
    _run_in_real_dir "${_ctl}" rm -f -- ./run-upgrade.pid
    [ -e "/root/.silent.update.cnf" ] && rm -f /root/.silent.update.cnf
    _TODAY=$(date +%y%m%d)
    _TODAY=${_TODAY//[^0-9]/}
    _NOW=$(date +%y%m%d-%H%M%S)
    _NOW=${_NOW//[^0-9-]/}
    _vBs="/var/backups"
    _LOG_UP_DIR="${_vBs}/reports/up/$(basename "$0")/${_TODAY}"
    _UP_OCTOPUS_LOG="${_LOG_UP_DIR}/$(basename "$0")-up-octopus-${_NOW}.log"
    mkdir -p ${_LOG_UP_DIR}
    nohup /opt/local/bin/octopus up-${_tRee} ${_H_USER} force log noscreen >${_UP_OCTOPUS_LOG} 2>&1 &
    _upPid=$!
    # The guard above is not atomic with octopus's own lock: two runners
    # ticking in the same second both pass it, both delete their trigger,
    # and the octopus that reaches _up_start second refuses on the first
    # one's boa_run.pid and exits within a second -- the losing tenant's
    # queued upgrade is then gone (seen on a promoted mirror re-arming five
    # accounts at once). A real upgrade never ends this fast, so an octopus
    # that is gone within the wait did not run: put the trigger back and
    # let the next tick retry once the lock is free. The refusal text is the
    # fast path; the liveness check covers every other early exit (the load
    # ceiling's "try again later", a wait marker), and a slow box that takes
    # longer than the window to reach the lock check still holds a live
    # octopus at its end, which is left alone.
    _upWait=0
    while [ "${_upWait}" -lt 30 ]; do
      if grep -qE 'Another BOA installer is running|Some important system task is running|is still in flight' ${_UP_OCTOPUS_LOG} 2>/dev/null \
        || ! kill -0 "${_upPid}" 2>/dev/null; then
        sleep 1
        _run_in_real_dir "${_ctl}" _run_upgrade_keep_here
        echo "${_H_USER}: octopus did not start (BOA lock held or refused), run-upgrade.pid kept for the next tick" >>${_UP_OCTOPUS_LOG}
        break
      fi
      sleep 1
      _upWait=$(( _upWait + 1 ))
    done
  fi
}

_run_action() {
  # In accelerated mode (an Octopus install/upgrade is genuinely in progress) the
  # backend config and Drush aliases must reload promptly so queued tasks run in
  # the correct Aegir context; run the queue even with a build in progress. The
  # marker is honoured while fresh OR backed by a live install process, so a
  # crashed run cannot force this on, and a stalled heartbeat (runner.sh held
  # by a maintenance pause) cannot switch a genuinely live install off it.
  if [ -e "/run/octopus_install_run.pid" ]; then
    if [ -n "$(find /run/octopus_install_run.pid -mmin -15 2>/dev/null)" ] \
      || pgrep -f "^(/[^ ]*/)?bash (-c )?/(opt|usr)/local/bin/octopus" > /dev/null 2>&1 \
      || pgrep -f "^(/[^ ]*/)?bash (-c )?/(var/backups|var/opt/boa-dist)/OCTOPUS\.sh\.txt" > /dev/null 2>&1 \
      || pgrep -f "^(/[^ ]*/)?bash (-c )?/(opt|usr)/local/bin/boa in-" > /dev/null 2>&1; then
      _buildTest="0"
    fi
  fi
  if [ "${_buildTest}" = "0" ] \
    || [ -z "${_buildTest}" ] \
    || [ ! -e "${_ceDir}" ]; then
    su -s /bin/bash - ${_H_USER} -c "drush8 cc drush" &> /dev/null
    wait
    su -s /bin/bash - ${_H_USER} -c "bash /data/disk/${_H_USER}/aegir.sh"
    wait
    touch /var/log/boa/last-run-${_H_USER}
  else
    touch /var/log/boa/skip-run-${_H_USER}
  fi
}

if [ -e "/run/boa_wait.pid" ]; then
  touch /var/log/boa/wait-${_H_USER}
  exit 0
else
  _if_sftp_password_update
  _if_octopus_upgrade
  _run_action
  exit 0
fi
