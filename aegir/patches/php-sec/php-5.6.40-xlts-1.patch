+			size_t len = *last_header_line_length + 1 + http_folded_header_line_length;
+			char *extended_header = emalloc(len + 1);
+			strncpy(extended_header, *last_header_line, *last_header_line_length);
+			extended_header[*last_header_line_length] = ' ';
+			strncpy(extended_header + *last_header_line_length + 1, http_folded_header_line, http_folded_header_line_length);
+			extended_header[len] = '\0';
+			efree(*last_header_line);
+			*last_header_line = extended_header;
+			*last_header_line_length = len;
+			/* Return new header line. */
+			return *last_header_line;
+		}
