+class my_mysqli_fake_packet_item
+{
+    public function __construct($name, $value, $is_hex = null)
+    {
+        $this->name   = $name;
+        $this->value  = $value;
+        $this->is_hex = $is_hex === null || $is_hex;
+    }
+}
+
+class my_mysqli_fake_packet
+{
+    private $data = array();
+
+    public function __get($name)
+    {
+        foreach ($this->data as $item) {
+            if ($item->name === $name) {
+                return $item->value;
+            }
+        }
+        return null;
+    }
+
+    public function __set($name, $value)
+    {
+        if ($value instanceof my_mysqli_fake_packet_item) {
+            if ($value->name === null) {
+                $value->name = $name;
+            }
+        } else {
+            $value = new my_mysqli_fake_packet_item($name, $value, true);
+        }
+
+        for ($i = 0; $i < count($this->data); $i++) {
