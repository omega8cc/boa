diff --git a/ext/mysqli/tests/mysqlnd_row_decode_failure_refetch.phpt b/ext/mysqli/tests/mysqlnd_row_decode_failure_refetch.phpt
new file mode 100644
index 00000000..12ce0b0b
--- /dev/null
+++ b/ext/mysqli/tests/mysqlnd_row_decode_failure_refetch.phpt
@@ -0,0 +1,34 @@
+--TEST--
+mysqlnd: a row whose decoding failed is decoded again, never served from freed fields
+--EXTENSIONS--
+mysqli
+--FILE--
+<?php
+require_once 'fake_server.inc';
+
+$port = 33305;
+$process = run_fake_server_in_background('stmt_response_row_over_read_int', $port);
+$process->wait();
+
+$conn = new mysqli("127.0.0.1", "root", "", "", $port);
+$stmt = $conn->prepare("SELECT strval, intval FROM data");
+$stmt->execute();
+$result = $stmt->get_result();
+
+$first = @$result->fetch_assoc();
+var_dump($first);
+$result->data_seek(0);
+$second = @$result->fetch_assoc();
+var_dump($second);
+
+$result->free();
+$stmt->close();
+$conn->close();
+$process->terminate(true);
+print "done!";
+?>
+--EXPECTF--
+%A
+bool(false)
+bool(false)
+%Adone!%A
