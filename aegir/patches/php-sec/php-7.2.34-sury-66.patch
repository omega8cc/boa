+
+    $cmd = [
+        getenv('TEST_PHP_CGI_EXECUTABLE'),
+        '-C',
+        '-n',
+        '-dlog_errors=1',
+        __DIR__ . '/GHSA-9pqp-7h25-4f32.inc',
