+        . '</test></s:Body></s:Envelope>';
+}
+
+function test($arg)
+{
+    $depth = 0;
+    while (is_object($arg)) {
+        $depth++;
+        $arg = $arg->a;
+    }
+    $GLOBALS['decoded'] = [$depth, $arg];
+
+    return 'ok';
+}
+
+$server = new SoapServer(null, ['uri' => 'urn:test']);
+$server->addFunction('test');
+
+$server->handle(envelope(200));
