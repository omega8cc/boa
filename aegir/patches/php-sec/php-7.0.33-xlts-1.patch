+    $tar .= tar_header('carrier.bin', sprintf("%011o\0", 512), $typeflag);
+    /* the carrier's only data block is a tar header a conforming reader skips */
+    $tar .= tar_header('injected.txt', sprintf("%011o\0", 0));
