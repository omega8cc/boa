+    'lone CR           ' => "X-Custom: keep-me\rAuthorization: Bearer SECRET",
+    'space before colon' => "Authorization : Bearer SECRET\r\nX-Custom: keep-me",
+    'tab before colon  ' => "Authorization\t: Bearer SECRET\r\nX-Custom: keep-me",
