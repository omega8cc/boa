+    'octal overflow to 1'    => "40000000001\0",
+    'octal padding overflow' => "37777777400\0",
+    'GNU base-256'           => "\x80" . str_repeat("\0", 9) . "\x02\x00",
+    'non-octal digits'       => "99999999999\0",
+    'trailing garbage'       => "0000000001XX",
