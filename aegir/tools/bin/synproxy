#!/bin/bash

#
# synproxy — SYNPROXY (TCP/443/80) + QUIC limiter (UDP/443) for CSF
# Use early dedicated chain + cron self-heal to defeat CSF/lfd rule drift.
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

set -Eeuo pipefail
trap '_rc=$?; echo "[ERROR] line ${LINENO}: command failed (exit ${_rc})"; exit ${_rc}' ERR

# ---------- User tunables ----------
_TCP_PORTS=(443 80)
_QUIC_PORT=443
_RATE_PER_IP="80/second"
_BURST_PER_IP="160"
_RATE_PER_24="800/second"
_BURST_PER_24="1600"
_SYSCTL_FILE="/etc/sysctl.d/60-synproxy.conf"
_INSTALL_MONITOR="YES"
_LOG="/var/log/synproxy-stability.log"
# -----------------------------------

# ---------- utils ----------
_msg(){ echo "[SYNPROXY-STABILITY] $*" | tee -a "${_LOG}"; }
_die(){ echo "[SYNPROXY-STABILITY] ERROR: $*" | tee -a "${_LOG}" >&2; exit 1; }
_need(){ command -v "$1" >/dev/null 2>&1 || _die "Missing command: $1"; }
_need iptables; _need sysctl; _need modprobe; _need sed; _need awk; _need grep; _need date; _need update-rc.d

# paths
_CSFCONF="/etc/csf/csf.conf"
_CSFPOST="/etc/csf/csfpost.sh"
_INC_DIR="/etc/csf/csfpost.d"
_SYN_ADDON="${_INC_DIR}/synproxy.sh"
_QUIC_ADDON="${_INC_DIR}/quic_udp${_QUIC_PORT}_limit.sh"
_ASSERT_BIN="/usr/local/sbin/synproxy_assert"
_INITD="/etc/init.d/synproxy-assert"
_MONITOR="/usr/local/sbin/mon_synproxy"
_WATCHER="/usr/local/sbin/watch_synproxy"

# iptables -w compat
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

# fresh log
: > "${_LOG}"
_msg "Started at $(date -u +'%F %T UTC')"

# 1) kernel bits
_msg "1) Load SYNPROXY modules & persist nf_synproxy_core"
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_hashlimit 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
lsmod | grep -q '^nf_synproxy_core' || modprobe nf_synproxy_core
grep -qs '^nf_synproxy_core$' /etc/modules || echo nf_synproxy_core >> /etc/modules

# 2) minimal TCP sysctls (don’t clobber other tuning)
_msg "2) Ensure tcp_syncookies/timestamps/window_scaling are on"
mkdir -p /etc/sysctl.d
: > "${_SYSCTL_FILE}"
_ensure_sysctl(){ local _k="$1" _v="$2" _c; _c="$(sysctl -n "${_k}" 2>/dev/null || true)"; [ "${_c}" = "${_v}" ] || sysctl -w "${_k}=${_v}" >/dev/null; printf '%s = %s\n' "${_k}" "${_v}" >> "${_SYSCTL_FILE}"; }
_ensure_sysctl net.ipv4.tcp_syncookies 1
_ensure_sysctl net.ipv4.tcp_timestamps 1
_ensure_sysctl net.ipv4.tcp_window_scaling 1
sysctl -p "${_SYSCTL_FILE}" >/dev/null || true

# 3) Ensure csfpost runs add-ons with bash
_msg "3) Ensure ${_CSFPOST} executes /etc/csf/csfpost.d/*.sh with bash"
mkdir -p "${_INC_DIR}"
if [ ! -e "${_CSFPOST}" ]; then echo "#!/bin/bash" > "${_CSFPOST}"; chmod 700 "${_CSFPOST}"; fi
cp -a "${_CSFPOST}" "${_CSFPOST}.bak.$(date +%s)"
sed -i '/^# ===== BEGIN synproxy include/,/^# ===== END synproxy include/d' "${_CSFPOST}"
cat >> "${_CSFPOST}" <<'EOF'

# ===== BEGIN synproxy include (bash exec) =====
if [ -d /etc/csf/csfpost.d ]; then
  for _inc in /etc/csf/csfpost.d/*.sh; do
    [ -r "${_inc}" ] && /bin/bash "${_inc}"
  done
fi
# ===== END synproxy include (bash exec) =====
EOF
chmod 700 "${_CSFPOST}"

# 4) Tame CSF features that fight SYNPROXY
if [ -f "${_CSFCONF}" ]; then
  _msg "4) Disable CSF SYNFLOOD (SYNPROXY supersedes it) and warn if PORTFLOOD hits 80/443"
  cp -a "${_CSFCONF}" "${_CSFCONF}.bak.$(date +%s)"
  sed -ri 's/^SYNFLOOD *= *".*"/SYNFLOOD = "0"/' "${_CSFCONF}" || true
  _pf="$(grep -E '^PORTFLOOD' "${_CSFCONF}" || true)"
  if echo "${_pf}" | grep -Eq '(^|,)(80|443);tcp;'; then
    _msg "WARNING: PORTFLOOD includes 80/443 — consider removing those to avoid top-of-chain inserts above SYNPROXY."
  fi
fi

# 5) Write add-ons: early chain + NOTRACK + SYNPROXY + NEW→DROP; QUIC limiter
_msg "5) Install add-ons: SYNPROXY_EARLY chain + QUIC limiter"
_TCP_PORTS_STR="$(printf '%s ' "${_TCP_PORTS[@]}")"
cat > "${_SYN_ADDON}" <<'EOF'
#!/bin/bash
set -Eeuo pipefail
_TCP_PORTS=(_PORTS_PLACEHOLDER_)
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }
_has_t(){ _ipt -t "$1" -C "$2" "${@:3}" >/dev/null 2>&1; }
_ins_top(){ _ipt -t "$1" -I "$2" 1 "${@:3}" 2>/dev/null || true; }
_add_end(){ _ipt -A "$1" "${@:2}" 2>/dev/null || true; }

# modules
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
modprobe nf_synproxy_core 2>/dev/null || true

# raw: NOTRACK SYNs
for _p in "${_TCP_PORTS[@]}"; do
  _has_t raw PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack || _ins_top raw PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack
done

# 1) Ensure early chain exists
_chain_exists SYNPROXY_EARLY || _ipt -N SYNPROXY_EARLY 2>/dev/null || true

# 2) Ensure jumps to early chain are #1 in INPUT and (if present) LOCALINPUT
_has_t filter INPUT -j SYNPROXY_EARLY || _ins_top filter INPUT -j SYNPROXY_EARLY
_chain_exists LOCALINPUT && { _has_t filter LOCALINPUT -j SYNPROXY_EARLY || _ins_top filter LOCALINPUT -j SYNPROXY_EARLY; } || true

# 3) Populate early chain (order matters):
_ipt -C SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || _add_end SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
for _p in "${_TCP_PORTS[@]}"; do
  _ipt -C SYNPROXY_EARLY -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null \
    || _add_end SYNPROXY_EARLY -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460
  _ipt -C SYNPROXY_EARLY -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null \
    || _add_end SYNPROXY_EARLY -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460
  _ipt -C SYNPROXY_EARLY -p tcp -m tcp --dport "${_p}" -m state --state NEW -j DROP 2>/dev/null \
    || _add_end SYNPROXY_EARLY -p tcp -m tcp --dport "${_p}" -m state --state NEW -j DROP
done
_ipt -C SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP 2>/dev/null || _add_end SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP
exit 0
EOF
sed -i "s/_PORTS_PLACEHOLDER_/$(printf '%s ' "${_TCP_PORTS[@]}")/" "${_SYN_ADDON}"
chmod 700 "${_SYN_ADDON}"

# QUIC limiter add-on
cat > "${_QUIC_ADDON}" <<'EOF'
#!/bin/bash
set -Eeuo pipefail
_PORT=_LIMIT_
_RATE_PER_IP="_RATEIP_"
_BURST_PER_IP="_BURSTIP_"
_RATE_PER_24="_RATE24_"
_BURST_PER_24="_BURST24_"
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_ins_top(){ _ipt -I INPUT 1 "$@" 2>/dev/null || true; }
_has(){ _ipt -C INPUT "$@" >/dev/null 2>&1; }
_ensure(){ _has "$@" || _ins_top "$@"; }
_ensure -p udp --dport "${_PORT}" -m conntrack --ctstate INVALID -j DROP
_ensure -p udp --dport "${_PORT}" -m hashlimit --hashlimit-name quic${_PORT}_ip  --hashlimit-above "${_RATE_PER_IP}"  --hashlimit-burst "${_BURST_PER_IP}" --hashlimit-mode srcip --hashlimit-htable-expire 60000 -j DROP
_ensure -p udp --dport "${_PORT}" -m hashlimit --hashlimit-name quic${_PORT}_24 --hashlimit-above "${_RATE_PER_24}" --hashlimit-burst "${_BURST_PER_24}" --hashlimit-mode srcip --hashlimit-srcmask 24 --hashlimit-htable-expire 60000 -j DROP
exit 0
EOF
sed -i "s/_LIMIT_/${_QUIC_PORT}/g" "${_QUIC_ADDON}"
sed -i "s/_RATEIP_/$(printf '%s' "${_RATE_PER_IP}" | sed 's:/:\\/:g')/g" "${_QUIC_ADDON}"
sed -i "s/_BURSTIP_/${_BURST_PER_IP}/g" "${_QUIC_ADDON}"
sed -i "s/_RATE24_/$(printf '%s' "${_RATE_PER_24}" | sed 's:/:\\/:g')/g" "${_QUIC_ADDON}"
sed -i "s/_BURST24_/${_BURST_PER_24}/g" "${_QUIC_ADDON}"
chmod 700 "${_QUIC_ADDON}"

# 6) Apply once and CSF reload (if present)
_msg "6) Apply add-ons and reload CSF once"
/bin/bash "${_SYN_ADDON}" || true
/bin/bash "${_QUIC_ADDON}" || true
command -v csf >/dev/null 2>&1 && csf -r || true

# 7) Install sysvinit daemon that re-asserts every 5s
_msg "7) Install sysvinit self-heal service (every 5s)"
cat > "${_ASSERT_BIN}" <<'EOSH'
#!/bin/bash
# /usr/local/sbin/synproxy_assert — keep SYNPROXY_EARLY jump pinned at rule #1 and refresh rules
set -Eeuo pipefail
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
/bin/bash /etc/csf/csfpost.d/synproxy.sh >/dev/null 2>&1 || true
/bin/bash /etc/csf/csfpost.d/quic_udp443_limit.sh >/dev/null 2>&1 || true
# Re-pin the early jump to position 1 in INPUT and LOCALINPUT, if needed
_ipt -t filter -C INPUT -j SYNPROXY_EARLY >/dev/null 2>&1 || _ipt -t filter -I INPUT 1 -j SYNPROXY_EARLY || true
iptables -L LOCALINPUT -n >/dev/null 2>&1 && { _ipt -t filter -C LOCALINPUT -j SYNPROXY_EARLY >/dev/null 2>&1 || _ipt -t filter -I LOCALINPUT 1 -j SYNPROXY_EARLY || true; } || true
exit 0
EOSH
chmod 750 "${_ASSERT_BIN}"

cat > "${_INITD}" <<'EOSH'
#!/bin/sh
### BEGIN INIT INFO
# Provides:          synproxy-assert
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Keep SYNPROXY jump/rules pinned despite CSF/lfd churn
### END INIT INFO

DAEMON=/usr/local/sbin/synproxy_assert
PIDFILE=/var/run/synproxy-assert.pid
INTERVAL=5

start() {
  echo "Starting synproxy-assert loop (every ${INTERVAL}s)"
  [ -f "$PIDFILE" ] && stop
  ( while :; do "$DAEMON"; sleep "$INTERVAL"; done ) >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
}

stop() {
  echo "Stopping synproxy-assert"
  [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null || true
  rm -f "$PIDFILE"
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "synproxy-assert running (pid $(cat "$PIDFILE"))"
    exit 0
  else
    echo "synproxy-assert not running"
    exit 3
  fi
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
EOSH
chmod 755 "${_INITD}"
update-rc.d synproxy-assert defaults >/dev/null 2>&1 || true
/etc/init.d/synproxy-assert restart || /etc/init.d/synproxy-assert start || true

# 8) Monitor + watcher (optional)
if [ "${_INSTALL_MONITOR}" = "YES" ]; then
  _msg "8) Install compact monitor"
  cat > "${_MONITOR}" <<'EOSH'
#!/bin/sh
_PORTS="$*"; [ -n "${_PORTS}" ] || _PORTS="443 80"
echo "=== INPUT top ===";        iptables -L INPUT -n -v --line-numbers 2>/dev/null | sed -n '1,25p'
echo; if iptables -L LOCALINPUT -n >/dev/null 2>&1; then
  echo "=== LOCALINPUT top ==="; iptables -L LOCALINPUT -n -v --line-numbers 2>/dev/null | sed -n '1,25p'; echo
fi
echo "=== raw PREROUTING (first 20) ==="; iptables -t raw -L PREROUTING -n -v --line-numbers 2>/dev/null | sed -n '1,20p'; echo
for _p in ${_PORTS}; do
  echo "=== TCP :${_p} ==="
  printf "SYN_RECV: "; ss -tan state syn-recv sport = :"${_p}" 2>/dev/null | wc -l || ss -tan state synrecv sport = :"${_p}" 2>/dev/null | wc -l
  printf "ESTAB:    "; ss -tan state established sport = :"${_p}" 2>/dev/null | wc -l
  echo
done
EOSH
  chmod 750 "${_MONITOR}"
  cat > "${_WATCHER}" <<'EOSH'
#!/bin/sh
_INT="${1:-2}"; shift || true
_PORTS="$*"; [ -n "${_PORTS}" ] || _PORTS="443 80"
exec watch -n "${_INT}" "/usr/local/sbin/mon_synproxy ${_PORTS}"
EOSH
  chmod 750 "${_WATCHER}"
fi

echo
echo "---------------------------------------------------------------------"
echo "Pinned model: INPUT/LOCALINPUT -> SYNPROXY_EARLY (rule #1), then:"
echo "  UNTRACKED+SYN -> SYNPROXY ; NEW+SYN -> SYNPROXY ; NEW (to port) -> DROP ; INVALID -> DROP"
echo "raw/PREROUTING: CT --notrack for SYNs to protected ports"
echo "QUIC limiter: INVALID+hashlimit on UDP/${_QUIC_PORT}"
echo "CSF: SYNFLOOD disabled; review PORTFLOOD for 80/443"
echo "Self-heal: sysvinit service '/etc/init.d/synproxy-assert' (every 5s)"
echo "Monitor:   ${_WATCHER}  (e.g., '${_WATCHER} 2 443 80')"
echo "Log:       ${_LOG}"
echo "---------------------------------------------------------------------"
