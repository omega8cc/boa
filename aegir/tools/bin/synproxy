#!/bin/bash

#
# synproxy — SYNPROXY (TCP/443/80) + QUIC limiter (UDP/443) for CSF
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

set -Eeuo pipefail
trap '_rc=$?; echo "[ERROR] line ${LINENO}: command failed (exit ${_rc})"; exit ${_rc}' ERR

# ---------- User tunables ----------
_TCP_PORTS=(443 80)
_QUIC_PORT=443
_RATE_PER_IP="80/second"
_BURST_PER_IP="160"
_RATE_PER_24="800/second"
_BURST_PER_24="1600"
_SYSCTL_FILE="/etc/sysctl.d/60-synproxy.conf"
_INSTALL_MONITOR="YES"
_POST_REAPPLY_TRIES=12
_POST_REAPPLY_SLEEP=2
_LOG="/var/log/synproxy-install.log"
# -----------------------------------

# ---------- utils ----------
_msg(){ echo "[SYNPROXY+QUIC] $*" | tee -a "${_LOG}"; }
_die(){ echo "[SYNPROXY+QUIC] ERROR: $*" | tee -a "${_LOG}" >&2; exit 1; }
_need(){ command -v "$1" >/dev/null 2>&1 || _die "Missing command: $1"; }
_need iptables; _need sysctl; _need modprobe; _need awk; _need sed; _need date; _need grep

_CSFPOST="/etc/csf/csfpost.sh"
_INC_DIR="/etc/csf/csfpost.d"
_SYN_ADDON="${_INC_DIR}/synproxy.sh"
_QUIC_ADDON="${_INC_DIR}/quic_udp${_QUIC_PORT}_limit.sh"
_MONITOR="/usr/local/sbin/mon_synproxy"
_WATCHER="/usr/local/sbin/watch_synproxy"
_ROLLBACK="/usr/local/sbin/synproxy_rollback"

_IPT_HAS_W="NO"
iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

# ---------- fresh log ----------
: > "${_LOG}"
_msg "Started at $(date -u +'%F %T UTC')"

echo
_msg "1) Load modules & persist nf_synproxy_core"
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_hashlimit 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
lsmod | grep -q '^nf_synproxy_core' || modprobe nf_synproxy_core
grep -qs '^nf_synproxy_core$' /etc/modules || echo nf_synproxy_core >> /etc/modules

echo
_msg "2) Minimal sysctls (non-clobber)"
mkdir -p /etc/sysctl.d
: > "${_SYSCTL_FILE}"
_ensure_sysctl(){ local _k="$1" _v="$2" _c; _c="$(sysctl -n "${_k}" 2>/dev/null || true)"; [ "${_c}" = "${_v}" ] || sysctl -w "${_k}=${_v}" >/dev/null; printf '%s = %s\n' "${_k}" "${_v}" >> "${_SYSCTL_FILE}"; }
_ensure_sysctl net.ipv4.tcp_syncookies 1
_ensure_sysctl net.ipv4.tcp_timestamps 1
_ensure_sysctl net.ipv4.tcp_window_scaling 1
sysctl -p "${_SYSCTL_FILE}" >/dev/null || true

echo
_msg "3) Ensure csfpost executes /etc/csf/csfpost.d/*.sh with bash (no sourcing)"
mkdir -p "${_INC_DIR}"
if [ ! -e "${_CSFPOST}" ]; then echo "#!/bin/bash" > "${_CSFPOST}"; chmod 700 "${_CSFPOST}"; fi
cp -a "${_CSFPOST}" "${_CSFPOST}.bak.$(date +%s)"
if grep -q '^# ===== BEGIN synproxy include' "${_CSFPOST}"; then
  sed -i '/^# ===== BEGIN synproxy include/,/^# ===== END synproxy include/c\
# ===== BEGIN synproxy include (bash exec) =====\
if [ -d /etc/csf/csfpost.d ]; then\
  for _inc in /etc/csf/csfpost.d/*.sh; do [ -x "${_inc}" ] && /bin/bash "${_inc}"; done\
fi\
# ===== END synproxy include (bash exec) =====' "${_CSFPOST}"
elif grep -q '^# ===== BEGIN csfpost.d include' "${_CSFPOST}"; then
  sed -i '/^# ===== BEGIN csfpost.d include/,/^# ===== END csfpost.d include/c\
# ===== BEGIN synproxy include (bash exec) =====\
if [ -d /etc/csf/csfpost.d ]; then\
  for _inc in /etc/csf/csfpost.d/*.sh; do [ -x "${_inc}" ] && /bin/bash "${_inc}"; done\
fi\
# ===== END synproxy include (bash exec) =====' "${_CSFPOST}"
elif ! grep -q '/etc/csf/csfpost.d' "${_CSFPOST}"; then
  cat >> "${_CSFPOST}" <<'EOF'

# ===== BEGIN synproxy include (bash exec) =====
if [ -d /etc/csf/csfpost.d ]; then
  for _inc in /etc/csf/csfpost.d/*.sh; do [ -x "${_inc}" ] && /bin/bash "${_inc}"; done
fi
# ===== END synproxy include (bash exec) =====
EOF
fi
chmod 700 "${_CSFPOST}"

echo
_msg "4) Clean any earlier/broken rules"
for _p in "${_TCP_PORTS[@]}"; do
  _ipt -t raw -D PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack 2>/dev/null || true
  _ipt -t raw -D PREROUTING -p tcp --syn --dport "${_p}" -j NOTRACK      2>/dev/null || true
  _ipt -D INPUT      -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  _ipt -D INPUT      -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW       -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  _ipt -D INPUT      -p tcp -m tcp       --dport "${_p}" -m state --state NEW       -j DROP     2>/dev/null || true
  _ipt -D LOCALINPUT -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  _ipt -D LOCALINPUT -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW       -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  _ipt -D LOCALINPUT -p tcp -m tcp       --dport "${_p}" -m state --state NEW       -j DROP     2>/dev/null || true
done
_ipt -D INPUT -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
_ipt -D INPUT -p udp --dport "${_QUIC_PORT}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
_ipt -D INPUT -p udp --dport "${_QUIC_PORT}" -m hashlimit --hashlimit-name quic${_QUIC_PORT}_ip  -j DROP 2>/dev/null || true
_ipt -D INPUT -p udp --dport "${_QUIC_PORT}" -m hashlimit --hashlimit-name quic${_QUIC_PORT}_24 -j DROP 2>/dev/null || true

echo
_msg "5) Write SYNPROXY add-on (adds NEW→DROP right after SYNPROXY)"
_TCP_PORTS_STR="$(printf '%s ' "${_TCP_PORTS[@]}")"
cat > "${_SYN_ADDON}" <<'EOF'
#!/bin/bash
# /etc/csf/csfpost.d/synproxy.sh — enforce SYNPROXY and NEW→DROP pairing
set -Eeuo pipefail

_TCP_PORTS=(_PORTS_PLACEHOLDER_)

# iptables compat
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

# simple ensure helpers
_ins1(){ _ipt -t "$1" -I "$2" 1 "${@:3}" 2>/dev/null || true; }
_has(){ _ipt -t "$1" -C "$2" "${@:3}" >/dev/null 2>&1; }
_ensure_top(){ _has "$@" || _ins1 "$@"; }

# modules (best-effort)
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
modprobe nf_synproxy_core 2>/dev/null || true

# 0) ESTABLISHED,RELATED early (safe if already present)
_ensure_top filter INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
_chain_exists LOCALINPUT && _ensure_top filter LOCALINPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || true

# 1) raw: mark SYNs NOTRACK (prefer CT --notrack; fallback NOTRACK)
for _p in "${_TCP_PORTS[@]}"; do
  _has raw PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack \
    || _ins1 raw PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack
done

# 2) For each chain (INPUT and LOCALINPUT if present), enforce order:
#    UNTRACKED+SYN -> SYNPROXY
#    NEW+SYN      -> SYNPROXY
#    NEW (any)    -> DROP          # <- stops kernel from also handshaking
_apply_chain(){
  local _C="$1"
  for _p in "${_TCP_PORTS[@]}"; do
    # Insert in REVERSE so final order is: UNTRACKED SYNPROXY, NEW SYNPROXY, NEW DROP
    _ensure_top filter "${_C}" -p tcp -m tcp --dport "${_p}" -m state --state NEW -j DROP
    _ensure_top filter "${_C}" -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW \
      -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460
    _ensure_top filter "${_C}" -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED \
      -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460
  done
  # INVALID early (after ESTABLISHED)
  _ensure_top filter "${_C}" -m conntrack --ctstate INVALID -j DROP
}

_apply_chain INPUT
_chain_exists LOCALINPUT && _apply_chain LOCALINPUT || true

exit 0
EOF
sed -i "s/_PORTS_PLACEHOLDER_/$(printf '%s ' "${_TCP_PORTS[@]}")/" "${_SYN_ADDON}"
chmod 700 "${_SYN_ADDON}"

echo
_msg "6) Write QUIC limiter add-on"
cat > "${_QUIC_ADDON}" <<'EOF'
#!/bin/bash
# /etc/csf/csfpost.d/quic_udp_LIMIT_.sh — rate-limit QUIC (UDP/_LIMIT_)
set -Eeuo pipefail
_PORT=_LIMIT_
_RATE_PER_IP="_RATEIP_"
_BURST_PER_IP="_BURSTIP_"
_RATE_PER_24="_RATE24_"
_BURST_PER_24="_BURST24_"

_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }

_ins1(){ _ipt -I "$1" 1 "${@:2}" 2>/dev/null || true; }
_has(){ _ipt -C "$1" "${@:2}" >/dev/null 2>&1; }
_ensure_top(){ _has "$@" || _ins1 "$@"; }

# INVALID early, then per-IP and per-/24 caps (DROP)
_ensure_top INPUT -p udp --dport "${_PORT}" -m conntrack --ctstate INVALID -j DROP
_ensure_top INPUT -p udp --dport "${_PORT}" -m hashlimit --hashlimit-name quic${_PORT}_ip  --hashlimit-above "${_RATE_PER_IP}"  --hashlimit-burst "${_BURST_PER_IP}" --hashlimit-mode srcip --hashlimit-htable-expire 60000 -j DROP
_ensure_top INPUT -p udp --dport "${_PORT}" -m hashlimit --hashlimit-name quic${_PORT}_24 --hashlimit-above "${_RATE_PER_24}" --hashlimit-burst "${_BURST_PER_24}" --hashlimit-mode srcip --hashlimit-srcmask 24 --hashlimit-htable-expire 60000 -j DROP
exit 0
EOF
sed -i "s/_LIMIT_/${_QUIC_PORT}/g" "${_QUIC_ADDON}"
sed -i "s/_RATEIP_/$(printf '%s' "${_RATE_PER_IP}" | sed 's:/:\\/:g')/g" "${_QUIC_ADDON}"
sed -i "s/_BURSTIP_/${_BURST_PER_IP}/g" "${_QUIC_ADDON}"
sed -i "s/_RATE24_/$(printf '%s' "${_RATE_PER_24}" | sed 's:/:\\/:g')/g" "${_QUIC_ADDON}"
sed -i "s/_BURST24_/${_BURST_PER_24}/g" "${_QUIC_ADDON}"
chmod 700 "${_QUIC_ADDON}"

echo
_msg "7) Apply now, reload CSF, then re-assert"
/bin/bash "${_SYN_ADDON}" || true
/bin/bash "${_QUIC_ADDON}" || true
command -v csf >/dev/null 2>&1 && csf -r || true
_try=0
while [ "${_try}" -lt "${_POST_REAPPLY_TRIES}" ]; do
  sleep "${_POST_REAPPLY_SLEEP}" || true
  /bin/bash "${_SYN_ADDON}" || true
  /bin/bash "${_QUIC_ADDON}" || true
  _try=$((_try+1))
done

echo
if [ "${_INSTALL_MONITOR}" = "YES" ]; then
  _msg "8) Install monitor"
  cat > "${_MONITOR}" <<'EOSH'
#!/bin/sh
# /usr/local/sbin/mon_synproxy — monitor (no bash -c)
_PORTS="$*"; [ -n "${_PORTS}" ] || _PORTS="443 80"
echo "=== INPUT (SYNPROXY/NEW-DROP/INVALID) ==="
iptables -vxnL INPUT 2>/dev/null | egrep 'SYNPROXY|state NEW.*DROP|INVALID' || echo "(no INPUT view)"
echo
if iptables -L LOCALINPUT -n >/dev/null 2>&1; then
  echo "=== LOCALINPUT (SYNPROXY/NEW-DROP) ==="
  iptables -vxnL LOCALINPUT 2>/dev/null | egrep 'SYNPROXY|state NEW.*DROP' || echo "(no LOCALINPUT view)"
  echo
fi
echo "=== raw PREROUTING (full) ==="
iptables -t raw -L PREROUTING -n -v --line-numbers 2>/dev/null | sed -n '1,100p'
echo
for _p in ${_PORTS}; do
  echo "=== TCP :${_p} ==="
  printf "SYN_RECV backlog: "; ss -tan state syn-recv sport = :"${_p}" 2>/dev/null | wc -l || ss -tan state synrecv sport = :"${_p}" 2>/dev/null | wc -l
  printf "  ESTABLISHED: ";     ss -tan state established sport = :"${_p}" 2>/dev/null | wc -l
  echo
done
EOSH
  chmod 750 "${_MONITOR}"

  cat > "${_WATCHER}" <<'EOSH'
#!/bin/sh
# /usr/local/sbin/watch_synproxy — wrapper around mon_synproxy
_INT="${1:-1}"; shift || true
_PORTS="$*"; [ -n "${_PORTS}" ] || _PORTS="443 80"
exec watch -n "${_INT}" "/usr/local/sbin/mon_synproxy ${_PORTS}"
EOSH
  chmod 750 "${_WATCHER}"
fi

echo
_msg "9) Rollback helper"
/bin/cat > "${_ROLLBACK}" <<'EOR'
#!/bin/bash
# /usr/local/sbin/synproxy_rollback — remove SYNPROXY + NEW→DROP + QUIC rules (IPv4)
_TCP_PORTS="80 443"
for _p in ${_TCP_PORTS}; do
  iptables -t raw    -D PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack 2>/dev/null || true
  iptables -D INPUT      -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  iptables -D INPUT      -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW       -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  iptables -D INPUT      -p tcp -m tcp       --dport "${_p}" -m state --state NEW       -j DROP 2>/dev/null || true
  iptables -D LOCALINPUT -p tcp -m tcp --syn --dport "${_p}" -m conntrack --ctstate UNTRACKED -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  iptables -D LOCALINPUT -p tcp -m tcp --syn --dport "${_p}" -m state --state NEW       -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
  iptables -D LOCALINPUT -p tcp -m tcp       --dport "${_p}" -m state --state NEW       -j DROP 2>/dev/null || true
done
iptables -D INPUT -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
_p=443
iptables -D INPUT -p udp --dport "${_p}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
iptables -D INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_ip  -j DROP 2>/dev/null || true
iptables -D INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_24 -j DROP 2>/dev/null || true
echo "Rollback attempted. Verify with: iptables -t raw -L PREROUTING -n -v; iptables -L INPUT -n -v; iptables -L LOCALINPUT -n -v"
EOR
chmod 750 "${_ROLLBACK}"

echo
echo "---------------------------------------------------------------------"
echo "SYNPROXY:  ${_TCP_PORTS[*]} (UNTRACKED→SYNPROXY, NEW→SYNPROXY, then NEW→DROP)"
echo "QUIC:      UDP/${_QUIC_PORT} limiter (per-IP ${_RATE_PER_IP}, /24 ${_RATE_PER_24})"
echo "Add-ons:   ${_SYN_ADDON}  and  ${_QUIC_ADDON}"
echo "Verify:    iptables -L INPUT -n -v --line-numbers | sed -n '1,60p'"
echo "           iptables -L LOCALINPUT -n -v --line-numbers | sed -n '1,60p'  (if exists)"
echo "           iptables -t raw -L PREROUTING -n -v --line-numbers | sed -n '1,60p'"
echo "Monitor:   ${_WATCHER}   e.g. '${_WATCHER} 1 443 80'"
echo "Rollback:  ${_ROLLBACK}"
echo "Log:       ${_LOG}"
echo "Note: IPv4 only; IPv6/HTTP3-over-IPv6 not covered."
echo "---------------------------------------------------------------------"
