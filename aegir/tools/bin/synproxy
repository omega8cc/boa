#!/bin/bash

#
# synproxy — SYNPROXY (TCP/443/80) + QUIC limiter (UDP/443) for CSF
#
# - Hooks CSF post scripts to call reassert tool on every reload
# - No background loops, removes NEW->DROP, purges QUIC when disabled
# - Adds lo bypass + optional trusted bypass, adds ACK-only NEW accept shim
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

set -Eeuo pipefail
trap '_rc=$?; echo "[INSTALL] line ${LINENO}: exit ${_rc}" >&2; exit ${_rc}' ERR

# -------------------- TUNABLES --------------------
_TCP_PORTS="${_TCP_PORTS:-443 80}"           # Protect these TCP ports with SYNPROXY
_ENABLE_QUIC_LIMITER="${_ENABLE_QUIC_LIMITER:-NO}"  # YES to rate-limit UDP/${_QUIC_PORT}
_QUIC_PORT="${_QUIC_PORT:-443}"              # QUIC UDP port (ignored if limiter disabled)
_RATE_PER_IP="${_RATE_PER_IP:-80/second}"    # QUIC per-IP
_BURST_PER_IP="${_BURST_PER_IP:-160}"
_RATE_PER_24="${_RATE_PER_24:-800/second}"   # QUIC per-/24
_BURST_PER_24="${_BURST_PER_24:-1600}"
_TRUSTED_SRC="${_TRUSTED_SRC:-}"             # space-separated CIDRs to bypass SYNPROXY (optional)
_APPLY_NOW="${_APPLY_NOW:-YES}"              # Run a CSF reload + reassert at the end
_SYSCTL_FILE="/etc/sysctl.d/60-synproxy.conf"
# -------------------------------------------------

# -------------------- prerequisites & helpers ------------------------
_need(){ command -v "$1" >/dev/null 2>&1 || { echo "[INSTALL] Missing: $1" >&2; exit 1; }; }
_need iptables; _need sed; _need grep; _need awk; _need modprobe; _need sysctl
_CSF_BIN="csf"; command -v "${_CSF_BIN}" >/dev/null 2>&1 || _CSF_BIN=""

_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }

_LOG="/var/log/synproxy-install.log"; : > "${_LOG}"
_msg(){ echo "[INSTALL] $*" | tee -a "${_LOG}"; }

_CSFCONF="/etc/csf/csf.conf"
_CSFPOST="/etc/csf/csfpost.sh"
_INC_DIR="/etc/csf/csfpost.d"

_REASSERT="/opt/local/bin/synproxy_reassert"
_ADDON="${_INC_DIR}/99-synproxy-reassert.sh"
_WATCH_BIN="/usr/local/sbin/watch_synproxy"
_ROLLBACK="/opt/local/bin/synproxy_rollback"

# Old artifacts we’ll clean up
_OLD_SYN_ADDON="${_INC_DIR}/synproxy.sh"
_OLD_QUIC_ADDONS_GLOB="${_INC_DIR}/quic_udp*_limit.sh"
_ASSERT_BIN="/usr/local/sbin/synproxy_assert"
_INITD="/etc/init.d/synproxy-assert"
_CRON="/etc/cron.d/synproxy-assert"
_MONITOR_OLD="/usr/local/sbin/mon_synproxy"
_WATCHER_OLD="/usr/local/sbin/watch_synproxy"
_OLD_ROLLBACK="/usr/local/sbin/synproxy_rollback"
# ---------------------------------------------------------------------

_msg "1) Load SYNPROXY modules & persist nf_synproxy_core"
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
modprobe nf_synproxy_core 2>/dev/null || true
grep -qs '^nf_synproxy_core$' /etc/modules || echo nf_synproxy_core >> /etc/modules

_msg "2) Minimal TCP sysctls (non-clobber of other files)"
mkdir -p /etc/sysctl.d
: > "${_SYSCTL_FILE}"
_set_sys(){ local _k="$1" _v="$2" _cur; _cur="$(sysctl -n "${_k}" 2>/dev/null || echo)"; [ "${_cur}" = "${_v}" ] || sysctl -w "${_k}=${_v}" >/dev/null; printf '%s = %s\n' "${_k}" "${_v}" >> "${_SYSCTL_FILE}"; }
_set_sys net.ipv4.tcp_syncookies 1
_set_sys net.ipv4.tcp_timestamps 1
_set_sys net.ipv4.tcp_window_scaling 1
sysctl -p "${_SYSCTL_FILE}" >/dev/null || true

_msg "3) Ensure csfpost executes ${_INC_DIR}/*.sh with bash (not source)"
mkdir -p "${_INC_DIR}"
if [ ! -e "${_CSFPOST}" ]; then echo "#!/bin/bash" > "${_CSFPOST}"; chmod 700 "${_CSFPOST}"; fi
cp -a "${_CSFPOST}" "${_CSFPOST}.bak.$(date +%s)"
# remove any prior include block we added
sed -i '/^# ===== BEGIN synproxy include/,/^# ===== END synproxy include/d' "${_CSFPOST}"
cat >> "${_CSFPOST}" <<'EOF'

# ===== BEGIN synproxy include (bash exec) =====
if [ -d /etc/csf/csfpost.d ]; then
  for _inc in /etc/csf/csfpost.d/*.sh; do
    [ -r "${_inc}" ] && /bin/bash "${_inc}"
  done
fi
# ===== END synproxy include =====
EOF
chmod 700 "${_CSFPOST}"

_msg "4) Disable CSF SYNFLOOD (SYNPROXY supersedes it); warn for PORTFLOOD 80/443"
if [ -f "${_CSFCONF}" ]; then
  cp -a "${_CSFCONF}" "${_CSFCONF}.bak.$(date +%s)"
  sed -i 's/^SYNFLOOD *= *".*"/SYNFLOOD = "0"/' "${_CSFCONF}" || true
  _pf="$(grep -E '^PORTFLOOD' "${_CSFCONF}" || true)"
  if echo "${_pf}" | grep -Eq '(^|,)(80|443);tcp;'; then
    _msg "WARNING: PORTFLOOD includes 80/443 — consider removing those to avoid top-of-chain inserts above SYNPROXY."
  fi
fi

_msg "5) Remove older/broken artifacts (safe if absent)"
rm -f "${_OLD_SYN_ADDON}" 2>/dev/null || true
[ -d "${_INC_DIR}" ] && find "${_INC_DIR}" -maxdepth 1 -type f -name "$(basename "${_OLD_QUIC_ADDONS_GLOB}")" -exec rm -f {} + 2>/dev/null || true
rm -f "${_ASSERT_BIN}" "${_CRON}" "${_MONITOR_OLD}" "${_OLD_ROLLBACK}" 2>/dev/null || true
if [ -x "${_INITD}" ]; then
  "${_INITD}" stop >/dev/null 2>&1 || true
  command -v update-rc.d >/dev/null 2>&1 && update-rc.d synproxy-assert remove >/dev/null 2>&1 || true
  rm -f "${_INITD}" 2>/dev/null || true
fi

_msg "6) Write CSF add-on to call reassert on every CSF reload: ${_ADDON}"
cat > "${_ADDON}" <<EOF
#!/bin/bash
# CSF post hook — call reassert tool (idempotent)
_TCP_PORTS="${_TCP_PORTS}"
_ENABLE_QUIC_LIMITER="${_ENABLE_QUIC_LIMITER}"
_QUIC_PORT="${_QUIC_PORT}"
_RATE_PER_IP="${_RATE_PER_IP}"
_BURST_PER_IP="${_BURST_PER_IP}"
_RATE_PER_24="${_RATE_PER_24}"
_BURST_PER_24="${_BURST_PER_24}"
_TRUSTED_SRC="${_TRUSTED_SRC}"
_ARGS="-p \\"\${_TCP_PORTS}\\""
[ "\${_ENABLE_QUIC_LIMITER}" = "YES" ] || _ARGS="\${_ARGS} --no-quic"
[ -n "\${_QUIC_PORT}" ] && _ARGS="\${_ARGS} --quic-port \${_QUIC_PORT}"
[ -n "\${_TRUSTED_SRC}" ] && _ARGS="\${_ARGS} --trust \\"\${_TRUSTED_SRC}\\""
_ARGS="\${_ARGS} --rate-ip \\"\${_RATE_PER_IP}\\" --burst-ip \\"\${_BURST_PER_IP}\\" --rate-24 \\"\${_RATE_PER_24}\\" --burst-24 \\"\${_BURST_PER_24}\\" -q"
\${_REASSERT} \${_ARGS}
exit 0
EOF
chmod 700 "${_ADDON}"

_msg "7) Install the new watch tool: ${_WATCH_BIN}"
cat > "${_WATCH_BIN}" <<'EOWATCH'
#!/bin/bash
# /usr/local/sbin/watch_synproxy — Devuan-friendly live view for SYNPROXY.
# Shows: INPUT top, LOCALINPUT (if any), raw/PREROUTING NOTRACK hits, SYNPROXY_EARLY with counters.
# STYLE: all names start with _ ; all refs use ${_VAR}.
set -u

_INTERVAL="${_INTERVAL:-2}"
_TCP_PORTS="${_TCP_PORTS:-443 80}"
_SHOW_INPUT_LINES="${_SHOW_INPUT_LINES:-20}"

_usage(){
  cat <<USAGE
Usage: watch_synproxy [options]
  -n SEC         Refresh interval (default: ${_INTERVAL})
  -p "443 80"    Ports to highlight in raw NOTRACK view (default: "${_TCP_PORTS}")
  -l NUM         How many INPUT lines to show (default: ${_SHOW_INPUT_LINES})
  -h             Help
Tip: run after a CSF change: csf -r && /usr/local/sbin/csf_synproxy_reassert.sh -p "443 80" --no-quic -q
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n) _INTERVAL="$2"; shift 2;;
    -p) _TCP_PORTS="$2"; shift 2;;
    -l) _SHOW_INPUT_LINES="$2"; shift 2;;
    -h|--help) _usage; exit 0;;
    *) echo "Unknown option: $1" >&2; _usage; exit 2;;
  esac
done

_has(){ command -v "$1" >/dev/null 2>&1; }
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

while :; do
  clear
  echo "=== SYNPROXY monitor @ $(date '+%F %T %Z')  interval=${_INTERVAL}s  ports: ${_TCP_PORTS}"
  echo

  echo "-- INPUT (top ${_SHOW_INPUT_LINES})"
  _ipt -L INPUT -n -v --line-numbers | sed -n "1,${_SHOW_INPUT_LINES}p"
  if _chain_exists LOCALINPUT; then
    echo; echo "-- LOCALINPUT (top ${_SHOW_INPUT_LINES})"
    _ipt -L LOCALINPUT -n -v --line-numbers | sed -n "1,${_SHOW_INPUT_LINES}p"
  fi

  echo; echo "-- raw/PREROUTING (NOTRACK hits for web ports)"
  _ipt -t raw -L PREROUTING -n -v --line-numbers \
    | awk -v PORTS="${_TCP_PORTS}" '
        BEGIN{ split(PORTS,a," "); for(i in a) p[a[i]]=1 }
        /CT --notrack|NOTRACK/ && /--syn/ && /--dport/ {
          port=""; for(i=1;i<=NF;i++){ if($i=="dpt:" || $i=="--dport"){ port=$(i+1) } }
          if(port in p){ print }
        }'

  echo; echo "-- SYNPROXY_EARLY (full chain with counters)"
  if _chain_exists SYNPROXY_EARLY; then
    _ipt -L SYNPROXY_EARLY -n -v --line-numbers
  else
    echo "SYNPROXY_EARLY not found"
  fi

  echo; echo "(q to quit)"; read -t "${_INTERVAL}" -n 1 _k && [ "${_k:-}" = "q" ] && exit 0
done
EOWATCH
chmod 755 "${_WATCH_BIN}"

if [ -n "${_CSF_BIN}" ]; then
  _msg "8) Reload CSF once to pick up add-on"
  ${_CSF_BIN} -r || true
else
  _msg "8) CSF not found; skipping CSF reload"
fi

if [ "${_APPLY_NOW}" = "YES" ]; then
  _msg "9) Apply reassert now (twice to beat lfd churn)"
  "${_REASSERT}" -p "${_TCP_PORTS}" $([ "${_ENABLE_QUIC_LIMITER}" = "YES" ] && echo "--quic-port ${_QUIC_PORT}" || echo "--no-quic") \
     --rate-ip "${_RATE_PER_IP}" --burst-ip "${_BURST_PER_IP}" --rate-24 "${_RATE_PER_24}" --burst-24 "${_BURST_PER_24}" \
     $([ -n "${_TRUSTED_SRC}" ] && printf "%s" "--trust \"${_TRUSTED_SRC}\"") -q || true
  sleep 1
  "${_REASSERT}" -p "${_TCP_PORTS}" $([ "${_ENABLE_QUIC_LIMITER}" = "YES" ] && echo "--quic-port ${_QUIC_PORT}" || echo "--no-quic") -q || true
fi

echo
echo "---------------------------------------------------------------------"
echo "SYNPROXY installed with updated logic."
echo " Reassert tool: ${_REASSERT}"
echo " CSF hook:      ${_ADDON}"
echo " Watch tool:    ${_WATCH_BIN}    (e.g., ${_WATCH_BIN} -n 2 -p \"${_TCP_PORTS}\")"
echo
echo "Use after ANY CSF mutation (example):"
echo "  csf -r && ${_REASSERT} -p \"${_TCP_PORTS}\" --no-quic -q"
[ "${_ENABLE_QUIC_LIMITER}" = "YES" ] && echo "QUIC limiter:   ENABLED on UDP/${_QUIC_PORT}  (rates: ${_RATE_PER_IP}, ${_RATE_PER_24})" || echo "QUIC limiter:   DISABLED (no UDP/${_QUIC_PORT} drops left)"
[ -n "${_TRUSTED_SRC}" ] && echo "Trusted bypass: ${_TRUSTED_SRC}" || true
echo
echo "Verify:"
echo "  iptables -S INPUT | sed -n '1,25p'     # INPUT#1 should be -j SYNPROXY_EARLY ; no udp/${_QUIC_PORT} INVALID drops if disabled"
echo "  iptables -S SYNPROXY_EARLY | sed -n '1,120p'  # lo RETURN; EST/REL ACCEPT; SYNPROXY; ACK-NEW ACCEPT; INVALID DROP"
echo "Log: ${_LOG}"
echo
echo " Uninstall tool: ${_ROLLBACK}"
echo "---------------------------------------------------------------------"
