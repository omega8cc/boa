#!/bin/bash

# Environment setup
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=dev

# Passive-mirror hold (2026-08-25 ruling): the active owns the backup
# lineage -- a mirror's own chain is redundant (its data IS the active's,
# minutes behind), doubles the offsite cost, and its site-bootstrap steps
# would log DB-write errors every pass under super_read_only. Covers the
# queue pass AND the operator restore verb: a restore would write the
# synced trees and permanently shadow the active's copies. One line, rc 0.
if [ -e "/root/.standby.cnf" ]; then
  echo "Replication standby: backup chain held (active owns the lineage)"
  exit 0
fi

_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

# An account owns /data/disk/<oN> and, through its .ftp login, static/control,
# so any name below either can be a link or a FIFO, and a whole directory on
# the way can be one. The root queue pass reads and writes there only inside
# the real directory.
#
# Run "$@" inside the real directory $1: below /data/disk and /home every name
# on the path must be a real directory; once entered, ./name stays there
# whatever is swapped. A copy of the helper in lib/functions/helper.sh.inc.
_acct_in_real_dir() {
  local _d="${1}" _a="" _want
  shift
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
  esac
  if [ -n "${_a}" ]; then
    _want="$(cd -P -- "${_a}" 2> /dev/null && pwd -P)${_d#"${_a}"}"
  else
    _want="$(cd -P -- "${_d%/*}" 2> /dev/null && pwd -P)/${_d##*/}"
  fi
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_want}" ] && "$@" )
}
# The queued command ./$1 in the current (pinned) directory: never through a
# link, never blocked on a FIFO, at most 4 KiB.
_queue_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=4096 count=1 status=none 2> /dev/null
}
# The line $2 appended to ./$1 in the current (pinned) directory, never
# through a link and never blocked on a FIFO put at the name (what >> did).
_acct_append_here() {
  printf '%s\n' "${2}" | timeout 10 dd of="./${1}" \
    oflag=append,nofollow,nonblock conv=notrunc status=none 2> /dev/null
}
# True when $1 is root's and no one else can write it: owned by root, not
# writable by others, group-writable only for group root.
_root_only() {
  local _s _u _g _m
  _s="$(stat -c '%u %g %a' -- "${1}" 2> /dev/null)" || return 1
  read -r _u _g _m <<< "${_s}"
  [ "${_u}" = 0 ] || return 1
  (( 0${_m} & 2 )) && return 1
  (( 0${_m} & 16 )) && [ "${_g}" != 0 ] && return 1
  return 0
}

# The restore window. A queued restore runs as the account's own user, which
# must read the service's credentials file and remote_backups/.secret.txt.
# For the run both are handed to that user by owner, mode 0600, never opened
# to anyone else, and afterwards given back to the owner:group they had,
# recorded by number. Each acts inside its real directory, on names checked
# to be regular files, and a give-back touches only the file (by device and
# inode) that was handed over.
#
# In the real credentials directory (the account's own, via its .ftp login):
# the directory and ./$2 go to $1, 0700 and 0600 unchanged. Prints the record
# for _cred_window_close_here: "dir-id dir-owner file-id file-owner".
_cred_window_open_here() {
  local _d _f="-" _fo="-"
  _d="$(stat -c '%d:%i %u:%g' .)" || return 1
  if [ -f "./${2}" ] && [ ! -L "./${2}" ]; then
    _f="$(stat -c '%d:%i' -- "./${2}")" && _fo="$(stat -c '%u:%g' -- "./${2}")" \
      && chown -h "${1}" -- "./${2}" || { _f="-"; _fo="-"; }
  fi
  chown -h "${1}" . && chmod 700 .
  echo "${_d} ${_f} ${_fo}"
}
# ./$1 in the current (pinned) directory removed when it is a link: rm
# unlinks the link itself, never what it points at.
_unlink_link_here() {
  [ -L "./${1}" ] && rm -f -- "./${1}"
  return 0
}
# The same directory, given back: $1 = the record, $2 = the file name.
_cred_window_close_here() {
  local _di _do _fi _fo
  read -r _di _do _fi _fo <<< "${1}"
  [ "$(stat -c '%d:%i' .)" = "${_di}" ] || return 1
  if [ "${_fi}" != "-" ] && [ -f "./${2}" ] && [ ! -L "./${2}" ] \
    && [ "$(stat -c '%d:%i' -- "./${2}")" = "${_fi}" ]; then
    chown -h "${_fo}" -- "./${2}"
  fi
  chown -h "${_do}" . && chmod 700 .
}
# In the real remote_backups (root's own; refused otherwise, since the account
# can swap in a directory it made, so no name in it can change under root): a
# link at paths is removed and paths/ is made 0755 as before, and
# ./.secret.txt goes to $1 with mode 0600, kept immutable for the run. Prints
# "file-id file-owner".
_rb_window_open_here() {
  local _f _fo
  _root_only . || return 2
  [ -L ./paths ] && rm -f -- ./paths
  [ -d ./paths ] && [ ! -L ./paths ] && chmod 755 ./paths
  [ -f ./.secret.txt ] && [ ! -L ./.secret.txt ] || return 1
  _f="$(stat -c '%d:%i' ./.secret.txt)" && _fo="$(stat -c '%u:%g' ./.secret.txt)" \
    || return 1
  chattr -i ./.secret.txt &> /dev/null
  chmod 600 ./.secret.txt && chown -h "${1}" ./.secret.txt
  chattr +i ./.secret.txt &> /dev/null
  echo "${_f} ${_fo}"
}
# The same file, given back: $1 = the record.
_rb_window_close_here() {
  local _fi _fo
  read -r _fi _fo <<< "${1}"
  _root_only . || return 2
  [ -f ./.secret.txt ] && [ ! -L ./.secret.txt ] \
    && [ "$(stat -c '%d:%i' ./.secret.txt)" = "${_fi}" ] || return 1
  local _rc=0
  chattr -i ./.secret.txt &> /dev/null
  chown -h "${_fo}" ./.secret.txt && chmod 600 ./.secret.txt || _rc=1
  chattr +i ./.secret.txt &> /dev/null
  return "${_rc}"
}

# Function to print env for debugging
_print_env() {
  if [ "$(id -u)" -eq 0 ] && [ -e "/root/.dev.server.cnf" ]; then
    _ENV=$(env 2>&1)
    echo
    echo "_ENV in $1 start"
    echo "${_ENV}"
    echo "_ENV in $1 end"
    echo
    _ENV=
  fi
}

# Base directory for user commands
_BASE_DIR="/data/disk"
_RUN_SUBDIR="static/control/.run"
_CMD_FILE="command.txt"

# Function to display usage information
_usage() {
  echo "Usage: $0 restore <SERVICE> [RESTORE_PATH] [RESTORE_TIME]"
  echo
  echo "Example command:"
  echo "  Restore:"
  echo "  $0 restore aws data/disk/o1/static/projects 1D"
  echo "  $0 restore b2 data/disk/o1/static/another-project 2W"
  echo
  echo "Supported services:"
  echo "  aws, aws_one_zone, aws_standard_ia, azure, b2, cloudflare, do_spaces, gcs, ibm, linode, wasabi"
  echo
  echo "NOTE: [RESTORE_PATH] must be an absolute path (no leading slash) of the file or directory to restore"
  echo
  exit 1
}

# Liveness for a recorded lock owner: the pid must exist AND still look
# like this tooling. A pid recycled by an unrelated long-lived process
# must not hold a backup lock forever, while a live run must never lose
# its lock. /proc is used instead of kill -0 because kill -0 reports
# EPERM for a live pid owned by another user -- this tool runs both as
# root and as the tenant system user. An unreadable or empty cmdline
# means the process exited (or is a zombie) between the checks: dead.
_pid_is_live() {
  local _pid=$1 _cmd
  [[ "${_pid}" =~ ^[0-9]+$ ]] || return 1
  [ -d "/proc/${_pid}" ] || return 1
  _cmd=$(tr '\0' ' ' < "/proc/${_pid}/cmdline" 2>/dev/null)
  [ -n "${_cmd}" ] || return 1
  case "${_cmd}" in
    *duplicity*|*multiback*|*mybackup*|*backboa*|*sequential_backups*) return 0 ;;
    *) return 1 ;;
  esac
}

# Function to create PID file; heals stale leftovers (dead owner,
# recycled pid, empty file) instead of treating any existing file as a
# live run -- a leftover from an interrupted run used to block every
# later attempt until removed by hand. A live owner's lock is never
# touched. Claim discipline against concurrent starters: the create is
# an atomic noclobber write that never overwrites; a stale file is
# removed only while it still holds the same dead pid, so a lock
# re-created in the gap is never swept up; and every successful claim
# is read back, so a starter whose fresh claim was swept by a slower
# healer detects the loss and re-enters instead of running unlocked.
_create_pid_file() {
  local _pidfile=$1 _old_pid _now_pid _try=0
  while [ "${_try}" -lt 3 ]; do
    _try=$((_try + 1))
    if ( set -o noclobber; echo $$ > "${_pidfile}" ) 2>/dev/null; then
      _now_pid=$(tr -dc '0-9' < "${_pidfile}" 2>/dev/null)
      if [ "${_now_pid}" = "$$" ]; then
        return 0
      fi
      continue
    fi
    _old_pid=$(tr -dc '0-9' < "${_pidfile}" 2>/dev/null)
    if _pid_is_live "${_old_pid}"; then
      echo "Process already running with PID ${_old_pid} holding ${_pidfile}"
      exit 1
    fi
    _now_pid=$(tr -dc '0-9' < "${_pidfile}" 2>/dev/null)
    if [ "${_now_pid}" = "${_old_pid}" ]; then
      echo "Removing stale PID file ${_pidfile} (pid ${_old_pid:-empty} not running)"
      rm -f "${_pidfile}"
    fi
  done
  echo "Process already running with PID file ${_pidfile}"
  exit 1
}

# Function to remove PID file
_remove_pid_file() {
  local _pidfile=$1
  if [ -f "${_pidfile}" ]; then
    rm -f "${_pidfile}" || {
      echo "Warning: Failed to remove PID file: ${_pidfile}"
    }
  fi
}

# Function to log validation issues
_log_issue() {
  local _type=$1
  local _file=$2
  local _message=$3
  echo "[$(date)] Validation issue type: [${_type}] in file: [${_file}] with error: ${_message}" >> "${_LOG_FILE}"
  if [ -n "${_MY_EMAIL}" ] && [ "${_INCIDENT_REPORT}" = "ALL" ]; then
    # Alert the admin
    echo "Sending Backup Validation Alert to ${_MY_EMAIL} on $(date)" >> ${_LOGFILE}
    s-nail -s "Backup Validation Alert for [$(hostname)] on $(date)" ${_MY_EMAIL} < ${_LOGFILE}
  fi
}

# Helper function to URL-encode using jq
_url_encode() {
  printf '%s' "$1" | jq -s -R -r @uri
}

# Function to escape values
_escape_value() {
  printf '%q' "$1"
}

# The names a per-account credentials file may set: the account writes that
# file, and this runs as root, so any other name (LD_PRELOAD, PATH, BASH_ENV,
# PYTHONPATH, AWS_CONFIG_FILE and the like) would steer root's own process.
# Such a line is ignored and logged; the backup runs on without it.
_CRED_NAMES_ALLOWED="KEEP_WITHIN FULL_BACKUP_FREQUENCY AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION AWS_DEFAULT_REGION AWS_SESSION_TOKEN AZURE_STORAGE_ACCOUNT AZURE_STORAGE_KEY AZURE_STORAGE_CONNECTION_STRING AZURE_CONNECTION_STRING B2_ACCOUNT_ID B2_APPLICATION_KEY DO_SPACES_KEY DO_SPACES_SECRET DO_SPACES_REGION GCS_ACCESS_KEY_ID GCS_SECRET_ACCESS_KEY IBM_ACCESS_KEY_ID IBM_SECRET_ACCESS_KEY IBM_REGION LINODE_ACCESS_KEY LINODE_SECRET_KEY LINODE_REGION R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_ACCOUNT_ID WASABI_ACCESS_KEY WASABI_SECRET_KEY WASABI_REGION"
_cred_name_allowed() {
  case " ${_CRED_NAMES_ALLOWED} " in
    *" ${1} "*) return 0 ;;
  esac
  return 1
}

# Function to sanitize and validate credentials file
_validate_credentials() {
  local _cred_file="$1"
  local _service="$2"
  local _line_number=0

  while IFS= read -r _line || [ -n "${_line}" ]; do
    _line_number=$(( _line_number + 1 ))
    # Trim leading and trailing whitespace
    _line="${_line#"${_line%%[![:space:]]*}"}"
    _line="${_line%"${_line##*[![:space:]]}"}"

    # Skip comments and empty lines
    if [[ -z "${_line}" || "${_line}" == \#* ]]; then
      continue
    fi

    # Remove 'export ' prefix if present
    _line="${_line#export }"

    # Validate the variable assignment
    if [[ "${_line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(\".*\"|'.*'|[^[:space:]]+)$ ]]; then
      local _varname="${BASH_REMATCH[1]}"
      local _value="${BASH_REMATCH[2]}"

      # a per-account file (the tenant's) sets only the names above
      case "${_cred_file}" in
        /data/disk/*)
          if ! _cred_name_allowed "${_varname}"; then
            _log_issue "credentials" "${_cred_file}" \
              "Name not allowed at line ${_line_number}: ${_varname}"
            continue
          fi
          ;;
      esac

      # Remove surrounding quotes if present
      if [[ "${_value}" =~ ^\".*\"$ || "${_value}" =~ ^\'.*\'$ ]]; then
        _value="${_value:1:-1}"
      fi

      # Check for forbidden characters in value
      if echo "${_value}" | grep -q -E '[$`(){};&|<>]'; then
        _log_issue "credentials" "${_cred_file}" "Forbidden characters in value at line ${_line_number}: ${_line}"
        continue
      fi

      # Safely export the variable. b2 alone embeds its key and secret
      # inside the duplicity target URL, so a reserved character in
      # either would corrupt the URL; percent-encode its values. Every
      # other service authenticates via env vars, where an encoded
      # value would break auth, so their values must stay verbatim.
      if [ "${_service}" = "b2" ]; then
        export ${_varname}=$(_url_encode "${_value}")
      else
        export ${_varname}="${_value}"
      fi
    else
      _log_issue "credentials" "${_cred_file}" "Invalid syntax at line ${_line_number}: ${_line}"
    fi
  done <<< "$(timeout 10 dd if="${_cred_file}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2>/dev/null)"
  _print_env "mybackup_validate_credentials"
}

# Function to load credentials
_load_credentials() {
  local _service="$1"
  local _user="$2"
  if [ "${_user}" != "arch" ] \
    && [ "${_user}" != "data" ] \
    && [ "${_user}" != "global" ] \
    && [ "${_user}" != "static" ] \
    && [ "${_user}" != "custom" ]; then
    _cred_file="/data/disk/${_user}/static/control/remote_backups/credentials/${_service}.txt"
    _secret_file="/data/disk/${_user}/remote_backups/.secret.txt"
  fi
  if [ "${_user}" = "global" ] || [ "${_user}" = "data" ] || [ "${_user}" = "custom" ]; then
    _cred_file="/root/.remote_backups/credentials/${_service}.txt"
    _secret_file="/root/.remote_backups/.secret.txt"
  fi

  if [ -f "${_secret_file}" ]; then
    export PASSPHRASE=$(cat "${_secret_file}")
  else
    echo "Secret file ${_secret_file} not found. Unable to proceed."
    exit 1
  fi

  if [ ! -f "${_cred_file}" ]; then
    echo "Error: Credentials file '${_cred_file}' not found."
    exit 1
  fi

  _validate_credentials "${_cred_file}" "${_service}"
  _print_env "mybackup_load_credentials"
}

# Function to load paths configuration
_load_paths() {
  local _user="$1"
  if [ "${_user}" != "arch" ] \
    && [ "${_user}" != "data" ] \
    && [ "${_user}" != "global" ] \
    && [ "${_user}" != "static" ] \
    && [ "${_user}" != "custom" ]; then
    local _paths_file="/data/disk/${_user}/remote_backups/paths/paths.txt"
  fi
  if [ "${_user}" = "global" ] || [ "${_user}" = "data" ] || [ "${_user}" = "custom" ]; then
    local _paths_file="/root/.remote_backups/paths/${_user}_paths.txt"
  fi

  if [ ! -f "${_paths_file}" ]; then
    echo "Error: Paths configuration file '${_paths_file}' not found."
    exit 1
  fi

  if [ "${_user}" != "arch" ]; then
    source "${_paths_file}"
  fi
  _print_env "mybackup_load_paths"
}

# Function to construct _BUCKET_NAME
_construct_bucket_name() {
  local _service_abbr=$1
  local _user=$2
  _service_dash=$(echo -n ${_service_abbr} | tr _ - 2>&1)
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n')"
  # dead-fallback fix: || bound to tr, see backboa
  [ -n "${_hName}" ] || _hName="$(hostname -f 2>/dev/null)"
  _hst_dash=$(echo -n ${_hName} | tr . -)
  export _BUCKET_NAME="back-to-${_user}-${_hst_dash}-${_service_dash}"
  export _NAME="${_user}-${_service_dash}"
}

# Function to notify user about completed restore
_send_restore_confirmation_email() {
  local _recipient=$1
  local _subject=$2

  if [ -n "${_recipient}" ]; then
    echo "Sending email report on $(date)" >> ${_LOGFILE}
    s-nail -s "${_subject}" "${_recipient}" < ${_LOGFILE}
  fi
}

# After a root-run restore: duplicity re-applies the archived ownership, so
# a pre-conversion archive lands files in the box-wide group inside a
# converted account, and a foreign box's archive lands them in whatever its
# numbers map to here -- another account's group, readable by its
# identities. The destination is resolved first (relative paths, and a
# planted symlink under a tenant-writable directory, resolve to where the
# files really are) and only a real path inside an account's tree is
# touched: it is handed to that account's group (the inline form), then
# instgrp reclaim redoes the whole account where it is installed (every
# root, the marker rule, the DRIFT verdict). A restore staged anywhere else
# is the operator's to follow with 'instgrp reclaim oN' once it is in place.
# Verbatim in backboa, duobackboa, multiback and mybackup. $1 = restored dir.
_acct_reclaim_restored() {
  local _r _a _g
  _r=$(realpath -e -- "$1" 2> /dev/null) || return 0
  [ -d "${_r}" ] || return 0
  case "${_r}" in
    /data/disk/*) _a="${_r#/data/disk/}"; _a="${_a%%/*}" ;;
    /home/*)      _a="${_r#/home/}"; _a="${_a%%/*}"; _a="${_a%%.*}" ;;
    *) return 0 ;;
  esac
  [ -n "${_a}" ] && [ "${_a}" != "all" ] && getent passwd "${_a}" > /dev/null 2>&1 || return 0
  _g=$(_acct_group "${_a}" 2> /dev/null)
  [ -n "${_g}" ] || _g="users"
  find -P "${_r}" ! -group "${_g}" ! -group www-data ! -group root -execdir chgrp -h "${_g}" {} + 2> /dev/null
  if [ -x "/opt/local/bin/instgrp" ]; then
    bash /opt/local/bin/instgrp reclaim "${_a}" > /dev/null 2>&1
  fi
  return 0
}

# Function to restore backup
_restore() {
  local _restore_path=$1
  local _restore_time=$2
  local _restore_command="${_DCY_MN_CMD} restore --no-restore-owner"
  local _restore_target="/data/disk/${_user}/static/restores"

  # Ensure _restore_target exists
  if [ ! -d "${_restore_target}" ]; then
    echo "Creating restore target directory: ${_restore_target}"
    mkdir -p ${_restore_target}
    chown ${_user}:$(_acct_group "${_user}") ${_restore_target}
  fi

  # Remove any trailing slash from _restore_path for proper basename extraction
  _clean_restore_path="${_restore_path%/}"

  # Extract the last part (basename) of the restore path.
  _last_part=$(basename "${_clean_restore_path}")

  # Combine _restore_target with the extracted basename.
  # Also, remove any trailing slash from _restore_target to avoid double slashes.
  _final_restore_target="${_restore_target%/}/${_last_part}"

  if [ -n "${_restore_time}" ]; then
    _restore_command="${_restore_command} --time ${_restore_time}"
  fi
  _restore_command="${_restore_command} ${_BACKUP_TARGET}"
  if [ -n "${_restore_path}" ]; then
    _restore_command="${_restore_command} --path-to-restore ${_restore_path}"
  fi
  _restore_command="${_restore_command} ${_final_restore_target}"

  echo "Command is ${_restore_command}"

  echo "MyBackup Restore for [${_user}] on [$(date)]" >> ${_LOGFILE}
  eval "${_restore_command}" >> ${_LOGFILE}
  # --no-restore-owner lands the tree root-owned: hand it to the account,
  # owner and group, then the shared restore claim (every restored path,
  # the whole account where instgrp is installed).
  if [ -d "${_final_restore_target}" ]; then
    chown -R -h -P "${_user}:$(_acct_group "${_user}")" "${_final_restore_target}" &> /dev/null
  fi
  _acct_reclaim_restored "${_final_restore_target}"
  if [ -n "${_userEmail}" ]; then
    _subject="MyBackup Restore Notification [${_user}] on [$(date)]"
    _send_restore_confirmation_email "${_userEmail}" "${_subject}"
  fi
}

# Function to set backup target based on service
_set_backup_target() {
  local _service=$1
  local _user=$2

  case "${_service}" in
    aws|aws_one_zone|aws_standard_ia)
      _load_credentials "${_service}" "${_user}"
      _construct_bucket_name "${_service}" "${_user}"

      # Define S3-specific options
      _s3_endpoint="https://s3.dualstack.${AWS_REGION}.amazonaws.com"
      _s3_options="--s3-endpoint-url ${_s3_endpoint} --s3-region-name ${AWS_REGION}"

      # Use intelligent-tiering options for specific services
      if [ "${_service}" = "aws_standard_ia" ] || [ "${_service}" = "aws_one_zone" ]; then
        _s3_options="${_s3_options} --s3-use-ia"
      fi

      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} ${_s3_options}"
      ;;
    azure)
      _load_credentials "azure" "${_user}"
      _construct_bucket_name "azure" "${_user}"

      # Duplicity's azure backend reads one name, AZURE_CONNECTION_STRING,
      # and takes the container from the URL (azure://<container>); an
      # account@container URL is refused as an invalid container name. A
      # connection string carries ';', which no credentials value may, so it
      # is composed here from the documented account and key names.
      if [ -z "${AZURE_CONNECTION_STRING}" ] \
        && [ -n "${AZURE_STORAGE_ACCOUNT}" ] && [ -n "${AZURE_STORAGE_KEY}" ]; then
        export AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=${AZURE_STORAGE_ACCOUNT};AccountKey=${AZURE_STORAGE_KEY};EndpointSuffix=core.windows.net"
      fi
      _BACKUP_TARGET="azure://${_BUCKET_NAME}"
      ;;
    b2)
      _load_credentials "b2" "${_user}"
      _construct_bucket_name "b2" "${_user}"
      _BACKUP_TARGET="b2://${B2_ACCOUNT_ID}:${B2_APPLICATION_KEY}@${_BUCKET_NAME}"
      ;;
    cloudflare)
      _load_credentials "cloudflare" "${_user}"
      _construct_bucket_name "cloudflare" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials;
      # R2 expects the literal region "auto"
      export AWS_ACCESS_KEY_ID="${R2_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${R2_SECRET_ACCESS_KEY}"
      _r2_endpoint="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_r2_endpoint} --s3-region-name auto"
      ;;
    do_spaces)
      _load_credentials "do_spaces" "${_user}"
      _construct_bucket_name "do_spaces" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials
      export AWS_ACCESS_KEY_ID="${DO_SPACES_KEY}"
      export AWS_SECRET_ACCESS_KEY="${DO_SPACES_SECRET}"
      _do_endpoint="https://${DO_SPACES_REGION}.digitaloceanspaces.com"
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_do_endpoint} --s3-region-name ${DO_SPACES_REGION}"
      ;;
    gcs)
      _load_credentials "gcs" "${_user}"
      _construct_bucket_name "gcs" "${_user}"

      # Duplicity has no native gs:// backend; use the GCS XML
      # interoperability API with HMAC keys via the boto3 backend
      # A credentials file written before the HMAC switch carries the
      # pre-HMAC key names, so stop nameably instead of handing
      # duplicity an empty key pair
      if [[ -z "${GCS_ACCESS_KEY_ID}" ]] || [[ -z "${GCS_SECRET_ACCESS_KEY}" ]]; then
        echo "Error: no GCS_ACCESS_KEY_ID / GCS_SECRET_ACCESS_KEY pair in the gcs credentials file"
        echo "Error: see README.txt in the same directory for the expected variable names"
        exit 1
      fi
      export AWS_ACCESS_KEY_ID="${GCS_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${GCS_SECRET_ACCESS_KEY}"
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url https://storage.googleapis.com"
      ;;
    ibm)
      _load_credentials "ibm" "${_user}"
      _construct_bucket_name "ibm" "${_user}"

      # Duplicity has no native ibmcos:// backend; use the IBM COS
      # S3-compatible endpoint with HMAC service credentials
      # A credentials file written before the HMAC switch carries the
      # pre-HMAC key names, so stop nameably instead of handing
      # duplicity an empty key pair
      if [[ -z "${IBM_ACCESS_KEY_ID}" ]] || [[ -z "${IBM_SECRET_ACCESS_KEY}" ]]; then
        echo "Error: no IBM_ACCESS_KEY_ID / IBM_SECRET_ACCESS_KEY pair in the ibm credentials file"
        echo "Error: see README.txt in the same directory for the expected variable names"
        exit 1
      fi
      export AWS_ACCESS_KEY_ID="${IBM_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${IBM_SECRET_ACCESS_KEY}"
      _ibm_endpoint="https://s3.${IBM_REGION}.cloud-object-storage.appdomain.cloud"
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_ibm_endpoint}"
      ;;
    linode)
      _load_credentials "linode" "${_user}"
      _construct_bucket_name "linode" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials
      export AWS_ACCESS_KEY_ID="${LINODE_ACCESS_KEY}"
      export AWS_SECRET_ACCESS_KEY="${LINODE_SECRET_KEY}"
      _linode_endpoint="https://${LINODE_REGION}.linodeobjects.com"
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_linode_endpoint} --s3-region-name ${LINODE_REGION}"
      ;;
    wasabi)
      _load_credentials "wasabi" "${_user}"
      _construct_bucket_name "wasabi" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials
      export AWS_ACCESS_KEY_ID="${WASABI_ACCESS_KEY}"
      export AWS_SECRET_ACCESS_KEY="${WASABI_SECRET_KEY}"
      _wasabi_endpoint="https://s3.${WASABI_REGION}.wasabisys.com"
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_wasabi_endpoint} --s3-region-name ${WASABI_REGION}"
      ;;
    *)
      echo "Error: Unknown service ${_service}"
      exit 1
      ;;
  esac
}

# Function to validate restore command
_validate_restore_command() {
  # Store all arguments in an array
  local args=("$@")

  # Now use the array indices to assign variables.
  # Note: Array indices start at 0.
  local _action="${args[0]}"
  local _service="${args[1]}"
  local _restore_path="${args[2]}"
  local _restore_time="${args[3]}"

  # Ensure the command starts with "restore"
  if [[ "${_action}" != "restore" ]]; then
    echo "Error: Invalid command action '${_action}'. Only 'restore' is allowed."
    return 1
  fi

  # Validate service
  case "${_service}" in
    aws|aws_one_zone|aws_standard_ia|azure|b2|cloudflare|do_spaces|gcs|ibm|linode|wasabi)
      # Valid services
      ;;
    *)
      echo "Error: Invalid service '${_service}'."
      return 1
      ;;
  esac

  # Validate restore path (optional, no leading slash, no whitespace).
  # Whitespace forbid is part of the queue-file hardening: the queue stores
  # one arg per line, so a path containing whitespace would round-trip into
  # multiple args on the consumer side. Disallow it at the producer to keep
  # producer and consumer in agreement on argument count. BOA's tenant
  # directory layout never includes whitespace in real paths, so this does
  # not block legitimate restores.
  if [[ -n "${_restore_path}" && "${_restore_path}" =~ ^/ ]]; then
    echo "Error: Restore path '${_restore_path}' must not have a leading slash."
    return 1
  fi
  if [[ -n "${_restore_path}" && "${_restore_path}" =~ [[:space:]] ]]; then
    echo "Error: Restore path '${_restore_path}' must not contain whitespace."
    return 1
  fi

  # Reject obvious metacharacters too. These should already be impossible
  # via lshell on the producer side, but the consumer re-runs this validator
  # against queue content that the operator can technically write directly
  # (the queue file lives under .ftp-owned static/control/), so defence in
  # depth here closes the loop.
  if [[ -n "${_restore_path}" && "${_restore_path}" =~ [\;\&\|\`\$\<\>\(\)\{\}\"\'\\] ]]; then
    echo "Error: Restore path '${_restore_path}' contains forbidden characters."
    return 1
  fi

  # Validate restore time (optional, must match supported formats: 1D, 7D, 2W, etc.)
  if [[ -n "${_restore_time}" && ! "${_restore_time}" =~ ^[0-9]+[DWMY]$ ]]; then
    echo "Error: Invalid restore time format '${_restore_time}'. Supported formats: 1D, 7D, 2W, etc."
    return 1
  fi

  # Command is valid
  _print_env "mybackup_validate_restore_command"
  return 0
}

# Check if run as root
export _run_as_user=$(whoami)

# Main script
_main_script() {
  _CNT=$(( $(pgrep -fc '^([^ ]*/)?((ba|da)?sh|python[0-9.]*) (-[^ ]+ )*[^ ]*duplicity( |$)') + $(pgrep -fc '^[^ ]*duplicity( |$)') ))
  if (( _CNT > 0 )); then
    echo "[$(date)] Active duplicity process detected, will try again later..." >> /var/log/mybackup_waiting_queue.log
    exit 1
  fi
  # Process queued commands for all users.
  # A passive mirror must never execute this queue: command.txt lives in
  # the synced static/control tree, so a tenant request queued on the
  # ACTIVE arrives here by rsync -- replaying it would run a duplicity
  # restore into the synced tree as the tenant and mail them a duplicate
  # notice. Leave the file alone; the active consumes its own copy.
  [ -e "/root/.standby.cnf" ] && return 0
  for _user_dir in "${_BASE_DIR}"/*; do
    if [[ -d "${_user_dir}" ]]; then
      export _user=$(basename "${_user_dir}")
      export _user_run_dir="${_user_dir}/${_RUN_SUBDIR}"
      export _user_cmd_file="${_user_run_dir}/${_CMD_FILE}"
      if [[ -f "${_user_cmd_file}" ]]; then
        # These paths hang off static/control, which the tenant owns, so every
        # component here is a name it can replace with a symlink. The leaf is
        # not enough: a planted INTERMEDIATE link (static/control itself,
        # control/remote_backups or .run) redirects every operand below it, so
        # refuse the whole run -- before the queue is even read -- when any
        # ancestor is a link or the queue file is one. A refused queue is left
        # where it is (never removed through a path that is not the account's
        # own) and logged each run. A name can still be swapped after this
        # check, so everything below also acts only inside the real directory.
        _user_ctl_ok=YES
        for _p in "/data/disk/${_user}/static" \
          "/data/disk/${_user}/static/control" \
          "/data/disk/${_user}/static/control/remote_backups" \
          "/data/disk/${_user}/remote_backups" \
          "${_user_run_dir}" "${_user_cmd_file}"; do
          if [ -L "${_p}" ]; then
            _user_ctl_ok=NO
            echo "[$(date)] REFUSED for ${_user}: ${_p} is a symlink" \
              >> /var/log/mybackup_invalid_queued.log
          fi
        done
        if [ "${_user_ctl_ok}" != "YES" ]; then
          continue
        fi
        # Read the queue file as one arg per line, inside the real .run
        # directory, without following a link or blocking on a FIFO put at
        # the name, at most 4 KiB. The producer side (printf '%s\n' "$@")
        # writes the validated args this way; old space-joined queue files
        # left over from before this change parse as a single args[0] that
        # will fail the "restore"-only check below and be rejected.
        local _queued_args=()
        mapfile -t _queued_args <<< "$(_acct_in_real_dir "${_user_run_dir}" \
          _queue_read_here "${_CMD_FILE}")"

        # Re-validate before exec. The queue file lives under
        # /data/disk/<user>/static/control/.run/ which is .ftp-writable
        # (manage_ltd_users.sh chowns static/control to <user>.ftp); we
        # cannot trust that the file was actually written via the validated
        # CLI path on the .ftp side.
        if ! _validate_restore_command "${_queued_args[@]}"; then
          echo "[$(date)] Invalid queued command for ${_user}: $(printf '%q ' "${_queued_args[@]}")" \
            >> /var/log/mybackup_invalid_queued.log
          _acct_in_real_dir "${_user_run_dir}" rm -f -- "./${_CMD_FILE}"
          continue
        fi

        # Open the restore window (see _cred_window_open_here). The account's
        # remote_backups must be root's own directory; one it swapped in is
        # refused like a link, and the queue is left where it is.
        local _rb_dir="/data/disk/${_user}/remote_backups"
        local _ctl_rb_dir="/data/disk/${_user}/static/control/remote_backups"
        local _user_credentials_dir="${_ctl_rb_dir}/credentials"
        local _cred_name="${_queued_args[1]}.txt"
        local _rb_rec="" _cred_rec="" _rb_rc=0
        if [ -e "${_rb_dir}" ]; then
          _rb_rec="$(_acct_in_real_dir "${_rb_dir}" _rb_window_open_here "${_user}")"
          _rb_rc=$?
          if [ "${_rb_rc}" != 0 ] && ! _acct_in_real_dir "${_rb_dir}" true; then
            _rb_rc=2
          fi
        fi
        if [ "${_rb_rc}" = 2 ]; then
          echo "[$(date)] REFUSED for ${_user}: ${_rb_dir} is not root's own directory" \
            >> /var/log/mybackup_invalid_queued.log
          continue
        fi
        [ "${_rb_rc}" = 0 ] || _rb_rec=""
        echo "Executing backup restore for user ${_user}."
        # A link at credentials is removed, never followed, as before.
        _acct_in_real_dir "${_ctl_rb_dir}" _unlink_link_here credentials
        _cred_rec="$(_acct_in_real_dir "${_user_credentials_dir}" \
          _cred_window_open_here "${_user}" "${_cred_name}")" || _cred_rec=""
        # Pass the validated args positionally via -- so each arg arrives at
        # the inner mybackup as a separate $1/$2/$3/$4. No shell-interpolation
        # of attacker-controlled bytes; metacharacters in any arg are inert.
        su -s /bin/bash - "${_user}" -c 'exec mybackup "$@"' -- "${_queued_args[@]}"
        wait
        # Clean up the command file
        local _command_log="$(printf '%q ' "${_queued_args[@]}")"
        echo "[$(date)] Command was run for user ${_user}: ${_command_log}" >> /var/log/mybackup_commands_history.log
        # log/ is the account's own: appended inside the real directory
        _acct_in_real_dir "/data/disk/${_user}/log" _acct_append_here \
          mybackup_commands_history.log \
          "[$(date)] Command was run for user ${_user}: ${_command_log}"
        _acct_in_real_dir "${_user_run_dir}" rm -f -- "./${_CMD_FILE}"
        # Close the window: ownership goes back to the recorded owners, and a
        # failure to do so is logged, never retried by path.
        if [ -n "${_cred_rec}" ] && ! _acct_in_real_dir "${_user_credentials_dir}" \
          _cred_window_close_here "${_cred_rec}" "${_cred_name}"; then
          echo "[$(date)] NOT RESTORED for ${_user}: owner of ${_user_credentials_dir} (${_cred_rec})" \
            >> /var/log/mybackup_invalid_queued.log
        fi
        if [ -n "${_rb_rec}" ] && ! _acct_in_real_dir "${_rb_dir}" \
          _rb_window_close_here "${_rb_rec}"; then
          echo "[$(date)] NOT RESTORED for ${_user}: owner of ${_rb_dir}/.secret.txt (${_rb_rec})" \
            >> /var/log/mybackup_invalid_queued.log
        fi
        sleep 10
      fi
    fi
  _print_env "mybackup_run_as_user"
  export _user=
  export _user_run_dir=
  export _user_cmd_file=
  done
  exit 0
}

if [[ "$#" -eq 0 ]] && [ "${_run_as_user}" = "root" ]; then
  _main_script
fi

# Extract the current user
export _user=$(whoami | sed 's/\.ftp$//')

_userEmail=""
[ -e "/data/disk/${_user}/log/email.txt" ] && _userEmail="$(cat /data/disk/${_user}/log/email.txt)"
[ -n "${_userEmail}" ] && export _userEmail=$(echo -n ${_userEmail} | tr -d "\n" 2>&1)

if [[ $(whoami) == *.ftp ]]; then
  _user_run_dir="/data/disk/${_user}/static/control/.run"
  [ ! -e "${_user_run_dir}" ] && mkdir -p "${_user_run_dir}"
  # Check if there is any task queued already
  [ -e "${_user_run_dir}/${_CMD_FILE}" ] && echo "Previous task is still in the queue. Please try again later."
  # Validate the command
  if ! _validate_restore_command "$@"; then
    echo "Error: Invalid command. The command has not been queued."
    # Optionally log invalid commands
    echo "[$(date)] Invalid command attempted by $(whoami): $*" >> ${_user_run_dir}/mybackup_invalid_commands.log
    exit 1
  fi

  # If invoked as USER.ftp, queue the command. One argument per line so the
  # root-side consumer can read it via mapfile and pass the args positionally
  # to su -c. The previous `echo "$@" > ...` form stored a space-joined string
  # which the consumer then re-interpolated into "su -c 'mybackup ${_command}'"
  # — letting a .ftp user who wrote the queue file directly inject shell
  # metacharacters and escape lshell into the per-tenant system user.
  printf '%s\n' "$@" > "${_user_run_dir}/${_CMD_FILE}"
  echo "Command queued for user ${_user}..."
  echo "It will be executed by the system shortly..."
  echo "Bye!"
  exit 0
fi

export _ACTION=$1
export _SERVICE=$2
export _RESTORE_PATH="${3:-}"
export _RESTORE_TIME="${4:-}"

# Defence-in-depth: re-validate even on the system-user execution path.
# The root cron consumer already validates the queued args before su, but
# this branch also runs when the per-tenant system user invokes mybackup
# directly (which they can). Validating here means _restore() can rely on
# its inputs being free of shell metacharacters before they reach the
# duplicity eval at line 255.
if ! _validate_restore_command "${_ACTION}" "${_SERVICE}" "${_RESTORE_PATH}" "${_RESTORE_TIME}"; then
  echo "Error: Invalid command."
  exit 1
fi

export _PIDFILE="/data/disk/${_user}/log/mybackup_${_SERVICE}_${_user}.pid"
export _LOGPTH="/data/disk/${_user}/log"
export _LOGFILE="${_LOGPTH}/mybackup_${_SERVICE}_${_user}.log"

export _DCY_MN_CMD="/usr/local/bin/duplicity \
    --name=${_NAME} \
    --allow-source-mismatch \
    --concurrency 4"

_create_pid_file "${_PIDFILE}"
# Set only after the lock is ours -- an exit on a held lock must not
# remove the owner's file; a signal death re-enters the EXIT trap.
# From here down the trap is the SINGLE lock releaser. Never add an
# explicit release to an error path: it removes the file, and the trap
# then removes it again on the way out, so a successor that acquired
# the lock in between loses it to the predecessor's trap. The bare
# exit is enough on every path below.
trap "rm -f '${_PIDFILE}'; exit" EXIT
trap 'exit 1' INT TERM HUP

# Load paths configuration
_load_paths "${_user}"

_print_env "mybackup_main"

case "${_ACTION}" in
  restore)
    _set_backup_target "${_SERVICE}" "${_user}"
    _restore "${_RESTORE_PATH}" "${_RESTORE_TIME}"
    ;;
  *)
    _usage
    ;;
esac

# The EXIT trap is the single lock releaser: an explicit release here
# opened a window in which a successor's freshly acquired lock would be
# removed again by the trap at exit

# Wipe out any exported variables to clean up env after running the backup
  export PASSPHRASE=
  export _ACTION=
  export _BACKUP_TARGET=
  export _BUCKET_NAME=
  export _DCY_MN_CMD=
  export _NAME=
  export _PIDFILE=
  export _RESTORE_PATH=
  export _RESTORE_TIME=
  export _SERVICE=
  export _cred_file=
  export _paths_file=
  export _r2_endpoint=
  export _run_as_user=
  export _secret_file=
  export _user=
  export _userEmail=

_print_env "mybackup_exit"
exit 0
