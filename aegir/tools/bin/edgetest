#!/bin/bash

# edgetest — automated checks for the BOA edge-policy stack: AI bot
# classification, Cloudflare realip, the csf->nginx web-ban mirror, and the
# per-site AI / IP access controls. Companion to docs/AI-POLICY-TESTING.md — it
# automates the parts that can run from the box itself and prints a plain
# pass/fail report so a first-time admin can see at a glance what works.
#
# Two modes:
#   default (local) — tests the LOCAL nginx; the box must HOST --site. HTTP probes
#     go to 127.0.0.1 (via --resolve). Inspects local config and (with --full) runs
#     state-changing proofs. --full cleans up after itself, even on Ctrl-C; run it
#     on a DISPOSABLE test VM, not production.
#   --remote — tests the LIVE site over the network from THIS box's IP (real DNS, no
#     --resolve). Read-only; runs the AI matrix + rate-limit against the real site and
#     shows whether this box's IP is ip_access-allowed. Use it to check a site hosted
#     on ANOTHER box (e.g. is my whitelisted IP allowed, a non-whitelisted one denied).
#     Local-config and --full phases are skipped (they concern the local box).
#
# A 444 (guard/throttle) shows up to curl as code 000; a 5xx (backend/upstream
# error) and a 403 (ip_access deny) are reported as inconclusive, not as policy
# results.
#
# HTTPS is NOT assumed: probes try https first and fall back to http when https is
# not cleanly served (e.g. a test VM with no real SSL behind a self-signed proxy
# that 5xx's). Force a scheme with --http / --https.
#
# Usage:
#   edgetest [--site <vhost>] [--oct <octopus>] [--test-ip <ip>] [--full | --remote] [--http | --https]
#
# Examples:
#   edgetest --site example.com --oct o1            # read-only, local box
#   edgetest --site example.com --oct o1 --full     # + state-changing proofs (test VM)
#   edgetest --site example.com --remote            # probe the live site from this box

set -u

_usage() {
  grep '^# ' "$0" | sed 's/^# \{0,1\}//'
}

# --- output -----------------------------------------------------------------
if [[ -t 1 ]]; then
  _CG=$'\033[32m'; _CR=$'\033[31m'; _CY=$'\033[33m'; _CB=$'\033[1m'; _C0=$'\033[0m'
else
  _CG=; _CR=; _CY=; _CB=; _C0=
fi
_PASS=0; _FAIL=0; _WARN=0; _SKIP=0
_pass() { echo "  ${_CG}PASS${_C0}  $*"; _PASS=$((_PASS + 1)); }
_fail() { echo "  ${_CR}FAIL${_C0}  $*"; _FAIL=$((_FAIL + 1)); }
_warn() { echo "  ${_CY}WARN${_C0}  $*"; _WARN=$((_WARN + 1)); }
_skip() { echo "  ${_CY}SKIP${_C0}  $*"; _SKIP=$((_SKIP + 1)); }
_note() { echo "        $*"; }
_head() { echo; echo "${_CB}== $* ==${_C0}"; }

# --- args -------------------------------------------------------------------
_SITE=""; _OCT=""; _TEST_IP="203.0.113.7"; _FREE_IP="198.51.100.250"; _FULL=0; _REMOTE=0
_SCHEME=https; _PORT=443; _FORCE_SCHEME=""; _SCHEME_NOTE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --site)    _SITE="${2:-}"; shift 2 ;;
    --oct)     _OCT="${2:-}"; shift 2 ;;
    --test-ip) _TEST_IP="${2:-}"; shift 2 ;;
    --full)    _FULL=1; shift ;;
    --remote)  _REMOTE=1; shift ;;
    --http)    _FORCE_SCHEME=http; shift ;;
    --https)   _FORCE_SCHEME=https; shift ;;
    -h|--help) _usage; exit 0 ;;
    *) echo "unknown option: $1"; echo; _usage; exit 1 ;;
  esac
done

if [[ "${_REMOTE}" -eq 1 && "${_FULL}" -eq 1 ]]; then
  echo "Note: --full is ignored with --remote (the state-changing proofs are local-only)."
  _FULL=0
fi
if [[ "${_REMOTE}" -eq 1 && -z "${_SITE}" ]]; then
  echo "--remote needs --site <vhost> to probe."; exit 1
fi

# --- environment sanity -----------------------------------------------------
if [[ "${_REMOTE}" -eq 0 ]]; then
  if [[ ! -d /var/xdrago ]] || ! command -v nginx >/dev/null 2>&1; then
    echo "Local mode needs a BOA box (/var/xdrago + nginx). Use --remote to test a site"
    echo "over the network, or run this on the host that serves --site."
    exit 1
  fi
  if [[ "${_FULL}" -eq 1 && "$(id -u)" -ne 0 ]]; then
    echo "--full runs state-changing tests and must be run as root."
    exit 1
  fi
else
  command -v curl >/dev/null 2>&1 || { echo "--remote needs curl."; exit 1; }
fi

# --- cleanup of --full test artifacts (idempotent; runs on any exit) --------
_emergency_cleanup() {
  # Read-only / remote runs create no artifacts — never touch csf or control files
  # (even a no-match `sed -i` rewrites the file and would bump its change-gate).
  [[ "${_FULL}" -eq 1 ]] || return 0
  rm -f /data/conf/nginx_cloudflare_real_ip.conf-edgetest 2>/dev/null
  if command -v csf >/dev/null 2>&1; then csf -tr "${_TEST_IP}" >/dev/null 2>&1; fi
  if [[ -n "${_OCT}" ]]; then
    sed -i '/# edge-policy-test$/d' "/data/disk/${_OCT}/static/control/ai/policy.txt" 2>/dev/null
    sed -i '/# edge-policy-test$/d' "/data/disk/${_OCT}/static/control/ip/access.txt" 2>/dev/null
    rm -f "/data/disk/${_OCT}/config/includes/ip_access/edgetest.example.com.conf" 2>/dev/null
  fi
  bash /var/xdrago/ai_policy.sh  >/dev/null 2>&1
  bash /var/xdrago/ip_access.sh  >/dev/null 2>&1
  bash /var/xdrago/nginx_deny.sh >/dev/null 2>&1
  service nginx reload >/dev/null 2>&1
}
trap _emergency_cleanup EXIT

# --- HTTP helpers -----------------------------------------------------------
# Echo "<http_code> <curl_exit>". Local mode forces the request to 127.0.0.1 (the
# LOCAL nginx) via --resolve; --remote uses real DNS to reach the live site. An
# nginx `return 444` closes the connection with no reply -> curl reports code 000
# + exit 52/56 (16/92 over h2). The classifiers below interpret all that.
_http() {
  local _code _ex _url="${_SCHEME}://${_SITE}${2:-/}"
  if [[ "${_REMOTE}" -eq 1 ]]; then
    _code=$(curl -sk --http1.1 -o /dev/null -w '%{http_code}' --max-time 10 \
      -A "$1" "${_url}" 2>/dev/null)
  else
    _code=$(curl -sk --http1.1 -o /dev/null -w '%{http_code}' --max-time 10 \
      --resolve "${_SITE}:${_PORT}:127.0.0.1" -A "$1" "${_url}" 2>/dev/null)
  fi
  _ex=$?
  echo "${_code} ${_ex}"
}
_http_cfip() {  # local-only (used by the realip+ban proof)
  local _code _ex
  _code=$(curl -sk --http1.1 -o /dev/null -w '%{http_code}' --max-time 10 \
    --resolve "${_SITE}:${_PORT}:127.0.0.1" -H "CF-Connecting-IP: $1" -A "${2:-Mozilla/5.0}" \
    "${_SCHEME}://${_SITE}/" 2>/dev/null)
  _ex=$?
  echo "${_code} ${_ex}"
}
_blocked()      { [[ "$1" == "444" ]] || { [[ "$1" == "000" ]] && [[ "$2" == "52" || "$2" == "56" || "$2" == "16" || "$2" == "92" ]]; }; }
_unreachable()  { [[ "$1" == "000" ]] && [[ "$2" == "7" || "$2" == "28" || "$2" == "6" || "$2" == "35" ]]; }
_server_error() { [[ "$1" =~ ^5[0-9][0-9]$ ]]; }   # 5xx: backend/upstream error (incl. a proxied 502)
_denied()       { [[ "$1" == "403" ]]; }           # ip_access (or other) deny — not the AI policy

# Probe scheme: prefer https, fall back to http when https is not cleanly served
# (TLS failure, unreachable, or a 5xx — e.g. a self-signed proxy with no real SSL).
# A 403/444/2xx/3xx all mean "https responds" -> keep https. --http/--https force it.
# A scheme is "clean" only if TWO consecutive probes are both cleanly served. The
# no-real-SSL self-signed-proxy pattern returns 200 on the FIRST request then 5xx on
# the rest, so a single probe would wrongly trust https. Sets _SCHEME/_PORT as a side
# effect (so _http uses them); returns 0 only when both probes are clean.
_scheme_clean() {  # <scheme> <port>
  local _s="$1" _p="$2" _i _o
  _SCHEME="${_s}"; _PORT="${_p}"
  for _i in 1 2; do
    _o=$(_http "Mozilla/5.0"); set -- $_o
    { _unreachable "$1" "$2" || _server_error "$1"; } && return 1
  done
  return 0
}
_detect_scheme() {
  [[ -z "${_SITE}" ]] && return
  if [[ -n "${_FORCE_SCHEME}" ]]; then
    _SCHEME="${_FORCE_SCHEME}"; [[ "${_SCHEME}" == "http" ]] && _PORT=80 || _PORT=443
    return
  fi
  _scheme_clean https 443 && return                      # _SCHEME/_PORT left at https/443
  if _scheme_clean http 80; then                         # _SCHEME/_PORT left at http/80
    _SCHEME_NOTE="HTTPS not cleanly served (no real SSL / proxy 5xx) — probing over HTTP; verify over HTTPS once real SSL is in place"
    return
  fi
  _SCHEME=https; _PORT=443   # neither clean; let the matrix baseline report it
}

_check_blocked() { # <label> <ua> <path> — expect a 444 block
  local _o; _o=$(_http "$2" "$3"); set -- "$1" $_o
  if   _blocked "$2" "$3";     then _pass "$1 -> blocked (444), as designed"
  elif _unreachable "$2" "$3"; then _warn "$1 -> unreachable (code $2 exit $3) — inconclusive"
  elif _server_error "$2";     then _warn "$1 -> HTTP $2 (backend/upstream 5xx) — inconclusive, not a policy result"
  elif _denied "$2";           then _warn "$1 -> HTTP 403 (denied by ip_access before the guard) — inconclusive"
  else _fail "$1 -> got HTTP $2 (expected a 444 block)"; fi
}
_check_allowed() { # <label> <ua> — expect NOT blocked
  local _o; _o=$(_http "$2" "/"); set -- "$1" $_o
  if   _unreachable "$2" "$3"; then _warn "$1 -> unreachable (code $2 exit $3) — inconclusive"
  elif _server_error "$2";     then _warn "$1 -> HTTP $2 (backend/upstream 5xx) — inconclusive"
  elif _denied "$2";           then _warn "$1 -> HTTP 403 (denied by ip_access, not the AI policy) — inconclusive"
  elif _blocked "$2" "$3";     then _fail "$1 -> blocked (444) but should be ALLOWED"
  else _pass "$1 -> allowed (HTTP $2), as designed"; fi
}

# --- read-only phases -------------------------------------------------------
_phase_presence() {
  _head "presence (tools, cron, nginx)"
  local _t
  for _t in ip_access ai_policy nginx_deny cloudflare_realip; do
    [[ -e "/var/xdrago/${_t}.sh" ]] && _pass "tool present: ${_t}.sh" \
      || _fail "tool MISSING: /var/xdrago/${_t}.sh (run a BOA up?)"
  done
  local _cron; _cron=$(crontab -l 2>/dev/null)
  for _t in ip_access ai_policy nginx_deny cloudflare_realip; do
    echo "${_cron}" | grep -q "${_t}.sh" && _pass "cron scheduled: ${_t}.sh" \
      || _warn "no cron entry for ${_t}.sh"
  done
  service nginx configtest >/dev/null 2>&1 && _pass "nginx configtest OK" \
    || _fail "nginx configtest FAILED (config currently broken)"
  pgrep -x nginx >/dev/null 2>&1 && _pass "nginx is running" || _fail "nginx is not running"
}

_phase_realip_config() {
  _head "realip configuration"
  local _rf="/data/conf/nginx_cloudflare_real_ip.conf"
  if [[ -s "${_rf}" ]] && grep -q '^set_real_ip_from ' "${_rf}"; then
    _pass "CF ranges include present ($(grep -c '^set_real_ip_from ' "${_rf}") ranges)"
  else
    _warn "CF ranges include missing/empty (${_rf}) — run /var/xdrago/cloudflare_realip.sh"
  fi
  local _conf; _conf=$(nginx -T 2>/dev/null)
  echo "${_conf}" | grep -qE 'real_ip_header[[:space:]]+CF-Connecting-IP' \
    && _pass "real_ip_header CF-Connecting-IP active in running config" \
    || _fail "real_ip_header not found in running config"
  echo "${_conf}" | grep -q 'set_real_ip_from' \
    && _pass "set_real_ip_from loaded into running config" \
    || _warn "no set_real_ip_from in running config (realip inactive until ranges load)"
}

_phase_ai_matrix() {
  _head "AI bot policy — default classes (UA-based)"
  [[ -z "${_SITE}" ]] && { _skip "need --site <vhost> for the AI matrix"; return; }
  # Local mode: confirm THIS nginx actually serves --site, else --resolve 127.0.0.1
  # just hits the default server and the matrix is meaningless. (Skip the check when
  # `nginx -T` is unreadable — e.g. a non-root run — to avoid a false "not served".)
  if [[ "${_REMOTE}" -eq 0 ]]; then
    local _ngt _esc; _ngt=$(nginx -T 2>/dev/null); _esc="${_SITE//./\\.}"
    if [[ -n "${_ngt}" ]] && ! echo "${_ngt}" | grep -E '^[[:space:]]*server_name' | grep -qE "(^|[[:space:]])${_esc}([[:space:]]|;)"; then
      _warn "local nginx has no server_name for ${_SITE} — this box does not serve it"
      _note "edgetest (without --remote) tests the LOCAL nginx; run it on the host serving ${_SITE}, or use --remote. Skipping the AI matrix."
      return
    fi
  fi
  local _o; _o=$(_http "Mozilla/5.0 (X11; Linux x86_64)"); set -- $_o
  if _unreachable "$1" "$2"; then
    _warn "baseline browser request to ${_SITE} failed (code $1 exit $2) — check --site / reachability"
    _note "skipping the AI matrix (need a reachable baseline)"; return
  fi
  if _server_error "$1"; then
    _warn "baseline returned HTTP $1 (backend/upstream 5xx) — the site/upstream is unhealthy"
    _note "skipping the AI matrix (a 5xx baseline makes every result inconclusive)"; return
  fi
  if _denied "$1"; then
    if [[ "${_REMOTE}" -eq 1 ]]; then
      _pass "${_SITE} returned 403 — this box's IP is denied by ip_access (the restriction is enforcing)"
      _note "if this box SHOULD be allowed, add its IP to the site's ip_access list. AI matrix skipped (denied vantage)."
    else
      _warn "baseline denied (HTTP 403) from localhost — unexpected (localhost should be anti-lockout-allowed)"
      _note "skipping the AI matrix (denied vantage)"
    fi
    return
  fi
  _pass "baseline browser request reachable (HTTP $1)"
  _check_blocked "training  GPTBot"          "GPTBot/1.1"       "/"
  _check_blocked "forged    Google-Extended" "Google-Extended" "/"
  _check_blocked "secret    /.env"           "Mozilla/5.0"      "/.env"
  _check_blocked "secret    /.git/config"    "Mozilla/5.0"      "/.git/config"
  _check_allowed "search    OAI-SearchBot"   "OAI-SearchBot/1.0"
  _check_allowed "user      ChatGPT-User"    "ChatGPT-User/1.0"
  _check_allowed "utility   OAI-AdsBot"      "OAI-AdsBot/1.0"
  _check_allowed "browser   Mozilla"         "Mozilla/5.0 (X11; Linux x86_64)"
}

_phase_ratelimit() {
  _head "AI rate limiting (throttle returns 444; a burst shows some pass, some blocked)"
  [[ -z "${_SITE}" ]] && { _skip "need --site"; return; }
  local _o; _o=$(_http "Mozilla/5.0"); set -- $_o
  if _unreachable "$1" "$2" || _server_error "$1" || _denied "$1"; then
    _skip "baseline not cleanly served (code $1) — rate-limit needs a reachable, allowed, healthy baseline"; return
  fi
  # search is allowed-but-rate-limited: a fast burst should let a few through and
  # throttle the rest with 444 (limit_req_status is 444, not 503).
  local _i _ok=0 _throttled=0 _err=0
  for _i in $(seq 1 25); do
    _o=$(_http "OAI-SearchBot/1.0"); set -- $_o
    if _blocked "$1" "$2"; then _throttled=$((_throttled + 1))
    elif _unreachable "$1" "$2" || _server_error "$1"; then _err=$((_err + 1))
    else _ok=$((_ok + 1)); fi
  done
  if   [[ "${_ok}" -eq 0 && "${_throttled}" -eq 0 ]]; then
    _warn "search burst returned no clean responses (${_err}/25 errored) — inconclusive"
  elif [[ "${_throttled}" -gt 0 && "${_ok}" -gt 0 ]]; then
    _pass "search class rate-limited under a burst (${_ok} passed, ${_throttled} throttled with 444)"
  elif [[ "${_throttled}" -eq 0 ]]; then
    _warn "no throttling in a 25-request burst — rate-limit may be loose (search zone is 1r/s)"
  else
    _fail "search fully blocked (${_throttled}/25 throttled, 0 passed) — search should be allowed + rate-limited, not blocked"
  fi
  local _bthrottled=0
  for _i in $(seq 1 25); do _o=$(_http "Mozilla/5.0"); set -- $_o; _blocked "$1" "$2" && _bthrottled=$((_bthrottled + 1)); done
  if [[ "${_bthrottled}" -eq 0 ]]; then _pass "browser traffic not charged to an AI zone (0/25 throttled)"
  else _fail "browser got ${_bthrottled} throttled (444) responses — a browser must never hit an AI rate zone"; fi
}

_phase_fragments() {
  _head "per-site control fragments"
  [[ -z "${_OCT}" ]] && { _skip "need --oct <instance> to inspect fragments"; return; }
  [[ -e "/data/disk/${_OCT}/tools/drush" ]] && _pass "${_OCT} is a real Octopus instance (tools/drush present)" \
    || _warn "${_OCT}/tools/drush not found — is ${_OCT} a real instance?"
  local _d
  for _d in ai_policy ip_access; do
    local _p="/data/disk/${_OCT}/config/includes/${_d}"
    if [[ -d "${_p}" ]]; then
      _pass "${_d} fragments dir present ($(find "${_p}" -maxdepth 1 -name '*.conf' 2>/dev/null | wc -l | tr -d ' ') site fragment(s))"
    else
      _note "no ${_d} fragments dir for ${_OCT} yet (none configured — fine)"
    fi
  done
}

_phase_ban_config() {
  _head "csf -> nginx ban wiring"
  local _bf="/data/conf/nginx_banned_ips.conf"
  [[ -e "${_bf}" ]] && _pass "ban set file present ($(grep -c ' 1;$' "${_bf}" 2>/dev/null) banned IP(s))" \
    || _note "ban set file ${_bf} not present yet (no web bans active — fine)"
  nginx -T 2>/dev/null | grep -q 'geo $remote_addr $is_banned' \
    && _pass "geo \$is_banned map loaded in running config (R4 enforcement wired)" \
    || _fail "geo \$is_banned map NOT in running config — R4 ban enforcement not wired"
}

_phase_regression() {
  _head "regression spot-checks"
  if command -v netstat >/dev/null 2>&1; then
    local _ssh; _ssh=$(netstat -tn 2>/dev/null | awk '$4 ~ /:22$/ && $6 == "ESTABLISHED" { print $5 }' | head -1)
    [[ -n "${_ssh}" ]] && _pass "netstat sees an established SSH peer (ip_access anti-lockout source works)" \
      || _note "no established SSH peer via netstat (fine if you are on console)"
  else
    _warn "netstat not found — ip_access SSH anti-lockout source unavailable on this box"
  fi
  if [[ -e /etc/csf/csf.allow ]]; then
    grep -qE ':[0-9a-fA-F]*:' /etc/csf/csf.allow 2>/dev/null \
      && _warn "IPv6-looking entries in csf.allow (BOA is IPv4-only by policy)" \
      || _pass "no IPv6 entries in csf.allow (matches IPv4-only policy)"
  fi
}

# --- --full (state-changing) phases -----------------------------------------
_phase_realip_ban_proof() {
  _head "realip + ban enforcement proof (mutating)"
  [[ -z "${_SITE}" ]] && { _skip "need --site"; return; }
  command -v csf >/dev/null 2>&1 || { _skip "csf not found"; return; }
  # An ip_access-restricted site would 403 the spoofed test IP (ip_access) BEFORE the
  # ban guard returns 444 — the proof can't read cleanly. Skip it.
  if [[ -n "${_OCT}" && -f "/data/disk/${_OCT}/config/includes/ip_access/${_SITE}.conf" ]]; then
    _skip "${_SITE} is ip_access-restricted — ip_access would 403 the spoofed test IP before the ban guard; use an unrestricted site for this proof"
    return
  fi
  local _o; _o=$(_http_cfip "${_FREE_IP}"); set -- $_o
  if _unreachable "$1" "$2" || _server_error "$1"; then _warn "site not cleanly served (code $1) — cannot run the ban proof"; return; fi
  # 1. trust localhost so a CF-Connecting-IP header rewrites $remote_addr
  local _trust="/data/conf/nginx_cloudflare_real_ip.conf-edgetest"
  echo "set_real_ip_from 127.0.0.1;" > "${_trust}"
  if ! service nginx configtest >/dev/null 2>&1; then _fail "configtest failed adding localhost trust"; rm -f "${_trust}"; return; fi
  service nginx reload >/dev/null 2>&1
  # 2. web-ban the sentinel IP via csf, mirror into nginx
  csf -td "${_TEST_IP}" 300 -p 80 >/dev/null 2>&1
  bash /var/xdrago/nginx_deny.sh >/dev/null 2>&1
  grep -q "^${_TEST_IP} 1;" /data/conf/nginx_banned_ips.conf 2>/dev/null \
    && _pass "nginx_deny mirrored the csf web ban (${_TEST_IP}) into the geo set" \
    || _fail "nginx_deny did NOT mirror the csf web ban (${_TEST_IP}) — check the csf.tempban port filter"
  # 3. request AS the banned IP (via the realip header) -> must be blocked
  _o=$(_http_cfip "${_TEST_IP}"); set -- $_o
  if   _blocked "$1" "$2";   then _pass "CF-Connecting-IP=${_TEST_IP} (banned) -> blocked: realip rewrite AND geo ban both bite"
  elif _denied "$1";         then _warn "banned IP -> HTTP 403 (ip_access denied before the ban guard) — realip works but the site is restricted; inconclusive"
  elif _server_error "$1";   then _warn "banned IP -> HTTP $1 (5xx) — inconclusive"
  else _fail "banned IP via realip header -> HTTP $1 (expected block) — realip or ban not biting"; fi
  # 4. a non-banned IP must NOT be blocked
  _o=$(_http_cfip "${_FREE_IP}"); set -- $_o
  if   _blocked "$1" "$2"; then _fail "non-banned IP via realip header -> blocked — ban is too broad"
  elif _denied "$1";       then _warn "non-banned IP -> HTTP 403 (ip_access) — inconclusive (site restricted)"
  else _pass "CF-Connecting-IP=${_FREE_IP} (not banned) -> allowed (HTTP $1) — ban is selective"; fi
  # 5. cleanup
  rm -f "${_trust}"
  csf -tr "${_TEST_IP}" >/dev/null 2>&1
  bash /var/xdrago/nginx_deny.sh >/dev/null 2>&1
  service nginx reload >/dev/null 2>&1
}

_phase_persite_ai() {
  _head "per-site AI policy toggle (mutating)"
  [[ -z "${_SITE}" || -z "${_OCT}" ]] && { _skip "need --site and --oct"; return; }
  [[ -e "/data/disk/${_OCT}/tools/drush" ]] || { _skip "${_OCT} is not a real instance"; return; }
  local _ctrl="/data/disk/${_OCT}/static/control/ai/policy.txt"
  local _o; _o=$(_http "GPTBot/1.1"); set -- $_o
  if _server_error "$1" || _unreachable "$1" "$2"; then _skip "site not cleanly served (code $1) — cannot test the toggle"; return; fi
  if ! _blocked "$1" "$2"; then _skip "GPTBot is already allowed for ${_SITE} (HTTP $1) — cannot test the toggle"; return; fi
  mkdir -p "$(dirname "${_ctrl}")"
  echo "${_SITE} train-allow # edge-policy-test" >> "${_ctrl}"
  bash /var/xdrago/ai_policy.sh >/dev/null 2>&1
  # nginx's reload is graceful/async — a probe fired immediately races the old
  # workers, so settle first. The >1s wait ALSO advances the control mtime past the
  # generate second, so ai_policy's second-granularity change-gate fires on the
  # restore below (regenerating --site's fragment to its real, test-line-removed
  # state — a direct rm is unsafe here: --site may carry a legitimate record).
  sleep 2
  _o=$(_http "GPTBot/1.1"); set -- $_o
  if ! _blocked "$1" "$2"; then _pass "train-allow opt-in took effect: GPTBot now allowed (HTTP $1) for ${_SITE}"
  else _fail "train-allow opt-in did NOT take effect: GPTBot still blocked"; fi
  sed -i '/# edge-policy-test$/d' "${_ctrl}" 2>/dev/null
  bash /var/xdrago/ai_policy.sh >/dev/null 2>&1
  sleep 2   # settle the prune reload before re-checking
  _o=$(_http "GPTBot/1.1"); set -- $_o
  _blocked "$1" "$2" && _pass "removing the record restored the default block (GPTBot 444 again)" \
    || _warn "after removing the record GPTBot is still allowed (HTTP $1) — check pruning"
}

_phase_ipaccess_validation() {
  _head "ip_access input validation + anti-lockout (mutating)"
  [[ -z "${_OCT}" ]] && { _skip "need --oct"; return; }
  [[ -e "/data/disk/${_OCT}/tools/drush" ]] || { _skip "${_OCT} is not a real instance"; return; }
  local _ctrl="/data/disk/${_OCT}/static/control/ip/access.txt"
  local _frag="/data/disk/${_OCT}/config/includes/ip_access/edgetest.example.com.conf"
  mkdir -p "$(dirname "${_ctrl}")"
  echo "edgetest.example.com 198.51.100.7 192.168.1.300 # edge-policy-test" >> "${_ctrl}"
  bash /var/xdrago/ip_access.sh >/dev/null 2>&1
  if [[ -f "${_frag}" ]]; then
    grep -q '^allow 198.51.100.7;' "${_frag}" && ! grep -q '192.168.1.300' "${_frag}" \
      && _pass "kept the valid IP and SKIPPED the out-of-range octet (192.168.1.300)" \
      || _fail "fragment wrong: valid IP missing or bad octet present"
    grep -q '^allow 127.0.0.1;' "${_frag}" && grep -q '^deny all;' "${_frag}" \
      && _pass "anti-lockout present (127.0.0.1 + deny all)" \
      || _fail "anti-lockout missing (127.0.0.1 / deny all)"
  else
    _fail "ip_access did not generate a fragment for the test record"
  fi
  service nginx configtest >/dev/null 2>&1 \
    && _pass "nginx configtest still OK — one bad octet did not break the config box-wide" \
    || _fail "nginx configtest FAILED after the test record — validation gap"
  # Cleanup: remove the control line AND the fragment directly — do not rely on the
  # generator's prune, whose second-granularity change-gate can skip a re-run that
  # lands in the same second as the create.
  sed -i '/# edge-policy-test$/d' "${_ctrl}" 2>/dev/null
  rm -f "${_frag}"
  bash /var/xdrago/ip_access.sh >/dev/null 2>&1
  [[ -f "${_frag}" ]] && _warn "test fragment reappeared (${_frag})" || _pass "test record cleaned up"
}

_phase_idempotence() {
  _head "generator idempotence (ai_policy, run twice — change-gate must hold)"
  bash /var/xdrago/ai_policy.sh >/dev/null 2>&1
  local _out; _out=$(bash /var/xdrago/ai_policy.sh 2>&1)
  echo "${_out}" | grep -qiE 'updated|reloaded|pruned' \
    && _warn "ai_policy reported changes on a second consecutive run — change-gate may not hold" \
    || _pass "ai_policy second run was a no-op (change-gate holds)"
}

# --- run --------------------------------------------------------------------
_MODE=read-only; [[ "${_FULL}" -eq 1 ]] && _MODE=full; [[ "${_REMOTE}" -eq 1 ]] && _MODE=remote
_detect_scheme
echo "${_CB}BOA edge-policy test${_C0}  site=${_SITE:-<none>}  oct=${_OCT:-<none>}  mode=${_MODE}  scheme=${_SCHEME}"
[[ -n "${_SCHEME_NOTE}" ]] && _warn "${_SCHEME_NOTE}"

if [[ "${_REMOTE}" -eq 1 ]]; then
  _head "remote mode — probing the live site over the network from this box's IP"
  _note "local-box config checks and --full proofs are skipped; this tests what ${_SITE} returns to requests from here (AI policy, and whether this IP is ip_access-allowed)."
  _phase_ai_matrix
  _phase_ratelimit
else
  _phase_presence
  _phase_realip_config
  _phase_ai_matrix
  _phase_ratelimit
  _phase_fragments
  _phase_ban_config
  _phase_regression
  if [[ "${_FULL}" -eq 1 ]]; then
    _phase_realip_ban_proof
    _phase_persite_ai
    _phase_ipaccess_validation
    _phase_idempotence
  else
    _head "state-changing proofs"
    _skip "realip+ban, per-site toggle, ip_access validation, idempotence — re-run as root with --full (on a test VM)"
  fi
fi

# --- summary ----------------------------------------------------------------
echo
echo "${_CB}== summary ==${_C0}"
echo "  ${_CG}${_PASS} passed${_C0}   ${_CR}${_FAIL} failed${_C0}   ${_WARN} warnings   ${_SKIP} skipped"
if [[ "${_FAIL}" -eq 0 ]]; then
  echo "  ${_CG}All critical checks passed.${_C0}"
  exit 0
fi
echo "  ${_CR}${_FAIL} check(s) failed — review the FAIL lines above.${_C0}"
exit 1
