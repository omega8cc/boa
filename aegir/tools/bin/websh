#!/bin/bash

export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec:/usr/local/ssl3

_DEST_DRUSH="/opt/tools/drush/8/drush/drush.php"

# Exact group membership, order-independent. id -nG prints the PRIMARY group
# first, so the whole-string and end-anchored comparisons this file used to
# make ("users www-data", "lshellg"$) silently stop matching the moment an
# account's primary group moves (per-instance groups) or a group is appended
# to a tenant identity -- and a tenant that falls out of the gate below gets
# an UNFILTERED dash instead of the dispatch and path policy. Test membership
# of one named group, never the shape of the list.
_in_grp() {
  local _g
  for _g in ${_LTD_GID}; do
    [ "${_g}" = "${1}" ] && return 0
  done
  return 1
}

# Exact group SET, order-independent: the historical whole-string forms
# ("www-data users", "users www-data", "aegir www-data users") matched an
# identity by its complete list, so keep that meaning -- same members, any
# order -- rather than widening it to "has both". Pure bash on purpose: the
# system binaries are root:users 0750 here, so an identity outside 'users'
# (the FPM pool user) cannot run sort/tr, and this runs for every identity.
# $1 = the expected set, space-separated.
_grp_set_is() {
  local _g _e
  for _g in ${_LTD_GID}; do
    case " ${1} " in
      *" ${_g} "*) ;;
      *) return 1 ;;
    esac
  done
  for _e in ${1}; do
    _in_grp "${_e}" || return 1
  done
  return 0
}

# lshell applies its noexec layer in the command line itself: every segment
# outside allowed_shell_escape arrives as  LD_PRELOAD=<sudo_noexec.so> cmd ...
# (an assignment prefix dash applies to that one command), so the text below
# is handed to dash exactly as received. A branch here used to strip
# "LD_PRELOAD...so" out of the line for ltd-shell-more members and exec the
# rest straight into dash. It was written for the pre-0.10 lshell that
# prepended the preload to the command text through its alias table; 0.10
# moved it into the environment and 0.11 into the line per segment, so on
# the fleet it could only fire on a member typing sudo_noexec.so into a
# line (skipping this function's option parsing and argv[0] normalisation,
# and re-running the line through an unquoted echo, word-split and
# glob-expanded), and with the prefix in the line it stripped the layer
# itself for that group (measured: every exec shape escaped). It is gone.
# A tenant must not hand drush a PHP file to load, a command that runs PHP,
# or an environment for the PHP process. Drush 8 has three option spellings
# that load a file: --config / -c (a drushrc, include_once), --early
# (require_once of the file), --include / -i (a directory of command files);
# each ran the tenant's own file as drush through the real login chain
# (measured 2026-09-07), past every drush token the forbidden list refuses,
# and a config file carries any refused option as well. The forbidden drush
# commands themselves (php-eval, php-script, core-cli, site-install, ...) are
# refused by lshell as typed-line substrings ("drush8 scr"), which an @alias
# or an option between the two words defeats: drush8 @site scr FILE ran the
# tenant's file through the real login chain (measured 2026-09-08). And a
# NAME=value word in front of drush, composer or php names php.ini for the
# process (PHPRC, PHP_INI_SCAN_DIR), whose auto_prepend_file is arbitrary
# PHP in a process the noexec layer leaves alone; lshell's own environment
# filter stops PATH and LD_*, not those. All three are tested here, on the
# STRING ABOUT TO BE HANDED TO DASH at every tenant exec site, never on the
# typed line, and on EVERY simple command of it: a drush behind a pipe (cat
# dump.sql | drush8 @site sqlc) reaches dash by PATH, not through the
# dispatch. The line is split the way dash splits it (see _drush_segments);
# each segment has its leading NAME=value words and leading shell words (!,
# command, env, a brace, ...) skipped, and only when what remains IS a drush
# invocation (drush/drushN/vdrush, a drush.php launcher, or php followed by
# one, php's own options skipped) are the option words tested (D), the drush
# command word -- the first word that is not an @alias, an option, the value
# of an option that takes one, or a redirection; a colon spelling read as
# its dash form -- looked up in the list below (E), which mirrors the
# forbidden drush tokens of the shipped lshell policy plus websh's own
# (xstatus, redis-flush); an environment word other than lshell's own
# LD_PRELOAD=<sudo_noexec.so> on a drush, composer or php segment is refused
# (F). A grep -c or tar -cf that merely names drush is never a hit. The
# Aegir backend, root and the instance users are not tenants and keep
# everything.
_DRUSH_REFUSED_CMDS="archive-restore arr core-config conf config core-execute exec execute core-quick-drupal qd ev eval php-eval php php-cli core-cli php-script scr rs runserver sha shell-alias si site-install sql-create ssh site-ssh sup site-upgrade xstatus redis-flush pm-updatecode upc"
_DR_WHY=""
# what dash reads as a boundary between simple commands (a pipe, the list
# separators, subshell parentheses, a backtick, a newline) and the three
# characters it reads specially inside a word (both quotes, the backslash,
# appended to the class where it is used)
_DR_SP="'\"|;&()\`"$'\n'
_drush_segments() {
  # every simple command of the line on its own line, quotes and backslashes
  # removed the way dash removes them: '...' literal to the closing quote,
  # "..." with a backslash escaping the next character, a bare backslash
  # escaping the next character. Braces stay in the word: dash reads { }
  # as reserved words in command position only, so a { before the drush
  # token is a leading word (skipped below) and anywhere else it is drush's
  # own argument, where a split would hide the option words behind it.
  # Chunked on the special characters rather than walked one character at
  # a time: the walk was quadratic in the line length.
  local _s="$1" _out="" _c
  while [ -n "${_s}" ]; do
    _c="${_s%%[${_DR_SP}\\]*}"
    _out+="${_c}"
    _s="${_s:${#_c}}"
    [ -n "${_s}" ] || break
    _c="${_s:0:1}"
    _s="${_s:1}"
    case "${_c}" in
      "'")
        _c="${_s%%\'*}"
        _out+="${_c}"
        _s="${_s:${#_c}+1}"
        ;;
      '"')
        while [ -n "${_s}" ]; do
          _c="${_s%%[\"\\]*}"
          _out+="${_c}"
          _s="${_s:${#_c}}"
          [ -n "${_s}" ] || break
          _c="${_s:0:1}"
          _s="${_s:1}"
          [ "${_c}" = '"' ] && break
          _out+="${_s:0:1}"
          _s="${_s:1}"
        done
        ;;
      '\')
        _out+="${_s:0:1}"
        _s="${_s:1}"
        ;;
      '&')
        # >& and <& are a redirection, not a list separator
        case "${_out}" in *[\<\>]) _out+='&' ;; *) _out+=$'\n' ;; esac
        ;;
      *)
        _out+=$'\n'
        ;;
    esac
  done
  printf '%s\n' "${_out}"
}
# A launcher line: an optionally quoted php (php, phpNN, /opt/phpNN/bin/php,
# /usr/bin/php) followed by a drush.php under /opt/tools, /data/disk,
# /mnt/.../data/disk or /var/aegir, or a vendor/drush/drush/drush.php
# (absolute or relative, the php prefix optional), read at the start of the
# line after an optional "set -m;", a leading "cd DIR &&" (kept in _LA_CD and
# put back in front of the exec line, so provision's cd-and-exec shape keeps
# the account's PHP) and leading NAME=value words. The launcher goes; the
# arguments travel as typed. The branches this replaces found the launcher
# ANYWHERE in the line with grep -o, removed every occurrence with sed and
# put the line through an unquoted echo, after stripping every single quote
# from any line naming drush: a quoted multi-word option value reached drush
# as separate words -- a server verify's --http_restart_cmd='sudo
# /etc/init.d/nginx reload' saved the alias with 'sudo' alone and provision
# never reloaded nginx again from that alias (measured 2026-09-08) -- and a
# quoted * was expanded against the cwd. The backend child that arrives with
# a quoted --php prefix took the verbatim fast lane above and was never hit;
# the bare-php launcher was.
_LA_PATH=""; _LA_REST=""; _LA_RM=""; _LA_PRE=""; _LA_CD=""
_RE_CD='^[[:space:]]*cd[[:space:]]+[^[:space:];&|]+[[:space:]]*(&&|;)[[:space:]]*'
# a token may be single-quoted as escapeshellarg spells it; the quotes must
# balance (a lone quote is the caller's, not a launcher)
_RE_LAPHP="('?(php|php[0-9][0-9]|/opt/php[0-9][0-9]/bin/php|/usr/bin/php|/usr/local/bin/php)'?)[[:space:]]+"
_RE_LADRUSH="('?(/opt/tools/drush/[^[:space:]']+/drush/drush\\.php|/data/disk/[^[:space:]']+/tools/drush/drush\\.php|/mnt/[^[:space:]']+/data/disk/[^[:space:]']+/tools/drush/drush\\.php|/var/aegir/drush/drush\\.php|[^[:space:]']*vendor/drush/drush/drush\\.php)'?)[[:space:]]+(.*)\$"
_quotes_balance() {
  case "$1" in
    \'*\') return 0 ;;
    *\'*) return 1 ;;
  esac
  return 0
}
_drush_launcher() {
  local _s="$1" _tok
  _LA_PATH=""; _LA_REST=""; _LA_RM=""; _LA_PRE=""; _LA_CD=""
  if [[ "${_s}" =~ ${_RE_SETM} ]]; then
    _s="${_s#"${BASH_REMATCH[0]}"}"
  fi
  if [[ "${_s}" =~ ${_RE_CD} ]]; then
    _LA_CD="${BASH_REMATCH[0]}"
    _s="${_s#"${_LA_CD}"}"
  fi
  while [[ "${_s}" =~ ${_RE_ASSIGN} ]]; do
    _LA_PRE+="${BASH_REMATCH[0]}"
    _s="${_s#"${BASH_REMATCH[0]}"}"
  done
  _s="${_s#"${_s%%[![:space:]]*}"}"
  if [[ "${_s}" =~ ^${_RE_LAPHP}${_RE_LADRUSH} ]] \
    && _quotes_balance "${BASH_REMATCH[1]}" && _quotes_balance "${BASH_REMATCH[3]}"; then
    _LA_PATH="${BASH_REMATCH[4]}"
    _LA_REST="${BASH_REMATCH[5]}"
  elif [[ "${_s}" =~ ^${_RE_LADRUSH} ]] && [[ "${BASH_REMATCH[2]}" == *vendor/drush/drush/drush.php ]] \
    && _quotes_balance "${BASH_REMATCH[1]}"; then
    _LA_PATH="${BASH_REMATCH[2]}"
    _LA_REST="${BASH_REMATCH[3]}"
  else
    _LA_PRE=""; _LA_CD=""
    return 1
  fi
  _LA_RM="${_LA_PATH//\//\\/}"
  return 0
}
# The composer line, the same way: the leading word after an optional
# "set -m;", a leading "cd DIR &&" and NAME=value words, the arguments as
# typed. The branch this replaces stripped "composer " everywhere with sed
# and word-split the rest, so provision's cd-and-exec form -- cd PLATFORM &&
# composer require drush/drush -- ran composer with the command "cd"
# (measured: Command "cd" is not defined) and never installed anything.
_CO_REST=""; _CO_PRE=""; _CO_CD=""
_RE_COLEAD='^[[:space:]]*composer[[:space:]]+(.*)$'
_composer_lead() {
  local _s="$1"
  _CO_REST=""; _CO_PRE=""; _CO_CD=""
  if [[ "${_s}" =~ ${_RE_SETM} ]]; then
    _s="${_s#"${BASH_REMATCH[0]}"}"
  fi
  if [[ "${_s}" =~ ${_RE_CD} ]]; then
    _CO_CD="${BASH_REMATCH[0]}"
    _s="${_s#"${_CO_CD}"}"
  fi
  while [[ "${_s}" =~ ${_RE_ASSIGN} ]]; do
    _CO_PRE+="${BASH_REMATCH[0]}"
    _s="${_s#"${BASH_REMATCH[0]}"}"
  done
  if [[ "${_s}" =~ ${_RE_COLEAD} ]]; then
    _CO_REST="${BASH_REMATCH[1]}"
    return 0
  fi
  _CO_PRE=""; _CO_CD=""
  return 1
}
_drush_cmd_word() {
  # the drush command word of an argument string: the first word that is
  # not an @alias, an option, the value of an option that takes one (drush
  # 8's -c -i -l -r -u; the long forms drush 10/11 accept with a space) or
  # a redirection (a bare operator takes the next word with it). read -a
  # splits on whitespace without expanding anything.
  local _ws _w _skip=NO
  read -r -a _ws <<< "$1"
  for _w in "${_ws[@]}"; do
    if [ "${_skip}" = "YES" ]; then
      _skip=NO
      continue
    fi
    case "${_w}" in
      @*|'{'|'}') ;;
      -c|-i|-l|-r|-u|--uri|--root|--user|--php|--php-options|--config|--include|--early|--alias-path|--define) _skip=YES ;;
      -*) ;;
      '>'|'>>'|'<'|'<>'|'>&'|'<&'|[0-9]'>'|[0-9]'>>'|[0-9]'<'|[0-9]'<>'|[0-9]'>&'|[0-9]'<&') _skip=YES ;;
      '>'*|'<'*|[0-9]'>'*|[0-9]'<'*) ;;
      *) printf '%s' "${_w}"; return 0 ;;
    esac
  done
  return 1
}
_drush_refused() {
  local _seg _w1 _w2 _rest _cw _f _n _env _again
  _DR_WHY=""
  while IFS= read -r _seg; do
    # leading NAME=value words and leading shell words, until neither
    # applies; an environment word other than lshell's own noexec prefix
    # is remembered for the php-running segments
    _again=YES
    _env=NO
    while [ "${_again}" = "YES" ]; do
      _again=NO
      while [[ "${_seg}" =~ ${_RE_ASSIGN} ]]; do
        _n="${BASH_REMATCH[0]}"
        _seg="${_seg#"${_n}"}"
        _n="${_n#"${_n%%[![:space:]]*}"}"
        case "${_n%%=*}" in
          LD_PRELOAD) case "${_n#*=}" in *sudo_noexec.so*) ;; *) _env=YES ;; esac ;;
          *) _env=YES ;;
        esac
        _again=YES
      done
      read -r _w1 _w2 _rest <<< "${_seg}"
      case "${_w1}" in
        '!'|'{'|'}'|command|exec|nohup|nice|time|env|if|then|else|elif|while|until|do)
          _seg="${_w2} ${_rest}"
          while [[ "${_seg}" =~ ^[[:space:]]*-[^[:space:]]*[[:space:]]* ]]; do
            _seg="${_seg#"${BASH_REMATCH[0]}"}"
          done
          _again=YES
          ;;
      esac
    done
    read -r _w1 _w2 _rest <<< "${_seg}"
    case "${_w1##*/}" in
      drush|drush8|drush10|drush11|vdrush|drush.php)
        _rest="${_w2} ${_rest}"
        ;;
      php|php[0-9][0-9])
        # php's own options before the launcher (-c FILE, -d k=v, -n, ...)
        _rest="${_w2} ${_rest}"
        while [[ "${_rest}" =~ ^[[:space:]]*(-c|-d|-f|-r|-z)[[:space:]]+[^[:space:]]+[[:space:]]* ]] \
          || [[ "${_rest}" =~ ^[[:space:]]*-[^[:space:]]*[[:space:]]* ]]; do
          _rest="${_rest#"${BASH_REMATCH[0]}"}"
        done
        read -r _w2 _rest <<< "${_rest}"
        case "${_w2##*/}" in
          drush|drush8|drush10|drush11|drush.php) ;;
          *)
            if [ "${_env}" = "YES" ]; then _DR_WHY=F; return 0; fi
            continue
            ;;
        esac
        ;;
      composer|*.php)
        if [ "${_env}" = "YES" ]; then _DR_WHY=F; return 0; fi
        continue
        ;;
      *) continue ;;
    esac
    if [ "${_env}" = "YES" ]; then _DR_WHY=F; return 0; fi
    if [[ "${_seg}" =~ (^|[[:space:]])--(config|early|include)(=|[[:space:]]|$) ]] \
      || [[ "${_seg}" =~ (^|[[:space:]])-[ci]([[:space:]]|$) ]]; then
      _DR_WHY=D
      return 0
    fi
    _cw=$(_drush_cmd_word "${_rest}")
    _cw="${_cw//:/-}"
    [ -n "${_cw}" ] || continue
    for _f in ${_DRUSH_REFUSED_CMDS}; do
      if [ "${_cw}" = "${_f}" ]; then
        _DR_WHY=E
        return 0
      fi
    done
  done < <(_drush_segments "$1")
  return 1
}
_is_tenant() {
  [[ "${_LTD_UID}" == *.ftp ]] || _in_grp lshellg || _in_grp ltd-shell || _in_grp ltd-shell-more
}
# every tenant exec site hands its final line through here
_exec_dash_c() {
  if _is_tenant && _drush_refused "$1"; then
    echo
    echo " This drush command is not available (${_DR_WHY})"
    echo
    exit 0
  fi
  exec /bin/dash -c "$1"
}

# The bare-verb dispatch reads the LEADING word of the line, never a
# substring of it. The branches it replaces tested "drush " anywhere in the
# line and then stripped EVERY occurrence of the matched token with sed, so a
# line whose ARGUMENT named drush was routed through drush and mangled:
# drush8 status | grep -i "drush version" ran as the drush command "8 status",
# a tenant's grep -c drush FILE was handed to drush and refused as its -c
# option, and drush8 status drush8 lost its argument (all measured through
# the real login chain, 2026-09-07/08). The token is read after an optional
# legacy "set -m;" (dropped, as before) and any leading NAME=value words, kept
# in _DL_PRE and put back in front of the launcher: lshell's per-segment
# noexec prefix is one (drush sits on every shell-escape list today, so it
# never carries it), and for a tenant any other name is refused at the exec
# site (_drush_refused, F) rather than handed to php. Only that
# one token goes; the arguments travel as typed -- no word-splitting, no glob
# expansion, no whitespace normalisation, which the unquoted echo | sed used
# to do to every drush line (a quoted select * from x was expanded against
# the cwd). A bare verb with no argument is not dispatched, as before.
_DL_TOK=""; _DL_PRE=""; _DL_REST=""
_RE_SETM='^[[:space:]]*set[[:space:]]+-m[[:space:]]*;[[:space:]]*'
_RE_ASSIGN='^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+'
_RE_DLEAD='^[[:space:]]*(drush|drush8|drush10|drush11)[[:space:]]+(.*)$'
_drush_lead() {
  local _s="$1"
  _DL_TOK=""; _DL_PRE=""; _DL_REST=""
  if [[ "${_s}" =~ ${_RE_SETM} ]]; then
    _s="${_s#"${BASH_REMATCH[0]}"}"
  fi
  while [[ "${_s}" =~ ${_RE_ASSIGN} ]]; do
    _DL_PRE+="${BASH_REMATCH[0]}"
    _s="${_s#"${BASH_REMATCH[0]}"}"
  done
  if [[ "${_s}" =~ ${_RE_DLEAD} ]]; then
    _DL_TOK="${BASH_REMATCH[1]}"
    _DL_REST="${BASH_REMATCH[2]}"
    return 0
  fi
  _DL_PRE=""
  return 1
}
_forward_to_dash() {
  # Path to the underlying shell (dash in this case)
  _shell="/bin/dash"
  # Name under which the shell should think it was invoked
  _shell_name="sh"
  # Arrays to hold options and positional parameters
  _options=()
  _positional=()
  # Variables to hold command strings or script files
  _command=""
  _script=""

  # Parse the options and arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        # End of options
        shift
        _positional+=("$@")
        break
        ;;
      -c)
        # Command option
        if [[ -n "$2" ]]; then
          if _is_tenant && _drush_refused "$2"; then
            echo
            echo " This drush command is not available (${_DR_WHY})"
            echo
            exit 0
          fi
          _options+=("-c" "$2")
          shift 2
          _positional+=("$@")
          break
        else
          echo "sh: option requires an argument -- 'c'" >&2
          exit 1
        fi
        ;;
      -i|-l|-s)
        # Other common options
        _options+=("$1")
        shift
        ;;
      -*)
        # Unrecognized options
        _options+=("$1")
        shift
        ;;
      *)
        # First non-option argument is the script file
        _script="$1"
        shift
        _positional+=("$@")
        break
        ;;
    esac
  done

  # Prepare to execute the underlying shell
  if [[ -n "${_script}" ]]; then
    # Execute a script file
    ### echo FWD 1 PARSED
    exec -a "${_shell_name}" "${_shell}" "${_options[@]}" "${_script}" "${_positional[@]}"
    exit 0
  else
    # Execute commands or start an interactive shell
    ### echo FWD 2 PARSED
    exec -a "${_shell_name}" "${_shell}" "${_options[@]}" "${_positional[@]}"
    exit 0
  fi
}

# POSIX allows -- to end the option list, and glibc has sent it since 2.38
# (BZ#28519, "system and popen should pass -- between /bin/sh and argument"):
# every libc system()/popen() caller now spawns  sh -c -- <command>  where
# older glibc sent  sh -c <command>. Measured: Excalibur (glibc 2.41) sends the
# separator for PHP exec(), PHP shell_exec() and python os.system() alike,
# Daedalus (glibc 2.36) sends none. Without this the separator itself landed in
# $2 and became the command, no allowlist could match it, and the run was denied
# with no output -- silently breaking every shell-out a site or drush makes on
# any trixie-based box. Drop the separator here, before anything reads the
# positional parameters, so the whole script sees the argv shape it always saw.
if [ "${1}" = "-c" ] && [ "${2}" = "--" ]; then
  shift 2
  set -- "-c" "$@"
fi

# Capture all arguments
_ALL="$@"
### echo "_ALL is ${_ALL}"

# Capture environment variables
_ENV=$(env 2>&1)
### echo "_ENV is ${_ENV}"

# Determine _ARGS based on the first argument
if [ "${1}" = "-c" ]; then
  _ARGS="${2}"
else
  _ARGS="${1}"
fi

### echo "_ARGS is ${_ARGS}"

# Composer >= 2.8.3 (and any symfony/process caller) invokes git/hg/svn/tar/... as
# argv-arrays, which symfony/process 5.x renders for /bin/sh (= websh) as
#   exec 'git' 'remote' '-v'
# or, on --enable-sigchild PHP builds, as
#   { (exec 'git' ...) <&3 3<&- 3>/dev/null & } 3<&0;...
# and Composer's OWN ProcessExecutor (plugin executeCommand, e.g. composer-patches
# applying a patch) renders the same argv as a quoted-verb string with NO exec prefix:
#   'git' -C '/path' apply --check --verbose -p2 '/path/to.patch'
# None of these forms match websh's bare-token or path checks below, so these legit
# subprocesses of an already-authorized parent were refused (exit 1) -- surfacing in
# Composer as "git was not found ... in your PATH env", and in composer-patches as
# "No available patcher was able to apply patch" with git never executed at all
# (found 2026-08-11 when every varbase core patch failed on a BOA box while applying
# cleanly by hand; the silent-refusal shape cost a day of patcher forensics).
# Read the normalised leading token, then exec the ORIGINAL string verbatim so its
# quoting and the sigchild fd-3 exit-code protocol both survive. An lshell user cannot
# forge this shape: exec/sh are not in allowed_shell_escape and the wrapper carries
# forbidden chars (; $! & { >&3).
#
# Pass through ONLY: (a) an absolute argv[0] - the caller already resolved the binary,
# incl. the /opt/phpNN/bin/php composer hands its own subprocesses, exactly as websh
# forwards absolute-path commands below without re-selecting PHP; and (b) bare VCS/archive
# helpers, which never need PHP-CLI selection. php/composer/drush by BARE name are NOT
# passed through: a user's top-level `composer`/`drush` is a bare string dispatched with
# PHP-version selection below, and composer's own php subprocess is an absolute-path
# string caught by (a) - so the PHP-CLI selection is never bypassed here.
# Only the bare-verb case list below is allowlist-equivalent. The absolute-path branch --
# shared by all three alternatives, not specific to the leading-quote one -- execs verbatim
# ahead of the group gate, the $0 check and the _IN_PATH path policy, so an absolute path
# that the policy would refuse must never reach it. Leads under the tenant-writable /tmp/
# and /home/ are therefore kept out of this fast lane and fall through to the normal path:
# the shell accounts already allowed those paths there still run them, everyone else gets
# the same refusal as for the bare spelling. /data/ deliberately keeps the fast lane --
# legit callers do resolve absolute binaries inside the platform tree -- so tightening it
# is a separate change, to be proven against a real composer/composer-patches run first.
if [ "${1}" = "-c" ] \
  && { [[ "${2}" == "exec "* ]] || [[ "${2}" == "{ (exec "* ]] || [[ "${2}" == "'"* ]]; }; then
  _SF_ORIG="${2}"
  _SF_CMD="${2#\{ (}"
  _SF_CMD="${_SF_CMD#exec }"
  _SF_CMD="${_SF_CMD//\'/}"
  _SF_LEAD="${_SF_CMD%% *}"
  _SF_SKIP=NO
  case "${_SF_LEAD}" in
    /tmp/*|/home/*)
      _SF_SKIP=YES
      ;;
  esac
  if [[ "${_SF_LEAD}" == /* ]] && [ "${_SF_SKIP}" = "NO" ]; then
    exec /bin/dash -c "${_SF_ORIG}"
    exit 0
  fi
  case "${_SF_LEAD}" in
    git|git-upload-pack|git-receive-pack|git-upload-archive|hg|svn|svnadmin|fossil|bzr|cvs|p4|tar|unzip|7z|7za|7zz|gzip|gunzip|bzip2|xz|unxz|zstd|unzstd)
      exec /bin/dash -c "${_SF_ORIG}"
      exit 0
      ;;
  esac
fi

if [[ "${_ARGS}" =~ "--php=" ]]; then
  PHP_FWD=YES
else
  PHP_FWD=
fi

if [[ "${_ARGS}" =~ "true COLUMNS=" ]]; then
  _R_M=`echo -n "${_ARGS}" | grep -o "true COLUMNS=[0-9]\+ "`
  ### Strip only the well-formed "true COLUMNS=NNN " prefix. On no match
  ### (malformed COLUMNS: empty value or non-space separator) leave _ARGS
  ### UNCHANGED - blanking it made the command miss every drush/composer/php
  ### branch below and fall through to a bare _forward_to_dash that bypasses
  ### per-account PHP-CLI selection. Empty match must not reach sed either:
  ### s///g errors to stderr on every non-drush /bin/sh -c (task-log noise).
  if [ -n "${_R_M}" ]; then
    _ARGS=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
  fi
fi

# No quote is ever removed from the line: the launcher parser reads a quoted
# php token where the backend child spells one, and every argument reaches
# dash as typed.

# The sudo test below is a WORD test: since lshell 0.11.8 a tenant line can
# carry LD_PRELOAD=<sudo_noexec.so path> on its non-escape segments (drush8
# status | LD_PRELOAD=/usr/libexec/sudo/sudo_noexec.so grep x), and a bare
# substring match on "sudo" sent every such line around this block.
# The drush dispatch: a launcher line or a bare-verb line, read at the head
# of the line (see _drush_launcher and _drush_lead). Lines naming composer,
# git, mysql or the sudo word take their own routes; a "cd DIR &&" prefix in
# front of a launcher is carried into the exec line by the parser, any other
# cd line is dash's.
_ARR=
if _drush_launcher "${_ARGS}"; then
  # a launcher is unambiguous at the head of the line, whatever its
  # arguments name (a db-server verify carries --master_db=mysql://..., an
  # alias may contain "git"): it is dispatched regardless of the words below
  _R_M="${_LA_RM}"
  _DL_PRE="${_LA_CD}${_LA_PRE}"
  _ARR=("${_LA_REST}")
elif [[ ! "${_ARGS}" =~ "composer" ]] \
  && [[ ! "${_ARGS}" =~ "git" ]] \
  && [[ ! "${_ARGS}" =~ "cd " ]] \
  && [[ ! "${_ARGS}" =~ "mysql" ]] \
  && [[ ! "${_ARGS}" =~ (^|[[:space:]])sudo([[:space:]]|$) ]] \
  && _drush_lead "${_ARGS}"; then
  # the bare verb leads the line: that one token goes, the rest is the
  # argument string as typed (_drush_lead above)
  _R_M="${_DL_TOK}"
  _ARR=("${_DL_REST}")
fi

_C_ARR=
if _composer_lead "${_ARGS}"; then
  _C_ARR=("${_CO_REST}")
fi

_INTERNAL=NO
_LTD_GID=$(id -nG ${USER} 2>&1)
_LTD_UID=$(id -nu ${USER} 2>&1)
if [ -z "${USER}" ]; then
  USER=$(id -nu ${USER} 2>&1)
  _LTD_QQQ=YES
fi
_X_USR=".*"
if [ "${USER}" = "aegir" ] \
  || [ "${HOME}" = "/var/aegir" ]; then
  _Y_USR=aegir
  _DRUSH_CLI_CTRL="/var/aegir/static/control"
  ### echo _DRUSH_CLI_CTRL is ${_DRUSH_CLI_CTRL}
else
  _Y_USR=${USER%${_X_USR}}
  _DRUSH_CLI_CTRL="/data/disk/${_Y_USR}/static/control"
  ### echo _DRUSH_CLI_CTRL is ${_DRUSH_CLI_CTRL}
fi
if [ -z "${HOME}" ]; then
  if [ -d "/home/${USER}/.tmp" ]; then
    HOME="/home/${USER}"
  elif [ -d "/data/disk/${_Y_USR}/.tmp" ]; then
    HOME="/data/disk/${_Y_USR}"
  elif [ -d "/var/${_Y_USR}/.tmp" ]; then
    HOME="/var/${_Y_USR}"
  fi
fi

# The alias listing is filtered for every identity that reaches drush here
# (the master, server and platform aliases stay out of it). It fires on the
# drush COMMAND WORD being sa or the aliases convenience -- the two
# spellings it always rewrote -- not on " sa" anywhere in the line, which
# rewrote drush8 status sa, drush8 en samlauth and drush8 @site vget sa into
# the listing (measured); site-alias with an argument passes through as it
# always did. Which drush answers follows the leading token; a launcher line
# keeps the tests this rewrite always made.
_DC_W=$(_drush_cmd_word "${_ARR}")
case "${_DC_W}" in
  sa|aliases)
    if [ -n "${_DL_TOK}" ]; then
      _DC_1011=NO; _DC_8=NO
      case "${_DL_TOK}" in drush10|drush11) _DC_1011=YES ;; *) _DC_8=YES ;; esac
    else
      _DC_1011=NO; _DC_8=NO
      if [[ "${_ALL}" =~ "drush10 " ]] || [[ "${_ALL}" =~ "drush11 " ]]; then _DC_1011=YES
      elif [[ "${_ALL}" =~ "drush " ]] || [[ "${_ALL}" =~ "drush8 " ]]; then _DC_8=YES; fi
    fi
    if [ "${_DC_1011}" = "YES" ]; then
      _ARR="sa --format=list | egrep -v \"(none|hostmaster|hm|server_|platform_|@none|@self)\""
    elif [ "${_DC_8}" = "YES" ]; then
      _ARR="sa | egrep -v \"(none|hostmaster|hm|server_|platform_|@none|@self)\""
    fi
    ;;
esac
# Which drush a dispatched line asks for: the leading token when the bare
# verb leads it, else (a launcher line) the substring tests the policy block
# below always made -- a "drush11 " inside an ARGUMENT of a drush8 line used
# to send the whole line to drush11 (measured).
_D_TOK=""; _D_IS=""
if [ -n "${_DL_TOK}" ]; then
  _D_TOK="${_DL_TOK}"
elif [[ "${_ARGS}" =~ "drush11 " ]]; then
  _D_TOK="drush11"
elif [[ "${_ARGS}" =~ "drush10 " ]]; then
  _D_TOK="drush10"
elif [[ "${_ARGS}" =~ "drush" ]]; then
  _D_TOK="drush"
fi
case "${_D_TOK}" in
  drush10|drush11) _D_IS=1011 ;;
  drush|drush8) _D_IS=8 ;;
esac

# "-c " is stripped from the drush arguments (2023, drush over SSH). It used
# to be stripped from the WHOLE line, which also ate the -c of a grep behind
# a pipe (drush8 status | grep -c x printed the lines, not a count); only the
# drush segment, up to the first pipe, is touched now, and never for a
# tenant: their -c is a refused option (see _drush_refused), and the
# strip would turn it into a not-found command before the refusal could
# name it.
if [[ "${_ARR}" =~ "-c " ]] && ! _is_tenant; then
  _ARR_HEAD="${_ARR%%|*}"
  _ARR_TAIL="${_ARR#"${_ARR_HEAD}"}"
  _ARR="${_ARR_HEAD//-c /}${_ARR_TAIL}"
fi


if [[ "${HOME}" =~ (^)"/data/disk/" ]] \
  && [ -z "${PHP_FWD}" ] \
  && [[ "${_ARGS}" =~ (^)"php ${HOME}" ]]; then
  _OCTO_SYS="${USER}"
  _OCTO_SYS_ARR=
  # the account's own launcher: the parser above already holds its arguments
  if [ -n "${_LA_PATH}" ] && [[ "${_LA_PATH}" == /data/disk/*/tools/drush/drush.php ]]; then
    _OCTO_SYS_ARR=("${_LA_REST}")
  fi
else
  _OCTO_SYS=
fi

if [[ "${HOME}" =~ (^)"/yyydata/disk/" ]]; then
  _DRUSH_CLI_CTRL=
  ### echo _DRUSH_CLI_CTRL has been disabled
fi

if [ -d "/home/${USER}/.tmp" ]; then
  export TMP="/home/${USER}/.tmp"
  export TMPDIR="/home/${USER}/.tmp"
  export TEMP="/home/${USER}/.tmp"
  if [[ "${_ARGS}" =~ " id " ]] \
    || [[ "${_ARGS}" =~ (^)"id " ]]; then
    exit 1
  elif [[ "${_ARGS}" =~ (^)"newrelic" ]] \
    || [[ "${_ARGS}" =~ (^)"nrsysm" ]]; then
    exit 1
  fi
elif [ -d "/data/disk/${_Y_USR}/.tmp" ]; then
  export TMP="/data/disk/${_Y_USR}/.tmp"
  export TMPDIR="/data/disk/${_Y_USR}/.tmp"
  export TEMP="/data/disk/${_Y_USR}/.tmp"
elif [ -d "/var/${_Y_USR}/.tmp" ]; then
  export TMP="/var/${_Y_USR}/.tmp"
  export TMPDIR="/var/${_Y_USR}/.tmp"
  export TEMP="/var/${_Y_USR}/.tmp"
else
  export TMP="/tmp"
  export TMPDIR="/tmp"
  export TEMP="/tmp"
fi

export HOME=${HOME}
export TEMP=${TEMP}
export USER=${USER}

