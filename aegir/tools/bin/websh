  export TMPDIR="/var/${_Y_USR}/.tmp"
  export TEMP="/var/${_Y_USR}/.tmp"
else
  export TMP="/tmp"
  export TMPDIR="/tmp"
  export TEMP="/tmp"
fi

export HOME=${HOME}
export TEMP=${TEMP}
export USER=${USER}

