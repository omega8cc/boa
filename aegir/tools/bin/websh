#!/bin/bash

export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec:/usr/local/ssl3

_DEST_DRUSH="/opt/tools/drush/8/drush/drush.php"

# Exact group membership, order-independent. id -nG prints the PRIMARY group
# first, so the whole-string and end-anchored comparisons this file used to
# make ("users www-data", "lshellg"$) silently stop matching the moment an
# account's primary group moves (per-instance groups) or a group is appended
# to a tenant identity -- and a tenant that falls out of the gate below gets
# an UNFILTERED dash instead of the dispatch and path policy. Test membership
# of one named group, never the shape of the list.
_in_grp() {
  local _g
  for _g in ${_LTD_GID}; do
    [ "${_g}" = "${1}" ] && return 0
  done
  return 1
}

# Exact group SET, order-independent: the historical whole-string forms
# ("www-data users", "users www-data", "aegir www-data users") matched an
# identity by its complete list, so keep that meaning -- same members, any
# order -- rather than widening it to "has both". Pure bash on purpose: the
# system binaries are root:users 0750 here, so an identity outside 'users'
# (the FPM pool user) cannot run sort/tr, and this runs for every identity.
# $1 = the expected set, space-separated.
_grp_set_is() {
  local _g _e
  for _g in ${_LTD_GID}; do
    case " ${1} " in
      *" ${_g} "*) ;;
      *) return 1 ;;
    esac
  done
  for _e in ${1}; do
    _in_grp "${_e}" || return 1
  done
  return 0
}

_forward_to_dash() {
  if [[ "${_ARGS}" =~ "sudo_noexec.so" ]] && _in_grp ltd-shell-more; then
    ### echo FWD 0 DIRECT
    _R_M=`echo -n ${_ARGS} | sed 's|LD_PRELOAD.*.so||'`
    ### echo _R_M is ${_R_M}
    exec /bin/dash -c "${_R_M}"
    exit 0
  fi
  # Path to the underlying shell (dash in this case)
  _shell="/bin/dash"
  # Name under which the shell should think it was invoked
  _shell_name="sh"
  # Arrays to hold options and positional parameters
  _options=()
  _positional=()
  # Variables to hold command strings or script files
  _command=""
  _script=""

  # Parse the options and arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        # End of options
        shift
        _positional+=("$@")
        break
        ;;
      -c)
        # Command option
        if [[ -n "$2" ]]; then
          _options+=("-c" "$2")
          shift 2
          _positional+=("$@")
          break
        else
          echo "sh: option requires an argument -- 'c'" >&2
          exit 1
        fi
        ;;
      -i|-l|-s)
        # Other common options
        _options+=("$1")
        shift
        ;;
      -*)
        # Unrecognized options
        _options+=("$1")
        shift
        ;;
      *)
        # First non-option argument is the script file
        _script="$1"
        shift
        _positional+=("$@")
        break
        ;;
    esac
  done

  # Prepare to execute the underlying shell
  if [[ -n "${_script}" ]]; then
    # Execute a script file
    ### echo FWD 1 PARSED
    exec -a "${_shell_name}" "${_shell}" "${_options[@]}" "${_script}" "${_positional[@]}"
    exit 0
  else
    # Execute commands or start an interactive shell
    ### echo FWD 2 PARSED
    exec -a "${_shell_name}" "${_shell}" "${_options[@]}" "${_positional[@]}"
    exit 0
  fi
}

# POSIX allows -- to end the option list, and glibc has sent it since 2.38
# (BZ#28519, "system and popen should pass -- between /bin/sh and argument"):
# every libc system()/popen() caller now spawns  sh -c -- <command>  where
# older glibc sent  sh -c <command>. Measured: Excalibur (glibc 2.41) sends the
# separator for PHP exec(), PHP shell_exec() and python os.system() alike,
# Daedalus (glibc 2.36) sends none. Without this the separator itself landed in
# $2 and became the command, no allowlist could match it, and the run was denied
# with no output -- silently breaking every shell-out a site or drush makes on
# any trixie-based box. Drop the separator here, before anything reads the
# positional parameters, so the whole script sees the argv shape it always saw.
if [ "${1}" = "-c" ] && [ "${2}" = "--" ]; then
  shift 2
  set -- "-c" "$@"
fi

# Capture all arguments
_ALL="$@"
### echo "_ALL is ${_ALL}"

# Capture environment variables
_ENV=$(env 2>&1)
### echo "_ENV is ${_ENV}"

# Determine _ARGS based on the first argument
if [ "${1}" = "-c" ]; then
  _ARGS="${2}"
else
  _ARGS="${1}"
fi

### echo "_ARGS is ${_ARGS}"

# Composer >= 2.8.3 (and any symfony/process caller) invokes git/hg/svn/tar/... as
# argv-arrays, which symfony/process 5.x renders for /bin/sh (= websh) as
#   exec 'git' 'remote' '-v'
# or, on --enable-sigchild PHP builds, as
#   { (exec 'git' ...) <&3 3<&- 3>/dev/null & } 3<&0;...
# and Composer's OWN ProcessExecutor (plugin executeCommand, e.g. composer-patches
# applying a patch) renders the same argv as a quoted-verb string with NO exec prefix:
#   'git' -C '/path' apply --check --verbose -p2 '/path/to.patch'
# None of these forms match websh's bare-token or path checks below, so these legit
# subprocesses of an already-authorized parent were refused (exit 1) -- surfacing in
# Composer as "git was not found ... in your PATH env", and in composer-patches as
# "No available patcher was able to apply patch" with git never executed at all
# (found 2026-08-11 when every varbase core patch failed on a BOA box while applying
# cleanly by hand; the silent-refusal shape cost a day of patcher forensics).
# Read the normalised leading token, then exec the ORIGINAL string verbatim so its
# quoting and the sigchild fd-3 exit-code protocol both survive. An lshell user cannot
# forge this shape: exec/sh are not in allowed_shell_escape and the wrapper carries
# forbidden chars (; $! & { >&3).
#
# Pass through ONLY: (a) an absolute argv[0] - the caller already resolved the binary,
# incl. the /opt/phpNN/bin/php composer hands its own subprocesses, exactly as websh
# forwards absolute-path commands below without re-selecting PHP; and (b) bare VCS/archive
# helpers, which never need PHP-CLI selection. php/composer/drush by BARE name are NOT
# passed through: a user's top-level `composer`/`drush` is a bare string dispatched with
# PHP-version selection below, and composer's own php subprocess is an absolute-path
# string caught by (a) - so the PHP-CLI selection is never bypassed here.
# Only the bare-verb case list below is allowlist-equivalent. The absolute-path branch --
# shared by all three alternatives, not specific to the leading-quote one -- execs verbatim
# ahead of the group gate, the $0 check and the _IN_PATH path policy, so an absolute path
# that the policy would refuse must never reach it. Leads under the tenant-writable /tmp/
# and /home/ are therefore kept out of this fast lane and fall through to the normal path:
# the shell accounts already allowed those paths there still run them, everyone else gets
# the same refusal as for the bare spelling. /data/ deliberately keeps the fast lane --
# legit callers do resolve absolute binaries inside the platform tree -- so tightening it
# is a separate change, to be proven against a real composer/composer-patches run first.
if [ "${1}" = "-c" ] \
  && { [[ "${2}" == "exec "* ]] || [[ "${2}" == "{ (exec "* ]] || [[ "${2}" == "'"* ]]; }; then
  _SF_ORIG="${2}"
  _SF_CMD="${2#\{ (}"
  _SF_CMD="${_SF_CMD#exec }"
  _SF_CMD="${_SF_CMD//\'/}"
  _SF_LEAD="${_SF_CMD%% *}"
  _SF_SKIP=NO
  case "${_SF_LEAD}" in
    /tmp/*|/home/*)
      _SF_SKIP=YES
      ;;
  esac
  if [[ "${_SF_LEAD}" == /* ]] && [ "${_SF_SKIP}" = "NO" ]; then
    exec /bin/dash -c "${_SF_ORIG}"
    exit 0
  fi
  case "${_SF_LEAD}" in
    git|git-upload-pack|git-receive-pack|git-upload-archive|hg|svn|svnadmin|fossil|bzr|cvs|p4|tar|unzip|7z|7za|7zz|gzip|gunzip|bzip2|xz|unxz|zstd|unzstd)
      exec /bin/dash -c "${_SF_ORIG}"
      exit 0
      ;;
  esac
fi

if [[ "${_ARGS}" =~ "--php=" ]]; then
  PHP_FWD=YES
else
  PHP_FWD=
fi

if [[ "${_ARGS}" =~ "true COLUMNS=" ]]; then
  _R_M=`echo -n "${_ARGS}" | grep -o "true COLUMNS=[0-9]\+ "`
  ### Strip only the well-formed "true COLUMNS=NNN " prefix. On no match
  ### (malformed COLUMNS: empty value or non-space separator) leave _ARGS
  ### UNCHANGED - blanking it made the command miss every drush/composer/php
  ### branch below and fall through to a bare _forward_to_dash that bypasses
  ### per-account PHP-CLI selection. Empty match must not reach sed either:
  ### s///g errors to stderr on every non-drush /bin/sh -c (task-log noise).
  if [ -n "${_R_M}" ]; then
    _ARGS=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
  fi
fi

if [[ "${_ARGS}" =~ "'" ]] && [[ "${_ARGS}" =~ "drush" ]]; then
  ### echo _ARGS RAW is ${_ARGS}
  _ARGS=$(echo -n ${_ARGS} | tr -d "'" 2>&1)
  ### echo _ARGS CLEAN is ${_ARGS}
fi

if [[ ! "${_ARGS}" =~ "composer" ]] \
  && [[ ! "${_ARGS}" =~ "git" ]] \
  && [[ ! "${_ARGS}" =~ "cd " ]] \
  && [[ ! "${_ARGS}" =~ "mysql" ]] \
  && [[ ! "${_ARGS}" =~ "sudo" ]]; then
  _ARR=
  if [[ "${_ARGS}" =~ "/vendor/drush/drush/drush.php " ]]; then
    _R_M=`echo -n ${_ARGS}  | grep -o ".*/vendor/drush/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS}  | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
      esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php " ]]; then
    _R_M=`echo -n ${_ARGS}  | grep -o "vendor/drush/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS}  | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
      esac
    done
    ### echo _ARR is ${_ARR}
  ### Absolute launchers come BEFORE the bare-verb branches below. Those
  ### match "drush " anywhere in the line and then strip EVERY "drush" with
  ### sed, so a launcher path was mangled whenever an argument also carried
  ### the bare word: provision's own `cache-clear drush` (run from every
  ### hostmaster site verify) became "php /var/aegir//.php ... cache-clear"
  ### and was re-dispatched as "php <drush.php> php ...", which drush parses
  ### as the `php` alias of core-cli -- fatal on PHP 8 (DRUPAL_ROOT undefined).
  ### Account launchers survived only through the _OCTO_SYS_ARR path further
  ### down; the master's /var/aegir/drush/drush.php and the global
  ### /opt/tools/drush/N launcher had no such path and failed every master
  ### site verify once /bin/sh became this wrapper.
  elif [[ "${_ARGS}" =~ "php /opt/tools/" ]]; then
    _R_M=`echo -n ${_ARGS} | grep -o "php /opt/tools/drush/.*/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
	  esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "php /data/disk/" ]]; then
    _R_M=`echo -n ${_ARGS} | grep -o "php /data/disk/.*/tools/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
	  esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ php\ /mnt/.*/data/disk/ ]]; then
    _R_M=`echo -n ${_ARGS} | grep -o "php /mnt/.*/data/disk/.*/tools/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
	  esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "php /var/aegir/drush/drush.php " ]]; then
    _R_M=`echo -n ${_ARGS} | grep -o "php /var/aegir/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
	  esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "drush " ]]; then
    if [[ "${_ARGS}" =~ "set -m" ]]; then
      _R_M=`echo -n ${_ARGS}  | grep -o "set -m\; drush" | head -1`
    else
      # the token once: a drush command line names drush several times
      # (the launcher path, the alias, an argument), grep -o printed each,
      # and the multi-line token broke the sed below on every such call
      _R_M=`echo -n ${_ARGS}  | grep -o "drush" | head -1`
    fi
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS}  | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
      esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "drush8 " ]]; then
    if [[ "${_ARGS}" =~ "set -m" ]]; then
      _R_M=`echo -n ${_ARGS}  | grep -o "set -m\; drush8" | head -1`
    else
      _R_M=`echo -n ${_ARGS}  | grep -o "drush8" | head -1`
    fi
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS}  | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
      esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "drush10 " ]]; then
    if [[ "${_ARGS}" =~ "set -m" ]]; then
      _R_M=`echo -n ${_ARGS}  | grep -o "set -m\; drush10" | head -1`
    else
      _R_M=`echo -n ${_ARGS}  | grep -o "drush10" | head -1`
    fi
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS}  | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
      esac
    done
    ### echo _ARR is ${_ARR}
  elif [[ "${_ARGS}" =~ "drush11 " ]]; then
    if [[ "${_ARGS}" =~ "set -m" ]]; then
      _R_M=`echo -n ${_ARGS}  | grep -o "set -m\; drush11" | head -1`
    else
      _R_M=`echo -n ${_ARGS}  | grep -o "drush11" | head -1`
    fi
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS}  | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _ARR+=("$arg") ;;
      esac
    done
    ### echo _ARR is ${_ARR}
  fi
fi

_C_ARR=
if [[ "${_ARGS}" =~ "composer " ]] && [[ ! "${_ARGS}" =~ "git remote add composer" ]]; then
  if [[ "${_ARGS}" =~ "set -m" ]]; then
    _C_RM=`echo -n ${_ARGS}  | grep -o "set -m\; composer "`
  else
    _C_RM=`echo -n ${_ARGS}  | grep -o "composer "`
  fi
  ### echo _C_RM is ${_C_RM}
  if [ -n "${_C_RM}" ]; then
    _CLR=`echo ${_ARGS}  | sed "s/\${_C_RM}//g"`
  else
    _CLR=
  fi
  _C_ARR=() # the buffer array for filtered parameters
  for arg in "${_CLR}"; do
    case ${_C_RM} in
      $arg\ * | *\ $arg | *\ $arg\ *) ;;
      *) _C_ARR+=("$arg") ;;
    esac
  done
  ### echo _C_ARR is ${_C_ARR}
fi

_INTERNAL=NO
_LTD_GID=$(id -nG ${USER} 2>&1)
_LTD_UID=$(id -nu ${USER} 2>&1)
if [ -z "${USER}" ]; then
  USER=$(id -nu ${USER} 2>&1)
  _LTD_QQQ=YES
fi
_X_USR=".*"
if [ "${USER}" = "aegir" ] \
  || [ "${HOME}" = "/var/aegir" ]; then
  _Y_USR=aegir
  _DRUSH_CLI_CTRL="/var/aegir/static/control"
  ### echo _DRUSH_CLI_CTRL is ${_DRUSH_CLI_CTRL}
else
  _Y_USR=${USER%${_X_USR}}
  _DRUSH_CLI_CTRL="/data/disk/${_Y_USR}/static/control"
  ### echo _DRUSH_CLI_CTRL is ${_DRUSH_CLI_CTRL}
fi
if [ -z "${HOME}" ]; then
  if [ -d "/home/${USER}/.tmp" ]; then
    HOME="/home/${USER}"
  elif [ -d "/data/disk/${_Y_USR}/.tmp" ]; then
    HOME="/data/disk/${_Y_USR}"
  elif [ -d "/var/${_Y_USR}/.tmp" ]; then
    HOME="/var/${_Y_USR}"
  fi
fi

if [[ "${_ARR}" =~ " aliases" ]] || [[ "${_ARR}" =~ " sa" ]]; then
  if [[ "${_ALL}" =~ "drush10 " ]] || [[ "${_ALL}" =~ "drush11 " ]]; then
    _ARR="sa --format=list | egrep -v \"(none|hostmaster|hm|server_|platform_|@none|@self)\""
  elif [[ "${_ALL}" =~ "drush " ]] || [[ "${_ALL}" =~ "drush8 " ]]; then
    _ARR="sa | egrep -v \"(none|hostmaster|hm|server_|platform_|@none|@self)\""
  fi
fi

if [[ "${_ARR}" =~ "-c " ]]; then
  _R_M=`echo -n "${_ARR}" | grep -o "\-c "`
  _ARR=`echo ${_ARR} | sed "s/\${_R_M}//g"`
fi

if [[ "${HOME}" =~ (^)"/data/disk/" ]] \
  && [ -z "${PHP_FWD}" ] \
  && [[ "${_ARGS}" =~ (^)"php ${HOME}" ]]; then
  _OCTO_SYS="${USER}"
  _OCTO_SYS_ARR=
  if [[ "${_ARGS}" =~ "tools/drush/drush.php" ]]; then
    _R_M=`echo -n ${_ARGS} | grep -o "php /data/disk/.*/tools/drush/drush.php"`
    ### echo _R_M is ${_R_M}
    _R_M=${_R_M//\//\\\/}
    ### echo _R_M is ${_R_M}
    if [ -n "${_R_M}" ]; then
      _CLR=`echo ${_ARGS} | sed "s/\${_R_M}//g"`
    else
      _CLR=
    fi
    _OCTO_SYS_ARR=() # the buffer array for filtered parameters
    for arg in "${_CLR}"; do
      case ${_R_M} in
        $arg\ * | *\ $arg | *\ $arg\ *) ;;
        *) _OCTO_SYS_ARR+=("$arg") ;;
	  esac
    done
    ### echo _OCTO_SYS_ARR is ${_OCTO_SYS_ARR}
  fi
else
  _OCTO_SYS=
fi

if [[ "${HOME}" =~ (^)"/yyydata/disk/" ]]; then
  _DRUSH_CLI_CTRL=
  ### echo _DRUSH_CLI_CTRL has been disabled
fi

if [ -d "/home/${USER}/.tmp" ]; then
  export TMP="/home/${USER}/.tmp"
  export TMPDIR="/home/${USER}/.tmp"
  export TEMP="/home/${USER}/.tmp"
  if [[ "${_ARGS}" =~ " id " ]] \
    || [[ "${_ARGS}" =~ (^)"id " ]]; then
    exit 1
  elif [[ "${_ARGS}" =~ (^)"newrelic" ]] \
    || [[ "${_ARGS}" =~ (^)"nrsysm" ]]; then
    exit 1
  fi
elif [ -d "/data/disk/${_Y_USR}/.tmp" ]; then
  export TMP="/data/disk/${_Y_USR}/.tmp"
  export TMPDIR="/data/disk/${_Y_USR}/.tmp"
  export TEMP="/data/disk/${_Y_USR}/.tmp"
elif [ -d "/var/${_Y_USR}/.tmp" ]; then
