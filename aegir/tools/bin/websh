  && [ -z "${PHP_FWD}" ] \
  && [[ "${_ARGS}" =~ (^)"php ${HOME}" ]]; then
  _OCTO_SYS="${USER}"
  _OCTO_SYS_ARR=
  # the account's own launcher: the parser above already holds its arguments
