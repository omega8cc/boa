# Check PHP CLI version defined.
#
# Selection for an account identity, in this order:
#   1. cli.info in ~/static/control -- read here directly, the same way the
#      phpNN.info instant switches are, so it applies to the next command;
#   2. the phpNN.info instant switches, layered on top below;
#   3. /usr/bin/php when neither names an installed version.
# The drush.php shebang pin in ~/tools/drush is no longer read for an
# account. It is a copy the ltd worker derives from cli.info minutes later,
# and reading it ran as the calling identity inside a tree a tenant shell is
# not guaranteed to be able to open (the lshell Landlock domain covers
# static, distro, clients and backups, not tools): a refused read looked
# like "no pin", so drush and composer fell to the box default while the
# markers, tested by stat in static/control, kept working. static/control is
# the tenant's own tree in the main login's shell, so the value comes from
# there, with the same two-digit + installed-binary validation the markers
# get; anything else in the file, or no file, means the box default until the
# worker rewrites it. The master keeps its own read of /var/aegir/drush/drush.php:
# it has no cli.info, and that shebang is where its pin lives.
# A platform developer login's lshell sandbox holds its client's trees only:
# its open() of a file in static/control is refused, while the name still
# tests present (the markers work there as anywhere). For that login the ltd
# worker keeps a copy of each control file read here -- cli.info,
# cli-per-platform.info cut to the login's own platforms, fpm.info and
# multi-fpm.info cut to its client's sites -- refreshed every three minutes,
# in a root directory the login can read its own file in and list nothing.
# _ctrl_file reads that copy only when the account's own file exists and
# cannot be opened, so every other identity reads exactly what it did.
_ctrl_file() {
  # $1 = the control directory, $2 = a file name; sets _CTRL_F to the path
  # to read, empty when there is none
  local _cp="/var/backups/ltd/.cli/${2}/${_LTD_UID}"
  _CTRL_F=""
  [ -f "${1}/${2}" ] || return 0
  if { : < "${1}/${2}"; } 2> /dev/null; then
    _CTRL_F="${1}/${2}"
  elif [[ "${_LTD_UID}" =~ ^[a-z0-9._-]+$ ]] && [ -f "${_cp}" ] \
    && { : < "${_cp}"; } 2> /dev/null; then
    _CTRL_F="${_cp}"
  fi
}
# The account's own php.ini: ~/.drush/php.ini, written by the ltd worker from
# the pinned version's template (open_basedir for the account's own trees, the
# temp, upload and session paths under ~/.tmp) and applied by the drush
# launcher as a php OPTION (--php-ini). websh launches Drush 8 and composer
# itself, so it hands the file to those two the same way, as -c on the
# interpreter line (_ACCT_INI), when it exists and was built for the PHP just
# selected: its extension_dir names the version, and a marker can select
# another version than the pin, where a foreign extension_dir would leave
# that binary without its extensions. Never through the environment: an
# exported PHPRC is inherited by every descendant, and a modern Drush
# (vendor/drush/drush/drush.php, drush10/11) refuses to run with open_basedir
# set -- a site-local Drush 13 child of the hosting queue did, measured. So
# PHP_INI and PHPRC stay on the global ini, and the option goes only where
# _DEST_DRUSH is the Drush 8 launcher, or composer (PHP_INI, which Drush 8's
# startup passes to the php it re-launches, names the file too; php itself
# never reads that variable). The ~/.drush/phpNN/php.ini
# this used to test was an older layout no writer has kept, so every websh
# launch ran on the global ini, whose sys_temp_dir is /tmp -- which is how a
# 0700 /tmp took composer away from every tenant while their own ~/.tmp
# stood ready. Pure bash: this runs for every identity, and applies the file
# for tenants and sub-accounts only (_is_tenant). The instance user and the
# master are the backend: the instance user runs the hosting queue every
# minute (hosting-tasks, hosting-cron, hosting-civicrm_cron) against its
# hostmaster, and under the account ini's open_basedir php turns its
# realpath cache off and checks every file operation against every basedir
# entry uncached -- a hostmaster bootstrap that takes three seconds on the
# global ini took a hundred, 3.5 million stats, and the per-minute runners
# piled up on every box of the fleet (measured 2026-09-09). Those two keep
# the global ini they always ran on.
_ACCT_INI=""
_account_ini() {
  local _ini="${HOME}/.drush/php.ini" _c _v=""
  PHP_INI="/opt/php${1}/lib/php.ini"
  PHPRC="/opt/php${1}/lib"
  _ACCT_INI=""
  _is_tenant || return 0
  [ -f "${_ini}" ] || return 0
  { _c=$(< "${_ini}"); } 2> /dev/null
  if [[ "${_c}" =~ (^|$'\n')extension_dir[[:space:]]*=[[:space:]]*\"?/opt/php([0-9][0-9])/ ]]; then
    _v="${BASH_REMATCH[2]}"
  fi
  if [ "${_v}" = "${1}" ]; then
    _ACCT_INI="${_ini}"
    # Drush 8's startup re-launches php with -c $PHP_INI, so the option on
    # the outer interpreter alone is replaced by whatever this names; only
    # Drush 8's own startup and launcher read it -- php itself reads PHPRC
    # (left on the global ini), a modern drush reads neither
    PHP_INI="${_ini}"
  fi
}
# the -c option for the Drush 8 launcher and composer, empty otherwise
_ini_opt() {
  _INI_OPT=""
  [ -n "${_ACCT_INI}" ] || return 0
  if [ "${1}" = "composer" ] || [ "${_DEST_DRUSH}" = "/opt/tools/drush/8/drush/drush.php" ]; then
    _INI_OPT="-c ${_ACCT_INI} "
  fi
}

# Command-line PHP per platform. ~/static/control/cli-per-platform.info lists
# platform folders, one "<folder> <version>" per line (d7-legacy 7.4): a
# drush, vdrush, bee or composer line that runs on a listed folder -- the
# tenant's own, and every Aegir task on the platform or one of its sites --
# runs on that version, ahead of the phpNN.info switch and cli.info, which
# keep deciding everything else. So an account that mixes old and new cores
# pins each old platform once, and flipping the account-wide switch for the
# new one no longer reaches them. The line's codebase is read the way Drush
# finds it: --root, else the @alias's root, else the working directory
# (composer: -d/--working-dir, else a leading cd DIR, else the working
# directory); a Clone or Migrate target is its own spawn on the target
# alias, so it follows the target platform's line. A folder is written
# relative to ~/static or as the platform's publish path (/data/disk/oN/
# static/..., a /data/all/... root); a trailing web, docroot or html is
# dropped, so the key names the codebase composer works in and covers the
# docroot below it. The longest matching key wins, the last of equal keys.
# Read live on every command and never written by BOA. A line that cannot
# apply -- not a folder, a site name, a version not installed -- is ignored
# and named in every tenant command and task log: a bad value in a tenant
# file never stops a task, the account-wide files decide instead, and the
# core guard below still stops a pair that would fatal. The account's
# hostmaster lives outside ~/static and /data/all, so no line reaches it.
_CPP_FILE=""; _CPP_V=""; _CPP_LN=""; _CPP_KEY=""; _CPP_WARN=""; _CPP_NK=""; _CPP_WHY=""
_CPP_ROOT=""; _CPP_CTX=""; _CPP_NAME=""; _CPP_CMD=""; _CPP_ACCT=""; _CPP_FROM=""; _CPP_DONE=NO
_CPP_PROBE=NO
# the launcher a drush line runs: "vendor" for a codebase's own
# vendor/drush/drush/drush.php (vdrush), empty for BOA's Drush 8 and 10/11
_CPP_FLAV=""
_CPP_PP=()
# what chose the account-wide PHP (check_php_cli_version), for the messages
_CLI_FROM=""; _CLI_WHY=""
_cpp_unq() {
  # $1 = an option value as the backend spells it; sets _CPP_UQ
  _CPP_UQ="${1#\'}"; _CPP_UQ="${_CPP_UQ%\'}"
  _CPP_UQ="${_CPP_UQ#\"}"; _CPP_UQ="${_CPP_UQ%\"}"
}
_cpp_phys() {
  # $@ = absolute paths; sets _CPP_PP to each one as Drush's realpath() sees
  # it -- links followed, .. folded -- in ONE subshell, then mapped back onto
  # /data/disk/<account>/static when it lies in that tree (a tenant reaches
  # it through ~/static, a box may mount it elsewhere), which is how the
  # aliases and the keys spell it. A path that does not exist (yet) keeps
  # its lexical form. The account's static tree is resolved the same way,
  # last, so both sides of a match always read alike.
  local _st="/data/disk/${_Y_USR}/static" _out _l _stp _i
  # the END sentinel keeps an unresolved (empty) last line: command
  # substitution strips every trailing newline
  _out=$(for _l in "$@" "${_st}"; do
    if cd -P -- "${_l}" 2> /dev/null; then printf '%s\n' "${PWD}"; else printf '\n'; fi
  done; printf 'END')
  mapfile -t _CPP_PP <<< "${_out}"
  _stp="${_CPP_PP[$#]}"
  for (( _i = 0; _i < $#; _i++ )); do
    _l="${_CPP_PP[${_i}]}"
    if [ -z "${_l}" ]; then
      # shellcheck disable=SC2124 # a slice of one element
      _l="${@:$(( _i + 1 )):1}"
    elif [ -n "${_stp}" ] && [ "${_stp}" != "${_st}" ]; then
      case "${_l}/" in
        "${_stp}/"*) _l="${_st}${_l#"${_stp}"}" ;;
      esac
    fi
    _CPP_PP[${_i}]="${_l%/}"
  done
}
_cpp_target() {
  # $1 = the argument string, $2 = drush, composer or bee, $3 = a leading
  # "cd DIR &&" of the line; sets _CPP_ROOT (the path the line runs on),
  # _CPP_CTX (site, platform or empty), _CPP_NAME (the @alias) and _CPP_CMD
  # (the command word)
  local _ws _w _next="" _root="" _rset=NO _uri="" _al="" _wd="" _cmd=NO _f _c _p="" _fromal=NO _cwd _optver=NO
  _CPP_ROOT=""; _CPP_CTX=""; _CPP_NAME=""; _CPP_CMD=""; _CPP_PROBE=NO
  read -r -a _ws <<< "$1"
  for _w in "${_ws[@]}"; do
    if [ -n "${_next}" ]; then
      _cpp_unq "${_w}"
      case "${_next}" in
        root) _root="${_CPP_UQ}" ;;
        uri) _uri="${_CPP_UQ}" ;;
        wd) _wd="${_CPP_UQ}" ;;
      esac
      _next=""
      continue
    fi
    case "${_w}" in
      --root=*) _cpp_unq "${_w#--root=}"; _root="${_CPP_UQ}"; _rset=YES ;;
      -r|--root) [ "$2" = "composer" ] || { _next=root; _rset=YES; } ;;
      --uri=*|-l=*) _cpp_unq "${_w#*=}"; _uri="${_CPP_UQ}" ;;
      -l|--uri) [ "$2" = "composer" ] || _next=uri ;;
      --working-dir=*) _cpp_unq "${_w#--working-dir=}"; _wd="${_CPP_UQ}" ;;
      -d|--working-dir) [ "$2" = "composer" ] && _next=wd ;;
      -d?*) [ "$2" = "composer" ] && { _cpp_unq "${_w#-d}"; _wd="${_CPP_UQ}"; } ;;
      # drush's other options that take the next word as their value
      -c|-i|-u|--user|--php|--php-options|--config|--include|--early|--alias-path|--define)
        [ "$2" = "composer" ] || _next=skip ;;
      # provision's Clone/Migrate target check: judged as the site task it
      # stands for, whatever harmless command carries it
      --boa-cli-php-probe) _CPP_PROBE=YES ;;
      --version) _optver=YES ;;
      -*) ;;
      # the @alias is the one in front of the command word; an @word after it
      # is an argument (provision-save '@site' names the context it saves)
      @*|\'@*)
        [ "$2" = "drush" ] && [ "${_cmd}" = "NO" ] && [ -z "${_al}" ] \
          && { _cpp_unq "${_w}"; _al="${_CPP_UQ#@}"; }
        ;;
      *)
        if [ "${_cmd}" = "NO" ]; then
          _cpp_unq "${_w}"
          _CPP_CMD="${_CPP_UQ}"
        fi
        _cmd=YES
        ;;
    esac
  done
  [ -z "${_CPP_CMD}" ] && [ "${_optver}" = "YES" ] && _CPP_CMD="--version"
  if [ "$2" = "composer" ] && [ -n "${_wd}" ]; then
    _root="${_wd}"; _rset=YES
  fi
  # an explicitly empty --root names no codebase (the backend's provision-save
  # line carries one); the working directory is not guessed for it
  [ "${_rset}" = "YES" ] && [ -z "${_root}" ] && return 0
  # the directory the line starts in: the working directory, moved by a
  # leading cd DIR
  _cwd="${PWD}"
  if [[ "$3" =~ ^[[:space:]]*cd[[:space:]]+([^[:space:];\&\|]+) ]]; then
    _cpp_unq "${BASH_REMATCH[1]}"
    _c="${_CPP_UQ/#\~/${HOME}}"
    if [[ "${_c}" == /* ]]; then _cwd="${_c}"; else _cwd="${PWD}/${_c}"; fi
  fi
  if [ -z "${_root}" ] && [ -n "${_al}" ]; then
    [[ "${_al}" =~ ^[A-Za-z0-9._-]+$ ]] || return 0
    case "${_al}" in
      none|hostmaster|hm|server_*) return 0 ;;
      self|sites) ;;
      *)
        _CPP_NAME="@${_al}"
        for _f in "${HOME}/.drush/${_al}.alias.drushrc.php" \
          "/data/disk/${_Y_USR}/.drush/${_al}.alias.drushrc.php"; do
          [ -f "${_f}" ] || continue
          { _c=$(< "${_f}"); } 2> /dev/null
          [[ "${_c}" =~ \'root\'[[:space:]]*=\>[[:space:]]*\'([^\']+)\' ]] || continue
          _root="${BASH_REMATCH[1]}"
          _fromal=YES
          if [[ "${_c}" =~ \'context_type\'[[:space:]]*=\>[[:space:]]*\'([a-z]+)\' ]]; then
            _CPP_CTX="${BASH_REMATCH[1]}"
          elif [[ "${_c}" =~ \'uri\'[[:space:]]*=\>[[:space:]]*\'[^\']+\' ]]; then
            _CPP_CTX=site
          fi
          break
        done
        # no Drush 8 alias of that name: the Drush 9+ alias BOA writes for
        # drush10/drush11 and vdrush (~/.drush/sites/<name>.site.yml, the
        # environment key being the part after the last dot) names the root
        if [ -z "${_root}" ] && [[ "${_al}" == *.* ]]; then
          _f="${HOME}/.drush/sites/${_al%.*}.site.yml"
          if [ -f "${_f}" ]; then
            { IFS= read -r -N 65536 _c < "${_f}"; } 2> /dev/null
            if [[ "${_c}" =~ (^|$'\n')${_al##*.}:$'\n'.*$'\n'"  root: "([^$'\n']+) ]]; then
              _root="${BASH_REMATCH[2]}"
              _fromal=YES
              _CPP_CTX=site
            fi
          fi
        fi
        if [ -z "${_root}" ]; then
          # vdrush runs the vendor/drush of the working directory, so that is
          # the codebase; BOA's own Drush with an alias it cannot find has no
          # codebase here (it reports the alias itself)
          [ "${_CPP_FLAV}" = "vendor" ] || return 0
          _CPP_CTX=site
        fi
        ;;
    esac
  fi
  if [ -n "${_root}" ]; then
    _root="${_root/#\~/${HOME}}"
    [[ "${_root}" == /* ]] || _root="${_cwd}/${_root}"
    if [ "${_fromal}" = "YES" ] && [ -z "${_CPP_FILE}" ]; then
      # a registered alias root is spelled the way BOA wrote it; only a
      # match against the file's keys needs it resolved
      _CPP_ROOT="${_root%/}"
    else
      _cpp_phys "${_root}" "${_cwd}"
      _CPP_ROOT="${_CPP_PP[0]}"
      # --root without --uri or an alias: Drush takes the site from the
      # working directory when that is one of the codebase's site folders
      if [ "${_rset}" = "YES" ] && [ -z "${_uri}" ] && [ -z "${_al}" ]; then
        case "${_CPP_PP[1]}/" in
          "${_CPP_ROOT}/sites/all/"*) ;;
          "${_CPP_ROOT}/sites/"?*/*) _CPP_CTX=site ;;
        esac
      fi
    fi
  else
    _cpp_phys "${_cwd}"
    _CPP_ROOT="${_CPP_PP[0]}"
    [ -n "${_CPP_ROOT}" ] || return 0
    case "${_CPP_ROOT}/" in
      */sites/all/*) ;;
      */sites/?*/*) _CPP_CTX=site ;;
    esac
  fi
  [ -n "${_uri}" ] && _CPP_CTX=site
  # the hostmaster's own tree never takes a line, nor the guard below
  case "${_CPP_ROOT}/" in
    "/data/disk/${_Y_USR}/aegir/"*|/var/aegir/*) _CPP_ROOT=""; _CPP_CTX="" ;;
  esac
}
_cpp_safe() {
  # $1 = text a tenant controls (a key as written, a folder name); sets
  # _CPP_S to it with anything outside a plain path alphabet replaced by ?,
  # so it can go into a task log, a JSON packet or a terminal as it is, and
  # at most 120 characters of it
  local LC_ALL=C
  _CPP_S="${1//[^A-Za-z0-9._\/~@+ -]/?}"
  [ "${#_CPP_S}" -le 120 ] || _CPP_S="${_CPP_S:0:117}..."
}
_cpp_norm() {
  # $1 = a folder as written in the file; sets _CPP_NK (its path) or
  # _CPP_WHY (why it cannot apply). Accepted: a folder under ~/static
  # (relative, ~/static/..., /home/<account>.ftp/static/... or the publish
  # path /data/disk/<account>/static/...), a platform BOA ships to the
  # account (~/distro/..., /home/<account>.ftp/distro/...,
  # /data/disk/<account>/distro/...) or a /data/all/... root
  local _k="$1" _st="/data/disk/${_Y_USR}/static" _di="/data/disk/${_Y_USR}/distro" _h="/home/${_Y_USR}.ftp"
  _CPP_NK=""; _CPP_WHY=""
  while [[ "${_k}" == */ ]]; do _k="${_k%/}"; done
  # shellcheck disable=SC2088 # keys as the tenant spells them, ~ literal
  case "${_k}" in
    "~/static/"*) _k="${_k#"~/static/"}" ;;
    "${_st}/"*) _k="${_k#"${_st}/"}" ;;
    "${_h}/static/"*) _k="${_k#"${_h}/static/"}" ;;
    static/*) _k="${_k#static/}" ;;
    "~/distro/"*) _k="${_di}/${_k#"~/distro/"}" ;;
    "${_h}/distro/"*) _k="${_di}/${_k#"${_h}/distro/"}" ;;
  esac
  case "${_k}" in
    */web|*/docroot|*/html) _k="${_k%/*}" ;;
  esac
  if [[ ! "${_k}" =~ ^[A-Za-z0-9._/-]+$ ]] || [[ "/${_k}/" == */../* ]] \
    || [[ "/${_k}/" == */./* ]] || [[ "${_k}" == *//* ]]; then
    _CPP_WHY="it is not a folder name"
    return 1
  fi
  case "${_k}" in
    /data/all/?*|"${_di}"/?*) _CPP_NK="${_k}" ;;
    /*) _CPP_WHY="it is outside ~/static, ~/distro and /data/all"; return 1 ;;
    *) _CPP_NK="${_st}/${_k}" ;;
  esac
  if [ ! -d "${_CPP_NK}" ]; then
    if [ -f "${HOME}/.drush/${_k}.alias.drushrc.php" ] \
      || [ -f "/data/disk/${_Y_USR}/.drush/${_k}.alias.drushrc.php" ]; then
      _CPP_WHY="${_k} is a site, not a folder; this file takes platform folders (the Aegir publish path)"
    else
      _CPP_WHY="there is no such folder"
    fi
    _CPP_NK=""
    return 1
  fi
}
_CPP_NW=0; _CPP_MORE=0
# how a message names the file (_cpp_resolve changes it for a developer login)
# shellcheck disable=SC2088 # message text, ~ literal
_CPP_WHERE="~/static/control/cli-per-platform.info"
_cpp_warn() {
  # $1 = a warning about the file; the first 20 are kept (each at most 400
  # characters), the rest counted
  if [ "${_CPP_NW}" -lt 20 ]; then
    _CPP_WARN+="${1:0:400}"$'\n'
    _CPP_NW=$(( _CPP_NW + 1 ))
  else
    _CPP_MORE=$(( _CPP_MORE + 1 ))
  fi
}
_cpp_match() {
  # $1 = the path a line runs on; sets _CPP_V, _CPP_LN and _CPP_KEY from the
  # longest matching key, and _CPP_WARN for every line that cannot apply.
  # The keys are resolved like the target (_cpp_phys), in one subshell. Only
  # the first 64 KiB and 200 lines are read, and at most 20 warnings of
  # bounded length are kept: the warnings travel in the environment of every
  # backend drush line, where a single string over 128 KiB would stop the
  # exec itself. 64 KiB in bytes whatever the locale: the ltd worker cuts the
  # copy it keeps for a developer login the same way.
  local LC_ALL=C
  local _txt="" _ln=0 _line _k _v _rest _best=0 _i
  local -a _ks=() _vs=() _ls=() _nks=()
  _CPP_V=""; _CPP_LN=""; _CPP_KEY=""; _CPP_WARN=""; _CPP_NW=0; _CPP_MORE=0; _CPP_TAIL=""
  { IFS= read -r -N 65536 _txt < "${_CPP_FILE}"; } 2> /dev/null
  while IFS= read -r _line; do
    _ln=$(( _ln + 1 ))
    if [ "${_ln}" -gt 200 ]; then
      _CPP_TAIL="cli-per-platform.info: the lines after line 200 are not read"
      break
    fi
    _line="${_line%%#*}"
    read -r _k _v _rest <<< "${_line}"
    [ -n "${_k}" ] || continue
    _cpp_safe "${_k}"
    if [ -z "${_v}" ] || [ -n "${_rest}" ]; then
      _cpp_warn "cli-per-platform.info line ${_ln} is ignored: write one \"<folder> <version>\" per line"
      continue
    fi
    _v="${_v//[!0-9]/}"
    case "${_v}" in
      56|70|71|72|73|74|80|81|82|83|84|85) ;;
      *)
        _cpp_warn "cli-per-platform.info line ${_ln} (${_CPP_S}) is ignored: its version is not one of 5.6 to 8.5"
        continue
        ;;
    esac
    if [ ! -x "/opt/php${_v}/bin/php" ]; then
      _cpp_warn "cli-per-platform.info line ${_ln} (${_CPP_S}) is ignored: PHP ${_v:0:1}.${_v:1:1} is not installed on this server"
      continue
    fi
    if ! _cpp_norm "${_k}"; then
      _cpp_safe "${_k}"
      _cpp_warn "cli-per-platform.info line ${_ln} (${_CPP_S}) is ignored: ${_CPP_WHY//[^A-Za-z0-9._\/~@+ ();,-]/?}"
      continue
    fi
    _ks+=("${_CPP_S}"); _vs+=("${_v}"); _ls+=("${_ln}"); _nks+=("${_CPP_NK}")
  done <<< "${_txt}"
  [ "${_CPP_MORE}" -gt 0 ] && _CPP_WARN+="cli-per-platform.info: ${_CPP_MORE} more warnings are not shown"$'\n'
  [ -n "${_CPP_TAIL}" ] && _CPP_WARN+="${_CPP_TAIL}"$'\n'
  [ -n "$1" ] && [ "${#_nks[@]}" -gt 0 ] || return 0
  _cpp_phys "${_nks[@]}"
  for (( _i = 0; _i < ${#_nks[@]}; _i++ )); do
    case "$1/" in
      "${_CPP_PP[${_i}]}/"*)
        if [ "${#_CPP_PP[${_i}]}" -ge "${_best}" ]; then
          _best="${#_CPP_PP[${_i}]}"
          _CPP_V="${_vs[${_i}]}"; _CPP_LN="${_ls[${_i}]}"; _CPP_KEY="${_ks[${_i}]}"
        fi
        ;;
    esac
  done
}
_cpp_resolve() {
  # $1 = the argument string, $2 = drush, composer or bee, $3 = a leading
  # cd; resolves the line's codebase and its line once per websh run
  [ "${_CPP_DONE}" = "YES" ] && return 0
  _CPP_DONE=YES
  _CPP_ACCT="${DRUSH_PHP}"
  [[ "${HOME}" == /data/disk/* ]] || [[ "${HOME}" == /home/* ]] || return 0
  [[ "${_DRUSH_CLI_CTRL}" == /data/disk/* ]] || return 0
  [ "${_IS_JENKINS}" = "FALSE" ] || return 0
  # a developer login has no ~/static of its own: the file is its main login's
  [ -d "${HOME}/static/control" ] \
    || _CPP_WHERE="the main login's ~/static/control/cli-per-platform.info"
  _ctrl_file "${_DRUSH_CLI_CTRL}" cli-per-platform.info
  _CPP_FILE="${_CTRL_F}"
  _cpp_target "$1" "$2" "$3"
  [ -n "${_CPP_FILE}" ] || return 0
  _cpp_match "${_CPP_ROOT}"
}
_cpp_pick() {
  # a matching line replaces the account-wide choice
  [ -n "${_CPP_V}" ] || return 0
  DRUSH_PHP="/opt/php${_CPP_V}/bin/php"
  _account_ini "${_CPP_V}"
  export DRUSH_PHP PHP_INI PHPRC
}
_cpp_rel() {
  # $1 = a path; sets _CPP_RP to it as the tenant knows it (static/...,
  # ~/distro/...), in the alphabet _cpp_safe keeps
  local _p="$1"
  # shellcheck disable=SC2088 # a name for messages, ~ literal
  case "${_p}" in
    "/data/disk/${_Y_USR}/static/"*) _p="static/${_p#"/data/disk/${_Y_USR}/static/"}" ;;
    "/data/disk/${_Y_USR}/distro/"*) _p="~/distro/${_p#"/data/disk/${_Y_USR}/distro/"}" ;;
  esac
  _cpp_safe "${_p}"
  _CPP_RP="${_CPP_S}"
}
_cpp_key() {
  # $1 = a path as _cpp_rel spells it; sets _CPP_KY to the key a line for
  # that folder is written with
  _CPP_KY="${1#static/}"
}
_cpp_json() {
  # $1 = text; sets _CPP_J to it escaped for a JSON string (every piece a
  # tenant controls already went through _cpp_safe; control bytes are
  # dropped here too, belt and braces)
  local LC_ALL=C
  _CPP_J="${1//[[:cntrl:]]/ }"
  _CPP_J="${_CPP_J//\\/\\\\}"
  _CPP_J="${_CPP_J//\"/\\\"}"
}
_cpp_say() {
  # $1 = a message the line cannot run with: a backend line reports it the
  # way a failing Drush child does, anything else on stderr; then exit before
  # any PHP starts. The lines of the file that were ignored go with it: the
  # process that would log them never starts, and they are often why the
  # account-wide PHP was chosen. A Drush child reports through incremental
  # packets -- set_error, which the parent turns into its own
  # drush_set_error, and log -- and a final output packet; once a parent has
  # read any incremental packet (the provision-save a task runs first sends
  # them) it never reads the final packet's log again, so a final packet
  # alone let the task end Successful with the verify skipped (measured).
  # All on stdout: Drush writes its packets to stderr and the line's own
  # 2>&1 merges them into the one pipe the parent reads, but that
  # redirection belongs to the command dash would run, never to websh
  # itself, whose stderr is the parent's. The final packet also serves
  # callers that read only its error_log (provision's Clone/Migrate target
  # check).
  local _m="$1" _ts _w _log _me
  # shellcheck disable=SC2128 # _ARR holds the whole line in one element
  if [[ " ${_ARR} " =~ [[:space:]]\'?--backend ]]; then
    printf -v _ts '%(%s)T' -1
    _cpp_json "${_m}"
    _me="${_CPP_J}"
    _log="{\"type\":\"error\",\"message\":\"${_me}\",\"error\":\"BOA_CLI_PHP_REFUSED\",\"timestamp\":${_ts},\"memory\":0}"
    while IFS= read -r _w; do
      [ -n "${_w}" ] || continue
      _cpp_json "${_w}"
      _log+=",{\"type\":\"warning\",\"message\":\"${_CPP_J}\",\"timestamp\":${_ts},\"memory\":0}"
      printf '\0DRUSH_BACKEND:{"type":"warning","message":"%s","timestamp":%s,"memory":0,"packet":"log"}\n\0' \
        "${_CPP_J}" "${_ts}"
    done <<< "${_CPP_WARN}"
    printf '\0DRUSH_BACKEND:{"error":"BOA_CLI_PHP_REFUSED","message":"%s","packet":"set_error"}\n\0' "${_me}"
    printf '\0DRUSH_BACKEND_OUTPUT_START>>>{"output":"","object":null,"error_status":1,"log":[%s],"error_log":{"BOA_CLI_PHP_REFUSED":["%s"]},"context":[]}<<<DRUSH_BACKEND_OUTPUT_END' \
      "${_log}" "${_me}"
  else
    echo >&2
    echo " ${_m}" >&2
    while IFS= read -r _w; do
      [ -n "${_w}" ] && echo " WARNING: ${_w}" >&2
    done <<< "${_CPP_WARN}"
    echo >&2
  fi
  exit 1
}
# The core guard, on every account: a line whose codebase cannot run on the
# PHP just chosen stops before PHP starts, naming the file that chose it and
# the fix, instead of dying on a PHP fatal half-way through a task. Only
# pairs that fatal anyway: Drupal 7 below 7.79 (the first release whose test
# suite passes on PHP 8.0) or any Drupal 8 on PHP 8.0+ -- refused for a site,
# only a warning for a platform line, which boots no site -- and a codebase
# whose vendor/composer/platform_check.php floor is above the chosen PHP, for
# any drush line (its autoloader stops at that check). composer itself is not
# guarded: it is the tool that repairs vendor. Neither applies to the
# commands that never load the codebase (a backup file deleted, a context
# saved, Drush 8's own version and alias listing; its help boots the site):
# they ran on any PHP before. A codebase's own Drush (vdrush) loads vendor/
# for every command, so the exemption is Drush 8's only.
_CPP_NOBOOT=" provision-backup-delete provision-save provision-leftover-import provision-leftover-purge version --version sa site-alias aliases "
_cpp_guard() {
  local _ch _p _dr="" _app="" _c="" _fl="" _fln="" _mj="" _mn="" _e _sug="" _fix _who
  [ "${_CPP_PROBE}" != "YES" ] && [ "${_CPP_FLAV}" != "vendor" ] && [ -n "${_CPP_CMD}" ] \
    && [[ "${_CPP_NOBOOT}" == *" ${_CPP_CMD} "* ]] && return 0
  case "${DRUSH_PHP}" in
    /opt/php[0-9][0-9]/bin/php) _ch="${DRUSH_PHP%/bin/php}"; _ch="${_ch##*/php}" ;;
    *) return 0 ;;
  esac
  [ -n "${_CPP_ROOT}" ] || return 0
  # the Drupal root at or above the path, then the vendor/ next to it, or
  # one level up when the root is a web/docroot/html docroot under a
  # composer root (never a vendor/ that merely sits in ~/static)
  _p="${_CPP_ROOT}"
  while [ -n "${_p}" ]; do
    if [ -f "${_p}/core/lib/Drupal.php" ] || [ -f "${_p}/includes/bootstrap.inc" ]; then
      _dr="${_p}"
      break
    fi
    case "${_p}" in
      "/data/disk/${_Y_USR}/static"|"/data/disk/${_Y_USR}/distro"|/data/all|/data/disk/*/static) break ;;
    esac
    _p="${_p%/*}"
  done
  # a composer root reached through a Drush 9+ alias or the working
  # directory: its docroot is below it
  if [ -z "${_dr}" ]; then
    for _p in web docroot html; do
      if [ -f "${_CPP_ROOT}/${_p}/core/lib/Drupal.php" ] || [ -f "${_CPP_ROOT}/${_p}/includes/bootstrap.inc" ]; then
        _dr="${_CPP_ROOT}/${_p}"
        break
      fi
    done
  fi
  if [ -n "${_dr}" ]; then
    if [ -f "${_dr}/vendor/composer/platform_check.php" ]; then
      _app="${_dr}"
    else
      case "${_dr##*/}" in
        web|docroot|html)
          [ -f "${_dr%/*}/vendor/composer/platform_check.php" ] && _app="${_dr%/*}" ;;
      esac
    fi
  elif [ -f "${_CPP_ROOT}/vendor/drush/drush/drush.php" ] \
    && [ -f "${_CPP_ROOT}/vendor/composer/platform_check.php" ]; then
    # no Drupal found, but a site-local Drush loads this vendor/; any other
    # codebase's vendor/ (Grav's) is never loaded by Drush
    _app="${_CPP_ROOT}"
  fi
  _who="${_CPP_NAME}"
  if [ -n "${_app}" ]; then
    { _c=$(< "${_app}/vendor/composer/platform_check.php"); } 2> /dev/null
    if [[ "${_c}" =~ PHP_VERSION_ID[[:space:]]*\>=[[:space:]]*([0-9]{5}) ]]; then
      _fl=$(( 10#${BASH_REMATCH[1]} / 100 ))
      _fln="${_fl:0:1}${_fl:2:1}"
      if [ "${_ch}" -lt "${_fln}" ]; then
        for _e in 70 71 72 73 74 80 81 82 83 84 85; do
          [ "${_e}" -ge "${_fln}" ] && [ -x "/opt/php${_e}/bin/php" ] && { _sug="${_e}"; break; }
        done
        _cpp_rel "${_app}"
        [ -n "${_who}" ] && _who="${_who} (${_CPP_RP})" || _who="${_CPP_RP}"
        if [ -n "${_CPP_V}" ]; then
          _fix="Fix: change line ${_CPP_LN} of ${_CPP_WHERE} to PHP ${_fln:0:1}.${_fln:1:1} or newer."
        elif [ -n "${_sug}" ]; then
          _cpp_key "${_CPP_RP}"
          _fix="Fix: add the line \"${_CPP_KY} ${_sug:0:1}.${_sug:1:1}\" to ${_CPP_WHERE}, or switch the account to PHP ${_fln:0:1}.${_fln:1:1} or newer."
        else
          _fix="No PHP ${_fln:0:1}.${_fln:1:1} or newer is installed on this server; ask your host."
        fi
        _cpp_say "Refused before PHP starts: ${_who} needs PHP ${_fln:0:1}.${_fln:1:1} or newer (vendor/composer/platform_check.php). This would use PHP ${_ch:0:1}.${_ch:1:1}, chosen by ${_CPP_FROM}. ${_fix}"
      fi
    fi
  fi
  [ "${_ch}" -ge 80 ] && [ -n "${_dr}" ] || return 0
  _c=""
  if [ -f "${_dr}/core/lib/Drupal.php" ]; then
    { IFS= read -r -N 16384 _c < "${_dr}/core/lib/Drupal.php"; } 2> /dev/null
    [[ "${_c}" =~ const[[:space:]]+VERSION[[:space:]]*=[[:space:]]*\'([0-9]+)\.([0-9]+) ]] || return 0
    _mj="${BASH_REMATCH[1]}"; _mn="${BASH_REMATCH[2]}"
    [ "${_mj}" = "8" ] || return 0
  else
    { IFS= read -r -N 16384 _c < "${_dr}/includes/bootstrap.inc"; } 2> /dev/null
    [[ "${_c}" =~ define\([[:space:]]*\'VERSION\'[[:space:]]*,[[:space:]]*\'7\.([0-9]+) ]] || return 0
    _mj=7; _mn="${BASH_REMATCH[1]}"
    [ "$(( 10#${_mn} ))" -lt 79 ] || return 0
  fi
  for _e in 74 73 72 71 70; do
    [ -x "/opt/php${_e}/bin/php" ] && { _sug="${_e}"; break; }
  done
  _cpp_rel "${_dr}"
  [ -n "${_who}" ] && _who="${_who} is Drupal ${_mj}.${_mn} (${_CPP_RP})" || _who="${_CPP_RP} is Drupal ${_mj}.${_mn}"
  if [ -n "${_CPP_V}" ]; then
    _fix="Fix: change line ${_CPP_LN} of ${_CPP_WHERE} to a PHP 7 version."
  elif [ -n "${_sug}" ]; then
    _cpp_key "${_CPP_RP}"
    _fix="Fix: add the line \"${_CPP_KY} ${_sug:0:1}.${_sug:1:1}\" to ${_CPP_WHERE}"
    [[ "${_CLI_FROM}" == php[0-9][0-9].info ]] && _fix+=" (or switch back to php${_sug}.info)"
    _fix+="."
  else
    _fix="No PHP 7 version is installed on this server; ask your host."
  fi
  if [ "${_CPP_CTX}" = "site" ]; then
    _cpp_say "Refused before Drupal starts: ${_who}, which cannot run on PHP 8.0 or newer. This would use PHP ${_ch:0:1}.${_ch:1:1}, chosen by ${_CPP_FROM}. ${_fix}"
  fi
  # shellcheck disable=SC2089 # message text for the task log, never run
  _CPP_WARN+="${_who}, which cannot run on PHP 8.0 or newer, and this runs on PHP ${_ch:0:1}.${_ch:1:1}, chosen by ${_CPP_FROM}; its sites' tasks will be refused. ${_fix}"$'\n'
}
# Every drush line, right before its exec: what chose the PHP, the guard,
# then the report. A tenant reads a NOTE when a line overrides the
# account-wide choice, and every warning, on stderr (never stdout, where a
# drush sql-dump > file would take it in). The backend gets the same as
# BOA_CLI_PHP_FROM / BOA_CLI_PHP_WARN in the process's environment, which
# provision writes into the task log. That is a report, not configuration:
# nothing reads it to choose anything, and every websh clears it on entry.
_cpp_before_exec() {
  local _w
  if [ "$1" = "drush" ] && [ "${_CPP_DONE}" != "YES" ]; then
    # shellcheck disable=SC2128 # _ARR holds the whole line in one element
    _cpp_resolve "${_ARR}" drush "${_LA_CD:-${_DL_CD}}"
    _cpp_pick
  fi
  if [ -n "${_CPP_V}" ] && [ "${DRUSH_PHP}" = "/opt/php${_CPP_V}/bin/php" ]; then
    _CPP_FROM="cli-per-platform.info line ${_CPP_LN}"
    [ "${_CPP_ACCT}" != "${DRUSH_PHP}" ] && [ -n "${_CLI_FROM}" ] && _CPP_FROM+=" (outranks ${_CLI_FROM})"
  elif [ -z "${_CPP_FROM}" ]; then
    _CPP_FROM="${_CLI_WHY:-the server default}"
  fi
  [ "$1" = "composer" ] || _cpp_guard
  if _is_tenant; then
    if [ -n "${_CPP_V}" ] && [ "${_CPP_ACCT}" != "${DRUSH_PHP}" ]; then
      _cpp_rel "${_CPP_ROOT}"
      echo "NOTE: command-line PHP ${_CPP_V:0:1}.${_CPP_V:1:1} for ${_CPP_RP} (${_CPP_FROM})" >&2
    fi
    while IFS= read -r _w; do
      [ -n "${_w}" ] && echo "WARNING: ${_w}" >&2
    done <<< "${_CPP_WARN}"
  elif [ "$1" = "drush" ]; then
    BOA_CLI_PHP_FROM="${_CPP_FROM}"
    BOA_CLI_PHP_WARN="${_CPP_WARN}"
    # shellcheck disable=SC2090 # message text for the task log, never run
    export BOA_CLI_PHP_FROM BOA_CLI_PHP_WARN
  fi
}
# A tenant's composer install, update or require resolves packages for the
# PHP it runs on, while the sites of that codebase are served by their
# PHP-FPM: a package that needs a newer PHP than a site's FPM makes
# vendor/composer/platform_check.php answer every request of that site with
# HTTP 500 "Composer detected issues in your platform" (measured). Warn with
# both versions. The only place websh reads fpm.info and multi-fpm.info, and
# never to choose. The tenant can read those two files only (the version the
# worker resolved and the site includes it writes are not theirs), so the
# warning names the version a site is SET to and the file that sets it, and
# a version not installed here -- which the worker would not serve -- is
# left out.
_cpp_composer_warn() {
  local _ws _w _cw="" _skip=NO _ch _c _f _nm _rt _fpm="" _mf="" _l _s _v _src _min="" _minsrc="" _site="" _i
  local -a _nms=() _rts=()
  _is_tenant || return 0
  [ -n "${_CPP_ROOT}" ] && [ -f "${_CPP_ROOT}/composer.json" ] || return 0
  case "${DRUSH_PHP}" in
    /opt/php[0-9][0-9]/bin/php) _ch="${DRUSH_PHP%/bin/php}"; _ch="${_ch##*/php}" ;;
    *) return 0 ;;
  esac
  # shellcheck disable=SC2128 # _C_ARR holds the whole line in one element
  read -r -a _ws <<< "${_C_ARR}"
  for _w in "${_ws[@]}"; do
    if [ "${_skip}" = "YES" ]; then
      _skip=NO
      continue
    fi
    case "${_w}" in
      -d|--working-dir) _skip=YES ;;
      -*) ;;
      *) _cw="${_w}"; break ;;
    esac
  done
  case "${_cw}" in
    install|i|update|u|upgrade|require|r) ;;
    *) return 0 ;;
  esac
  { _c=$(< "${_CPP_ROOT}/composer.json"); } 2> /dev/null
  [[ "${_c}" =~ \"platform\"[[:space:]]*:[[:space:]]*\{[^}]*\"php\" ]] && return 0
  _ctrl_file "${_DRUSH_CLI_CTRL}" fpm.info
  [ -n "${_CTRL_F}" ] && { _fpm=$(< "${_CTRL_F}"); } 2> /dev/null
  _fpm="${_fpm%%$'\n'*}"; _fpm="${_fpm//[!0-9]/}"
  _ctrl_file "${_DRUSH_CLI_CTRL}" multi-fpm.info
  [ -n "${_CTRL_F}" ] && { _mf=$(< "${_CTRL_F}"); } 2> /dev/null
  for _f in "${HOME}"/.drush/*.alias.drushrc.php; do
    [ -f "${_f}" ] || continue
    _nm="${_f##*/}"; _nm="${_nm%.alias.drushrc.php}"
    case "${_nm}" in platform_*|hostmaster|hm|server_*) continue ;; esac
    { _c=$(< "${_f}"); } 2> /dev/null
    [[ "${_c}" =~ \'root\'[[:space:]]*=\>[[:space:]]*\'([^\']+)\' ]] || continue
    _nms+=("${_nm}"); _rts+=("${BASH_REMATCH[1]}")
  done
  [ "${#_rts[@]}" -gt 0 ] || return 0
  # the alias roots read the way the target was (links, the tenant's
  # ~/static), so a platform registered through a link still matches
  _cpp_phys "${_rts[@]}"
  for (( _i = 0; _i < ${#_rts[@]}; _i++ )); do
    _nm="${_nms[${_i}]}"; _rt="${_CPP_PP[${_i}]}"
    case "${_rt}/" in "${_CPP_ROOT}/"*) ;; *) continue ;; esac
    _v="${_fpm}"; _src="fpm.info"
    while read -r _s _l; do
      [ "${_s}" = "${_nm}" ] && { _v="${_l//[!0-9]/}"; _src="multi-fpm.info"; }
    done <<< "${_mf}"
    [[ "${_v}" =~ ^[5-8][0-9]$ ]] && [ -x "/opt/php${_v}/bin/php" ] || continue
    if [ -z "${_min}" ] || [ "${_v}" -lt "${_min}" ]; then
      _min="${_v}"; _minsrc="${_src}"; _site="${_nm}"
    fi
  done
  [ -n "${_min}" ] && [ "${_ch}" -gt "${_min}" ] || return 0
  _cpp_rel "${_CPP_ROOT}"
  _cpp_key "${_CPP_RP}"
  _cpp_safe "${_site}"
  echo "WARNING: composer runs on PHP ${_ch:0:1}.${_ch:1:1} but ${_CPP_S} on this platform is set to PHP-FPM ${_min:0:1}.${_min:1:1} in ${_minsrc}; a package that needs PHP ${_ch:0:1}.${_ch:1:1} would make that site answer HTTP 500 \"Composer detected issues in your platform\". Add \"${_CPP_KY} ${_min:0:1}.${_min:1:1}\" to ${_CPP_WHERE}, or set config.platform.php in composer.json." >&2
}

check_php_cli_version() {
  ### echo CHK start check_php_cli_version
  _PHP_CLI=
  _CLI_FROM=""; _CLI_WHY=""
  if [ "${HOME}" = "/var/aegir" ] && [ -f "/var/aegir/drush/drush.php" ]; then
    _PHP_CLI=$(grep "/opt/php" /var/aegir/drush/drush.php 2>&1)
    _CLI_FROM="the master's Drush pin"
  else
    _ctrl_file "/data/disk/${_Y_USR}/static/control" cli.info
    _CLI_INFO="${_CTRL_F}"
    if [ -n "${_CLI_INFO}" ]; then
      _CLI_VRN=$(head -c 8 "${_CLI_INFO}" 2> /dev/null | tr -cd '0-9')
      case "${_CLI_VRN}" in
        56|70|71|72|73|74|80|81|82|83|84|85)
          [ -x "/opt/php${_CLI_VRN}/bin/php" ] && _PHP_CLI="php${_CLI_VRN}"
          _CLI_FROM="cli.info"
          ;;
      esac
    fi
  fi
  ### echo CHK 1 _PHP_CLI is ${_PHP_CLI}

  _PHP_V="56 70 71 72 73 74 80 81 82 83 84 85"
  for e in ${_PHP_V}; do
    if [[ "${_PHP_CLI}" =~ "php${e}" ]] && [ -x "/opt/php${e}/bin/php" ]; then
      DRUSH_PHP="/opt/php${e}/bin/php"
      _account_ini "${e}"
    fi
  done
  _CLI_WHY="${_CLI_FROM}"
  ### echo CHK 2 DRUSH_PHP is ${DRUSH_PHP}
  ### echo CHK 2 PHP_INI is ${PHP_INI}
  ### echo CHK 2 PHPRC is ${PHPRC}

  for e in ${_PHP_V}; do
    if [ -e "${_DRUSH_CLI_CTRL}/php${e}.info" ] && [ -x "/opt/php${e}/bin/php" ]; then
      DRUSH_PHP="/opt/php${e}/bin/php"
      _account_ini "${e}"
      _CLI_FROM="php${e}.info"
      _CLI_WHY="php${e}.info"
    fi
  done
  if [[ "${_CLI_FROM}" == php[0-9][0-9].info ]] && [ -n "${_CLI_VRN}" ] \
    && [ "${_CLI_FROM}" != "php${_CLI_VRN}.info" ] && [[ "${_PHP_CLI}" == php[0-9][0-9] ]]; then
    _CLI_WHY="${_CLI_FROM} (outranks cli.info ${_CLI_VRN:0:1}.${_CLI_VRN:1:1})"
  fi
  ### echo CHK 3 DRUSH_PHP is ${DRUSH_PHP}
  ### echo CHK 3 PHP_INI is ${PHP_INI}
  ### echo CHK 3 PHPRC is ${PHPRC}

  if [ ! -z "${PHP_INI}" ]; then
    export DRUSH_PHP;export PHP_INI;export PHPRC;
  else
    DRUSH_PHP="/usr/bin/php"
    export DRUSH_PHP;
    _CLI_FROM="the server default"
    _CLI_WHY="the server default"
    ### echo CHK 4 DRUSH_PHP is ${DRUSH_PHP}
  fi

  ### echo CHK fin check_php_cli_version
}

if [ -n "${JENKINS_HOME}" ] \
  || [ -n "${JENKINS_NODE_COOKIE}" ] \
  || [ -n "${WORKSPACE_TMP}" ]; then
  _IS_JENKINS=TRUE
else
  _IS_JENKINS=FALSE
fi

if [ "${_IS_JENKINS}" = "FALSE" ]; then
  check_php_cli_version
fi

# Known BOA identity classes take the dispatched path below: the master and
# the account users by home, the shell identities by lshellg/ltd-shell(-more)
# membership, and the two historical exact sets ("www-data users" in either
# order, "aegir www-data users"). Membership and set tests, never the order
# of the list -- see _in_grp / _grp_set_is.
if _grp_set_is "users www-data" \
  || _grp_set_is "aegir users www-data" \
  || [[ "${HOME}" =~ (^)"/var/aegir" ]] \
  || [[ "${HOME}" =~ (^)"/data/disk/" ]] \
  || _in_grp lshellg \
  || _in_grp ltd-shell \
  || _in_grp ltd-shell-more; then
  if [ "${1}" = "-c" ]; then
    _IS_SH_PATH=NO
    if [ "$0" = "/bin/sh" ] || [ "$0" = "/usr/bin/sh" ]; then
      _IS_SH_PATH=YES
    else
      echo
      echo "  ERROR: Not Authorized Path"
      echo
      exit 1
    fi
    if [[ $(whoami) == *.ftp ]] \
      || [[ "${2}" =~ "drush" ]] \
      || [[ "${2}" =~ "mysql " ]]; then
      _IN_PATH=YES
      _INTERNAL=YES
      # a dispatched drush line (_ARR from the bare verb or a launcher,
      # _OCTO_SYS_ARR from the account's own launcher), a mysql line, or a
      # line that names drush10/drush11 without leading with it (cd ... &&
      # drush11 cr): the Drush 10/11 PHP-floor selection below exports the
      # DRUSH_PHP the vendor launcher reads, and it must run for those too.
      # A line that merely NAMED drush took this block, and its "drush make"
      # test sent a tenant's grep -c "drush make" FILE away with "can not be
      # run in /home/..." (measured).
      if [[ "${_ARGS}" =~ "mysql " ]] \
        || [ -n "${_ARR}" ] \
        || [ -n "${_OCTO_SYS_ARR}" ] \
        || [ "${_D_IS}" = "1011" ]; then
        _PWD=$(pwd 2>&1)
        # a bare-verb line after "cd DIR &&" runs in DIR: the checks below
        # (drush make in ~/static, drush in a site folder) judge that folder
        if [[ "${_DL_CD}" =~ ^[[:space:]]*cd[[:space:]]+([^[:space:]\;\&\|]+) ]]; then
          _PWD=$(cd -- "${BASH_REMATCH[1]/#\~/${HOME}}" 2> /dev/null && pwd) || _PWD=$(pwd 2>&1)
        fi
        _DEST_DRUSH="/opt/tools/drush/8/drush/drush.php"
        if [[ "${_ARGS}" =~ "vendor/bin/drush " ]]; then
          _DEST_DRUSH="${_R_M}/vendor/drush/drush/drush.php"
        fi
        if [[ "${_ARGS}" =~ "vendor/drush/drush/drush " ]]; then
          _DEST_DRUSH="${_R_M}/vendor/drush/drush/drush.php"
        fi
        if [[ "${_ARGS}" =~ "/vendor/bin/drush " ]]; then
          _DEST_DRUSH="${_R_M}/vendor/drush/drush/drush.php"
        fi
        if [[ "${_LA_PATH}" == *vendor/drush/drush/drush.php ]] || [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php " ]]; then
          if [ -n "${_LA_PATH}" ] && ! _is_tenant && { [[ "${_LA_PATH}" == /* ]] || [ -n "${_LA_CD}" ]; }; then
            _DEST_DRUSH="${_LA_PATH}"
          elif [[ "$PWD" =~ /(web|html|docroot)$ ]] && [ -d ../vendor/drush ]; then
            _DEST_DRUSH="../vendor/drush/drush/drush.php"
          else
            _DEST_DRUSH="vendor/drush/drush/drush.php"
          fi
          ### echo INF 0 _DEST_DRUSH is ${_DEST_DRUSH}
        fi
        # the line's codebase and its cli-per-platform.info line, if any: a
        # dispatched line from its own arguments, a Drush 10/11 line that is
        # not dispatched (cd DIR && drush11 cr) from the segment that runs
        # it; a line that only names drush11 in an argument takes none
        [[ "${_DEST_DRUSH}" == *vendor/drush/drush/drush.php ]] && _CPP_FLAV=vendor
        _D_RUNS=NO
        if [ -n "${_ARR}" ]; then
          _D_RUNS=YES
          _cpp_resolve "${_ARR}" drush "${_LA_CD:-${_DL_CD}}"
        elif [ "${_D_IS}" = "1011" ] && _cpp_seg_lead "${_ARGS}" drush10 drush11; then
          _D_RUNS=YES
          _cpp_resolve "${_SEG_REST}" drush "${_SEG_CD}"
        fi
        if [ "${_D_IS}" = "1011" ]; then
          if [ "${_D_TOK}" = "drush11" ]; then
            _DEST_DRUSH="/usr/bin/drush11"
          else
            _DEST_DRUSH="/usr/bin/drush10"
          fi
          # The PHP floor of the Drush 10/11 tree BOA built is whatever its
          # composer platform check says (8.1 on current builds), not the 7.4
          # this branch used to claim: the cli.info pin (already resolved into
          # DRUSH_PHP by check_php_cli_version) and any phpNN.info control file
          # are honoured only at or above that floor, otherwise the highest
          # installed PHP that clears it is used and the user is told, so a
          # 7.4 pin never surfaces as a composer platform error.
          _D_FLOOR=$(grep -o "PHP_VERSION_ID >= [0-9]*" \
            "$(dirname "$(readlink -f "${_DEST_DRUSH}")")/../composer/platform_check.php" 2> /dev/null \
            | head -1 | grep -o "[0-9]*$")
          case "${_D_FLOOR}" in
            [0-9][0-9][0-9][0-9][0-9]) _D_FLOOR=$(( _D_FLOOR / 100 )) ;;
            *) _D_FLOOR=801 ;;
          esac
          _D_FLOOR_N="${_D_FLOOR:0:1}${_D_FLOOR:2:1}"
          _D_PIN=""
          case "${DRUSH_PHP}" in
            /opt/php[0-9][0-9]/bin/php) _D_PIN="${DRUSH_PHP:8:2}" ;;
          esac
          _D_SEL=""
          # a cli-per-platform.info line is never raised: below the floor
          # the line is refused and named, the tenant chose that version
          if [ -n "${_CPP_V}" ]; then
            if [ "${_CPP_V}" -ge "${_D_FLOOR_N}" ]; then
              _D_SEL="${_CPP_V}"
            else
              _cpp_rel "${_CPP_ROOT}"
              _cpp_say "Drush 11 and Drush 10 need PHP ${_D_FLOOR:0:1}.${_D_FLOOR:2:1} or newer; line ${_CPP_LN} of ${_CPP_WHERE} sets PHP ${_CPP_V:0:1}.${_CPP_V:1:1} for ${_CPP_RP}. Use drush8 there, or change the line."
            fi
          fi
          if [ -z "${_D_SEL}" ] && [[ ! "${HOME}" =~ (^)"/data/disk/" ]]; then
            _PHP_V="74 80 81 82 83 84 85"
            for e in ${_PHP_V}; do
              if [ -e "${_DRUSH_CLI_CTRL}/php${e}.info" ] && [ -x "/opt/php${e}/bin/php" ] \
                && [ "${e}" -ge "${_D_FLOOR_N}" ]; then
                _D_SEL="${e}"
              fi
            done
          fi
          if [ -z "${_D_SEL}" ] && [ -n "${_D_PIN}" ] && [ "${_D_PIN}" -ge "${_D_FLOOR_N}" ] \
            && [ -x "/opt/php${_D_PIN}/bin/php" ]; then
            _D_SEL="${_D_PIN}"
          fi
          if [ -z "${_D_SEL}" ]; then
            # every supported CLI, so a 7.4 or 8.0 floor can be met on a box
            # without PHP 8.1+; the floor test below keeps anything lower out
            for e in 85 84 83 82 81 80 74; do
              if [ -x "/opt/php${e}/bin/php" ] && [ "${e}" -ge "${_D_FLOOR_N}" ]; then
                _D_SEL="${e}"
                # stderr: a NOTE on stdout lands in drush11 ... > file; and
                # only where Drush 10/11 runs, not on a line that names it
                [ "${_D_RUNS}" = "YES" ] \
                  && echo "  NOTE: Drush 10/11 need PHP ${_D_FLOOR:0:1}.${_D_FLOOR:2:1}+; using PHP ${e:0:1}.${e:1:1}" >&2
                _CPP_FROM="the Drush 10/11 floor (${_CLI_WHY:-the server default} is below ${_D_FLOOR:0:1}.${_D_FLOOR:2:1})"
                break
              fi
            done
          fi
          if [ -n "${_D_SEL}" ]; then
            DRUSH_PHP="/opt/php${_D_SEL}/bin/php"
            _account_ini "${_D_SEL}"
            export DRUSH_PHP;export PHP_INI;export PHPRC;
            ### echo INF 3 DRUSH_PHP is ${DRUSH_PHP}
            ### echo INF 3 PHP_INI is ${PHP_INI}
            ### echo INF 3 PHPRC is ${PHPRC}
            ### echo INF 3 _DEST_DRUSH is ${_DEST_DRUSH}
          else
            echo
            echo "  Drush 11 and Drush 10 need PHP ${_D_FLOOR:0:1}.${_D_FLOOR:2:1} or newer,"
            echo "  and no such PHP version is installed on this server."
            echo "  Bye"
            echo
            exit 0
          fi
        elif [ "${_D_IS}" = "8" ]; then
          _DEST_DRUSH="/opt/tools/drush/8/drush/drush.php"
          if [[ "${_ARGS}" =~ "vendor/bin/drush " ]]; then
            _DEST_DRUSH="${_R_M}/vendor/drush/drush/drush.php"
          fi
          if [[ "${_ARGS}" =~ "vendor/drush/drush/drush " ]]; then
            _DEST_DRUSH="${_R_M}/vendor/drush/drush/drush.php"
          fi
          if [[ "${_ARGS}" =~ "/vendor/bin/drush " ]]; then
            _DEST_DRUSH="${_R_M}/vendor/drush/drush/drush.php"
          fi
          if [[ "${_LA_PATH}" == *vendor/drush/drush/drush.php ]] || [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php " ]]; then
            if [ -n "${_LA_PATH}" ] && ! _is_tenant && { [[ "${_LA_PATH}" == /* ]] || [ -n "${_LA_CD}" ]; }; then
              # an absolute launcher, or one relative to a cd DIR && in front
              # of it: run the launcher as typed (the cwd-derived form below
              # only fits a launcher relative to where websh runs). Not for a
              # tenant: an absolute path of theirs under /tmp or /home is what
              # the fast lane above keeps out on purpose
              _DEST_DRUSH="${_LA_PATH}"
            # the parent's Drush only where the parent has one: a docroot
            # named web/html/docroot can carry its own vendor/ instead
            elif [[ "$PWD" =~ /(web|html|docroot)$ ]] && [ -d ../vendor/drush ]; then
              _DEST_DRUSH="../vendor/drush/drush/drush.php"
            else
              _DEST_DRUSH="vendor/drush/drush/drush.php"
            fi
            ### echo INF 1 _DEST_DRUSH is ${_DEST_DRUSH}
          fi
          if [[ ! "${HOME}" =~ (^)"/data/disk/" ]] && [ "${_IS_JENKINS}" = "FALSE" ]; then
            _PHP_V="56 70 71 72 73 74 80 81 82 83 84 85"
            for e in ${_PHP_V}; do
              if [ -e "${_DRUSH_CLI_CTRL}/php${e}.info" ] && [ -x "/opt/php${e}/bin/php" ]; then
                DRUSH_PHP="/opt/php${e}/bin/php"
                _account_ini "${e}"
              fi
            done
          fi
          _cpp_pick
          if [ ! -z "${DRUSH_PHP}" ] && [ ! -z "${PHP_INI}" ] && [ "${_IS_JENKINS}" = "FALSE" ]; then
            export DRUSH_PHP;export PHP_INI;export PHPRC;
            ### echo INF 4 DRUSH_PHP is ${DRUSH_PHP}
            ### echo INF 4 PHP_INI is ${PHP_INI}
            ### echo INF 4 PHPRC is ${PHPRC}
            ### echo INF 4 _DEST_DRUSH is ${_DEST_DRUSH}
          fi
        fi
        if [[ "${_ARGS}" =~ "drush make" ]] \
          || [[ "${_ARGS}" =~ "drush8 make" ]] \
          || [[ "${_ARGS}" =~ "drush cc drush" ]] \
          || [[ "${_ARGS}" =~ "drush8 cc drush" ]] \
          || [[ "${_ARGS}" =~ "drush10 cr drush" ]] \
          || [[ "${_ARGS}" =~ "drush11 cr drush" ]] \
          || [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php cr drush" ]]; then
          if [[ "${_PWD}" =~ "/static" ]] \
            || [[ "${_ARGS}" =~ "drush cc drush" ]] \
            || [[ "${_ARGS}" =~ "drush8 cc drush" ]] \
            || [[ "${_ARGS}" =~ "drush10 cr drush" ]] \
            || [[ "${_ARGS}" =~ "drush11 cr drush" ]] \
            || [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php cr drush" ]]; then
            _CORRECT=YES
            _CORRECT_PWD_R=$(pwd 2>&1)
            _CORRECT_ARGS_R="${_ARGS}"
            ### echo _CORRECT_PWD_R is ${_CORRECT_PWD_R}
            ### echo _CORRECT_ARGS_R is ${_CORRECT_ARGS_R}
          else
            if [[ "${_ARGS}" =~ "make-generate" ]] \
              && [ -f "${_PWD}/settings.php" ]; then
              _CORRECT=YES
              _CORRECT_PWD_S=$(pwd 2>&1)
              _CORRECT_ARGS_S="${_ARGS}"
              ### echo _CORRECT_PWD_S is ${_CORRECT_PWD_S}
              ### echo _CORRECT_ARGS_S is ${_CORRECT_ARGS_S}
            else
              echo
              echo " This drush command can not be run in ${_PWD}"
              if [[ "${2}" =~ "make-generate" ]]; then
                echo " Please cd to the valid sites/foo.com directory first"
                echo " or use a valid @alias, like: drush @foo.com status"
                echo " Hint: Use 'drush aliases' to display all Drush 8 aliases"
                echo " Hint: Use 'drush11 aliases' to display all Drush 10+ aliases"
              else
                echo " Please cd ~/static first"
              fi
              echo
              exit 0
            fi
          fi
        else
          if [[ "${_ARGS}" =~ "drush @" ]] \
            || [[ "${_ARGS}" =~ "drush8 @" ]] \
            || [[ "${_ARGS}" =~ "drush10 @" ]] \
            || [[ "${_ARGS}" =~ "drush11 @" ]] \
            || [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php @" ]] \
            || [[ "${_ARGS}" =~ "vendor/bin/drush @" ]] \
            || [[ "${_ARGS}" =~ "drush -vvv @" ]] \
            || [[ "${_ARGS}" =~ "drush8 -vvv @" ]] \
            || [[ "${_ARGS}" =~ "drush10 -vvv @" ]] \
            || [[ "${_ARGS}" =~ "drush11 -vvv @" ]] \
            || [[ "${_ARGS}" =~ "vendor/drush/drush/drush.php -vvv @" ]] \
            || [[ "${_ARGS}" =~ "vendor/bin/drush -vvv @" ]]; then
            if [[ "${2}" =~ "restore"($) ]] \
              || [[ "${2}" =~ "arr"($) ]] \
