#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Script to check Drupal codebase compatibility with Percona 8.0
# Focuses on Drupal core version and lists contributed modules

# Set the path to your Drupal codebase; can be passed as the first argument
_DRUPAL_PATH="${1:-/path/to/drupal}"

# Log file to store incompatibility results
_LOG_FILE="/var/xdrago/log/core/incompatible-$(date +%y%m%d-%H%M%S).log"

# Function to get Drupal core version
get_drupal_version() {
  local _version=""
  # Check for Drupal 8 and above
  if [ -f "${_DRUPAL_PATH}/core/lib/Drupal.php" ]; then
    _version_line=$(grep -m1 'const VERSION =' "${_DRUPAL_PATH}/core/lib/Drupal.php")
    _version=$(echo "${_version_line}" | awk -F"'" '{print $2}')
    echo "${_version}"
    return
  fi

  # Check for Drupal 7 and below
  if [ -f "${_DRUPAL_PATH}/includes/bootstrap.inc" ]; then
    _version_line=$(grep -m1 "define('VERSION'," "${_DRUPAL_PATH}/includes/bootstrap.inc")
    _version=$(echo "${_version_line}" | awk -F"'" '{print $2}')
    echo "${_version}"
    return
  fi

  # Try to get version from VERSION.txt
  if [ -f "${_DRUPAL_PATH}/core/VERSION.txt" ]; then
    _version=$(cat "${_DRUPAL_PATH}/core/VERSION.txt" | tr -d '[:space:]')
    echo "${_version}"
    return
  fi

  if [ -f "${_DRUPAL_PATH}/VERSION.txt" ]; then
    _version=$(cat "${_DRUPAL_PATH}/VERSION.txt" | tr -d '[:space:]')
    echo "${_version}"
    return
  fi

  # Version not found
  echo ""
}

# Function to compare versions
version_lt() {
  # Returns 0 (true) if first version is less than second
  test "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" != "$2"
}

# Function to check compatibility based on Drupal version
check_compatibility() {
  local _version="$1"
  local _major_version=$(echo "${_version}" | cut -d '.' -f1)

  if [ -z "${_version}" ]; then
    # Could not determine version
    echo "Could not determine Drupal version for codebase at ${_DRUPAL_PATH}" >> "${_LOG_FILE}"
    return 1
  fi

  # Drupal 6 does not support MySQL 8.0
  if [ "${_major_version}" = "6" ]; then
    echo "Drupal 6 (${_version}) does not support MySQL 8.0" >> "${_LOG_FILE}"
    return 1
  fi

  # Drupal 7 supports MySQL 8.0 since version 7.76
  if [ "${_major_version}" = "7" ]; then
    if version_lt "${_version}" "7.76"; then
      echo "Drupal 7 (${_version}) supports MySQL 8.0 since version 7.76" >> "${_LOG_FILE}"
      return 1
    fi
  fi

  # Drupal 8 supports MySQL 8.0 since version 8.6.0
  if [ "${_major_version}" = "8" ]; then
    if version_lt "${_version}" "8.6.0"; then
      echo "Drupal 8 (${_version}) supports MySQL 8.0 since version 8.6.0" >> "${_LOG_FILE}"
      return 1
    fi
  fi

  # Drupal 11 no longer supports MySQL 5.7
  if [ "${_major_version}" = "11" ]; then
    echo "Drupal 11 (${_version}) requires MySQL 8.0" >> "${_LOG_FILE}"
    # No need to return 1, as it's compatible with MySQL 8.0
  fi

  # All other versions are considered compatible
  return 0
}

# Function to list contributed modules and their versions
list_contrib_modules() {
  local _module_paths=()
  # Drupal 7 and below modules path
  if [ -d "${_DRUPAL_PATH}/sites/all/modules" ]; then
    _module_paths+=("${_DRUPAL_PATH}/sites/all/modules")
  fi
  # Drupal 8 and above modules path
  if [ -d "${_DRUPAL_PATH}/modules" ]; then
    _module_paths+=("${_DRUPAL_PATH}/modules")
  fi

  for _module_dir in "${_module_paths[@]}"; do
    find "${_module_dir}" -type f \( -name "*.info.yml" -o -name "*.info" \) | while read -r _file; do
      _module_name=$(basename "$(dirname "${_file}")")
      _module_version=$(grep -E '^version[:=]' "${_file}" 2>/dev/null | awk -F'[:=]' '{print $2}' | tr -d '[:space:]')
      if [ -z "${_module_version}" ]; then
        _module_version="(version not specified)"
      fi
      echo "Module: ${_module_name}, Version: ${_module_version}, Path: $(dirname "${_file}")" >> "${_LOG_FILE}"
    done
  done
}

# Main script execution

# Initialize incompatibility found flag
_INCOMPATIBILITY_FOUND=0

# Get Drupal core version
_DRUPAL_VERSION=$(get_drupal_version)

# Check compatibility
check_compatibility "${_DRUPAL_VERSION}"
_COMPATIBLE=$?

# If codebase is incompatible, set incompatibility found flag
if [ "${_COMPATIBLE}" -ne 0 ]; then
  _INCOMPATIBILITY_FOUND=1
fi

# If any incompatibilities were found, log the codebase path and list contributed modules
if [ "${_INCOMPATIBILITY_FOUND}" -eq 1 ]; then
  echo "Incompatibility detected in codebase at ${_DRUPAL_PATH}" >> "${_LOG_FILE}"
  echo "Drupal version: ${_DRUPAL_VERSION}" >> "${_LOG_FILE}"
  echo "Listing contributed modules for manual compatibility check:" >> "${_LOG_FILE}"
  list_contrib_modules
  echo "-----------------------------" >> "${_LOG_FILE}"
fi
