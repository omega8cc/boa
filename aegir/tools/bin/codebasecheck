#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

# Check a Drupal/Backdrop codebase for compatibility with Percona/MySQL 8.x (8.0/8.4).
#
# Two modes:
#   codebasecheck <platform-path>   Check one codebase (used by the nightly, per platform).
#   codebasecheck --box             Scan every Octopus account on this box and print a single
#                                   Percona-8 readiness report: which accounts (if any) block the
#                                   box-wide 5.7 -> 8.0 -> 8.4 upgrade because one shared instance
#                                   serves the whole box, so its oldest codebase gates the upgrade.
#
# Compatibility floor per core (mirrors BOA's own maintained cores and community MySQL-8 support):
#   D6  >= 6.51  (d6lts/Pressflow MySQL-8 retrofits)   D7  >= 7.76   D8  >= 8.6.0
#   D9 / D10 / D11 and Backdrop: supported. Older, or an unrecognised codebase: flagged.

# Log directory for both modes.
[ ! -d "/var/log/boa/core" ] && mkdir -p /var/log/boa/core

# Function to get the core version of a codebase.
# $1 = codebase path. Prints the version token (e.g. 7.105, 6.60, backdrop-1.35.x-dev) to stdout,
# or an empty line if it cannot be determined. Diagnostics go to stderr.
get_drupal_version() {
  local _path="$1"
  local _version_line
  local _version

  echo "Checking core version in path: ${_path}" >&2

  # Backdrop CMS: unique marker BACKDROP_VERSION in core/includes/bootstrap.inc (has core/ but no
  # core/lib/Drupal.php, so it must be matched before the Drupal 8+ probe below).
  if [ -f "${_path}/core/includes/bootstrap.inc" ] \
    && grep -q "BACKDROP_VERSION" "${_path}/core/includes/bootstrap.inc"; then
    echo "Detected Backdrop CMS." >&2
    _version_line=$(grep -m1 "define('BACKDROP_VERSION'" "${_path}/core/includes/bootstrap.inc")
    _version=$(echo "${_version_line}" | sed -E "s/.*define\('BACKDROP_VERSION',[[:space:]]*'([^']+)'\).*/\1/")
    echo "Detected Backdrop version: ${_version}" >&2
    echo "backdrop-${_version}"
    return
  fi

  # Drupal 8 and above.
  if [ -f "${_path}/core/lib/Drupal.php" ]; then
    echo "Detected Drupal 8 or higher." >&2
    _version_line=$(grep -m1 'const VERSION' "${_path}/core/lib/Drupal.php")
    _version=$(echo "${_version_line}" | sed -E "s/.*const VERSION[[:space:]]*=[[:space:]]*'([^']+)'.*/\1/")
    echo "Detected Drupal version: ${_version}" >&2
    echo "${_version}"
    return
  fi

  # Drupal 7.
  if [ -f "${_path}/includes/bootstrap.inc" ]; then
    if grep -q "define('VERSION'," "${_path}/includes/bootstrap.inc"; then
      echo "Detected Drupal 7." >&2
      _version_line=$(grep -m1 "define('VERSION'," "${_path}/includes/bootstrap.inc")
      _version=$(echo "${_version_line}" | sed -E "s/.*define\('VERSION',[[:space:]]*'([^']+)'\);.*/\1/")
      echo "Detected Drupal version: ${_version}" >&2
      echo "${_version}"
      return
    fi
  fi

  # Drupal 6.
  if [ -f "${_path}/modules/system/system.module" ]; then
    if grep -q "define('VERSION'," "${_path}/modules/system/system.module"; then
      echo "Detected Drupal 6." >&2
      _version_line=$(grep -m1 "define('VERSION'," "${_path}/modules/system/system.module")
      _version=$(echo "${_version_line}" | sed -E "s/.*define\('VERSION',[[:space:]]*'([^']+)'\);.*/\1/")
      echo "Detected Drupal version: ${_version}" >&2
      echo "${_version}"
      return
    fi
  fi

  # Fallbacks.
  if [ -f "${_path}/core/VERSION.txt" ]; then
    _version=$(tr -d '[:space:]' < "${_path}/core/VERSION.txt")
    echo "Detected Drupal version (core/VERSION.txt): ${_version}" >&2
    echo "${_version}"
    return
  fi

  if [ -f "${_path}/VERSION.txt" ]; then
    _version=$(tr -d '[:space:]' < "${_path}/VERSION.txt")
    echo "Detected Drupal version (VERSION.txt): ${_version}" >&2
    echo "${_version}"
    return
  fi

  echo "Could not determine core version for codebase at ${_path}" >&2
  echo ""
  return
}

# version_lt A B -> returns 0 (true) if A is strictly less than B (version-sorted).
version_lt() {
  test "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" != "$2"
}

# Classify one codebase against the Percona-8 floor.
# $1 = codebase path.
# Prints one TAB-separated line to stdout: "<STATUS>\t<version>\t<reason>"
#   STATUS = OK | BLOCK | UNKNOWN
# Returns 0 for OK, 1 for BLOCK, 2 for UNKNOWN.
classify_codebase() {
  local _path="$1"
  local _version
  local _major
  _version=$(get_drupal_version "${_path}")

  if [ -z "${_version}" ]; then
    printf 'UNKNOWN\t(unknown)\tCould not determine core version — review manually: %s\n' "${_path}"
    return 2
  fi

  # Backdrop: supported on MySQL/Percona 8.x.
  case "${_version}" in
    backdrop-*)
      printf 'OK\t%s\tBackdrop is MySQL-8 compatible\n' "${_version}"
      return 0
      ;;
  esac

  _major=$(echo "${_version}" | cut -d '.' -f1)

  case "${_major}" in
    6)
      # d6lts / Pressflow gained MySQL-8 support at 6.51 (reserved-word escaping,
      # ONLY_FULL_GROUP_BY stripping, native_password).
      if version_lt "${_version}" "6.51"; then
        printf 'BLOCK\t%s\tDrupal 6 (%s) predates d6lts 6.51 MySQL-8 support — migrate to a legacy Percona 5.7 VM\n' "${_version}" "${_version}"
        return 1
      fi
      printf 'OK\t%s\tDrupal 6 (%s) is d6lts >= 6.51 (MySQL-8 compatible)\n' "${_version}" "${_version}"
      return 0
      ;;
    7)
      # D7 core gained MySQL-8 support at 7.76.
      if version_lt "${_version}" "7.76"; then
        printf 'BLOCK\t%s\tDrupal 7 (%s) predates 7.76 MySQL-8 support — migrate to a legacy Percona 5.7 VM\n' "${_version}" "${_version}"
        return 1
      fi
      printf 'OK\t%s\tDrupal 7 (%s) >= 7.76 (MySQL-8 compatible)\n' "${_version}" "${_version}"
      return 0
      ;;
    8)
      # D8 gained MySQL-8 support at 8.6.0.
      if version_lt "${_version}" "8.6.0"; then
        printf 'BLOCK\t%s\tDrupal 8 (%s) predates 8.6.0 MySQL-8 support — migrate to a legacy Percona 5.7 VM\n' "${_version}" "${_version}"
        return 1
      fi
      printf 'OK\t%s\tDrupal 8 (%s) >= 8.6.0 (MySQL-8 compatible)\n' "${_version}" "${_version}"
      return 0
      ;;
    9|10)
      printf 'OK\t%s\tDrupal %s is MySQL-8 compatible\n' "${_version}" "${_version}"
      return 0
      ;;
    11)
      printf 'OK\t%s\tDrupal %s requires MySQL 8 (this is why the box must be on Percona 8.x)\n' "${_version}" "${_version}"
      return 0
      ;;
    *)
      printf 'OK\t%s\tDrupal %s is MySQL-8 compatible\n' "${_version}" "${_version}"
      return 0
      ;;
  esac
}

# List contributed/custom modules for a codebase, for manual review when it is incompatible.
# $1 = codebase path, $2 = log file to append to.
list_contrib_modules() {
  local _path="$1"
  local _log="$2"
  local _module_paths=()
  local _module_dir
  local _file
  local _module_name
  local _module_version
  echo "Listing contributed modules for manual compatibility check:" | tee -a "${_log}"

  # Drupal 7 and below.
  [ -d "${_path}/sites/all/modules" ] && _module_paths+=("${_path}/sites/all/modules")
  if ls -d "${_path}/sites/"*/modules 1> /dev/null 2>&1; then
    for _module_dir in "${_path}/sites/"*/modules; do
      _module_paths+=("${_module_dir}")
    done
  fi
  # Drupal 8 and above.
  [ -d "${_path}/modules/contrib" ] && _module_paths+=("${_path}/modules/contrib")
  [ -d "${_path}/modules/custom" ] && _module_paths+=("${_path}/modules/custom")
  [ -d "${_path}/modules" ] && _module_paths+=("${_path}/modules")

  for _module_dir in "${_module_paths[@]}"; do
    echo "Scanning directory: ${_module_dir}" >&2
    find "${_module_dir}" -type f \( -name "*.info.yml" -o -name "*.info" \) 2>/dev/null | while read -r _file; do
      _module_name=$(basename "$(dirname "${_file}")")
      _module_version=$(grep -E '^(version|core)[:=]' "${_file}" 2>/dev/null | head -n1 | awk -F'[:=]' '{print $2}' | tr -d '[:space:]')
      [ -z "${_module_version}" ] && _module_version="(version not specified)"
      echo "Module: ${_module_name}, Version: ${_module_version}, Path: $(dirname "${_file}")" | tee -a "${_log}"
    done
  done
}

# ---------------------------------------------------------------------------
# Path mode: check one codebase (backward-compatible; used by the nightly).
# ---------------------------------------------------------------------------
run_path_mode() {
  local _path="$1"
  local _log
  local _result_line
  local _status
  _log="/var/log/boa/core/incompatible-$(date +%y%m%d-%H%M%S).log"

  _result_line=$(classify_codebase "${_path}")
  _status=$(echo "${_result_line}" | cut -f1)

  echo "${_result_line}" | cut -f3-

  if [ "${_status}" != "OK" ]; then
    {
      echo "Incompatibility detected in codebase at ${_path}"
      echo "${_result_line}" | cut -f2- | sed 's/\t/ : /'
    } | tee -a "${_log}"
    list_contrib_modules "${_path}" "${_log}"
    echo "-----------------------------" | tee -a "${_log}"
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Box mode: scan every Octopus account on this box and roll up one readiness verdict.
# ---------------------------------------------------------------------------
run_box_mode() {
  local _log
  local _host
  local _acct_home
  local _acct
  local _plr
  local _result_line
  local _status
  local _version
  local _reason
  local _platforms
  local _acct_blocked
  local _blocked_accounts=()
  local _box_status="READY"
  _host=$(hostname -f 2>/dev/null || hostname)
  _log="/var/log/boa/core/box-readiness-$(date +%y%m%d-%H%M%S).log"

  {
    echo "=== BOA Percona 8.x readiness — ${_host} — $(date) ==="
    echo "One shared Percona instance serves the whole box, so its oldest codebase gates the"
    echo "box-wide 5.7 -> 8.0 -> 8.4 upgrade. Accounts marked BLOCKED must move to a legacy"
    echo "Percona 5.7 VM before this box can upgrade."
    echo ""
  } | tee -a "${_log}"

  for _acct_home in $(find /data/disk/ -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort); do
    _acct=$(basename "${_acct_home}")
    # Only real Octopus instances carry drush aliases.
    [ -d "${_acct_home}/.drush" ] || continue

    # Harvest unique platform roots from this account's site/platform aliases (the walk the
    # nightly already trusts), validated under /data/disk and existing on disk.
    _platforms=$(grep -hE "'root'[[:space:]]*=>" "${_acct_home}/.drush/"*.alias.drushrc.php 2>/dev/null \
      | sed -E "s/.*'root'[[:space:]]*=>[[:space:]]*'([^']+)'.*/\1/" \
      | sort -u)

    _acct_blocked=0
    local _acct_lines=()
    local _plr_count=0
    while IFS= read -r _plr; do
      [ -z "${_plr}" ] && continue
      case "${_plr}" in
        /data/disk/*) ;;
        *) continue ;;
      esac
      [ -d "${_plr}" ] || continue
      _plr_count=$((_plr_count + 1))
      _result_line=$(classify_codebase "${_plr}")
      _status=$(echo "${_result_line}" | cut -f1)
      _version=$(echo "${_result_line}" | cut -f2)
      _reason=$(echo "${_result_line}" | cut -f3)
      if [ "${_status}" = "OK" ]; then
        _acct_lines+=("    OK      ${_plr}  [${_version}]")
      else
        _acct_blocked=1
        _acct_lines+=("    ${_status}   ${_plr}  [${_version}]  ${_reason}")
      fi
    done <<< "${_platforms}"

    if [ "${_plr_count}" -eq 0 ]; then
      continue
    fi

    if [ "${_acct_blocked}" -eq 1 ]; then
      _blocked_accounts+=("${_acct}")
      _box_status="BLOCKED"
      echo "Account ${_acct}: BLOCKED" | tee -a "${_log}"
    else
      echo "Account ${_acct}: READY (${_plr_count} codebase(s))" | tee -a "${_log}"
    fi
    printf '%s\n' "${_acct_lines[@]}" | tee -a "${_log}"
  done

  {
    echo ""
    echo "--------------------------------------------------------"
    if [ "${_box_status}" = "READY" ]; then
      echo "RESULT: READY — every codebase on this box is compatible with Percona 8.x."
    else
      echo "RESULT: BLOCKED — these account(s) must move to a legacy Percona 5.7 VM before this box upgrades:"
      printf '  - %s\n' "${_blocked_accounts[@]}"
    fi
  } | tee -a "${_log}"

  echo "Report saved to ${_log}" >&2
  [ "${_box_status}" = "READY" ]
}

# ---------------------------------------------------------------------------
# Dispatch.
# ---------------------------------------------------------------------------
case "$1" in
  --box|-b|box)
    run_box_mode
    exit $?
    ;;
  ""|--help|-h)
    echo "Usage:" >&2
    echo "  codebasecheck <platform-path>   check one codebase" >&2
    echo "  codebasecheck --box             box-wide Percona 8.x readiness report" >&2
    exit 1
    ;;
  *)
    run_path_mode "$1"
    exit $?
    ;;
esac
