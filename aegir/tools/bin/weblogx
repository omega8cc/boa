#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=pro

_aptAllow="--allow-unauthenticated"
_aptYesUnth="-y ${_aptAllow}"
_crlGet="-L --max-redirs 3 -s --fail --retry 9 --retry-delay 9 -A iCab"
_wgetGet="--max-redirect=3 -q --tries=9 --wait=9 --user-agent='iCab'"
_GOACCESS_VRN=1.11
_sPmrs="https://raw.githubusercontent.com/matomo-org/referrer-spam-blacklist/master/spammers.txt"

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    ionice -c2 -n7 -p $$
    renice 19 -p $$
    chmod a+w /dev/null
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
}
_check_root

[ -e "/etc/boa/.pause_tasks_maint.cnf" ] && exit 0

if [ -n "${_ENABLE_GOACCESS}" ] && [ "${_ENABLE_GOACCESS}" = "YES" ]; then
  _GOACCESS=YES
else
  if [ -d "/var/www/adminer/access/archive" ]; then
    rm -rf /var/www/adminer/access
    rm -f /root/.goaccessrc*
  fi
  exit 0
fi

_os_detection_minimal() {
  _APT_UPDATE="apt-get update"
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  _OS_LIST="excalibur daedalus chimaera beowulf buster bullseye bookworm trixie"
  for e in ${_OS_LIST}; do
    if [ "${e}" = "${_OS_CODE}" ]; then
      _APT_UPDATE="apt-get update --allow-releaseinfo-change"
    fi
  done
}
_os_detection_minimal

_apt_clean_update() {
  ${_APT_UPDATE} -qq 2>/dev/null
  _CALLER_SCRIPT="$(basename "${BASH_SOURCE[-1]}")"
  _CALLER_SCRIPT="${_CALLER_SCRIPT//[^a-zA-Z0-9._-]/_}"
  date +%s > "/run/_latest_apt_clean_update.${_CALLER_SCRIPT}.pid"
}

_find_fast_mirror_early() {
  _isNetc="$(which netcat)"
  if [ ! -x "${_isNetc}" ] || [ -z "${_isNetc}" ]; then
    if [ ! -e "/etc/apt/apt.conf.d/00sandboxoff" ] \
      && [ -e "/etc/apt/apt.conf.d" ]; then
      echo "APT::Sandbox::User \"root\";" > /etc/apt/apt.conf.d/00sandboxoff
    fi
    _apt_clean_update
    apt-get install netcat-traditional ${_aptYesUnth} 2> /dev/null
    wait
  fi
  _ffMirr=/opt/local/bin/ffmirror
  if [ -x "${_ffMirr}" ]; then
    _ffList="/var/backups/boa-mirrors-2026-07.txt"
    [ -d "/var/backups" ] || mkdir -p /var/backups
    if [ ! -e "${_ffList}" ]; then
      echo "files.boa.io"  > ${_ffList}
      echo "files.o8.io" >> ${_ffList}
      echo "files.host8.biz" >> ${_ffList}
      echo "files.aegir.biz" >> ${_ffList}
      echo "files.aoboshi.com" >> ${_ffList}
    fi
    if [ -e "${_ffList}" ]; then
      _BROKEN_FFMIRR_TEST=$(grep "stuff" ${_ffMirr} 2>&1)
      if [[ "${_BROKEN_FFMIRR_TEST}" =~ "stuff" ]]; then
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _USE_MIR="${_CHECK_MIRROR}"
        [[ "${_USE_MIR}" =~ "printf" ]] && _USE_MIR="files.boa.io"
      else
        _USE_MIR="files.boa.io"
      fi
    else
      _USE_MIR="files.boa.io"
    fi
  else
    _USE_MIR="files.boa.io"
  fi
  _urlDev="https://${_USE_MIR}/dev"
  _urlHmr="https://${_USE_MIR}/versions/${_tRee}/boa/aegir"
}

_fetch_geoip() {
  mkdir -p /usr/share/GeoIP
  chmod 755 /usr/share/GeoIP
  mkdir -p /opt/tmp
  cd /opt/tmp
  rm -f /opt/tmp/Geo*

  # For GeoIP2 ASN database:
  wget -q -U iCab ${_urlDev}/src/GeoLite2-ASN.mmdb.gz
  gunzip GeoLite2-ASN.mmdb.gz &> /dev/null
  cp -af GeoLite2-ASN.mmdb /usr/share/GeoIP/

  # For GeoIP2 City database:
  wget -q -U iCab ${_urlDev}/src/GeoLite2-City.mmdb.gz
  gunzip GeoLite2-City.mmdb.gz &> /dev/null
  cp -af GeoLite2-City.mmdb /usr/share/GeoIP/

  # For GeoIP2 Country database:
  wget -q -U iCab ${_urlDev}/src/GeoLite2-Country.mmdb.gz
  gunzip GeoLite2-Country.mmdb.gz &> /dev/null
  cp -af GeoLite2-Country.mmdb /usr/share/GeoIP/

  chmod 644 /usr/share/GeoIP/*
  rm -f /opt/tmp/Geo*
  cd
}

_install_goaccess() {
  echo "Installing GoAccess ${_GOACCESS_VRN} with dependencies..."
  cd
  if [ ! -e "/etc/apt/apt.conf.d/00sandboxoff" ] \
    && [ -e "/etc/apt/apt.conf.d" ]; then
    echo "APT::Sandbox::User \"root\";" > /etc/apt/apt.conf.d/00sandboxoff
  fi
  _apt_clean_update
  aptitude purge goaccess -y
  apt-get install libmaxminddb-dev ${_aptYesUnth}
  apt-get install libncurses5-dev ${_aptYesUnth}
  apt-get install libncursesw5-dev ${_aptYesUnth}
  apt-get install autopoint ${_aptYesUnth}
  _find_fast_mirror_early
  mkdir -p /var/opt
  cd /var/opt
  rm -rf /var/opt/goaccess*
  echo "Downloading from ${_urlDev}/src/goaccess-${_GOACCESS_VRN}.tar.gz"
  curl -I ${_urlDev}/src/goaccess-${_GOACCESS_VRN}.tar.gz
  curl ${_crlGet} "${_urlDev}/src/goaccess-${_GOACCESS_VRN}.tar.gz" | tar -xzf -
  cd /var/opt/goaccess-${_GOACCESS_VRN}
  bash ./configure --prefix=/usr --enable-utf8 --enable-geoip=mmdb --with-getline
  make --quiet
  make --quiet install
  rm -rf /var/opt/goaccess*
  cd
}

_if_install() {
  _isGoacs="$(which goaccess)"
  if [ ! -x "${_isGoacs}" ] \
    || [ -z "${_isGoacs}" ]; then
    _install_goaccess
  else
    _GOACCESS_ITD=$(goaccess --version 2>&1 \
      | tr -d "\n" \
      | tr -d "v=" \
      | tr -d "For" \
      | cut -d" " -f3 \
      | awk '{ print $1}' 2>&1)
    if [ "${_GOACCESS_ITD}" = "${_GOACCESS_VRN}." ]; then
      echo "Latest GoAccess ${_GOACCESS_VRN} already installed"
    else
      _install_goaccess
    fi
  fi
  if [ -e "/usr/etc/goaccess/goaccess.conf" ]; then
    if [ ! -e "/root/.goaccessrc" ] || [ ! -e "/var/log/boa/.goaccessrc.fix.021.pid" ]; then
      echo 'date-format %d/%b/%Y' > /root/.goaccessrc
      echo 'time-format %H:%M:%S' >> /root/.goaccessrc
      echo 'log-format "~h{, }" %v [%d:%t %^] "%r" %s %^ %^ %b "%R" "%u" %T "%^"' >> /root/.goaccessrc
      echo '444-as-404 true' >> /root/.goaccessrc
      echo '4xx-to-unique-count false' >> /root/.goaccessrc
      echo 'agent-list false' >> /root/.goaccessrc
      echo 'all-static-files true' >> /root/.goaccessrc
      echo 'anonymize-ip true' >> /root/.goaccessrc
      echo 'browsers-file /usr/etc/goaccess/browsers.list' >> /root/.goaccessrc
      ### With --no-global-config nothing ever loaded the static-file
      ### extension registry, so goaccess classified NOTHING as static:
      ### theme css/js flooded the REQUESTS panel and valid_requests, which
      ### is exactly the noise that made the reports useless. Carry the
      ### registry inside the one config we do load; the ignore-statics
      ### directive below then keeps every classified static out of the
      ### request metrics.
      if grep -q "^static-file" /usr/etc/goaccess/goaccess.conf 2>/dev/null; then
        grep "^static-file" /usr/etc/goaccess/goaccess.conf >> /root/.goaccessrc
      else
        for _sfx in css js jpg jpeg png gif ico svg webp avif bmp tiff tif \
          woff woff2 ttf otf eot map pdf csv txt xml zip gz tgz rar tar xz \
          zst mp3 mp4 mpeg mpg ogg avi flv swf exe iso dmg doc docx xls \
          xlsx ppt pptx; do
          echo "static-file .${_sfx}" >> /root/.goaccessrc
        done
      fi
      echo 'double-decode true' >> /root/.goaccessrc
      echo 'enable-panel BROWSERS' >> /root/.goaccessrc
      echo 'enable-panel GEO_LOCATION' >> /root/.goaccessrc
      echo 'enable-panel HOSTS' >> /root/.goaccessrc
      echo 'enable-panel KEYPHRASES' >> /root/.goaccessrc
      echo 'enable-panel NOT_FOUND' >> /root/.goaccessrc
      echo 'enable-panel OS' >> /root/.goaccessrc
      echo 'enable-panel REFERRERS' >> /root/.goaccessrc
      echo 'enable-panel REFERRING_SITES' >> /root/.goaccessrc
      echo 'enable-panel REMOTE_USER' >> /root/.goaccessrc
      echo 'enable-panel REQUESTS' >> /root/.goaccessrc
      ### enable-panel is additive (every panel renders by default), so the
      ### static panel must be ignored explicitly -- with statics classified
      ### it holds nothing an operator reads and only re-adds the noise the
      ### registry above just removed from the request metrics.
      echo 'ignore-panel REQUESTS_STATIC' >> /root/.goaccessrc
      echo 'enable-panel STATUS_CODES' >> /root/.goaccessrc
      echo 'enable-panel VIRTUAL_HOSTS' >> /root/.goaccessrc
      echo 'enable-panel VISIT_TIMES' >> /root/.goaccessrc
      echo 'enable-panel VISITORS' >> /root/.goaccessrc
      echo 'exclude-ip 127.0.0.1' >> /root/.goaccessrc
      echo 'ignore-crawlers true' >> /root/.goaccessrc
      if [ ! -e "/usr/etc/goaccess/spammers.txt" ]; then
        ### curl ${_crlGet} "${_sPmrs}" -o /usr/etc/goaccess/spammers.txt
        curl ${_crlGet} "${_urlDev}/src/spammers.txt" -o /usr/etc/goaccess/spammers.txt
      fi
      if [ -e "/usr/etc/goaccess/spammers.txt" ]; then
        echo 'ignore-referrer /usr/etc/goaccess/spammers.txt' >> /root/.goaccessrc
      fi
      echo 'ignore-statics req' >> /root/.goaccessrc
      echo 'ignore-status 301' >> /root/.goaccessrc
      echo 'ignore-status 302' >> /root/.goaccessrc
      echo 'real-os true' >> /root/.goaccessrc
      echo 'sort-panel BROWSERS,BY_VISITORS,DESC' >> /root/.goaccessrc
      echo 'sort-panel GEO_LOCATION,BY_VISITORS,DESC' >> /root/.goaccessrc
      echo 'sort-panel HOSTS,BY_VISITORS,DESC' >> /root/.goaccessrc
      echo 'sort-panel OS,BY_VISITORS,DESC' >> /root/.goaccessrc
      echo 'sort-panel REFERRERS,BY_VISITORS,DESC' >> /root/.goaccessrc
      echo 'sort-panel REFERRING_SITES,BY_VISITORS,DESC' >> /root/.goaccessrc
      echo 'sort-panel REQUESTS,BY_VISITORS,DESC' >> /root/.goaccessrc
      if [ ! -e "/usr/share/GeoIP/GeoLite2-City.mmdb" ]; then
        _fetch_geoip
      fi
      if [ -e "/usr/share/GeoIP/GeoLite2-ASN.mmdb" ]; then
        echo 'geoip-database /usr/share/GeoIP/GeoLite2-ASN.mmdb' >> /root/.goaccessrc
      fi
      if [ -e "/usr/share/GeoIP/GeoLite2-City.mmdb" ]; then
        echo 'geoip-database /usr/share/GeoIP/GeoLite2-City.mmdb' >> /root/.goaccessrc
      fi
      if [ -e "/usr/share/GeoIP/GeoLite2-Country.mmdb" ]; then
        echo 'geoip-database /usr/share/GeoIP/GeoLite2-Country.mmdb' >> /root/.goaccessrc
      fi
      echo 'html-prefs {"theme":"darkBlue","perPage":10,"visitors":{"plot":{"chartType":"bar"}},"visit_time":{"plot":{"chartType":"bar"}}}' >> /root/.goaccessrc
      rm -f /var/log/boa/.goaccessrc.fix*
      touch /var/log/boa/.goaccessrc.fix.021.pid
      sleep 1
    fi
  else
    echo "ERROR: GoAccess was not found..."
    exit 1
  fi
}

###
### The AI report (_GOACCESS_AI_REPORT=YES): requests by the AI agent classes
### the vhosts act on, and visits referred by AI assistants, as plain text
### beside the GoAccess HTML, so the night copies both into the account.
### The classes come from the maps nginx loads, so the report counts what
### the box enforces: each map's regex lines are tried in order and the
### first match decides, an empty value keeping the agent out of that class.
###
_AI_REPORT=ai-visibility.txt
_AI_MAPS=/etc/nginx/conf.d/aegir.conf

_ai_report() {
  local _log="${1}"
  local _site="${2}"
  local _maps="${_AI_MAPS}"
  local _tab
  _tab="$(printf '\t')"
  [ -r "${_log}" ] || return 1
  [ -r "${_maps}" ] || _maps=/dev/null
  LC_ALL=C awk -v site="${_site}" -v mapf="${_maps}" '
    function classify(lua,   k, c, i) {
      agent = ""
      for (k = 1; k <= nchk; k++) {
        c = chk[k]
        for (i = 1; i <= np; i++) {
          if (pc[i] != c) continue
          if (match(lua, pp[i])) {
            if (!pv[i]) break
            agent = substr(ua, RSTART, RLENGTH)
            return c
          }
        }
      }
      return ""
    }
    function verdict(s) {
      if (s ~ /^2/ || s == "304") return "served"
      if (s == "401" || s == "403" || s == "429" || s == "444" || s == "503") return "refused"
      return "other"
    }
    function clip(s) {
      gsub(/\t/, " ", s)
      return (length(s) > 100) ? substr(s, 1, 97) "..." : s
    }
    function page(u,   i) {
      if (u == "") return "(no path)"
      i = index(u, "?")
      if (i) u = substr(u, 1, i - 1)
      return clip((all ? host : "") u)
    }
    function refhost(r,   h, i) {
      if (r == "" || r == "-") return ""
      h = tolower(r)
      sub(/^[a-z][a-z0-9+.-]*:\/\//, "", h)
      i = index(h, "/")
      if (i) h = substr(h, 1, i - 1)
      sub(/^[^@]*@/, "", h)
      sub(/:[0-9]*$/, "", h)
      return h
    }
    function utm(q,   s, i) {
      s = "&" tolower(q)
      i = index(s, "&utm_source=")
      if (!i) return ""
      s = substr(s, i + 12)
      i = index(s, "&")
      if (i) s = substr(s, 1, i - 1)
      return substr(s, 1, 60)
    }
    BEGIN {
      split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mn, " ")
      for (i = 1; i <= 12; i++) mon[mn[i]] = sprintf("%02d", i)
      nord = split("search user evasive training utility", ord, " ")
      for (i = 1; i <= nord; i++) rank[ord[i]] = i
      # The vhost guards refuse training and evasive agents before the
      # served classes are paced, so an agent two maps claim is counted
      # where it was refused.
      nchk = split("training evasive user search utility", chk, " ")
      all = (index(site, "ALL") > 0)
      site = tolower(site)
      aisrc = "[.](chatgpt[.]com|chat[.]openai[.]com|perplexity[.]ai|claude[.]ai|copilot[.]microsoft[.]com|gemini[.]google[.]com|chat[.]mistral[.]ai)$"
      aiutm = "^(chatgpt([.]com)?|openai|perplexity([.]ai)?|claude([.]ai)?|copilot([.]microsoft[.]com)?|gemini([.]google[.]com)?|mistral([.]ai)?)$"
      botre = "bot[-/;.) ]|robot|crawl|spider|slurp|preview|scan|probe|monitor|fetch|feed|reader|curl|wget|python|go-http|libwww|httpclient|java/|okhttp|headless|lighthouse|pingdom|uptime|validator|archive|facebookexternalhit|whatsapp|mastodon|http[.]rb|axios|guzzle|faraday|dalvik|node([.]js|js|/)|rss-parser|barkrowler|research|auditor|on-behalf-of|drupal [(]"
      assetre = "[.](css|js|mjs|map|jpe?g|png|gif|ico|svg|webp|avif|bmp|tiff?|woff2?|ttf|otf|eot|mp3|mp4|m4a|webm|ogg|wav)$"
    }
    FILENAME == mapf {
      if ($1 == "map" && $2 == "$http_user_agent" \
        && $3 ~ /^[$]is_ai_(training|search|user|evasive|utility)$/) {
        cur = substr($3, 8)
        inmap = 1
        nmaps++
        next
      }
      if (!inmap) next
      if ($1 == "}") { inmap = 0; next }
      if (NF == 0 || $1 == "default" || $1 ~ /^#/) next
      # Only case-blind regex keys made of plain tokens read the same in
      # awk as in nginx; any other key is reported, never guessed at.
      if ($1 !~ /^~[*]/ || substr($1, 3) !~ /^[A-Za-z0-9_.|?()-]+$/) {
        skipped++
        next
      }
      val = $2
      sub(/;.*/, "", val)
      np++
      pc[np] = cur
      pp[np] = tolower(substr($1, 3))
      pv[np] = (val != "" && val != "\047\047" && val != "\"\"")
      next
    }
    {
      if (!ready) {
        anyre = ""
        for (i = 1; i <= np; i++) anyre = anyre (i > 1 ? "|" : "") pp[i]
        ready = 1
      }
      if (split($0, f, "\"") < 9) next
      if (split(f[3], hs, " ") < 2) next
      host = tolower(hs[1])
      if (!all && host != site) next
      ts = hs[2]
      mo = substr(ts, 5, 3)
      if (length(ts) < 21 || !(mo in mon)) next
      dk = substr(ts, 9, 4) mon[mo] substr(ts, 2, 2)
      if (first == "" || dk < first) first = dk
      if (last == "" || dk > last) last = dk
      # Over HTTPS through the front proxy one request is logged twice: by
      # the site vhost from 127.0.0.1, then by the front with the visitor.
      # A request the site refuses with 444 reaches the front as a closed
      # connection and is logged there as 502, a moment after the site
      # line, so a site 444 is kept for its own clock minute and the next.
      mnum = substr(ts, 14, 2) * 60 + substr(ts, 17, 2)
      if (dk != cdk || mnum != cmnum) {
        if (dk == cdk && mnum == cmnum + 1) {
          if (cg) { split("", in0); cg = 0 } else { split("", in1); cg = 1 }
        } else {
          split("", in0)
          split("", in1)
        }
        cdk = dk
        cmnum = mnum
      }
      # The two lines of one request differ in protocol (the front speaks
      # HTTP/2 or 3 to the visitor, HTTP/1.1 to the site), so they pair on
      # the method and the path.
      nrq = split(f[4], rq, " ")
      rk = rq[1] " " rq[2]
      ua = f[8]
      split(f[5], st, " ")
      status = st[1]
      loop = (f[2] == "127.0.0.1" || f[2] == "::1")
      lua = tolower(ua)
      cls = ""
      if (anyre != "" && lua ~ anyre) cls = classify(lua)
      if (cls != "") {
        pk = host SUBSEP rk SUBSEP agent
        if (loop) {
          if (status == "444") { if (cg) in1[pk] = 1; else in0[pk] = 1 }
          next
        }
        v = verdict(status)
        if (status == "502" && ((pk in in0) || (pk in in1))) v = "refused"
        act[dk] = 1
        dc[dk, cls]++
        tot[cls]++
        tv[cls, v]++
        ak = agent SUBSEP cls
        an[ak]++
        av[ak, v]++
        pg[cls, page(rq[2])]++
        next
      }
      if (loop) next
      if (nrq < 2 || rq[1] != "GET") next
      if (status != "200" && status != "304") next
      if ((lua " ") ~ botre) next
      uri = rq[2]
      q = ""
      i = index(uri, "?")
      if (i) { q = substr(uri, i + 1); uri = substr(uri, 1, i - 1) }
      if (tolower(uri) ~ assetre) next
      rh = refhost(f[6])
      src = ""
      if (rh != "") {
        if (("." rh) ~ aisrc) src = rh
      } else if (q != "") {
        u = utm(q)
        if (u != "" && u ~ aiutm) src = "utm_source=" u
      }
      if (src == "") next
      act[dk] = 1
      rd[dk]++
      rtot++
      rs[clip(src)]++
      rl[clip((all ? host : "") uri)]++
    }
    END {
      printf "0hdr\t0\t%s\t%s\t%d\t%d\t%d\n", first, last, nmaps, np, skipped
      for (k = 1; k <= nord; k++) {
        c = ord[k]
        printf "1tot\t%d\t%s\t%d\t%d\t%d\t%d\n", 9 - k, c, tot[c], \
          tv[c, "served"], tv[c, "refused"], tv[c, "other"]
      }
      printf "1tot\t0\treferred\t%d\n", rtot
      for (d in act) {
        printf "2day\t%s\t%s-%s-%s", d, substr(d, 1, 4), substr(d, 5, 2), substr(d, 7, 2)
        for (k = 1; k <= nord; k++) printf "\t%d", dc[d, ord[k]]
        printf "\t%d\n", rd[d]
      }
      for (x in an) {
        split(x, a, SUBSEP)
        printf "3agt\t%d\t%s\t%s\t%d\t%d\t%d\n", an[x], a[1], a[2], \
          av[x, "served"], av[x, "refused"], av[x, "other"]
      }
      for (x in pg) {
        split(x, a, SUBSEP)
        printf "4p%d\t%d\t%s\n", rank[a[1]], pg[x], a[2]
      }
      for (x in rs) printf "5src\t%d\t%s\n", rs[x], x
      for (x in rl) printf "6lnd\t%d\t%s\n", rl[x], x
    }
  ' "${_maps}" "${_log}" \
    | LC_ALL=C sort -t "${_tab}" -k1,1 -k2,2nr -k3,3 \
    | LC_ALL=C awk -F "${_tab}" -v site="${_site}" \
      -v built="$(date '+%Y-%m-%d %H:%M %Z')" '
    function day(d) {
      return substr(d, 1, 4) "-" substr(d, 5, 2) "-" substr(d, 7, 2)
    }
    BEGIN {
      lab["search"] = "Search / index"
      lab["user"] = "Assistant"
      lab["evasive"] = "Evasive assistant"
      lab["training"] = "Training"
      lab["utility"] = "Utility"
      split("Search / index,Assistant,Evasive assistant,Training,Utility", pl, ",")
      all = (index(site, "ALL") > 0)
    }
    $1 == "0hdr" {
      hdr = 1
      printf "AI agents and AI-referred visits: %s\n", (all ? "all sites on this server" : site)
      if ($3 == "") {
        printf "Built %s. The access logs hold no requests for it.\n", built
      } else {
        printf "Built %s from this server'\''s access logs, %s to %s.\n", built, day($3), day($4)
      }
      print ""
      print "Served: the page or file was sent. Refused: the server turned the request"
      print "away (a class blocked by default, or the site'\''s line in policy.txt)."
      print "Other: redirects, missing pages and errors. Referred visits are page views"
      print "that came from an AI assistant'\''s site or a link tagged utm_source with an"
      print "assistant'\''s name. A fetch is not a citation, and an agent that hides what"
      print "it is cannot be counted."
      if ($5 == 0) {
        print ""
        print "This server'\''s web configuration lists no AI agent classes, so only"
        print "referred visits are counted."
      } else if ($7 > 0) {
        print ""
        printf "%d agent pattern(s) in the web configuration could not be read here\n", $7
        print "and their requests are not counted."
      }
      next
    }
    $1 == "1tot" && $3 == "referred" {
      printf "\nVisits referred by AI assistants: %d\n", $4
      next
    }
    $1 == "1tot" {
      if (!th) {
        printf "\n%-20s %9s %9s %9s %9s\n", "Class", "Requests", "Served", "Refused", "Other"
        th = 1
      }
      printf "%-20s %9d %9d %9d %9d\n", lab[$3], $4, $5, $6, $7
      next
    }
    $1 == "2day" {
      if (!dh) {
        print "\nPer day, newest first"
        printf "%-11s %8s %9s %8s %9s %8s %9s\n", "Day", "Search", "Assistant", "Evasive", \
          "Training", "Utility", "Referred"
        dh = 1
      }
      if (++dn > 62) {
        if (dn == 63) print "(older days left out)"
        next
      }
      printf "%-11s %8d %9d %8d %9d %8d %9d\n", $3, $4, $5, $6, $7, $8, $9
      next
    }
    $1 == "3agt" {
      if (!ah) {
        print "\nAgents"
        printf "%-26s %-18s %9s %9s %9s %9s\n", "Agent", "Class", "Requests", "Served", \
          "Refused", "Other"
        ah = 1
      }
      printf "%-26s %-18s %9d %9d %9d %9d\n", substr($3, 1, 26), lab[$4], $2, $5, $6, $7
      next
    }
    $1 ~ /^4p[1-5]$/ {
      k = substr($1, 3)
      if (k != pk) {
        printf "\nMost requested by %s agents\n", pl[k]
        pk = k
        pn = 0
      }
      if (++pn <= 10) printf "%9d  %s\n", $2, $3
      next
    }
    $1 == "5src" {
      if (!sh) { print "\nReferred visits by source"; sh = 1 }
      printf "%9d  %s\n", $2, $3
      next
    }
    $1 == "6lnd" {
      if (!lh) { print "\nPages the referred visits landed on"; lh = 1 }
      if (++ln <= 10) printf "%9d  %s\n", $2, $3
      next
    }
    END {
      if (!hdr) exit 1
    }
  '
}

_if_install

for i in "$@"; do
  case $i in
    -s=*|--site=*)
        _SITE="${i#*=}"
        shift # --site=SiteName
    ;;
    -e=*|--env=*)
        _ENV="${i#*=}"
        shift # --env=[dev|stage|prod]
    ;;
    -u=*|--url=*)
        _URL="${i#*=}"
        shift # --url=https://site-d9.foo.bar.aegir.cc/
    ;;
    -d=*|--dir=*)
        _DIR="${i#*=}"
        shift # --dir=foo/bar
    ;;
    -c=*|--ga_conf=*)
        _GACONF="${i#*=}"
        shift # --ga_conf=/etc/goaccess.conf
    ;;
    *)
        # nope
    ;;
  esac
done

if [ -z "${_URL}" ]; then
  if [ -z "${_SITE}" ] && [ -z "${_ENV}" ]; then
    echo "[-] --site and --env must be specified"
    exit 1;
  fi
else
  _SITE=${_URL%.aegir.cc}
  _SITE=${_SITE%.aegir.cc}
  _SITE=${_SITE#dev-}
  _SITE=${_SITE#stage-}
  _SITE=${_SITE#prod-}
  _ENV="$( cut -d '-' -f 1 <<< "${_URL}" )"
fi

echo "[+] _SITE NAME: ${_SITE} / _ENV: ${_ENV}"

if [ -z "${_ARCH}" ]; then
  _ARCHLOGS=/var/www/adminer/access/archive
  mkdir -p ${_ARCHLOGS}/unzip
else
  _ARCHLOGS=${_ARCH}
  mkdir -p ${_ARCH}/unzip
fi

if [ -z "${_DIR}" ]; then
  mkdir -p /var/www/adminer/access/${_ENV}/${_SITE}
  _TARGET=/var/www/adminer/access/${_ENV}/${_SITE}
else
  mkdir -p ${_DIR}
  _TARGET=${_DIR}
fi

if [ ! -e "${_ARCHLOGS}/unzip/.global.pid" ]; then
  echo "[+] SYNCING LOGS TO: ${_ARCHLOGS}"
  rsync -rlvz --size-only --progress /var/log/nginx/access* ${_ARCHLOGS}/
  echo "[+] COPYING LOGS TO: ${_ARCHLOGS}/unzip/"
  cp -af ${_ARCHLOGS}/access* ${_ARCHLOGS}/unzip/
  echo "[+] DECOMPRESSING GZ FILES"
  find ${_ARCHLOGS}/unzip -name "*.gz" -exec gunzip -f {} \;
  echo "[+] RENAMING RAW FILES"
  ### Exclude already-renamed .txt files: renaming them again would move a
  ### just-refreshed access.log.N.txt (the fresh rename lands earlier in the
  ### sorted list) to .txt.txt, which the sweep below then deletes -- a
  ### re-prepare over a previous run's corpus emptied the whole set on every
  ### second call. Excluding .txt makes re-preparation idempotent: fresh
  ### renames simply overwrite the previous corpus.
  for _log in `find ${_ARCHLOGS}/unzip \
    -maxdepth 1 -mindepth 1 -type f ! -name '*.txt' | sort`; do
    mv -f ${_log} ${_log}.txt;
  done
  if [ -e "${_ARCHLOGS}/unzip/.global.pid.txt" ]; then
    mv -f ${_ARCHLOGS}/unzip/.global.pid.txt ${_ARCHLOGS}/unzip/.global.pid
  fi
  rm -f ${_ARCHLOGS}/unzip/*.txt.txt*
fi

echo "[+] MERGING AND FILTERING NGINX LOGS"
if [ -e "${_TARGET}/mrgd_nginx.log" ]; then
  rm -rf ${_TARGET}/mrgd_nginx.log
fi

if [[ "${_SITE}" =~ "ALL" ]]; then
  _SITE_REGEX=" /"
else
  _SITE_REGEX=" ${_SITE} "
fi

### -a is load-bearing: one NUL byte anywhere in the concatenated corpus flips
### grep into binary mode, which silently truncates the merged log and produces
### an empty report.
find ${_ARCHLOGS}/unzip -name "access*" -exec cat {} \; | grep -a "${_SITE_REGEX}" >> ${_TARGET}/mrgd_nginx.log

echo "[+] EXPORTING GOACCESS REPORT HTML"
_GOVER=$(goaccess -V | awk 'NR == 1 { print substr ($3,0,1)}')

### Operator-owned exclusions (own workstation/monitoring addresses) so reports
### show real visitor traffic; space-separated IPv4/IPv6 addresses or
### dash-ranges (1.2.3.4-1.2.3.9) in _GOACCESS_EXCLUDE_IPS (/root/.barracuda.cnf,
### sourced above). CLI -e entries merge with the exclude-ip list already
### present in /root/.goaccessrc. CIDR is refused here because goaccess
### silently ignores slash notation -- a filter that looks armed but is not.
_xIps=()
for _xIp in ${_GOACCESS_EXCLUDE_IPS}; do
  [[ "${_xIp}" =~ ^[0-9a-fA-F.:-]+$ ]] && _xIps+=("-e" "${_xIp}")
done

[[ ${_GACONF} ]] && conf=(-p "${_GACONF}")
if [[ ${_GOVER} = 1 ]]; then
  goaccess -p /root/.goaccessrc --no-global-config --persist --no-query-string -f "${_TARGET}/mrgd_nginx.log" "${conf[@]}" "${_xIps[@]}" -a -o "${_TARGET}/index.html"
else
  goaccess -p /root/.goaccessrc --no-global-config --persist --no-query-string -f "${_TARGET}/mrgd_nginx.log" "${conf[@]}" "${_xIps[@]}" > "${_TARGET}/index.html"
fi

### Written whole or not at all, and withdrawn when switched off, so the
### night never copies a stale or half-written report into the account.
if [ "${_GOACCESS_AI_REPORT}" = "YES" ]; then
  echo "[+] WRITING THE AI AGENTS REPORT"
  if _ai_report "${_TARGET}/mrgd_nginx.log" "${_SITE}" \
    > "${_TARGET}/.${_AI_REPORT}.new"; then
    mv -f "${_TARGET}/.${_AI_REPORT}.new" "${_TARGET}/${_AI_REPORT}"
  else
    echo "[-] The AI agents report could not be built"
    rm -f "${_TARGET}/${_AI_REPORT}"
  fi
  rm -f "${_TARGET}/.${_AI_REPORT}.new"
else
  rm -f "${_TARGET}/${_AI_REPORT}"
fi

if [ -e "${_TARGET}/mrgd_nginx.log" ]; then
  rm -rf ${_TARGET}/mrgd_nginx.log
fi

echo ${_TARGET}/index.html
echo "[+] DONE!"
exit 0
