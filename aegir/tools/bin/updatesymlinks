#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_logDir=/var/log/boa
_actionTemporaryLog="${_logDir}/autosymlink.tmp.log"
_actionPermanentLog="${_logDir}/autosymlink.update.log"
_actionVerboseArchiveLog="${_logDir}/autosymlink.verbose.archive.log"
_stateFile="${_logDir}/autosymlink.state"
_nightStamp="${_logDir}/autosymlink.nightok.stamp"
_autoBin=/opt/local/bin/autosymlink
# Self-healing task-queue stop file (records our PID): runner.sh honours it (parent exit
# + per-child skip), clear.sh purges a leaked one by PID-liveness, and /run clears on
# reboot — so it can never freeze the queue. Replaces the old .pause_tasks_maint.cnf
# pause, which was NOT self-healing (a leaked one also made clear.sh exit early).
_queueStop=/run/boa_queue_stop.pid

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    chmod a+w /dev/null
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

# Run only on fully installed system
[ ! -e "/var/log/boa/reset_no_new_password.pid" ] && exit 0

# Sub-mode selection (cron entry points). Bare invocation keeps the legacy
# full apply+report behaviour for manual use (ungated).
#   --auto-fix       : nightly global symlinks auto-fix (apply + report),
#                      gated by _AUTOSYMLINK_NIGHTLY=YES. Pauses tasks.
#   --orphan-report  : daily read-only orphan/ghost files-dir report,
#                      gated by _ORPHAN_FILES_REPORT=YES. Never pauses tasks.
_subMode="legacy"
case "$1" in
  --auto-fix|auto-fix)            _subMode="auto-fix" ;;
  --orphan-report|orphan-report)  _subMode="orphan-report" ;;
esac

# Opt-in gates default OFF on already-installed boxes whose /root/.barracuda.cnf
# predates these vars (the template only seeds them for fresh installs).
: "${_AUTOSYMLINK_NIGHTLY:=NO}"
: "${_ORPHAN_FILES_REPORT:=NO}"

# Fixed grace (seconds) held after pausing the queue, before draining any in-flight
# task, so a runner.sh that was already mid-dispatch when we paused cannot slip a
# provision task into our window. Overridable from /root/.barracuda.cnf (3–5 min band).
: "${_AUTOSYMLINK_PAUSE_GRACE:=240}"

# Tracks whether THIS process created the queue-stop file, so the EXIT trap never tears
# down a pause window opened by a concurrent maintenance op.
_stopOwned="NO"

_log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> ${_actionPermanentLog}
}

###
### Atomic lock/unlock to prevent TOCTOU race
###
_manage_single_lock() {
  _SELF_NAME="${_SELF_NAME:-$(basename "$0")}"
  for _L in "/opt/local/bin/lock.inc" "/opt/local/lib/lock.inc"; do
    [ -r "${_L}" ] && . "${_L}" && break
  done
  if [ -n "${_SINGLE_INSTANCE_LIB_VER:-}" ] && command -v _single_instance_lock >/dev/null 2>&1; then
    # use shared lock if available
    _single_instance_lock
  else
    # -------- legacy pgrep guard ---------
    # Exit if more than 2 instances of this script are running
    _SCRIPT=$(basename "$0")
    _CNT=$(pgrep -fc ${_SCRIPT})
    if (( _CNT > 2 )); then
      echo "Too many ${_SCRIPT} running $(date) (count=${_CNT})" >> /var/log/boa/too.many.log
      exit 0
    fi
  fi
}
_manage_single_lock
trap '_clean_lock' EXIT INT TERM

_clean_lock() {
  # Release the task-queue stop file only if THIS process created it and still owns it
  # (verify the recorded PID), so a concurrent maintenance op's pause is never torn
  # down. It is self-healing anyway (clear.sh purges a dead owner).
  if [ "${_stopOwned}" = "YES" ] && [ -e "${_queueStop}" ] \
    && [ "$(tr -dc '0-9' < "${_queueStop}" 2>/dev/null)" = "$$" ]; then
    rm -f "${_queueStop}"
  fi
  if command -v _single_instance_unlock >/dev/null 2>&1; then
    # Pass the fd/path recorded by _single_instance_lock explicitly; an argless call
    # left _FD empty and tripped "_FD: ambiguous redirect" on the exec {_FD}>&- close.
    _single_instance_unlock "${_LOCK_FD:-}" "${_LOCK_PATH:-}"
  fi
  [ -n "${_lockDir:-}" ] && [ -d "${_lockDir}" ] && rm -rf "${_lockDir}"
}

_action_email_report() {
  if [ -n "${_MY_EMAIL}" ] && [ "${_actionReport}" = "TRUE" ]; then
    _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
    _log "INFO: Sending AutoSymlink Report Email (${1})"
    s-nail -s "AutoSymlink Actions Report: ${1} on ${_hName} at $(date)" "${_MY_EMAIL}" < ${_actionPermanentLog}
    s-nail -s "AutoSymlink Details Report: ${1} on ${_hName} at $(date)" "${_MY_EMAIL}" < ${_actionTemporaryLog}
  fi
}

_is_protected_run() {
  _protectedRun=FALSE
  _optBin="/opt/local/bin"
  _boaBins="autosymlink autoupboa barracuda boa octopus"

  for _cbn in ${_boaBins}; do
    if [ -e "${_optBin}/${_cbn}" ]; then
      _CNT=$(pgrep -fc /local/bin/${_cbn})
      if (( _CNT > 0 )); then
        _log "The ${_cbn} is running!"
        _protectedRun=TRUE
      fi
    fi
  done

  [ -e "/run/octopus_install_run.pid" ] && _protectedRun=TRUE
  [ -e "/run/boa_run.pid" ] && _protectedRun=TRUE
  [ -e "/run/boa_wait.pid" ] && _protectedRun=TRUE
  [ -e "/run/max_load.pid" ] && _protectedRun=TRUE
  [ -e "/run/critical_load.pid" ] && _protectedRun=TRUE

  _IS_PROVISION_RUNNING=$(pgrep -fc provision)
  if (( _IS_PROVISION_RUNNING > 0 )); then
    _protectedRun=TRUE
  fi
  _IS_DUPLICITY_RUNNING=$(pgrep -fc duplicity)
  if (( _IS_DUPLICITY_RUNNING > 0 )); then
    _protectedRun=TRUE
  fi
}

_read_state_var() {
  _key="$1"
  if [ -e "${_stateFile}" ]; then
    grep "^${_key}=" "${_stateFile}" 2>/dev/null | head -n 1 | cut -d= -f2-
  fi
}

_provision_running() {
  pgrep -f provision >/dev/null 2>&1
}

# Stable per-night id so the hourly retry stamps success once and no-ops for the rest of
# the night. The attempt window sits in [22:00,06:00); shifting back 12h collapses the
# whole window (evening + the early hours past midnight) onto one noon-anchored date.
_night_id() {
  date --date '12 hours ago' '+%Y-%m-%d' 2>/dev/null
}

# Pause the Aegir task queue and drain any in-flight provision task before touching
# symlinks. Sets the self-healing stop file (records our PID), holds a fixed grace so a
# runner already mid-dispatch cannot fire a task after we paused, then bounded-drains
# pgrep provision. Returns 0 when quiescent (safe to convert), 1 if a task is still
# active after the grace+drain (caller must NOT apply; the hourly retry tries again).
_pause_and_drain() {
  if [ ! -e "${_queueStop}" ]; then
    echo "$$" > "${_queueStop}" 2>/dev/null && _stopOwned="YES"
  fi
  _log "INFO: Aegir queue paused (${_queueStop}); grace ${_AUTOSYMLINK_PAUSE_GRACE}s, then drain"
  sleep "${_AUTOSYMLINK_PAUSE_GRACE}"
  _drain=0
  while _provision_running && [ "${_drain}" -lt 12 ]; do
    sleep 5
    _drain=$(( _drain + 1 ))
  done
  if _provision_running; then
    _log "INFO: provision task still active after grace+drain; not applying this run"
    return 1
  fi
  return 0
}

_autosymlink_run() {
  _actionReport=FALSE
  _orphansFound=FALSE
  _applyCount=0
  _lastAction=NO

  [ -d "${_logDir}" ] || mkdir -p "${_logDir}"
  : > ${_actionTemporaryLog}

  if [ ! -x "${_autoBin}" ]; then
    _log "ERROR: Missing autosymlink: ${_autoBin}"
    return 1
  fi

  # Pause the Aegir queue with the self-healing stop file, hold a fixed grace so a
  # runner already mid-dispatch cannot slip a task in, drain any in-flight task, then
  # re-check protection before converting anything. A still-active task means "blocked":
  # bail with rc 2 so the caller does NOT stamp the night and the hourly retry tries again.
  if ! _pause_and_drain; then
    return 2
  fi
  _is_protected_run
  if [ "${_protectedRun}" = "TRUE" ]; then
    _log "INFO: Protected run detected after pausing tasks; not applying this run."
    return 2
  fi

  # Cron-safe: DRY -> if CLEAN -> BATCH in one run
  _log "INFO: Running autosymlink --batch-if-clean"
  ${_autoBin} --batch-if-clean > ${_actionTemporaryLog} 2>&1
  _rcBatch="$?"

  _lastStatus="$(_read_state_var "_LAST_STATUS")"
  _lastAction="$(_read_state_var "_LAST_ACTION")"
  _applyCount="$(_read_state_var "_LAST_APPLY_COUNT")"
  [ -z "${_applyCount}" ] && _applyCount="0"

  if [ "${_rcBatch}" -eq 0 ]; then
    if [ "${_lastAction}" = "YES" ] && [ "${_applyCount}" -gt 0 ]; then
      _actionReport=TRUE
      _subject="APPLIED (${_applyCount} changes)"
    else
      # No action taken -> never email
      _subject=""
    fi
  elif [ "${_rcBatch}" -eq 10 ]; then
    _actionReport=TRUE
    _subject="NOT CLEAN (manual review required)"
  else
    _actionReport=TRUE
    _subject="FAILED (rc=${_rcBatch})"
  fi

  # Always run report; email if ORPHANS detected
  _log "INFO: Running autosymlink --report"
  ${_autoBin} --report >> ${_actionTemporaryLog} 2>&1
  _rcReport="$?"

  if grep -q "\[REPORT\] ORPHAN" ${_actionTemporaryLog} 2>/dev/null; then
    _orphansFound="TRUE"
    _actionReport=TRUE
    if [ -z "${_subject}" ]; then
      _subject="ORPHANS detected"
    else
      _subject="${_subject} + ORPHANS"
    fi
  fi

  if [ "${_rcReport}" -ne 0 ]; then
    _actionReport=TRUE
    if [ -z "${_subject}" ]; then
      _subject="FAILED report (rc=${_rcReport})"
    else
      _subject="${_subject} + report rc=${_rcReport}"
    fi
  fi

  # Archive the full temporary log (verbose), so details are preserved even if email delivery fails.
  {
    echo "===== $(date '+%Y-%m-%d %H:%M:%S') autosymlink run (batch_rc=${_rcBatch}, report_rc=${_rcReport}) subject=${_subject} ====="
    cat ${_actionTemporaryLog}
    echo
  } >> ${_actionVerboseArchiveLog}

  if [ "${_actionReport}" = "TRUE" ] && [ -n "${_subject}" ]; then
    _action_email_report "${_subject}"
    echo >> ${_actionPermanentLog}
  fi

  return 0
}

_orphan_report_run() {
  # Daily read-only orphan/ghost files-dir report. Runs autosymlink --report
  # only (no apply, no task-pause), and emails _MY_EMAIL ONLY when orphans are
  # detected (or a hard report failure). Never converts and never deletes.
  _actionReport=FALSE
  _orphansFound=FALSE
  _subject=""

  [ -d "${_logDir}" ] || mkdir -p "${_logDir}"
  : > ${_actionTemporaryLog}

  if [ ! -x "${_autoBin}" ]; then
    _log "ERROR: Missing autosymlink: ${_autoBin}"
    return 1
  fi

  # Read-only: deliberately do NOT touch the task-pause file, so a concurrent
  # apply pass (if any) keeps its own pause window.
  _log "INFO: Running autosymlink --report (orphan check)"
  ${_autoBin} --report > ${_actionTemporaryLog} 2>&1
  _rcReport="$?"

  if grep -q "\[REPORT\] ORPHAN" ${_actionTemporaryLog} 2>/dev/null; then
    _orphansFound="TRUE"
    _actionReport=TRUE
    _subject="ORPHANS detected"
  fi

  if [ "${_rcReport}" -ne 0 ]; then
    _actionReport=TRUE
    if [ -z "${_subject}" ]; then
      _subject="FAILED report (rc=${_rcReport})"
    else
      _subject="${_subject} + report rc=${_rcReport}"
    fi
  fi

  # Archive the verbose output so details survive even if email delivery fails.
  {
    echo "===== $(date '+%Y-%m-%d %H:%M:%S') autosymlink orphan-report run (report_rc=${_rcReport}) subject=${_subject} ====="
    cat ${_actionTemporaryLog}
    echo
  } >> ${_actionVerboseArchiveLog}

  if [ "${_actionReport}" = "TRUE" ] && [ -n "${_subject}" ]; then
    _action_email_report "${_subject}"
    echo >> ${_actionPermanentLog}
  fi

  return 0
}

case "${_subMode}" in
  orphan-report)
    # Daily ~06:00 ghost/orphan report, opt-in.
    if [ "${_ORPHAN_FILES_REPORT}" != "YES" ]; then
      exit 0
    fi
    _orphan_report_run
    exit 0
    ;;
  auto-fix)
    # Nightly files-symlink maintenance, opt-in. Fired hourly through the night; the first
    # un-blocked hour does the work, stamps the night, and every later hour that night is a
    # cheap no-op. A blocked hour (heavy task running) just retries next. This one schedule
    # serves BOTH independent opt-ins: _AUTOSYMLINK_NIGHTLY runs the full pause+two-step
    # (which already folds in the orphan report); with only _ORPHAN_FILES_REPORT set it runs
    # the read-only orphan report alone (no pause). So NIGHTLY=NO + ORPHAN=YES still reports.
    if [ "${_AUTOSYMLINK_NIGHTLY}" != "YES" ] && [ "${_ORPHAN_FILES_REPORT}" != "YES" ]; then
      exit 0
    fi
    _thisNight="$(_night_id)"
    if [ -n "${_thisNight}" ] \
      && [ "$(cat "${_nightStamp}" 2>/dev/null)" = "${_thisNight}" ]; then
      # Already completed for this night.
      exit 0
    fi
    _is_protected_run
    if [ "${_protectedRun}" = "TRUE" ]; then
      # A heavy task (backup/upgrade/provision/load) is running — retry next hour.
      exit 0
    fi
    if [ "${_AUTOSYMLINK_NIGHTLY}" = "YES" ]; then
      _autosymlink_run    # pause + drain + two-step, with the orphan report folded in
    else
      _orphan_report_run  # _ORPHAN_FILES_REPORT=YES only: read-only orphan report, no pause
    fi
    _rcRun="$?"
    # Stamp only when the work actually ran (rc 0); rc 2 = blocked, so leave the night
    # un-stamped and let the next hourly window try again.
    if [ "${_rcRun}" -eq 0 ] && [ -n "${_thisNight}" ]; then
      echo "${_thisNight}" > "${_nightStamp}" 2>/dev/null
      _log "INFO: Nightly files-symlink maintenance completed for night ${_thisNight}; no more attempts until next night."
    fi
    exit 0
    ;;
  *)
    # Legacy bare invocation: full apply + report for manual use (ungated).
    _is_protected_run
    if [ "${_protectedRun}" = "TRUE" ]; then
      exit 0
    fi
    _autosymlink_run
    exit 0
    ;;
esac
