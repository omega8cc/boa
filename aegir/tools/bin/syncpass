#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_NOW=$(date +%y%m%d-%H%M%S)
_NOW=${_NOW//[^0-9-]/}
_vBs="/var/backups"
_RDB_DIR="/var/backups/boa/remote-db"
_THIS_DB_PORT=3306
_crlGet="-L --max-redirs 3 -s --fail --retry 9 --retry-delay 9 -A iCab"
_wgetGet="--max-redirect=3 -q --tries=9 --wait=9 --user-agent='iCab'"

_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

# An account owns /data/disk/<oN> (and the backend user /var/aegir), so any
# name there can be a link or a FIFO, and any directory on the way can itself
# be a link. Root reads and writes the pass files and the server aliases only
# through the helpers below; the first three are the helper.sh.inc bodies
# (this tool never sources that file).
#
# Run "$@" inside the real directory $1, never one reached through a link an
# account planted on the way. Below /home and /data/disk (root's) every name
# on the path must be a real directory; elsewhere the last name is checked
# against its resolved parent. Once entered, ./name stays in that directory
# whatever is swapped.
_acct_in_real_dir() {
  local _d="${1}" _a="" _want
  shift
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
  esac
  if [ -n "${_a}" ]; then
    _want="$(cd -P -- "${_a}" 2> /dev/null && /bin/pwd -P)${_d#"${_a}"}"
  else
    _want="$(cd -P -- "${_d%/*}" 2> /dev/null && /bin/pwd -P)/${_d##*/}"
  fi
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_want}" ] && "$@" )
}
# ./$1 in the current (pinned) directory: never through a link, never blocked
# on a FIFO, at most 1 MiB. Empty for anything else.
_acct_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2> /dev/null
}
# $2 in the real directory $1, read as _acct_read_here reads it.
_acct_read_in() {
  _acct_in_real_dir "${1}" _acct_read_here "${2}"
}
# stdin as ./$1 in the current (pinned) directory: a fresh 0600 file handed
# to $2 (owner:group) and renamed over the name, so a link or a FIFO put at
# the name is replaced, never followed or opened. The temp is created,
# written, owned and moded through one handle, as _acct_put_same_here puts
# a file (_ACCT_PUT_PL), never chowned by name in a directory the account
# can write.
_put_secret_here() {
  local _t="./.${1}.put.$$.${RANDOM}" _uid _gid
  _uid=$(id -u -- "${2%%:*}" 2> /dev/null)
  _gid=$(getent group "${2#*:}" 2> /dev/null | cut -d: -f3)
  [[ "${_uid}" =~ ^[0-9]+$ && "${_gid}" =~ ^[0-9]+$ ]] || return 1
  rm -f -- "${_t}"
  if perl -e "${_ACCT_PUT_PL}" "${_t}" "${_uid}" "${_gid}" 600 \
    && mv -f -T -- "${_t}" "./${1}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# The password in _ESC_PASS put as _L_SYS, a fresh 0600 file handed to
# _L_SYS_OWN (_put_secret_here). The run stops here when it cannot be, before
# any database account changes.
_put_pass() {
  printf '%s\n' "${_ESC_PASS}" \
    | _acct_in_real_dir "${_L_SYS%/*}" _put_secret_here "${_L_SYS##*/}" \
      "${_L_SYS_OWN}" && return 0
  echo "ERROR: Could not write ${_L_SYS}"
  exit 1
}
# The account's PHP password file with the password in _ESC_PASS, put in the
# account root as a fresh 0600 file handed to the account (_put_secret_here),
# never written, handed over or given a mode through a link put at the name.
# The database host as the install path writes it: FQDN becomes the box's
# own name, PROXYSQL the local proxy address; any other value is written as
# it is.
_put_pass_php() {
  _OCT_DB_HOST_W="${_THIS_DB_HOST}"
  if [ "${_THIS_DB_HOST}" = "FQDN" ]; then
    _OCT_DB_HOST_W="${_hName}"
  elif [ "${_THIS_DB_HOST}" = "PROXYSQL" ]; then
    _OCT_DB_HOST_W=127.0.0.1
  fi
  { echo "<?php"
    echo "\$oct_db_user = \"${_uname}\";"
    echo "\$oct_db_pass = \"${_ESC_PASS}\";"
    echo "\$oct_db_host = \"${_OCT_DB_HOST_W}\";"
    echo "\$oct_db_port = \"${_THIS_DB_PORT}\";"
    echo "\$oct_db_dirs = \"/data/disk/${_uname}/backups\";"
  } | _acct_in_real_dir "/data/disk/${_uname}" _put_secret_here \
    ".${_uname}.pass.php" "${_uname}:${_grp}"
}
# The alias ./$2 of the real directory $1 kept as the root copy $3, as cp kept
# it (the same bytes and read/write bits, root's): read bounded, never through
# a link or from a FIFO, so only a regular file is copied.
_keep_alias_copy() {
  local _st _typ _mod _sz _c
  _st=$(_acct_in_real_dir "${1}" stat -c '%F|%a|%s' -- "./${2}" 2> /dev/null) \
    || return 1
  IFS='|' read -r _typ _mod _sz <<< "${_st}"
  case "${_typ}" in
    "regular file"|"regular empty file") ;;
    *) return 1 ;;
  esac
  [[ "${_mod}" =~ ^[0-7]+$ && "${_sz}" =~ ^[0-9]+$ ]] || return 1
  [ "${_sz}" -le 1048576 ] || return 1
  # the x keeps the trailing newlines a command substitution would drop
  _c=$(_acct_read_in "${1}" "${2}" && echo x) || return 1
  ( umask "$(printf '%03o' "$(( (0777 & ~8#${_mod}) | 8#$(umask) ))")"
    printf '%s' "${_c%x}" > "${3}" )
}
# ./$1 in the current (pinned) directory replaced by the exact bytes $2, only
# while ./$1 is a regular file below 1 MiB (so a bounded read saw all of it):
# a fresh file with the owner, group and read/write bits of the file it
# replaces, then renamed over the name. The temp is created, written, owned
# and moded through one handle opened O_EXCL|O_NOFOLLOW, so nothing root owns
# is ever chowned by name in a directory the account can write (a hard link
# renamed over the temp name before a chown by name would have handed
# another file to the owner of the file it replaces); a swap before the
# rename only lands a file the account could have put there itself. The mode
# keeps only the read/write bits of the file it replaces, as before.
_ACCT_PUT_PL='use Fcntl; my ($n, $u, $g, $m) = @ARGV; local $/; my $d = <STDIN>; sysopen(my $h, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; (print {$h} $d) or exit 1; chown($u, $g, $h) or exit 1; chmod(oct($m) & 0666, $h) or exit 1; close($h) or exit 1; exit 0'
_acct_put_same_here() {
  local _t="./.${1}.put.$$.${RANDOM}" _st _typ _uid _gid _mod _sz
  _st=$(stat -c '%F|%u|%g|%a|%s' -- "./${1}" 2> /dev/null) || return 1
  IFS='|' read -r _typ _uid _gid _mod _sz <<< "${_st}"
  case "${_typ}" in
    "regular file"|"regular empty file") ;;
    *) return 1 ;;
  esac
  [[ "${_mod}" =~ ^[0-7]+$ && "${_sz}" =~ ^[0-9]+$ ]] || return 1
  [ "${_sz}" -lt 1048576 ] || return 1
  rm -f -- "${_t}"
  if printf '%s' "${2}" \
    | perl -e "${_ACCT_PUT_PL}" "${_t}" "${_uid}" "${_gid}" "${_mod}" \
    && mv -f -T -- "${_t}" "./${1}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# Every server_*.alias.drushrc.php in the current (pinned) directory edited by
# the sed script $1 as sed -i edited it (the same bytes: the trailing "x"
# keeps every newline through the substitution), read bounded and never
# through a link, and put back as _acct_put_same_here puts it. A name that is
# not a regular file is left alone.
_sed_server_aliases_here() {
  local _f _c
  for _f in ./server_*.alias.drushrc.php; do
    _f="${_f#./}"
    [ -f "./${_f}" ] && [ ! -L "./${_f}" ] || continue
    _c=$(_acct_read_here "${_f}" && echo x) || continue
    _c=$(printf '%s' "${_c%x}" | sed "${1}"; echo x)
    _acct_put_same_here "${_f}" "${_c%x}"
  done
}

# The instance user of an account $1 switched to the database broker
# (root's control file /data/conf/<oN>_db_broker.txt): 0 when handled here,
# 1 when the account is not switched and the user is made as before. Only
# an account on this box's own database server, not through ProxySQL, can
# be switched: a control file of any other is named and left alone. The
# broker makes the user again on the rows the control file lists, with the
# password in _ESC_PASS, and gives back its grant on each of the account's
# databases; nothing is granted on all databases. A control file the broker
# finds not valid leaves the account on the direct path, as provision reads
# it, so the user is made as before. Any other failure grants nothing: the
# new password goes on the user's rows as they are, so the logins the
# aliases are about to name keep working, and the failure is named.
_db_broker_rekey() {
  local _f="/data/conf/${1}_db_broker.txt" _h _out _rc
  [ -e "${_f}" ] || [ -L "${_f}" ] || return 1
  _h=$(grep -s "^_THIS_DB_HOST=" "/root/.${1}.octopus.cnf" | tail -n 1 \
    | cut -d= -f2 | tr -d "\"' ")
  [ -n "${_h}" ] || _h="${_THIS_DB_HOST}"
  case "${_h}" in
    localhost|127.0.0.1|FQDN) ;;
    *)
      echo "ALRT: ${_f} ignored: the database broker does not serve ${1}'s database host mode ${_h}"
      return 1
      ;;
  esac
  if [ -e "/data/conf/${1}_use_proxysql.txt" ]; then
    echo "ALRT: ${_f} ignored: ${1} goes through ProxySQL"
    return 1
  fi
  if [ -x "/usr/local/bin/boa-dbctl" ]; then
    _out=$(printf '%s\n' "${_ESC_PASS}" \
      | /usr/local/bin/boa-dbctl rekey --account "${1}" 2>&1)
    _rc=$?
    if [ "${_rc}" = "0" ]; then
      echo "INFO: ${_out##*$'\n'}"
      return 0
    fi
    if [ "${_rc}" = "8" ]; then
      echo "ALRT: ${_f} is not valid: ${1}'s tasks take the direct path, made as before"
      return 1
    fi
    echo "ALRT: the database broker did not renew ${1}'s instance user: ${_out##*$'\n'}"
  else
    echo "ALRT: ${1} is switched to the database broker, which is not installed here"
  fi
  echo "ALRT: ${1}'s instance user keeps its rights and takes the new password only"
  mysql --force --silent -u root -h"${_SQL_CONNECT}" -P"${_THIS_DB_PORT}" --protocol=tcp -u root mysql<<EOFMYSQL &> /dev/null
ALTER USER IF EXISTS '${_USE_DB_USER}'@'localhost' IDENTIFIED BY '${_ESC_PASS}';
ALTER USER IF EXISTS '${_USE_DB_USER}'@'127.0.0.1' IDENTIFIED BY '${_ESC_PASS}';
ALTER USER IF EXISTS '${_USE_DB_USER}'@'%' IDENTIFIED BY '${_ESC_PASS}';
ALTER USER IF EXISTS '${_USE_DB_USER}'@'${_USE_AEGIR_HOST}' IDENTIFIED BY '${_ESC_PASS}';
ALTER USER IF EXISTS '${_USE_DB_USER}'@'${_USE_RESOLVEIP}' IDENTIFIED BY '${_ESC_PASS}';
EOFMYSQL
  return 0
}

# Remove dangerous stuff from the string.
_sanitize_string() {
  echo "$1" | sed 's/[\\\/\^\?\>\`\#\"\{\(\&\|\*]//g; s/\(['"'"'\]\)//g'
}

#
# Find correct IP.
_find_correct_ip() {
  if [ -e "/root/.found_correct_ipv4.cnf" ]; then
    _LOC_IP=$(cat /root/.found_correct_ipv4.cnf 2>/dev/null | tr -d '\n')
  else
    _LOC_IP=$(curl ${_crlGet} https://api.ipify.org | sed 's/[^0-9\.]//g')
    if [ -z "${_LOC_IP}" ]; then
      _LOC_IP=$(curl ${_crlGet} http://ipv4.icanhazip.com | sed 's/[^0-9\.]//g')
    fi
    if [ ! -z "${_LOC_IP}" ]; then
      echo ${_LOC_IP} > /root/.found_correct_ipv4.cnf
    fi
  fi
}

_check_generate() {
  # _L_SYS sits in a directory its account owns: removed, read and written
  # only inside the real directory (_acct_in_real_dir, _put_pass).
  _acct_in_real_dir "${_L_SYS%/*}" rm -f -- "./${_L_SYS##*/}"
  if [ -e "${_L_SYS}" ]; then
    _ESC_PASS=$(_acct_read_in "${_L_SYS%/*}" "${_L_SYS##*/}")
  else
    echo "INFO: Expected file ${_L_SYS} does not exist"
    if [ "${_STRONG_PASSWORDS}" = "YES" ]; then
      _PWD_CHARS=64
    elif [ "${_STRONG_PASSWORDS}" = "NO" ]; then
      _PWD_CHARS=32
    else
      _STRONG_PASSWORDS=${_STRONG_PASSWORDS//[^0-9]/}
      if [ ! -z "${_STRONG_PASSWORDS}" ] \
        && [ "${_STRONG_PASSWORDS}" -gt 32 ]; then
        _PWD_CHARS="${_STRONG_PASSWORDS}"
      else
        _PWD_CHARS=32
      fi
      if [ ! -z "${_PWD_CHARS}" ] && [ "${_PWD_CHARS}" -gt 128 ]; then
        _PWD_CHARS=128
      fi
    fi
    if [ "${_STRONG_PASSWORDS}" = "YES" ] \
      || [ "${_PWD_CHARS}" -gt 32 ]; then
      echo "INFO: We will generate new random strong password (${_PWD_CHARS})"
      if [ -e "/root/.my.cluster_root_pwd.txt" ]; then
        _ESC_PASS="$(openssl rand -base64 64 | tr -d '\n')"
      else
        _RANDPASS_TEST=$(randpass -V 2>&1)
        if [[ "${_RANDPASS_TEST}" =~ "alnum" ]]; then
          _ESC_PASS=$(randpass "${_PWD_CHARS}" alnum 2>&1)
        else
          _ESC_PASS=$(shuf -zer -n64 {A..Z} {a..z} {0..9} % @ | tr -d '\0' 2>&1)
          _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
          _ESC_PASS=$(_sanitize_string "${_ESC_PASS}" 2>&1)
        fi
      fi
      _isPythonTwo="$(which python2)"
      _isPythonThree="$(which python3)"
      _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
      if [ -x "${_isPythonThree}" ]; then
        _ENC_PASS=$(python3 -c "import urllib.parse; print(urllib.parse.quote('''${_ESC_PASS}'''))")
      elif [ -x "${_isPythonTwo}" ]; then
        _ENC_PASS=$(python2 -c "import urllib; print urllib.quote('''${_ESC_PASS}''')")
      fi
      _put_pass
    else
       echo "INFO: We will generate new random password using shuf tool"
      _ESC_PASS=$(shuf -zer -n64 {A..Z} {a..z} {0..9} % @ | tr -d '\0' 2>&1)
      _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
      _ESC_PASS=$(_sanitize_string "${_ESC_PASS}" 2>&1)
      _ENC_PASS="${_ESC_PASS}"
      _put_pass
    fi
  fi
  _LEN_PASS=$(echo ${#_ESC_PASS} 2>&1)
  if [ -z "${_ESC_PASS}" ] || [ "${_LEN_PASS}" -lt 9 ]; then
     echo "WARN: The random password=${_ESC_PASS} does not look good"
     echo "INFO: We will generate new random password using shuf tool"
    _ESC_PASS=$(shuf -zer -n64 {A..Z} {a..z} {0..9} % @ | tr -d '\0' 2>&1)
    _ESC_PASS=$(echo -n "${_ESC_PASS}" | tr -d "\n" 2>&1)
    _ESC_PASS=$(_sanitize_string "${_ESC_PASS}" 2>&1)
    _ENC_PASS="${_ESC_PASS}"
    _put_pass
  fi
}

# aegir2boa's own root state for the account $1 says its db-import, or the
# revert of one, is unfinished: the dispatcher it held aside is still there,
# a hold xmass carried here with a failover from the box the import ran on
# stands (failover-hold) on a box that is no standby, or on any box with $2
# promoted (a standby's own passes never act on it; a promotion's own steps,
# which run before its marker goes, do), a revert marked itself started
# (revert-db.started, cleared only once the revert's dispatcher is back), or
# a step marker of the import stands with neither its done marker nor the
# marker of its hand-back (written right before the import returns the
# dispatcher).
# Root's /var/backups/a2b only: a link on the way reads as no state, and so
# does a state recorded for another account of the name (its uid, or its
# home's inode or birth time, not the account's now; a birth time either
# side does not know is not compared). The record's first line is read
# whether or not a newline ends it; an empty record, or none, is the
# account's own. One text wherever it is defined.
_a2b_import_unfinished() {
  local _b="/var/backups/a2b/${1}" _m _iu="" _ii _ib _n
  case "${1}" in
    ""|*[!a-z0-9-]*) return 1 ;;
  esac
  [ -d "${_b}" ] && [ ! -L "${_b}" ] && [ ! -L /var/backups/a2b ] || return 1
  if [ -f "${_b}/identity" ] && [ ! -L "${_b}/identity" ]; then
    read -r _iu _ii _ib _ < "${_b}/identity"
  fi
  if [ -n "${_iu}" ]; then
    _n=$(stat -c '%i %W' "/data/disk/${1}" 2> /dev/null)
    [ "${_iu}" = "$(id -u "${1}" 2> /dev/null)" ] && [ "${_ii}" = "${_n% *}" ] || return 1
    [ "${_ib}" = "0" ] || [ "${_n#* }" = "0" ] || [ "${_ib}" = "${_n#* }" ] || return 1
  fi
  [ -e "${_b}/held-run-${1}" ] && return 0
  [ -e "${_b}/failover-hold" ] && { [ "${2:-}" = "promoted" ] \
    || { [ ! -e /root/.standby.cnf ] && [ ! -e /root/.standby.prep.cnf ]; }; } \
    && return 0
  [ -d "${_b}/markers" ] && [ ! -L "${_b}/markers" ] || return 1
  [ -e "${_b}/markers/revert-db.started" ] && return 0
  [ -e "${_b}/markers/import.db-import.done" ] && return 1
  [ -e "${_b}/markers/dbimport.12.done" ] && return 1
  for _m in "${_b}"/markers/dbimport.*.done; do
    [ -e "${_m}" ] && return 0
  done
  return 1
}
# What to do about the unfinished aegir2boa import of the account $1 (one
# _a2b_import_unfinished holds for), by what its root state says was cut
# off: the one way out that state allows, or either. A revert cut off part
# way (revert-db.started) is ended by the revert alone: a re-run of the
# import would find its step markers and report a finished import on the
# panel the revert restored. A hold xmass carried here with a failover
# (failover-hold), with no dump transferred here, is ended by the route run
# again toward this box, once the site databases the replication brought
# from the cut-off import are dropped: the dumps and the pre-import
# snapshot stayed on the box the import ran on. An import cut off before its pre-import
# snapshot was complete (no dbimport.1.done) is ended by its re-run alone:
# there is nothing to revert to. Anything else by either. One sentence, its
# commands spelled out. One text wherever it is defined.
_a2b_import_advice() {
  local _b="/var/backups/a2b/${1}" _c="aegir2boa-stage2 import --account ${1}"
  if [ -e "${_b}/markers/revert-db.started" ]; then
    echo "A revert of it was cut off part way: finish the revert with ${_c} --revert-db-import (dry first, then with --live); a re-run of the import would report it finished on the panel the revert restored"
  elif [ -e "${_b}/failover-hold" ] && [ ! -e "${_b}/src/hostmaster.sql" ]; then
    echo "It came here with a failover from the box it ran on, where its dumps and pre-import snapshot stayed, so neither its re-run nor its revert can run here: run the route again toward this box, a fresh aegir2boa-stage2 export and transfer on its source; once that transfer has put its manifests here (${_b}/src/manifest/*.info), drop each database they name (A2BM_DBN) that already exists here, as the replication brought them from the cut-off import (boa-dbctl drop <database> --account ${1} where the account is switched to the database broker, DROP DATABASE as root otherwise: the import refuses a database that exists, and no reset reaches them), then ${_c} --route db-import here, dry first, then with --live"
  elif [ ! -e "${_b}/markers/dbimport.1.done" ]; then
    echo "It was cut off before its pre-import snapshot was complete, so there is nothing to revert to: finish it with ${_c} --route db-import (dry first, then with --live)"
  else
    echo "Finish it with ${_c} --route db-import, or undo it with ${_c} --revert-db-import (each dry first, then with --live)"
  fi
}

# The last value of the setting $2 in the account $1's own cnf, as its
# Octopus pass reads it; empty where the cnf names none.
_acct_cnf_value() {
  grep -s "^${2}=" "/root/.${1}.octopus.cnf" | tail -n 1 \
    | cut -d= -f2 | tr -d "\"' "
}

# Remote database server mode, per account. An account's databases are on a
# remote server when its own cnf names a host other than the four words that
# keep them on this box and other than the box's own address. Its install
# left it logging in there with the shared aegir_root login its server alias
# and its panel's server record name, and no password sync changes anything
# there: the login of its own name a sync once made again there is used by
# nothing. "syncpass remote <oN> apply" switches it to a login of its own
# there, at this web head's address, where root from here can manage users;
# the switch is recorded in root's /root/.<oN>.remote-db.txt, and each later
# "syncpass fix <oN>" gives that one login a new password, found by the
# record and never by a name. What a switch saved, and the journal of one
# cut off, are root's, under /var/backups/boa/remote-db.
_rdb_remote() {
  case "${_THIS_DB_HOST}" in
    ""|localhost|127.0.0.1|PROXYSQL|FQDN) return 1 ;;
  esac
  [ "${_THIS_DB_HOST}" != "${_MY_OWNIP}" ]
}

# SQL on stdin as root on the account's database server, as the password
# sync reaches it (root's /root/.my.cnf): rows tab separated, no names.
_rdb_sql() {
  mysql --connect-timeout=10 -u root -h"${_SQL_CONNECT}" -P"${_THIS_DB_PORT}" \
    --protocol=tcp -BN mysql 2> /dev/null
}

# $1 quoted for a single-quoted SQL string.
_rdb_q() {
  local _v="${1//\\/\\\\}"
  printf '%s' "${_v//\'/\'\'}"
}

# Status 0 when root from here can create users and grant there.
_rdb_root_manages() {
  [ "$(echo "SELECT 1 FROM mysql.user WHERE CONCAT(User,'@',Host)=CURRENT_USER() AND Create_user_priv='Y' AND Grant_priv='Y';" \
    | _rdb_sql)" = "1" ]
}

# A login there as $1 with the password $2: prints the account row it lands
# on (CURRENT_USER()). The password goes through a root-only option file
# removed right after, never through the command line. A password read from
# an account's alias can hold anything: a control character or a quote in it
# would add option lines of the account's choosing to root's client (a plugin
# directory it loads from), so such a value logs in nowhere.
_rdb_login() {
  local _f _o _rc _p="${2//\\/\\\\}"
  case "${2}" in
    ""|*[[:cntrl:]]*|*\"*) return 1 ;;
  esac
  _f=$(mktemp /root/.syncpass.rdb.XXXXXX) || return 1
  printf '[client]\nuser="%s"\npassword="%s"\nhost="%s"\nport=%s\nprotocol=tcp\nconnect-timeout=10\n' \
    "${1}" "${_p}" "${_SQL_CONNECT}" "${_THIS_DB_PORT}" > "${_f}"
  _o=$(mysql --defaults-file="${_f}" -BN -e "SELECT CURRENT_USER()" 2> /dev/null < /dev/null)
  _rc=$?
  rm -f -- "${_f}"
  printf '%s' "${_o}"
  return "${_rc}"
}

# A new password of letters and digits, as long as _STRONG_PASSWORDS asks
# (32 to 128): nothing in it needs encoding in a server alias.
_rdb_newpass() {
  local _n=32 _s _p=""
  case "${_STRONG_PASSWORDS}" in
    YES) _n=64 ;;
    NO) _n=32 ;;
    *)
      _s="${_STRONG_PASSWORDS//[^0-9]/}"
      if [ -n "${_s}" ] && [ "${_s}" -gt 32 ]; then
        _n="${_s}"
      fi
      [ "${_n}" -gt 128 ] && _n=128
      ;;
  esac
  if [[ "$(randpass -V 2>&1)" =~ alnum ]]; then
    _p=$(randpass "${_n}" alnum 2> /dev/null)
  fi
  if [[ ! "${_p}" =~ ^[A-Za-z0-9]{32,128}$ ]]; then
    _p=$(openssl rand -base64 384 2> /dev/null | tr -dc 'A-Za-z0-9' | head -c "${_n}")
  fi
  [[ "${_p}" =~ ^[A-Za-z0-9]{32,128}$ ]] || return 1
  printf '%s' "${_p}"
}

# The password of a server alias's master_db, decoded as provision and the
# panel decode it (urldecode).
_rdb_urldecode() {
  local _v="${1//+/ }"
  printf '%b' "${_v//%/\\x}"
}

# The password the server alias $2 (in the account's real .drush, read
# bounded, never through a link) gives the login $1, decoded.
_rdb_alias_pass() {
  local _e
  _e=$(_acct_read_in "/data/disk/${_uname}/.drush" "${2}" \
    | sed -n "s#.*'master_db' *=> *'mysql://${1}:\([^@']*\)@.*#\1#p" | head -n 1)
  [ -n "${_e}" ] || return 1
  _rdb_urldecode "${_e}"
}

# In the current (pinned) .drush: each server alias whose master_db logs in
# as $1 on the host $2, a name a line.
_rdb_aliases_here() {
  local _f
  for _f in ./server_*.alias.drushrc.php; do
    [ -f "${_f}" ] && [ ! -L "${_f}" ] || continue
    _acct_read_here "${_f#./}" \
      | grep -q "'master_db' *=> *'mysql://${1}:[^@']*@${2//./\\.}[:'/]" \
      && printf '%s\n' "${_f#./}"
  done
}

# The server alias $1 in the account's real .drush given the login $2 with
# the password $3 (letters and digits) on its master_db line, the host and
# everything else kept; read back. Status 0 when the alias then holds it.
_rdb_alias_set() {
  local _c _n _k
  [[ "${3}" =~ ^[A-Za-z0-9]+$ ]] || return 1
  _c=$(_acct_read_in "/data/disk/${_uname}/.drush" "${1}" && echo x) || return 1
  # the password never reaches sed's command line: sed writes a mark, the
  # shell puts the password in its place
  _k="RDBPASS${$}x${RANDOM}${RANDOM}${RANDOM}"
  [[ "${_c}" == *"${_k}"* ]] && return 1
  _n=$(printf '%s' "${_c%x}" \
    | sed -E "/'master_db' *=>/ s#mysql://(aegir_root|${_uname}):[^@']*@#mysql://${2}:${_k}@#"; echo x)
  _n="${_n//"${_k}"/${3}}"
  [ "${_n}" != "${_c}" ] || [ "$(_rdb_alias_pass "${2}" "${1}")" = "${3}" ] || return 1
  _acct_in_real_dir "/data/disk/${_uname}/.drush" _acct_put_same_here "${1}" "${_n%x}" \
    || return 1
  [ "$(_rdb_alias_pass "${2}" "${1}")" = "${3}" ]
}

# SQL on stdin in the account's own panel database, as the panel's own
# tasks reach it; only the lines that start with RDB| are printed, without
# it, so neither column names nor the client's escaping reach the reader.
_rdb_panel() {
  su -s /bin/bash - "${_uname}" -c "drush8 @hostmaster sql-cli" 2> /dev/null 8>&- \
    | sed -n 's/^RDB|//p'
}

# The panel's database server records of the node $1, as lines
# vid|nid|user|password, the two values in hex.
_rdb_rows_read() {
  echo "SELECT CONCAT('RDB|', vid, '|', nid, '|', HEX(db_user), '|', HEX(db_passwd)) FROM hosting_db_server WHERE nid = ${1} ORDER BY vid;" \
    | _rdb_panel
}

# The records saved in the file $1 put back, each by its revision; status 0
# when the node's records then read exactly as saved.
_rdb_rows_restore() {
  local _v _n _u _p _sql="" _nid=""
  while IFS='|' read -r _v _n _u _p; do
    [[ "${_v}" =~ ^[0-9]+$ && "${_n}" =~ ^[0-9]+$ && "${_u}" =~ ^[0-9A-F]*$ && "${_p}" =~ ^[0-9A-F]*$ ]] \
      || return 1
    _nid="${_n}"
    _sql="${_sql}UPDATE hosting_db_server SET db_user = UNHEX('${_u}'), db_passwd = UNHEX('${_p}') WHERE vid = ${_v} AND nid = ${_n};"$'\n'
  done < "${1}"
  [ -n "${_nid}" ] || return 1
  printf '%s' "${_sql}" | _rdb_panel > /dev/null
  [ "$(_rdb_rows_read "${_nid}")" = "$(cat "${1}")" ]
}

# The account's two password files given $1, without stopping the run.
_rdb_files_put() {
  _ESC_PASS="${1}"
  printf '%s\n' "${_ESC_PASS}" \
    | _acct_in_real_dir "${_L_SYS%/*}" _put_secret_here "${_L_SYS##*/}" \
      "${_L_SYS_OWN}" \
    && _put_pass_php && return 0
  echo "ALRT: remote database ${_uname}: its password files could not be written"
  return 1
}

# The record $1 (root's, a regular file of a single link, 0600) read: sets
# the _R_* values, status 0 when each has its form.
_rdb_rec_read() {
  local _k _v
  _R_ALIAS=""
  _R_SERVER=""
  _R_DBHOST=""
  _R_PORT=""
  _R_ROW=""
  _R_NODE=""
  _R_SAVED=""
  _R_SINCE=""
  [ -f "${1}" ] && [ ! -L "${1}" ] || return 1
  [ "$(stat -c '%u|%h|%a' -- "${1}" 2> /dev/null)" = "0|1|600" ] || return 1
  while IFS='=' read -r _k _v; do
    case "${_k}" in
      alias) _R_ALIAS="${_v}" ;;
      server) _R_SERVER="${_v}" ;;
      dbhost) _R_DBHOST="${_v}" ;;
      port) _R_PORT="${_v}" ;;
      row) _R_ROW="${_v}" ;;
      node) _R_NODE="${_v}" ;;
      saved) _R_SAVED="${_v}" ;;
      since) _R_SINCE="${_v}" ;;
    esac
  done < <(head -c 4096 -- "${1}" 2> /dev/null)
  [[ "${_R_ALIAS}" =~ ^server_[A-Za-z0-9._-]+\.alias\.drushrc\.php$ ]] \
    && [[ "${_R_SERVER}" =~ ^server_[A-Za-z0-9._-]+$ ]] \
    && [[ "${_R_DBHOST}" =~ ^[A-Za-z0-9._:-]+$ ]] \
    && [[ "${_R_PORT}" =~ ^[0-9]{1,5}$ ]] \
    && [[ "${_R_ROW}" =~ ^[0-9A-Fa-f.:]+$ ]] \
    && [[ "${_R_NODE}" =~ ^[1-9][0-9]*$ ]] \
    && [[ "${_R_SAVED}" =~ ^${_RDB_DIR}/${_uname}-[0-9-]+$ ]]
}

# The record or the journal $1 written whole from the _R_* values, root's
# 0600, beside its name and moved over it.
_rdb_rec_write() {
  rm -f -- "${1}.new"
  ( umask 077
    printf 'alias=%s\nserver=%s\ndbhost=%s\nport=%s\nrow=%s\nnode=%s\nsaved=%s\nsince=%s\n' \
      "${_R_ALIAS}" "${_R_SERVER}" "${_R_DBHOST}" "${_R_PORT}" "${_R_ROW}" \
      "${_R_NODE}" "${_R_SAVED}" "${_R_SINCE}" > "${1}.new" ) || return 1
  chmod 0600 "${1}.new" && mv -f -T -- "${1}.new" "${1}"
}

# The journal of a login of the account's own that its install made on its
# remote database server before its panel was installed (syncpass remote
# <oN> born): root's /var/backups/boa/remote-db/<oN>.born, 0600, a single
# link, with the lines dbhost=, port=, row= and since=. Status 0 when it
# reads with each form; sets _R_DBHOST, _R_PORT, _R_ROW and _R_SINCE.
_rdb_born_read() {
  local _f="${_RDB_DIR}/${_uname}.born" _k _v
  _R_DBHOST=""
  _R_PORT=""
  _R_ROW=""
  _R_SINCE=""
  [ -f "${_f}" ] && [ ! -L "${_f}" ] || return 1
  [ "$(stat -c '%u|%h|%a' -- "${_f}" 2> /dev/null)" = "0|1|600" ] || return 1
  while IFS='=' read -r _k _v; do
    case "${_k}" in
      dbhost) _R_DBHOST="${_v}" ;;
      port) _R_PORT="${_v}" ;;
      row) _R_ROW="${_v}" ;;
      since) _R_SINCE="${_v}" ;;
    esac
  done < <(head -c 4096 -- "${_f}" 2> /dev/null)
  [[ "${_R_DBHOST}" =~ ^[A-Za-z0-9._:-]+$ ]] \
    && [[ "${_R_PORT}" =~ ^[0-9]{1,5}$ ]] \
    && [[ "${_R_ROW}" =~ ^[0-9A-Fa-f.:]+$ ]]
}

# Status 0 while the journal of an install's own login stands, valid or not.
_rdb_born_cut() {
  [ -e "${_RDB_DIR}/${_uname}.born" ] || [ -L "${_RDB_DIR}/${_uname}.born" ]
}

# $1 as upper case hex, as the panel's saved records hold a value.
_rdb_hex() {
  printf '%s' "${1}" | od -An -v -tx1 | tr -d ' \n' | tr 'a-f' 'A-F'
}

# $1 for a server alias's master_db: every byte but a letter, a digit and
# . _ ~ - written as %XX, which provision and _rdb_urldecode both decode.
_rdb_urlencode() {
  local LC_ALL=C _s="${1}" _o="" _c _i
  for (( _i = 0; _i < ${#_s}; _i++ )); do
    _c="${_s:_i:1}"
    case "${_c}" in
      [A-Za-z0-9._~-]) _o="${_o}${_c}" ;;
      *) printf -v _c '%%%02X' "'${_c}"; _o="${_o}${_c}" ;;
    esac
  done
  printf '%s' "${_o}"
}

# The account's own switch lock: one switch, rotation or revert at a time.
# fd 8 is closed on each command a run starts.
_rdb_lock() {
  exec 8> "/run/boa-remote-db.${_uname}.lock" || return 1
  flock -w "${1}" 8
}

# The task queue released, when this run holds it.
_rdb_release() {
  if [ "${_RDB_QHELD}" = "YES" ] \
    && [ "$( { tr -dc '0-9' < /run/boa_queue_stop.pid; } 2> /dev/null )" = "$$" ]; then
    rm -f -- /run/boa_queue_stop.pid
  fi
  _RDB_QHELD=NO
}

# The task queue held as a maintenance move holds it (the pause file with
# this run's pid; one whose owner is gone is cleared, never obeyed), then
# the account's own running tasks waited out. Refused during a BOA run.
_rdb_hold() {
  local _p _w=0
  if [ -e /run/boa_run.pid ] || [ -e /run/octopus_install_run.pid ]; then
    echo "ERROR: ${_uname}: a BOA run is in progress; nothing was changed, run this again once it ends"
    return 1
  fi
  if [ -e /run/boa_queue_stop.pid ] || [ -L /run/boa_queue_stop.pid ]; then
    _p=$( { tr -dc '0-9' < /run/boa_queue_stop.pid; } 2> /dev/null )
    if [ -n "${_p}" ] && kill -0 "${_p}" 2> /dev/null \
      && [ "$(awk '/^Uid:/ { print $2; exit }' "/proc/${_p}/status" 2> /dev/null)" = "0" ]; then
      echo "ERROR: ${_uname}: the task queue is held by another run; nothing was changed"
      return 1
    fi
    # cleared only while it still names the owner read above, so a hold
    # another run takes meanwhile is never removed
    [ "$( { tr -dc '0-9' < /run/boa_queue_stop.pid; } 2> /dev/null )" = "${_p}" ] \
      && rm -f -- /run/boa_queue_stop.pid
  fi
  if ! ( set -C; echo "$$" > /run/boa_queue_stop.pid ) 2> /dev/null; then
    echo "ERROR: ${_uname}: the task queue could not be held; nothing was changed"
    return 1
  fi
  _RDB_QHELD=YES
  trap '_rdb_release' EXIT
  while pgrep -u "${_uname}" -f '(^| )provision-[a-z0-9-]+( |$)|hosting-task( |$)' > /dev/null 2>&1; do
    _w=$(( _w + 1 ))
    if [ "${_w}" -gt 60 ]; then
      echo "ERROR: ${_uname}: its tasks still run after ten minutes; nothing was changed"
      return 1
    fi
    sleep 10
  done
  return 0
}

# This web head's address as the database server sees it, from root's own
# connection: the client address, else the address root's matching row
# names; never a name or a pattern, so the login made for it can never be
# one the server shares with another web head or its own accounts.
_rdb_web_row() {
  local _o _h
  _o=$(echo "SELECT USER(), CURRENT_USER();" | _rdb_sql) || return 1
  for _h in "$(printf '%s' "${_o}" | cut -f1)" "$(printf '%s' "${_o}" | cut -f2)"; do
    _h="${_h##*@}"
    if [[ "${_h}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] \
      || [[ "${_h}" =~ ^[0-9A-Fa-f]*:[0-9A-Fa-f:.]+$ ]]; then
      printf '%s' "${_h}"
      return 0
    fi
  done
  return 1
}

# The account's password file backups that hold the value $1 (compared in
# memory, never printed), removed with their PHP twins inside the real
# account home; prints how many.
_rdb_pre_drop_here() {
  local _f _n=0
  for _f in "./.${_uname}.pass.txt-pre-"*; do
    [ -f "${_f}" ] && [ ! -L "${_f}" ] || continue
    [ "$(stat -c %h -- "${_f}" 2> /dev/null)" = "1" ] || continue
    [ "$(_acct_read_here "${_f#./}" | tr -d '\n')" = "${1}" ] || continue
    rm -f -- "${_f}" \
      "./.${_uname}.pass.php-pre-${_f#"./.${_uname}.pass.txt-pre-"}" 2> /dev/null
    _n=$(( _n + 1 ))
  done
  echo "${_n}"
}

# What on this box keeps a login of the account's own off its database
# server, or nothing: a standby or a box being made one, the active of a
# standing pair or a move (the login would be bound to this web head's
# address, which a promotion leaves behind), ProxySQL or a cluster, an
# unfinished aegir2boa import. Status 2 where root from here cannot manage
# users there: a NOTE, not an error.
_rdb_gate() {
  local _p
  if [ -e /root/.standby.cnf ] || [ -e /root/.standby.prep.cnf ]; then
    echo "ERROR: ${_uname}: this box is a standby: a login of its own there is made on the active web head"
    return 1
  fi
  _p=$(grep -s -m 1 '^_XMASS_PHASE=' /data/conf/xmass_state.cnf | cut -d= -f2- | tr -cd 'a-z-')
  case "${_p}" in
    init|syncing|cutover|rename-failed)
      echo "ERROR: ${_uname}: this box is the active of a standing pair or a move: a login of its own there would be bound to this web head's address alone"
      return 1
      ;;
  esac
  if [ -e "/data/conf/${_uname}_use_proxysql.txt" ] || [ -e /root/.my.cluster_root_pwd.txt ]; then
    echo "ERROR: ${_uname}: ProxySQL or a cluster stands between this box and its database server"
    return 1
  fi
  if _a2b_import_unfinished "${_uname}"; then
    echo "ERROR: ${_uname}: its aegir2boa db-import is unfinished; nothing was changed. $(_a2b_import_advice "${_uname}")"
    return 1
  fi
  if ! _rdb_root_manages; then
    echo "NOTE: ${_uname}: root from this web head cannot manage users on ${_THIS_DB_HOST}: it keeps the shared aegir_root login; allow root from this web head there, with CREATE USER and GRANT OPTION, to switch it"
    return 2
  fi
  return 0
}

# Why the account cannot be switched here, or nothing. Status 2 for a
# database server where root from here cannot manage users: a NOTE, not an
# error. With $1 "resume", the alias and the node come from the journal.
# Sets _A_ALIAS, _A_SERVER, _A_NODE, _A_ROW and _A_PLUGIN.
_rdb_check() {
  local _p _l _c
  _A_ALIAS=""
  _A_SERVER=""
  _A_NODE=""
  _A_ROW=""
  _A_PLUGIN=""
  if [ ! -d "/data/disk/${_uname}/.drush" ] || [ ! -e "/root/.${_uname}.octopus.cnf" ]; then
    echo "ERROR: ${_uname} is not an Octopus account on this box"
    return 1
  fi
  if ! _rdb_remote; then
    echo "ERROR: ${_uname}'s databases are on this box's own server (${_THIS_DB_HOST}): nothing to switch"
    return 1
  fi
  _rdb_gate || return $?
  if [ "${1}" = "resume" ]; then
    _A_ALIAS="${_R_ALIAS}"
    _A_SERVER="${_R_SERVER}"
    _A_NODE="${_R_NODE}"
  else
    _l=$(_acct_in_real_dir "/data/disk/${_uname}/.drush" _rdb_aliases_here aegir_root "${_THIS_DB_HOST}")
    if [ -z "${_l}" ] || [ "$(printf '%s\n' "${_l}" | wc -l)" != "1" ]; then
      echo "ERROR: ${_uname}: not exactly one server alias logs in as aegir_root on ${_THIS_DB_HOST}"
      return 1
    fi
    _A_ALIAS="${_l}"
    # the form its record and journal must hold, or a revert could not read them
    if [[ ! "${_A_ALIAS}" =~ ^server_[A-Za-z0-9._-]+\.alias\.drushrc\.php$ ]]; then
      echo "ERROR: ${_uname}: its server alias ${_A_ALIAS//[^A-Za-z0-9._-]/?} has a name a record cannot hold; nothing was changed"
      return 1
    fi
    _A_SERVER=$(_acct_read_in "/data/disk/${_uname}/.drush" "${_A_ALIAS}" \
      | sed -n "s/^\$aliases\['\([^']*\)'\].*/\1/p" | head -n 1)
    _l=$(echo "SELECT CONCAT('RDB|', n.nid) FROM node n JOIN hosting_db_server d ON d.vid = n.vid WHERE n.type = 'server' AND n.title = '${_THIS_DB_HOST}' AND d.db_user = 'aegir_root';" \
      | _rdb_panel)
    if [[ ! "${_l}" =~ ^[1-9][0-9]*$ ]]; then
      echo "ERROR: ${_uname}: not exactly one server of its panel named ${_THIS_DB_HOST} logs in as aegir_root"
      return 1
    fi
    _A_NODE="${_l}"
  fi
  if [[ ! "${_A_SERVER}" =~ ^server_[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: ${_uname}: the server alias ${_A_ALIAS} names no server"
    return 1
  fi
  if ! _A_ROW=$(_rdb_web_row); then
    echo "ERROR: ${_uname}: ${_THIS_DB_HOST} does not see this web head by an address"
    return 1
  fi
  if [ "${1}" = "resume" ] && [ "${_A_ROW}" != "${_R_ROW}" ]; then
    echo "ERROR: ${_uname}: ${_THIS_DB_HOST} now sees this web head as ${_A_ROW}, the switch began for ${_R_ROW}"
    return 1
  fi
  _c=$(echo "SELECT COUNT(*) FROM mysql.user WHERE User = '${_uname}' AND Host = '${_A_ROW}';" | _rdb_sql)
  if [ "${_c}" != "0" ] && [ "${1}" != "resume" ]; then
    echo "ERROR: ${_uname}: ${_THIS_DB_HOST} already has the login '${_uname}'@'${_A_ROW}', which this web head did not make"
    return 1
  fi
  if [ "${1}" = "resume" ]; then
    _l=$(_acct_read_in "${_R_SAVED}" alias \
      | sed -n "s#.*'master_db' *=> *'mysql://aegir_root:\([^@']*\)@.*#\1#p" | head -n 1)
    _A_OLD=$(_rdb_urldecode "${_l}")
  else
    _A_OLD=$(_rdb_alias_pass aegir_root "${_A_ALIAS}")
  fi
  _l=$(_rdb_login aegir_root "${_A_OLD}")
  if [[ ! "${_l}" =~ ^aegir_root@ ]]; then
    echo "ERROR: ${_uname}: its aegir_root login there does not work now; nothing to switch from"
    return 1
  fi
  _A_PLUGIN=$(echo "SELECT plugin FROM mysql.user WHERE CONCAT(User, '@', Host) = '$(_rdb_q "${_l}")';" | _rdb_sql)
  if [[ ! "${_A_PLUGIN}" =~ ^[a-z0-9_]+$ ]]; then
    echo "ERROR: ${_uname}: the login plugin of ${_l} could not be read"
    return 1
  fi
  return 0
}

# Everything an apply changed put back from what it saved (the panel's
# records, the server alias), the account's own login there dropped, the
# journal and the record removed and the password files made random. The
# saved copy stays. When either could not be put back, the login, the
# journal and the files stay as they are, so a revert can finish it.
_rdb_undo() {
  local _c _ok=YES
  if ! _rdb_rows_restore "${_R_SAVED}/rows"; then
    echo "ALRT: remote database ${_uname}: its panel's server records could not be put back from ${_R_SAVED}/rows"
    _ok=NO
  fi
  _c=$(cat -- "${_R_SAVED}/alias" && echo x)
  if [ "${_c}" = "x" ] || ! _acct_in_real_dir "/data/disk/${_uname}/.drush" \
    _acct_put_same_here "${_R_ALIAS}" "${_c%x}" \
    || [ "$(_rdb_alias_pass aegir_root "${_R_ALIAS}")" != "${_A_OLD}" ]; then
    echo "ALRT: remote database ${_uname}: its server alias could not be put back from ${_R_SAVED}/alias"
    _ok=NO
  fi
  su -s /bin/bash - "${_uname}" -c "drush8 cc drush" > /dev/null 2>&1 8>&-
  if [ "${_ok}" != "YES" ]; then
    echo "ALRT: remote database ${_uname}: the journal, and its own login '${_uname}'@'${_R_ROW}' where it was made, are kept: run syncpass remote ${_uname} revert"
    return 1
  fi
  echo "DROP USER IF EXISTS '${_uname}'@'${_R_ROW}';" | _rdb_sql > /dev/null
  rm -f -- "/root/.${_uname}.remote-db.txt" "${_RDB_DIR}/${_uname}.apply"
  _rdb_files_put "$(_rdb_newpass)" > /dev/null
}

# The account's server alias, as it now stands, verified by provision as
# the account (the backend verify, not queued, so it cannot race the task
# queue), then a read of its panel's own database.
_rdb_verify() {
  su -s /bin/bash - "${_uname}" -c "drush8 cc drush" > /dev/null 2>&1 8>&-
  su -s /bin/bash - "${_uname}" -c "drush8 @${_R_SERVER} provision-verify" \
    > /dev/null 2>&1 8>&- || return 1
  [ "$(echo "SELECT CONCAT('RDB|', 1);" | _rdb_panel)" = "1" ]
}

# syncpass remote <oN> apply: the switch (see above). A switch cut off is
# taken up again from its journal. Changes nothing where root from here
# cannot manage users there (a NOTE), or the account is already switched.
_rdb_apply() {
  local _rec="/root/.${_uname}.remote-db.txt" _jr="${_RDB_DIR}/${_uname}.apply"
  local _mode="" _rc _p _l _c _n _r _sql
  if ! _rdb_lock 300; then
    echo "ERROR: ${_uname}: another switch, revert or password sync of it is running; nothing was changed"
    return 1
  fi
  if _rdb_born_cut; then
    echo "ERROR: ${_uname}: the login of its own its install made there was never recorded (${_RDB_DIR}/${_uname}.born): run syncpass remote ${_uname} status; nothing was changed"
    return 1
  fi
  if [ -e "${_jr}" ] || [ -L "${_jr}" ]; then
    if ! _rdb_rec_read "${_jr}" || [ ! -s "${_R_SAVED}/alias" ] || [ ! -s "${_R_SAVED}/rows" ]; then
      echo "ERROR: ${_uname}: the journal ${_jr} or what it saved is not valid; nothing was changed"
      return 1
    fi
    if [ "${_R_DBHOST}" != "${_THIS_DB_HOST}" ]; then
      echo "ERROR: ${_uname}: the journal names ${_R_DBHOST}, its cnf ${_THIS_DB_HOST}; nothing was changed"
      return 1
    fi
    _THIS_DB_PORT="${_R_PORT}"
    _mode=resume
    echo "INFO: ${_uname}: taking up the switch that began ${_R_SINCE}"
  elif [ -e "${_rec}" ] || [ -L "${_rec}" ]; then
    if ! _rdb_rec_read "${_rec}"; then
      echo "ERROR: ${_uname}: its record ${_rec} is not valid; nothing was changed"
      return 1
    fi
    _SQL_CONNECT="${_R_DBHOST}"
    _THIS_DB_PORT="${_R_PORT}"
    _p=$(_rdb_alias_pass "${_uname}" "${_R_ALIAS}")
    if [ -n "${_p}" ] && [ "$(_rdb_login "${_uname}" "${_p}")" = "${_uname}@${_R_ROW}" ]; then
      echo "INFO: ${_uname} already logs in to ${_R_DBHOST} as '${_uname}'@'${_R_ROW}': nothing to do"
      return 0
    fi
    echo "ERROR: ${_uname} is switched to '${_uname}'@'${_R_ROW}' on ${_R_DBHOST}, and that login fails now: run syncpass remote ${_uname} revert"
    return 1
  fi
  _rdb_hold || return 1
  _rdb_check "${_mode}"
  _rc=$?
  [ "${_rc}" = "2" ] && return 0
  [ "${_rc}" = "0" ] || return 1
  if [ "${_mode}" != "resume" ]; then
    _R_ALIAS="${_A_ALIAS}"
    _R_SERVER="${_A_SERVER}"
    _R_DBHOST="${_THIS_DB_HOST}"
    _R_PORT="${_THIS_DB_PORT}"
    _R_ROW="${_A_ROW}"
    _R_NODE="${_A_NODE}"
    _R_SAVED="${_RDB_DIR}/${_uname}-${_NOW}"
    _R_SINCE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    if ! mkdir -p "${_RDB_DIR}" || ! chmod 0700 "${_RDB_DIR}" \
      || [ -L "${_RDB_DIR}" ] || ! mkdir -m 0700 "${_R_SAVED}"; then
      echo "ERROR: ${_uname}: ${_R_SAVED} could not be made; nothing was changed"
      return 1
    fi
    _c=$(_acct_read_in "/data/disk/${_uname}/.drush" "${_R_ALIAS}" && echo x)
    _l=$(_rdb_rows_read "${_R_NODE}")
    if [ "${_c}" = "x" ] || [ -z "${_c}" ] || [ -z "${_l}" ] \
      || ! ( umask 077; printf '%s' "${_c%x}" > "${_R_SAVED}/alias" \
        && printf '%s\n' "${_l}" > "${_R_SAVED}/rows" ) \
      || ! _rdb_rec_write "${_jr}"; then
      echo "ERROR: ${_uname}: its server alias and its panel's records could not be saved; nothing was changed"
      return 1
    fi
  fi
  if ! _p=$(_rdb_newpass); then
    echo "ALRT: remote database ${_uname}: no new password could be made; nothing was changed"
    _rdb_undo
    return 1
  fi
  _c=$(echo "SELECT COUNT(*) FROM mysql.user WHERE User = '${_uname}' AND Host = '${_R_ROW}';" | _rdb_sql)
  if [ "${_c}" = "0" ]; then
    _sql="CREATE USER '${_uname}'@'${_R_ROW}' IDENTIFIED WITH ${_A_PLUGIN} BY '${_p}';"
  else
    _sql="ALTER USER '${_uname}'@'${_R_ROW}' IDENTIFIED WITH ${_A_PLUGIN} BY '${_p}';"
  fi
  _sql="${_sql}"$'\n'"GRANT ALL ON *.* TO '${_uname}'@'${_R_ROW}' WITH GRANT OPTION;"
  _l=$(printf '%s\n' "${_sql}" "SELECT CONCAT(Create_user_priv, Grant_priv) FROM mysql.user WHERE User = '${_uname}' AND Host = '${_R_ROW}';" \
    | _rdb_sql)
  if [ "${_l}" != "YY" ] || [ "$(_rdb_login "${_uname}" "${_p}")" != "${_uname}@${_R_ROW}" ]; then
    echo "ALRT: remote database ${_uname}: its own login '${_uname}'@'${_R_ROW}' on ${_R_DBHOST} could not be made and proven; nothing was switched"
    _rdb_undo
    return 1
  fi
  echo "UPDATE hosting_db_server SET db_user = '${_uname}', db_passwd = '${_p}' WHERE nid = ${_R_NODE} AND db_user IN ('aegir_root', '${_uname}');" \
    | _rdb_panel > /dev/null
  _l=$(echo "SELECT CONCAT('RDB|', IFNULL(SUM(db_user = '${_uname}' AND db_passwd = '${_p}'), 0), '|', IFNULL(SUM(db_user = 'aegir_root'), 0)) FROM hosting_db_server WHERE nid = ${_R_NODE};" \
    | _rdb_panel)
  if [[ ! "${_l}" =~ ^[1-9][0-9]*\|0$ ]] \
    || ! _rdb_alias_set "${_R_ALIAS}" "${_uname}" "${_p}"; then
    echo "ALRT: remote database ${_uname}: its panel's server records or its server alias could not be switched; putting all back"
    _rdb_undo
    return 1
  fi
  _rdb_files_put "${_p}" > /dev/null
  if ! _rdb_verify; then
    echo "ALRT: remote database ${_uname}: the verify of @${_R_SERVER} failed on its own login; putting all back on aegir_root"
    _rdb_undo
    return 1
  fi
  _R_SINCE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if ! _rdb_rec_write "${_rec}"; then
    echo "ALRT: remote database ${_uname}: switched, but its record ${_rec} could not be written; run this again"
    return 1
  fi
  rm -f -- "${_jr}"
  _n=$(_acct_in_real_dir "/data/disk/${_uname}" _rdb_pre_drop_here "${_A_OLD}")
  _r=$(cat /root/.my.pass.txt 2> /dev/null | tr -d '\n')
  if [ -n "${_r}" ] && [ "${_r}" != "${_A_OLD}" ]; then
    _c=$(_acct_in_real_dir "/data/disk/${_uname}" _rdb_pre_drop_here "${_r}")
    [[ "${_c}" =~ ^[0-9]+$ ]] && _n=$(( ${_n:-0} + _c ))
  fi
  echo "INFO: ${_uname} now logs in to ${_R_DBHOST} as '${_uname}'@'${_R_ROW}': its server alias ${_R_ALIAS}, its panel's server records and its password files hold that login's own password (record ${_rec}; saved ${_R_SAVED})"
  echo "INFO: ${_uname}: password file backups that held the shared password, removed: ${_n:-0}"
  _l=$(echo "SELECT Host FROM mysql.user WHERE User = '${_uname}' AND Host <> '${_R_ROW}' ORDER BY Host;" | _rdb_sql | tr '\n' ' ')
  if [ -n "${_l}" ]; then
    echo "NOTE: ${_uname}: other logins of its name on ${_R_DBHOST}, kept, not used by it: ${_l% }"
  fi
  echo "NOTE: ${_uname}: its panel backups made before the switch still hold the shared aegir_root password"
  return 0
}

# syncpass remote <oN> revert: the account back on the shared aegir_root
# login from what the switch saved, verified there, and only then its own
# login dropped. A revert whose verify fails keeps that login and leaves a
# journal, so apply or revert can be run again.
_rdb_revert() {
  local _rec="/root/.${_uname}.remote-db.txt" _jr="${_RDB_DIR}/${_uname}.apply" _src="" _c
  if ! _rdb_lock 300; then
    echo "ERROR: ${_uname}: another switch, revert or password sync of it is running; nothing was changed"
    return 1
  fi
  if _rdb_rec_read "${_jr}"; then
    _src="${_jr}"
  elif _rdb_rec_read "${_rec}"; then
    _src="${_rec}"
  else
    echo "INFO: ${_uname} is not switched here (no valid record or journal): nothing to revert"
    return 0
  fi
  if [ ! -s "${_R_SAVED}/alias" ] || [ ! -s "${_R_SAVED}/rows" ]; then
    echo "ERROR: ${_uname}: what the switch saved (${_R_SAVED}) is missing; nothing was changed"
    return 1
  fi
  _SQL_CONNECT="${_R_DBHOST}"
  _THIS_DB_PORT="${_R_PORT}"
  # the saved aegir_root password must still log in there (it may have been
  # changed since the switch), or the put-back would leave the account on a
  # login that fails
  _c=$(_acct_read_in "${_R_SAVED}" alias \
    | sed -n "s#.*'master_db' *=> *'mysql://aegir_root:\([^@']*\)@.*#\1#p" | head -n 1)
  if [[ ! "$(_rdb_login aegir_root "$(_rdb_urldecode "${_c}")")" =~ ^aegir_root@ ]]; then
    echo "ERROR: ${_uname}: the aegir_root password the switch saved (${_R_SAVED}/alias) does not log in to ${_R_DBHOST} now; nothing was changed"
    return 1
  fi
  _rdb_hold || return 1
  _c=$(cat -- "${_R_SAVED}/alias" && echo x)
  if ! _rdb_rows_restore "${_R_SAVED}/rows" \
    || ! _acct_in_real_dir "/data/disk/${_uname}/.drush" _acct_put_same_here "${_R_ALIAS}" "${_c%x}" \
    || ! _rdb_verify; then
    [ "${_src}" = "${_rec}" ] && mv -f -T -- "${_rec}" "${_jr}"
    echo "ALRT: remote database ${_uname}: put back on aegir_root from ${_R_SAVED}, but that did not verify; its own login '${_uname}'@'${_R_ROW}' is kept: run syncpass remote ${_uname} apply or revert again"
    return 1
  fi
  echo "DROP USER IF EXISTS '${_uname}'@'${_R_ROW}';" | _rdb_sql > /dev/null
  rm -f -- "${_rec}" "${_jr}"
  _rdb_files_put "$(_rdb_newpass)" > /dev/null
  echo "INFO: ${_uname} logs in to ${_R_DBHOST} with the shared aegir_root login again; '${_uname}'@'${_R_ROW}' dropped there"
  return 0
}

# syncpass remote <oN> status: the record and a login with it, or what
# stands in the way of a switch. Changes nothing.
_rdb_status() {
  local _p _l
  if _rdb_born_cut; then
    if _rdb_born_read; then
      echo "STATUS ${_uname}: its install made '${_uname}'@'${_R_ROW}' on ${_R_DBHOST} (${_R_SINCE}) and never recorded it: an install that ended runs syncpass remote ${_uname} born-end ok; one that did not is taken away by boa cleanup, which names that login"
    else
      echo "STATUS ${_uname}: the journal ${_RDB_DIR}/${_uname}.born of its install is not valid"
    fi
    return 1
  fi
  if _rdb_rec_read "${_RDB_DIR}/${_uname}.apply"; then
    echo "STATUS ${_uname}: a switch to '${_uname}'@'${_R_ROW}' on ${_R_DBHOST} was cut off (began ${_R_SINCE}): run syncpass remote ${_uname} apply, or revert"
    return 0
  fi
  if _rdb_rec_read "/root/.${_uname}.remote-db.txt"; then
    _SQL_CONNECT="${_R_DBHOST}"
    _THIS_DB_PORT="${_R_PORT}"
    _p=$(_rdb_alias_pass "${_uname}" "${_R_ALIAS}")
    _l="FAILED"
    [ -n "${_p}" ] && [ "$(_rdb_login "${_uname}" "${_p}")" = "${_uname}@${_R_ROW}" ] && _l="OK"
    echo "STATUS ${_uname}: switched since ${_R_SINCE}: '${_uname}'@'${_R_ROW}' on ${_R_DBHOST}:${_R_PORT}, alias ${_R_ALIAS} (@${_R_SERVER}), server node ${_R_NODE}, saved ${_R_SAVED}; login ${_l}"
    [ "${_l}" = "OK" ]
    return $?
  fi
  if ! _rdb_remote; then
    echo "STATUS ${_uname}: its databases are on this box's own server (${_THIS_DB_HOST})"
  elif _rdb_root_manages; then
    echo "STATUS ${_uname}: not switched: it logs in to ${_THIS_DB_HOST} with the login its server alias names; root from here can manage users there"
  else
    echo "STATUS ${_uname}: not switched: it logs in to ${_THIS_DB_HOST} with the login its server alias names; root from here cannot manage users there"
  fi
  return 0
}

# syncpass remote <oN> plan: what apply would do. Changes nothing.
_rdb_plan() {
  local _rc
  if _rdb_born_cut; then
    echo "PLAN ${_uname}: the login of its own its install made there was never recorded: see syncpass remote ${_uname} status. Nothing was changed"
    return 1
  fi
  if _rdb_rec_read "${_RDB_DIR}/${_uname}.apply"; then
    echo "PLAN ${_uname}: a switch was cut off (began ${_R_SINCE}): apply takes it up, revert undoes it"
    return 0
  fi
  if _rdb_rec_read "/root/.${_uname}.remote-db.txt"; then
    echo "PLAN ${_uname}: already switched to '${_uname}'@'${_R_ROW}' on ${_R_DBHOST}: nothing to do"
    return 0
  fi
  _rdb_check
  _rc=$?
  [ "${_rc}" = "2" ] && return 0
  [ "${_rc}" = "0" ] || return 1
  echo "PLAN ${_uname}: make '${_uname}'@'${_A_ROW}' on ${_THIS_DB_HOST} (${_A_PLUGIN}, all privileges with grant option, as aegir_root has them), prove its login, save ${_A_ALIAS} and the records of its panel's server node ${_A_NODE} under ${_RDB_DIR}, switch them and its password files to that login, verify @${_A_SERVER}, record it in /root/.${_uname}.remote-db.txt; on any failure all is put back. Nothing was changed"
  return 0
}

# syncpass fix <oN> for an account on a remote database server: no login of
# its name there is dropped or made again, and nothing found by its name
# alone is changed. Not switched: its password files get a new random
# password, which nothing reads after its install. Switched: its own login
# there gets a new password, proven before the record's alias and panel
# record take it, and set back when anything fails.
_rdb_fix() {
  local _rec="/root/.${_uname}.remote-db.txt" _jr="${_RDB_DIR}/${_uname}.apply" _old _p _l
  # a database broker control file of such an account is named, as the
  # broker serves it not, before anything is sent anywhere
  _db_broker_rekey "${_uname}"
  if ! _rdb_lock 300; then
    echo "ALRT: remote database ${_uname}: a switch or a revert of it is running; nothing was changed"
    return 1
  fi
  if [ -e "${_jr}" ] || [ -L "${_jr}" ]; then
    echo "ALRT: remote database ${_uname}: a switch to its own login was cut off: run syncpass remote ${_uname} apply, or revert; nothing was changed"
    return 1
  fi
  if _rdb_born_cut; then
    echo "ALRT: remote database ${_uname}: the login of its own its install made there was never recorded (${_RDB_DIR}/${_uname}.born): run syncpass remote ${_uname} status; nothing was changed"
    return 1
  fi
  if [ ! -e "${_rec}" ] && [ ! -L "${_rec}" ]; then
    if ! _p=$(_rdb_newpass) || ! _rdb_files_put "${_p}"; then
      echo "ERROR: Could not write ${_L_SYS}"
      return 1
    fi
    echo "INFO: ${_uname} logs in to ${_THIS_DB_HOST} with the login its server alias names; nothing was changed there, its password files are new"
    return 0
  fi
  if ! _rdb_rec_read "${_rec}"; then
    echo "ALRT: remote database ${_uname}: its record ${_rec} is not valid; nothing was changed"
    return 1
  fi
  if [ "${_R_DBHOST}" != "${_THIS_DB_HOST}" ]; then
    echo "ALRT: remote database ${_uname}: its record names ${_R_DBHOST}, its cnf ${_THIS_DB_HOST}; nothing was changed"
    return 1
  fi
  _SQL_CONNECT="${_R_DBHOST}"
  _THIS_DB_PORT="${_R_PORT}"
  _old=$(_rdb_alias_pass "${_uname}" "${_R_ALIAS}")
  if [ -z "${_old}" ]; then
    echo "ALRT: remote database ${_uname}: its server alias ${_R_ALIAS} does not log in as ${_uname}; nothing was changed"
    return 1
  fi
  if ! _p=$(_rdb_newpass); then
    echo "ALRT: remote database ${_uname}: no new password could be made; nothing was changed"
    return 1
  fi
  echo "ALTER USER '${_uname}'@'${_R_ROW}' IDENTIFIED BY '${_p}';" | _rdb_sql > /dev/null
  if [ "$(_rdb_login "${_uname}" "${_p}")" != "${_uname}@${_R_ROW}" ]; then
    echo "ALTER USER '${_uname}'@'${_R_ROW}' IDENTIFIED BY '$(_rdb_q "${_old}")';" | _rdb_sql > /dev/null
    _l="it keeps the one it has"
    [ "$(_rdb_login "${_uname}" "${_old}")" = "${_uname}@${_R_ROW}" ] \
      || _l="and the one it had could not be proven after the set-back: the next syncpass fix of it sets a new one"
    echo "ALRT: remote database ${_uname}: its own login '${_uname}'@'${_R_ROW}' on ${_R_DBHOST} could not take a new password; ${_l}"
    _rdb_files_put "${_old}" > /dev/null
    return 1
  fi
  echo "UPDATE hosting_db_server SET db_passwd = '${_p}' WHERE nid = ${_R_NODE} AND db_user = '${_uname}';" \
    | _rdb_panel > /dev/null
  _l=$(echo "SELECT CONCAT('RDB|', COUNT(*), '|', IFNULL(SUM(db_passwd = '${_p}'), 0)) FROM hosting_db_server WHERE nid = ${_R_NODE} AND db_user = '${_uname}';" \
    | _rdb_panel)
  # an empty or broken read-back (the panel not reached) is a failure too
  if [[ ! "${_l}" =~ ^([1-9][0-9]*)\|([0-9]+)$ ]] \
    || [ "${BASH_REMATCH[1]}" != "${BASH_REMATCH[2]}" ] \
    || ! _rdb_alias_set "${_R_ALIAS}" "${_uname}" "${_p}"; then
    echo "UPDATE hosting_db_server SET db_passwd = '$(_rdb_q "${_old}")' WHERE nid = ${_R_NODE} AND db_user = '${_uname}';" \
      | _rdb_panel > /dev/null
    [[ "${_old}" =~ ^[A-Za-z0-9]+$ ]] && _rdb_alias_set "${_R_ALIAS}" "${_uname}" "${_old}"
    echo "ALTER USER '${_uname}'@'${_R_ROW}' IDENTIFIED BY '$(_rdb_q "${_old}")';" | _rdb_sql > /dev/null
    _l="all set back to the one it has"
    [ "$(_rdb_login "${_uname}" "${_old}")" = "${_uname}@${_R_ROW}" ] \
      || _l="set back, but the one it had could not be proven after the set-back: the next syncpass fix of it sets a new one"
    echo "ALRT: remote database ${_uname}: its panel's server record or its server alias could not take the new password; ${_l}"
    _rdb_files_put "${_old}" > /dev/null
    return 1
  fi
  _rdb_files_put "${_p}" > /dev/null
  su -s /bin/bash - "${_uname}" -c "drush8 cc drush" > /dev/null 2>&1 8>&-
  echo "INFO: ${_uname}'s own login '${_uname}'@'${_R_ROW}' on ${_R_DBHOST} has a new password, in its server alias, its panel's server record and its password files"
  return 0
}

# syncpass remote <oN> born, run by the account's install alone, as root,
# before its panel is installed. Where root from this web head can manage
# users on the account's remote database server, a login of the account's
# own is made there at this web head's address, as apply makes one (the
# plugin and rights of the shared aegir_root login, which must open there
# with root's password), proven, and its password put in the account's two
# password files, which the install reads: the panel is then installed on
# that login, and root's password never enters the account's files. The
# journal is written before the login is made. Status 0 then; 2 where root
# from here cannot manage users there (a NOTE); any other status leaves
# nothing there and the install keeps the shared aegir_root login.
_rdb_born() {
  local _jr="${_RDB_DIR}/${_uname}.born" _r _l _c _plg _p _f
  if ! _rdb_lock 300; then
    echo "ERROR: ${_uname}: another switch, revert or password sync of it is running; nothing was changed"
    return 1
  fi
  if [ ! -e "/root/.${_uname}.octopus.cnf" ] || ! id -u "${_uname}" > /dev/null 2>&1 \
    || [ ! -d "/data/disk/${_uname}" ] || [ -e "/data/disk/${_uname}/log/cores.txt" ]; then
    echo "ERROR: ${_uname} is not an Octopus account being installed on this box"
    return 1
  fi
  if ! _rdb_remote; then
    echo "INFO: ${_uname}'s databases are on this box's own server (${_THIS_DB_HOST})"
    return 1
  fi
  for _f in "/root/.${_uname}.remote-db.txt" "${_RDB_DIR}/${_uname}.apply" "${_jr}"; do
    if [ -e "${_f}" ] || [ -L "${_f}" ]; then
      echo "NOTE: ${_uname}: ${_f} stands: its install keeps the shared aegir_root login"
      return 1
    fi
  done
  _rdb_gate || return $?
  if ! _l=$(_rdb_web_row); then
    echo "NOTE: ${_uname}: ${_THIS_DB_HOST} does not see this web head by an address: its install keeps the shared aegir_root login"
    return 1
  fi
  _c=$(echo "SELECT COUNT(*) FROM mysql.user WHERE User = '${_uname}' AND Host = '${_l}';" | _rdb_sql)
  if [ "${_c}" != "0" ]; then
    echo "NOTE: ${_uname}: ${_THIS_DB_HOST} already has the login '${_uname}'@'${_l}', which this install did not make: it keeps the shared aegir_root login"
    return 1
  fi
  _r=$(cat /root/.my.pass.txt 2> /dev/null | tr -d '\n')
  _c=$(_rdb_login aegir_root "${_r}")
  if [[ ! "${_c}" =~ ^aegir_root@ ]]; then
    echo "NOTE: ${_uname}: the shared aegir_root login does not open ${_THIS_DB_HOST} with root's password here: its install keeps it as it is"
    return 1
  fi
  _plg=$(echo "SELECT plugin FROM mysql.user WHERE CONCAT(User, '@', Host) = '$(_rdb_q "${_c}")';" | _rdb_sql)
  if [[ ! "${_plg}" =~ ^[a-z0-9_]+$ ]]; then
    echo "NOTE: ${_uname}: the login plugin of ${_c} could not be read: its install keeps the shared aegir_root login"
    return 1
  fi
  _R_DBHOST="${_THIS_DB_HOST}"
  _R_PORT="${_THIS_DB_PORT}"
  _R_ROW="${_l}"
  _R_SINCE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  rm -f -- "${_jr}.new"
  if ! mkdir -p "${_RDB_DIR}" || ! chmod 0700 "${_RDB_DIR}" || [ -L "${_RDB_DIR}" ] \
    || ! ( umask 077
      printf 'dbhost=%s\nport=%s\nrow=%s\nsince=%s\n' "${_R_DBHOST}" "${_R_PORT}" \
        "${_R_ROW}" "${_R_SINCE}" > "${_jr}.new" ) \
    || ! chmod 0600 "${_jr}.new" || ! mv -f -T -- "${_jr}.new" "${_jr}"; then
    echo "NOTE: ${_uname}: its journal ${_jr} could not be written: its install keeps the shared aegir_root login"
    return 1
  fi
  if ! _p=$(_rdb_newpass); then
    rm -f -- "${_jr}"
    echo "NOTE: ${_uname}: no new password could be made: its install keeps the shared aegir_root login"
    return 1
  fi
  _c=$(printf '%s\n' "CREATE USER '${_uname}'@'${_R_ROW}' IDENTIFIED WITH ${_plg} BY '${_p}';" \
    "GRANT ALL ON *.* TO '${_uname}'@'${_R_ROW}' WITH GRANT OPTION;" \
    "SELECT CONCAT(Create_user_priv, Grant_priv) FROM mysql.user WHERE User = '${_uname}' AND Host = '${_R_ROW}';" \
    | _rdb_sql)
  if [ "${_c}" != "YY" ] || [ "$(_rdb_login "${_uname}" "${_p}")" != "${_uname}@${_R_ROW}" ] \
    || ! _rdb_files_put "${_p}" > /dev/null; then
    echo "DROP USER IF EXISTS '${_uname}'@'${_R_ROW}';" | _rdb_sql > /dev/null
    rm -f -- "${_jr}"
    echo "ALRT: remote database ${_uname}: a login of its own '${_uname}'@'${_R_ROW}' on ${_R_DBHOST} could not be made and proven for its install; it keeps the shared aegir_root login"
    return 1
  fi
  echo "INFO: ${_uname}: its install logs in to ${_R_DBHOST} as '${_uname}'@'${_R_ROW}', a login of its own made there now (${_plg}, all privileges with grant option, as aegir_root has them)"
  return 0
}

# The account born switched made a switched account: the server alias its
# install wrote and its panel's server node of that host, each found by
# the account's own login, proven; what a revert needs saved (the alias and
# the node's records as the shared aegir_root login gives them, root's
# password in them, root's own under /var/backups/boa/remote-db); the
# record written as apply writes it; the journal removed. Status 1, with
# the journal and the login kept, when any of it cannot be done.
_rdb_born_settle() {
  local _jr="${_RDB_DIR}/${_uname}.born" _a _s _p _n _r _c _k _rows _v _nn _u _w _out=""
  _a=$(_acct_in_real_dir "/data/disk/${_uname}/.drush" _rdb_aliases_here "${_uname}" "${_R_DBHOST}")
  if [ -z "${_a}" ] || [ "$(printf '%s\n' "${_a}" | wc -l)" != "1" ] \
    || [[ ! "${_a}" =~ ^server_[A-Za-z0-9._-]+\.alias\.drushrc\.php$ ]]; then
    echo "ALRT: remote database ${_uname}: not exactly one server alias of its install logs in as ${_uname} on ${_R_DBHOST}"
    return 1
  fi
  _s=$(_acct_read_in "/data/disk/${_uname}/.drush" "${_a}" \
    | sed -n "s/^\$aliases\['\([^']*\)'\].*/\1/p" | head -n 1)
  _p=$(_rdb_alias_pass "${_uname}" "${_a}")
  if [[ ! "${_s}" =~ ^server_[A-Za-z0-9._-]+$ ]] || [ -z "${_p}" ] \
    || [ "$(_rdb_login "${_uname}" "${_p}")" != "${_uname}@${_R_ROW}" ]; then
    echo "ALRT: remote database ${_uname}: its server alias ${_a} does not log in as '${_uname}'@'${_R_ROW}'"
    return 1
  fi
  _n=$(echo "SELECT CONCAT('RDB|', n.nid) FROM node n JOIN hosting_db_server d ON d.vid = n.vid WHERE n.type = 'server' AND n.title = '$(_rdb_q "${_R_DBHOST}")' AND d.db_user = '${_uname}';" \
    | _rdb_panel)
  _rows=""
  [[ "${_n}" =~ ^[1-9][0-9]*$ ]] && _rows=$(_rdb_rows_read "${_n}")
  if [ -z "${_rows}" ]; then
    echo "ALRT: remote database ${_uname}: not exactly one server of its panel named ${_R_DBHOST} logs in as ${_uname}"
    return 1
  fi
  _r=$(cat /root/.my.pass.txt 2> /dev/null | tr -d '\n')
  if [[ ! "$(_rdb_login aegir_root "${_r}")" =~ ^aegir_root@ ]]; then
    echo "ALRT: remote database ${_uname}: the shared aegir_root login does not open ${_R_DBHOST} with root's password now, so no revert to it could be saved"
    return 1
  fi
  _R_ALIAS="${_a}"
  _R_SERVER="${_s}"
  _R_NODE="${_n}"
  _R_SAVED="${_RDB_DIR}/${_uname}-${_NOW}"
  _c=$(_acct_read_in "/data/disk/${_uname}/.drush" "${_a}" && echo x)
  # the passwords never reach sed's command line: sed writes a mark, the
  # shell puts the value in its place
  _k="RDBPASS${$}x${RANDOM}${RANDOM}${RANDOM}"
  if [ "${_c}" = "x" ] || [[ "${_c}" == *"${_k}"* ]]; then
    echo "ALRT: remote database ${_uname}: its server alias ${_a} could not be read"
    return 1
  fi
  _c=$(printf '%s' "${_c%x}" \
    | sed -E "/'master_db' *=>/ s#mysql://${_uname}:[^@']*@#mysql://aegir_root:${_k}@#"; echo x)
  _c="${_c//"${_k}"/$(_rdb_urlencode "${_r}")}"
  while IFS='|' read -r _v _nn _u _w; do
    _out="${_out}${_v}|${_nn}|$(_rdb_hex aegir_root)|$(_rdb_hex "${_r}")"$'\n'
  done <<< "${_rows}"
  if ! mkdir -m 0700 "${_R_SAVED}" \
    || ! ( umask 077; printf '%s' "${_c%x}" > "${_R_SAVED}/alias" \
      && printf '%s' "${_out}" > "${_R_SAVED}/rows" ) \
    || [ "$(_rdb_urldecode "$(_acct_read_in "${_R_SAVED}" alias \
      | sed -n "s#.*'master_db' *=> *'mysql://aegir_root:\([^@']*\)@.*#\1#p" | head -n 1)")" != "${_r}" ]; then
    echo "ALRT: remote database ${_uname}: what a revert needs could not be saved under ${_R_SAVED}"
    return 1
  fi
  _R_SINCE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if ! _rdb_rec_write "/root/.${_uname}.remote-db.txt"; then
    echo "ALRT: remote database ${_uname}: its record /root/.${_uname}.remote-db.txt could not be written"
    return 1
  fi
  rm -f -- "${_jr}"
  _rdb_files_put "${_p}" > /dev/null
  echo "INFO: ${_uname} is born switched: it logs in to ${_R_DBHOST} as '${_uname}'@'${_R_ROW}', its server alias ${_R_ALIAS}, its panel's server records and its password files hold that login's own password (record /root/.${_uname}.remote-db.txt; saved ${_R_SAVED}, for a revert to the shared aegir_root login)"
  return 0
}

# syncpass remote <oN> born-end ok|fail, run by the install that ran born,
# once its panel's install has returned. ok: the account is made a switched
# account (_rdb_born_settle); when that cannot be done, its login and the
# journal stay, the password syncs of it refuse, and this can be run again.
# fail: the login its install was to use is dropped there, the journal
# removed and the password files made random. Without a journal it changes
# nothing.
_rdb_born_end() {
  local _jr="${_RDB_DIR}/${_uname}.born"
  if ! _rdb_lock 300; then
    echo "ERROR: ${_uname}: another switch, revert or password sync of it is running; nothing was changed"
    return 1
  fi
  if ! _rdb_born_read; then
    if _rdb_born_cut; then
      echo "ALRT: remote database ${_uname}: the journal ${_jr} of its install is not valid; nothing was changed"
      return 1
    fi
    return 0
  fi
  _SQL_CONNECT="${_R_DBHOST}"
  _THIS_DB_PORT="${_R_PORT}"
  if [ "${1}" = "ok" ]; then
    _rdb_born_settle && return 0
    echo "ALRT: remote database ${_uname}: it logs in with its own login '${_uname}'@'${_R_ROW}', kept with the journal ${_jr}; its password syncs refuse until syncpass remote ${_uname} born-end ok is run again"
    return 1
  fi
  echo "DROP USER IF EXISTS '${_uname}'@'${_R_ROW}';" | _rdb_sql > /dev/null
  rm -f -- "${_jr}"
  _rdb_files_put "$(_rdb_newpass)" > /dev/null
  echo "INFO: ${_uname}: its install did not end: the login of its own '${_uname}'@'${_R_ROW}' made for it dropped on ${_R_DBHOST}"
  return 0
}

# syncpass remote <oN> plan|apply|revert|status
_rdb_main() {
  # a plain database user name, as the purge takes an account's
  if [[ ! "${_uname}" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || [ "${_uname}" = "aegir" ]; then
    echo "Usage: syncpass remote <oN> {plan|apply|revert|status}"
    exit 1
  fi
  _grp=$(_acct_group "${_uname}")
  _L_SYS="/data/disk/${_uname}/.${_uname}.pass.txt"
  _L_SYS_OWN="${_uname}:${_grp}"
  case "${_rdb_verb}" in
    plan) _rdb_plan ;;
    apply) _rdb_apply ;;
    revert) _rdb_revert ;;
    status) _rdb_status ;;
    born) _rdb_born ;;
    born-end)
      case "${_rdb_how}" in
        ok|fail) _rdb_born_end "${_rdb_how}" ;;
        *)
          echo "Usage: syncpass remote <oN> born-end {ok|fail}"
          exit 1
          ;;
      esac
      ;;
    *)
      echo "Usage: syncpass remote <oN> {plan|apply|revert|status}"
      exit 1
      ;;
  esac
  exit $?
}

_do_syncpass() {
  if [ ! -z "${_uname}" ]; then
    _find_correct_ip
    _prH="/var/aegir/.drush"
    if [ "${_uname}" = "aegir" ] && [ -e "/var/aegir/backups" ]; then
      _L_SYS="/var/aegir/backups/system/.aegir_root.pass.txt"
      _L_SYS_OWN="${_uname}:${_uname}"
      _keep_alias_copy "${_prH}" server_localhost.alias.drushrc.php \
        "${_vBs}/server_localhost.alias.drushrc.php.${_uname}-${_NOW}" &> /dev/null
      _keep_alias_copy "${_prH}" server_master.alias.drushrc.php \
        "${_vBs}/server_master.alias.drushrc.php.${_uname}-${_NOW}" &> /dev/null
      _check_generate
      if [ ! -z "${_ESC_PASS}" ] && [ ! -z "${_ENC_PASS}" ]; then
        mysql -u root -e "FLUSH NO_WRITE_TO_BINLOG HOSTS" &> /dev/null
        su -s /bin/bash - ${_uname} -c "drush8 @hostmaster \
          sqlq \"UPDATE hosting_db_server \
          SET db_passwd='${_ESC_PASS}' \
          WHERE db_user='aegir_root'\"" &> /dev/null
        wait
        _ESC="*.*"
        _USE_DB_USER="aegir_root"
        _USE_AEGIR_HOST="${_hName}"
        _USE_RESOLVEIP="${_LOC_IP}"
        [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL1 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -uroot"
        if [ -e "/root/.my.proxysql_adm_pwd.txt" ]; then
          _PROXYSQL_PASSWORD=$(cat /root/.my.proxysql_adm_pwd.txt 2>/dev/null | tr -d '\n')
          mysql -uadmin -p${_PROXYSQL_PASSWORD} -h127.0.0.1 -P6032 --protocol=tcp<<PROXYSQL
DELETE FROM mysql_users WHERE username='${_USE_DB_USER}';
DELETE FROM mysql_query_rules WHERE username='${_USE_DB_USER}';
INSERT INTO mysql_users (username,password,default_hostgroup) VALUES ('${_USE_DB_USER}','${_ESC_PASS}','10');
LOAD MYSQL USERS TO RUNTIME;
SAVE MYSQL USERS FROM RUNTIME;
SAVE MYSQL USERS TO DISK;
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_USE_DB_USER}',10,1);
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_USE_DB_USER}',11,1);
LOAD MYSQL QUERY RULES TO RUNTIME;
SAVE MYSQL QUERY RULES TO DISK;
PROXYSQL
        fi
        _C_SQL="mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp --database=mysql -e"
        ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'${_USE_AEGIR_HOST}';" &> /dev/null
        ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'${_USE_RESOLVEIP}';" &> /dev/null
        ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'localhost';" &> /dev/null
        ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'127.0.0.1';" &> /dev/null
        ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'%';" &> /dev/null
        mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -u root mysql<<EOFMYSQL
CREATE USER IF NOT EXISTS '${_USE_DB_USER}'@'localhost';
CREATE USER IF NOT EXISTS '${_USE_DB_USER}'@'%';
GRANT ALL ON ${_ESC} TO '${_USE_DB_USER}'@'localhost' WITH GRANT OPTION;
GRANT ALL ON ${_ESC} TO '${_USE_DB_USER}'@'%' WITH GRANT OPTION;
ALTER USER '${_USE_DB_USER}'@'localhost' IDENTIFIED BY '${_ESC_PASS}';
ALTER USER '${_USE_DB_USER}'@'%' IDENTIFIED BY '${_ESC_PASS}';
EOFMYSQL
        _acct_in_real_dir "${_prH}" _sed_server_aliases_here \
          "s/mysql:\/\/aegir_root:.*/mysql:\/\/aegir_root:${_ENC_PASS}@${_SQL_CONNECT}',/g" \
          &> /dev/null
        wait
        mysqladmin -u root flush-privileges &> /dev/null
        # Where the database broker keeps a baseline of the server's own
        # logins, aegir_root on this box's own server is recorded again as
        # it is now.
        case "${_SQL_CONNECT}" in
          localhost|127.0.0.1)
            if [ -x /usr/local/bin/boa-dbctl ] && [ -d /var/lib/mysql/boa_dbreg ] \
              && [ ! -e /root/.standby.cnf ] \
              && ! /usr/local/bin/boa-dbctl baseline rerecord aegir_root > /dev/null 2>&1 < /dev/null; then
              echo "ALRT: the database broker's record of aegir_root was not renewed: see boa-dbctl baseline plan"
            fi
            ;;
        esac
      else
        echo "ERROR: Auto-generated password for aegir_root system user"
        echo "ERROR: did not work as expected, please try again"
        exit 1
      fi
      echo "INFO: Fixed Ægir Master Instance system user=aegir_root"
      echo "INFO: New system password=${_ESC_PASS} encoded=${_ENC_PASS}"
      echo "BYE!"
    else
      if [ -e "/data/disk/${_uname}" ]; then
        # a control panel an aegir2boa db-import left half made, on a box
        # armed for the web group: its password is not changed under it
        # (the panel's server record, the database login, the aliases)
        # until the import is finished or undone
        if [ -s /etc/boa/control/instgrp-web-arm.ready.txt ] \
          && _a2b_import_unfinished "${_uname}"; then
          echo "ERROR: ${_uname}: its aegir2boa db-import is unfinished, its control panel half made; nothing was changed. $(_a2b_import_advice "${_uname}"). Then run syncpass fix ${_uname} again"
          exit 1
        fi
        _grp=$(_acct_group "${_uname}")
        _L_SYS="/data/disk/${_uname}/.${_uname}.pass.txt"
        _L_SYS_OWN="${_uname}:${_grp}"
        _keep_alias_copy "/data/disk/${_uname}/.drush" server_localhost.alias.drushrc.php \
          "${_vBs}/server_localhost.alias.drushrc.php.${_uname}-${_NOW}" &> /dev/null
        _keep_alias_copy "/data/disk/${_uname}/.drush" server_master.alias.drushrc.php \
          "${_vBs}/server_master.alias.drushrc.php.${_uname}-${_NOW}" &> /dev/null
        if _rdb_remote; then
          _rdb_fix
          _rc=$?
          echo "INFO: Fixed Ægir Satellite Instance system user=${_uname}"
          echo "INFO: With Satellite oct_db_host=${_THIS_DB_HOST}"
          echo "BYE!"
          exit "${_rc}"
        fi
        _check_generate
        if [ ! -z "${_ESC_PASS}" ] && [ ! -z "${_ENC_PASS}" ]; then
          if [ -e "/data/conf/${_uname}_use_proxysql.txt" ]; then
            _SQL_CONNECT=127.0.0.1
            _THIS_DB_PORT=6033
            mysql -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -e "FLUSH NO_WRITE_TO_BINLOG HOSTS" &> /dev/null
          else
            mysql -u root -e "FLUSH NO_WRITE_TO_BINLOG HOSTS" &> /dev/null
          fi
          su -s /bin/bash - ${_uname} -c "drush8 @hostmaster \
            sqlq \"UPDATE hosting_db_server SET db_passwd='${_ESC_PASS}' \
            WHERE db_user='${_uname}'\"" &> /dev/null
          wait
          _ESC="*.*"
          _USE_DB_USER="${_uname}"
          _USE_AEGIR_HOST="${_hName}"
          _USE_RESOLVEIP="${_LOC_IP}"
          [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL2 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -uroot"
          if [ -e "/root/.my.proxysql_adm_pwd.txt" ]; then
            _PROXYSQL_PASSWORD=$(cat /root/.my.proxysql_adm_pwd.txt 2>/dev/null | tr -d '\n')
            mysql -uadmin -p${_PROXYSQL_PASSWORD} -h127.0.0.1 -P6032 --protocol=tcp<<PROXYSQL
DELETE FROM mysql_users WHERE username='${_USE_DB_USER}';
DELETE FROM mysql_query_rules WHERE username='${_USE_DB_USER}';
INSERT INTO mysql_users (username,password,default_hostgroup) VALUES ('${_USE_DB_USER}','${_ESC_PASS}','10');
LOAD MYSQL USERS TO RUNTIME;
SAVE MYSQL USERS FROM RUNTIME;
SAVE MYSQL USERS TO DISK;
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_USE_DB_USER}',10,1);
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_USE_DB_USER}',11,1);
LOAD MYSQL QUERY RULES TO RUNTIME;
SAVE MYSQL QUERY RULES TO DISK;
PROXYSQL
          fi
          if ! _db_broker_rekey "${_uname}"; then
            _C_SQL="mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp --database=mysql -e"
            ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'${_USE_AEGIR_HOST}';" &> /dev/null
            ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'${_USE_RESOLVEIP}';" &> /dev/null
            ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'localhost';" &> /dev/null
            ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'127.0.0.1';" &> /dev/null
            ${_C_SQL} "DROP USER '${_USE_DB_USER}'@'%';" &> /dev/null
            mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -u root mysql<<EOFMYSQL
CREATE USER IF NOT EXISTS '${_USE_DB_USER}'@'localhost';
CREATE USER IF NOT EXISTS '${_USE_DB_USER}'@'%';
GRANT ALL ON ${_ESC} TO '${_USE_DB_USER}'@'localhost' WITH GRANT OPTION;
GRANT ALL ON ${_ESC} TO '${_USE_DB_USER}'@'%' WITH GRANT OPTION;
ALTER USER '${_USE_DB_USER}'@'localhost' IDENTIFIED BY '${_ESC_PASS}';
ALTER USER '${_USE_DB_USER}'@'%' IDENTIFIED BY '${_ESC_PASS}';
EOFMYSQL
          fi
          _acct_in_real_dir "/data/disk/${_uname}/.drush" _sed_server_aliases_here \
            "s/mysql:\/\/${_uname}:.*/mysql:\/\/${_uname}:${_ENC_PASS}@${_SQL_CONNECT}',/g" \
            &> /dev/null
          wait
          if [ -e "/data/conf/${_uname}_use_proxysql.txt" ]; then
            _SQL_CONNECT=127.0.0.1
            _THIS_DB_PORT=6033
            mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges &> /dev/null
          else
            mysqladmin -u root flush-privileges &> /dev/null
          fi
        else
          echo "ERROR: Auto-generated password for ${_uname} system user"
          echo "ERROR: did not work as expected, please try again"
          exit 1
        fi
        _L_SYS_PHP="/data/disk/${_uname}/.${_uname}.pass.php"
        _put_pass_php || echo "ERROR: Could not write ${_L_SYS_PHP}"
        echo "INFO: Fixed Ægir Satellite Instance system user=${_uname}"
        echo "INFO: New system password=${_ESC_PASS} encoded=${_ENC_PASS}"
        echo "INFO: With Satellite oct_db_host=${_OCT_DB_HOST_W}"
        echo "INFO: With Satellite oct_db_port=${_THIS_DB_PORT}"
        echo "BYE!"
      else
        echo "ERROR: You must specify the existing Ægir \
          instance username to fix"
        exit 1
      fi
    fi
    exit 0
  else
    echo "ERROR: You must specify the existing Ægir instance username to fix"
    exit 1
  fi
}

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    chmod a+w /dev/null
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    ### An account's databases are where its own cnf says, as its Octopus
    ### pass reads it; the box's value only where the cnf names none.
    if [ -n "${_uname}" ] && [ "${_uname}" != "aegir" ]; then
      _aDbH=$(_acct_cnf_value "${_uname}" _THIS_DB_HOST)
      [ -n "${_aDbH}" ] && _THIS_DB_HOST="${_aDbH}"
    fi
    if [ "${_THIS_DB_HOST}" = "localhost" ] \
      || [ "${_THIS_DB_HOST}" = "FQDN" ]; then
      _SQL_CONNECT=localhost
    elif [ "${_THIS_DB_HOST}" = "127.0.0.1" ] \
      || [ "${_THIS_DB_HOST}" = "PROXYSQL" ]; then
      _SQL_CONNECT=127.0.0.1
    else
      _SQL_CONNECT="${_THIS_DB_HOST}"
      ### Remote DB server mode: the master instance still uses the local
      ### DB server, as the upgrade sets it up, while aegir_root on the DB
      ### head is the credential the instances there share, so it is never
      ### dropped, re-created or given a new password from here. Host and
      ### port as the upgrade uses them for the master.
      if [ "${_uname}" = "aegir" ] \
        && [ "${_THIS_DB_HOST}" != "${_MY_OWNIP}" ]; then
        _SQL_CONNECT=localhost
        _THIS_DB_PORT=3306
        if [ -e "/var/aegir/use_proxysql.txt" ]; then
          _THIS_DB_PORT=6033
        fi
      fi
    fi
    if [ "${_THIS_DB_HOST}" = "${_MY_OWNIP}" ]; then
      _SQL_CONNECT=localhost
    fi
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  # A test, not ||: tr exits 0 on an empty /etc/hostname
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n')"
  [ -n "${_hName}" ] || _hName="$(hostname -f 2>/dev/null)"
}

case "$1" in
  fix) _uname="$2"
       _check_root
       _do_syncpass
  ;;
  remote) _uname="$2"
       _rdb_verb="$3"
       _rdb_how="$4"
       _check_root
       _rdb_main
  ;;
  *)   echo "Usage: syncpass fix {aegir|o1}"
       echo "       syncpass remote <oN> {plan|apply|revert|status}"
       exit 1
  ;;
esac

exit 0
