# Parse arguments
for arg in "$@"; do
  case "$arg" in
    --compact|--quiet) _VERBOSE=0; _COMPACT=1 ;;
    --verbose) _VERBOSE=1; _COMPACT=0 ;;
    --no-dbtest) _DBTEST_ENABLED=NO ;;
    --dbtest-heavy) _DBTEST_HEAVY=YES ;;
    --keep-db) _DBTEST_KEEP_DB=YES ;;
    -h|--help) _usage; exit 0 ;;
    *)
      echo "Unknown option: $arg"
      _usage
      exit 1
      ;;
  esac
done

