# Parse fio JSON and return values via stdout (key=value lines)
_parse_fio_json() {
  # $1 = json file
  local _json_file="$1"
  local _read_iops _write_iops _read_bw_kib _write_bw_kib
  _read_iops="$(jq -r '[.jobs[].read.iops] | add' "${_json_file}" 2>/dev/null)"
  _write_iops="$(jq -r '[.jobs[].write.iops] | add' "${_json_file}" 2>/dev/null)"
  _read_bw_kib="$(jq -r '[.jobs[].read.bw] | add' "${_json_file}" 2>/dev/null)" # KiB/s
  _write_bw_kib="$(jq -r '[.jobs[].write.bw] | add' "${_json_file}" 2>/dev/null)" # KiB/s

  local _read_clat_ns_mean _write_clat_ns_mean
  _read_clat_ns_mean="$(jq -r '([.jobs[].read.clat_ns.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
  _write_clat_ns_mean="$(jq -r '([.jobs[].write.clat_ns.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"

  local _read_lat_ms _write_lat_ms
  if [ -n "${_read_clat_ns_mean}" ] && [ -n "${_write_clat_ns_mean}" ]; then
    _read_lat_ms="$(awk -v ns="${_read_clat_ns_mean}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
    _write_lat_ms="$(awk -v ns="${_write_clat_ns_mean}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  else
    local _read_clat_usec_mean _write_clat_usec_mean
    _read_clat_usec_mean="$(jq -r '([.jobs[].read.clat.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
    _write_clat_usec_mean="$(jq -r '([.jobs[].write.clat.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
    _read_lat_ms="$(awk -v us="${_read_clat_usec_mean:-0}" 'BEGIN{printf "%.2f", us/1000.0}')"
    _write_lat_ms="$(awk -v us="${_write_clat_usec_mean:-0}" 'BEGIN{printf "%.2f", us/1000.0}')"
  fi

  local _read_bw_mb _write_bw_mb
  _read_bw_mb="$(awk -v kib="${_read_bw_kib:-0}" 'BEGIN{printf "%.2f", kib/1024.0}')"
  _write_bw_mb="$(awk -v kib="${_write_bw_kib:-0}" 'BEGIN{printf "%.2f", kib/1024.0}')"


  # Optional percentiles (fio3+): clat_ns.percentile
  local _read_p95_ns _read_p99_ns _write_p95_ns _write_p99_ns
  local _read_p95_ms _read_p99_ms _write_p95_ms _write_p99_ms

  _read_p95_ns="$(jq -r '([.jobs[].read.clat_ns.percentile["95.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _read_p99_ns="$(jq -r '([.jobs[].read.clat_ns.percentile["99.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _write_p95_ns="$(jq -r '([.jobs[].write.clat_ns.percentile["95.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _write_p99_ns="$(jq -r '([.jobs[].write.clat_ns.percentile["99.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"

  if [ -n "${_read_p95_ns}" ]; then
    _read_p95_ms="$(awk -v ns="${_read_p95_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_read_p99_ns}" ]; then
    _read_p99_ms="$(awk -v ns="${_read_p99_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_write_p95_ns}" ]; then
    _write_p95_ms="$(awk -v ns="${_write_p95_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_write_p99_ns}" ]; then
    _write_p99_ms="$(awk -v ns="${_write_p99_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi

  echo "READ_IOPS=${_read_iops}"
  echo "WRITE_IOPS=${_write_iops}"
  echo "READ_BW_MB=${_read_bw_mb}"
  echo "WRITE_BW_MB=${_write_bw_mb}"
  echo "READ_LAT_MS=${_read_lat_ms}"
  echo "WRITE_LAT_MS=${_write_lat_ms}"
  echo "READ_P95_MS=${_read_p95_ms}"
  echo "READ_P99_MS=${_read_p99_ms}"
  echo "WRITE_P95_MS=${_write_p95_ms}"
  echo "WRITE_P99_MS=${_write_p99_ms}"
}

# Simple metadata / small file operations test
_run_metadata_test() {
  # $1 = mountpoint
  # $2 = output var name (global)
  local _mount_point="$1"
  local _outvar="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_meta_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || { eval "${_outvar}=\"ERROR\""; return; }

  local _count="${_METADATA_FILE_COUNT}"
  local _start _end _elapsed _ops _ops_per_sec

  _start="$(date +%s.%N)"
  local _i
  for _i in $(seq 1 "${_count}"); do
    echo "x" > "${_test_dir}/file_${_i}" || break
  done
  for _i in $(seq 1 "${_count}"); do
    cat "${_test_dir}/file_${_i}" >/dev/null 2>&1 || break
  done
  rm -f "${_test_dir}"/file_* >/dev/null 2>&1
  rmdir "${_test_dir}" >/dev/null 2>&1 || true
  _end="$(date +%s.%N)"

  _elapsed="$(echo "${_end} - ${_start}" | bc -l 2>/dev/null || echo 0)"
  _ops=$((_count * 2))
  if [ "${_elapsed}" != "0" ]; then
    _ops_per_sec="$(echo "${_ops} / ${_elapsed}" | bc -l 2>/dev/null || echo 0)"
    eval "${_outvar}=\"$(printf '%.2f' "${_ops_per_sec}") ops/s\""
  else
    eval "${_outvar}=\"ERROR\""
  fi
}

# Run sysbench CPU and extract events/sec and avg latency
_run_sysbench_cpu() {
  # $1 = threads
  # $2 = label (for variable names)
  local _threads="$1"
  local _label="$2"
  local _test
  _test="$(sysbench cpu --threads="${_threads}" --time="${_SYSBENCH_CPU_TIME}" run 2>/dev/null)"
  local _events _lat
  _events="$(echo "${_test}" | awk '/events per second:/ {print $4}')"
  _lat="$(echo "${_test}" | awk '/avg:/ {print $2}')"
  eval "_cpu_events_${_label}=\"${_events}\""
  eval "_cpu_latency_${_label}=\"${_lat}\""
}

# PHP micro-benchmark: multi-run median + concurrent throughput
_run_php_benchmarks() {
  if ! command -v php >/dev/null 2>&1; then
    _php_time_median="N/A (php not installed)"
    _php_time_runs=""
    _php_concurrency_wall="N/A"
    _php_concurrency_throughput="N/A"
    return
  fi

  local _script="/tmp/phpbench.php"
  cat << 'EOF' > "${_script}"
<?php
$iterations = getenv('PHP_BENCH_ITERATIONS') ? intval(getenv('PHP_BENCH_ITERATIONS')) : 50000;
$start = microtime(true);
$acc = 0;
for ($i = 0; $i < $iterations; $i++) {
  $s = "the quick brown fox jumps over the lazy dog " . $i;
  $h = hash('sha256', $s, false);
  $acc += ord($h[0]);
}
$elapsed = microtime(true) - $start;
printf("%.6f\n", $elapsed);
EOF

  local _runs="${_PHP_BENCH_RUNS}"
  local _times=()
  local _i
  echo "Running PHP single-thread benchmark (${_runs} runs, iterations=${_PHP_BENCH_ITERATIONS})..."
  for _i in $(seq 1 "${_runs}"); do
    local _t
    _t="$(PHP_BENCH_ITERATIONS="${_PHP_BENCH_ITERATIONS}" php "${_script}" 2>/dev/null || echo 0)"
    _log " Run ${_i}: ${_t} seconds"
    _times+=("${_t}")
  done

  # Median (PHP_BENCH_RUNS is 5, so 3rd value after sort)
  local _sorted
  _sorted=($(printf '%s\n' "${_times[@]}" | sort -n))
  _php_time_median="${_sorted[2]}"
  _php_time_runs="$(printf '%s ' "${_times[@]}")"

  # Concurrent benchmark
  local _conc
  local _nproc
  _nproc="$(nproc)"
  if [ "${_nproc}" -le 0 ]; then
    _nproc=1
  fi
  if [ "${_nproc}" -gt "${_PHP_BENCH_CONCURRENCY_MAX}" ]; then
    _conc="${_PHP_BENCH_CONCURRENCY_MAX}"
  else
    _conc="${_nproc}"
  fi

  echo "Running PHP concurrent benchmark (${_conc} processes, iterations=${_PHP_BENCH_ITERATIONS} each)..."
  local _start _end _elapsed
  _start="$(date +%s.%N)"
  for _i in $(seq 1 "${_conc}"); do
    PHP_BENCH_ITERATIONS="${_PHP_BENCH_ITERATIONS}" php "${_script}" >/dev/null 2>&1 &
  done
  wait
  _end="$(date +%s.%N)"
  _elapsed="$(echo "${_end} - ${_start}" | bc -l 2>/dev/null || echo 0)"
  _php_concurrency_wall="$(printf '%.6f' "${_elapsed}")"

  if [ "${_elapsed}" != "0" ]; then
    local _total_ops
    _total_ops="$(echo "${_conc} * ${_PHP_BENCH_ITERATIONS}" | bc -l 2>/dev/null || echo 0)"
    local _thr
    _thr="$(echo "${_total_ops} / ${_elapsed}" | bc -l 2>/dev/null || echo 0)"
    _php_concurrency_throughput="$(printf '%.2f ops/sec' "${_thr}")"
  else
    _php_concurrency_throughput="N/A"
  fi

  rm -f "${_script}" >/dev/null 2>&1
}

# ----
# BOA-specific grading helpers
# ----
_num_or_empty() {
  printf '%s' "$1" | grep -Eo '^[0-9]+(\.[0-9]+)?' || true
}

_boa_grade_mem_bw() {
  # input: numeric MiB/s (bandwidth)
  # Kept for backward compatibility; prefers DRAM-focused membench output.
  awk -v v="$1" 'BEGIN{
    if (v>=60000) print "ultra";
    else if (v>=40000) print "excellent";
    else if (v>=25000) print "good";
    else if (v>=15000) print "average";
    else print "low";
  }'
}

_boa_grade_mem_final() {
  # Inputs:
  #   $1 = bandwidth MiB/s
  #   $2 = pointer-chase latency in ns (optional)
  # BOA in-memory heavy workloads benefit from both high bandwidth and low tail-ish latency.
  local _bw _lat _g
  _bw="$(_num_or_empty "$1")"
  _lat="$(_num_or_empty "$2")"

  _g="$(_boa_grade_mem_bw "${_bw}")"

  # Apply latency caps (best-effort; prevents "ultra" on cache-only measurements)
  if [ -n "${_lat}" ]; then
    if awk -v n="${_lat}" 'BEGIN{exit !(n>=220)}' 2>/dev/null; then
      _g="low"
    elif awk -v n="${_lat}" 'BEGIN{exit !(n>=170)}' 2>/dev/null; then
      if [ "${_g}" = "ultra" ] || [ "${_g}" = "excellent" ] || [ "${_g}" = "good" ]; then
        _g="average"
      fi
    elif awk -v n="${_lat}" 'BEGIN{exit !(n>=130)}' 2>/dev/null; then
      if [ "${_g}" = "ultra" ] || [ "${_g}" = "excellent" ]; then
        _g="good"
      fi
    fi
  fi

  echo "${_g}"
}

_boa_grade_cpu_steal() {
  # input: percent
  awk -v s="$1" 'BEGIN{
    if (s=="" || s=="N/A") print "unknown";
    else if (s<1) print "excellent";
    else if (s<3) print "good";
    else if (s<7) print "warning";
    else print "bad";
  }'
}

_boa_grade_cpu_speed() {
  # input: single-thread events/sec
  # Based on typical BOA workloads (Drupal PHP)
  awk -v eps="$1" 'BEGIN{
    if (eps=="" || eps=="N/A") print "unknown";
    else if (eps>=5000) print "ultra";
    else if (eps>=4000) print "excellent";
    else if (eps>=3000) print "good";
    else if (eps>=2000) print "average";
    else if (eps>=1000) print "acceptable";
    else print "poor";
  }'
}

_boa_grade_disk_final() {
  # Inputs: $1=ioping_avg_us, $2=seq_read_mbps, $3=seq_write_mbps, $4=read_iops, $5=write_iops, $6=meta_ops, $7=qd1_p99_read_ms, $8=qd1_p99_write_ms
  # BOA-realistic: Sequential WRITE is critical (Drupal writes, cache, logs)
  # Priority: seq_write (blocker) > seq_read > IOPS > ioping > metadata
  local ioping_us="$1"
  local seq_read_mbps="$2"
  local seq_write_mbps="$3"
  local read_iops="$4"
  local write_iops="$5"
  local meta_ops="$6"
  local qd1_p99_read_ms="$7"
  local qd1_p99_write_ms="$8"
  local qd1_fsync_p99_write_ms="$9"

  # Extract numeric values
  ioping_us="$(_num_or_empty "${ioping_us}")"
  seq_read_mbps="$(_num_or_empty "${seq_read_mbps}")"
  seq_write_mbps="$(_num_or_empty "${seq_write_mbps}")"
  read_iops="$(_num_or_empty "${read_iops}")"
  write_iops="$(_num_or_empty "${write_iops}")"
  meta_ops="$(_num_or_empty "${meta_ops}")"
  qd1_p99_read_ms="$(_num_or_empty "${qd1_p99_read_ms}")"
  qd1_p99_write_ms="$(_num_or_empty "${qd1_p99_write_ms}")"
  qd1_fsync_p99_write_ms="$(_num_or_empty "${qd1_fsync_p99_write_ms}")"

  # CRITICAL CHECK: Sequential write < 100 MB/s = BAD (throttled/failing disk)
  if [ -n "${seq_write_mbps}" ]; then
    if awk -v sw="${seq_write_mbps}" 'BEGIN{exit !(sw<100)}' 2>/dev/null; then
      echo "bad"
      return
    fi
  fi

  # Now grade based on combined metrics
  local grade="poor"

  # Check if we have both read and write
  if [ -n "${seq_read_mbps}" ] && [ -n "${seq_write_mbps}" ]; then
    # EXCELLENT: NVMe-class (write > 1000 AND read > 2000)
    if awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>1000 && sr>2000)}' 2>/dev/null; then
      grade="excellent"
    # GOOD: Healthy SSD (write > 500 AND read > 1000)
    elif awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>500 && sr>1000)}' 2>/dev/null; then
      grade="good"
    # OK: Moderate (write > 300 AND read > 500)
    elif awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>300 && sr>500)}' 2>/dev/null; then
      grade="average"
    # POOR: Below thresholds but not catastrophic
    else
      grade="poor"
    fi
  fi

  # Boost grade if IOPS are excellent (11k+ = NVMe-class)
  if [ -n "${read_iops}" ] && [ -n "${write_iops}" ]; then
    if awk -v ri="${read_iops}" -v wi="${write_iops}" 'BEGIN{exit !(ri>10000 && wi>10000)}' 2>/dev/null; then
      # Excellent IOPS - upgrade one level
      case "${grade}" in
        poor) grade="average" ;;
        average) grade="good" ;;
        good) grade="excellent" ;;
      esac
    fi
  fi

  # ioping reality check: if ioping shows bad latency, downgrade
  if [ -n "${ioping_us}" ]; then
    if awk -v i="${ioping_us}" 'BEGIN{exit !(i>2000)}' 2>/dev/null; then
      # Very bad real latency - downgrade one level
      case "${grade}" in
        excellent) grade="good" ;;
        good) grade="average" ;;
        average) grade="poor" ;;
      esac
    fi
  fi

  # QD=1 p99 latency caps (Drupal/DB feel). Best-effort: if missing, no effect.
  if [ -n "${qd1_p99_write_ms}" ]; then
    # Force-poor if p99 write latency is extremely high
    if awk -v p="${qd1_p99_write_ms}" 'BEGIN{exit !(p>150)}' 2>/dev/null; then
      grade="poor"
    elif awk -v p="${qd1_p99_write_ms}" 'BEGIN{exit !(p>60)}' 2>/dev/null; then
      # cap at average
      case "${grade}" in
        excellent|good) grade="average" ;;
      esac
    elif awk -v p="${qd1_p99_write_ms}" 'BEGIN{exit !(p>20)}' 2>/dev/null; then
      # cap at good
      case "${grade}" in
        excellent) grade="good" ;;
      esac
    fi
  fi


  # QD=1 fsync p99 write latency caps (DB durability realism). Best-effort: if missing, no effect.
  if [ -n "${qd1_fsync_p99_write_ms}" ]; then
    if awk -v p="${qd1_fsync_p99_write_ms}" 'BEGIN{exit !(p>250)}' 2>/dev/null; then
      grade="poor"
    elif awk -v p="${qd1_fsync_p99_write_ms}" 'BEGIN{exit !(p>120)}' 2>/dev/null; then
      case "${grade}" in
        excellent|good) grade="average" ;;
      esac
    elif awk -v p="${qd1_fsync_p99_write_ms}" 'BEGIN{exit !(p>40)}' 2>/dev/null; then
      case "${grade}" in
        excellent) grade="good" ;;
      esac
    fi
  fi
  echo "${grade}"
}

_boa_grade_network() {
  # input: numeric MiB/s
  awk -v n="$1" 'BEGIN{
    if (n=="" || n=="N/A") print "unknown";
    else if (n>=150) print "ultra";
    else if (n>=100) print "excellent";
    else if (n>=75) print "good";
    else if (n>=50) print "average";
    else print "poor";
  }'
}

_boa_guess_storage_tier() {
  # Inputs (numeric, best-effort):
  # $1 = ioping_avg_us
  # $2 = seq_read_mbps
  # $3 = seq_write_mbps
  # $4 = qd1_p99_read_ms
  # $5 = qd1_p99_write_ms
  local ioping_us="$1"
  local sr="$2"
  local sw="$3"
  local p99r="$4"
  local p99w="$5"
  local p99wf="$6"

  # Hard fail / severely throttled
  if [ -n "${sw}" ] && awk -v sw="${sw}" 'BEGIN{exit !(sw<100)}' 2>/dev/null; then
    echo "CRITICAL_DEGRADED"
    return
  fi

  # Normalize unknowns
  [ -n "${ioping_us}" ] || ioping_us=""
  [ -n "${p99r}" ] || p99r=""
  [ -n "${p99w}" ] || p99w=""

  # Helper lambdas (awk comparisons)
  # Tiering heuristics (production vs backup tiers)
  # NOTE: Use multiple signals to reduce misclassification on bursty network storage.

  # Production: local fast NVMe
  if [ -n "${sr}" ] && [ -n "${sw}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" 'BEGIN{exit !(sw>=1200 && sr>=2500)}' 2>/dev/null; then
    if [ -n "${p99w}" ] && awk -v p="${p99w}" 'BEGIN{exit !(p<=5)}' 2>/dev/null; then
      echo "PROD_LOCAL_NVME"
      return
    fi
    if [ -n "${ioping_us}" ] && awk -v u="${ioping_us}" 'BEGIN{exit !(u<=400)}' 2>/dev/null; then
      echo "PROD_LOCAL_NVME"
      return
    fi
  fi

  # Production: local SSD / slower NVMe
  if [ -n "${sr}" ] && [ -n "${sw}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" 'BEGIN{exit !(sw>=400 && sr>=800)}' 2>/dev/null; then
    if [ -n "${p99w}" ] && awk -v p="${p99w}" 'BEGIN{exit !(p<=20)}' 2>/dev/null; then
      echo "PROD_LOCAL_SSD"
      return
    fi
    if [ -n "${ioping_us}" ] && awk -v u="${ioping_us}" 'BEGIN{exit !(u<=1200)}' 2>/dev/null; then
      echo "PROD_LOCAL_SSD"
      return
    fi
  fi

  # Backup: network NVMe-ish / good network block storage
  if [ -n "${sr}" ] && [ -n "${sw}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" 'BEGIN{exit !(sw>=450 && sr>=450)}' 2>/dev/null; then
    if [ -n "${p99w}" ] && awk -v p="${p99w}" 'BEGIN{exit !(p<=60)}' 2>/dev/null; then
      if [ -n "${p99wf}" ] && awk -v p="${p99wf}" 'BEGIN{exit !(p>120)}' 2>/dev/null; then
        # Durability is slow -> treat as network SSD tier
        echo "BACKUP_NET_SSD"
        return
      fi
      echo "BACKUP_NET_NVME"
      return
    fi
  fi

  # Backup: network SSD / slower attached
  if [ -n "${sr}" ] && [ -n "${sw}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" 'BEGIN{exit !(sw>=200 && sr>=400)}' 2>/dev/null; then
    if [ -n "${p99w}" ] && awk -v p="${p99w}" 'BEGIN{exit !(p<=150)}' 2>/dev/null; then
      echo "BACKUP_NET_SSD"
      return
    fi
  fi

  echo "DEGRADED"
}

_print_disk_compact_section() {
  # $1 = mountpoint, $2 = short description (header hint)
  local _mp="$1"
  local _desc="$2"

  local _seqw _seqr _riops _wiops _meta
  local _rbw _wbw _rlat _wlat
  local _seek_line _ioping_avg _ioping_avg_us
  local _seqw_num _seqr_num _riops_num _wiops_num _meta_num
  local _disk_grade

  _seqw="${_fio_seqwrite_bw_write["${_mp}"]:-N/A}"
  _seqr="${_fio_seqread_bw_read["${_mp}"]:-N/A}"
  _riops="${_fio_rand_iops_read["${_mp}"]:-N/A}"
  _wiops="${_fio_rand_iops_write["${_mp}"]:-N/A}"
  _meta="${_meta_ops["${_mp}"]:-N/A}"

  _rbw="${_fio_rand_bw_read["${_mp}"]:-N/A}"
  _wbw="${_fio_rand_bw_write["${_mp}"]:-N/A}"
  _rlat="${_fio_rand_latency_read["${_mp}"]:-N/A}"
  _wlat="${_fio_rand_latency_write["${_mp}"]:-N/A}"

  _seek_line="${_ioping_seek_line["${_mp}"]:-N/A}"
  _ioping_avg="$(echo "${_seek_line}" | grep -oP '\d+\.\d+ us' | head -2 | tail -1 2>/dev/null)"
  [ -n "${_ioping_avg}" ] || _ioping_avg="N/A"
  _ioping_avg_us="$(echo "${_seek_line}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1 2>/dev/null)"

  _seqw_num="$(_num_or_empty "$(echo "${_seqw}" | awk '{print $1}')")"
  _seqr_num="$(_num_or_empty "$(echo "${_seqr}" | awk '{print $1}')")"
  _riops_num="$(_num_or_empty "${_riops}")"
  _wiops_num="$(_num_or_empty "${_wiops}")"
  _meta_num="$(_num_or_empty "$(echo "${_meta}" | awk '{print $1}')")"

  _qd1_p95_r="${_fio_qd1_p95_read["${_mp}"]:-N/A}"
  _qd1_p95_w="${_fio_qd1_p95_write["${_mp}"]:-N/A}"
  _qd1_p99_r="${_fio_qd1_p99_read["${_mp}"]:-N/A}"
  _qd1_p99_w="${_fio_qd1_p99_write["${_mp}"]:-N/A}"
  _qd1_fsync_p95_w="${_fio_qd1_fsync_p95_write["${_mp}"]:-N/A}"
  _qd1_fsync_p99_w="${_fio_qd1_fsync_p99_write["${_mp}"]:-N/A}"

  _qd1_p99_r_num="$(_num_or_empty "$(echo "${_qd1_p99_r}" | awk "{print \$1}")")"
  _qd1_p99_w_num="$(_num_or_empty "$(echo "${_qd1_p99_w}" | awk "{print \$1}")")"
  _qd1_fsync_p99_w_num="$(_num_or_empty "$(echo "${_qd1_fsync_p99_w}" | awk "{print \$1}")")"

  _disk_grade="$(_boa_grade_disk_final "${_ioping_avg_us}" "${_seqr_num}" "${_seqw_num}" "${_riops_num}" "${_wiops_num}" "${_meta_num}" "${_qd1_p99_r_num}" "${_qd1_p99_w_num}" "${_qd1_fsync_p99_w_num}" "${root_qd1_fsync_p99_w_num}")"
  _storage_tier="$(_boa_guess_storage_tier "${_ioping_avg_us}" "${_seqr_num}" "${_seqw_num}" "${_qd1_p99_r_num}" "${_qd1_p99_w_num}" "${_qd1_fsync_p99_w_num}")"

  echo " ============================================================================="
  if [ "${_mp}" = "/" ]; then
    echo " == 3. DISK (Root partition / main filesystem)                              =="
  else
    printf " == 3. DISK (%s) (Mounted extra filesystem) \n" "${_mp}"
  fi
  echo " ============================================================================="
  echo ""
  printf "   Sequential write (CRITICAL): %s\n" "${_seqw}"
  printf "   Sequential read:             %s\n" "${_seqr}"
  printf "   Random 4K IOPS:              %s read / %s write\n" "${_riops}" "${_wiops}"
  printf "   Real latency (ioping avg):   %s\n" "${_ioping_avg}"
  printf "   Metadata ops:                %s\n" "${_meta}"
  printf "   Random 4K QD1 p95/p99:        %s / %s read, %s / %s write\n" "${_qd1_p95_r}" "${_qd1_p99_r}" "${_qd1_p95_w}" "${_qd1_p99_w}"
  printf "   Random 4K QD1 fsync p95/p99:  %s / %s write\n" "${_qd1_fsync_p95_w}" "${_qd1_fsync_p99_w}"
  printf "   Storage tier guess:          %s\n" "${_storage_tier}"
  echo ""
  printf "   Details (fio synthetic latency):\n"
  printf "     Random 4K read:   %s @ %s\n" "${_rbw}" "${_rlat}"
  printf "     Random 4K write:  %s @ %s\n" "${_wbw}" "${_wlat}"
  echo ""

  if [ "${_disk_grade}" = "bad" ]; then
    echo "   ❌ CRITICAL: Sequential write < 100 MB/s - disk is throttled or failing!"
    echo "      This will severely impact BOA performance (cache writes, logs, DB)"
  elif [ "${_disk_grade}" = "poor" ]; then
    echo "   ⚠️  Disk profile looks weak (slow SSD/attached)"
  elif [ "${_disk_grade}" = "average" ]; then
    echo "   ✅  Average disk performance for BOA workloads"
  elif [ "${_disk_grade}" = "good" ]; then
    echo "   🌟  Good disk performance for BOA workloads"
  elif [ "${_disk_grade}" = "excellent" ]; then
    echo "   🏆  Excellent disk performance (NVMe-class)"
  fi
  echo ""
}

_print_compact_summary() {
  echo " ============================================================================="
  echo " ==                 BOA Performance Test - Compact Summary                  =="
  echo " ==      Priority: Memory > CPU > Disk > Network (for Drupal caching)       =="
  echo " ============================================================================="
  echo ""
  echo "System:"
  echo ""
  if [ -x "/opt/local/bin/screenfetch" ]; then
    bash /opt/local/bin/screenfetch -n
  else
    echo "Host:  ${_hostname}"
    echo "CPU:   ${_cpu_info}"
    echo "vCPUs: ${_cpu_cores}"
    _total_ram_mb="$(free -m | awk '/^Mem:/ {print $2}')"
    echo "RAM:   ${_total_ram_mb} MB"
  fi
  echo ""

  # Extract numeric values
  local mem_mibps mem_lat cpu_steal st_eps mt_eps aes_mibps net_mibps
  local rand_read_lat seq_read_mbps seq_write_mbps ioping_avg_us meta_ops_num
  local read_iops write_iops

  mem_mibps="$(_num_or_empty "$(echo "${_mem_transfer_speed}" | awk '{print $1}')")"
  mem_lat="$(_num_or_empty "${_mem_latency}")"
  cpu_steal="${_cpu_steal_mt}"
  st_eps="$(_num_or_empty "${_cpu_events_ST}")"
  mt_eps="$(_num_or_empty "${_cpu_events_MT_NPROC}")"
  aes_mibps="$(_num_or_empty "$(echo "${_aes_mibps}" | awk '{print $1}')")"
  net_mibps="$(_num_or_empty "$(echo "${_net_download}" | awk '{print $1}')")"

  rand_read_lat="$(_num_or_empty "$(echo "${_root_rand_lat_read}" | awk '{print $1}')")"
  seq_read_mbps="$(_num_or_empty "$(echo "${_root_seqread_bw_read}" | awk '{print $1}')")"
  seq_write_mbps="$(_num_or_empty "$(echo "${_root_seqwrite_bw_write}" | awk '{print $1}')")"
  meta_ops_num="$(_num_or_empty "$(echo "${_root_meta_ops}" | awk '{print $1}')")"
  read_iops="$(_num_or_empty "${_fio_rand_iops_read["/"]}")"
  write_iops="$(_num_or_empty "${_fio_rand_iops_write["/"]}")"

  # Extract ioping avg latency (format: "min/avg/max/mdev = 28.3 us / 126.5 us / ...")
  ioping_avg_us="$(echo "${_ioping_seek}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1)"

  # Calculate grades
  local mem_grade steal_grade cpu_grade disk_grade net_grade
  mem_grade="$(_boa_grade_mem_final "${mem_mibps:-0}" "${mem_lat}")"
  steal_grade="$(_boa_grade_cpu_steal "${cpu_steal}")"
  cpu_grade="$(_boa_grade_cpu_speed "${st_eps}")"
  root_qd1_p99_r_num="$(_num_or_empty "$(echo "${_root_qd1_p99_read}" | awk "{print \$1}")")"
  root_qd1_p99_w_num="$(_num_or_empty "$(echo "${_root_qd1_p99_write}" | awk "{print \$1}")")"
  root_qd1_fsync_p99_w_num="$(_num_or_empty "$(echo "${_root_qd1_fsync_p99_write}" | awk "{print \$1}")")"
  disk_grade="$(_boa_grade_disk_final "${ioping_avg_us}" "${seq_read_mbps}" "${seq_write_mbps}" "${read_iops}" "${write_iops}" "${meta_ops_num}" "${root_qd1_p99_r_num}" "${root_qd1_p99_w_num}")"
  net_grade="$(_boa_grade_network "${net_mibps}")"

  echo " ============================================================================="
  echo " == 1. MEMORY (Critical for APC/Valkey/OPcache + Nginx microcaching)        =="
  echo " ============================================================================="
  echo ""
  printf "   Bandwidth:  %-20s Grade: [%s]\n" "${_mem_transfer_speed}" "${mem_grade}"
  if [ -n "${_mem_latency}" ]; then
    printf "   Latency:    %-20s\n" "${_mem_latency} ${_mem_latency_unit}"
  else
    printf "   Latency:    %-20s\n" "N/A"
  fi
  if [ -n "${_mem_bench_size_mib:-}" ]; then
    echo "   Bench:      ${_mem_bench_size_mib} MiB per buffer x2 (~${_mem_bench_total_mib} MiB total), ${_mem_bench_threads} threads (median of ${_MEM_BENCH_REPEATS})"
    if [ -n "${_mem_bw_min}" ] && [ -n "${_mem_bw_max}" ]; then
      echo "   Variance:   ${_mem_bw_min}-${_mem_bw_max} MiB/s (bw), ${_mem_lat_min}-${_mem_lat_max} ns (lat)"
    fi
  fi
  echo ""

  if [ "${mem_grade}" = "low" ]; then
    echo "   ⚠️  Low memory bandwidth - may limit BOA caching under heavy load"
  elif [ "${mem_grade}" = "average" ]; then
    echo "   ✅  Average memory bandwidth for in-memory caching"
  elif [ "${mem_grade}" = "good" ]; then
    echo "   🌟  Good memory bandwidth for in-memory caching"
  elif [ "${mem_grade}" = "excellent" ]; then
    echo "   🏆  Excellent memory bandwidth for in-memory caching"
  elif [ "${mem_grade}" = "ultra" ]; then
    echo "   🚀  Ultra memory bandwidth for in-memory caching"
  fi
  echo ""

  echo " ============================================================================="
  echo " == 2. CPU (Drupal/PHP runtime; watch steal on oversold nodes)              =="
  echo " ============================================================================="
  echo ""
  printf "   Single-thread:  %-15s events/sec  [%s] (most important)\n" "${_cpu_events_ST}" "${cpu_grade}"
  printf "   Multi-thread:   %-15s events/sec  (${_cpu_cores} vCPUs)\n" "${_cpu_events_MT_NPROC}"
  printf "   CPU Steal:      %-15s%%  [%s]\n" "${cpu_steal:-N/A}" "${steal_grade}"
  printf "   AES Throughput: %-15s (crypto/compression)\n" "${_aes_mibps}"
  echo ""

  if [ -n "${cpu_steal}" ] && [ "${cpu_steal}" != "N/A" ]; then
    if awk -v s="${cpu_steal}" 'BEGIN{exit !(s>=7)}' 2>/dev/null; then
      echo "   ❌ HIGH CPU steal - oversold host, NOT recommended for production"
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s>=3)}' 2>/dev/null; then
      echo "   ⚠️  Elevated CPU steal - will cause latency spikes under load"
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s<1)}' 2>/dev/null; then
      echo "   🏆  Excellent CPU steal - minimal noisy neighbor impact"
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s<3)}' 2>/dev/null; then
      echo "   ☑️  Minimal CPU steal - but may cause latency spikes under load"
    fi
  fi

  if [ "${cpu_grade}" = "poor" ]; then
    echo "   ❌ CPU performance too slow for BOA"
  elif [ "${cpu_grade}" = "acceptable" ]; then
    echo "   ☑️  Acceptable CPU performance but not optimal"
  elif [ "${cpu_grade}" = "average" ]; then
    echo "   ✅  Average CPU performance"
  elif [ "${cpu_grade}" = "good" ]; then
    echo "   🌟  Good CPU performance "
  elif [ "${cpu_grade}" = "excellent" ]; then
    echo "   🏆  Excellent CPU performance"
  elif [ "${cpu_grade}" = "ultra" ]; then
    echo "   🚀  Ultra CPU performance"
  fi
  echo ""

  # DISK (root is used for overall rating; other mounts are informational)
  _print_disk_compact_section "/" "Root partition / main filesystem"
  local _mp
  for _mp in "${_test_mounts[@]}"; do
    if [ "${_mp}" != "/" ]; then
      _print_disk_compact_section "${_mp}" "Mounted extra filesystem"
    fi
  done


  echo " ============================================================================="
  echo " == 4. NETWORK (Sanity check)                                               =="
  echo " ============================================================================="
  echo ""
  printf "   Public IPv4:        %s\n" "${_net_ipv4}"
  printf "   Download score:     %-15s [%s]\n" "${_net_download}" "${net_grade}"
  printf "   Score: avg of best 2/4 single-stream pulls (range ~10 MiB, timeout %ss)\n" "${_NET_TIMEOUT}"
  if [ "${#_net_dl_name[@]}" -gt 0 ]; then
    local _i
    _i=0
    while [ "${_i}" -lt "${#_net_dl_name[@]}" ]; do
      printf "     - %-10s %s\n" "${_net_dl_name[${_i}]}:" "${_net_dl_pretty[${_i}]}"
      _i=$((_i + 1))
    done
    [ -n "${_net_dl_top2}" ] && printf "   Top 2: %s\n" "${_net_dl_top2}"
  fi
  echo ""

  if [ "${net_grade}" = "poor" ]; then
    echo "   ⚠️  Slow network - may affect external API calls and package updates"
  elif [ "${net_grade}" = "average" ]; then
    echo "   ✅  Average network speed"
  elif [ "${net_grade}" = "good" ]; then
    echo "   🌟  Good network speed"
  elif [ "${net_grade}" = "excellent" ]; then
    echo "   🏆  Excellent network speed"
  elif [ "${net_grade}" = "ultra" ]; then
    echo "   🚀  Ultra network speed"
  fi
  echo ""

  echo " ============================================================================="
  echo " == BOA SUITABILITY SUMMARY                                                 =="
  echo " ============================================================================="

  local _issues=0
  local _warnings=0

  # Memory
  if [ "${mem_grade}" = "low" ]; then
    echo "   ❌ Memory bandwidth too low for BOA"
    _issues=$((_issues + 1))
  fi

  # CPU speed
  if [ "${cpu_grade}" = "poor" ]; then
    echo "   ❌ CPU performance too slow for BOA"
    _issues=$((_issues + 1))
  elif [ "${cpu_grade}" = "acceptable" ]; then
    echo "   ⚠️  CPU performance acceptable but not optimal"
    _warnings=$((_warnings + 1))
  fi

  # CPU steal
  if [ "${steal_grade}" = "bad" ]; then
    echo "   ❌ CPU steal critically high - oversold host, NOT recommended"
    _issues=$((_issues + 1))
  elif [ "${steal_grade}" = "warning" ]; then
    echo "   ⚠️  CPU steal elevated - may cause latency spikes"
    _warnings=$((_warnings + 1))
  fi

  # Disk
  if [ "${disk_grade}" = "bad" ]; then
    echo "   ❌ CRITICAL: Sequential write < 100 MB/s - disk is throttled or failing!"
    _warnings=$((_warnings + 1))
  elif [ "${disk_grade}" = "poor" ]; then
    echo "   ⚠️  Slow disk - may impact deployments"
    _warnings=$((_warnings + 1))
  fi

  # Network
  if [ "${net_grade}" = "poor" ]; then
    echo "   ⚠️  Slow network - not suitable for high traffic sites"
    _warnings=$((_warnings + 1))
  fi

  # Summary
  if [ "${_issues}" -eq 0 ] && [ "${_warnings}" -eq 0 ]; then
    echo ""
    echo "   ✅  This host is well-suited for BOA deployment"
    echo "   ✅  All critical metrics meet recommended thresholds"
  elif [ "${_issues}" -eq 0 ]; then
    echo ""
    echo "   ⚠️  This host is acceptable for BOA (${_warnings} minor warning(s))"
    echo "      Should work fine for most BOA workloads"
  else
    echo ""
    echo "   ❌ This host has ${_issues} critical issue(s)"
    echo "      NOT recommended for production BOA deployment"
  fi

  echo ""
  echo " ============================================================================="
  echo ""
  echo "For detailed metrics, run: perftest --verbose"
  echo ""
}

# ----
# Main
# ----

# Parse arguments
for arg in "$@"; do
  case "$arg" in
    --compact|--quiet) _VERBOSE=0; _COMPACT=1 ;;
    --verbose) _VERBOSE=1; _COMPACT=0 ;;
    -h|--help) _usage; exit 0 ;;
    *)
      echo "Unknown option: $arg"
      _usage
      exit 1
      ;;
  esac
done

_check_root

# Update package list silently
apt-get update -qq >/dev/null 2>&1

# Required packages
_check_and_install_package "curl"
_check_and_install_package "openssl"
_check_and_install_package "fio"
_check_and_install_package "jq"
_check_and_install_package "sysstat" # mpstat
_check_and_install_package "bc"
_ensure_sysbench

echo ""
echo "Starting performance tests..."
echo ""

# Basic system info
_hostname="$(hostname)"
_cpu_info="$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//')"
_cpu_cores="$(nproc 2>/dev/null || echo N/A)"

if [ "${_VERBOSE}" -eq 1 ]; then
  echo "Host: ${_hostname}"
  echo "CPU: ${_cpu_info}"
  echo "vCPUs: ${_cpu_cores}"
  echo ""
  echo "Block devices (lsblk):"
  lsblk -o NAME,TYPE,SIZE,ROTA | sed 's/^/  /'
  echo ""
fi

if command -v php >/dev/null 2>&1 && [ "${_VERBOSE}" -eq 1 ]; then
  echo "PHP version:"
  php -v | sed 's/^/  /'
  echo ""
fi

# CPU Performance Tests
echo "Running CPU performance tests with sysbench..."
_cpu_steal_mt="$(_measure_cpu_steal 1)" # initial check

# Multi-threaded: nproc
if command -v mpstat >/dev/null 2>&1; then
  mpstat 1 "${_SYSBENCH_CPU_TIME}" >/tmp/perftest_mpstat_mt.txt 2>/dev/null &
  _mpstat_pid="$!"
fi

_run_sysbench_cpu "$(nproc)" "MT_NPROC"

if [ -n "${_mpstat_pid:-}" ]; then
  wait "${_mpstat_pid}" >/dev/null 2>&1
  _cpu_steal_mt="$(awk '/^[0-9]/ { steal_sum += $(NF); steal_cnt++ } END { if (steal_cnt>0) printf "%.2f", steal_sum/steal_cnt }' /tmp/perftest_mpstat_mt.txt 2>/dev/null)"
  rm -f /tmp/perftest_mpstat_mt.txt >/dev/null 2>&1
fi

# Single-threaded
_run_sysbench_cpu 1 "ST"

# 4-thread
_run_sysbench_cpu 4 "MT4"

# Memory Performance Test (DRAM-focused)
echo "Running Memory performance test (DRAM-focused membench)..."
_run_mem_benchmarks

# AES throughput (nench-inspired)
echo "Running AES throughput test (openssl enc, ${_AES_TEST_MIB} MiB)..."
_run_aes_throughput_test

# PHP Performance Tests (single + concurrent)
echo "Running PHP performance tests..."
_run_php_benchmarks

# Disk I/O Performance Tests
_log "Detecting mounted filesystems to test (root + real mounted partitions; excluding /boot*)..."
mapfile -t _test_mounts < <(_get_test_mounts)

# ioping latency (nench-inspired)
echo "Running ioping quick latency checks (${_IOPING_SECONDS}s)..."
declare -A _ioping_seek_line
declare -A _ioping_seqread_line
_run_ioping_quick_mounts

# IPv4 network sanity check (CDN with fallback)
echo "Running IPv4 network check (4 tests, ${_NET_TIMEOUT}s timeout)..."
_run_ipv4_net_check

declare -A _fio_rand_iops_read
declare -A _fio_rand_iops_write
declare -A _fio_rand_bw_read
declare -A _fio_rand_bw_write
declare -A _fio_rand_latency_read
declare -A _fio_rand_latency_write
declare -A _fio_seqread_bw_read
declare -A _fio_seqread_latency_read
declare -A _fio_seqwrite_bw_write
declare -A _fio_seqwrite_latency_write
declare -A _fio_qd1_p95_read
declare -A _fio_qd1_p95_write
declare -A _fio_qd1_p99_read
declare -A _fio_qd1_p99_write
declare -A _fio_qd1_fsync_p95_write
declare -A _fio_qd1_fsync_p99_write
declare -A _meta_ops

# For CSV summary (root mount)
_root_rand_bw_read=""
_root_rand_bw_write=""
_root_rand_lat_read=""
_root_rand_lat_write=""
_root_seqread_bw_read=""
_root_seqread_lat_read=""
_root_seqwrite_bw_write=""
_root_seqwrite_lat_write=""
_root_meta_ops=""
_root_qd1_p95_read=""
_root_qd1_p95_write=""
_root_qd1_p99_read=""
_root_qd1_p99_write=""
    _root_qd1_fsync_p95_write="${_fio_qd1_fsync_p95_write["${_mount_point}"]}"
    _root_qd1_fsync_p99_write="${_fio_qd1_fsync_p99_write["${_mount_point}"]}"

for _mount_point in "${_test_mounts[@]}"; do
  echo "Running Disk I/O tests on ${_mount_point}..."
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"

  # Random 4k read/write
  _rand_output="/tmp/fio_rand_${_safe_mount_point}_$$.json"
  if _run_fio_rand_test "${_mount_point}" "${_rand_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_IOPS) _fio_rand_iops_read["${_mount_point}"]="${_v}" ;;
        WRITE_IOPS) _fio_rand_iops_write["${_mount_point}"]="${_v}" ;;
        READ_BW_MB) _fio_rand_bw_read["${_mount_point}"]="${_v} MB/s" ;;
        WRITE_BW_MB) _fio_rand_bw_write["${_mount_point}"]="${_v} MB/s" ;;
        READ_LAT_MS) _fio_rand_latency_read["${_mount_point}"]="${_v} ms" ;;
        WRITE_LAT_MS) _fio_rand_latency_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_rand_output}")
  else
    _fio_rand_iops_read["${_mount_point}"]="ERROR"
    _fio_rand_iops_write["${_mount_point}"]="ERROR"
    _fio_rand_bw_read["${_mount_point}"]="ERROR"
    _fio_rand_bw_write["${_mount_point}"]="ERROR"
    _fio_rand_latency_read["${_mount_point}"]="ERROR"
    _fio_rand_latency_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_rand_output}" >/dev/null 2>&1

  # Sequential read
  _seqread_output="/tmp/fio_seqread_${_safe_mount_point}_$$.json"
  if _run_fio_seq_read_test "${_mount_point}" "${_seqread_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_BW_MB) _fio_seqread_bw_read["${_mount_point}"]="${_v} MB/s" ;;
        READ_LAT_MS) _fio_seqread_latency_read["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_seqread_output}")
  else
    _fio_seqread_bw_read["${_mount_point}"]="ERROR"
    _fio_seqread_latency_read["${_mount_point}"]="ERROR"
  fi
  rm -f "${_seqread_output}" >/dev/null 2>&1

  # Sequential write
  _seqwrite_output="/tmp/fio_seqwrite_${_safe_mount_point}_$$.json"
  if _run_fio_seq_write_test "${_mount_point}" "${_seqwrite_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        WRITE_BW_MB) _fio_seqwrite_bw_write["${_mount_point}"]="${_v} MB/s" ;;
        WRITE_LAT_MS) _fio_seqwrite_latency_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_seqwrite_output}")
  else
    _fio_seqwrite_bw_write["${_mount_point}"]="ERROR"
    _fio_seqwrite_latency_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_seqwrite_output}" >/dev/null 2>&1


  # Random 4k randrw QD=1 (latency percentiles for tiering)
  echo "Running QD=1 random latency test on ${_mount_point}..."
  _qd1_output="/tmp/fio_qd1_${_safe_mount_point}_$$.json"
  if _run_fio_qd1_test "${_mount_point}" "${_qd1_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_P95_MS) [ -n "${_v}" ] && _fio_qd1_p95_read["${_mount_point}"]="${_v} ms" ;;
        WRITE_P95_MS) [ -n "${_v}" ] && _fio_qd1_p95_write["${_mount_point}"]="${_v} ms" ;;
        READ_P99_MS) [ -n "${_v}" ] && _fio_qd1_p99_read["${_mount_point}"]="${_v} ms" ;;
        WRITE_P99_MS) [ -n "${_v}" ] && _fio_qd1_p99_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_qd1_output}")
  else
    _fio_qd1_p95_read["${_mount_point}"]="ERROR"
    _fio_qd1_p95_write["${_mount_point}"]="ERROR"
    _fio_qd1_p99_read["${_mount_point}"]="ERROR"
    _fio_qd1_p99_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_qd1_output}" >/dev/null 2>&1

  # Random 4k randwrite QD=1 with fsync (durability realism)
  echo "Running QD=1 fsync write test on ${_mount_point}..."
  _qd1_fsync_output="/tmp/fio_qd1_fsync_${_safe_mount_point}_$$.json"
  if _run_fio_qd1_fsync_test "${_mount_point}" "${_qd1_fsync_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        WRITE_P95_MS) [ -n "${_v}" ] && _fio_qd1_fsync_p95_write["${_mount_point}"]="${_v} ms" ;;
        WRITE_P99_MS) [ -n "${_v}" ] && _fio_qd1_fsync_p99_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_qd1_fsync_output}")
  else
    _fio_qd1_fsync_p95_write["${_mount_point}"]="ERROR"
    _fio_qd1_fsync_p99_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_qd1_fsync_output}" >/dev/null 2>&1

  # Metadata test
  _run_metadata_test "${_mount_point}" "_meta_ops[\"${_mount_point}\"]"

  # Capture root mount metrics for CSV
  if [ "${_mount_point}" = "/" ]; then
    _root_rand_bw_read="${_fio_rand_bw_read["${_mount_point}"]}"
    _root_rand_bw_write="${_fio_rand_bw_write["${_mount_point}"]}"
    _root_rand_lat_read="${_fio_rand_latency_read["${_mount_point}"]}"
    _root_rand_lat_write="${_fio_rand_latency_write["${_mount_point}"]}"
    _root_seqread_bw_read="${_fio_seqread_bw_read["${_mount_point}"]}"
    _root_seqread_lat_read="${_fio_seqread_latency_read["${_mount_point}"]}"
    _root_seqwrite_bw_write="${_fio_seqwrite_bw_write["${_mount_point}"]}"
    _root_seqwrite_lat_write="${_fio_seqwrite_latency_write["${_mount_point}"]}"
    _root_meta_ops="${_meta_ops["${_mount_point}"]}"
    _root_qd1_p95_read="${_fio_qd1_p95_read["${_mount_point}"]}"
    _root_qd1_p95_write="${_fio_qd1_p95_write["${_mount_point}"]}"
    _root_qd1_p99_read="${_fio_qd1_p99_read["${_mount_point}"]}"
    _root_qd1_p99_write="${_fio_qd1_p99_write["${_mount_point}"]}"
  fi
done

