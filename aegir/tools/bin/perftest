_mem_test="$(sysbench memory --threads="$(nproc)" --time="${_SYSBENCH_MEM_TIME}" run 2>/dev/null)"
_mem_transfer_speed="$(echo "${_mem_test}" | awk '/transferred/ {gsub("[()]","",$(NF-1)); print $(NF-1)" "$(NF)}')"
_mem_transfer_speed=$(echo -n "${_mem_transfer_speed}" | tr -d ")" 2>&1)
_mem_latency="$(echo "${_mem_test}" | awk '/avg:/ {print $2}')"

# AES throughput (nench-inspired)
