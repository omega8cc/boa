echo "Running IPv4 network check (Cloudflare CDN, ${_NET_TIMEOUT}s timeout)..."
_run_ipv4_net_check

declare -A _fio_rand_iops_read
declare -A _fio_rand_iops_write
declare -A _fio_rand_bw_read
declare -A _fio_rand_bw_write
declare -A _fio_rand_latency_read
declare -A _fio_rand_latency_write
declare -A _fio_seqread_bw_read
declare -A _fio_seqread_latency_read
declare -A _fio_seqwrite_bw_write
declare -A _fio_seqwrite_latency_write
declare -A _meta_ops

# For CSV summary (root mount)
_root_rand_bw_read=""
_root_rand_bw_write=""
_root_rand_lat_read=""
_root_rand_lat_write=""
_root_seqread_bw_read=""
_root_seqread_lat_read=""
_root_seqwrite_bw_write=""
_root_seqwrite_lat_write=""
_root_meta_ops=""

for _mount_point in "${_test_mounts[@]}"; do
  echo "Running Disk I/O tests on ${_mount_point}..."
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"

  # Random 4k read/write
  _rand_output="/tmp/fio_rand_${_safe_mount_point}_$$.json"
  if _run_fio_rand_test "${_mount_point}" "${_rand_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_IOPS) _fio_rand_iops_read["${_mount_point}"]="${_v}" ;;
        WRITE_IOPS) _fio_rand_iops_write["${_mount_point}"]="${_v}" ;;
        READ_BW_MB) _fio_rand_bw_read["${_mount_point}"]="${_v} MB/s" ;;
        WRITE_BW_MB) _fio_rand_bw_write["${_mount_point}"]="${_v} MB/s" ;;
        READ_LAT_MS) _fio_rand_latency_read["${_mount_point}"]="${_v} ms" ;;
        WRITE_LAT_MS) _fio_rand_latency_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_rand_output}")
  else
    _fio_rand_iops_read["${_mount_point}"]="ERROR"
    _fio_rand_iops_write["${_mount_point}"]="ERROR"
    _fio_rand_bw_read["${_mount_point}"]="ERROR"
    _fio_rand_bw_write["${_mount_point}"]="ERROR"
    _fio_rand_latency_read["${_mount_point}"]="ERROR"
    _fio_rand_latency_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_rand_output}" >/dev/null 2>&1

  # Sequential read
  _seqread_output="/tmp/fio_seqread_${_safe_mount_point}_$$.json"
  if _run_fio_seq_read_test "${_mount_point}" "${_seqread_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_BW_MB) _fio_seqread_bw_read["${_mount_point}"]="${_v} MB/s" ;;
        READ_LAT_MS) _fio_seqread_latency_read["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_seqread_output}")
  else
    _fio_seqread_bw_read["${_mount_point}"]="ERROR"
    _fio_seqread_latency_read["${_mount_point}"]="ERROR"
  fi
  rm -f "${_seqread_output}" >/dev/null 2>&1

  # Sequential write
  _seqwrite_output="/tmp/fio_seqwrite_${_safe_mount_point}_$$.json"
  if _run_fio_seq_write_test "${_mount_point}" "${_seqwrite_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        WRITE_BW_MB) _fio_seqwrite_bw_write["${_mount_point}"]="${_v} MB/s" ;;
        WRITE_LAT_MS) _fio_seqwrite_latency_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_seqwrite_output}")
  else
    _fio_seqwrite_bw_write["${_mount_point}"]="ERROR"
    _fio_seqwrite_latency_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_seqwrite_output}" >/dev/null 2>&1

  # Metadata test
  _run_metadata_test "${_mount_point}" "_meta_ops[\"${_mount_point}\"]"

  # Capture root mount metrics for CSV
  if [ "${_mount_point}" = "/" ]; then
    _root_rand_bw_read="${_fio_rand_bw_read["${_mount_point}"]}"
    _root_rand_bw_write="${_fio_rand_bw_write["${_mount_point}"]}"
    _root_rand_lat_read="${_fio_rand_latency_read["${_mount_point}"]}"
    _root_rand_lat_write="${_fio_rand_latency_write["${_mount_point}"]}"
    _root_seqread_bw_read="${_fio_seqread_bw_read["${_mount_point}"]}"
    _root_seqread_lat_read="${_fio_seqread_latency_read["${_mount_point}"]}"
    _root_seqwrite_bw_write="${_fio_seqwrite_bw_write["${_mount_point}"]}"
    _root_seqwrite_lat_write="${_fio_seqwrite_latency_write["${_mount_point}"]}"
    _root_meta_ops="${_meta_ops["${_mount_point}"]}"
  fi
done

# ----
# Display Results
# ----
echo ""

if [ "${_COMPACT}" -eq 1 ]; then
  _print_compact_summary
else
  echo ""
  echo "==== Performance Test Summary ===="
  echo ""
  echo "System:"
  echo ""
  if [ -x "/opt/local/bin/screenfetch" ]; then
    bash /opt/local/bin/screenfetch -n
  else
    echo "  - Hostname: ${_hostname}"
    echo "  - CPU: ${_cpu_info}"
    echo "  - vCPUs: ${_cpu_cores}"
    local _total_ram_mb
    _total_ram_mb="$(free -m | awk '/^Mem:/ {print $2}')"
    echo "  - RAM: ${_total_ram_mb} MB"
  fi
  echo ""
  echo "CPU Performance (Multi-threaded, nproc=$(nproc)):"
  echo "  - Events per Second: ${_cpu_events_MT_NPROC}"
  echo "  - Average Latency: ${_cpu_latency_MT_NPROC} ms"
  if [ -n "${_cpu_steal_mt}" ]; then
    echo "  - Avg CPU Steal: ${_cpu_steal_mt} %"
  fi
  echo ""
  echo "CPU Performance (4 threads):"
  echo "  - Events per Second: ${_cpu_events_MT4}"
  echo "  - Average Latency: ${_cpu_latency_MT4} ms"
  echo ""
  echo "CPU Performance (Single-threaded):"
  echo "  - Events per Second: ${_cpu_events_ST}"
  echo "  - Average Latency: ${_cpu_latency_ST} ms"
  echo ""
  echo "Memory Performance:"
  echo "  - Transfer Speed: ${_mem_transfer_speed}"
  echo "  - Average Latency: ${_mem_latency} ms"
  echo ""
  echo "AES Performance (openssl enc):"
  echo "  - Time: ${_aes_seconds} s"
  echo "  - Throughput: ${_aes_mibps}"
  echo ""
  echo "Disk Latency (ioping):"
  echo "  - Seek rate: ${_ioping_seek}"
  echo "  - Sequential read: ${_ioping_seqread}"
  echo ""
  echo "Network (IPv4 single-stream):"
  echo "  - Public IPv4: ${_net_ipv4}"
  echo "  - CDN Speed Test: ${_net_download}"
  echo ""
  echo "PHP Performance (CLI Micro-benchmark):"
  if command -v php >/dev/null 2>&1; then
    echo "  - Runs (seconds): ${_php_time_runs}"
    echo "  - Median Time: ${_php_time_median} seconds"
    echo "  - Concurrent Procs: $( [ "$(nproc)" -gt "${_PHP_BENCH_CONCURRENCY_MAX}" ] && echo "${_PHP_BENCH_CONCURRENCY_MAX}" || nproc )"
    echo "  - Wall Time (conc.): ${_php_concurrency_wall} seconds"
    echo "  - Throughput (conc.): ${_php_concurrency_throughput}"
  else
    echo "  - PHP not installed"
  fi

  for _mount_point in "${_test_mounts[@]}"; do
    echo ""
    echo "Disk I/O Performance on ${_mount_point}:"
    echo ""
    echo "  Random 4k randrw:"
    echo "    - Read IOPS: ${_fio_rand_iops_read["${_mount_point}"]}"
    echo "    - Write IOPS: ${_fio_rand_iops_write["${_mount_point}"]}"
    echo "    - Read Bandwidth: ${_fio_rand_bw_read["${_mount_point}"]}"
    echo "    - Write Bandwidth: ${_fio_rand_bw_write["${_mount_point}"]}"
    echo "    - Avg Read Latency: ${_fio_rand_latency_read["${_mount_point}"]}"
    echo "    - Avg Write Latency: ${_fio_rand_latency_write["${_mount_point}"]}"
    echo ""
    echo "  Sequential Read (128k):"
    echo "    - Read Bandwidth: ${_fio_seqread_bw_read["${_mount_point}"]}"
    echo "    - Avg Read Latency: ${_fio_seqread_latency_read["${_mount_point}"]}"
    echo ""
    echo "  Sequential Write (128k):"
    echo "    - Write Bandwidth: ${_fio_seqwrite_bw_write["${_mount_point}"]}"
    echo "    - Avg Write Latency: ${_fio_seqwrite_latency_write["${_mount_point}"]}"
    echo ""
    echo "  Metadata (small file create+read+delete):"
    echo "    - Ops per second: ${_meta_ops["${_mount_point}"]}"
  done

  echo ""
  echo "Performance tests completed."
  echo ""
fi

# ----
# CSV summary line (focus on root mount) for easy ingest
# ----
# Fields (comma-separated, no header):
# hostname,cpu_model,vcpus,cpu_mt_eps,cpu_4t_eps,cpu_st_eps,mem_bw,php_median_s,php_conc_thr_ops,
# root_rand_bw_read,root_rand_bw_write,root_rand_lat_r,root_rand_lat_w,
# root_seqread_bw,root_seqread_lat_r,root_seqwrite_bw,root_seqwrite_lat_w,root_meta_ops,
# aes_mibps,net_mibps

# Strip units from some disk fields for CSV
_strip_unit() {
  # $1 = value like "195.67 MB/s" or "1.23 ms"
  echo "$1" | awk '{print $1}'
}

_csv_mem_bw="$(_strip_unit "${_mem_transfer_speed}")"
_csv_root_rand_bw_read="$(_strip_unit "${_root_rand_bw_read}")"
_csv_root_rand_bw_write="$(_strip_unit "${_root_rand_bw_write}")"
_csv_root_rand_lat_read="$(_strip_unit "${_root_rand_lat_read}")"
_csv_root_rand_lat_write="$(_strip_unit "${_root_rand_lat_write}")"
_csv_root_seqread_bw_read="$(_strip_unit "${_root_seqread_bw_read}")"
_csv_root_seqread_lat_read="$(_strip_unit "${_root_seqread_lat_read}")"
_csv_root_seqwrite_bw_write="$(_strip_unit "${_root_seqwrite_bw_write}")"
_csv_root_seqwrite_lat_write="$(_strip_unit "${_root_seqwrite_lat_write}")"
_csv_root_meta_ops="$(_strip_unit "${_root_meta_ops}")"
_csv_aes_mibps="$(_strip_unit "${_aes_mibps}")"
_csv_net_download="$(_strip_unit "${_net_download}")"

echo "CSV_SUMMARY:${_hostname},\"${_cpu_info}\",${_cpu_cores},${_cpu_events_MT_NPROC},${_cpu_events_MT4},${_cpu_events_ST},${_csv_mem_bw},${_php_time_median},\"${_php_concurrency_throughput}\",${_csv_root_rand_bw_read},${_csv_root_rand_bw_write},${_csv_root_rand_lat_read},${_csv_root_rand_lat_write},${_csv_root_seqread_bw_read},${_csv_root_seqread_lat_read},${_csv_root_seqwrite_bw_write},${_csv_root_seqwrite_lat_write},${_csv_root_meta_ops},${_csv_aes_mibps},${_csv_net_download}"
