#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

# Tunables
_PHP_BENCH_ITERATIONS=50000 # per process
_PHP_BENCH_RUNS=5 # single-thread runs for median
_PHP_BENCH_CONCURRENCY_MAX=8 # cap on concurrent PHP workers
_SYSBENCH_CPU_TIME=30 # seconds
_SYSBENCH_MEM_TIME=30 # seconds
_DB_SYSBENCH_TIME_RO=30 # seconds (read-only OLTP)
_DB_SYSBENCH_TIME_RW=30 # seconds (read-write OLTP)
_DB_SYSBENCH_TABLES=4 # number of tables
_DB_SYSBENCH_TABLE_SIZE=100000 # rows per table (light)
_DB_SYSBENCH_TABLE_SIZE_HEAVY=1000000 # rows per table (heavy)
_DB_SYSBENCH_THREADS_MAX=16 # cap threads
_DB_SYSBENCH_THREADS_MIN=2 # min threads
_DB_SYSBENCH_REPEATS=3 # median-of-N to reduce noise (DB can be bursty)
_DB_SYSBENCH_WARMUP=5 # seconds (optional warmup run, discarded)
_MEM_BENCH_TIME=10 # seconds (DRAM-focused membench, per run)
_MEM_BENCH_REPEATS=3 # repeats for stability; median-of-3 is used
_MEM_BENCH_SIZE_MIN_MIB=128 # MiB working set (min; must exceed LLC)
_MEM_BENCH_SIZE_MAX_MIB=1024 # MiB working set (cap to avoid OOM)
_MEM_BENCH_THREADS_MAX=8 # cap threads used for memory bandwidth
_MEM_BENCH_LAT_SIZE_MIB=256 # MiB pointer-chase working set (DRAM latency)
_FIO_RAND_RUNTIME=60 # seconds
_FIO_SEQ_RUNTIME=60 # seconds
_FIO_QD1_RUNTIME=20 # seconds (QD=1 random latency for tiering)
_FIO_QD1_SIZE_M=256 # MiB per QD=1 test
_FIO_QD1_FSYNC_RUNTIME=15 # seconds (QD=1 randwrite with fsync for DB realism)
_FIO_QD1_FSYNC_SIZE_M=128 # MiB (file size for fsync test)
_FIO_QD1_REPEATS=3 # repeats for QD=1 tests to reduce noise (median-of-N used)
_FIO_QD1_FSYNC_REPEATS=3 # repeats for QD=1 fsync tests to reduce noise (median-of-N used)
_METADATA_FILE_COUNT=5000 # small-file ops per mount
_NET_TIMEOUT=10 # seconds for curl speedtest
_AES_TEST_MIB=500 # MiB encrypted for AES throughput test
_IOPING_SECONDS=5 # seconds for ioping checks

# Output mode
_VERBOSE=0   # default: full output
_COMPACT=1   # compact BOA-focused mode

# DB benchmark (sysbench OLTP)
_DBTEST_ENABLED=YES
_DBTEST_HEAVY=NO
_DBTEST_KEEP_DB=NO

# CSV output
# Printed only in --verbose mode (no CSV in compact mode).

# ----
# Usage
# ----
_usage() {
  cat <<'USAGE'
Usage: perftest [--compact|--quiet] [--verbose] [-h|--help]

  --compact, --quiet  Print BOA-focused compact summary only (default)
                      (prioritizes memory > CPU > disk > network)
  --verbose           Print full detailed output or just CSV summary with | grep CSV_
  --no-dbtest         Skip MySQL sysbench OLTP benchmark (default: run in --verbose mode)
  --dbtest-heavy      Use larger dataset for DB test (more disk pressure)
  --keep-db           Keep sysbench DB after run (for debugging)
  -h, --help          Show this help

BOA context: This script evaluates VM vendor/host quality for BOA stack
(Drupal + APC/Valkey/OPcache/Nginx microcaching). Compact mode highlights
the metrics that matter most for in-memory caching performance.
USAGE
}

# ----
# Helpers
# ----
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root"
    exit 1
  fi
}

_log() {
  [ "${_VERBOSE}" -eq 1 ] && echo "$@"
}

_find_fast_mirror_early() {
  _USE_MIR=
  _urlDld=
  _ffMirr=/opt/local/bin/ffmirror
  if [ -x "${_ffMirr}" ]; then
    _ffList="/var/backups/boa-mirrors-2025-01.txt"
    [ -d "/var/backups" ] || mkdir -p /var/backups
    if [ ! -e "${_ffList}" ]; then
      echo "eu.files.aegir.cc"  > ${_ffList}
      echo "us.files.aegir.cc" >> ${_ffList}
      echo "ao.files.aegir.cc" >> ${_ffList}
    fi
    if [ -e "${_ffList}" ]; then
      _BROKEN_FFMIRR_TEST=$(grep "stuff" ${_ffMirr} 2>&1)
      if [[ "${_BROKEN_FFMIRR_TEST}" =~ "stuff" ]]; then
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _USE_MIR="${_CHECK_MIRROR}"
        [[ "${_USE_MIR}" =~ "printf" ]] && _USE_MIR=
      fi
    fi
  fi
  if [ -n "${_USE_MIR}" ]; then
    _urlDld="http://${_USE_MIR}/dev/solr-4.2.1.tgz"
  fi
}

# Function to check if a package is installed
_check_and_install_package() {
  # $1 = package name
  if ! dpkg -s "$1" >/dev/null 2>&1; then
    echo "Installing package: $1"
    apt-get install -y "$1" >/dev/null 2>&1
  fi
}

# Ensure sysbench build dependencies are present (always run)
_ensure_sysbench_build_deps() {
  _check_and_install_package "git"
  _check_and_install_package "make"
  _check_and_install_package "gcc"
  _check_and_install_package "automake"
  _check_and_install_package "libtool"
  _check_and_install_package "pkg-config"
  _check_and_install_package "libaio-dev"
}

# Extract sysbench version (first X.Y[.Z...] token)
_sysbench_get_version() {
  sysbench --version 2>/dev/null | grep -Eo '[0-9]+(\.[0-9]+)+' | head -n 1
}

# Return 0 if version A >= version B (dot-separated numeric)
_version_ge() {
  # Usage: _version_ge "1.0.20" "1.0.18"
  _A="${1}"
  _B="${2}"

  # Empty versions => fail safe
  if [ -z "${_A}" ] || [ -z "${_B}" ]; then
    return 1
  fi

  # shellcheck disable=SC2206
  _A_ARR=(${_A//./ })
  # shellcheck disable=SC2206
  _B_ARR=(${_B//./ })

  _I=0
  _MAX="${#_A_ARR[@]}"
  if [ "${#_B_ARR[@]}" -gt "${_MAX}" ]; then
    _MAX="${#_B_ARR[@]}"
  fi

  while [ "${_I}" -lt "${_MAX}" ]; do
    _AI="${_A_ARR[${_I}]:-0}"
    _BI="${_B_ARR[${_I}]:-0}"
    # Force base-10 numeric compare (avoid 08/09 octal edge)
    if [ "$((10#${_AI}))" -gt "$((10#${_BI}))" ]; then
      return 0
    fi
    if [ "$((10#${_AI}))" -lt "$((10#${_BI}))" ]; then
      return 1
    fi
    _I=$((_I + 1))
  done

  return 0
}

# Detect whether sysbench was built with mysql driver
_sysbench_has_mysql_driver() {
  # Never allow this check to hang perftest (and don't let sysbench read from stdin).
  if command -v timeout >/dev/null 2>&1; then
    _SB_HELP="$(timeout 3s sysbench --help </dev/null 2>/dev/null | tr '\n' ' ' | tr -s ' ')"
  else
    _SB_HELP="$(sysbench --help </dev/null 2>/dev/null | tr '\n' ' ' | tr -s ' ')"
  fi

  # If sysbench was killed by timeout or produced nothing, treat as "no mysql driver"
  if [ -z "${_SB_HELP}" ]; then
    return 1
  fi

  # Match either:
  # - the "Compiled-in database drivers:" section mentioning mysql (even if it was multiline originally), OR
  # - the explicit "mysql - MySQL driver" entry
  printf '%s\n' "${_SB_HELP}" | grep -Eqi 'Compiled-in database drivers:.*(^|[[:space:],])mysql([[:space:],]|$)' && return 0
  printf '%s\n' "${_SB_HELP}" | grep -Eqi '(^|[[:space:]])mysql[[:space:]]*-[[:space:]]*MySQL driver([[:space:]]|$)' && return 0

  return 1
}

_mysql_is_present() {
  if command -v mysqld >/dev/null 2>&1 || [ -d "/var/lib/mysql/mysql" ]; then
    return 0
  fi
  return 1
}

_mysql_build_support_ok() {
  if ! command -v mysql_config >/dev/null 2>&1; then
    return 1
  fi
  mysql_config --cflags >/dev/null 2>&1 || return 1
  mysql_config --libs   >/dev/null 2>&1 || return 1
  return 0
}

# Prefer sysbench build-from-source without MySQL, but rebuild with mysql support when appropriate.
# Rebuild triggers:
# - sysbench missing
# - sysbench version < ${_SYSBENCH_MIN_VER} (defaults below)
# - mysql is present + mysql_config works + sysbench lacks mysql driver
_ensure_sysbench() {
  # Dummy default; override elsewhere if you want.
  if [ -z "${_SYSBENCH_MIN_VER}" ]; then
    _SYSBENCH_MIN_VER="1.1.0"
  fi

  _MYSQL_SUPPORT_POSSIBLE="NO"
  _NEEDS_BUILD="NO"

  # Always ensure prerequisites (even if we end up doing nothing)
  _ensure_sysbench_build_deps

  if _mysql_is_present && _mysql_build_support_ok; then
    _MYSQL_SUPPORT_POSSIBLE="YES"
  fi

  if ! command -v sysbench >/dev/null 2>&1; then
    _NEEDS_BUILD="YES"
    _log "The sysbench is not installed yet, building from source..."
  else
    _SYSBENCH_CUR_VER="$(_sysbench_get_version)"

    # Version gate: rebuild if current version cannot be read or is too old
    if ! _version_ge "${_SYSBENCH_CUR_VER}" "${_SYSBENCH_MIN_VER}"; then
      _NEEDS_BUILD="YES"
      _log "The sysbench version is ${_SYSBENCH_CUR_VER} while minimum is ${_SYSBENCH_MIN_VER}, building from source..."
    fi

    # MySQL driver gate: rebuild only when MySQL support is actually possible
    if [ "${_NEEDS_BUILD}" != "YES" ] && [ "${_MYSQL_SUPPORT_POSSIBLE}" = "YES" ]; then
      if ! _sysbench_has_mysql_driver; then
        _NEEDS_BUILD="YES"
        _log "The sysbench MySQL support is missing, compiling from source..."
      fi
    fi
  fi

  if [ "${_NEEDS_BUILD}" != "YES" ]; then
    return 0
  fi

  if command -v sysbench >/dev/null 2>&1; then
    _log "Rebuilding sysbench from source (min ${_SYSBENCH_MIN_VER}; MySQL support possible: ${_MYSQL_SUPPORT_POSSIBLE})..."
  else
    _log "Compiling sysbench from source (min ${_SYSBENCH_MIN_VER})..."
  fi

  rm -rf /tmp/sysbench-build >/dev/null 2>&1
  mkdir -p /tmp/sysbench-build || exit 1
  cd /tmp/sysbench-build || exit 1

  git clone --depth 1 https://github.com/omega8cc/sysbench.git >/dev/null 2>&1 || exit 1
  cd sysbench || exit 1

  ./autogen.sh >/dev/null 2>&1 || exit 1

  # Default: without mysql. Enable mysql only when we proved build support is present.
  if [ "${_MYSQL_SUPPORT_POSSIBLE}" = "YES" ]; then
    ./configure >/dev/null 2>&1 || exit 1
  else
    ./configure --without-mysql >/dev/null 2>&1 || exit 1
  fi

  make -j"$(nproc)" >/dev/null 2>&1 || exit 1
  make install >/dev/null 2>&1 || exit 1

  cd /root || exit 1
  rm -rf /tmp/sysbench-build >/dev/null 2>&1

  # Ensure shell picks up any newly installed sysbench in PATH
  hash -r >/dev/null 2>&1
}

# Best-effort C compiler (for DRAM-focused membench)
_ensure_cc() {
  if command -v gcc >/dev/null 2>&1; then
    return 0
  fi
  if command -v cc >/dev/null 2>&1; then
    return 0
  fi
  _check_and_install_package "gcc"
}

_get_l3_cache_mib() {
  # Best-effort detection of L3 cache size (MiB) for sizing the memory benchmark.
  # Returns empty string if unknown.
  local _idx _lvl _sz _val

  # Prefer sysfs (works in most Linux guests).
  for _idx in /sys/devices/system/cpu/cpu0/cache/index*; do
    [ -d "${_idx}" ] || continue
    _lvl="$(cat "${_idx}/level" 2>/dev/null)"
    if [ "${_lvl}" = "3" ]; then
      _sz="$(cat "${_idx}/size" 2>/dev/null)"
      case "${_sz}" in
        *K) _val="${_sz%K}"; echo $(( _val / 1024 )); return 0 ;;
        *M) _val="${_sz%M}"; echo "${_val}"; return 0 ;;
      esac
    fi
  done

  # Fallback to lscpu output.
  if command -v lscpu >/dev/null 2>&1; then
    _sz="$(lscpu 2>/dev/null | awk -F: '/L3 cache/ {gsub(/^[ 	]+/,"",$2); print $2; exit}')"
    case "${_sz}" in
      *K) _val="${_sz%K}"; echo $(( _val / 1024 )); return 0 ;;
      *M) _val="${_sz%M}"; echo "${_val}"; return 0 ;;
    esac
  fi

  echo ""
}

_calc_mem_bench_size_mib() {
  # Choose a working set intended to exceed LLC but avoid OOM.
  # NOTE: membench allocates *two* buffers of this size (src+dst), so the
  # actual resident footprint is roughly 2x.
  local _avail_kb _avail_mib _mib _l3_mib _target _max_by_avail

  _avail_kb="$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)"
  if [ -z "${_avail_kb}" ]; then
    _avail_kb="$(awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null)"
  fi
  _avail_mib=0
  if [ -n "${_avail_kb}" ]; then
    _avail_mib=$(( _avail_kb / 1024 ))
  fi

  _l3_mib="$(_get_l3_cache_mib)"

  # Start from 4x L3 (if known), otherwise 25% of MemAvailable.
  if [ -n "${_l3_mib}" ] && [ "${_l3_mib}" -gt 0 ]; then
    _target=$(( _l3_mib * 4 ))
  else
    if [ "${_avail_mib}" -gt 0 ]; then
      _target=$(( _avail_mib / 4 ))
    else
      _target="${_MEM_BENCH_SIZE_MIN_MIB}"
    fi
  fi

  # Clamp to configured min/max.
  _mib="${_target}"
  if [ "${_mib}" -lt "${_MEM_BENCH_SIZE_MIN_MIB}" ]; then
    _mib="${_MEM_BENCH_SIZE_MIN_MIB}"
  fi
  if [ "${_mib}" -gt "${_MEM_BENCH_SIZE_MAX_MIB}" ]; then
    _mib="${_MEM_BENCH_SIZE_MAX_MIB}"
  fi

  # Headroom guard: keep 2x buffers under ~60% of MemAvailable.
  # (2 buffers + overhead + other daemons)
  if [ "${_avail_mib}" -gt 0 ]; then
    _max_by_avail=$(( (_avail_mib * 60 / 100) / 2 ))
    if [ "${_max_by_avail}" -gt 0 ] && [ "${_mib}" -gt "${_max_by_avail}" ]; then
      _mib="${_max_by_avail}"
      if [ "${_mib}" -lt "${_MEM_BENCH_SIZE_MIN_MIB}" ]; then
        _mib="${_MEM_BENCH_SIZE_MIN_MIB}"
      fi
    fi
  fi

  echo "${_mib}"
}

_build_membench() {
  # Builds /tmp/perftest_membench if missing.
  local _bin _c _cc
  _bin="/tmp/perftest_membench"
  [ -x "${_bin}" ] && return 0

  _ensure_cc

  if command -v gcc >/dev/null 2>&1; then
    _cc="gcc"
  else
    _cc="cc"
  fi

  _c="/tmp/perftest_membench.c"

  cat > "${_c}" <<'C'
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <time.h>
#include <pthread.h>
#include <unistd.h>

typedef struct {
  uint8_t *src;
  uint8_t *dst;
  size_t offset;
  size_t len;
  double seconds;
  uint64_t bytes;
} worker_t;

static inline double now_sec(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;
}

static void *bw_worker(void *arg) {
  worker_t *w = (worker_t *)arg;
  uint8_t *src = w->src + w->offset;
  uint8_t *dst = w->dst + w->offset;
  size_t len = w->len;
  uint64_t bytes = 0;

  // Warm-up touch
  for (size_t i = 0; i < len; i += 4096) {
    dst[i] = (uint8_t)(src[i] ^ 0x5a);
  }

  const double end = now_sec() + w->seconds;
  while (1) {
    // Do a small batch of copies before re-checking time (reduces timer overhead)
    for (int k = 0; k < 8; k++) {
      memcpy(dst, src, len);
      // Prevent overly aggressive optimization / dead-store elimination
      dst[0] ^= src[0];
      bytes += (uint64_t)len;
    }
    if (now_sec() >= end) break;
  }

  w->bytes = bytes;
  return NULL;
}

static uint64_t xorshift64(uint64_t *state) {
  uint64_t x = *state;
  x ^= x << 13;
  x ^= x >> 7;
  x ^= x << 17;
  *state = x;
  return x;
}

static double pointer_chase_latency_ns(size_t bytes, double seconds) {
  // Pointer chasing over a large random cycle to approximate DRAM latency.
  // bytes should exceed LLC to avoid cache-only results.

  size_t n = bytes / sizeof(uint32_t);
  if (n < 1024) n = 1024;

  uint32_t *next = NULL;
  if (posix_memalign((void **)&next, 64, n * sizeof(uint32_t)) != 0) {
    return 0.0;
  }

  // Build a random permutation (single cycle)
  uint32_t *perm = NULL;
  if (posix_memalign((void **)&perm, 64, n * sizeof(uint32_t)) != 0) {
    free(next);
    return 0.0;
  }

  for (size_t i = 0; i < n; i++) perm[i] = (uint32_t)i;

  uint64_t seed = 0x12345678abcdef00ULL;
  for (size_t i = n - 1; i > 0; i--) {
    size_t j = (size_t)(xorshift64(&seed) % (i + 1));
    uint32_t tmp = perm[i];
    perm[i] = perm[j];
    perm[j] = tmp;
  }

  for (size_t i = 0; i < n; i++) {
    next[perm[i]] = perm[(i + 1) % n];
  }

  // Warm-up: walk a bit
  volatile uint32_t idx = 0;
  for (size_t i = 0; i < (n < 100000 ? n : 100000); i++) {
    idx = next[idx];
  }

  const double end = now_sec() + seconds;
  uint64_t ops = 0;
  double t0 = now_sec();

  while (1) {
    // Batch pointer derefs to reduce timer overhead
    for (int k = 0; k < 4096; k++) {
      idx = next[idx];
    }
    ops += 4096;
    if (now_sec() >= end) break;
  }

  double t1 = now_sec();
  (void)idx;

  free(perm);
  free(next);

  double elapsed = t1 - t0;
  if (ops == 0 || elapsed <= 0.0) return 0.0;
  return (elapsed * 1e9) / (double)ops;
}

int main(int argc, char **argv) {
  long size_mib = 256;
  long lat_mib = 0;
  int threads = 1;
  double seconds = 5.0;

  for (int i = 1; i < argc; i++) {
    if (!strcmp(argv[i], "--size-mib") && i + 1 < argc) {
      size_mib = atol(argv[++i]);
    } else if (!strcmp(argv[i], "--threads") && i + 1 < argc) {
      threads = atoi(argv[++i]);
    } else if (!strcmp(argv[i], "--lat-mib") && i + 1 < argc) {
      lat_mib = atol(argv[++i]);
    } else if (!strcmp(argv[i], "--seconds") && i + 1 < argc) {
      seconds = atof(argv[++i]);
    }
  }

  if (size_mib < 64) size_mib = 64;
  if (threads < 1) threads = 1;

  size_t total = (size_t)size_mib * 1024 * 1024;

  uint8_t *src = NULL;
  uint8_t *dst = NULL;
  if (posix_memalign((void **)&src, 64, total) != 0) return 2;
  if (posix_memalign((void **)&dst, 64, total) != 0) return 2;

  // Fill src with a pattern to avoid special zero-page behaviors
  for (size_t i = 0; i < total; i += 4096) {
    src[i] = (uint8_t)((i >> 12) ^ 0xa5);
  }

  // Partition work among threads
  pthread_t *t = calloc((size_t)threads, sizeof(pthread_t));
  worker_t *w = calloc((size_t)threads, sizeof(worker_t));
  if (!t || !w) return 3;

  size_t chunk = total / (size_t)threads;
  // Align chunk to 64 bytes
  chunk = (chunk / 64) * 64;

  double start = now_sec();
  for (int i = 0; i < threads; i++) {
    w[i].src = src;
    w[i].dst = dst;
    w[i].offset = (size_t)i * chunk;
    w[i].len = chunk;
    w[i].seconds = seconds;
    w[i].bytes = 0;
    pthread_create(&t[i], NULL, bw_worker, &w[i]);
  }
  for (int i = 0; i < threads; i++) pthread_join(t[i], NULL);
  double end = now_sec();

  uint64_t total_bytes = 0;
  for (int i = 0; i < threads; i++) total_bytes += w[i].bytes;

  double elapsed = end - start;
  double mibps = 0.0;
  if (elapsed > 0.0) mibps = ((double)total_bytes / 1024.0 / 1024.0) / elapsed;

  // Latency test: pointer-chase over a large random cycle
  // Default: derive from bandwidth working set; override with --lat-mib
  size_t lat_bytes;
  if (lat_mib > 0) {
    lat_bytes = (size_t)lat_mib * 1024 * 1024;
  } else {
    lat_bytes = total;
  }
  if (lat_bytes > (size_t)512 * 1024 * 1024) lat_bytes = (size_t)512 * 1024 * 1024;
  if (lat_bytes < (size_t)128 * 1024 * 1024) lat_bytes = (size_t)128 * 1024 * 1024;
  double lat_ns = pointer_chase_latency_ns(lat_bytes, 1.5);

  printf("BW_MIBPS=%.2f\n", mibps);
  printf("LAT_NS=%.2f\n", lat_ns);
  printf("SIZE_MIB=%ld\n", size_mib);
  printf("THREADS=%d\n", threads);

  free(w);
  free(t);
  free(dst);
  free(src);

  return 0;
}
C

  "${_cc}" -O3 -pthread "${_c}" -o "${_bin}" >/dev/null 2>&1
  if [ ! -x "${_bin}" ]; then
    return 1
  fi
  return 0
}

_run_membench() {
  # Outputs key=value lines on success.
  local _size_mib="$1"
  local _threads="$2"
  local _seconds="$3"
  local _lat_mib="$4"
  local _bin="/tmp/perftest_membench"

  _build_membench || return 1

  if [ -n "${_lat_mib}" ]; then
    "${_bin}" --size-mib "${_size_mib}" --threads "${_threads}" --seconds "${_seconds}" --lat-mib "${_lat_mib}" 2>/dev/null
  else
    "${_bin}" --size-mib "${_size_mib}" --threads "${_threads}" --seconds "${_seconds}" 2>/dev/null
  fi
}

_run_mem_benchmarks() {
  # Sets globals:
  #   _mem_transfer_speed ("NNNNN MiB/s")
  #   _mem_latency        ("NN.NN" in ns)
  #   _mem_latency_unit   ("ns")
  #   _mem_bench_size_mib (per-buffer size)
  #   _mem_bench_threads
  #   _mem_bw_min/_mem_bw_max (numeric MiB/s, for variance hint)
  #   _mem_lat_min/_mem_lat_max (numeric ns, for variance hint)
  local _size_mib _threads _lat_mib _rep _out _bw _lat
  local _bw_vals _lat_vals _bw_med _lat_med

  _size_mib="$(_calc_mem_bench_size_mib)"
  _mem_bench_size_mib="${_size_mib}"
  _mem_bench_total_mib=$(( _size_mib * 2 ))

  _threads="$(nproc 2>/dev/null || echo 1)"
  if [ "${_threads}" -gt "${_MEM_BENCH_THREADS_MAX}" ]; then
    _threads="${_MEM_BENCH_THREADS_MAX}"
  fi
  if [ "${_threads}" -lt 1 ]; then
    _threads=1
  fi
  _mem_bench_threads="${_threads}"

  _lat_mib="${_MEM_BENCH_LAT_SIZE_MIB}"
  if [ "${_lat_mib}" -gt "${_size_mib}" ]; then
    _lat_mib="${_size_mib}"
  fi
  if [ "${_lat_mib}" -gt 512 ]; then
    _lat_mib=512
  fi
  if [ "${_lat_mib}" -lt 128 ]; then
    _lat_mib=128
  fi

  _bw_vals=""
  _lat_vals=""

  _rep=1
  while [ "${_rep}" -le "${_MEM_BENCH_REPEATS}" ]; do
    _out="$(_run_membench "${_size_mib}" "${_threads}" "${_MEM_BENCH_TIME}" "${_lat_mib}")"
    _bw="$(printf '%s\n' "${_out}" | awk -F= '/^BW_MIBPS=/{print $2}' | head -n1)"
    _lat="$(printf '%s\n' "${_out}" | awk -F= '/^LAT_NS=/{print $2}' | head -n1)"

    if [ -n "${_bw}" ]; then
      _bw_vals="${_bw_vals}${_bw}\n"
    fi
    if [ -n "${_lat}" ]; then
      _lat_vals="${_lat_vals}${_lat}\n"
    fi

    _rep=$((_rep + 1))
  done

  # Median-of-N to reduce noise (best-of was too optimistic and hides contention).
  _bw_med=""
  _lat_med=""
  _mem_bw_min=""
  _mem_bw_max=""
  _mem_lat_min=""
  _mem_lat_max=""

  if [ -n "${_bw_vals}" ]; then
    _bw_med="$(printf '%b' "${_bw_vals}" | sort -n | awk '{a[NR]=$1} END{ if(NR==0) exit; if(NR%2==1) print a[(NR+1)/2]; else print (a[NR/2]+a[NR/2+1])/2 }')"
    _mem_bw_min="$(printf '%b' "${_bw_vals}" | sort -n | head -n1)"
    _mem_bw_max="$(printf '%b' "${_bw_vals}" | sort -n | tail -n1)"
  fi

  if [ -n "${_lat_vals}" ]; then
    _lat_med="$(printf '%b' "${_lat_vals}" | sort -n | awk '{a[NR]=$1} END{ if(NR==0) exit; if(NR%2==1) print a[(NR+1)/2]; else print (a[NR/2]+a[NR/2+1])/2 }')"
    _mem_lat_min="$(printf '%b' "${_lat_vals}" | sort -n | head -n1)"
    _mem_lat_max="$(printf '%b' "${_lat_vals}" | sort -n | tail -n1)"
  fi

  if [ -n "${_bw_med}" ]; then
    _mem_transfer_speed="${_bw_med} MiB/s"
  else
    # Fallback to sysbench if membench failed
    _mem_test="$(sysbench memory --memory-block-size=256M --memory-oper=read --memory-access-mode=seq --memory-total-size=10G --threads="$(nproc)" --time="${_SYSBENCH_MEM_TIME}" run 2>/dev/null)"
    _mem_transfer_speed="$(echo "${_mem_test}" | awk '/transferred/ {gsub("[()]","",$(NF-1)); print $(NF-1)" "$(NF)}')"
  fi

  _mem_latency_unit="ns"
  if [ -n "${_lat_med}" ]; then
    _mem_latency="${_lat_med}"
  else
    _mem_latency=""
  fi
}

# Convert bytes/sec to MiB/s (numeric only) (numeric only)
_bps_to_mibps_num() {
  awk '{ if (NR>0) printf "%.2f", $0 / 1024 / 1024 }'
}

# Convert bytes/sec to pretty "X.XX MiB/s"
_bps_to_mibps_pretty() {
  awk '{ if (NR>0) printf "%.2f MiB/s", $0 / 1024 / 1024; else printf "error" }'
}

_redact_ip() {
  case "$1" in
    *.*) printf '%s.xxxx' "$(printf '%s\n' "$1" | cut -d . -f 1-3)" ;;
    *:*) printf '%s:xxxx' "$(printf '%s\n' "$1" | cut -d : -f 1-3)" ;;
    *) printf '%s' "$1" ;;
  esac
}

_get_public_ipv4() {
  curl -4 -s --max-time 5 http://icanhazip.com/ 2>/dev/null | tr -d '\r\n'
}

_download_benchmark_v4() {
  # Single-stream IPv4 download speed probe (curl).
  #
  # Uses a byte-range request to keep it fast and to avoid false positives from
  # empty/placeholder responses.
  #
  # Args:
  #   $1 = URL
  #   $2 = expected_min_bytes (optional, default 1 MiB)
  #   $3 = range_end_byte (optional, default ~10 MiB)
  #
  # Output (on success):
  #   speed_bps|size_bytes|time_total|http_code
  #
  # Output (on failure): empty line
  local url="$1"
  local min_bytes="${2:-1048576}"   # 1 MiB
  local range_end="${3:-10485759}"  # ~10 MiB

  local out http_code size_download speed_bps time_total

  out="$(curl -4 -sL --max-time "${_NET_TIMEOUT}" --range "0-${range_end}" -o /dev/null \
    -w '%{http_code} %{size_download} %{speed_download} %{time_total}\n' "${url}" 2>/dev/null)"

  [ -n "${out}" ] || return 0

  http_code="$(printf '%s\n' "${out}" | awk '{print $1}')"
  size_download="$(printf '%s\n' "${out}" | awk '{print $2}')"
  speed_bps="$(printf '%s\n' "${out}" | awk '{print $3}')"
  time_total="$(printf '%s\n' "${out}" | awk '{print $4}')"

  # Validate HTTP status (200 OK or 206 Partial Content are expected)
  case "${http_code}" in
    200|206) : ;;
    *) return 0 ;;
  esac

  # Validate payload size (protects against empty/placeholder/truncated responses)
  if ! printf '%s' "${size_download}" | grep -Eq '^[0-9]+$'; then
    return 0
  fi
  if [ "${size_download}" -lt "${min_bytes}" ]; then
    _log "Network test INVALID (${url}): got ${size_download} bytes, expected >=${min_bytes}"
    return 0
  fi

  # Validate speed numeric
  if ! printf '%s' "${speed_bps}" | grep -Eq '^[0-9]+(\.[0-9]+)?$'; then
    return 0
  fi

  printf '%s|%s|%s|%s\n' "${speed_bps}" "${size_download}" "${time_total}" "${http_code}"
}

# Best-effort ioping setup (download static binary like nench if not installed)
_ensure_ioping() {
  if command -v ioping >/dev/null 2>&1; then
    _ioping_cmd="ioping"
    return 0
  fi
  local dst="/tmp/ioping.static"
  if curl -s --max-time 10 -o "${dst}" http://wget.racing/ioping.static 2>/dev/null; then
    chmod +x "${dst}" 2>/dev/null || true
    _ioping_cmd="${dst}"
    return 0
  fi
  _ioping_cmd=""
  return 1
}

_run_ioping_quick() {
  _ioping_seek="N/A"
  _ioping_seqread="N/A"
  _ensure_ioping || return 0
  [ -n "${_ioping_cmd}" ] || return 0
  # Keep it short; these lines match nench-style output snippets
  _ioping_seek="$("${_ioping_cmd}" -DR -w "${_IOPING_SECONDS}" . 2>/dev/null | tail -n 1)"
  _ioping_seqread="$("${_ioping_cmd}" -DRL -w "${_IOPING_SECONDS}" . 2>/dev/null | tail -n 2 | head -n 1)"
}

_run_ioping_quick_mounts() {
  # Requires _test_mounts[] already populated.
  # Populates:
  #   _ioping_seek_line["/mount"]    (last line of ioping -DR output)
  #   _ioping_seqread_line["/mount"] (seq read snippet)
  # Keeps legacy globals _ioping_seek/_ioping_seqread as root (/) values.
  _ioping_seek="N/A"
  _ioping_seqread="N/A"
  _ensure_ioping || return 0
  [ -n "${_ioping_cmd}" ] || return 0

  local _mp
  for _mp in "${_test_mounts[@]}"; do
    if [ -d "${_mp}" ]; then
      _ioping_seek_line["${_mp}"]="$("${_ioping_cmd}" -DR -w "${_IOPING_SECONDS}" "${_mp}" 2>/dev/null | tail -n 1)"
      _ioping_seqread_line["${_mp}"]="$("${_ioping_cmd}" -DRL -w "${_IOPING_SECONDS}" "${_mp}" 2>/dev/null | tail -n 2 | head -n 1)"
    else
      _ioping_seek_line["${_mp}"]="N/A"
      _ioping_seqread_line["${_mp}"]="N/A"
    fi
  done

  # Backward-compatible globals (root only)
  if [ -n "${_ioping_seek_line["/"]:-}" ]; then
    _ioping_seek="${_ioping_seek_line["/"]}"
  fi
  if [ -n "${_ioping_seqread_line["/"]:-}" ]; then
    _ioping_seqread="${_ioping_seqread_line["/"]}"
  fi
}

# AES throughput test (captures AES-NI issues better than sysbench cpu)
_run_aes_throughput_test() {
  _aes_mibps="N/A"
  _aes_seconds="N/A"
  if ! command -v openssl >/dev/null 2>&1; then
    return 0
  fi
  local start end elapsed
  start="$(date +%s.%N)"
  # Use fixed key/iv to avoid KDF overhead; measures raw AES speed better
  dd if=/dev/zero bs=1M count="${_AES_TEST_MIB}" 2>/dev/null \
    | openssl enc -aes-256-cbc \
      -K 0000 \
      -iv 0000 \
      -nosalt 2>/dev/null \
    > /dev/null
  end="$(date +%s.%N)"
  elapsed="$(echo "${end} - ${start}" | bc -l 2>/dev/null || echo 0)"
  if [ "${elapsed}" != "0" ]; then
    _aes_seconds="$(printf '%.3f' "${elapsed}")"
    _aes_mibps="$(echo "${_AES_TEST_MIB} / ${elapsed}" | bc -l 2>/dev/null | awk '{printf "%.2f MiB/s",$0}')"
  fi
}

_run_ipv4_net_check() {
  _net_ipv4="N/A"
  _net_download="N/A"

  # Per-test results (used later by output sections)
  _net_dl_name=()
  _net_dl_url=()
  _net_dl_pretty=()
  _net_dl_bps=()
  _net_dl_bytes=()
  _net_dl_time=()
  _net_dl_http=()
  _net_dl_top2=""

  local ip
  ip="$(_get_public_ipv4)"
  [ -n "${ip}" ] || return 0
  _net_ipv4="$(_redact_ip "${ip}")"

  # Fixed URLs + BOA mirror (region-aware via custom speed test)
  local cf_url cachefly_url gh_url boa_url
  cf_url="https://speed.cloudflare.com/__down?bytes=104857600"
  cachefly_url="http://cachefly.cachefly.net/100mb.test"
  gh_url="https://raw.githubusercontent.com/TestFileHub/FileHub/main/pdf/pdf100mb.pdf"

  boa_url=""
  _find_fast_mirror_early
  if [ -n "${_urlDld}" ]; then
    boa_url="${_urlDld}"
  fi

  # Require at least 1 MiB downloaded within timeout; request up to ~10 MiB
  local min_bytes range_end
  min_bytes=1048576
  range_end=10485759

  # Append tests in a stable order
  _net_dl_name+=("Cloudflare")
  _net_dl_url+=("${cf_url}")
  _net_dl_name+=("CacheFly")
  _net_dl_url+=("${cachefly_url}")
  _net_dl_name+=("GitHub")
  _net_dl_url+=("${gh_url}")
  _net_dl_name+=("BOA")
  _net_dl_url+=("${boa_url}")

  local i name url line bps bytes ttotal code pretty
  i=0
  while [ "${i}" -lt "${#_net_dl_name[@]}" ]; do
    name="${_net_dl_name[${i}]}"
    url="${_net_dl_url[${i}]}"
    if [ -z "${url}" ]; then
      _net_dl_pretty+=("N/A")
      _net_dl_bps+=("")
      _net_dl_bytes+=("")
      _net_dl_time+=("")
      _net_dl_http+=("")
      i=$((i + 1))
      continue
    fi

    _log "Network test: ${name} (${url})"
    line="$(_download_benchmark_v4 "${url}" "${min_bytes}" "${range_end}")"
    if [ -n "${line}" ]; then
      bps="$(printf '%s\n' "${line}" | cut -d'|' -f1)"
      bytes="$(printf '%s\n' "${line}" | cut -d'|' -f2)"
      ttotal="$(printf '%s\n' "${line}" | cut -d'|' -f3)"
      code="$(printf '%s\n' "${line}" | cut -d'|' -f4)"
      pretty="$(printf '%s\n' "${bps}" | _bps_to_mibps_pretty)"
      _net_dl_pretty+=("${pretty}")
      _net_dl_bps+=("${bps}")
      _net_dl_bytes+=("${bytes}")
      _net_dl_time+=("${ttotal}")
      _net_dl_http+=("${code}")
    else
      _net_dl_pretty+=("error")
      _net_dl_bps+=("")
      _net_dl_bytes+=("")
      _net_dl_time+=("")
      _net_dl_http+=("")
    fi
    i=$((i + 1))
  done

  # Score = average of the best 2 successful tests (bytes/sec)
  local ranked rank_cnt best1_bps best2_bps best1_idx best2_idx avg_bps
  ranked="$(for i in "${!_net_dl_bps[@]}"; do
    if printf '%s' "${_net_dl_bps[${i}]}" | grep -Eq '^[0-9]+(\.[0-9]+)?$'; then
      printf '%s|%s\n' "${_net_dl_bps[${i}]}" "${i}"
    fi
  done | sort -t'|' -k1,1nr)"

  rank_cnt="$(printf '%s\n' "${ranked}" | grep -c '|' 2>/dev/null || echo 0)"

  if [ "${rank_cnt}" -ge 2 ]; then
    best1_bps="$(printf '%s\n' "${ranked}" | head -n 1 | cut -d'|' -f1)"
    best1_idx="$(printf '%s\n' "${ranked}" | head -n 1 | cut -d'|' -f2)"
    best2_bps="$(printf '%s\n' "${ranked}" | head -n 2 | tail -n 1 | cut -d'|' -f1)"
    best2_idx="$(printf '%s\n' "${ranked}" | head -n 2 | tail -n 1 | cut -d'|' -f2)"
    avg_bps="$(awk -v a="${best1_bps}" -v b="${best2_bps}" 'BEGIN{printf "%.2f",(a+b)/2}')"
    _net_dl_top2="${_net_dl_name[${best1_idx}]} + ${_net_dl_name[${best2_idx}]}"
  elif [ "${rank_cnt}" -eq 1 ]; then
    best1_bps="$(printf '%s\n' "${ranked}" | head -n 1 | cut -d'|' -f1)"
    best1_idx="$(printf '%s\n' "${ranked}" | head -n 1 | cut -d'|' -f2)"
    avg_bps="${best1_bps}"
    _net_dl_top2="${_net_dl_name[${best1_idx}]}"
  else
    avg_bps=""
    _net_dl_top2=""
  fi

  if printf '%s' "${avg_bps}" | grep -Eq '^[0-9]+(\.[0-9]+)?$'; then
    _net_download="$(printf '%s\n' "${avg_bps}" | _bps_to_mibps_pretty) (avg best 2/4)"
  else
    _net_download="error"
  fi
}

# Return average %steal while running for N seconds (requires mpstat)
_measure_cpu_steal() {
  # $1 = seconds
  local _seconds="$1"
  if ! command -v mpstat >/dev/null 2>&1; then
    echo ""
    return 0
  fi
  # mpstat output: header + per-second lines; %steal column exists on Linux
  mpstat 1 "${_seconds}" 2>/dev/null \
    | awk '
      /^[0-9]/ { steal_sum += $(NF); steal_cnt++ }
      END {
        if (steal_cnt > 0) {
          printf "%.2f", steal_sum / steal_cnt
        }
      }'
}

# Decide which mounts to test:
# - include "/" always if it is a "real" filesystem type
# - include other mounted filesystems (separate partitions/volumes)
# - exclude /boot*, pseudo fs, and tiny mounts
_get_test_mounts() {
  df -P -T -B1 \
    | awk 'NR>1 {print $2 "|" $7 "|" $3}' \
    | while IFS="|" read -r _fstype _mount _size_bytes; do
      case "${_fstype}" in
        ext4|xfs|btrfs|zfs|f2fs) : ;;
        *) continue ;;
      esac
      case "${_mount}" in
        /boot|/boot/*|/boot/efi|/boot/efi/*) continue ;;
        /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*) continue ;;
        /snap|/snap/*) continue ;;
      esac
      if [ "${_size_bytes}" -lt $((2 * 1024 * 1024 * 1024)) ]; then
        continue
      fi
      case "${_mount}" in
        /*) echo "${_mount}" ;;
        *) : ;;
      esac
    done \
    | awk '!seen[$0]++ { print $0 }'
}

# Run fio random 4k randrw test in a mount and write JSON output to a file
_run_fio_rand_test() {
  # $1 = mountpoint
  # $2 = output_file
  local _mount_point="$1"
  local _output_file="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_fio_rand_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || return 1
  fio \
    --name=randreadwrite \
    --directory="${_test_dir}" \
    --ioengine=libaio \
    --iodepth=64 \
    --rw=randrw \
    --rwmixread=50 \
    --bs=4k \
    --direct=1 \
    --size=1G \
    --numjobs=4 \
    --runtime="${_FIO_RAND_RUNTIME}" \
    --time_based \
    --group_reporting \
    --output-format=json \
    > "${_output_file}" 2>/dev/null
  rm -rf "${_test_dir}" >/dev/null 2>&1
}

