_run_ioping_quick_mounts

# IPv4 network sanity check (CDN with fallback)
echo "Running IPv4 network check (4 tests, ${_NET_TIMEOUT}s timeout)..."
_run_ipv4_net_check

declare -A _fio_rand_iops_read
declare -A _fio_rand_iops_write
declare -A _fio_rand_bw_read
declare -A _fio_rand_bw_write
declare -A _fio_rand_latency_read
declare -A _fio_rand_latency_write
declare -A _fio_seqread_bw_read
declare -A _fio_seqread_latency_read
declare -A _fio_seqwrite_bw_write
declare -A _fio_seqwrite_latency_write
declare -A _fio_qd1_p95_read
declare -A _fio_qd1_p95_write
declare -A _fio_qd1_p99_read
declare -A _fio_qd1_p99_write
declare -A _fio_qd1_fsync_p95_write
declare -A _fio_qd1_fsync_p99_write
declare -A _meta_ops

# For CSV summary (root mount)
_root_rand_bw_read=""
_root_rand_bw_write=""
_root_rand_lat_read=""
_root_rand_lat_write=""
_root_seqread_bw_read=""
_root_seqread_lat_read=""
_root_seqwrite_bw_write=""
_root_seqwrite_lat_write=""
_root_meta_ops=""
_root_qd1_p95_read=""
_root_qd1_p95_write=""
_root_qd1_p99_read=""
_root_qd1_p99_write=""
_root_qd1_fsync_p95_write=""
_root_qd1_fsync_p99_write=""

for _mount_point in "${_test_mounts[@]}"; do
  [ -z "${_mount_point}" ] && continue
  echo "Running Disk I/O tests on ${_mount_point}..."
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"

  # Random 4k read/write
  _rand_output="/tmp/fio_rand_${_safe_mount_point}_$$.json"
  if _run_fio_rand_test "${_mount_point}" "${_rand_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_IOPS) _fio_rand_iops_read["${_mount_point}"]="${_v}" ;;
        WRITE_IOPS) _fio_rand_iops_write["${_mount_point}"]="${_v}" ;;
        READ_BW_MB) _fio_rand_bw_read["${_mount_point}"]="${_v} MB/s" ;;
        WRITE_BW_MB) _fio_rand_bw_write["${_mount_point}"]="${_v} MB/s" ;;
        READ_LAT_MS) _fio_rand_latency_read["${_mount_point}"]="${_v} ms" ;;
        WRITE_LAT_MS) _fio_rand_latency_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_rand_output}")
  else
    _fio_rand_iops_read["${_mount_point}"]="ERROR"
    _fio_rand_iops_write["${_mount_point}"]="ERROR"
    _fio_rand_bw_read["${_mount_point}"]="ERROR"
    _fio_rand_bw_write["${_mount_point}"]="ERROR"
    _fio_rand_latency_read["${_mount_point}"]="ERROR"
    _fio_rand_latency_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_rand_output}" >/dev/null 2>&1

  # Sequential read
  _seqread_output="/tmp/fio_seqread_${_safe_mount_point}_$$.json"
  if _run_fio_seq_read_test "${_mount_point}" "${_seqread_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        READ_BW_MB) _fio_seqread_bw_read["${_mount_point}"]="${_v} MB/s" ;;
        READ_LAT_MS) _fio_seqread_latency_read["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_seqread_output}")
  else
    _fio_seqread_bw_read["${_mount_point}"]="ERROR"
    _fio_seqread_latency_read["${_mount_point}"]="ERROR"
  fi
  rm -f "${_seqread_output}" >/dev/null 2>&1

  # Sequential write
  _seqwrite_output="/tmp/fio_seqwrite_${_safe_mount_point}_$$.json"
  if _run_fio_seq_write_test "${_mount_point}" "${_seqwrite_output}"; then
    while IFS="=" read -r _k _v; do
      case "${_k}" in
        WRITE_BW_MB) _fio_seqwrite_bw_write["${_mount_point}"]="${_v} MB/s" ;;
        WRITE_LAT_MS) _fio_seqwrite_latency_write["${_mount_point}"]="${_v} ms" ;;
      esac
    done < <(_parse_fio_json "${_seqwrite_output}")
  else
    _fio_seqwrite_bw_write["${_mount_point}"]="ERROR"
    _fio_seqwrite_latency_write["${_mount_point}"]="ERROR"
  fi
  rm -f "${_seqwrite_output}" >/dev/null 2>&1


  # Random 4k randrw QD=1 (latency percentiles for tiering) - repeated for stability
  echo "Running QD=1 random latency test (x${_FIO_QD1_REPEATS}) on ${_mount_point}..."
  _qd1_rep=""
  _qd1_p95_r_list=() _qd1_p95_w_list=() _qd1_p99_r_list=() _qd1_p99_w_list=()
  _qd1_ok="YES"
  for _qd1_rep in $(seq 1 "${_FIO_QD1_REPEATS}"); do
    _qd1_output="/tmp/fio_qd1_${_safe_mount_point}_${_qd1_rep}_$$.json"
    if _run_fio_qd1_test "${_mount_point}" "${_qd1_output}"; then
      _tmp_r95="" _tmp_w95="" _tmp_r99="" _tmp_w99=""
      while IFS="=" read -r _k _v; do
        case "${_k}" in
          READ_P95_MS) _tmp_r95="${_v}" ;;
          WRITE_P95_MS) _tmp_w95="${_v}" ;;
          READ_P99_MS) _tmp_r99="${_v}" ;;
          WRITE_P99_MS) _tmp_w99="${_v}" ;;
        esac
      done < <(_parse_fio_json "${_qd1_output}")
      [ -n "${_tmp_r95}" ] && _qd1_p95_r_list+=("${_tmp_r95}")
      [ -n "${_tmp_w95}" ] && _qd1_p95_w_list+=("${_tmp_w95}")
      [ -n "${_tmp_r99}" ] && _qd1_p99_r_list+=("${_tmp_r99}")
      [ -n "${_tmp_w99}" ] && _qd1_p99_w_list+=("${_tmp_w99}")
    else
      _qd1_ok="NO"
    fi
    rm -f "${_qd1_output}" >/dev/null 2>&1
  done

  if [ "${_qd1_ok}" = "YES" ] && [ "${#_qd1_p99_r_list[@]}" -gt 0 ] && [ "${#_qd1_p99_w_list[@]}" -gt 0 ]; then
    _fio_qd1_p95_read["${_mount_point}"]="$(_median_num "${_qd1_p95_r_list[@]}") ms"
    _fio_qd1_p95_write["${_mount_point}"]="$(_median_num "${_qd1_p95_w_list[@]}") ms"
    _fio_qd1_p99_read["${_mount_point}"]="$(_median_num "${_qd1_p99_r_list[@]}") ms"
    _fio_qd1_p99_write["${_mount_point}"]="$(_median_num "${_qd1_p99_w_list[@]}") ms"
  else
    _fio_qd1_p95_read["${_mount_point}"]="ERROR"
    _fio_qd1_p95_write["${_mount_point}"]="ERROR"
    _fio_qd1_p99_read["${_mount_point}"]="ERROR"
    _fio_qd1_p99_write["${_mount_point}"]="ERROR"
  fi

  # Random 4k randwrite QD=1 with fsync (durability realism) - repeated for stability
  echo "Running QD=1 fsync write test (x${_FIO_QD1_FSYNC_REPEATS}) on ${_mount_point}..."
  _fs_rep=""
  _fs_p95_list=() _fs_p99_list=()
  _fs_ok="YES"
  for _fs_rep in $(seq 1 "${_FIO_QD1_FSYNC_REPEATS}"); do
    _qd1_fsync_output="/tmp/fio_qd1_fsync_${_safe_mount_point}_${_fs_rep}_$$.json"
    if _run_fio_qd1_fsync_test "${_mount_point}" "${_qd1_fsync_output}"; then
      _tmp_fs95="" _tmp_fs99=""
      while IFS="=" read -r _k _v; do
        case "${_k}" in
          SYNC_P95_MS) _tmp_fs95="${_v}" ;;
          SYNC_P99_MS) _tmp_fs99="${_v}" ;;
          WRITE_P95_MS) [ -z "${_tmp_fs95}" ] && _tmp_fs95="${_v}" ;;
          WRITE_P99_MS) [ -z "${_tmp_fs99}" ] && _tmp_fs99="${_v}" ;;
        esac
      done < <(_parse_fio_json "${_qd1_fsync_output}")
      [ -n "${_tmp_fs95}" ] && _fs_p95_list+=("${_tmp_fs95}")
      [ -n "${_tmp_fs99}" ] && _fs_p99_list+=("${_tmp_fs99}")
    else
      _fs_ok="NO"
    fi
    rm -f "${_qd1_fsync_output}" >/dev/null 2>&1
  done

  if [ "${_fs_ok}" = "YES" ] && [ "${#_fs_p99_list[@]}" -gt 0 ]; then
    _fio_qd1_fsync_p95_write["${_mount_point}"]="$(_median_num "${_fs_p95_list[@]}") ms"
    _fio_qd1_fsync_p99_write["${_mount_point}"]="$(_median_num "${_fs_p99_list[@]}") ms"
  else
    _fio_qd1_fsync_p95_write["${_mount_point}"]="ERROR"
    _fio_qd1_fsync_p99_write["${_mount_point}"]="ERROR"
  fi

  # Metadata test
  _run_metadata_test "${_mount_point}" "_meta_ops[\"${_mount_point}\"]"

  # Capture root mount metrics for CSV
  if [ "${_mount_point}" = "/" ]; then
    _root_rand_bw_read="${_fio_rand_bw_read["${_mount_point}"]}"
    _root_rand_bw_write="${_fio_rand_bw_write["${_mount_point}"]}"
    _root_rand_lat_read="${_fio_rand_latency_read["${_mount_point}"]}"
    _root_rand_lat_write="${_fio_rand_latency_write["${_mount_point}"]}"
    _root_seqread_bw_read="${_fio_seqread_bw_read["${_mount_point}"]}"
    _root_seqread_lat_read="${_fio_seqread_latency_read["${_mount_point}"]}"
    _root_seqwrite_bw_write="${_fio_seqwrite_bw_write["${_mount_point}"]}"
    _root_seqwrite_lat_write="${_fio_seqwrite_latency_write["${_mount_point}"]}"
    _root_meta_ops="${_meta_ops["${_mount_point}"]}"
    _root_qd1_p95_read="${_fio_qd1_p95_read["${_mount_point}"]}"
    _root_qd1_p95_write="${_fio_qd1_p95_write["${_mount_point}"]}"
    _root_qd1_p99_read="${_fio_qd1_p99_read["${_mount_point}"]}"
    _root_qd1_p99_write="${_fio_qd1_p99_write["${_mount_point}"]}"
    _root_qd1_fsync_p95_write="${_fio_qd1_fsync_p95_write["${_mount_point}"]}"
    _root_qd1_fsync_p99_write="${_fio_qd1_fsync_p99_write["${_mount_point}"]}"
  fi
done

# ----
# Display Results
# ----
echo ""

if [ "${_COMPACT}" -eq 1 ]; then
  _print_compact_summary
else
  echo ""
  echo "==== Performance Test Summary ===="
  echo ""
  echo "System:"
  echo ""
  if [ -x "/opt/local/bin/screenfetch" ]; then
    bash /opt/local/bin/screenfetch -n
  else
    echo "  - Hostname: ${_hostname}"
    echo "  - CPU: ${_cpu_info}"
    echo "  - vCPUs: ${_cpu_cores}"
    _total_ram_mb="$(free -m | awk '/^Mem:/ {print $2}')"
    echo "  - RAM: ${_total_ram_mb} MB"
  fi
  echo ""
  echo "CPU Performance (Multi-threaded, nproc=$(nproc)):"
  echo "  - Events per Second: ${_cpu_events_MT_NPROC}"
  echo "  - Average Latency: ${_cpu_latency_MT_NPROC} ms"
  if [ -n "${_cpu_steal_mt}" ]; then
    echo "  - Avg CPU Steal: ${_cpu_steal_mt} %"
  fi
  echo ""
  echo "CPU Performance (4 threads):"
  echo "  - Events per Second: ${_cpu_events_MT4}"
  echo "  - Average Latency: ${_cpu_latency_MT4} ms"
  echo ""
  echo "CPU Performance (Single-threaded):"
  echo "  - Events per Second: ${_cpu_events_ST}"
  echo "  - Average Latency: ${_cpu_latency_ST} ms"
  echo ""
  echo "Memory Performance:"
  echo "  - Transfer Speed: ${_mem_transfer_speed}"
  if [ -n "${_mem_latency}" ]; then
    echo "  - Pointer-chase latency: ${_mem_latency} ${_mem_latency_unit}"
  else
    echo "  - Pointer-chase latency: N/A"
  fi
  if [ -n "${_mem_bench_size_mib:-}" ]; then
    echo "  - Working set: ${_mem_bench_size_mib} MiB per buffer x2 (~${_mem_bench_total_mib} MiB total), Threads: ${_mem_bench_threads} (median of ${_MEM_BENCH_REPEATS})"
    if [ -n "${_mem_bw_min}" ] && [ -n "${_mem_bw_max}" ]; then
      echo "  - Variance: ${_mem_bw_min}-${_mem_bw_max} MiB/s (bw), ${_mem_lat_min}-${_mem_lat_max} ns (lat)"
    fi
  fi
  echo ""
  echo "AES Performance (openssl enc):"
  echo "  - Time: ${_aes_seconds} s"
  echo "  - Throughput: ${_aes_mibps}"
  echo ""
  echo "Disk Latency (ioping):"
  echo "  - Seek rate: ${_ioping_seek}"
  echo "  - Sequential read: ${_ioping_seqread}"
  echo ""
  echo "Network (IPv4 single-stream):"
  echo "  - Public IPv4: ${_net_ipv4}"
  echo "  - Download score (avg best 2/4): ${_net_download}"
  if [ "${#_net_dl_name[@]}" -gt 0 ]; then
    echo "  - Tests:"
    _i=0
    while [ "${_i}" -lt "${#_net_dl_name[@]}" ]; do
      echo "    - ${_net_dl_name[${_i}]}: ${_net_dl_pretty[${_i}]}"
      _i=$((_i + 1))
    done
    [ -n "${_net_dl_top2}" ] && echo "  - Top 2: ${_net_dl_top2}"
  fi
  echo ""
  echo "PHP Performance (CLI Micro-benchmark):"
  if command -v php >/dev/null 2>&1; then
    echo "  - Runs (seconds): ${_php_time_runs}"
    echo "  - Median Time: ${_php_time_median} seconds"
    echo "  - Concurrent Procs: $( [ "$(nproc)" -gt "${_PHP_BENCH_CONCURRENCY_MAX}" ] && echo "${_PHP_BENCH_CONCURRENCY_MAX}" || nproc )"
    echo "  - Wall Time (conc.): ${_php_concurrency_wall} seconds"
    echo "  - Throughput (conc.): ${_php_concurrency_throughput}"
  else
    echo "  - PHP not installed"
  fi

  echo ""
  echo "Database OLTP (sysbench, MySQL root):"
  if [ "${_db_test_status}" = "OK" ] || [ "${_db_test_status}" = "WARN" ]; then
      echo "  - Threads: ${_db_threads_used:-N/A}"
    echo "  - Read-only:  ${_db_ro_tps} TPS, p95 ${_db_ro_p95_ms} ms"
    echo "  - Read-write: ${_db_rw_tps} TPS, p95 ${_db_rw_p95_ms} ms"
    if [ "${_db_test_status}" = "WARN" ]; then
      echo "  - Note: results parsed with warning (${_db_test_reason})"
    fi
  else
    if [ -n "${_db_test_reason}" ]; then
      echo "  - ${_db_test_status}: ${_db_test_reason}"
    else
      echo "  - ${_db_test_status}"
    fi
  fi

  for _mount_point in "${_test_mounts[@]}"; do
    [ -z "${_mount_point}" ] && continue
    echo ""
    echo "Disk I/O Performance on ${_mount_point}:"
    echo ""
    echo "  Random 4k randrw:"
    echo "    - Read IOPS: ${_fio_rand_iops_read["${_mount_point}"]}"
    echo "    - Write IOPS: ${_fio_rand_iops_write["${_mount_point}"]}"
    echo "    - Read Bandwidth: ${_fio_rand_bw_read["${_mount_point}"]}"
    echo "    - Write Bandwidth: ${_fio_rand_bw_write["${_mount_point}"]}"
    echo "    - Avg Read Latency: ${_fio_rand_latency_read["${_mount_point}"]}"
    echo "    - Avg Write Latency: ${_fio_rand_latency_write["${_mount_point}"]}"
    echo ""
    echo "  QD=1 randrw (p95/p99):"
    echo "    - Read p95/p99: ${_fio_qd1_p95_read["${_mount_point}"]} / ${_fio_qd1_p99_read["${_mount_point}"]}"
    echo "    - Write p95/p99: ${_fio_qd1_p95_write["${_mount_point}"]} / ${_fio_qd1_p99_write["${_mount_point}"]}"
    _tier_ioping_us="$(echo "${_ioping_seek_line["${_mount_point}"]:-}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1 2>/dev/null)"
    _tier_ioping_us="$(_num_or_empty "${_tier_ioping_us}")"
    _tier_srw_num="$(_num_or_empty "$(echo "${_fio_seqread_bw_read["${_mount_point}"]}" | awk '{print $1}')")"
    _tier_sww_num="$(_num_or_empty "$(echo "${_fio_seqwrite_bw_write["${_mount_point}"]}" | awk '{print $1}')")"
    _tier_p99r_num="$(_num_or_empty "$(echo "${_fio_qd1_p99_read["${_mount_point}"]}" | awk '{print $1}')")"
    _tier_p99w_num="$(_num_or_empty "$(echo "${_fio_qd1_p99_write["${_mount_point}"]}" | awk '{print $1}')")"
    _tier_fsync_p99w_num="$(_num_or_empty "$(echo "${_fio_qd1_fsync_p99_write["${_mount_point}"]}" | awk '{print $1}')")"
    _tier_storage_tier="$(_boa_guess_storage_tier "${_tier_ioping_us}" "${_tier_srw_num}" "${_tier_sww_num}" "${_tier_p99r_num}" "${_tier_p99w_num}" "${_tier_fsync_p99w_num}")"
    echo "    - Storage tier guess: ${_tier_storage_tier}"
    echo ""
    echo "  Sequential Read (128k):"
    echo "    - Read Bandwidth: ${_fio_seqread_bw_read["${_mount_point}"]}"
    echo "    - Avg Read Latency: ${_fio_seqread_latency_read["${_mount_point}"]}"
    echo ""
    echo "  Sequential Write (128k):"
    echo "    - Write Bandwidth: ${_fio_seqwrite_bw_write["${_mount_point}"]}"
    echo "    - Avg Write Latency: ${_fio_seqwrite_latency_write["${_mount_point}"]}"
    echo ""
    echo "  Metadata (small file create+read+delete):"
    echo "    - Ops per second: ${_meta_ops["${_mount_point}"]}"

    # CSV per-mount disk line (verbose mode only)
    # Format:
    # CSV_DISK_V1:hostname,"/mount",seq_read_MBps,seq_write_MBps,rand_iops_r,rand_iops_w,meta_ops,ioping_us,qd1_p99_r,qd1_p99_w,qd1_fsync_p99_w,"tier","grade"
    if [ "${_VERBOSE}" -eq 1 ]; then
      _csv_seqr_num="${_tier_srw_num}"
      _csv_seqw_num="${_tier_sww_num}"
      _csv_riops_num="$(_num_or_empty "${_fio_rand_iops_read["${_mount_point}"]}")"
      _csv_wiops_num="$(_num_or_empty "${_fio_rand_iops_write["${_mount_point}"]}")"
      _csv_meta_num="$(_num_or_empty "$(echo "${_meta_ops["${_mount_point}"]}" | awk '{print $1}')")"
      _csv_ioping_avg_us="${_tier_ioping_us}"
      _csv_p99r_num="${_tier_p99r_num}"
      _csv_p99w_num="${_tier_p99w_num}"
      _csv_fsync_p99w_num="${_tier_fsync_p99w_num}"
      _csv_disk_grade="$(_boa_grade_disk_final "${_csv_ioping_avg_us}" "${_csv_seqr_num}" "${_csv_seqw_num}" "${_csv_riops_num}" "${_csv_wiops_num}" "${_csv_meta_num}" "${_csv_p99r_num}" "${_csv_p99w_num}" "${_csv_fsync_p99w_num}")"
      echo "CSV_DISK_V1:${_hostname},\"${_mount_point}\",${_csv_seqr_num},${_csv_seqw_num},${_csv_riops_num},${_csv_wiops_num},${_csv_meta_num},${_csv_ioping_avg_us},${_csv_p99r_num},${_csv_p99w_num},${_csv_fsync_p99w_num},\"${_tier_storage_tier}\",\"${_csv_disk_grade}\""
    fi
  done

  echo ""
  echo "Performance tests completed."
  echo ""
fi

# ----
# CSV summary line (focus on root mount) for easy ingest
# ----
# Fields (comma-separated, no header):
# hostname,cpu_model,vcpus,cpu_mt_eps,cpu_4t_eps,cpu_st_eps,mem_bw,php_median_s,php_conc_thr_ops,
# root_rand_bw_read,root_rand_bw_write,root_rand_lat_r,root_rand_lat_w,
# root_seqread_bw,root_seqread_lat_r,root_seqwrite_bw,root_seqwrite_lat_w,root_meta_ops,
# aes_mibps,net_mibps

# Strip units from some disk fields for CSV
_strip_unit() {
  # $1 = value like "195.67 MB/s" or "1.23 ms"
  echo "$1" | awk '{print $1}'
}

_csv_mem_bw="$(_strip_unit "${_mem_transfer_speed}")"
_csv_root_rand_bw_read="$(_strip_unit "${_root_rand_bw_read}")"
_csv_root_rand_bw_write="$(_strip_unit "${_root_rand_bw_write}")"
_csv_root_rand_lat_read="$(_strip_unit "${_root_rand_lat_read}")"
_csv_root_rand_lat_write="$(_strip_unit "${_root_rand_lat_write}")"
_csv_root_seqread_bw_read="$(_strip_unit "${_root_seqread_bw_read}")"
_csv_root_seqread_lat_read="$(_strip_unit "${_root_seqread_lat_read}")"
_csv_root_seqwrite_bw_write="$(_strip_unit "${_root_seqwrite_bw_write}")"
_csv_root_seqwrite_lat_write="$(_strip_unit "${_root_seqwrite_lat_write}")"
_csv_root_meta_ops="$(_strip_unit "${_root_meta_ops}")"
_csv_aes_mibps="$(_strip_unit "${_aes_mibps}")"
_csv_net_download="$(_strip_unit "${_net_download}")"

# Root-only extras for grading/tiering
_csv_root_qd1_p95_read="$(_strip_unit "${_root_qd1_p95_read}")"
_csv_root_qd1_p95_write="$(_strip_unit "${_root_qd1_p95_write}")"
_csv_root_qd1_p99_read="$(_strip_unit "${_root_qd1_p99_read}")"
_csv_root_qd1_p99_write="$(_strip_unit "${_root_qd1_p99_write}")"
_csv_root_qd1_fsync_p95_write="$(_strip_unit "${_root_qd1_fsync_p95_write}")"
_csv_root_qd1_fsync_p99_write="$(_strip_unit "${_root_qd1_fsync_p99_write}")"
_csv_root_ioping_avg_us="$(echo "${_ioping_seek}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1 2>/dev/null)"
_csv_root_ioping_avg_us="$(_num_or_empty "${_csv_root_ioping_avg_us}")"
_csv_root_seqr_num="$(_num_or_empty "${_csv_root_seqread_bw_read}")"
_csv_root_seqw_num="$(_num_or_empty "${_csv_root_seqwrite_bw_write}")"
_csv_root_p99r_num="$(_num_or_empty "${_csv_root_qd1_p99_read}")"
_csv_root_p99w_num="$(_num_or_empty "${_csv_root_qd1_p99_write}")"
_csv_root_fsync_p99w_num="$(_num_or_empty "${_csv_root_qd1_fsync_p99_write}")"
_csv_root_storage_tier="$(_boa_guess_storage_tier "${_csv_root_ioping_avg_us}" "${_csv_root_seqr_num}" "${_csv_root_seqw_num}" "${_csv_root_p99r_num}" "${_csv_root_p99w_num}" "${_csv_root_fsync_p99w_num}")"

# DRAM pointer-chase latency (ns) helps distinguish true RAM vs cache effects
_csv_mem_lat_ns="${_mem_latency}"
[ -z "${_csv_mem_lat_ns}" ] && _csv_mem_lat_ns="N/A"

if [ "${_VERBOSE}" -eq 1 ]; then
  echo "CSV_SUMMARY_V4:${_hostname},\"${_cpu_info}\",${_cpu_cores},${_cpu_events_MT_NPROC},${_cpu_events_MT4},${_cpu_events_ST},${_csv_mem_bw},${_csv_mem_lat_ns},${_php_time_median},\"${_php_concurrency_throughput}\",${_csv_root_rand_bw_read},${_csv_root_rand_bw_write},${_csv_root_rand_lat_read},${_csv_root_rand_lat_write},${_csv_root_seqread_bw_read},${_csv_root_seqread_lat_read},${_csv_root_seqwrite_bw_write},${_csv_root_seqwrite_lat_write},${_csv_root_meta_ops},${_csv_root_qd1_p95_read},${_csv_root_qd1_p95_write},${_csv_root_qd1_p99_read},${_csv_root_qd1_p99_write},${_csv_root_qd1_fsync_p95_write},${_csv_root_qd1_fsync_p99_write},\"${_csv_root_storage_tier}\",${_csv_aes_mibps},${_csv_net_download}"
  echo "CSV_DB_V1:${_hostname},${_db_ro_tps},${_db_ro_p95_ms},${_db_rw_tps},${_db_rw_p95_ms},${_db_test_status}"
fi
