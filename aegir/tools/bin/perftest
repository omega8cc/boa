# Run fio random 4k randwrite QD=1 with fsync (durability-focused)
_run_fio_qd1_fsync_test() {
  # $1 = mountpoint
  # $2 = output_file
  local _mount_point="$1"
  local _output_file="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_fio_qd1_fsync_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || return 1
  fio \
    --name=randwrite_qd1_fsync \
    --directory="${_test_dir}" \
    --ioengine=sync \
    --iodepth=1 \
    --rw=randwrite \
    --bs=4k \
    --direct=0 \
    --fsync=1 \
    --size="${_FIO_QD1_FSYNC_SIZE_M}M" \
    --numjobs=1 \
    --runtime="${_FIO_QD1_FSYNC_RUNTIME}" \
    --time_based \
    --group_reporting \
    --output-format=json \
    > "${_output_file}" 2>/dev/null
  rm -rf "${_test_dir}" >/dev/null 2>&1
}
# Parse fio JSON and return values via stdout (key=value lines)
_parse_fio_json() {
  # $1 = json file
  local _json_file="$1"
  local _read_iops _write_iops _read_bw_kib _write_bw_kib
  _read_iops="$(jq -r '[.jobs[].read.iops] | add' "${_json_file}" 2>/dev/null)"
  _write_iops="$(jq -r '[.jobs[].write.iops] | add' "${_json_file}" 2>/dev/null)"
  _read_bw_kib="$(jq -r '[.jobs[].read.bw] | add' "${_json_file}" 2>/dev/null)" # KiB/s
  _write_bw_kib="$(jq -r '[.jobs[].write.bw] | add' "${_json_file}" 2>/dev/null)" # KiB/s

  local _read_clat_ns_mean _write_clat_ns_mean
  _read_clat_ns_mean="$(jq -r '([.jobs[].read.clat_ns.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
  _write_clat_ns_mean="$(jq -r '([.jobs[].write.clat_ns.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"

  local _read_lat_ms _write_lat_ms
  if [ -n "${_read_clat_ns_mean}" ] && [ -n "${_write_clat_ns_mean}" ]; then
    _read_lat_ms="$(awk -v ns="${_read_clat_ns_mean}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
    _write_lat_ms="$(awk -v ns="${_write_clat_ns_mean}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  else
    local _read_clat_usec_mean _write_clat_usec_mean
    _read_clat_usec_mean="$(jq -r '([.jobs[].read.clat.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
    _write_clat_usec_mean="$(jq -r '([.jobs[].write.clat.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
    _read_lat_ms="$(awk -v us="${_read_clat_usec_mean:-0}" 'BEGIN{printf "%.2f", us/1000.0}')"
    _write_lat_ms="$(awk -v us="${_write_clat_usec_mean:-0}" 'BEGIN{printf "%.2f", us/1000.0}')"
  fi

  local _read_bw_mb _write_bw_mb
  _read_bw_mb="$(awk -v kib="${_read_bw_kib:-0}" 'BEGIN{printf "%.2f", kib/1024.0}')"
  _write_bw_mb="$(awk -v kib="${_write_bw_kib:-0}" 'BEGIN{printf "%.2f", kib/1024.0}')"


  # Optional percentiles (fio3+): clat_ns.percentile
  local _read_p95_ns _read_p99_ns _write_p95_ns _write_p99_ns
  local _read_p95_ms _read_p99_ms _write_p95_ms _write_p99_ms
  local _sync_p95_ns _sync_p99_ns _sync_p95_ms _sync_p99_ms

  _read_p95_ns="$(jq -r '([.jobs[].read.clat_ns.percentile["95.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _read_p99_ns="$(jq -r '([.jobs[].read.clat_ns.percentile["99.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _write_p95_ns="$(jq -r '([.jobs[].write.clat_ns.percentile["95.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _write_p99_ns="$(jq -r '([.jobs[].write.clat_ns.percentile["99.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"

  if [ -n "${_read_p95_ns}" ]; then
    _read_p95_ms="$(awk -v ns="${_read_p95_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_read_p99_ns}" ]; then
    _read_p99_ms="$(awk -v ns="${_read_p99_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_write_p95_ns}" ]; then
    _write_p95_ms="$(awk -v ns="${_write_p95_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_write_p99_ns}" ]; then
    _write_p99_ms="$(awk -v ns="${_write_p99_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi

  # Optional percentiles for sync/fsync (fio JSON uses a separate sync section)
  _sync_p95_ns="$(jq -r '([.jobs[].sync.lat_ns.percentile["95.000000"]?] | map(select(.!=null)) | max) // ([.jobs[].sync.clat_ns.percentile["95.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  _sync_p99_ns="$(jq -r '([.jobs[].sync.lat_ns.percentile["99.000000"]?] | map(select(.!=null)) | max) // ([.jobs[].sync.clat_ns.percentile["99.000000"]?] | map(select(.!=null)) | max) // empty' "${_json_file}" 2>/dev/null)"
  if [ -n "${_sync_p95_ns}" ]; then
    _sync_p95_ms="$(awk -v ns="${_sync_p95_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi
  if [ -n "${_sync_p99_ns}" ]; then
    _sync_p99_ms="$(awk -v ns="${_sync_p99_ns}" 'BEGIN{printf "%.2f", ns/1000000.0}')"
  fi

  echo "READ_IOPS=${_read_iops}"
  echo "WRITE_IOPS=${_write_iops}"
  echo "READ_BW_MB=${_read_bw_mb}"
  echo "WRITE_BW_MB=${_write_bw_mb}"
  echo "READ_LAT_MS=${_read_lat_ms}"
  echo "WRITE_LAT_MS=${_write_lat_ms}"
  echo "READ_P95_MS=${_read_p95_ms}"
  echo "READ_P99_MS=${_read_p99_ms}"
  echo "WRITE_P95_MS=${_write_p95_ms}"
  echo "WRITE_P99_MS=${_write_p99_ms}"
  echo "SYNC_P95_MS=${_sync_p95_ms}"
  echo "SYNC_P99_MS=${_sync_p99_ms}"
}

# Simple metadata / small file operations test
_run_metadata_test() {
  # $1 = mountpoint
  # $2 = output var name (global)
  local _mount_point="$1"
  local _outvar="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_meta_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || { eval "${_outvar}=\"ERROR\""; return; }

  local _count="${_METADATA_FILE_COUNT}"
  local _start _end _elapsed _ops _ops_per_sec

  _start="$(date +%s.%N)"
  local _i
  for _i in $(seq 1 "${_count}"); do
    echo "x" > "${_test_dir}/file_${_i}" || break
  done
  for _i in $(seq 1 "${_count}"); do
    cat "${_test_dir}/file_${_i}" >/dev/null 2>&1 || break
  done
  rm -f "${_test_dir}"/file_* >/dev/null 2>&1
  rmdir "${_test_dir}" >/dev/null 2>&1 || true
  _end="$(date +%s.%N)"

  _elapsed="$(echo "${_end} - ${_start}" | bc -l 2>/dev/null || echo 0)"
  _ops=$((_count * 2))
  if [ "${_elapsed}" != "0" ]; then
    _ops_per_sec="$(echo "${_ops} / ${_elapsed}" | bc -l 2>/dev/null || echo 0)"
    eval "${_outvar}=\"$(printf '%.2f' "${_ops_per_sec}") ops/s\""
  else
    eval "${_outvar}=\"ERROR\""
  fi
}

# Run sysbench CPU and extract events/sec and avg latency
_run_sysbench_cpu() {
  # $1 = threads
  # $2 = label (for variable names)
  local _threads="$1"
  local _label="$2"
  local _test
  _test="$(sysbench cpu --threads="${_threads}" --time="${_SYSBENCH_CPU_TIME}" run 2>/dev/null)"
  local _events _lat
  _events="$(echo "${_test}" | awk '/events per second:/ {print $4}')"
  _lat="$(echo "${_test}" | awk '/avg:/ {print $2}')"
  eval "_cpu_events_${_label}=\"${_events}\""
  eval "_cpu_latency_${_label}=\"${_lat}\""
}

# PHP micro-benchmark: multi-run median + concurrent throughput
_run_php_benchmarks() {
  if ! command -v php >/dev/null 2>&1; then
    _php_time_median="N/A (php not installed)"
    _php_time_runs=""
    _php_concurrency_wall="N/A"
    _php_concurrency_throughput="N/A"
    return
  fi

  local _script="/tmp/phpbench.php"
  cat << 'EOF' > "${_script}"
<?php
$iterations = getenv('PHP_BENCH_ITERATIONS') ? intval(getenv('PHP_BENCH_ITERATIONS')) : 50000;
$start = microtime(true);
$acc = 0;
for ($i = 0; $i < $iterations; $i++) {
  $s = "the quick brown fox jumps over the lazy dog " . $i;
  $h = hash('sha256', $s, false);
  $acc += ord($h[0]);
}
$elapsed = microtime(true) - $start;
printf("%.6f\n", $elapsed);
EOF

  local _runs="${_PHP_BENCH_RUNS}"
  local _times=()
  local _i
  echo "Running PHP single-thread benchmark (${_runs} runs, iterations=${_PHP_BENCH_ITERATIONS})..."
  for _i in $(seq 1 "${_runs}"); do
    local _t
    _t="$(PHP_BENCH_ITERATIONS="${_PHP_BENCH_ITERATIONS}" php "${_script}" 2>/dev/null || echo 0)"
    _log " Run ${_i}: ${_t} seconds"
    _times+=("${_t}")
  done

  # Median (PHP_BENCH_RUNS is 5, so 3rd value after sort)
  local _sorted
  _sorted=($(printf '%s\n' "${_times[@]}" | sort -n))
  _php_time_median="${_sorted[2]}"
  _php_time_runs="$(printf '%s ' "${_times[@]}")"

  # Concurrent benchmark
  local _conc
  local _nproc
  _nproc="$(nproc)"
  if [ "${_nproc}" -le 0 ]; then
    _nproc=1
  fi
  if [ "${_nproc}" -gt "${_PHP_BENCH_CONCURRENCY_MAX}" ]; then
    _conc="${_PHP_BENCH_CONCURRENCY_MAX}"
  else
    _conc="${_nproc}"
  fi

  echo "Running PHP concurrent benchmark (${_conc} processes, iterations=${_PHP_BENCH_ITERATIONS} each)..."
  local _start _end _elapsed
  _start="$(date +%s.%N)"
  for _i in $(seq 1 "${_conc}"); do
    PHP_BENCH_ITERATIONS="${_PHP_BENCH_ITERATIONS}" php "${_script}" >/dev/null 2>&1 &
  done
  wait
  _end="$(date +%s.%N)"
  _elapsed="$(echo "${_end} - ${_start}" | bc -l 2>/dev/null || echo 0)"
  _php_concurrency_wall="$(printf '%.6f' "${_elapsed}")"

  if [ "${_elapsed}" != "0" ]; then
    local _total_ops
    _total_ops="$(echo "${_conc} * ${_PHP_BENCH_ITERATIONS}" | bc -l 2>/dev/null || echo 0)"
    local _thr
    _thr="$(echo "${_total_ops} / ${_elapsed}" | bc -l 2>/dev/null || echo 0)"
    _php_concurrency_throughput="$(printf '%.2f ops/sec' "${_thr}")"
  else
    _php_concurrency_throughput="N/A"
  fi

  rm -f "${_script}" >/dev/null 2>&1
}

# ----
# BOA-specific grading helpers
# ----
_num_or_empty() {
  printf '%s' "$1" | grep -Eo '^[0-9]+(\.[0-9]+)?' || true
}

_median_num() {
  # Median of numeric arguments (prints empty if no valid inputs)
  # Uses simple sort; intended for small N (default repeats=3).
  if [ "$#" -eq 0 ]; then
    echo ""
    return
  fi
  printf '%s\n' "$@" | awk 'NF{print}' | sort -n | awk '{a[NR]=$1} END{if(NR==0){print ""; exit} mid=int((NR+1)/2); printf "%.3f", a[mid]}'
}

_max_num() {
  # Max of numeric arguments (prints empty if no valid inputs)
  if [ "$#" -eq 0 ]; then
    echo ""
    return
  fi
  printf '%s\n' "$@" | awk 'NF{print}' | sort -n | tail -n 1
}


_boa_grade_mem_bw() {
  # Bandwidth in MiB/s; optionally pass number of threads used.
  # For VMs with 1-3 vCPU, bandwidth won't fully saturate memory channels, so we scale
  # thresholds down slightly based on threads (up to 4).
  local bw="$1"
  local threads="${2:-4}"
  local scale="1.00"

  if [ -n "${threads}" ] && awk -v t="${threads}" 'BEGIN{exit !(t<4)}' 2>/dev/null; then
    scale="$(awk -v t="${threads}" 'BEGIN{printf "%.2f", t/4.0}')"
  fi

  local thr_avg thr_good thr_exc thr_ultra
  # Tuned for membench (>=128 MiB buffers) on typical VPS hardware.
  thr_avg="$(awk -v s="${scale}" 'BEGIN{printf "%.0f", 14000*s}')"
  thr_good="$(awk -v s="${scale}" 'BEGIN{printf "%.0f", 20000*s}')"
  thr_exc="$(awk -v s="${scale}" 'BEGIN{printf "%.0f", 32000*s}')"
  thr_ultra="$(awk -v s="${scale}" 'BEGIN{printf "%.0f", 48000*s}')"

  if [ -z "${bw}" ]; then
    echo "low"
    return
  fi

  if awk -v bw="${bw}" -v t="${thr_ultra}" 'BEGIN{exit !(bw>=t)}' 2>/dev/null; then
    echo "ultra"; return
  fi
  if awk -v bw="${bw}" -v t="${thr_exc}" 'BEGIN{exit !(bw>=t)}' 2>/dev/null; then
    echo "excellent"; return
  fi
  if awk -v bw="${bw}" -v t="${thr_good}" 'BEGIN{exit !(bw>=t)}' 2>/dev/null; then
    echo "good"; return
  fi
  if awk -v bw="${bw}" -v t="${thr_avg}" 'BEGIN{exit !(bw>=t)}' 2>/dev/null; then
    echo "average"; return
  fi

  echo "low"
}

_boa_grade_mem_final() {
  local mem_bw_mibps="$1"
  local mem_latency_ns="$2"
  local threads_used="$3"
  local grade

  grade="$(_boa_grade_mem_bw "${mem_bw_mibps}" "${threads_used}")"

  # BOA is latency-sensitive (Valkey/Redis, MySQL buffer pool, Opcache/APCu):
  #   - allow low latency to lift borderline bandwidth
  #   - apply latency-led caps so higher grades reflect snappy cache-heavy workloads
  if [ -n "${mem_latency_ns}" ]; then
    # Low-latency boost: keep small-vCPU VMs from being unfairly rated.
    if awk -v l="${mem_latency_ns}" 'BEGIN{exit !(l<=130)}' 2>/dev/null; then
      if [ "${grade}" = "average" ] && awk -v b="${mem_bw_mibps}" 'BEGIN{exit !(b>=18000)}' 2>/dev/null; then
        grade="good"
      fi
    fi

    # If latency is excellent, ensure at least "excellent" (BOA in-RAM stacks feel this).
    if awk -v l="${mem_latency_ns}" 'BEGIN{exit !(l<=115)}' 2>/dev/null; then
      if [ "${grade}" = "average" ] || [ "${grade}" = "good" ]; then
        grade="excellent"
      fi
    fi

    # Latency-led caps (calibrated from real v9 fleet distribution):
    #   - >140ns: cap ultra/excellent to good
    #   - >165ns: cap ultra/excellent to good (still production-worthy, but not top tier)
    #   - >200ns: cap to average (typically noisy-neighbor/NUMA/host contention)
    #   - >=260ns: treat as low ONLY when bandwidth is also weak
    if awk -v l="${mem_latency_ns}" 'BEGIN{exit !(l>=260)}' 2>/dev/null; then
      # If bandwidth is strong, this is likely a contention outlier rather than "bad RAM".
      if awk -v b="${mem_bw_mibps}" 'BEGIN{exit !(b>=30000)}' 2>/dev/null; then
        grade="average"
      else
        grade="low"
      fi
    elif awk -v l="${mem_latency_ns}" 'BEGIN{exit !(l>200)}' 2>/dev/null; then
      if [ "${grade}" != "low" ]; then
        grade="average"
      fi
    elif awk -v l="${mem_latency_ns}" 'BEGIN{exit !(l>165)}' 2>/dev/null; then
      if [ "${grade}" = "ultra" ] || [ "${grade}" = "excellent" ]; then
        grade="good"
      fi
    elif awk -v l="${mem_latency_ns}" 'BEGIN{exit !(l>140)}' 2>/dev/null; then
      if [ "${grade}" = "ultra" ] || [ "${grade}" = "excellent" ]; then
        grade="good"
      fi
    fi
  fi

  echo "${grade}"
}

_boa_grade_cpu_steal() {
  # input: percent
  awk -v s="$1" 'BEGIN{
    if (s=="" || s=="N/A") print "unknown";
    else if (s<1) print "excellent";
    else if (s<3) print "good";
    else if (s<7) print "warning";
    else print "bad";
  }'
}

_boa_grade_cpu_speed() {
  # input: single-thread events/sec
  # Based on typical BOA workloads (Drupal PHP)
  awk -v eps="$1" 'BEGIN{
    if (eps=="" || eps=="N/A") print "unknown";
    else if (eps>=5000) print "ultra";
    else if (eps>=4000) print "excellent";
    else if (eps>=3000) print "good";
    else if (eps>=2000) print "average";
    else if (eps>=1000) print "acceptable";
    else print "poor";
  }'
}

_boa_grade_db_oltp() {
  # Inputs:
  #  $1 = rw_tps, $2 = rw_p95_ms, $3 = vcpus, $4 = ro_p95_ms (optional)
  #
  # This is a lightweight "experience proxy" for Drupal workloads (cache misses + writes).
  # We grade primarily on RW TPS per vCPU, with latency caps on RW p95.
  local rw_tps rw_p95 vcpus ro_p95 per_vcpu
  rw_tps="$(_num_or_empty "$1")"
  rw_p95="$(_num_or_empty "$2")"
  vcpus="$(_num_or_empty "$3")"
  ro_p95="$(_num_or_empty "$4")"

  [ -n "${vcpus}" ] || vcpus="1"

  if [ -z "${rw_tps}" ] || [ -z "${rw_p95}" ]; then
    echo "unknown"
    return
  fi

  per_vcpu="$(awk -v t="${rw_tps}" -v c="${vcpus}" 'BEGIN{if(c>0) printf "%.2f", t/c; else print ""}')"

  if awk -v p="${per_vcpu}" -v l="${rw_p95}" 'BEGIN{exit !(p<250 || l>=25)}' 2>/dev/null; then
    echo "poor"; return
  fi
  if awk -v p="${per_vcpu}" -v l="${rw_p95}" 'BEGIN{exit !(p<400 || l>=15)}' 2>/dev/null; then
    echo "average"; return
  fi
  if awk -v p="${per_vcpu}" -v l="${rw_p95}" 'BEGIN{exit !(p<600 || l>=10)}' 2>/dev/null; then
    echo "good"; return
  fi
  if awk -v p="${per_vcpu}" -v l="${rw_p95}" 'BEGIN{exit !(p<900 || l>=7)}' 2>/dev/null; then
    echo "excellent"; return
  fi

  echo "ultra"
}

_boa_grade_disk_final() {
  # Inputs (best-effort numeric):
  #  $1=ioping_avg_us, $2=seq_read_mbps, $3=seq_write_mbps, $4=read_iops, $5=write_iops, $6=meta_ops,
  #  $7=qd1_p99_read_ms, $8=qd1_p99_write_ms, $9=qd1_fsync_p99_write_ms
  #
  # Design goal:
  # - Preserve the original (v9) multi-signal logic (seq, iops, ioping, metadata) so you can reason about *why* a grade was chosen.
  # - Add DB-realistic *caps* driven by QD=1 p99 + fsync p99 so we never call high-tail storage “excellent”.

  local ioping_us="$1"
  local seq_read_mbps="$2"
  local seq_write_mbps="$3"
  local read_iops="$4"
  local write_iops="$5"
  local meta_ops="$6"
  local qd1_p99_read_ms="$7"
  local qd1_p99_write_ms="$8"
  local qd1_fsync_p99_write_ms="$9"

  # Extract numeric values
  ioping_us="$(_num_or_empty "${ioping_us}")"
  seq_read_mbps="$(_num_or_empty "${seq_read_mbps}")"
  seq_write_mbps="$(_num_or_empty "${seq_write_mbps}")"
  read_iops="$(_num_or_empty "${read_iops}")"
  write_iops="$(_num_or_empty "${write_iops}")"
  meta_ops="$(_num_or_empty "${meta_ops}")"
  qd1_p99_read_ms="$(_num_or_empty "${qd1_p99_read_ms}")"
  qd1_p99_write_ms="$(_num_or_empty "${qd1_p99_write_ms}")"
  qd1_fsync_p99_write_ms="$(_num_or_empty "${qd1_fsync_p99_write_ms}")"

  # CRITICAL: Sequential write throttled/failing
  if [ -n "${seq_write_mbps}" ] && awk -v sw="${seq_write_mbps}" 'BEGIN{exit !(sw<100)}' 2>/dev/null; then
    echo "bad"
    return
  fi

  # Base grade (throughput-first, like v9)
  local grade="poor"

  # Check if we have both read and write
  if [ -n "${seq_read_mbps}" ] && [ -n "${seq_write_mbps}" ]; then
    # EXCELLENT: NVMe-class (write > 1000 AND read > 2000)
    if awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>1000 && sr>2000)}' 2>/dev/null; then
      grade="excellent"
    # GOOD: Healthy SSD (write > 500 AND read > 1000)
    elif awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>500 && sr>1000)}' 2>/dev/null; then
      grade="good"
    # OK: Moderate (write > 300 AND read > 500)
    elif awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>300 && sr>500)}' 2>/dev/null; then
      grade="average"
    # POOR: Below thresholds but not catastrophic
    else
      grade="poor"
    fi
  fi

  # Helper: rank for min/max comparisons
  _grade_rank() {
    case "$1" in
      bad) echo 0 ;;
      poor) echo 1 ;;
      average) echo 2 ;;
      good) echo 3 ;;
      excellent) echo 4 ;;
      *) echo 1 ;;
    esac
  }

  _rank_to_grade() {
    case "$1" in
      0) echo bad ;;
      1) echo poor ;;
      2) echo average ;;
      3) echo good ;;
      4) echo excellent ;;
      *) echo poor ;;
    esac
  }

  # Compute DB-realistic cap from QD1+fsync (if available)
  local cap_grade=""
  if [ -n "${qd1_fsync_p99_write_ms}" ] && [ -n "${qd1_p99_read_ms}" ] && [ -n "${qd1_p99_write_ms}" ] && [ -n "${ioping_us}" ]; then
    if awk -v f="${qd1_fsync_p99_write_ms}" -v r="${qd1_p99_read_ms}" -v w="${qd1_p99_write_ms}" -v io="${ioping_us}"       'BEGIN{exit !(f<=2 && r<=0.5 && w<=0.5 && io<=200)}' 2>/dev/null; then
      cap_grade="excellent"
    elif awk -v f="${qd1_fsync_p99_write_ms}" -v r="${qd1_p99_read_ms}" -v w="${qd1_p99_write_ms}"       'BEGIN{exit !(f<=5 && r<=1.0 && w<=1.0)}' 2>/dev/null; then
      cap_grade="good"
    elif awk -v f="${qd1_fsync_p99_write_ms}" -v r="${qd1_p99_read_ms}" -v w="${qd1_p99_write_ms}"       'BEGIN{exit !(f<=12 && r<=3.0 && w<=3.0)}' 2>/dev/null; then
      cap_grade="average"
    else
      cap_grade="poor"
    fi
  fi

  # IOPS boost (same spirit as v9), but never above cap_grade if present
  if [ -n "${read_iops}" ] && [ -n "${write_iops}" ]; then
    if awk -v ri="${read_iops}" -v wi="${write_iops}" 'BEGIN{exit !(ri>10000 && wi>10000)}' 2>/dev/null; then
      local r=$(_grade_rank "${grade}")
      if [ "${r}" -lt 4 ]; then
        r=$((r+1))
        grade="$(_rank_to_grade "${r}")"
      fi
    fi
  fi

  # Metadata boost (small): only if already >= average
  if [ -n "${meta_ops}" ]; then
    if awk -v m="${meta_ops}" 'BEGIN{exit !(m>5000)}' 2>/dev/null; then
      case "${grade}" in
        average) grade="good" ;;
        good) grade="excellent" ;;
      esac
    fi
  fi

  # ioping reality check: very bad latency downgrades one level
  if [ -n "${ioping_us}" ] && awk -v i="${ioping_us}" 'BEGIN{exit !(i>2000)}' 2>/dev/null; then
    case "${grade}" in
      excellent) grade="good" ;;
      good) grade="average" ;;
      average) grade="poor" ;;
    esac
  fi

  # Apply DB-realistic cap (prevents “excellent” on high-tail storage)
  if [ -n "${cap_grade}" ]; then
    local gr=$(_grade_rank "${grade}")
    local cr=$(_grade_rank "${cap_grade}")
    if [ "${gr}" -gt "${cr}" ]; then
      grade="${cap_grade}"
    fi
  fi

  # Extra safety: extreme tails force poor even if cap_grade not available
  if [ -n "${qd1_p99_write_ms}" ] && awk -v p="${qd1_p99_write_ms}" 'BEGIN{exit !(p>150)}' 2>/dev/null; then
    grade="poor"
  fi
  if [ -n "${qd1_fsync_p99_write_ms}" ] && awk -v p="${qd1_fsync_p99_write_ms}" 'BEGIN{exit !(p>250)}' 2>/dev/null; then
    grade="poor"
  fi

  echo "${grade}"
}

_boa_grade_network() {
  # input: numeric MiB/s
  awk -v n="$1" 'BEGIN{
    if (n=="" || n=="N/A") print "unknown";
    else if (n>=150) print "ultra";
    else if (n>=100) print "excellent";
    else if (n>=75) print "good";
    else if (n>=50) print "average";
    else print "poor";
  }'
}

_boa_guess_storage_tier() {
  # Behavior-first storage guess for BOA/Drupal.
  # We *can* usually infer LOCAL vs NET from latency/variance/caps.
  # We *cannot* reliably infer the physical media behind network block storage,
  # so network labels use *_CLASS suffix to mean "behaves like".
  #
  # Inputs (numeric, best-effort):
  # $1 = ioping_avg_us
  # $2 = seq_read_mbps
  # $3 = seq_write_mbps
  # $4 = qd1_p99_read_ms
  # $5 = qd1_p99_write_ms
  # $6 = qd1_fsync_p99_write_ms
  local ioping_us="$1"
  local sr="$2"
  local sw="$3"
  local p99r="$4"
  local p99w="$5"
  local p99wf="$6"

  # Hard fail / severely throttled
  if [ -n "${sw}" ] && awk -v sw="${sw}" 'BEGIN{exit !(sw<100)}' 2>/dev/null; then
    echo "CRITICAL_DEGRADED"
    return
  fi

  # Normalize unknowns
  [ -n "${ioping_us}" ] || ioping_us=""
  [ -n "${sr}" ] || sr=""
  [ -n "${sw}" ] || sw=""
  [ -n "${p99r}" ] || p99r=""
  [ -n "${p99w}" ] || p99w=""
  [ -n "${p99wf}" ] || p99wf=""

  # ----
  # Step 0: DEGRADED detection (HDD-ish / ancient SSD / extremely contended)
  # ----
  local _degraded="NO"
  if [ -n "${sw}" ] && awk -v sw="${sw}" 'BEGIN{exit !(sw<150)}' 2>/dev/null; then
    _degraded="YES"
  fi
  if [ "${_degraded}" = "NO" ] && [ -n "${p99wf}" ] && awk -v f="${p99wf}" 'BEGIN{exit !(f>50)}' 2>/dev/null; then
    _degraded="YES"
  fi
  if [ "${_degraded}" = "NO" ] && [ -n "${p99w}" ] && awk -v w="${p99w}" 'BEGIN{exit !(w>10)}' 2>/dev/null; then
    _degraded="YES"
  fi
  if [ "${_degraded}" = "NO" ] && [ -n "${ioping_us}" ] && awk -v u="${ioping_us}" 'BEGIN{exit !(u>1500)}' 2>/dev/null; then
    _degraded="YES"
  fi

  # ----
  # Step 1: LOCAL vs NET guess
  # ----
  local _net="NO"

  # Strong signal: ioping in high hundreds of microseconds usually means network/storage fabric.
  if [ -n "${ioping_us}" ] && awk -v u="${ioping_us}" 'BEGIN{exit !(u>=350)}' 2>/dev/null; then
    _net="YES"
  fi

  # Durability tail + random tail suggests network block, even if sequential is OK.
  if [ "${_net}" = "NO" ] && [ -n "${p99wf}" ] && [ -n "${p99w}" ] && \
     awk -v f="${p99wf}" -v w="${p99w}" 'BEGIN{exit !(f>=8 && (w>=1.0))}' 2>/dev/null; then
    _net="YES"
  fi

  # Classic capped-block signature (e.g., ~500-600 MB/s ceilings)
  if [ "${_net}" = "NO" ] && [ -n "${sr}" ] && [ -n "${sw}" ] && [ -n "${ioping_us}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" -v u="${ioping_us}" 'BEGIN{exit !(sr>=450 && sr<=700 && sw>=350 && sw<=700 && u>=250)}' 2>/dev/null; then
    _net="YES"
  fi

  # ----
  # Step 2: Performance class (NVMe vs SSD) based on observed behavior
  # ----
  local _class="UNKNOWN"

  # NVMe-class: very low QD=1 tail + low ioping
  if [ -n "${p99r}" ] && [ -n "${p99w}" ] && [ -n "${ioping_us}" ] && \
     awk -v pr="${p99r}" -v pw="${p99w}" -v u="${ioping_us}" 'BEGIN{exit !(pr<=0.20 && pw<=0.20 && u<=200)}' 2>/dev/null; then
    _class="NVME"
  fi

  # NVMe-class (throughput override): some providers cap per-VM throughput/latency,
  # but multi-GB/s sequential strongly indicates NVMe-class when not network.
  if [ "${_class}" = "UNKNOWN" ] && [ "${_net}" = "NO" ] && [ "${_degraded}" = "NO" ] && \
     [ -n "${sr}" ] && [ -n "${sw}" ] && [ -n "${ioping_us}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" -v u="${ioping_us}" 'BEGIN{exit !((sr>=1500 || sw>=1200) && u<=350)}' 2>/dev/null; then
    _class="NVME"
  fi

  # SSD-class: still decent tails, but not NVMe-like
  if [ "${_class}" = "UNKNOWN" ] && [ -n "${p99w}" ] && [ -n "${p99wf}" ] && \
     awk -v w="${p99w}" -v f="${p99wf}" 'BEGIN{exit !(w<=2.0 && f<=20)}' 2>/dev/null; then
    _class="SSD"
  fi

  # Fallback when tails are missing: use seq + ioping
  if [ "${_class}" = "UNKNOWN" ] && [ -n "${sr}" ] && [ -n "${sw}" ] && [ -n "${ioping_us}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" -v u="${ioping_us}" 'BEGIN{exit !(sw>=1200 && sr>=1800 && u<=350)}' 2>/dev/null; then
    _class="NVME"
  fi
  if [ "${_class}" = "UNKNOWN" ] && [ -n "${sr}" ] && [ -n "${sw}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" 'BEGIN{exit !(sw>=300 && sr>=600)}' 2>/dev/null; then
    _class="SSD"
  fi

  # ----
  # Final label
  # ----
  if [ "${_degraded}" = "YES" ]; then
    if [ "${_net}" = "YES" ]; then
      echo "NET_DEGRADED"
    else
      echo "LOCAL_DEGRADED"
    fi
    return
  fi

  # LOCAL NVMe that is clearly capped by policy/limits (common on some vendors).
  # We infer this when latency looks local+NVMe-like, but sequential sits in a well-known ceiling band.
  if [ "${_net}" = "NO" ] && [ -n "${sr}" ] && [ -n "${sw}" ] && [ -n "${ioping_us}" ] && [ -n "${p99wf}" ] && [ -n "${p99w}" ] && \
     awk -v sr="${sr}" -v sw="${sw}" -v u="${ioping_us}" -v f="${p99wf}" -v w="${p99w}" \
       'BEGIN{exit !((sr>=450 && sr<=750) && (sw>=350 && sw<=750) && (u<=250) && (f<=5) && (w<=1.0))}' 2>/dev/null; then
    echo "LOCAL_NVME_CAPPED"
    return
  fi

  if [ "${_net}" = "YES" ]; then
    if [ "${_class}" = "NVME" ]; then
      echo "NET_NVME_CLASS"
    else
      # default for net block: SSD-class behavior is most common
      echo "NET_SSD_CLASS"
    fi
  else
    if [ "${_class}" = "NVME" ]; then
      echo "LOCAL_NVME"
    else
      echo "LOCAL_SSD"
    fi
  fi
}

_print_disk_compact_section() {
  # $1 = mountpoint, $2 = short description (header hint)
  local _mp="$1"
  local _desc="$2"

  local _seqw _seqr _riops _wiops _meta
  local _rbw _wbw _rlat _wlat
  local _seek_line _ioping_avg _ioping_avg_us
  local _seqw_num _seqr_num _riops_num _wiops_num _meta_num
  local _disk_grade

  _seqw="${_fio_seqwrite_bw_write["${_mp}"]:-N/A}"
  _seqr="${_fio_seqread_bw_read["${_mp}"]:-N/A}"
  _riops="${_fio_rand_iops_read["${_mp}"]:-N/A}"
  _wiops="${_fio_rand_iops_write["${_mp}"]:-N/A}"
  _meta="${_meta_ops["${_mp}"]:-N/A}"

  _rbw="${_fio_rand_bw_read["${_mp}"]:-N/A}"
  _wbw="${_fio_rand_bw_write["${_mp}"]:-N/A}"
  _rlat="${_fio_rand_latency_read["${_mp}"]:-N/A}"
  _wlat="${_fio_rand_latency_write["${_mp}"]:-N/A}"

  _seek_line="${_ioping_seek_line["${_mp}"]:-N/A}"
  _ioping_avg="$(echo "${_seek_line}" | grep -oP '\d+\.\d+ us' | head -2 | tail -1 2>/dev/null)"
  [ -n "${_ioping_avg}" ] || _ioping_avg="N/A"
  _ioping_avg_us="$(echo "${_seek_line}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1 2>/dev/null)"

  _seqw_num="$(_num_or_empty "$(echo "${_seqw}" | awk '{print $1}')")"
  _seqr_num="$(_num_or_empty "$(echo "${_seqr}" | awk '{print $1}')")"
  _riops_num="$(_num_or_empty "${_riops}")"
  _wiops_num="$(_num_or_empty "${_wiops}")"
  _meta_num="$(_num_or_empty "$(echo "${_meta}" | awk '{print $1}')")"

  _qd1_p95_r="${_fio_qd1_p95_read["${_mp}"]:-N/A}"
  _qd1_p95_w="${_fio_qd1_p95_write["${_mp}"]:-N/A}"
  _qd1_p99_r="${_fio_qd1_p99_read["${_mp}"]:-N/A}"
  _qd1_p99_w="${_fio_qd1_p99_write["${_mp}"]:-N/A}"
  _qd1_fsync_p95_w="${_fio_qd1_fsync_p95_write["${_mp}"]:-N/A}"
  _qd1_fsync_p99_w="${_fio_qd1_fsync_p99_write["${_mp}"]:-N/A}"

  _qd1_p99_r_num="$(_num_or_empty "$(echo "${_qd1_p99_r}" | awk "{print \$1}")")"
  _qd1_p99_w_num="$(_num_or_empty "$(echo "${_qd1_p99_w}" | awk "{print \$1}")")"
  _qd1_fsync_p99_w_num="$(_num_or_empty "$(echo "${_qd1_fsync_p99_w}" | awk "{print \$1}")")"

  _disk_grade="$(_boa_grade_disk_final "${_ioping_avg_us}" "${_seqr_num}" "${_seqw_num}" "${_riops_num}" "${_wiops_num}" "${_meta_num}" "${_qd1_p99_r_num}" "${_qd1_p99_w_num}" "${_qd1_fsync_p99_w_num}")"
  _storage_tier="$(_boa_guess_storage_tier "${_ioping_avg_us}" "${_seqr_num}" "${_seqw_num}" "${_qd1_p99_r_num}" "${_qd1_p99_w_num}" "${_qd1_fsync_p99_w_num}")"

  echo " ============================================================================="
  if [ "${_mp}" = "/" ]; then
    echo " == 3. DISK (Root partition / main filesystem)                              =="
  else
    printf " == 3. DISK (%s) (Mounted extra filesystem) \n" "${_mp}"
  fi
  echo " ============================================================================="
  echo ""
  printf "   Sequential write (CRITICAL): %s\n" "${_seqw}"
  printf "   Sequential read:             %s\n" "${_seqr}"
  printf "   Random 4K IOPS:              %s read / %s write\n" "${_riops}" "${_wiops}"
  printf "   Real latency (ioping avg):   %s\n" "${_ioping_avg}"
  printf "   Metadata ops:                %s\n" "${_meta}"
  printf "   Random 4K QD1 p95/p99:       %s / %s read, %s / %s write\n" "${_qd1_p95_r}" "${_qd1_p99_r}" "${_qd1_p95_w}" "${_qd1_p99_w}"
  printf "   Random 4K QD1 fsync p95/p99: %s / %s write\n" "${_qd1_fsync_p95_w}" "${_qd1_fsync_p99_w}"
  printf "   Storage tier guess:          %s\n" "${_storage_tier}"
  echo ""
  printf "   Details (fio synthetic latency):\n"
  printf "     Random 4K read:   %s @ %s\n" "${_rbw}" "${_rlat}"
  printf "     Random 4K write:  %s @ %s\n" "${_wbw}" "${_wlat}"
  echo ""

  if [ "${_disk_grade}" = "bad" ]; then
    echo "   ❌ CRITICAL: Sequential write < 100 MB/s - disk is throttled or failing!"
    echo "      This will severely impact BOA performance (cache writes, logs, DB)"
  elif [ "${_disk_grade}" = "poor" ]; then
    echo "   ⚠️  Disk profile looks weak (slow SSD/attached)"
  elif [ "${_disk_grade}" = "average" ]; then
    echo "   ✅  Average disk performance for BOA workloads"
  elif [ "${_disk_grade}" = "good" ]; then
    echo "   🌟  Good disk performance for BOA workloads"
  elif [ "${_disk_grade}" = "excellent" ]; then
    echo "   🏆  Excellent disk performance (NVMe-class)"
  fi
  echo ""
}

_print_compact_summary() {
  echo " ============================================================================="
  echo " ==                 BOA Performance Test - Compact Summary                  =="
  echo " ==              Priority: Memory > CPU > Disk > DB > Network               =="
  echo " ============================================================================="
  echo ""
  echo "System:"
  echo ""
  if [ -x "/opt/local/bin/screenfetch" ]; then
    bash /opt/local/bin/screenfetch -n
  else
    echo "Host:  ${_hostname}"
    echo "CPU:   ${_cpu_info}"
    echo "vCPUs: ${_cpu_cores}"
    _total_ram_mb="$(free -m | awk '/^Mem:/ {print $2}')"
    echo "RAM:   ${_total_ram_mb} MB"
  fi
  echo ""

  # Extract numeric values
  local mem_mibps mem_lat cpu_steal st_eps mt_eps aes_mibps net_mibps
  local rand_read_lat seq_read_mbps seq_write_mbps ioping_avg_us meta_ops_num
  local read_iops write_iops

  mem_mibps="$(_num_or_empty "$(echo "${_mem_transfer_speed}" | awk '{print $1}')")"
  mem_lat="$(_num_or_empty "${_mem_latency}")"
  cpu_steal="${_cpu_steal_mt}"
  st_eps="$(_num_or_empty "${_cpu_events_ST}")"
  mt_eps="$(_num_or_empty "${_cpu_events_MT_NPROC}")"
  aes_mibps="$(_num_or_empty "$(echo "${_aes_mibps}" | awk '{print $1}')")"
  net_mibps="$(_num_or_empty "$(echo "${_net_download}" | awk '{print $1}')")"

  rand_read_lat="$(_num_or_empty "$(echo "${_root_rand_lat_read}" | awk '{print $1}')")"
  seq_read_mbps="$(_num_or_empty "$(echo "${_root_seqread_bw_read}" | awk '{print $1}')")"
  seq_write_mbps="$(_num_or_empty "$(echo "${_root_seqwrite_bw_write}" | awk '{print $1}')")"
  meta_ops_num="$(_num_or_empty "$(echo "${_root_meta_ops}" | awk '{print $1}')")"
  read_iops="$(_num_or_empty "${_fio_rand_iops_read["/"]}")"
  write_iops="$(_num_or_empty "${_fio_rand_iops_write["/"]}")"

  # Extract ioping avg latency (format: "min/avg/max/mdev = 28.3 us / 126.5 us / ...")
  ioping_avg_us="$(echo "${_ioping_seek}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1)"

  # Calculate grades
  local mem_grade steal_grade cpu_grade disk_grade db_grade net_grade
  mem_grade="$(_boa_grade_mem_final "${mem_mibps:-0}" "${mem_lat}" "${_mem_bench_threads}")"
  steal_grade="$(_boa_grade_cpu_steal "${cpu_steal}")"
  cpu_grade="$(_boa_grade_cpu_speed "${st_eps}")"
  root_qd1_p99_r_num="$(_num_or_empty "$(echo "${_root_qd1_p99_read}" | awk "{print \$1}")")"
  root_qd1_p99_w_num="$(_num_or_empty "$(echo "${_root_qd1_p99_write}" | awk "{print \$1}")")"
  root_qd1_fsync_p99_w_num="$(_num_or_empty "$(echo "${_root_qd1_fsync_p99_write}" | awk "{print \$1}")")"
  disk_grade="$(_boa_grade_disk_final "${ioping_avg_us}" "${seq_read_mbps}" "${seq_write_mbps}" "${read_iops}" "${write_iops}" "${meta_ops_num}" "${root_qd1_p99_r_num}" "${root_qd1_p99_w_num}" "${root_qd1_fsync_p99_w_num}")"
  net_grade="$(_boa_grade_network "${net_mibps}")"

  # Database grade (optional; only if DB test ran)
  db_grade="unknown"
  if [ "${_db_test_status}" = "OK" ] || [ "${_db_test_status}" = "WARN" ]; then
    local _vcpus_num
    _vcpus_num="$(_num_or_empty "${_cpu_cores}")"
    [ -n "${_vcpus_num}" ] || _vcpus_num="1"
    db_grade="$(_boa_grade_db_oltp "${_db_rw_tps}" "${_db_rw_p95_ms}" "${_vcpus_num}" "${_db_ro_p95_ms}")"
  fi


  echo " ============================================================================="
  echo " == 1. MEMORY (Critical for APC/Valkey/OPcache + Nginx microcaching)        =="
  echo " ============================================================================="
  echo ""
  printf "   Bandwidth:  %-20s Grade: [%s]\n" "${_mem_transfer_speed}" "${mem_grade}"
  if [ -n "${_mem_latency}" ]; then
    printf "   Latency:    %-20s\n" "${_mem_latency} ${_mem_latency_unit}"
  else
    printf "   Latency:    %-20s\n" "N/A"
  fi
  if [ -n "${_mem_bench_size_mib:-}" ]; then
    echo "   Bench:      ${_mem_bench_size_mib} MiB per buffer x2 (~${_mem_bench_total_mib} MiB total), ${_mem_bench_threads} threads (median of ${_MEM_BENCH_REPEATS})"
    if [ -n "${_mem_bw_min}" ] && [ -n "${_mem_bw_max}" ]; then
      echo "   Variance:   ${_mem_bw_min}-${_mem_bw_max} MiB/s (bw), ${_mem_lat_min}-${_mem_lat_max} ns (lat)"
    fi
  fi
  echo ""

  if [ "${mem_grade}" = "low" ]; then
    if [ -n "${mem_lat}" ] && awk -v l="${mem_lat}" 'BEGIN{exit !(l>200)}' 2>/dev/null; then
      echo "   ⚠️  High/variable memory latency - may hurt cache-heavy BOA workloads (rerun to confirm)"
    else
      echo "   ⚠️  Low memory bandwidth - may limit BOA caching under heavy load"
    fi
  elif [ "${mem_grade}" = "average" ]; then
    if [ -n "${mem_lat}" ] && awk -v l="${mem_lat}" 'BEGIN{exit !(l>200)}' 2>/dev/null; then
      echo "   ☑️  Strong bandwidth but higher latency - likely host contention/NUMA; monitor under load"
    else
      echo "   ✅  Average memory performance for in-memory caching"
    fi
  elif [ "${mem_grade}" = "good" ]; then
    echo "   🌟  Good memory performance for in-memory caching"
  elif [ "${mem_grade}" = "excellent" ]; then
    echo "   🏆  Excellent memory performance for in-memory caching"
  elif [ "${mem_grade}" = "ultra" ]; then
    echo "   🚀  Ultra memory performance for in-memory caching"
  fi
  echo ""

  echo " ============================================================================="
  echo " == 2. CPU (Drupal/PHP runtime; watch steal on oversold nodes)              =="
  echo " ============================================================================="
  echo ""
  printf "   Single-thread:  %-15s events/sec  [%s] (most important)\n" "${_cpu_events_ST}" "${cpu_grade}"
  printf "   Multi-thread:   %-15s events/sec  (${_cpu_cores} vCPUs)\n" "${_cpu_events_MT_NPROC}"
  printf "   CPU Steal:      %-15s%%  [%s]\n" "${cpu_steal:-N/A}" "${steal_grade}"
  printf "   AES Throughput: %-15s (crypto/compression)\n" "${_aes_mibps}"
  echo ""

  if [ -n "${cpu_steal}" ] && [ "${cpu_steal}" != "N/A" ]; then
    if awk -v s="${cpu_steal}" 'BEGIN{exit !(s>=7)}' 2>/dev/null; then
      echo "   ❌ HIGH CPU steal - oversold host, NOT recommended for production"
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s>=3)}' 2>/dev/null; then
      echo "   ⚠️  Elevated CPU steal - will cause latency spikes under load"
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s<1)}' 2>/dev/null; then
      echo "   🏆  Excellent CPU steal - minimal noisy neighbor impact"
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s<3)}' 2>/dev/null; then
      echo "   ☑️  Minimal CPU steal - but may cause latency spikes under load"
    fi
  fi

  if [ "${cpu_grade}" = "poor" ]; then
    echo "   ❌ CPU performance too slow for BOA"
  elif [ "${cpu_grade}" = "acceptable" ]; then
    echo "   ☑️  Acceptable CPU performance but not optimal"
  elif [ "${cpu_grade}" = "average" ]; then
    echo "   ✅  Average CPU performance"
  elif [ "${cpu_grade}" = "good" ]; then
    echo "   🌟  Good CPU performance "
  elif [ "${cpu_grade}" = "excellent" ]; then
    echo "   🏆  Excellent CPU performance"
  elif [ "${cpu_grade}" = "ultra" ]; then
    echo "   🚀  Ultra CPU performance"
  fi
  echo ""

  # DISK (root is used for overall rating; other mounts are informational)
  _print_disk_compact_section "/" "Root partition / main filesystem"
  local _mp
  for _mp in "${_test_mounts[@]}"; do
    if [ "${_mp}" != "/" ]; then
      _print_disk_compact_section "${_mp}" "Mounted extra filesystem"
    fi
  done



  echo " ============================================================================="
  echo " == 4. DATABASE (Percona/MySQL OLTP proxy via sysbench)                     =="
  echo " ============================================================================="
  echo ""
  if [ "${_db_test_status}" = "OK" ] || [ "${_db_test_status}" = "WARN" ]; then
    printf "   Threads used:            %s
" "${_db_threads_used:-N/A}"
    printf "   Read-only (tps / p95):   %-10s / %s ms
" "${_db_ro_tps:-N/A}" "${_db_ro_p95_ms:-N/A}"
    printf "   Read-write (tps / p95):  %-10s / %s ms  [%s]
" "${_db_rw_tps:-N/A}" "${_db_rw_p95_ms:-N/A}" "${db_grade}"
    echo ""
    if [ "${db_grade}" = "poor" ]; then
      echo "   ❌ Slow DB OLTP - cache misses and admin tasks may feel sluggish"
    elif [ "${db_grade}" = "average" ]; then
      echo "   ✅ Average DB OLTP performance"
    elif [ "${db_grade}" = "good" ]; then
      echo "   🌟 Good DB OLTP performance"
    elif [ "${db_grade}" = "excellent" ]; then
      echo "   🏆 Excellent DB OLTP performance"
    elif [ "${db_grade}" = "ultra" ]; then
      echo "   🚀 Ultra DB OLTP performance"
    fi
    if [ "${_db_test_status}" = "WARN" ] && [ -n "${_db_test_reason}" ]; then
      echo "   ⚠️  Note: ${_db_test_reason}"
    fi
  else
    printf "   Status: %s
" "${_db_test_status}"
    if [ -n "${_db_test_reason}" ]; then
      printf "   Reason: %s
" "${_db_test_reason}"
    fi
  fi
  echo ""

  echo " ============================================================================="
  echo " == 5. NETWORK (Sanity check)                                               =="
  echo " ============================================================================="
  echo ""
  printf "   Public IPv4:        %s\n" "${_net_ipv4}"
  printf "   Download score:     %-15s [%s]\n" "${_net_download}" "${net_grade}"
  printf "   Score: avg of best 2/4 single-stream pulls (range ~10 MiB, timeout %ss)\n" "${_NET_TIMEOUT}"
  if [ "${#_net_dl_name[@]}" -gt 0 ]; then
    local _i
    _i=0
    while [ "${_i}" -lt "${#_net_dl_name[@]}" ]; do
      printf "     - %-10s %s\n" "${_net_dl_name[${_i}]}:" "${_net_dl_pretty[${_i}]}"
      _i=$((_i + 1))
    done
    [ -n "${_net_dl_top2}" ] && printf "   Top 2: %s\n" "${_net_dl_top2}"
  fi
  echo ""

  if [ "${net_grade}" = "poor" ]; then
    echo "   ⚠️  Slow network - may affect external API calls and package updates"
  elif [ "${net_grade}" = "average" ]; then
    echo "   ✅  Average network speed"
  elif [ "${net_grade}" = "good" ]; then
    echo "   🌟  Good network speed"
  elif [ "${net_grade}" = "excellent" ]; then
    echo "   🏆  Excellent network speed"
  elif [ "${net_grade}" = "ultra" ]; then
    echo "   🚀  Ultra network speed"
  fi
  echo ""

  echo " ============================================================================="
  echo " == BOA SUITABILITY SUMMARY                                                 =="
  echo " ============================================================================="

  local _issues=0
  local _warnings=0

  # Memory
  # Treat "low" as a critical issue only when bandwidth is genuinely weak.
  # Higher latency alone is a warning (VM contention/NUMA effects), not a hard fail.
  if [ "${mem_grade}" = "low" ]; then
    if [ -n "${mem_mibps}" ] && awk -v b="${mem_mibps}" 'BEGIN{exit !(b>=20000)}' 2>/dev/null; then
      echo "   ⚠️  Memory latency/variance looks high (bandwidth is strong) - monitor under load"
      _warnings=$((_warnings + 1))
    else
      echo "   ❌ Memory bandwidth too low for BOA"
      _issues=$((_issues + 1))
    fi
  elif [ "${mem_grade}" = "average" ]; then
    if [ -n "${mem_lat}" ] && awk -v l="${mem_lat}" 'BEGIN{exit !(l>200)}' 2>/dev/null; then
      echo "   ⚠️  Memory latency higher than expected - may reduce cache hit performance"
      _warnings=$((_warnings + 1))
    fi
  fi

  # CPU speed
  if [ "${cpu_grade}" = "poor" ]; then
    echo "   ❌ CPU performance too slow for BOA"
    _issues=$((_issues + 1))
  elif [ "${cpu_grade}" = "acceptable" ]; then
    echo "   ⚠️  CPU performance acceptable but not optimal"
    _warnings=$((_warnings + 1))
  fi

  # CPU steal
  if [ "${steal_grade}" = "bad" ]; then
    echo "   ❌ CPU steal critically high - oversold host, NOT recommended"
    _issues=$((_issues + 1))
  elif [ "${steal_grade}" = "warning" ]; then
    echo "   ⚠️  CPU steal elevated - may cause latency spikes"
    _warnings=$((_warnings + 1))
  fi

  # Disk
  if [ "${disk_grade}" = "bad" ]; then
    echo "   ❌ CRITICAL: Sequential write < 100 MB/s - disk is throttled or failing!"
    _warnings=$((_warnings + 1))
  elif [ "${disk_grade}" = "poor" ]; then
    echo "   ⚠️  Slow disk - may impact deployments"
    _warnings=$((_warnings + 1))
  fi


  # Database (optional)
  if [ "${_db_test_status}" = "OK" ] || [ "${_db_test_status}" = "WARN" ]; then
    if [ "${db_grade}" = "poor" ]; then
      echo "   ⚠️  DB OLTP is slow - cache misses and write-heavy workloads may suffer"
      _warnings=$((_warnings + 1))
    fi
  fi

  # Network
  if [ "${net_grade}" = "poor" ]; then
    echo "   ⚠️  Slow network - not suitable for high traffic sites"
    _warnings=$((_warnings + 1))
  fi

  # Summary
  if [ "${_issues}" -eq 0 ] && [ "${_warnings}" -eq 0 ]; then
    echo ""
    echo "   ✅  This host is well-suited for BOA deployment"
    echo "   ✅  All critical metrics meet recommended thresholds"
  elif [ "${_issues}" -eq 0 ]; then
    echo ""
    echo "   ⚠️  This host is acceptable for BOA (${_warnings} minor warning(s))"
    echo "      Should work fine for most BOA workloads"
  else
    echo ""
    echo "   ❌ This host has ${_issues} critical issue(s)"
    echo "      NOT recommended for production BOA deployment"
  fi

  echo ""
  echo " ============================================================================="
  echo ""
  echo "For detailed metrics, run: perftest --verbose"
  echo ""
}



# ----
# DB benchmark (sysbench OLTP, MySQL root)
# Runs only in --verbose mode by default.
# ----
_db_ro_tps=""
_db_ro_p95_ms=""
_db_rw_tps=""
_db_rw_p95_ms=""
_db_test_status="SKIPPED"
_db_test_reason=""

_read_mysql_root_pass() {
  if [ ! -e "/root/.my.pass.txt" ]; then
    echo ""
    return
  fi
  head -n 1 /root/.my.pass.txt 2>/dev/null | tr -d '
'
}

_guess_mysql_socket() {
  if [ -S "/var/run/mysqld/mysqld.sock" ]; then
    echo "/var/run/mysqld/mysqld.sock"
    return
  fi
  if [ -S "/run/mysqld/mysqld.sock" ]; then
    echo "/run/mysqld/mysqld.sock"
    return
  fi
  if [ -S "/var/lib/mysql/mysql.sock" ]; then
    echo "/var/lib/mysql/mysql.sock"
    return
  fi
  echo ""
}

_sysbench_lua() {
  # Args: file name (e.g. oltp_read_only.lua)
  if [ -f "/usr/share/sysbench/$1" ]; then
    echo "/usr/share/sysbench/$1"
    return
  fi
  # Older locations (rare)
  if [ -f "/usr/local/share/sysbench/$1" ]; then
    echo "/usr/local/share/sysbench/$1"
    return
  fi
  echo ""
}

_parse_sysbench_tps() {
  awk '/transactions:/ { for (i=1;i<=NF;i++) { if ($i=="per") { v=$(i-1); gsub(/[()]/,"",v); print v; exit } } }'
}

_parse_sysbench_p95() {
  awk '/95th percentile:/ { print $3; exit }'
}

_run_db_sysbench() {
  # Args: mode(ro|rw), dbname, threads, table_size, tables, time, repeats
  local mode="$1"
  local dbname="$2"
  local threads="$3"
  local table_size="$4"
  local tables="$5"
  local time_s="$6"
  local repeats="$7"

  [ -n "${repeats}" ] || repeats="1"

  local pass sock lua out tps p95
  local _tps_list=()
  local _p95_list=()

  pass="$(_read_mysql_root_pass)"
  [ -n "${pass}" ] || { printf '%s|%s\n' "" ""; return; }

  sock="$(_guess_mysql_socket)"

  if [ "${mode}" = "ro" ]; then
    lua="$(_sysbench_lua "oltp_read_only.lua")"
  else
    lua="$(_sysbench_lua "oltp_read_write.lua")"
  fi
  [ -n "${lua}" ] || { printf '%s|%s\n' "" ""; return; }

  local args=(
    "--db-driver=mysql"
    "--mysql-user=root"
    "--mysql-password=${pass}"
    "--mysql-db=${dbname}"
    "--tables=${tables}"
    "--table-size=${table_size}"
    "--threads=${threads}"
    "--time=${time_s}"
    "--report-interval=0"
  )

  if [ -n "${sock}" ]; then
    args+=("--mysql-socket=${sock}")
  else
    args+=("--mysql-host=127.0.0.1" "--mysql-port=3306")
  fi

  # Optional warmup (discarded)
  if [ -n "${_DB_SYSBENCH_WARMUP}" ] && [ "${_DB_SYSBENCH_WARMUP}" -gt 0 ]; then
    sysbench "${lua}" "${args[@]}" "--time=${_DB_SYSBENCH_WARMUP}" run >/dev/null 2>&1 || true
  fi

  local i
  i=1
  while [ "${i}" -le "${repeats}" ]; do
    out="$(sysbench "${lua}" "${args[@]}" run 2>/dev/null)"

    tps="$(printf '%s\n' "${out}" | _parse_sysbench_tps | head -n1)"
    p95="$(printf '%s\n' "${out}" | _parse_sysbench_p95 | head -n1)"

    if printf '%s' "${tps}" | grep -Eq '^[0-9]+(\.[0-9]+)?$'; then
      _tps_list+=("${tps}")
    fi
    if printf '%s' "${p95}" | grep -Eq '^[0-9]+(\.[0-9]+)?$'; then
      _p95_list+=("${p95}")
    fi

    i=$((i + 1))
  done

  # Median results
  local tps_med p95_med
  tps_med="$(_median_num "${_tps_list[@]}")"
  p95_med="$(_median_num "${_p95_list[@]}")"

  printf '%s|%s\n' "${tps_med}" "${p95_med}"
}

_db_benchmark_sysbench() {
  # Runs when enabled and MySQL root access is available.
  if [ "${_DBTEST_ENABLED}" != "YES" ]; then
    _db_test_status="SKIPPED"
    _db_test_reason="disabled"
    return
  fi
  if ! command -v sysbench >/dev/null 2>&1; then
    _db_test_status="SKIPPED"
    _db_test_reason="sysbench not installed"
    return
  fi
  if ! command -v mysql >/dev/null 2>&1; then
    _db_test_status="SKIPPED"
    _db_test_reason="mysql client not installed"
    return
  fi

  if ! _sysbench_has_mysql_driver; then
    _db_test_status="SKIPPED"
    _db_test_reason="sysbench built without mysql driver"
    return
  fi

  local pass
  pass="$(_read_mysql_root_pass)"
  if [ -z "${pass}" ]; then
    _db_test_status="SKIPPED"
    _db_test_reason="/root/.my.pass.txt missing/empty"
    return
  fi

  # Ensure mysqld responds
  local sock extra
  sock="$(_guess_mysql_socket)"
  extra=""
  if [ -n "${sock}" ]; then
    extra="--socket=${sock}"
  fi

  if ! mysql -uroot -p"${pass}" ${extra} -e 'SELECT 1' >/dev/null 2>&1; then
    _db_test_status="SKIPPED"
    _db_test_reason="cannot connect to MySQL as root"
    return
  fi

  echo "Running MySQL OLTP (sysbench: RO+RW, ${_DB_SYSBENCH_TIME_RO}s+${_DB_SYSBENCH_TIME_RW}s)..."

  # Threads = min(vCPU*2, cap)
  local threads
  threads=$(( $(nproc 2>/dev/null || echo 1) * 2 ))
  if [ "${threads}" -gt "${_DB_SYSBENCH_THREADS_MAX}" ]; then
    threads="${_DB_SYSBENCH_THREADS_MAX}"
  fi
  if [ "${threads}" -lt "${_DB_SYSBENCH_THREADS_MIN}" ]; then
    threads="${_DB_SYSBENCH_THREADS_MIN}"
  fi

  _db_threads_used="${threads}"

  local table_size tables time_ro time_rw
  tables="${_DB_SYSBENCH_TABLES}"
  time_ro="${_DB_SYSBENCH_TIME_RO}"
  time_rw="${_DB_SYSBENCH_TIME_RW}"
  if [ "${_DBTEST_HEAVY}" = "YES" ]; then
    table_size="${_DB_SYSBENCH_TABLE_SIZE_HEAVY}"
  else
    table_size="${_DB_SYSBENCH_TABLE_SIZE}"
  fi

  # Unique db name (<=64 chars)
  local dbname
  dbname="perftest_sb_${_hostname}_$$"
  dbname="$(printf '%s' "${dbname}" | tr -c 'A-Za-z0-9_' '_' | cut -c1-63)"

  # Create db
  if ! mysql -uroot -p"${pass}" ${extra} -e "CREATE DATABASE IF NOT EXISTS ${dbname}" >/dev/null 2>&1; then
    _db_test_status="SKIPPED"
    _db_test_reason="failed to create db"
    return
  fi

  # Prepare tables once (read-only/read-write share dataset)
  local lua_prepare
  lua_prepare="$(_sysbench_lua "oltp_read_write.lua")"
  if [ -z "${lua_prepare}" ]; then
    _db_test_status="SKIPPED"
    _db_test_reason="sysbench lua not found"
    return
  fi

  local sb_args=(
    "--db-driver=mysql"
    "--mysql-user=root"
    "--mysql-password=${pass}"
    "--mysql-db=${dbname}"
    "--tables=${tables}"
    "--table-size=${table_size}"
    "--threads=${threads}"
    "--report-interval=0"
  )
  if [ -n "${sock}" ]; then
    sb_args+=("--mysql-socket=${sock}")
  else
    sb_args+=("--mysql-host=127.0.0.1" "--mysql-port=3306")
  fi

  if ! sysbench "${lua_prepare}" "${sb_args[@]}" prepare >/dev/null 2>&1; then
    _db_test_status="SKIPPED"
    _db_test_reason="sysbench prepare failed"
    [ "${_DBTEST_KEEP_DB}" = "YES" ] && return
    mysql -uroot -p"${pass}" ${extra} -e "DROP DATABASE IF EXISTS ${dbname}" >/dev/null 2>&1 || true
    return
  fi

  # Run RO and RW, capture tps + p95 latency
  local ro rw
  ro="$(_run_db_sysbench ro "${dbname}" "${threads}" "${table_size}" "${tables}" "${time_ro}" "${_DB_SYSBENCH_REPEATS}")"
  rw="$(_run_db_sysbench rw "${dbname}" "${threads}" "${table_size}" "${tables}" "${time_rw}" "${_DB_SYSBENCH_REPEATS}")"

  _db_ro_tps="$(printf '%s' "${ro}" | cut -d'|' -f1)"
  _db_ro_p95_ms="$(printf '%s' "${ro}" | cut -d'|' -f2)"
  _db_rw_tps="$(printf '%s' "${rw}" | cut -d'|' -f1)"
  _db_rw_p95_ms="$(printf '%s' "${rw}" | cut -d'|' -f2)"

  if [ -n "${_db_ro_tps}" ] && [ -n "${_db_rw_tps}" ]; then
    _db_test_status="OK"
    _db_test_reason=""
  else
    _db_test_status="WARN"
    _db_test_reason="could not parse results"
  fi

  # Cleanup tables
  sysbench "${lua_prepare}" "${sb_args[@]}" cleanup >/dev/null 2>&1 || true

  if [ "${_DBTEST_KEEP_DB}" != "YES" ]; then
    mysql -uroot -p"${pass}" ${extra} -e "DROP DATABASE IF EXISTS ${dbname}" >/dev/null 2>&1 || true
  fi
}
