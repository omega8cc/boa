#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

# Tunables
_PHP_BENCH_ITERATIONS=50000 # per process
_PHP_BENCH_RUNS=5 # single-thread runs for median
_PHP_BENCH_CONCURRENCY_MAX=8 # cap on concurrent PHP workers
_SYSBENCH_CPU_TIME=30 # seconds
_SYSBENCH_MEM_TIME=30 # seconds
_FIO_RAND_RUNTIME=60 # seconds
_FIO_SEQ_RUNTIME=60 # seconds
_METADATA_FILE_COUNT=5000 # small-file ops per mount
_NET_TIMEOUT=10 # seconds for curl speedtest
_AES_TEST_MIB=500 # MiB encrypted for AES throughput test
_IOPING_SECONDS=5 # seconds for ioping checks

# Output mode
_VERBOSE=0   # default: full output
_COMPACT=1   # compact BOA-focused mode

# ----
# Usage
# ----
_usage() {
  cat <<'USAGE'
Usage: perftest [--compact|--quiet] [--verbose] [-h|--help]

  --compact, --quiet  Print BOA-focused compact summary only (default)
                      (prioritizes memory > CPU > disk > network)
  --verbose           Print full detailed output
  -h, --help          Show this help

BOA context: This script evaluates VM vendor/host quality for BOA stack
(Drupal + APC/Valkey/OPcache/Nginx microcaching). Compact mode highlights
the metrics that matter most for in-memory caching performance.
USAGE
}

# ----
# Helpers
# ----
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root"
    exit 1
  fi
}

_log() {
  [ "${_VERBOSE}" -eq 1 ] && echo "$@"
}

_find_fast_mirror_early() {
  _USE_MIR=
  _urlDld=
  _ffMirr=/opt/local/bin/ffmirror
  if [ -x "${_ffMirr}" ]; then
    _ffList="/var/backups/boa-mirrors-2025-01.txt"
    [ -d "/var/backups" ] || mkdir -p /var/backups
    if [ ! -e "${_ffList}" ]; then
      echo "eu.files.aegir.cc"  > ${_ffList}
      echo "us.files.aegir.cc" >> ${_ffList}
      echo "ao.files.aegir.cc" >> ${_ffList}
    fi
    if [ -e "${_ffList}" ]; then
      _BROKEN_FFMIRR_TEST=$(grep "stuff" ${_ffMirr} 2>&1)
      if [[ "${_BROKEN_FFMIRR_TEST}" =~ "stuff" ]]; then
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _USE_MIR="${_CHECK_MIRROR}"
        [[ "${_USE_MIR}" =~ "printf" ]] && _USE_MIR=
      fi
    fi
  fi
  if [ -n "${_USE_MIR}" ]; then
    _urlDld="http://${_USE_MIR}/dev/solr-4.2.1.tgz"
  fi
}

# Function to check if a package is installed
_check_and_install_package() {
  # $1 = package name
  if ! dpkg -s "$1" >/dev/null 2>&1; then
    echo "Installing package: $1"
    apt-get install -y "$1" >/dev/null 2>&1
  fi
}

# Prefer sysbench build-from-source without MySQL/MariaDB
_ensure_sysbench() {
  if command -v sysbench >/dev/null 2>&1; then
    return 0
  fi
  # Always compile sysbench from source without MySQL/MariaDB
  _log "Compiling sysbench from source..."
  _check_and_install_package "git"
  _check_and_install_package "make"
  _check_and_install_package "gcc"
  _check_and_install_package "automake"
  _check_and_install_package "libtool"
  _check_and_install_package "pkg-config"
  _check_and_install_package "libaio-dev"
  rm -rf /tmp/sysbench-build >/dev/null 2>&1
  mkdir -p /tmp/sysbench-build || exit 1
  cd /tmp/sysbench-build || exit 1
  git clone --depth 1 https://github.com/akopytov/sysbench.git >/dev/null 2>&1 || exit 1
  cd sysbench || exit 1
  ./autogen.sh >/dev/null 2>&1 || exit 1
  ./configure --without-mysql >/dev/null 2>&1 || exit 1
  make -j"$(nproc)" >/dev/null 2>&1 || exit 1
  make install >/dev/null 2>&1 || exit 1
  cd /root || exit 1
  rm -rf /tmp/sysbench-build >/dev/null 2>&1
}

# Convert bytes/sec to MiB/s (numeric only)
_bps_to_mibps_num() {
  awk '{ if (NR>0) printf "%.2f", $0 / 1024 / 1024 }'
}

# Convert bytes/sec to pretty "X.XX MiB/s"
_bps_to_mibps_pretty() {
  awk '{ if (NR>0) printf "%.2f MiB/s", $0 / 1024 / 1024; else printf "error" }'
}

_redact_ip() {
  case "$1" in
    *.*) printf '%s.xxxx' "$(printf '%s\n' "$1" | cut -d . -f 1-3)" ;;
    *:*) printf '%s:xxxx' "$(printf '%s\n' "$1" | cut -d : -f 1-3)" ;;
    *) printf '%s' "$1" ;;
  esac
}

_get_public_ipv4() {
  curl -4 -s --max-time 5 http://icanhazip.com/ 2>/dev/null | tr -d '\r\n'
}

_download_benchmark_v4() {
  # Downloads test file, validates size, returns bytes/sec (or empty on failure)
  # Args: $1 = URL, $2 = expected_min_bytes (optional, default 10MB)
  local url="$1"
  local min_bytes="${2:-10485760}"  # 10 MB default
  local tmpfile="/tmp/perftest_net_$$"
  local speed_bps=""
  local actual_size=0
  # Download with size tracking
  if curl -4 --max-time "${_NET_TIMEOUT}" -sL -o "$tmpfile" -w '%{speed_download}\n' "$url" 2>/dev/null > /tmp/perftest_speed_$$; then
    speed_bps=$(cat /tmp/perftest_speed_$$ 2>/dev/null)
    actual_size=$(stat -c%s "$tmpfile" 2>/dev/null || stat -f%z "$tmpfile" 2>/dev/null || echo 0)
    # Validate payload size
    if [ "$actual_size" -lt "$min_bytes" ]; then
      _log "Network test INVALID: got ${actual_size} bytes, expected >=${min_bytes} (CDN returned placeholder/truncated)"
      speed_bps=""
    fi
  fi
  # Cleanup
  rm -f "$tmpfile" /tmp/perftest_speed_$$
  echo "$speed_bps"
}

# Best-effort ioping setup (download static binary like nench if not installed)
_ensure_ioping() {
  if command -v ioping >/dev/null 2>&1; then
    _ioping_cmd="ioping"
    return 0
  fi
  local dst="/tmp/ioping.static"
  if curl -s --max-time 10 -o "${dst}" http://wget.racing/ioping.static 2>/dev/null; then
    chmod +x "${dst}" 2>/dev/null || true
    _ioping_cmd="${dst}"
    return 0
  fi
  _ioping_cmd=""
  return 1
}

_run_ioping_quick() {
  _ioping_seek="N/A"
  _ioping_seqread="N/A"
  _ensure_ioping || return 0
  [ -n "${_ioping_cmd}" ] || return 0
  # Keep it short; these lines match nench-style output snippets
  _ioping_seek="$("${_ioping_cmd}" -DR -w "${_IOPING_SECONDS}" . 2>/dev/null | tail -n 1)"
  _ioping_seqread="$("${_ioping_cmd}" -DRL -w "${_IOPING_SECONDS}" . 2>/dev/null | tail -n 2 | head -n 1)"
}

# AES throughput test (captures AES-NI issues better than sysbench cpu)
_run_aes_throughput_test() {
  _aes_mibps="N/A"
  _aes_seconds="N/A"
  if ! command -v openssl >/dev/null 2>&1; then
    return 0
  fi
  local start end elapsed
  start="$(date +%s.%N)"
  # Use fixed key/iv to avoid KDF overhead; measures raw AES speed better
  dd if=/dev/zero bs=1M count="${_AES_TEST_MIB}" 2>/dev/null \
    | openssl enc -aes-256-cbc \
      -K 0000 \
      -iv 0000 \
      -nosalt 2>/dev/null \
    > /dev/null
  end="$(date +%s.%N)"
  elapsed="$(echo "${end} - ${start}" | bc -l 2>/dev/null || echo 0)"
  if [ "${elapsed}" != "0" ]; then
    _aes_seconds="$(printf '%.3f' "${elapsed}")"
    _aes_mibps="$(echo "${_AES_TEST_MIB} / ${elapsed}" | bc -l 2>/dev/null | awk '{printf "%.2f MiB/s",$0}')"
  fi
}

_run_ipv4_net_check() {
  _net_ipv4="N/A"
  _net_download="N/A"
  local ip
  ip="$(_get_public_ipv4)"
  if [ -z "${ip}" ]; then
    return 0
  fi
  _net_ipv4="$(_redact_ip "${ip}")"
  local bps

  # BOA mirrors (100 MB, region-aware via custom speed test)
  _find_fast_mirror_early
  if [ -n "${_urlDld}" ]; then
    bps="$(_download_benchmark_v4 "${_urlDld}" 90000)"
  fi

  # Fallback to Cloudflare 50 MB, region-aware via anycast
  if [ -z "${bps}" ]; then
    _log "BOA mirror test failed, trying Cloudflare fallback..."
    bps="$(_download_benchmark_v4 "https://speed.cloudflare.com/__down?bytes=52428800" 50000)"
  fi

  # Fallback to GitHub 100 MB
  if [ -z "${bps}" ]; then
    _log "Cloudflare test failed, trying GitHub fallback..."
    bps="$(_download_benchmark_v4 "https://raw.githubusercontent.com/TestFileHub/FileHub/main/pdf/pdf100mb.pdf" 90000)"
  fi

  if printf '%s' "${bps}" | grep -Eq '^[0-9]+(\.[0-9]+)?$'; then
    _net_download="$(printf '%s\n' "${bps}" | _bps_to_mibps_pretty)"
  else
    _net_download="error"
  fi
}

# Return average %steal while running for N seconds (requires mpstat)
_measure_cpu_steal() {
  # $1 = seconds
  local _seconds="$1"
  if ! command -v mpstat >/dev/null 2>&1; then
    echo ""
    return 0
  fi
  # mpstat output: header + per-second lines; %steal column exists on Linux
  mpstat 1 "${_seconds}" 2>/dev/null \
    | awk '
      /^[0-9]/ { steal_sum += $(NF); steal_cnt++ }
      END {
        if (steal_cnt > 0) {
          printf "%.2f", steal_sum / steal_cnt
        }
      }'
}

# Decide which mounts to test:
# - include "/" always if it is a "real" filesystem type
# - include other mounted filesystems (separate partitions/volumes)
# - exclude /boot*, pseudo fs, and tiny mounts
_get_test_mounts() {
  df -P -T -B1 \
    | awk 'NR>1 {print $2 "|" $7 "|" $3}' \
    | while IFS="|" read -r _fstype _mount _size_bytes; do
      case "${_fstype}" in
        ext4|xfs|btrfs|zfs|f2fs) : ;;
        *) continue ;;
      esac
      case "${_mount}" in
        /boot|/boot/*|/boot/efi|/boot/efi/*) continue ;;
        /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*) continue ;;
        /snap|/snap/*) continue ;;
      esac
      if [ "${_size_bytes}" -lt $((2 * 1024 * 1024 * 1024)) ]; then
        continue
      fi
      case "${_mount}" in
        /*) echo "${_mount}" ;;
        *) : ;;
      esac
    done \
    | awk '!seen[$0]++ { print $0 }'
}

# Run fio random 4k randrw test in a mount and write JSON output to a file
_run_fio_rand_test() {
  # $1 = mountpoint
  # $2 = output_file
  local _mount_point="$1"
  local _output_file="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_fio_rand_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || return 1
  fio \
    --name=randreadwrite \
    --directory="${_test_dir}" \
    --ioengine=libaio \
    --iodepth=64 \
    --rw=randrw \
    --rwmixread=50 \
    --bs=4k \
    --direct=1 \
    --size=1G \
    --numjobs=4 \
    --runtime="${_FIO_RAND_RUNTIME}" \
    --time_based \
    --group_reporting \
    --output-format=json \
    > "${_output_file}" 2>/dev/null
  rm -rf "${_test_dir}" >/dev/null 2>&1
}

# Run fio sequential read test
_run_fio_seq_read_test() {
  # $1 = mountpoint
  # $2 = output_file
  local _mount_point="$1"
  local _output_file="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_fio_seqread_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || return 1
  fio \
    --name=seqread \
    --directory="${_test_dir}" \
    --ioengine=libaio \
    --iodepth=32 \
    --rw=read \
    --bs=128k \
    --direct=1 \
    --size=2G \
    --runtime="${_FIO_SEQ_RUNTIME}" \
    --time_based \
    --group_reporting \
    --output-format=json \
    > "${_output_file}" 2>/dev/null
  rm -rf "${_test_dir}" >/dev/null 2>&1
}

