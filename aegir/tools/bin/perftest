# Parse fio JSON and return values via stdout (key=value lines)
_parse_fio_json() {
  # $1 = json file
  local _json_file="$1"
  local _read_iops _write_iops _read_bw_kib _write_bw_kib
  _read_iops="$(jq -r '[.jobs[].read.iops] | add' "${_json_file}" 2>/dev/null)"
  _write_iops="$(jq -r '[.jobs[].write.iops] | add' "${_json_file}" 2>/dev/null)"
  _read_bw_kib="$(jq -r '[.jobs[].read.bw] | add' "${_json_file}" 2>/dev/null)" # KiB/s
  _write_bw_kib="$(jq -r '[.jobs[].write.bw] | add' "${_json_file}" 2>/dev/null)" # KiB/s

  local _read_clat_ns_mean _write_clat_ns_mean
  _read_clat_ns_mean="$(jq -r '([.jobs[].read.clat_ns.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
  _write_clat_ns_mean="$(jq -r '([.jobs[].write.clat_ns.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"

  local _read_lat_ms _write_lat_ms
  if [ -n "${_read_clat_ns_mean}" ] && [ -n "${_write_clat_ns_mean}" ]; then
    _read_lat_ms="$(awk -v ns="${_read_clat_ns_mean}" 'BEGIN{printf "%.2f", ns/10000.0}')"
    _write_lat_ms="$(awk -v ns="${_write_clat_ns_mean}" 'BEGIN{printf "%.2f", ns/10000.0}')"
  else
    local _read_clat_usec_mean _write_clat_usec_mean
    _read_clat_usec_mean="$(jq -r '([.jobs[].read.clat.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
    _write_clat_usec_mean="$(jq -r '([.jobs[].write.clat.mean?] | map(select(.!=null)) | (if length>0 then (add/length) else empty end))' "${_json_file}" 2>/dev/null)"
    _read_lat_ms="$(awk -v us="${_read_clat_usec_mean:-0}" 'BEGIN{printf "%.2f", us/1000.0}')"
    _write_lat_ms="$(awk -v us="${_write_clat_usec_mean:-0}" 'BEGIN{printf "%.2f", us/1000.0}')"
  fi

  local _read_bw_mb _write_bw_mb
  _read_bw_mb="$(awk -v kib="${_read_bw_kib:-0}" 'BEGIN{printf "%.2f", kib/1024.0}')"
  _write_bw_mb="$(awk -v kib="${_write_bw_kib:-0}" 'BEGIN{printf "%.2f", kib/1024.0}')"

  echo "READ_IOPS=${_read_iops}"
  echo "WRITE_IOPS=${_write_iops}"
  echo "READ_BW_MB=${_read_bw_mb}"
  echo "WRITE_BW_MB=${_write_bw_mb}"
  echo "READ_LAT_MS=${_read_lat_ms}"
  echo "WRITE_LAT_MS=${_write_lat_ms}"
}

# Simple metadata / small file operations test
_run_metadata_test() {
  # $1 = mountpoint
  # $2 = output var name (global)
  local _mount_point="$1"
  local _outvar="$2"
  local _safe_mount_point
  _safe_mount_point="$(echo "${_mount_point}" | sed 's#/#_#g')"
  local _test_dir="${_mount_point}/.perftest_meta_${_safe_mount_point}_$$"
  mkdir -p "${_test_dir}" || { eval "${_outvar}=\"ERROR\""; return; }

  local _count="${_METADATA_FILE_COUNT}"
  local _start _end _elapsed _ops _ops_per_sec

  _start="$(date +%s.%N)"
  local _i
  for _i in $(seq 1 "${_count}"); do
    echo "x" > "${_test_dir}/file_${_i}" || break
  done
  for _i in $(seq 1 "${_count}"); do
    cat "${_test_dir}/file_${_i}" >/dev/null 2>&1 || break
  done
  rm -f "${_test_dir}"/file_* >/dev/null 2>&1
  rmdir "${_test_dir}" >/dev/null 2>&1 || true
  _end="$(date +%s.%N)"

  _elapsed="$(echo "${_end} - ${_start}" | bc -l 2>/dev/null || echo 0)"
  _ops=$((_count * 2))
  if [ "${_elapsed}" != "0" ]; then
    _ops_per_sec="$(echo "${_ops} / ${_elapsed}" | bc -l 2>/dev/null || echo 0)"
    eval "${_outvar}=\"$(printf '%.2f' "${_ops_per_sec}") ops/s\""
  else
    eval "${_outvar}=\"ERROR\""
  fi
}

# Run sysbench CPU and extract events/sec and avg latency
_run_sysbench_cpu() {
  # $1 = threads
  # $2 = label (for variable names)
  local _threads="$1"
  local _label="$2"
  local _test
  _test="$(sysbench cpu --threads="${_threads}" --time="${_SYSBENCH_CPU_TIME}" run 2>/dev/null)"
  local _events _lat
  _events="$(echo "${_test}" | awk '/events per second:/ {print $4}')"
  _lat="$(echo "${_test}" | awk '/avg:/ {print $2}')"
  eval "_cpu_events_${_label}=\"${_events}\""
  eval "_cpu_latency_${_label}=\"${_lat}\""
}

# PHP micro-benchmark: multi-run median + concurrent throughput
_run_php_benchmarks() {
  if ! command -v php >/dev/null 2>&1; then
    _php_time_median="N/A (php not installed)"
    _php_time_runs=""
    _php_concurrency_wall="N/A"
    _php_concurrency_throughput="N/A"
    return
  fi

  local _script="/tmp/phpbench.php"
  cat << 'EOF' > "${_script}"
<?php
$iterations = getenv('PHP_BENCH_ITERATIONS') ? intval(getenv('PHP_BENCH_ITERATIONS')) : 50000;
$start = microtime(true);
$acc = 0;
for ($i = 0; $i < $iterations; $i++) {
  $s = "the quick brown fox jumps over the lazy dog " . $i;
  $h = hash('sha256', $s, false);
  $acc += ord($h[0]);
}
$elapsed = microtime(true) - $start;
printf("%.6f\n", $elapsed);
EOF

  local _runs="${_PHP_BENCH_RUNS}"
  local _times=()
  local _i
  echo "Running PHP single-thread benchmark (${_runs} runs, iterations=${_PHP_BENCH_ITERATIONS})..."
  for _i in $(seq 1 "${_runs}"); do
    local _t
    _t="$(PHP_BENCH_ITERATIONS="${_PHP_BENCH_ITERATIONS}" php "${_script}" 2>/dev/null || echo 0)"
    _log " Run ${_i}: ${_t} seconds"
    _times+=("${_t}")
  done

  # Median (PHP_BENCH_RUNS is 5, so 3rd value after sort)
  local _sorted
  _sorted=($(printf '%s\n' "${_times[@]}" | sort -n))
  _php_time_median="${_sorted[2]}"
  _php_time_runs="$(printf '%s ' "${_times[@]}")"

  # Concurrent benchmark
  local _conc
  local _nproc
  _nproc="$(nproc)"
  if [ "${_nproc}" -le 0 ]; then
    _nproc=1
  fi
  if [ "${_nproc}" -gt "${_PHP_BENCH_CONCURRENCY_MAX}" ]; then
    _conc="${_PHP_BENCH_CONCURRENCY_MAX}"
  else
    _conc="${_nproc}"
  fi

  echo "Running PHP concurrent benchmark (${_conc} processes, iterations=${_PHP_BENCH_ITERATIONS} each)..."
  local _start _end _elapsed
  _start="$(date +%s.%N)"
  for _i in $(seq 1 "${_conc}"); do
    PHP_BENCH_ITERATIONS="${_PHP_BENCH_ITERATIONS}" php "${_script}" >/dev/null 2>&1 &
  done
  wait
  _end="$(date +%s.%N)"
  _elapsed="$(echo "${_end} - ${_start}" | bc -l 2>/dev/null || echo 0)"
  _php_concurrency_wall="$(printf '%.6f' "${_elapsed}")"

  if [ "${_elapsed}" != "0" ]; then
    local _total_ops
    _total_ops="$(echo "${_conc} * ${_PHP_BENCH_ITERATIONS}" | bc -l 2>/dev/null || echo 0)"
    local _thr
    _thr="$(echo "${_total_ops} / ${_elapsed}" | bc -l 2>/dev/null || echo 0)"
    _php_concurrency_throughput="$(printf '%.2f ops/sec' "${_thr}")"
  else
    _php_concurrency_throughput="N/A"
  fi

  rm -f "${_script}" >/dev/null 2>&1
}

# ----
# BOA-specific grading helpers
# ----
_num_or_empty() {
  printf '%s' "$1" | grep -Eo '^[0-9]+(\.[0-9]+)?' || true
}

_boa_grade_mem_bw() {
  # input: numeric MiB/s
  # Only warn if truly low; NUMA/cgroup can limit single-thread sysbench
  awk -v v="$1" 'BEGIN{
    if (v>=6000) print "excellent";
    else if (v>=3000) print "good";
    else if (v>=2000) print "average";
    else print "low";
  }'
}

_boa_grade_cpu_steal() {
  # input: percent
  awk -v s="$1" 'BEGIN{
    if (s=="" || s=="N/A") print "unknown";
    else if (s<1) print "excellent";
    else if (s<3) print "good";
    else if (s<7) print "warning";
    else print "bad";
  }'
}

_boa_grade_cpu_speed() {
  # input: single-thread events/sec
  # Based on typical BOA workloads (Drupal PHP)
  awk -v eps="$1" 'BEGIN{
    if (eps=="" || eps=="N/A") print "unknown";
    else if (eps>=3500) print "excellent";
    else if (eps>=2500) print "good";
    else if (eps>=1500) print "average";
    else print "poor";
  }'
}

_boa_grade_disk_final() {
  # Inputs: $1=ioping_avg_us, $2=seq_read_mbps, $3=seq_write_mbps, $4=read_iops, $5=write_iops, $6=meta_ops
  # BOA-realistic: Sequential WRITE is critical (Drupal writes, cache, logs)
  # Priority: seq_write (blocker) > seq_read > IOPS > ioping > metadata
  local ioping_us="$1"
  local seq_read_mbps="$2"
  local seq_write_mbps="$3"
  local read_iops="$4"
  local write_iops="$5"
  local meta_ops="$6"

  # Extract numeric values
  ioping_us="$(_num_or_empty "${ioping_us}")"
  seq_read_mbps="$(_num_or_empty "${seq_read_mbps}")"
  seq_write_mbps="$(_num_or_empty "${seq_write_mbps}")"
  read_iops="$(_num_or_empty "${read_iops}")"
  write_iops="$(_num_or_empty "${write_iops}")"
  meta_ops="$(_num_or_empty "${meta_ops}")"

  # CRITICAL CHECK: Sequential write < 100 MB/s = BAD (throttled/failing disk)
  if [ -n "${seq_write_mbps}" ]; then
    if awk -v sw="${seq_write_mbps}" 'BEGIN{exit !(sw<100)}' 2>/dev/null; then
      echo "bad"
      return
    fi
  fi

  # Now grade based on combined metrics
  local grade="poor"

  # Check if we have both read and write
  if [ -n "${seq_read_mbps}" ] && [ -n "${seq_write_mbps}" ]; then
    # EXCELLENT: NVMe-class (write > 1000 AND read > 2000)
    if awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>1000 && sr>2000)}' 2>/dev/null; then
      grade="excellent"
    # GOOD: Healthy SSD (write > 500 AND read > 1000)
    elif awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>500 && sr>1000)}' 2>/dev/null; then
      grade="good"
    # OK: Moderate (write > 300 AND read > 500)
    elif awk -v sw="${seq_write_mbps}" -v sr="${seq_read_mbps}" 'BEGIN{exit !(sw>300 && sr>500)}' 2>/dev/null; then
      grade="average"
    # POOR: Below thresholds but not catastrophic
    else
      grade="poor"
    fi
  fi

  # Boost grade if IOPS are excellent (11k+ = NVMe-class)
  if [ -n "${read_iops}" ] && [ -n "${write_iops}" ]; then
    if awk -v ri="${read_iops}" -v wi="${write_iops}" 'BEGIN{exit !(ri>10000 && wi>10000)}' 2>/dev/null; then
      # Excellent IOPS - upgrade one level
      case "${grade}" in
        poor) grade="average" ;;
        average) grade="good" ;;
        good) grade="excellent" ;;
      esac
    fi
  fi

  # ioping reality check: if ioping shows bad latency, downgrade
  if [ -n "${ioping_us}" ]; then
    if awk -v i="${ioping_us}" 'BEGIN{exit !(i>2000)}' 2>/dev/null; then
      # Very bad real latency - downgrade one level
      case "${grade}" in
        excellent) grade="good" ;;
        good) grade="average" ;;
        average) grade="poor" ;;
      esac
    fi
  fi

  echo "${grade}"
}

_boa_grade_network() {
  # input: numeric MiB/s
  awk -v n="$1" 'BEGIN{
    if (n=="" || n=="N/A") print "unknown";
    else if (n>=200) print "excellent";
    else if (n>=100) print "good";
    else if (n>=50) print "average";
    else print "poor";
  }'
}

_print_compact_summary() {
  echo " ============================================================================="
  echo " ==                 BOA Performance Test - Compact Summary                  =="
  echo " ==      Priority: Memory > CPU > Disk > Network (for Drupal caching)       =="
  echo " ============================================================================="
  echo ""
  echo "System:"
  echo ""
  if [ -x "/opt/local/bin/screenfetch" ]; then
    bash /opt/local/bin/screenfetch -n
  else
    echo "Host:  ${_hostname}"
    echo "CPU:   ${_cpu_info}"
    echo "vCPUs: ${_cpu_cores}"
    local _total_ram_mb
    _total_ram_mb="$(free -m | awk '/^Mem:/ {print $2}')"
    echo "RAM:   ${_total_ram_mb} MB"
  fi
  echo ""

  # Extract numeric values
  local mem_mibps mem_lat cpu_steal st_eps mt_eps aes_mibps net_mibps
  local rand_read_lat seq_read_mbps seq_write_mbps ioping_avg_us meta_ops_num
  local read_iops write_iops

  mem_mibps="$(_num_or_empty "$(echo "${_mem_transfer_speed}" | awk '{print $1}')")"
  mem_lat="$(_num_or_empty "${_mem_latency}")"
  cpu_steal="${_cpu_steal_mt}"
  st_eps="$(_num_or_empty "${_cpu_events_ST}")"
  mt_eps="$(_num_or_empty "${_cpu_events_MT_NPROC}")"
  aes_mibps="$(_num_or_empty "$(echo "${_aes_mibps}" | awk '{print $1}')")"
  net_mibps="$(_num_or_empty "$(echo "${_net_download}" | awk '{print $1}')")"

  rand_read_lat="$(_num_or_empty "$(echo "${_root_rand_lat_read}" | awk '{print $1}')")"
  seq_read_mbps="$(_num_or_empty "$(echo "${_root_seqread_bw_read}" | awk '{print $1}')")"
  seq_write_mbps="$(_num_or_empty "$(echo "${_root_seqwrite_bw_write}" | awk '{print $1}')")"
  meta_ops_num="$(_num_or_empty "$(echo "${_root_meta_ops}" | awk '{print $1}')")"
  read_iops="$(_num_or_empty "${_fio_rand_iops_read["/"]}")"
  write_iops="$(_num_or_empty "${_fio_rand_iops_write["/"]}")"

  # Extract ioping avg latency (format: "min/avg/max/mdev = 28.3 us / 126.5 us / ...")
  ioping_avg_us="$(echo "${_ioping_seek}" | grep -oP '\d+\.\d+(?= us)' | head -2 | tail -1)"

  # Calculate grades
  local mem_grade steal_grade cpu_grade disk_grade net_grade
  mem_grade="$(_boa_grade_mem_bw "${mem_mibps:-0}")"
  steal_grade="$(_boa_grade_cpu_steal "${cpu_steal}")"
  cpu_grade="$(_boa_grade_cpu_speed "${st_eps}")"
  disk_grade="$(_boa_grade_disk_final "${ioping_avg_us}" "${seq_read_mbps}" "${seq_write_mbps}" "${read_iops}" "${write_iops}" "${meta_ops_num}")"
  net_grade="$(_boa_grade_network "${net_mibps}")"

  echo " ============================================================================="
  echo " == 1. MEMORY (Critical for APC/Valkey/OPcache + Nginx microcaching)        =="
  echo " ============================================================================="
  echo ""
  printf "   Bandwidth:  %-20s Grade: [%s]\n" "${_mem_transfer_speed}" "${mem_grade}"
  printf "   Latency:    %-20s\n" "${_mem_latency} ms"
  echo ""

  if [ "${mem_grade}" = "low" ]; then
    echo "   ⚠️  Low memory bandwidth - may limit BOA caching under heavy load."
  elif [ "${mem_grade}" = "average" ]; then
    echo "   ✓  Average memory bandwidth for in-memory caching."
  elif [ "${mem_grade}" = "good" ]; then
    echo "   🌟  Good memory bandwidth for in-memory caching."
  elif [ "${mem_grade}" = "excellent" ]; then
    echo "   🏆  Excellent memory bandwidth for in-memory caching."
  fi
  echo ""

  echo " ============================================================================="
  echo " == 2. CPU (Drupal/PHP runtime; watch steal on oversold nodes)              =="
  echo " ============================================================================="
  echo ""
  printf "   Single-thread:  %-15s events/sec  [%s] (most important)\n" "${_cpu_events_ST}" "${cpu_grade}"
  printf "   Multi-thread:   %-15s events/sec  (${_cpu_cores} vCPUs)\n" "${_cpu_events_MT_NPROC}"
  printf "   CPU Steal:      %-15s%%  [%s]\n" "${cpu_steal:-N/A}" "${steal_grade}"
  printf "   AES Throughput: %-15s (crypto/compression)\n" "${_aes_mibps}"
  echo ""

  if [ -n "${cpu_steal}" ] && [ "${cpu_steal}" != "N/A" ]; then
    if awk -v s="${cpu_steal}" 'BEGIN{exit !(s>=7)}' 2>/dev/null; then
      echo "   ❌ HIGH CPU steal - oversold host, NOT recommended for production."
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s>=3)}' 2>/dev/null; then
      echo "   ⚠️  Elevated CPU steal - will cause latency spikes under load."
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s<1)}' 2>/dev/null; then
      echo "   🏆  Excellent CPU steal - minimal noisy neighbor impact."
    elif awk -v s="${cpu_steal}" 'BEGIN{exit !(s<3)}' 2>/dev/null; then
      echo "   ✓  Minimal CPU steal - but may cause latency spikes under load."
    fi
  fi

  if [ "${cpu_grade}" = "poor" ]; then
    echo "   ❌ CPU performance too slow for BOA"
  elif [ "${cpu_grade}" = "average" ]; then
    echo "   ✓  Average CPU performance but not optimal"
  elif [ "${cpu_grade}" = "good" ]; then
    echo "   🌟  Good CPU performance "
  elif [ "${cpu_grade}" = "excellent" ]; then
    echo "   🏆  Excellent CPU performance"

  fi
  echo ""

  echo " ============================================================================="
  echo " == 3. DISK (Root dominates; attached storage influences vendor grading)    =="
  echo " ============================================================================="
  echo ""
  printf "   Sequential write (CRITICAL): %s\n" "${_root_seqwrite_bw_write}"
  printf "   Sequential read:             %s\n" "${_root_seqread_bw_read}"
  printf "   Random 4K IOPS:              %s read / %s write\n" "${_fio_rand_iops_read["/"]}" "${_fio_rand_iops_write["/"]}"
  printf "   Real latency (ioping avg):   %s\n" "$(echo "${_ioping_seek}" | grep -oP '\d+\.\d+ us' | head -2 | tail -1 || echo "N/A")"
  printf "   Metadata ops:                %s\n" "${_root_meta_ops}"
  echo ""
  printf "   Details (fio synthetic latency):\n"
  printf "     Random 4K read:   %s @ %s\n" "${_root_rand_bw_read}" "${_root_rand_lat_read}"
  printf "     Random 4K write:  %s @ %s\n" "${_root_rand_bw_write}" "${_root_rand_lat_write}"
  echo ""

  if [ "${disk_grade}" = "bad" ]; then
    echo "   ❌ CRITICAL: Sequential write < 100 MB/s - disk is throttled or failing!"
    echo "      This will severely impact BOA performance (cache writes, logs, DB)."
  elif [ "${disk_grade}" = "poor" ]; then
    echo "   ⚠️  Disk profile looks weak (slow SSD/attached). May impact deploys/logs/DB."
  elif [ "${disk_grade}" = "average" ]; then
    echo "   ✓  Average disk performance for BOA workloads."
  elif [ "${disk_grade}" = "good" ]; then
    echo "   🌟  Good disk performance for BOA workloads."
  elif [ "${disk_grade}" = "excellent" ]; then
    echo "   🏆  Excellent disk performance (NVMe-class)."
  fi
  echo ""

  echo " ============================================================================="
  echo " == 4. NETWORK (Sanity check)                                               =="
  echo " ============================================================================="
  echo ""
  printf "   Public IPv4:        %s\n" "${_net_ipv4}"
  printf "   Download speed:     %-15s [%s]\n" "${_net_download}" "${net_grade}"
  printf "   Test: Single-stream CDN pull (100MB)\n"
  echo ""

  if [ "${net_grade}" = "poor" ]; then
    echo "   ⚠️  Slow network - may affect external API calls and package updates."
  elif [ "${net_grade}" = "average" ]; then
    echo "   ✓  Average network speed."
  elif [ "${net_grade}" = "good" ]; then
    echo "   🌟  Good network speed."
  elif [ "${net_grade}" = "excellent" ]; then
    echo "   🏆  Excellent network speed."
  fi
  echo ""

  echo " ============================================================================="
  echo " == BOA SUITABILITY SUMMARY                                                 =="
  echo " ============================================================================="

  local _issues=0
  local _warnings=0

  # Memory
  if [ "${mem_grade}" = "low" ]; then
    echo "   ❌ Memory bandwidth too low for BOA"
    _issues=$((_issues + 1))
  fi

  # CPU speed
  if [ "${cpu_grade}" = "poor" ]; then
    echo "   ❌ CPU performance too slow for BOA"
    _issues=$((_issues + 1))
  elif [ "${cpu_grade}" = "average" ]; then
    echo "   ⚠️  CPU performance average but not optimal"
    _warnings=$((_warnings + 1))
  fi

  # CPU steal
  if [ "${steal_grade}" = "bad" ]; then
    echo "   ❌ CPU steal critically high - oversold host, NOT recommended"
    _issues=$((_issues + 1))
  elif [ "${steal_grade}" = "warning" ]; then
    echo "   ⚠️  CPU steal elevated - may cause latency spikes"
    _warnings=$((_warnings + 1))
  fi

  # Disk
  if [ "${disk_grade}" = "poor" ]; then
    echo "   ⚠️  Slow disk - may impact deployments"
    _warnings=$((_warnings + 1))
  fi

  # Summary
  if [ "${_issues}" -eq 0 ] && [ "${_warnings}" -eq 0 ]; then
    echo ""
    echo "   ✓  This host is well-suited for BOA deployment"
    echo "   ✓  All critical metrics meet recommended thresholds"
  elif [ "${_issues}" -eq 0 ]; then
    echo ""
    echo "   ⚠️  This host is acceptable for BOA (${_warnings} minor warning(s))"
    echo "      Should work fine for most BOA workloads"
  else
    echo ""
    echo "   ❌ This host has ${_issues} critical issue(s)"
    echo "      NOT recommended for production BOA deployment"
  fi

  echo ""
  echo " ============================================================================="
  echo ""
  echo "For detailed metrics, run: perftest --verbose"
  echo ""
}

