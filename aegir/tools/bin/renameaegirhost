#!/bin/bash

###
### renameaegirhost — in-place rename of the Aegir hostname on BOA
###
### Usage: renameaegirhost --aegir-root PATH [--dry-run] [--force-old OLDFQDN]
###                        [--old-account SRCOCT --new-account DSTOCT]
###
###   --aegir-root PATH  Aegir home directory (required); validated as a real
###                      Aegir root before any changes are made.
###      Examples:
###      --aegir-root /var/aegir    (BOA master)
###      --aegir-root /data/disk/o1 (BOA octopus account)
###   --dry-run    Print what would be changed; make no modifications
###   --force-old FQDN   Override auto-detected old hostname with FQDN
###   --old-account/--new-account   Also rename the OCTOPUS ACCOUNT axis
###      (rename-mode migrations, e.g. xoct import o1 -> o2): the panel
###      identity (site dir, node title, panel vhost, hostmaster aliases)
###      moves from <old>.<NEWFQDN> to <new>.<NEWFQDN>, and /data/disk/<old>
###      paths inside the Aegir DB and on-disk configs become
###      /data/disk/<new>. Customer-site URIs are NEVER touched — a site on
###      the account subdomain keeps its name. Both flags or neither;
###      --aegir-root must be /data/disk/<new-account>.
###
### What it does:
###   §1  Detect old hostname from <aegir-root>/.drush/server_master.alias.drushrc.php
###   §2  Detect new hostname from system FQDN (hostname -f)
###   §2c Move host-derived tenant site dirs onto the new hostname, together
###       with every surface keyed by site URI: per-site Drush alias file,
###       static files store, the site's files/private symlinks into that
###       store, the client symlink, and the URI-derived values inside
###       settings.php (file paths, trusted_host_patterns, local.settings
###       include — never the database name). Grav and Textpattern sites
###       carry no settings.php at all, so they are recognised by the markers
###       provision's own site finders glob for (sites/<uri>/system/defines.php,
###       sites/<uri>/private/config.php) and moved the same way, with the
###       surfaces their class keys on the URI re-pointed too: the Grav .env
###       and per-host environment overlay, the Textpattern private/config.php,
###       its six uri-bound txp_prefs rows and the session/nonce invalidation
###       a name change requires. A capsule an earlier release parked under
###       backups/rename-hostname/stray-sites/ is reinstated before the move
###       runs, since no later pass can see it there. A tenant whose URI
###       embeds the box hostname follows the box; leaving its dir behind
###       strands it under a name §7 would import as a second, duplicate site
###       node, and leaving the rest behind leaves it not serving
###   §2d Rewrite the per-site PHP pins in static/control/multi-fpm.info,
###       whose rows key on the site URI: left stale, every host-derived
###       site's pin goes inert and the site silently falls back to the
###       account default PHP version
###   §3  Rewrite all Drush alias files in <aegir-root>/.drush/, and the yml
###       copies Drush 9+ reads (<aegir-root>/.drush/sites, and for an
###       Octopus account /home/<acct>.ftp/.drush/sites), keeping the checksum
###       of a copy Drush still manages in step with its new bytes
###   §4  Rename + rewrite vhost files in <aegir-root>/config/server_master/nginx/vhost.d/,
###       then rewrite the platform sites/sites.php alias maps (the queued
###       verifies only ever ADD new-hostname records there; stale
###       old-hostname records would otherwise survive the rename
###       indefinitely)
###   §5  Rename the hostname inside the Aegir DB with serialize-safe, targeted
###       statements: identity rows keyed by hosting_context nid, REPLACE()
###       sweeps over plain-varchar columns, and an unserialize/replace/
###       re-serialize pass over the variable table. Never a blanket dump+sed:
###       that corrupts PHP-serialized byte lengths when the FQDN length
###       changes, and (with --hex-blob) never reached blob values anyway.
###       A plain dump is still taken first, as a backup only.
###   §5b /var/aegir only: rename the host-level names written at install --
###       postfix myhostname and a mydestination entry, /etc/mailname, and
###       BOA's self-signed fallback certificate (re-issued on its own key) --
###       when they carry one of the box's former names: the old hostname, or
###       the name that certificate was issued for. Anything else is left
###       alone.
###   §6  Reload nginx
###   §9  Confirm every site carrying the new hostname actually serves
###       before reporting success -- the dirs this run moved AND the ones
###       an earlier or parked run had already moved -- waiting out PHP's
###       per-worker realpath cache instead of leaving that judgement to an
###       operator with curl
###   §7  Flush Drush cache and run Aegir task queue (5 passes) to regenerate
###       all aliases, vhosts, and db-host entries from the updated database,
###       plus one queued verify per Drupal/Backdrop site §2c renamed
###       (server verifies regenerate nothing per-site). The Grav and
###       Textpattern capsules are not queued: §2c re-points their surfaces
###       itself, and their verify is provision's own class-specific task.
###       Assumes BOA cron is not running (caller must ensure this).
###

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

###-------------DEFAULTS------------------###

_AEGIR_ROOT=""
_DRY_RUN=NO
_FORCE_OLD=""
_OLD_ACCT=""
_NEW_ACCT=""
_SITESPHP_N=0
_TENANT_DIRS_N=0
_CAPSULE_DIRS_N=0
_CAPSULE_DONE_URIS=""
_UNPARKED_N=0
_STRAY_LEFT_N=0
_SETTINGS_SKIPPED_N=0
_RENAMED_SITE_URIS=()
_SERVE_CHECK_URIS=()
_SERVE_N=0
_SERVE_SKIPPED_N=0
_URI_SURFACES_CHANGED=NO
_HOST_NAMES_DONE=""
_SERVE_FAILED=""
_SERVE_WAIT="${_RENAME_SERVE_WAIT:-180}"

###-------------ARGUMENT PARSING----------###

while [ $# -gt 0 ]; do
  case "$1" in
    --aegir-root)
      _AEGIR_ROOT="$2"
      shift 2
      ;;
    --dry-run)
      _DRY_RUN=YES
      shift
      ;;
    --force-old)
      _FORCE_OLD="$2"
      shift 2
      ;;
    --old-account)
      _OLD_ACCT="$2"
      shift 2
      ;;
    --new-account)
      _NEW_ACCT="$2"
      shift 2
      ;;
    -h|--help)
      sed -n '/^###/{ s/^### \?//; p }' "$0"
      exit 0
      ;;
    *)
      echo "ERROR: Unknown argument: $1"
      echo "Usage: $0 --aegir-root PATH [--dry-run] [--force-old OLDFQDN] [--old-account SRCOCT --new-account DSTOCT]"
      exit 1
      ;;
  esac
done

if [ -z "${_AEGIR_ROOT}" ]; then
  echo "ERROR: --aegir-root PATH is required"
  echo "Usage: $0 --aegir-root PATH [--dry-run] [--force-old OLDFQDN] [--old-account SRCOCT --new-account DSTOCT]"
  exit 1
fi

# Derive all paths and username from _AEGIR_ROOT now that args are fully parsed
_DRUSH_DIR=${_AEGIR_ROOT}/.drush
_VHOSTD=${_AEGIR_ROOT}/config/server_master/nginx/vhost.d
_BACKUP_DIR=${_AEGIR_ROOT}/backups/rename-hostname
_AEGIR_USER=$(basename "${_AEGIR_ROOT}")

# Account axis: both flags or neither; the tool runs on the already-landed
# DESTINATION tree, so the root must be the new account's.
_ACCT_AXIS=NO
if [ -n "${_OLD_ACCT}" ] || [ -n "${_NEW_ACCT}" ]; then
  if [ -z "${_OLD_ACCT}" ] || [ -z "${_NEW_ACCT}" ]; then
    echo "ERROR: --old-account and --new-account must be given together"
    exit 1
  fi
  case "${_OLD_ACCT}" in *[!a-z0-9]*|[!a-z]*) echo "ERROR: bad --old-account '${_OLD_ACCT}'"; exit 1 ;; esac
  case "${_NEW_ACCT}" in *[!a-z0-9]*|[!a-z]*) echo "ERROR: bad --new-account '${_NEW_ACCT}'"; exit 1 ;; esac
  if [ "${_OLD_ACCT}" = "${_NEW_ACCT}" ]; then
    echo "ERROR: --old-account equals --new-account (${_OLD_ACCT}) — nothing to do"
    exit 1
  fi
  if [ "${_AEGIR_ROOT}" != "/data/disk/${_NEW_ACCT}" ]; then
    echo "ERROR: with --new-account ${_NEW_ACCT} the --aegir-root must be /data/disk/${_NEW_ACCT} (got ${_AEGIR_ROOT})"
    exit 1
  fi
  _ACCT_AXIS=YES
fi

###-------------HELPERS-------------------###

_info() {
  echo "INFO: $*"
}

_alrt() {
  echo "ALRT: $*"
}

_die() {
  echo "ERROR: $*"
  exit 1
}

_maybe_run() {
  # Execute command unless --dry-run; always echo it
  if [ "${_DRY_RUN}" = "YES" ]; then
    echo "DRY:  $*"
  else
    eval "$@"
  fi
}

_safe_name() {
  # Tenant-derived values (site dir basenames, symlink targets under the
  # tenant's own tree) travel through _maybe_run's eval inside literal single
  # quotes and into su -c strings; one quote in such a value would close the
  # quoting and run the remainder as root. Refuse anything outside the
  # hostname/path charset. $1 = value, $2 = label for the alert.
  if [[ ! "$1" =~ ^[A-Za-z0-9._/-]+$ ]]; then
    _alrt "  ${2:-name} '$1' carries characters outside [A-Za-z0-9._/-] -- skipped"
    return 1
  fi
  return 0
}

_renamed_already() {
  # NEW-contains-OLD guard, path/name flavor: in that regime any value that
  # already carries NEW would double on a second forward substitution
  # (master.xy.example.com -> master.xy.xy.example.com on a re-run). Same
  # semantics as the §5 sweeps' AND-NOT-LIKE guard. Returns 0 when the
  # argument must be left alone.
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*)
      case "$1" in
        *"${_NEW_HOST}"*) return 0 ;;
      esac
    ;;
  esac
  return 1
}

_file_needs_rename() {
  # Eligible = the file has a line carrying OLD that is not already
  # NEW-carrying (line-level twin of _renamed_already; whole file counts
  # when no guard regime is active).
  grep -q "${_OLD_HOST}" "$1" 2>/dev/null || return 1
  [ -z "${_SED_RENAME_GUARD}" ] && return 0
  grep -v "${_NEW_HOST}" "$1" 2>/dev/null | grep -q "${_OLD_HOST}"
}

###-------------CHECKS--------------------###

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    _die "This script must be run as root"
  fi

  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ -n "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    _die "Disk usage is at ${_DF_TEST}% — aborting (must be below 90%)"
  fi

  if [ ! -d "${_AEGIR_ROOT}" ]; then
    _die "Aegir root not found: ${_AEGIR_ROOT}"
  fi

  # Validate the directory actually looks like an Aegir root before touching anything
  _aegir_root_ok=YES
  for _required_subdir in \
    .drush \
    config/server_master \
    backups \
  ; do
    if [ ! -d "${_AEGIR_ROOT}/${_required_subdir}" ]; then
      _alrt "Expected Aegir subdir missing: ${_AEGIR_ROOT}/${_required_subdir}"
      _aegir_root_ok=NO
    fi
  done
  if [ "${_aegir_root_ok}" = "NO" ]; then
    _die "'${_AEGIR_ROOT}' does not look like a valid Aegir root (missing subdirs above)"
  fi

  if [ ! -f "${_DRUSH_DIR}/server_master.alias.drushrc.php" ]; then
    _die "server_master.alias.drushrc.php not found in ${_DRUSH_DIR}"
  fi

  _info "Aegir root : ${_AEGIR_ROOT}"
  _info "Aegir user : ${_AEGIR_USER}"
}

###-------------§1 DETECT OLD HOSTNAME---###

_detect_old_hostname() {
  if [ -n "${_FORCE_OLD}" ]; then
    # Same charset guard as auto-detection — the value feeds sed and SQL
    _OLD_HOST="${_FORCE_OLD//[^a-zA-Z0-9.\-]/}"
    if [ -z "${_OLD_HOST}" ]; then
      _die "--force-old value '${_FORCE_OLD}' is not a usable hostname"
    fi
    _info "Old hostname forced via --force-old: ${_OLD_HOST}"
    return
  fi

  # Extract remote_host from server_master alias — this is the authoritative
  # hostname stored in the Aegir drush config
  _OLD_HOST=$(grep "remote_host" \
    "${_DRUSH_DIR}/server_master.alias.drushrc.php" \
    | head -1 \
    | sed "s/.*remote_host.*=>//; s/[' ,;]//g")

  _OLD_HOST=${_OLD_HOST//[^a-zA-Z0-9.\-]/}

  if [ -z "${_OLD_HOST}" ]; then
    _die "Could not detect old hostname from server_master.alias.drushrc.php"
  fi

  _info "Detected old hostname: ${_OLD_HOST}"
}

###-------------§2 DETECT NEW HOSTNAME---###

_detect_new_hostname() {
  _NEW_HOST=$(hostname -f 2>/dev/null | tr -d '\n')
  # Same charset guard as §1 — the value feeds sed and SQL
  _NEW_HOST=${_NEW_HOST//[^a-zA-Z0-9.\-]/}

  if [ -z "${_NEW_HOST}" ]; then
    _die "Could not determine system FQDN via hostname -f"
  fi

  # Sanity: must contain at least one dot (real FQDN)
  if [[ "${_NEW_HOST}" != *.* ]]; then
    _die "System hostname '${_NEW_HOST}' does not look like a FQDN (no dot). " \
       "Set it correctly in /etc/hostname and /etc/hosts first."
  fi

  _info "New hostname (system FQDN): ${_NEW_HOST}"

  if [ "${_OLD_HOST}" = "${_NEW_HOST}" ]; then
    _info "Old and new hostname are identical — nothing to do."
    exit 0
  fi

  # Line-level sed guard for the NEW-contains-OLD regime: never touch lines
  # already carrying NEW (a second s/OLD/NEW/ pass would double the prefix).
  _SED_RENAME_GUARD=""
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _SED_RENAME_GUARD="/${_NEW_HOST}/!" ;;
  esac

  # The box identity on a BOA host is cnf-driven: barracuda re-asserts
  # _MY_HOSTN into /etc/hostname on its next run (install final phase,
  # up-*), which mid-queue flips provision back to remote-host mode against
  # the OLD identity (failed self-rsync, legacy nginx conf fallback). Warn
  # until the operator updates the cnf. In-place renames only; migration
  # targets get a correct cnf from their fresh install.
  if [ -e "/root/.barracuda.cnf" ]; then
    _CNF_HOSTN=$(grep "^_MY_HOSTN=" /root/.barracuda.cnf 2>/dev/null \
      | head -1 | cut -d'"' -f2)
    if [ -n "${_CNF_HOSTN}" ] && [ "${_CNF_HOSTN}" != "${_NEW_HOST}" ]; then
      _alrt "/root/.barracuda.cnf records _MY_HOSTN=${_CNF_HOSTN} — the next barracuda run will revert /etc/hostname to it"
      _alrt "Update _MY_HOSTN (and _MY_FRONT) in /root/.barracuda.cnf to match ${_NEW_HOST} before any barracuda run"
    fi
  fi
}

###-------------BACKUP--------------------###

_backup_files() {
  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would create backup in ${_BACKUP_DIR}"
    return
  fi

  mkdir -p "${_BACKUP_DIR}"
  _TS=$(date +%Y%m%d_%H%M%S)

  cp -a "${_DRUSH_DIR}" "${_BACKUP_DIR}/drush_${_TS}"
  _info "Drush dir backed up to ${_BACKUP_DIR}/drush_${_TS}"

  if [ -d "${_VHOSTD}" ]; then
    cp -a "${_VHOSTD}" "${_BACKUP_DIR}/vhost.d_${_TS}"
    _info "vhost.d backed up to ${_BACKUP_DIR}/vhost.d_${_TS}"
  fi

  _info "Backup timestamp: ${_TS}"
}

###-------------§2b HOSTMASTER SITE DIR--###

_rename_hostmaster_site_dir() {
  # The hostmaster frontend site dir is host-derived (sites/<user>.FQDN) and
  # must follow the rename BEFORE §3 rewrites the aliases: §5 re-derives the
  # drushrc path from the (by then rewritten) alias and would die against an
  # OLD-named dir. GUARD (load-bearing for xoct/xmass): when a NEW-named dir
  # already exists (fresh-install migration targets), skip -- renaming the
  # source's OLD-named dir over it would clobber the target's correct
  # settings.php.
  local _HM_RAW
  _HM_RAW=$(grep "site_path'" \
    "${_DRUSH_DIR}/hostmaster.alias.drushrc.php" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g" \
    | tr -d ' ')
  if [ -z "${_HM_RAW}" ]; then
    _alrt "Could not extract site_path for the site-dir rename; leaving to §5"
    return 0
  fi
  if _renamed_already "${_HM_RAW}"; then
    # Re-run over a renamed root in the NEW-contains-OLD regime: the forward
    # substitution below would walk the name forward again
    # (master.xy.example.com -> master.xy.xy.example.com) and §7 would then
    # import the doubled dir as a brand-new site.
    _info "Hostmaster site dir already carries ${_NEW_HOST} — not renaming"
    return 0
  fi
  local _HM_DIR_NEW="${_HM_RAW//${_OLD_HOST}/${_NEW_HOST}}"
  local _HM_DIR_OLD="${_HM_DIR_NEW//${_NEW_HOST}/${_OLD_HOST}}"
  if [ "${_HM_DIR_OLD}" = "${_HM_DIR_NEW}" ]; then
    return 0
  fi
  if [ -d "${_HM_DIR_NEW}" ]; then
    _info "Hostmaster site dir already ${_HM_DIR_NEW##*/} — not renaming"
    return 0
  fi
  if [ -d "${_HM_DIR_OLD}" ]; then
    _info "Renaming hostmaster site dir: ${_HM_DIR_OLD##*/} -> ${_HM_DIR_NEW##*/}"
    _maybe_run mv -f \'"${_HM_DIR_OLD}"\' \'"${_HM_DIR_NEW}"\'
  else
    _alrt "Neither ${_HM_DIR_OLD##*/} nor ${_HM_DIR_NEW##*/} found on disk"
  fi
}

###-------------§2c TENANT SITE DIRS-----###

# The host axis renames a site's vhost, its sites.php record and its panel
# node title by substring, so a tenant whose URI embeds the box hostname
# (BOA's standard staging shape <site>.<oN>.<FQDN>) followed the rename on
# every surface EXCEPT its own directory. That split is not survivable:
# conf_path() finds no sites/<new URI> and serves the installer page, while
# §7's platform verify enumerates every sites/*/settings.php, finds the
# stranded old-named dir claimed by no node, and imports it as a brand-new
# site — leaving two panel nodes per site, the enabled one broken and the
# orphan owning the only directory and database.
#
# So the directory moves with the name, together with every other on-disk
# surface keyed by URI: the per-site Drush alias FILE (§3 rewrites its
# contents but cannot rename it), the static files store that the site's
# files symlink resolves through, the site's own files/private symlinks INTO
# that store (dangling the moment it moves), the client symlink, and the
# URI-derived values inside the provision-generated settings.php.
#
# None of those are optional and none regenerate on their own. §7 queues
# SERVER verifies, and every per-site artefact is written by a SITE verify:
# _provision_client_create_symlink() is reached only under
# `d()->type === 'site'`. That is why a run whose seven other gates passed
# still left three renamed sites answering HTTP 400 with a settings.php
# pinned to the old FQDN, no client symlink and dangling files symlinks,
# while the one untouched control site kept all three.
#
# A site is not Drupal-shaped by definition. Grav and Textpattern capsules
# carry no settings.php, so a settings.php test on its own parked a box-named
# one as a stray while its panel node, its vhost and its alias were renamed
# around it: the new name answered 404 from a root that did not exist and the
# data sat in backups/rename-hostname/stray-sites/. The markers used below are
# provision's own site finders' (provision-grav globs
# 'sites/*/system/defines.php', provision-txp 'sites/*/private/config.php'),
# so what this tool counts as a site is what the backend counts as one. Each
# class then gets exactly the uri-bound surfaces its own rename command
# re-points and nothing more — identity, content and database stay put.
#
# The account axis deliberately does NOT do this — there the box keeps its
# name and a site's URI is its own, so §5b stays exact-match. Here the box
# name itself is changing and the old name keeps resolving to the source
# box, which is why the tenant has to follow.

_parked_capsule_platform_root() {
  # Where a parked capsule belongs. provision persists a site's platform root
  # in that site's ALIAS file ('root' => '...'), never in the site's own
  # sites/<uri>/drushrc.php: that file is rendered from the 'site' drush
  # context, which carries the six database credentials plus
  # installed/profile/language and nothing else. Reading $options['root']
  # from the capsule's drushrc.php therefore answers on a hand-written file
  # only, which is why it is the last arm here and not the first. BOA's own
  # tooling reads the same key from the same place (xoct, codebasecheck).
  # $1 = old uri, $2 = new uri, $3 = the parked dir. Prints the root, or
  # nothing at all when no source carries one.
  local _OLDN="$1"
  local _NEWN="$2"
  local _PD="$3"
  local _F _R
  # This pass runs before §3 and before the surfaces pass, so the alias is
  # still filed under the OLD uri -- unless an earlier buggy run already
  # renamed it, hence the new name too. After the live dir, the .drush copies
  # of EARLIER runs, newest first: an alias the run that parked this capsule
  # destroyed is missing from the live dir and from this run's own copy of it
  # (taken seconds ago from that same live dir), and lives only in the copy
  # that run took before it acted.
  local _CANDS=(
    "${_DRUSH_DIR}/${_OLDN}.alias.drushrc.php"
    "${_DRUSH_DIR}/${_NEWN}.alias.drushrc.php"
  )
  local _BK
  for _BK in $(ls -1d "${_BACKUP_DIR}"/drush_* 2>/dev/null | sort -r); do
    [ -d "${_BK}" ] || continue
    [ "${_BK}" = "${_BACKUP_DIR}/drush_${_TS}" ] && continue
    _CANDS+=("${_BK}/${_OLDN}.alias.drushrc.php")
    _CANDS+=("${_BK}/${_NEWN}.alias.drushrc.php")
  done
  for _F in "${_CANDS[@]}"; do
    [ -f "${_F}" ] || continue
    _R=$(sed -n "s/.*'root' => '\([^']*\)'.*/\1/p" "${_F}" 2>/dev/null | head -1)
    if [ -n "${_R}" ]; then
      printf '%s' "${_R}"
      return 0
    fi
  done
  _R=$(_txp_drushrc_value "${_PD}/drushrc.php" root) || _R=""
  [ -z "${_R}" ] && return 1
  printf '%s' "${_R}"
  return 0
}

_recover_parked_site_dirs() {
  # Un-park what an earlier release parked. That release tested a site dir for
  # settings.php alone, so a Grav or Textpattern capsule whose uri carries the
  # box name was moved into ${_BACKUP_DIR}/stray-sites/ while its panel node,
  # its vhost and its alias were renamed around it — the new name answering
  # 404 from a root that does not exist. Nothing else in this tool ever reads
  # that directory back: every find excludes */backups/*, and _BACKUP_DIR is
  # under backups/. So without this pass a re-run of the FIXED tool finds no
  # dir to move, §9 has nothing to probe, the pre-queue guard sees nothing
  # stranded, and the run prints "Rename complete" over a parked site.
  #
  # Guarded exactly like the mover it runs before: _safe_name on every value
  # that reaches an eval, --dry-run through _maybe_run, and a refusal rather
  # than an overwrite when the destination is taken. The platform root comes
  # from the site's alias file (helper above), and the capsule is reinstated
  # only when that root sits UNDER ${_AEGIR_ROOT} and carries an index.php:
  # this is the one destination in the tool chosen by file CONTENT rather
  # than computed in place, so a stale or hand-edited value must never move a
  # tenant into another instance's platform, where no later pass of this run
  # could see it again while the summary still read "reinstated". On the
  # account axis the recorded root still names /data/disk/<old-account>,
  # which fails the containment test, so the capsule is reported and left
  # parked rather than guessed at.
  #
  # Anything host-derived down there that this cannot reinstate is named at
  # the end, so the summary can never read as success over a park.
  local _PARK="${_BACKUP_DIR}/stray-sites"
  local _P _OLDNAME _NEWNAME _CLASS _ROOT _NEWD _UNDER_ROOT _LEFT=""

  [ -d "${_PARK}" ] || return 0
  for _P in "${_PARK}"/*; do
    { [ -d "${_P}" ] && [ ! -L "${_P}" ]; } || continue
    _OLDNAME=$(basename "${_P}")
    case "${_OLDNAME}" in
      *"${_OLD_HOST}"*) ;;
      *) continue ;;
    esac
    _renamed_already "${_OLDNAME}" && continue
    _NEWNAME="${_OLDNAME//${_OLD_HOST}/${_NEW_HOST}}"
    [ "${_NEWNAME}" = "${_OLDNAME}" ] && continue
    _safe_name "${_P}" "parked site dir" || continue
    _CLASS=$(_site_capsule_class "${_P}")
    if [ -z "${_CLASS}" ]; then
      _LEFT="${_LEFT} ${_OLDNAME}"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    _ROOT=$(_parked_capsule_platform_root "${_OLDNAME}" "${_NEWNAME}" "${_P}") || _ROOT=""
    if [ -z "${_ROOT}" ] || ! _safe_name "${_ROOT}" "parked capsule platform root"; then
      _alrt "  parked ${_CLASS} capsule ${_OLDNAME}: no usable platform root in its alias file or drushrc.php — left parked"
      _LEFT="${_LEFT} ${_OLDNAME}"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    # Containment before existence: a prefix test alone is escaped by a ..
    # segment, and _safe_name admits dots and slashes.
    _UNDER_ROOT=YES
    case "/${_ROOT}/" in
      *"/../"*) _UNDER_ROOT=NO ;;
    esac
    case "${_ROOT}/" in
      "${_AEGIR_ROOT%/}"/*) ;;
      *) _UNDER_ROOT=NO ;;
    esac
    if [ "${_UNDER_ROOT}" != "YES" ]; then
      _alrt "  parked ${_CLASS} capsule ${_OLDNAME}: platform root ${_ROOT} is outside ${_AEGIR_ROOT} — left parked"
      _LEFT="${_LEFT} ${_OLDNAME}"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    if [ ! -d "${_ROOT}" ] || [ ! -f "${_ROOT}/index.php" ]; then
      _alrt "  parked ${_CLASS} capsule ${_OLDNAME}: ${_ROOT} is not a platform root (no index.php) — left parked"
      _LEFT="${_LEFT} ${_OLDNAME}"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    _NEWD="${_ROOT}/sites/${_NEWNAME}"
    if [ -e "${_NEWD}" ] || [ -L "${_NEWD}" ]; then
      _alrt "  parked ${_CLASS} capsule ${_OLDNAME}: ${_NEWD} already exists — left parked, merge them by hand"
      _LEFT="${_LEFT} ${_OLDNAME}"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    _info "  un-park: stray-sites/${_OLDNAME} -> ${_NEWD} (${_CLASS} capsule)"
    if ! _maybe_run mv -f \'"${_P}"\' \'"${_NEWD}"\'; then
      _alrt "  un-park FAILED — left parked: ${_P}"
      _LEFT="${_LEFT} ${_OLDNAME}"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    # Reinstated, so it takes the same two passes and the same §9 gate as a
    # capsule the mover moves itself — and the same exclusion from
    # _RENAMED_SITE_URIS, for the reason given there.
    _rename_site_uri_surfaces "${_OLDNAME}" "${_NEWNAME}" "${_P}" "${_NEWD}"
    _rename_capsule_uri_surfaces "${_CLASS}" "${_OLDNAME}" "${_NEWNAME}" "${_P}" "${_NEWD}"
    _SERVE_CHECK_URIS+=("${_NEWNAME}")
    _CAPSULE_DONE_URIS="${_CAPSULE_DONE_URIS} ${_NEWNAME}"
    _CAPSULE_DIRS_N=$((_CAPSULE_DIRS_N + 1))
    _UNPARKED_N=$((_UNPARKED_N + 1))
  done

  if [ "${_UNPARKED_N}" -gt 0 ] && [ "${_DRY_RUN}" = "YES" ]; then
    _info "  ${_UNPARKED_N} parked capsule(s) would be reinstated from ${_PARK}"
  elif [ "${_UNPARKED_N}" -gt 0 ]; then
    _info "  ${_UNPARKED_N} parked capsule(s) reinstated from ${_PARK}"
  fi
  if [ -n "${_LEFT}" ]; then
    _alrt "  still parked in ${_PARK} and NOT reinstated:${_LEFT}"
    _alrt "  Check each one before that directory is deleted — a parked site serves nothing."
  fi
  return 0
}

_rename_tenant_site_dirs() {
  _info "§2c Renaming host-derived tenant site dirs under ${_AEGIR_ROOT} ..."

  local _D _SITES _OLDNAME _NEWNAME _NEWD _CLASS _N=0

  # Before the mover, because a capsule parked by an earlier release is
  # invisible to every find below and to the pre-queue guard.
  _recover_parked_site_dirs

  for _D in $(_find_old_host_site_dirs | sort); do
    _OLDNAME=$(basename "${_D}")
    _safe_name "${_D}" "site dir" || continue
    _renamed_already "${_OLDNAME}" && continue
    _NEWNAME="${_OLDNAME//${_OLD_HOST}/${_NEW_HOST}}"
    [ "${_NEWNAME}" = "${_OLDNAME}" ] && continue
    _SITES=$(dirname "${_D}")
    _NEWD="${_SITES}/${_NEWNAME}"
    if [ -d "${_NEWD}" ]; then
      _alrt "  ${_NEWNAME} already exists beside ${_OLDNAME} — leaving both for review"
      continue
    fi
    # A sites/<name> dir carrying none of the three site markers is not a
    # site, yet §7's platform verify would import it as one: renamed, it
    # became a bogus site node that §9 then alarmed NOT SERVING; left in
    # place under the old host, the pre-queue guard refuses the whole tail.
    # Park it under the rename's own backup dir and say so -- nothing to
    # rename, nothing for §7 to import. Reversible: the recovery pass above
    # reinstates anything down there that turns out to be a capsule, and
    # names the rest. It counts into the SAME leftover total that pass feeds,
    # because it runs before this loop: without that, the run which creates a
    # park prints a summary reading as unqualified success and the ATTENTION
    # line appears only on a next invocation that a one-shot cutover never
    # makes.
    _CLASS=$(_site_capsule_class "${_D}")
    if [ ! -f "${_D}/settings.php" ] && [ -z "${_CLASS}" ]; then
      _maybe_run mkdir -p \'"${_BACKUP_DIR}/stray-sites"\'
      _maybe_run mv -f \'"${_D}"\' \'"${_BACKUP_DIR}/stray-sites/${_OLDNAME}"\'
      _alrt "  parked ${_OLDNAME}: no settings.php, no system/defines.php, no private/config.php (not a site) -> ${_BACKUP_DIR}/stray-sites/"
      _STRAY_LEFT_N=$((_STRAY_LEFT_N + 1))
      continue
    fi
    if [ -n "${_CLASS}" ]; then
      _info "  site dir: ${_OLDNAME} -> ${_NEWNAME} (in ${_SITES}, ${_CLASS} capsule)"
    else
      _info "  site dir: ${_OLDNAME} -> ${_NEWNAME} (in ${_SITES})"
    fi
    _maybe_run mv -f \'"${_D}"\' \'"${_NEWD}"\'
    _rename_site_uri_surfaces "${_OLDNAME}" "${_NEWNAME}" "${_D}" "${_NEWD}"
    if [ -n "${_CLASS}" ]; then
      _rename_capsule_uri_surfaces "${_CLASS}" "${_OLDNAME}" "${_NEWNAME}" "${_D}" "${_NEWD}"
      # A capsule is gated by §9 like any other renamed name, but never joins
      # _RENAMED_SITE_URIS: that list is what §7 queues per-site verifies
      # from, and a capsule's verify is provision's own class-specific task,
      # with its own PHP floor -- not this tool's to force from the queue.
      _SERVE_CHECK_URIS+=("${_NEWNAME}")
      _CAPSULE_DONE_URIS="${_CAPSULE_DONE_URIS} ${_NEWNAME}"
      _CAPSULE_DIRS_N=$((_CAPSULE_DIRS_N + 1))
    else
      _RENAMED_SITE_URIS+=("${_NEWNAME}")
    fi
    _N=$((_N + 1))
  done

  # A reinstated capsule is a tenant dir that landed on the new hostname too,
  # and the summary calls the capsule total a subset of this one: counted
  # here, so a run whose only work was the recovery pass cannot print "0
  # moved" over the capsule it just un-parked.
  _TENANT_DIRS_N=$((_N + _UNPARKED_N))
  if [ "${_N}" -eq 0 ] && [ "${_UNPARKED_N}" -eq 0 ]; then
    _info "  no host-derived tenant site dirs found — nothing to move"
  elif [ "${_N}" -eq 0 ] && [ "${_DRY_RUN}" = "YES" ]; then
    _info "  no host-derived tenant site dirs left to move beside the ${_UNPARKED_N} that would be reinstated above"
  elif [ "${_N}" -eq 0 ]; then
    _info "  no host-derived tenant site dirs left to move beside the ${_UNPARKED_N} reinstated above"
  elif [ "${_DRY_RUN}" = "YES" ]; then
    _info "  ${_N} tenant site dir(s) would move onto ${_NEW_HOST}"
  else
    _info "  ${_N} tenant site dir(s) moved onto ${_NEW_HOST}"
  fi

  _converge_renamed_site_surfaces
}

_converge_renamed_site_surfaces() {
  # A box renamed by an earlier release moved the site DIRS and nothing else:
  # its sites keep an old-URI settings.php, dangling files symlinks and no
  # client symlink. The loop above cannot see them — their dirs already carry
  # the new hostname — so without this a re-run would report a clean pass over
  # sites that do not serve. That is the whole failure mode being closed here,
  # so it must converge rather than depend on being run at the right moment.
  #
  # Safe on a box with nothing to fix: every action in the surfaces function is
  # conditioned on evidence that THIS site is wrong — the old name still on a
  # surface, or a stored value that already disagrees with the site's own uri —
  # so a correct site, including one freshly installed on a migration target
  # which legitimately carries the new hostname, matches nothing and is not
  # even queued for a verify. The database legs are held to the stricter half
  # of that rule: old-name evidence only, never a constant that merely differs.
  local _D _NAME _OLDNAME _CLASS _N=0
  for _D in $(_find_host_site_dirs "${_NEW_HOST}" | sort); do
    _NAME=$(basename "${_D}")
    # Same guard the mover applies: this path reaches _maybe_run's eval
    # through the surfaces function below.
    _safe_name "${_D}" "site dir" || continue
    _OLDNAME="${_NAME//${_NEW_HOST}/${_OLD_HOST}}"
    [ "${_OLDNAME}" = "${_NAME}" ] && continue
    # A capsule the loop above has already moved and re-pointed is finished:
    # a second pass over it would find nothing to do and still repeat every
    # ALRT it printed. Only capsule names ever reach that list, so the test
    # needs no class of its own -- which is what lets the class be decided
    # after the generic pass below.
    case " ${_CAPSULE_DONE_URIS} " in
      *" ${_NAME} "*) continue ;;
    esac
    _URI_SURFACES_CHANGED=NO
    _rename_site_uri_surfaces "${_OLDNAME}" "${_NAME}" "${_D}" "${_D}"
    # Classified only NOW, because the pass above moves and repoints the very
    # surfaces the class markers are read through: the account's static files
    # store follows the name there, and so does every link in the site dir
    # that resolved into it. provision materialises private/ and system/ as
    # real directories, but a half-finished earlier run -- the very state this
    # pass exists to heal -- can leave a capsule's marker behind a link into
    # the store under the OLD name, dangling until the pass above repoints
    # it. Classified before that, such a capsule reads as a plain site with no
    # settings.php: no capsule surface repaired, and not even probed by §9.
    _CLASS=$(_site_capsule_class "${_D}")
    # Every site already on the new hostname is §9's to confirm, repaired
    # here or not: on a resume after a refusal the dirs were moved by the
    # parked run, nothing below changes, and without this line the serving
    # gate would have nothing to probe and the summary nothing to say.
    # Host-derived means the name ENDS in the hostname (label.<host>, the
    # panel's own oN.<host>); a substring match would drag in an unrelated
    # domain that merely contains it.
    case "${_NAME}" in
      *".${_NEW_HOST}"|"${_NEW_HOST}")
        if [ -f "${_D}/settings.php" ] || [ -n "${_CLASS}" ]; then
          _SERVE_CHECK_URIS+=("${_NAME}")
        fi
      ;;
    esac
    if [ -n "${_CLASS}" ]; then
      # Same converge duty for a capsule moved by an earlier run: its .env,
      # environment overlay and private/config.php are conditioned on the
      # value being wrong, and the database legs on old-name evidence this
      # call did not bring (the dir did not move here), so a correct capsule
      # matches nothing and issues no statement. It stays out of
      # _RENAMED_SITE_URIS for the reason given in the mover -- §7 must not
      # queue a class verify for it.
      _rename_capsule_uri_surfaces "${_CLASS}" "${_OLDNAME}" "${_NAME}" "${_D}" "${_D}"
      [ "${_URI_SURFACES_CHANGED}" = "YES" ] && _N=$((_N + 1))
      continue
    fi
    if [ "${_URI_SURFACES_CHANGED}" = "YES" ]; then
      _RENAMED_SITE_URIS+=("${_NAME}")
      _N=$((_N + 1))
    fi
  done
  if [ "${_N}" -gt 0 ]; then
    _info "  ${_N} already-renamed site(s) had stale per-site surfaces repaired"
  fi
  return 0
}

_find_host_site_dirs() {
  # Every platform docroot layout at once (sites/, web/sites/, docroot/sites/,
  # html/sites/) — one platform can even carry the same site at two depths.
  # Backups and the Drush checksum store are never site dirs.
  find "${_AEGIR_ROOT}" -maxdepth 8 -type d -path '*/sites/*' \
    -name "*${1}*" \
    -not -path '*/backups/*' \
    -not -path '*/.drush/*' \
    -not -path '*/sites/*/*' 2>/dev/null
}

_find_old_host_site_dirs() {
  _find_host_site_dirs "${_OLD_HOST}"
}

_rename_site_uri_surfaces() {
  # Idempotent by construction: every move is skipped when the source is
  # gone or the target already exists, so a site carried at two depths and a
  # re-run both converge.
  local _OLDNAME="$1"
  local _NEWNAME="$2"
  local _OLD_D="$3"
  local _NEWD="$4"
  local _OLD_ALIAS="${_DRUSH_DIR}/${_OLDNAME}.alias.drushrc.php"
  local _NEW_ALIAS="${_DRUSH_DIR}/${_NEWNAME}.alias.drushrc.php"
  local _OLD_FILES="${_AEGIR_ROOT}/static/files/${_OLDNAME}"
  local _NEW_FILES="${_AEGIR_ROOT}/static/files/${_NEWNAME}"
  local _SD _L _NEWL _TGT _SUF _OWN

  # The dir to read from: the moved one live, the source one under --dry-run
  # (where the move above only printed). Keeps the dry-run report honest
  # about the settings.php and symlink work instead of silently skipping it.
  _SD="${_OLD_D}"
  [ -d "${_NEWD}" ] && _SD="${_NEWD}"

  if [ -f "${_OLD_ALIAS}" ] && [ ! -f "${_NEW_ALIAS}" ]; then
    _info "    alias file: ${_OLDNAME}.alias.drushrc.php -> ${_NEWNAME}.alias.drushrc.php"
    _maybe_run mv -f \'"${_OLD_ALIAS}"\' \'"${_NEW_ALIAS}"\'
    _URI_SURFACES_CHANGED=YES
  fi

  # The site's files symlink resolves through this store. Leave it behind and
  # the next verify mints an EMPTY store under the new URI and the site loses
  # its files, so this move is not optional.
  if [ -d "${_OLD_FILES}" ] && [ ! -d "${_NEW_FILES}" ]; then
    _info "    static files store: static/files/${_OLDNAME} -> static/files/${_NEWNAME}"
    _maybe_run mv -f \'"${_OLD_FILES}"\' \'"${_NEW_FILES}"\'
    _URI_SURFACES_CHANGED=YES
  fi

  # ...which leaves the site's own files/private symlinks pointing INTO the
  # store under its old name: dangling, so the site serves without any of
  # its files. Repoint every symlink in the site dir that resolves into the
  # old store; a site whose files are a real directory has none and is left
  # alone. -h on the chown: the link's own ownership, never the target's.
  for _L in "${_SD}"/*; do
    [ -L "${_L}" ] || continue
    _TGT=$(readlink "${_L}" 2>/dev/null)
    case "${_TGT}" in
      "${_OLD_FILES}"|"${_OLD_FILES}"/*) ;;
      *) continue ;;
    esac
    _SUF="${_TGT#${_OLD_FILES}}"
    if [ -n "${_SUF}" ] && ! _safe_name "${_SUF}" "files symlink target suffix"; then
      continue
    fi
    _safe_name "${_L}" "files symlink" || continue
    _OWN=$(stat -c '%U:%G' "${_L}" 2>/dev/null)
    _info "    files symlink: ${_L##*/} -> static/files/${_NEWNAME}${_SUF}"
    _maybe_run ln -sfn \'"${_NEW_FILES}${_SUF}"\' \'"${_L}"\'
    [ -n "${_OWN}" ] && _maybe_run chown -h \'"${_OWN}"\' \'"${_L}"\'
    _URI_SURFACES_CHANGED=YES
  done

  # The client symlink MOVES with the name. Dropping it for provision to
  # recreate cannot work — that only happens in a site verify, and §7 queues
  # server verifies — and a missing one takes the site out of the client's
  # home directory listing.
  for _L in "${_AEGIR_ROOT}"/clients/*/"${_OLDNAME}"; do
    [ -L "${_L}" ] || continue
    _safe_name "${_L}" "client symlink" || continue
    _NEWL="$(dirname "${_L}")/${_NEWNAME}"
    if [ -e "${_NEWL}" ] || [ -L "${_NEWL}" ]; then
      _info "    client symlink already present: ${_NEWL#${_AEGIR_ROOT}/}"
      _maybe_run rm -f \'"${_L}"\'
      continue
    fi
    _OWN=$(stat -c '%U:%G' "${_L}" 2>/dev/null)
    _info "    client symlink: ${_L#${_AEGIR_ROOT}/} -> ${_NEWL#${_AEGIR_ROOT}/}"
    _maybe_run ln -sfn \'"${_NEWD}"\' \'"${_NEWL}"\'
    [ -n "${_OWN}" ] && _maybe_run chown -h \'"${_OWN}"\' \'"${_NEWL}"\'
    _maybe_run rm -f \'"${_L}"\'
    _URI_SURFACES_CHANGED=YES
  done

  _rewrite_site_settings_uri "${_SD}/settings.php" "${_OLDNAME}" "${_NEWNAME}"
}

_rewrite_site_in_place() {
  # Rewrite a file THROUGH ITS EXISTING INODE.
  #
  # `sed -i` does not edit in place: it writes a new file and renames it over
  # the old one, so the inode changes. PHP resolves this path through its
  # realpath cache -- default TTL 120s, and held PER FPM WORKER -- so opcache
  # goes on compiling the copy it already has and the site keeps serving the
  # OLD settings.php long after the correct one is on disk.
  #
  # Measured on a test box, in both directions: a corrected settings.php sat
  # on disk while the site answered HTTP 400 for ~3 minutes, and later a
  # deliberately broken one kept serving 200 for over 3 minutes. Because the
  # cache is per worker, whether a given request sees the change is luck --
  # which is exactly why it looked like "the fix did not work" once and "the
  # fix works instantly" the next time.
  #
  # Truncating in place keeps the inode, so opcache's ordinary 2s
  # revalidation applies and the rename takes effect immediately. It also
  # preserves ownership and mode for free.
  local _expr="$1"
  local _f="$2"
  local _tmp
  # The site dir is tenant-writable and `>` follows symlinks, so the staging
  # file is created O_EXCL under a random name: a planted link at the path is
  # refused rather than written through as root. The inode that matters is the
  # real file's, and that is preserved by the truncate-in-place cat below.
  _tmp=$(mktemp "${_f}.xrename.XXXXXX" 2>/dev/null) || return 1
  sed "${_expr}" "${_f}" > "${_tmp}" 2>/dev/null || { rm -f "${_tmp}"; return 1; }
  # Never truncate a live settings.php to nothing because sed hiccuped.
  [ -s "${_tmp}" ] || { rm -f "${_tmp}"; return 1; }
  cat "${_tmp}" > "${_f}" || { rm -f "${_tmp}"; return 1; }
  rm -f "${_tmp}"
  return 0
}

_rewrite_site_settings_uri() {
  # settings.php is provision-generated and embeds the site URI in far more
  # than the host patterns: the public/private/temp file paths, the D10+
  # config sync directory, the syslog identity and the ABSOLUTE
  # local.settings.php include path all carry it. Only trusted_host_patterns
  # produces the visible HTTP 400 ("The provided host name is not valid for
  # this server") — the rest fail silently, writing into a directory that no
  # longer exists and quietly dropping a client's local overrides.
  #
  # The DATABASE must NOT follow the rename: the site keeps its database by
  # design. Its name and user are derived from the URI at install time in a
  # MANGLED form (dots and dashes stripped, then truncated), so the dotted
  # URI replaced here cannot reach them — and if a file ever does carry the
  # dotted URI on a credential line, this refuses it rather than repoint a
  # live site at a database that does not exist. That failure would look
  # exactly like data loss.
  local _SET="$1"
  local _OLDNAME="$2"
  local _NEWNAME="$3"
  local _OLD_BS _NEW_BS _RE_BS _RP_BS _RE _EXPR _OWN _MODE

  # A symlink here is never a provision artefact -- provision writes
  # settings.php as a real file. Everything below dereferences it: the
  # rewrite, and the chown/chmod that hand the file back. The site dir is
  # tenant-writable, so refuse rather than re-own whatever a link points at.
  if [ -L "${_SET}" ]; then
    _alrt "    settings.php is a symlink — refusing to rewrite: ${_SET}"
    _SETTINGS_SKIPPED_N=$((_SETTINGS_SKIPPED_N + 1))
    return 0
  fi

  # The URI appears in TWO spellings. Paths and identities carry it plain;
  # trusted_host_patterns carries it as a PHP regex with the dots
  # backslash-escaped ('^d7\.o1\.old\.example\.com$'). A rewrite that knows
  # only the plain form leaves every host pattern stale — which is to say it
  # leaves the site answering HTTP 400, the one symptom the whole exercise is
  # about. Both spellings, one pass.
  _OLD_BS="${_OLDNAME//./\\.}"
  _NEW_BS="${_NEWNAME//./\\.}"

  [ -f "${_SET}" ] || return 0
  # This path lands in a _maybe_run (eval) argument list below inside literal
  # single quotes. The files and client symlink legs re-guard their own
  # values; this one is the exception, so guard it here rather than trust
  # every caller to have done it.
  if ! _safe_name "${_SET}" "settings.php path"; then
    _SETTINGS_SKIPPED_N=$((_SETTINGS_SKIPPED_N + 1))
    return 0
  fi
  grep -qF -e "${_OLDNAME}" -e "${_OLD_BS}" "${_SET}" 2>/dev/null || return 0

  if grep -E "'(database|username|password)'|db_url" "${_SET}" 2>/dev/null \
    | grep -qF -e "${_OLDNAME}" -e "${_OLD_BS}"; then
    _alrt "    settings.php NOT rewritten — database credentials embed ${_OLDNAME}:"
    _alrt "    ${_SET}"
    _alrt "    Rewrite the URI values by hand; never the database name."
    _SETTINGS_SKIPPED_N=$((_SETTINGS_SKIPPED_N + 1))
    return 0
  fi

  # Dots are regex metacharacters and a site URI is nothing but dots; in the
  # escaped spelling the backslashes need escaping too. The expression is
  # single-quoted through _maybe_run because eval would otherwise eat them.
  _RE=$(printf '%s' "${_OLDNAME}" | sed -e 's/[.]/\\./g')
  _RE_BS=$(printf '%s' "${_OLD_BS}" | sed -e 's/[\]/\\\\/g' -e 's/[.]/\\./g')
  _RP_BS=$(printf '%s' "${_NEW_BS}" | sed -e 's/[\]/\\\\/g')
  _EXPR="${_SED_RENAME_GUARD}s/${_RE_BS}/${_RP_BS}/g"
  _EXPR="${_EXPR}; ${_SED_RENAME_GUARD}s/${_RE}/${_NEWNAME}/g"
  _OWN=$(stat -c '%U:%G' "${_SET}" 2>/dev/null)
  _MODE=$(stat -c '%a' "${_SET}" 2>/dev/null)
  _info "    settings.php: file paths + trusted_host_patterns -> ${_NEWNAME}"
  if ! _maybe_run _rewrite_site_in_place \'"${_EXPR}"\' \'"${_SET}"\'; then
    _alrt "    settings.php rewrite FAILED — left untouched: ${_SET}"
    _SETTINGS_SKIPPED_N=$((_SETTINGS_SKIPPED_N + 1))
    return 0
  fi
  _URI_SURFACES_CHANGED=YES
  # The file is mode 440 owned by the account, and root must hand it back
  # exactly as it found it.
  [ -n "${_OWN}" ] && _maybe_run chown \'"${_OWN}"\' \'"${_SET}"\'
  [ -n "${_MODE}" ] && _maybe_run chmod "${_MODE}" \'"${_SET}"\'
  return 0
}

###-------------§2c2 CAPSULE SITES-------###

# A Grav or Textpattern site is not a Drupal site dir with other contents: it
# is a self-contained capsule under sites/<uri>/, and the only things inside
# it keyed by the uri are the few surfaces its own provision layer re-points
# when IT renames a site. Those lists are mirrored here, each from the file
# named above the function that implements it, rather than guessed -- the
# host-axis rename moves the directory and nothing else will.

_site_capsule_class() {
  # Which non-Drupal site class owns this sites/<uri> dir, decided by the
  # marker provision's own site finders glob for: provision-grav globs
  # 'sites/*/system/defines.php', provision-txp 'sites/*/private/config.php'.
  # Prints grav, txp, or nothing when the dir is neither -- a Drupal or
  # Backdrop site is the settings.php case, and a dir with none of the three
  # markers is the stray case. $1 = the site dir.
  #
  # settings.php outranks both markers because a capsule never carries one:
  # without that test, a tenant who drops a config.php into a Drupal site's
  # private files dir would have the site handled as a Textpattern capsule.
  #
  # Both marker tests are -f, which follows symlinks. provision materialises
  # private/ and system/ as real directories (cp -a from the platform
  # skeleton), so an untouched capsule answers whenever it is asked; a marker
  # reached through a link -- left by a half-finished earlier run, or by an
  # operator's own move into the account's static files store -- answers only
  # once that link resolves. That is a timing requirement on the caller, not
  # a test to loosen: ask AFTER the generic surfaces pass has moved the store
  # and repointed the link, or a half-moved capsule reads as no capsule at
  # all.
  [ -f "$1/settings.php" ] && return 0
  if [ -f "$1/system/defines.php" ]; then
    echo "grav"
  elif [ -f "$1/private/config.php" ]; then
    echo "txp"
  fi
  return 0
}

_rename_capsule_uri_surfaces() {
  # $1 class, $2 old uri, $3 new uri, $4 the source dir, $5 the moved dir.
  # Called AFTER the generic surfaces pass: a Textpattern capsule's private/
  # can be a symlink into the account's static files store, and that store has
  # only just followed the name.
  local _CLASS="$1"
  local _OLDNAME="$2"
  local _NEWNAME="$3"
  local _SD="$4"
  local _MOVED=NO
  # "$5 is absent" cannot stand in for "the move only printed": a live `mv -f`
  # that failed leaves the same shape, and then every value written below --
  # including the path rows in the tenant's own database, which are outside
  # _BACKUP_DIR and have no prior-value record -- would name a directory that
  # does not exist. Dry-run is the only reading of an absent $5 that is safe.
  if [ "${_DRY_RUN}" != "YES" ] && [ ! -d "$5" ]; then
    _alrt "    capsule did not land at $5 — class surfaces left untouched"
    return 0
  fi
  # Two different paths, and conflating them makes the dry-run lie. $5 is
  # where the capsule ENDS UP, so it is what a stored path value must name,
  # dry-run included; _SD is where its files are readable RIGHT NOW, which
  # under --dry-run is still the source dir because the move only printed.
  [ -d "$5" ] && _SD="$5"
  # Old-name evidence of the strongest kind: this run moved the dir. The
  # converge pass calls with $4 = $5 and carries no such evidence, so the
  # class legs that write to a database have to find their own (see the txp
  # leg) rather than assume the site was renamed.
  [ "$4" != "$5" ] && _MOVED=YES
  # Class-agnostic first: every capsule carries provision's persisted site
  # context, and it is keyed by the uri whatever the class.
  _rewrite_capsule_site_drushrc "${_SD}/drushrc.php" "${_OLDNAME}" "${_NEWNAME}"
  case "${_CLASS}" in
    grav)
      _rename_grav_capsule_uri "${_OLDNAME}" "${_NEWNAME}" "${_SD}"
    ;;
    txp)
      _rename_txp_capsule_uri "${_OLDNAME}" "${_NEWNAME}" "${_SD}" "$5" "${_MOVED}"
    ;;
  esac
  return 0
}

_rewrite_capsule_site_drushrc() {
  # The capsule's OWN sites/<uri>/drushrc.php -- provision's persisted site
  # context, carrying uri and site_path among the options the backend reloads
  # on every later task. A Drupal site has this file re-rendered by the site
  # verify §7 queues for it; a capsule is deliberately not queued, so the
  # rename re-points it here or the next task on that capsule resolves a
  # site_path that no longer exists.
  #
  # The database name and user are MANGLED forms of the uri (dots and dashes
  # stripped, then truncated), so the dotted uri replaced here cannot reach
  # them -- and a file that does carry the dotted uri on a credential line is
  # refused rather than repointed at a database that does not exist. Same
  # rule, same reason, as the settings.php pass.
  local _RC="$1"
  local _OLDNAME="$2"
  local _NEWNAME="$3"
  local _RE _EXPR

  [ -f "${_RC}" ] || return 0
  if [ -L "${_RC}" ]; then
    _alrt "    drushrc.php is a symlink — refusing to rewrite: ${_RC}"
    return 0
  fi
  _safe_name "${_RC}" "drushrc.php path" || return 0
  grep -qF "${_OLDNAME}" "${_RC}" 2>/dev/null || return 0
  if grep -E "db_name|db_user|db_passwd|db_url" "${_RC}" 2>/dev/null \
    | grep -qF "${_OLDNAME}"; then
    _alrt "    drushrc.php NOT rewritten — database credentials embed ${_OLDNAME}:"
    _alrt "    ${_RC}"
    return 0
  fi
  _RE=$(printf '%s' "${_OLDNAME}" | sed -e 's/[.]/\\./g')
  _EXPR="${_SED_RENAME_GUARD}s/${_RE}/${_NEWNAME}/g"
  _info "    drushrc.php: uri + site_path -> ${_NEWNAME}"
  if _maybe_run _rewrite_site_in_place \'"${_EXPR}"\' \'"${_RC}"\'; then
    _URI_SURFACES_CHANGED=YES
  else
    _alrt "    drushrc.php rewrite FAILED — left untouched: ${_RC}"
  fi
  return 0
}

_rename_grav_capsule_uri() {
  # Mirrors provision-grav's own rename (rename.grav.provision.inc, through
  # _provision_grav_repoint_uri and _provision_grav_write_env): the capsule's
  # .env pins GRAV_ENVIRONMENT to the site uri, and Grav resolves
  # environment:// to user/env/<that value> when user/env exists and to
  # user/<that value> otherwise -- refusing a directory that is not there and
  # silently dropping every per-host config, blueprint and language override.
  # No database, and nothing else in the capsule is uri-keyed: the nonce key,
  # the api secret, the accounts and the pages are its identity.
  local _OLDNAME="$1"
  local _NEWNAME="$2"
  local _SD="$3"
  local _ENV="${_SD}/.env"
  local _ENV_OK=NO
  local _BASE _OLD_ENV _NEW_ENV _EXPR _NEW_RE _ENV_N _ENV_OKN

  # The overlay move is gated on this file, because the pair must never come
  # apart: an .env naming an overlay directory that no longer exists is the
  # one state provision's writer says must not exist, and no verify is queued
  # for a capsule to repair it. So the test is the whole line's VALUE, not the
  # old name: a quoted value, trailing whitespace or a CRLF line ending all
  # miss an exact-old-name match while leaving the capsule pinned to a dead
  # overlay. A capsule already reading the new name matches here and is
  # silently left alone, which is what the converge pass needs -- and it has
  # to match in every form the rewrite arm below accepts, or a capsule whose
  # environment already resolves to the new uri is rewritten and counted as a
  # repair by the converge pass. Only the dot needs escaping: the value came
  # through _safe_name, whose charset holds no other ERE metacharacter.
  _NEW_RE=$(printf '%s' "${_NEWNAME}" | sed -e 's/[.]/\\./g')
  if [ ! -e "${_ENV}" ] && [ ! -L "${_ENV}" ]; then
    # No .env at all is a stock shape (Grav falls back to user/<uri>), and
    # there is nothing pinning the overlay name, so the move is safe.
    _ENV_OK=YES
  elif [ -L "${_ENV}" ]; then
    # provision writes .env as a real file, and the capsule dir is
    # tenant-writable; a link here is not provision's artefact.
    _alrt "    .env is a symlink — refusing to rewrite: ${_ENV}"
  elif ! _safe_name "${_ENV}" ".env path"; then
    : # _safe_name said why; the overlay stays put with the file
  elif _ENV_N=$(grep -c "^[[:space:]]*GRAV_ENVIRONMENT=" "${_ENV}" 2>/dev/null); \
    _ENV_OKN=$(grep -Ec "^[[:space:]]*GRAV_ENVIRONMENT=(\"${_NEW_RE}\"|'${_NEW_RE}'|${_NEW_RE})[[:space:]]*\$" "${_ENV}" 2>/dev/null); \
    [ "${_ENV_N:-0}" -gt 0 ] && [ "${_ENV_N}" -eq "${_ENV_OKN:-0}" ]; then
    # Dotenv unquotes and trims, so a quoted or padded value that already
    # reads the new uri is an honoured value and not a surface to repair --
    # but only when EVERY assignment line reads it: a stale first line with a
    # corrected one appended (a hand-fixed dotenv) resolves to whichever the
    # reader honours, and the tool cannot prove which, so such a file falls
    # through to the rewrite arm, which replaces every line and converges it.
    _ENV_OK=YES
  elif grep -q "^[[:space:]]*GRAV_ENVIRONMENT=" "${_ENV}" 2>/dev/null; then
    # Whatever the value and whatever the quoting: the line is replaced whole.
    _EXPR='s|^[[:space:]]*GRAV_ENVIRONMENT=.*$|GRAV_ENVIRONMENT='"${_NEWNAME}"'|'
    _info "    .env: GRAV_ENVIRONMENT -> ${_NEWNAME}"
    # The writer rewrites through the existing inode, so the file's ownership
    # and its 0640 mode survive without being handed back explicitly.
    if _maybe_run _rewrite_site_in_place \'"${_EXPR}"\' \'"${_ENV}"\'; then
      _URI_SURFACES_CHANGED=YES
      _ENV_OK=YES
      # Prove it landed before moving the directory it names: a writer that
      # reports success over a line that did not land -- a full filesystem, an
      # .env replaced under the tool, an expression that stops matching after
      # a later edit -- must not be followed by the overlay move. Exact,
      # because the expression above writes the line whole and unquoted.
      if [ "${_DRY_RUN}" != "YES" ] \
        && ! grep -qxF "GRAV_ENVIRONMENT=${_NEWNAME}" "${_ENV}" 2>/dev/null; then
        _ENV_OK=NO
        _alrt "    .env does not read GRAV_ENVIRONMENT=${_NEWNAME} after the rewrite — overlay left at ${_OLDNAME}: ${_ENV}"
      fi
    else
      _alrt "    .env rewrite FAILED — left untouched: ${_ENV}"
    fi
  else
    _alrt "    .env carries no GRAV_ENVIRONMENT line — overlay left at ${_OLDNAME}, set it by hand: ${_ENV}"
  fi

  [ "${_ENV_OK}" = "YES" ] || return 0

  # Both bases, as provision does: a 1.6-shaped capsule keeps the overlay at
  # user/<uri>, a 2.x one at user/env/<uri>, and a tree can carry both.
  for _BASE in "${_SD}/user/env" "${_SD}/user"; do
    _OLD_ENV="${_BASE}/${_OLDNAME}"
    _NEW_ENV="${_BASE}/${_NEWNAME}"
    { [ -d "${_OLD_ENV}" ] && [ ! -L "${_OLD_ENV}" ]; } || continue
    if [ -e "${_NEW_ENV}" ] || [ -L "${_NEW_ENV}" ]; then
      _alrt "    ${_BASE#${_SD}/} carries both ${_OLDNAME} and ${_NEWNAME} — neither overlay moved, merge them by hand"
      continue
    fi
    _safe_name "${_OLD_ENV}" "grav env overlay" || continue
    _info "    grav env overlay: ${_BASE#${_SD}/}/${_OLDNAME} -> ${_NEWNAME}"
    # The inverse of the stale .env, and just as fatal: the vhost's
    # fastcgi_param already names the new uri, so a failed move breaks the
    # web tier too. provision logs it; so does this.
    if _maybe_run mv -f \'"${_OLD_ENV}"\' \'"${_NEW_ENV}"\'; then
      _URI_SURFACES_CHANGED=YES
    else
      _alrt "    grav env overlay move FAILED — .env now names ${_NEWNAME} with no overlay there: ${_OLD_ENV}"
    fi
  done
  return 0
}

_rename_txp_capsule_uri() {
  # Mirrors provision-txp's own rename (rename.txp.provision.inc): the file
  # side is private/config.php, whose admin_url and multisite_root_path carry
  # the uri and the site path (cookie_domain and txpath do not, and a
  # substring pass leaves them alone), and the database side is that command's
  # three operations in its order -- clear the session-bearing tables, rotate
  # every user's nonce, re-point the six uri/path-bound txp_prefs rows. The
  # database, its content and the site's identity -- blog_uid, image ids,
  # every AUTO_INCREMENT -- never move and are never rewritten.
  local _OLDNAME="$1"
  local _NEWNAME="$2"
  local _SD="$3"
  local _TARGET="$4"
  local _MOVED="$5"
  local _CFG="${_SD}/private/config.php"
  local _EVID="${_MOVED}"
  local _RE _EXPR

  if [ ! -f "${_CFG}" ]; then
    _alrt "    no private/config.php under ${_SD} — Textpattern surfaces left alone"
    return 0
  fi
  if [ -L "${_CFG}" ]; then
    _alrt "    private/config.php is a symlink — refusing to rewrite: ${_CFG}"
    return 0
  fi
  _safe_name "${_CFG}" "private/config.php path" || return 0
  if grep -qF "${_OLDNAME}" "${_CFG}" 2>/dev/null; then
    # Old-name evidence of the second kind (see the database pass): this file
    # still names the old uri, so the capsule really is mid-rename.
    _EVID=YES
    _RE=$(printf '%s' "${_OLDNAME}" | sed -e 's/[.]/\\./g')
    _EXPR="${_SED_RENAME_GUARD}s/${_RE}/${_NEWNAME}/g"
    _info "    private/config.php: admin_url + multisite_root_path -> ${_NEWNAME}"
    if _maybe_run _rewrite_site_in_place \'"${_EXPR}"\' \'"${_CFG}"\'; then
      _URI_SURFACES_CHANGED=YES
      # Prove the write landed. In the NEW-contains-OLD regime a rewritten
      # line still carries the old substring inside the new one, so the test
      # is "a line with OLD and without NEW" -- _file_needs_rename's shape.
      if [ "${_DRY_RUN}" != "YES" ] \
        && grep -vF "${_NEWNAME}" "${_CFG}" 2>/dev/null \
        | grep -qF "${_OLDNAME}"; then
        _alrt "    private/config.php still carries ${_OLDNAME}: ${_CFG}"
      fi
    else
      _alrt "    private/config.php rewrite FAILED — left untouched: ${_CFG}"
      return 0
    fi
  fi

  _txp_repoint_database "${_CFG}" "${_NEWNAME}" "${_TARGET}" "${_SD}" \
    "${_EVID}" "${_OLDNAME}"
  return 0
}

_txp_sql() {
  # One batch query against ONE Textpattern site database. This tool runs as
  # root, so root's own defaults-file authenticates and the tenant's database
  # user and password are deliberately never read out of private/config.php
  # into a root shell. $1 = database, $2 = statement.
  mysql --defaults-file=/root/.my.cnf -N -B "$1" -e "$2" 2>/dev/null
}

_txp_config_value() {
  # One single-quoted $txpcfg['<key>'] value out of a Textpattern
  # private/config.php. Strict on purpose: the value goes into an SQL
  # statement and a connection, so anything outside the host/identifier
  # charset -- a quote, a space, a shell metacharacter -- fails the parse
  # instead of being escaped into safety. $1 = file, $2 = key.
  #
  # Three outcomes, and the caller MUST be able to tell them apart: 0 with a
  # value (an empty one is legitimate -- table_prefix normally is), 1 on a
  # charset refusal, 2 when no such assignment is in the file. Collapsing 2
  # into "empty" is how a host that could not be read becomes "" and then
  # localhost, i.e. this box, for a site whose database is on another one.
  # The sentinel is what keeps the two apart through a command substitution,
  # which strips nothing but trailing newlines.
  local _V
  _V=$(sed -n "s/^[[:space:]]*[\$]txpcfg\['$2'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/=\1/p" \
    "$1" 2>/dev/null | head -1)
  [ -z "${_V}" ] && return 2
  _V="${_V#=}"
  case "${_V}" in
    *[!A-Za-z0-9._:-]*) return 1 ;;
  esac
  printf '%s' "${_V}"
  return 0
}

_txp_drushrc_value() {
  # The same three outcomes, read from the capsule's own sites/<uri>/
  # drushrc.php -- provision's persisted site context, written by var_export
  # and so always a single-quoted literal. This is the SOURCE OF TRUTH for the
  # database name and host: private/config.php is credential-CLOAKED by
  # default under the BOA nginx service (provision_db_cloaking), where it
  # carries `$txpcfg['db'] = $_SERVER['db_name'];` and no literal at all --
  # the whole database leg is dead if it is read from there. provision itself
  # reads this file for the same purpose. $1 = file, $2 = option key.
  #
  # Three keys are readable here and no others: db_name and db_host for the
  # database leg above, and root as the LAST resort for the un-park
  # destination -- a key provision does not write into a site drushrc.php, so
  # it answers on a hand-written file only, and the caller separately refuses
  # a root outside ${_AEGIR_ROOT} or without an index.php. The password sits
  # in the same file and is deliberately never parsed: this tool connects as
  # root through root's own defaults-file.
  local _V
  case "$2" in
    db_name|db_host|root) ;;
    *) return 2 ;;
  esac
  _V=$(sed -n "s/^[[:space:]]*[\$]options\['$2'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/=\1/p" \
    "$1" 2>/dev/null | head -1)
  [ -z "${_V}" ] && return 2
  _V="${_V#=}"
  case "${_V}" in
    *[!A-Za-z0-9._:/-]*) return 1 ;;
  esac
  printf '%s' "${_V}"
  return 0
}

_txp_table_exists() {
  # $1 = database, $2 = table. information_schema, not SHOW TABLES LIKE:
  # '_' is a single-character LIKE wildcard and a site's tables are all
  # txp_something, so LIKE 'txp_token' matches txpXtoken too and the probe
  # fails OPEN. provision's own helper carries the same note for the same
  # reason.
  local _N
  _N=$(_txp_sql "$1" "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = '$2'")
  _N=${_N//[^0-9]/}
  [ "${_N:-0}" -gt 0 ]
}

_txp_repoint_database() {
  # The database side of provision-txp's own rename, in its order and through
  # the same three operations (rename.txp.provision.inc step 5, calling
  # _provision_txp_truncate_sessions, _provision_txp_rotate_nonces and
  # _provision_txp_repoint_uri): clear the session-bearing tables, rotate
  # every user's nonce, re-point the six uri- and path-bound preference rows.
  # Left stale, siteurl composes every public link at the old name and
  # path_to_site, file_base_path and tempdir name directories that moved with
  # the capsule. Every prefs row is READ before it is written, so a capsule
  # already at the new name is a no-op and a re-run changes nothing.
  #
  # An ABSENT prefs row is CREATED with core's own metadata, for the reason
  # provision gives for creating it: Textpattern's checkPrefsIntegrity()
  # recreates a missing row from DEFAULTS on the next admin login, and the
  # siteurl default is the ADMIN hostname -- the site would start composing
  # links at the wrong host. A row that can be neither updated nor created is
  # reported. Every refusal below leaves the site serving from its renamed
  # directory -- that half is the load-bearing one -- and says what is stale.
  #
  # $1 config.php, $2 new uri, $3 the site path the rows must name, $4 the
  # capsule dir readable right now, $5 old-name evidence so far (YES/NO),
  # $6 old uri.
  #
  # With no evidence this pass is INERT. The converge loop walks every site
  # dir carrying the new hostname, including capsules freshly installed on a
  # migration target that were never renamed at all, and two of the six values
  # are constants -- a tenant's deliberately non-live production_status is not
  # a host rename's to flip. So the last resort is ONE read of siteurl: it
  # still names the old uri, or nothing here runs and nothing is printed.
  local _CFG="$1"
  local _URI="$2"
  local _SITE_PATH="$3"
  local _SD="$4"
  local _EVID="$5"
  local _OLDURI="$6"
  local _RC="${_SD}/drushrc.php"
  local _DB="" _PFX="" _HOST="" _R=0
  local _TBL _NAME _VAL _CUR _CNT _TYPE _EVENT _HTML _POS _T
  local _N=0 _MISSING="" _CREATED=""

  _safe_name "${_SITE_PATH}" "txp site path" || return 0

  # The capsule's own drushrc.php first, the config.php literal second.
  # private/config.php is credential-CLOAKED by default under the BOA nginx
  # service, where it carries no database name at all; drushrc.php is
  # provision's persisted site context, var_export'd and never cloaked, and is
  # where provision itself reads these values. The literal arm is what an
  # uncloaked tree has. The password is in neither path: root's own
  # defaults-file authenticates.
  _DB=$(_txp_drushrc_value "${_RC}" db_name) || _DB=""
  if [ -z "${_DB}" ]; then
    _DB=$(_txp_config_value "${_CFG}" db) || _DB=""
  fi
  if [ -z "${_DB}" ]; then
    [ "${_EVID}" = "YES" ] \
      && _alrt "    no plain database name in ${_RC} or ${_CFG} — txp_prefs left stale"
    return 0
  fi

  _HOST=$(_txp_drushrc_value "${_RC}" db_host); _R=$?
  if [ "${_R}" -ne 0 ]; then
    _HOST=$(_txp_config_value "${_CFG}" host); _R=$?
  fi
  if [ "${_R}" -ne 0 ]; then
    # Fail CLOSED. An unread host used to arrive here as "", and "" is read
    # below as this box -- which would run the six statements against the
    # local server for a site whose database lives on another one.
    [ "${_EVID}" = "YES" ] \
      && _alrt "    no plain database host in ${_RC} or ${_CFG} — txp_prefs left stale rather than assumed local"
    return 0
  fi

  # The prefix is not a credential, so both config.php shapes carry it as a
  # literal; an empty one is the normal value. Absent, the table names cannot
  # be derived at all.
  _PFX=$(_txp_config_value "${_CFG}" table_prefix); _R=$?
  if [ "${_R}" -eq 2 ]; then
    [ "${_EVID}" = "YES" ] \
      && _alrt "    no table_prefix assignment in ${_CFG} — the table names cannot be derived, txp_prefs left stale"
    return 0
  fi
  if [ "${_R}" -ne 0 ]; then
    [ "${_EVID}" = "YES" ] \
      && _alrt "    table_prefix in ${_CFG} is not a plain identifier — txp_prefs left stale"
    return 0
  fi
  case "${_PFX}" in
    *[!A-Za-z0-9_]*)
      [ "${_EVID}" = "YES" ] \
        && _alrt "    table_prefix in ${_CFG} is not a plain identifier — txp_prefs left stale"
      return 0
    ;;
  esac

  # root's defaults-file names the LOCAL server, so a site whose database
  # lives elsewhere is that server's to re-point, not ours. An empty value is
  # mysqli's localhost default -- and now only ever a real empty literal, not
  # a host that could not be read; the port suffix is not part of the host.
  case "${_HOST%%:*}" in
    ""|localhost|127.0.0.1|"${_OLD_HOST}"|"${_NEW_HOST}") ;;
    *)
      [ "${_EVID}" = "YES" ] \
        && _alrt "    site database is on ${_HOST}, not this box — txp_prefs left to that server"
      return 0
    ;;
  esac

  _TBL="${_PFX}txp_prefs"
  # The only database read a no-evidence capsule makes. An unreachable
  # database or an absent table answers "not the old uri" and is silent here:
  # a capsule this run has no business touching has nothing to report either.
  if [ "${_EVID}" != "YES" ]; then
    _CUR=$(_txp_sql "${_DB}" "SELECT val FROM ${_TBL} WHERE name = 'siteurl' LIMIT 1")
    [ "${_CUR}" = "${_OLDURI}" ] || return 0
    _EVID=YES
  fi

  if [ -z "$(_txp_sql "${_DB}" "SELECT 1")" ]; then
    _alrt "    database ${_DB} unreachable as root — txp_prefs left stale; the site serves, its links may not"
    return 0
  fi
  if ! _txp_table_exists "${_DB}" "${_TBL}"; then
    _alrt "    ${_DB} has no ${_TBL} table — no preference rows to re-point"
    return 0
  fi

  # A name change is a cookie invalidation, which is why provision does this
  # before it re-points anything: a live login cookie authenticates against
  # the STORED nonce, and after a cutover the old FQDN keeps resolving to the
  # SOURCE box, where the same site and the same database are still served --
  # a copy of this site answering at another name. Nothing in the three
  # tables is content, and passwords are not touched: the nonce is the
  # session salt, not the secret.
  for _T in txp_token txp_log txp_discuss_nonce; do
    _txp_table_exists "${_DB}" "${_PFX}${_T}" || continue
    if [ "${_DRY_RUN}" = "YES" ]; then
      echo "DRY:  mysql --defaults-file=/root/.my.cnf -N -B ${_DB} -e \"TRUNCATE TABLE ${_PFX}${_T}\""
      continue
    fi
    if ! _txp_sql "${_DB}" "TRUNCATE TABLE ${_PFX}${_T}"; then
      _alrt "    ${_PFX}${_T} could not be cleared in ${_DB}"
    fi
  done
  if _txp_table_exists "${_DB}" "${_PFX}txp_users"; then
    if [ "${_DRY_RUN}" = "YES" ]; then
      echo "DRY:  mysql --defaults-file=/root/.my.cnf -N -B ${_DB} -e \"UPDATE ${_PFX}txp_users SET nonce = MD5(CONCAT(RAND(), UUID()))\""
    elif _txp_sql "${_DB}" "UPDATE ${_PFX}txp_users SET nonce = MD5(CONCAT(RAND(), UUID()))"; then
      _info "    txp sessions cleared, every user nonce rotated in ${_DB}"
    else
      _alrt "    ${_PFX}txp_users nonces could not be rotated in ${_DB} — cookies minted at ${_OLDURI} stay valid"
    fi
  fi

  for _NAME in siteurl path_to_site file_base_path tempdir plugin_cache_dir production_status; do
    # The value, and core's own prefs metadata for the row should it have to
    # be created: type, event, html, position. collection and user_name are
    # '' for all six, which is what makes them global prefs rather than
    # per-user overrides.
    case "${_NAME}" in
      siteurl)
        _VAL="${_URI}"; _TYPE=0; _EVENT='site'; _HTML='text_input'; _POS=40
      ;;
      path_to_site)
        _VAL="${_SITE_PATH}/public"; _TYPE=2; _EVENT='publish'; _HTML='text_input'; _POS=0
      ;;
      file_base_path)
        _VAL="${_SITE_PATH}/public/files"; _TYPE=0; _EVENT='admin'; _HTML='text_input'; _POS=40
      ;;
      tempdir)
        _VAL="${_SITE_PATH}/tmp"; _TYPE=0; _EVENT='admin'; _HTML='text_input'; _POS=80
      ;;
      plugin_cache_dir)
        # Source-bound, and PHP is include()d from it on every public request.
        _VAL=""; _TYPE=0; _EVENT='admin'; _HTML='text_input'; _POS=100
      ;;
      production_status)
        # Never carry a debug status through a rename: it publishes trace and
        # SQL detail on the new name.
        _VAL="live"; _TYPE=0; _EVENT='site'; _HTML='prod_levels'; _POS=80
      ;;
    esac
    _CNT=$(_txp_sql "${_DB}" "SELECT COUNT(*) FROM ${_TBL} WHERE name = '${_NAME}'")
    _CNT=${_CNT//[^0-9]/}
    if [ "${_CNT:-0}" -eq 0 ]; then
      if [ "${_DRY_RUN}" = "YES" ]; then
        echo "DRY:  mysql --defaults-file=/root/.my.cnf -N -B ${_DB} -e \"INSERT INTO ${_TBL} (name, val, type, event, collection, html, position, user_name) VALUES ('${_NAME}', '${_VAL}', ${_TYPE}, '${_EVENT}', '', '${_HTML}', ${_POS}, '')\""
        continue
      fi
      # The INSERT's own status is not the verdict, which is why provision
      # swallows it too: a schema this statement does not understand (an
      # adopted site whose txp_prefs predates the collection column) refuses
      # it, and TXP's integrity check racing this pass makes it a
      # duplicate-key error while producing exactly the row wanted. The
      # value is re-asserted either way and the count below decides.
      _txp_sql "${_DB}" "INSERT INTO ${_TBL} (name, val, type, event, collection, html, position, user_name) VALUES ('${_NAME}', '${_VAL}', ${_TYPE}, '${_EVENT}', '', '${_HTML}', ${_POS}, '')"
      _txp_sql "${_DB}" "UPDATE ${_TBL} SET val = '${_VAL}' WHERE name = '${_NAME}'"
      _CNT=$(_txp_sql "${_DB}" "SELECT COUNT(*) FROM ${_TBL} WHERE name = '${_NAME}'")
      _CNT=${_CNT//[^0-9]/}
      if [ "${_CNT:-0}" -gt 0 ]; then
        _CREATED="${_CREATED} ${_NAME}"
      else
        _MISSING="${_MISSING} ${_NAME}"
      fi
      continue
    fi
    _CUR=$(_txp_sql "${_DB}" "SELECT val FROM ${_TBL} WHERE name = '${_NAME}' LIMIT 1")
    [ "${_CUR}" = "${_VAL}" ] && continue
    if [ "${_DRY_RUN}" = "YES" ]; then
      echo "DRY:  mysql --defaults-file=/root/.my.cnf -N -B ${_DB} -e \"UPDATE ${_TBL} SET val = '${_VAL}' WHERE name = '${_NAME}'\""
      _N=$((_N + 1))
      continue
    fi
    if _txp_sql "${_DB}" "UPDATE ${_TBL} SET val = '${_VAL}' WHERE name = '${_NAME}'"; then
      _N=$((_N + 1))
    else
      _alrt "    ${_TBL}.${_NAME} could not be updated in ${_DB}"
    fi
  done

  if [ "${_N}" -gt 0 ]; then
    _info "    txp_prefs: ${_N} row(s) re-pointed in ${_DB}"
    _URI_SURFACES_CHANGED=YES
  fi
  if [ -n "${_CREATED}" ]; then
    _info "    txp_prefs rows absent, recreated with core metadata in ${_DB}:${_CREATED}"
    _URI_SURFACES_CHANGED=YES
  fi
  if [ -n "${_MISSING}" ]; then
    _alrt "    txp_prefs rows in ${_DB} could be neither updated nor created:${_MISSING}"
    _alrt "    Textpattern recreates those from defaults on the next admin login and siteurl then defaults to the ADMIN host — set them in the Preferences panel"
  fi
  return 0
}

_assert_site_dirs_converged() {
  # Fail closed BEFORE the queue runs. §7 turns any unclaimed sites/<dir>
  # into a new site node, so one stranded old-hostname dir is one duplicate
  # site — and the duplicate is the half that owns the data. Refusing here
  # costs a re-run; importing costs a manual panel repair.
  local _STRAY _p
  # NEW-contains-OLD regime (example.com -> srv.example.com): every correctly
  # renamed dir still matches the *OLD* substring find, so drop the ones that
  # already carry NEW -- the same guard the mover itself applies.
  _STRAY=$(_find_old_host_site_dirs | while read -r _p; do
    _renamed_already "$(basename "${_p}")" || printf '%s\n' "${_p}"
  done | sort)
  [ -z "${_STRAY}" ] && return 0

  if [ "${_DRY_RUN}" = "YES" ]; then
    _alrt "(dry-run) site dirs still carrying ${_OLD_HOST} — the live run moves these first:"
    echo "${_STRAY}" | sed 's/^/      /'
    return 0
  fi

  _alrt "Site dirs still carrying ${_OLD_HOST} after the rename:"
  echo "${_STRAY}" | sed 's/^/      /'
  _die "Refusing to run the Aegir task queue: §7 would import the above as brand-new sites, giving every one of them a duplicate panel node. Resolve the dirs above, then re-run."
}

###-------------§2d PER-SITE PHP PINS----###

_rewrite_fpm_pin_control() {
  # static/control/multi-fpm.info holds one "<site uri> <php version>" row per
  # PINNED site and is the only record of that pin: manage_ltd_users.sh
  # regenerates the post.d/fpm_include_site_*.inc files FROM it and never the
  # reverse. The rows key on the site URI, so a host-derived site's pin goes
  # INERT the moment the box is renamed — the row names a site that no longer
  # exists, no include is emitted, and the site silently falls back to the
  # account's default PHP version. Nothing breaks loudly; the site just starts
  # running on the wrong interpreter, which for a D7 site pinned to 7.4 is not
  # a cosmetic difference.
  #
  # xmass forces this file onto a migration target verbatim, on the stated
  # assumption that site URIs are "unchanged by migration". That holds for a
  # plain migration and fails for exactly the case §2c exists for.
  #
  # .prev-multi-fpm.info is deliberately NOT touched: it is the diff baseline,
  # so leaving it stale is what makes the next manage_ltd_users pass see a
  # change, wipe every fpm_include_site_* (the stale old-hostname ones
  # included) and regenerate the lot correctly.
  local _CTL="${_AEGIR_ROOT}/static/control/multi-fpm.info"
  local _OWN _MODE
  [ -f "${_CTL}" ] || return 0
  _file_needs_rename "${_CTL}" || return 0
  _info "§2d Rewriting per-site PHP pins in static/control/multi-fpm.info ..."
  _OWN=$(stat -c '%U:%G' "${_CTL}" 2>/dev/null)
  _MODE=$(stat -c '%a' "${_CTL}" 2>/dev/null)
  _maybe_run sed -i "${_SED_RENAME_GUARD}s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_CTL}"\'
  [ -n "${_OWN}" ] && _maybe_run chown \'"${_OWN}"\' \'"${_CTL}"\'
  [ -n "${_MODE}" ] && _maybe_run chmod "${_MODE}" \'"${_CTL}"\'
  return 0
}

###-------------§3 REWRITE DRUSH FILES---###

_rewrite_drush_files() {
  _info "§3 Rewriting Drush alias files in ${_DRUSH_DIR} ..."

  for _F in $(find "${_DRUSH_DIR}" -maxdepth 1 -type f -name '*.drushrc.php' | sort); do
    if _file_needs_rename "${_F}"; then
      _info "  sed in-place: ${_F}"
      _maybe_run sed -i "${_SED_RENAME_GUARD}s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_F}"\'
    fi
  done
  _rewrite_site_yml_files
}

# The yml aliases Drush 9+ reads are converted copies of the drushrc aliases
# (site:alias-convert into <root>/.drush/sites, and for an Octopus account
# the limited-shell user's copy in /home/<acct>.ftp/.drush/sites). The
# converter re-runs only when a site alias changes, so after a rename the
# copies kept the old name -- master_url above all -- for as long as no site
# alias moved. Rewritten in place, ownership kept. A copy Drush still manages
# (its checksum matches the old bytes) gets the checksum of the new bytes, so
# the next conversion keeps managing it instead of treating it as hand-edited.
_rewrite_site_yml_files() {
  local _store _F _OWN _MODE _SUM _OLD_SUM _NEW_SUM
  for _store in "${_DRUSH_DIR}/sites" "/home/${_AEGIR_USER}.ftp/.drush/sites"; do
    [ -d "${_store}" ] || continue
    for _F in "${_store}"/*.site.yml; do
      [ -f "${_F}" ] && [ ! -L "${_F}" ] || continue
      _file_needs_rename "${_F}" || continue
      _info "  sed in-place: ${_F}"
      _SUM="${_store}/.checksums/$(basename "${_F}" .yml).md5"
      _OLD_SUM=$(md5sum < "${_F}" | cut -c1-32)
      _OWN=$(stat -c '%u:%g' "${_F}")
      _MODE=$(stat -c '%a' "${_F}")
      _maybe_run sed -i "${_SED_RENAME_GUARD}s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_F}"\'
      [ "${_DRY_RUN}" = "YES" ] && continue
      chown "${_OWN}" "${_F}"
      chmod "${_MODE}" "${_F}"
      if [ -f "${_SUM}" ] && [ ! -L "${_SUM}" ] \
        && grep -q "${_OLD_SUM}" "${_SUM}" 2>/dev/null; then
        _NEW_SUM=$(md5sum < "${_F}" | cut -c1-32)
        _OWN=$(stat -c '%u:%g' "${_SUM}")
        _MODE=$(stat -c '%a' "${_SUM}")
        sed -i "s/${_OLD_SUM}/${_NEW_SUM}/" "${_SUM}"
        chown "${_OWN}" "${_SUM}"
        chmod "${_MODE}" "${_SUM}"
      fi
    done
  done
}

###-------------§4 RENAME + REWRITE VHOSTS-###

_rewrite_vhosts() {
  if [ ! -d "${_VHOSTD}" ]; then
    _alrt "vhost.d dir not found: ${_VHOSTD} — skipping vhost step"
    return
  fi

  _info "§4 Rewriting vhost files in ${_VHOSTD} ..."

  for _F in $(find "${_VHOSTD}" -maxdepth 1 -type f | sort); do
    _BASENAME=$(basename "${_F}")

    # Rewrite content regardless of filename
    if _file_needs_rename "${_F}"; then
      _info "  sed in-place content: ${_F}"
      _maybe_run sed -i "${_SED_RENAME_GUARD}s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_F}"\'
    fi

    # Rename the file if old hostname appears in the filename — unless the
    # name already carries NEW (NEW-contains-OLD re-run would double it)
    if [[ "${_BASENAME}" == *"${_OLD_HOST}"* ]] \
      && ! _renamed_already "${_BASENAME}"; then
      _NEW_BASENAME="${_BASENAME//${_OLD_HOST}/${_NEW_HOST}}"
      _NEW_F="${_VHOSTD}/${_NEW_BASENAME}"
      _info "  rename: ${_BASENAME} -> ${_NEW_BASENAME}"
      _maybe_run mv -f \'"${_F}"\' \'"${_NEW_F}"\'
    fi
  done

  # The panel's SSL proxy include lives under the MASTER root's pre.d, keyed
  # on the panel's old name. The account pass regenerates it for the new name
  # once the new-name certificate exists, but nothing removed the old one: it
  # kept naming a certificate under the old-name LE dir, and once that tree
  # went (a purge, an LE cleanup) nginx failed its configtest box-wide. Park
  # it with the other backups; never rewrite it in place, the new-name
  # certificate is not there yet.
  local _PRX _PRX_ACCT
  case "${_AEGIR_ROOT}" in
    /data/disk/*)
      for _PRX_ACCT in "${_AEGIR_USER}" "${_OLD_ACCT}"; do
        [ -n "${_PRX_ACCT}" ] || continue
        _PRX="/var/aegir/config/server_master/nginx/pre.d/z_${_PRX_ACCT}.${_OLD_HOST}_ssl_proxy.conf"
        [ -e "${_PRX}" ] || continue
        _info "  park old-name panel SSL proxy include: $(basename "${_PRX}") -> ${_BACKUP_DIR}/"
        _maybe_run mkdir -p \'"${_BACKUP_DIR}"\'
        _maybe_run mv -f \'"${_PRX}"\' \'"${_BACKUP_DIR}/"\'
      done
    ;;
  esac
}

###-------------§4b OCTOPUS CONTROL CNF--###

_rewrite_octopus_cnf() {
  # Octopus roots only: /root/.<oN>.octopus.cnf (_DOMAIN etc.) feeds the
  # install/config legs and must follow the rename. NB: the satellite
  # UPGRADE re-reads its _DOMAIN from <root>/log/domain.txt, not from this
  # cnf — that stamp is handled in §4b2. The master root has no octopus
  # cnf. Idempotent: no-op when the old FQDN is absent (migration targets
  # get a correct cnf from their fresh install).
  [[ "${_AEGIR_ROOT}" == /data/disk/* ]] || return 0
  local _OCT_CNF="/root/.${_AEGIR_USER}.octopus.cnf"
  [ -e "${_OCT_CNF}" ] || return 0
  if _file_needs_rename "${_OCT_CNF}"; then
    _info "Rewriting ${_OCT_CNF} (_DOMAIN etc.) ..."
    _maybe_run sed -i "${_SED_RENAME_GUARD}s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_OCT_CNF}"\'
  fi
}

###-------------§4b2 LOG IDENTITY STAMPS-###

_rewrite_log_stamps() {
  # Octopus roots only: <root>/log carries per-instance identity stamps.
  # domain.txt is what the satellite upgrade reads back as _DOMAIN (NOT the
  # octopus cnf) — left stale, the upgrader probes the previous install
  # under the OLD name, declares the healthy renamed platform a zombie and
  # moves it to backups/system before a rebuild that cannot bootstrap, and
  # each run re-stamps the stale value so it never self-heals. setupmail.txt
  # is the rendered welcome mail kept as the on-disk credentials copy the
  # operator is pointed at (the upgrade resend reads only upgrademail.txt,
  # never this file). Run logs and dated files in log/ are history and
  # stay untouched.
  [[ "${_AEGIR_ROOT}" == /data/disk/* ]] || return 0
  local _F _OWN _MODE _NEEDS
  for _F in "${_AEGIR_ROOT}/log/domain.txt" "${_AEGIR_ROOT}/log/setupmail.txt"; do
    [ -f "${_F}" ] || continue
    _NEEDS=NO
    if _file_needs_rename "${_F}"; then
      _NEEDS=YES
    fi
    # Account axis: the stamps carry the panel FRONT "<acct>.<fqdn>" AND
    # the credential lines' "<acct>.ftp" login form, so a --new-account
    # run must rename both or the next satellite upgrade probes a front
    # that does not exist on this box — the same zombie class on the
    # account axis — while the credential lines keep naming the retired
    # account. Checked against BOTH hostnames and the .ftp form so the
    # equal-hostname account-move corner (where the host-axis gate
    # no-ops) still qualifies the file, even if the panel-URL wording
    # ever changes.
    if [ "${_ACCT_AXIS}" = "YES" ] \
      && grep -Eq "${_OLD_ACCT}\.(${_OLD_HOST}|${_NEW_HOST}|ftp\b)" "${_F}" 2>/dev/null; then
      _NEEDS=YES
    fi
    [ "${_NEEDS}" = "YES" ] || continue
    _info "Rewriting identity stamp ${_F} ..."
    _OWN=$(stat -c '%u:%g' "${_F}")
    _MODE=$(stat -c '%a' "${_F}")
    _maybe_run sed -i "${_SED_RENAME_GUARD}s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_F}"\'
    if [ "${_ACCT_AXIS}" = "YES" ]; then
      _maybe_run sed -i "s/${_OLD_ACCT}\.${_NEW_HOST}/${_NEW_ACCT}.${_NEW_HOST}/g" \'"${_F}"\'
      # The credential lines write the account as "<acct>.ftp" (username:
      # / user: / login wording), a form the front-axis sed above never
      # matches — without this the file mixes the old account in
      # credential lines with the new one in URLs.
      _maybe_run sed -i "s/\b${_OLD_ACCT}\.ftp\b/${_NEW_ACCT}.ftp/g" \'"${_F}"\'
    fi
    # A root-side sed -i must never leave a backend-user-owned stamp
    # root:root — restore the captured identity explicitly.
    if [ "${_DRY_RUN}" != "YES" ]; then
      chown "${_OWN}" "${_F}"
      chmod "${_MODE}" "${_F}"
    fi
  done
}

###-------------§4c PLATFORM SITES.PHP---###

_sites_php_candidates() {
  # Registered platforms first: hosting_platform.publish_path is
  # authoritative and depth-independent — operators nest composer platforms
  # arbitrarily under ~/static (and aegir2boa lands them under static/a2b/),
  # where any fixed find depth silently misses them. provision roots the
  # alias store at the real docroot (web|docroot|html on composer trees), so
  # probe each variant. The bounded find still sweeps shallow unregistered
  # trees — their records are inert (no vhost roots a request there), but
  # cleaning them is free. Callers filter with [ -f ], which also follows a
  # symlinked docroot the find would skip.
  {
    local _P _D
    if _sql_table_exists hosting_platform; then
      for _P in $(_sql "SELECT DISTINCT publish_path FROM hosting_platform" 2>/dev/null); do
        # Rename-mode migrations: the imported rows still carry the SOURCE
        # account root until the §5b DB pass re-paths them — remap so they
        # resolve on the landed tree.
        if [ "${_ACCT_AXIS}" = "YES" ]; then
          case "${_P}" in
            "/data/disk/${_OLD_ACCT}"/*)
              _P="${_AEGIR_ROOT}${_P#/data/disk/${_OLD_ACCT}}"
            ;;
          esac
        fi
        # Every legitimate platform of this root lives under it; anything
        # else (e.g. a LIVE same-named account on the destination box whose
        # tree the imported rows still point at) must never be probed, let
        # alone written.
        case "${_P}" in
          "${_AEGIR_ROOT}"/*) ;;
          *) continue ;;
        esac
        for _D in "" /web /docroot /html; do
          echo "${_P%/}${_D}/sites/sites.php"
        done
      done
    fi
    find "${_AEGIR_ROOT}" -maxdepth 5 -type f -name sites.php \
      -path '*/sites/sites.php' 2>/dev/null
  } | sort -u
}

_rewrite_sites_php_files() {
  # Rewrite one token pair across every platform sites/sites.php:
  # $1 = old token, $2 = new token, $3 = non-empty when lines already
  # carrying the new token must be left alone (NEW-contains-OLD regime,
  # same guard as §3/§4), $4 = axis label for messages.
  #
  # Provision's alias store maintain() only deletes records whose VALUE
  # equals the site's CURRENT uri, so after a rename every verify re-adds
  # the new record while the old-token record survives forever. Stale
  # sites.php records are the class behind the migrate-rename data-loss
  # near-miss — rewrite them at the file layer, before anything can resolve
  # a hostname through them. Line-level semantics: a token-carrying record
  # whose rewritten twin already exists in the file (resumed run after the
  # verifies added it) is dropped; any other token-carrying line is
  # rewritten in place. The file is include()d by conf_path() on every
  # bootstrap of the platform, so the write is committed only from a
  # fully-written temp — a failed awk/cp must never truncate it.
  local _O="$1" _N="$2" _G="$3" _LBL="$4"
  local _F _BAK _TMP _OWN _MODE
  for _F in $(_sites_php_candidates); do
    [ -f "${_F}" ] || continue
    grep -qF -- "${_O}" "${_F}" 2>/dev/null || continue
    if [ -n "${_G}" ]; then
      grep -F -- "${_O}" "${_F}" 2>/dev/null | grep -qvF -- "${_N}" || continue
    fi
    if [ "${_DRY_RUN}" = "YES" ]; then
      _info "(dry-run) Would rewrite/drop stale ${_LBL} record(s) in ${_F}"
      continue
    fi
    # Global counter: the host-axis and account-axis calls run under _TS
    # stamps that can land in the same second — a per-call index would then
    # overwrite the earlier pass's pre-edit backup of the same file.
    _SITESPHP_N=$((_SITESPHP_N + 1))
    _BAK="${_BACKUP_DIR}/sitesphp_${_TS}_${_SITESPHP_N}_${_F//\//_}"
    _TMP="${_BACKUP_DIR}/sitesphp_${_TS}_${_SITESPHP_N}.tmp"
    if ! cp -a "${_F}" "${_BAK}"; then
      _alrt "backup copy failed for ${_F} — leaving it untouched"
      rm -f "${_BAK}"
      continue
    fi
    _OWN=$(stat -c '%u:%g' "${_F}")
    _MODE=$(stat -c '%a' "${_F}")
    # Tokens are used as awk regexes with loose dots — same laxity as the
    # sed sweeps above; the §1/§2 charset guard keeps hostnames
    # metachar-free, and the account-axis token adds only quotes/=/> (all
    # literal in ERE).
    if ! awk -v o="${_O}" -v n="${_N}" -v g="${_G}" '
      NR == FNR { seen[$0] = 1; next }
      index($0, o) && !(g && index($0, n)) {
        t = $0
        gsub(o, n, t)
        if (t in seen) next
        $0 = t
      }
      { print }
    ' "${_F}" "${_F}" > "${_TMP}" || [ ! -s "${_TMP}" ]; then
      _alrt "sites.php rewrite failed for ${_F} — left untouched"
      rm -f "${_TMP}" "${_BAK}"
      continue
    fi
    _info "  sites.php records (${_LBL}): ${_F}"
    # cat-over keeps the inode, but a root-side edit must never be able to
    # leave a backend-user-owned file root:root — restore the captured
    # identity explicitly.
    if ! cat "${_TMP}" > "${_F}"; then
      cat "${_BAK}" > "${_F}" \
        || _die "write-back AND restore failed for ${_F} — pre-edit copy kept at ${_BAK}"
      _alrt "write-back failed for ${_F} — pre-edit content restored"
    fi
    rm -f "${_TMP}"
    chown "${_OWN}" "${_F}"
    chmod "${_MODE}" "${_F}"
  done
}

_rewrite_sites_php() {
  # Host axis: every OLD-host occurrence under this root is renamed by the
  # §5 sweeps, so the records rewrite is a free substring pass. Runs right
  # after DB detection (the platform list lives in the Ægir DB) and before
  # any DB mutation.
  _info "§4c Rewriting platform sites.php alias maps ..."
  _rewrite_sites_php_files "${_OLD_HOST}" "${_NEW_HOST}" \
    "${_SED_RENAME_GUARD:+1}" "${_OLD_HOST}"
}

###-------------§5 DATABASE RENAME-------###

_detect_aegir_db() {
  # The Aegir hostmaster DB name lives in the hostmaster site's drushrc.php
  # Path is derived from the site_path in hostmaster.alias.drushrc.php
  _HM_SITE_PATH=$(grep "site_path'" \
    "${_DRUSH_DIR}/hostmaster.alias.drushrc.php" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g" \
    | tr -d ' ')

  if [ -z "${_HM_SITE_PATH}" ]; then
    _die "Could not extract site_path from hostmaster.alias.drushrc.php"
  fi

  _HM_DRUSHRC="${_HM_SITE_PATH}/drushrc.php"

  if [ ! -f "${_HM_DRUSHRC}" ]; then
    # Resume/dry-run tolerance: the alias may hold either hostname variant
    # while the on-disk dir holds the other (e.g. dry-run skips the §3
    # rewrite; a resumed run may find the dir already renamed). Try the
    # other variant before giving up.
    _HM_SITE_ALT="${_HM_SITE_PATH//${_NEW_HOST}/${_OLD_HOST}}"
    if [ "${_HM_SITE_ALT}" = "${_HM_SITE_PATH}" ]; then
      _HM_SITE_ALT="${_HM_SITE_PATH//${_OLD_HOST}/${_NEW_HOST}}"
    fi
    if [ -f "${_HM_SITE_ALT}/drushrc.php" ]; then
      _HM_DRUSHRC="${_HM_SITE_ALT}/drushrc.php"
    fi
  fi

  if [ ! -f "${_HM_DRUSHRC}" ]; then
    _die "Hostmaster drushrc.php not found: ${_HM_DRUSHRC}"
  fi

  _AEGIR_DB=$(grep "options\['db_name'\]" "${_HM_DRUSHRC}" \
    | head -1 \
    | sed "s/.*=//; s/[' ,;]//g" \
    | tr -d ' ')
  _AEGIR_DB=${_AEGIR_DB//[^a-zA-Z0-9_]/}

  if [ -z "${_AEGIR_DB}" ]; then
    _die "Could not detect Aegir DB name from ${_HM_DRUSHRC}"
  fi

  # The drushrc the alias points at can be a fresh-install LEFTOVER whose DB
  # no longer exists: on an xmass/xoct target the NEW-host-named panel dir
  # survives by design (§2b guard), but its DB died with the replicated-in
  # datadir — the LIVE hostmaster DB is the one in the OLD-host-named dir's
  # drushrc. Never trust a drushrc whose schema is gone; re-derive from the
  # other hostname variant before giving up. (Pre-B3 §5 silently no-op'd
  # here — the mysqldump failure was swallowed and the DB simply kept the
  # source hostname.)
  if [ -z "$(mysql --defaults-file=/root/.my.cnf -N -B \
      -e "SHOW DATABASES LIKE '${_AEGIR_DB}'" 2>/dev/null)" ]; then
    _alrt "DB '${_AEGIR_DB}' from ${_HM_DRUSHRC} does not exist — trying the other hostname variant"
    _HM_SITE_ALT="${_HM_SITE_PATH//${_NEW_HOST}/${_OLD_HOST}}"
    if [ "${_HM_SITE_ALT}" = "${_HM_SITE_PATH}" ]; then
      _HM_SITE_ALT="${_HM_SITE_PATH//${_OLD_HOST}/${_NEW_HOST}}"
    fi
    _ALT_DB=""
    if [ -f "${_HM_SITE_ALT}/drushrc.php" ]; then
      _ALT_DB=$(grep "options\['db_name'\]" "${_HM_SITE_ALT}/drushrc.php" \
        | head -1 \
        | sed "s/.*=//; s/[' ,;]//g" \
        | tr -d ' ')
      _ALT_DB=${_ALT_DB//[^a-zA-Z0-9_]/}
      if [ -n "${_ALT_DB}" ] \
        && [ -z "$(mysql --defaults-file=/root/.my.cnf -N -B \
            -e "SHOW DATABASES LIKE '${_ALT_DB}'" 2>/dev/null)" ]; then
        _ALT_DB=""
      fi
    fi
    if [ -z "${_ALT_DB}" ]; then
      # No variant drushrc on disk either (migration targets never receive
      # the source's panel platform tree — only the DB replicates in). Probe
      # the live schemas for the hostmaster DB that belongs to THIS aegir
      # root: it is the one that has a server_master context AND whose
      # platform publish paths live under the root. Refuse to guess when
      # zero or several match.
      local _CAND
      for _CAND in $(mysql --defaults-file=/root/.my.cnf -N -B \
          -e "SHOW DATABASES" 2>/dev/null \
        | grep -vE "^(information_schema|performance_schema|mysql|sys)$"); do
        if [ -n "$(mysql --defaults-file=/root/.my.cnf -N -B "${_CAND}" \
            -e "SELECT name FROM hosting_context WHERE name='server_master' LIMIT 1" 2>/dev/null)" ] \
          && [ -n "$(mysql --defaults-file=/root/.my.cnf -N -B "${_CAND}" \
            -e "SELECT publish_path FROM hosting_platform WHERE publish_path LIKE '${_AEGIR_ROOT}/%' LIMIT 1" 2>/dev/null)" ]; then
          if [ -n "${_ALT_DB}" ]; then
            _die "Multiple live hostmaster DBs match ${_AEGIR_ROOT} (${_ALT_DB}, ${_CAND}) — refusing to guess"
          fi
          _ALT_DB="${_CAND}"
        fi
      done
      [ -n "${_ALT_DB}" ] \
        && _info "Live hostmaster DB for ${_AEGIR_ROOT} found by schema probe: ${_ALT_DB}"
    fi
    if [ -n "${_ALT_DB}" ]; then
      _AEGIR_DB="${_ALT_DB}"
    else
      _die "Neither '${_AEGIR_DB}' nor any live hostmaster DB for ${_AEGIR_ROOT} found — cannot locate the live Aegir DB"
    fi
  fi

  _info "Detected Aegir database: ${_AEGIR_DB}"
}

_sql() {
  # Batch/silent query against the Aegir DB; -N drops headers so callers can
  # capture single values.
  mysql --defaults-file=/root/.my.cnf -N -B "${_AEGIR_DB}" -e "$1"
}

_sql_table_exists() {
  # Hostmaster on Backdrop lacks some D7 tables (e.g. variable), so every §5
  # step is existence-gated: one schema must never break the other.
  [ -n "$(_sql "SHOW TABLES LIKE '$1'")" ]
}

_sql_replace_col() {
  # REPLACE() sweep over one plain-varchar column. Never point this at
  # serialized/blob storage — that is what the variable pass below is for.
  # When NEW contains OLD (a subdomain-augmenting rename), a REPLACE applied
  # to an already-renamed value doubles it (sub.example.com ->
  # sub.sub.example.com — the nid-keyed identity rows and any forced re-run
  # would hit this), so such rows are skipped; single-domain columns never
  # legitimately hold both values.
  local _T="$1" _C="$2" _N _G=""
  _sql_table_exists "${_T}" || return 0
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _G=" AND ${_C} NOT LIKE '%${_NEW_HOST}%'" ;;
  esac
  _N=$(_sql "SELECT COUNT(*) FROM ${_T} WHERE ${_C} LIKE '%${_OLD_HOST}%'${_G}")
  if [ "${_N:-0}" -gt 0 ]; then
    _sql "UPDATE ${_T} SET ${_C} = REPLACE(${_C}, '${_OLD_HOST}', '${_NEW_HOST}') WHERE ${_C} LIKE '%${_OLD_HOST}%'${_G}"
    _info "  ${_T}.${_C}: ${_N} row(s) renamed"
  fi
}

_repair_serialized_variables() {
  # D7 stores every variable PHP-serialized in a blob column. A text-level
  # replacement either corrupts the declared s:N:"..." byte lengths (value
  # silently unserializes to FALSE) or, in a --hex-blob dump, never reaches
  # the value at all. unserialize -> str_replace -> variable_set() instead:
  # correct lengths by construction and the variable cache stays coherent.
  _sql_table_exists variable || {
    _info "  variable table absent (Backdrop hostmaster?) — serialized pass skipped"
    return 0
  }

  local _CNT _PHP _VOUT
  _CNT=$(_sql "SELECT COUNT(*) FROM variable WHERE value LIKE '%${_OLD_HOST}%'")
  if [ "${_CNT:-0}" -eq 0 ]; then
    _info "  variable table: no values reference ${_OLD_HOST}"
    return 0
  fi

  _info "  Repairing ${_CNT} serialized variable value(s) via php/mysqli ..."
  _PHP="${_BACKUP_DIR}/varfix_${_TS}.php"
  _VOUT="${_BACKUP_DIR}/varfix_${_TS}.log"
  {
    printf '<?php\n$old = '\''%s'\'';\n$new = '\''%s'\'';\n' "${_OLD_HOST}" "${_NEW_HOST}"
    cat <<'PHPEOF'
// When $new contains $old (subdomain-augmenting rename), re-applying the
// replace to an already-renamed string would double it — skip strings
// already carrying $new in that case (mirrors the SQL sweep guard).
function rah_replace($v, $old, $new, &$hadobj, $guard) {
  if (is_string($v)) {
    if ($guard && strpos($v, $new) !== FALSE) {
      return $v;
    }
    return str_replace($old, $new, $v);
  }
  if (is_array($v)) {
    $out = array();
    foreach ($v as $k => $item) {
      if (is_string($k) && !($guard && strpos($k, $new) !== FALSE)) {
        $k = str_replace($old, $new, $k);
      }
      $out[$k] = rah_replace($item, $old, $new, $hadobj, $guard);
    }
    return $out;
  }
  if (is_object($v)) {
    // Leave objects untouched: re-building an arbitrary (possibly
    // incomplete) class instance is riskier than a reported residual.
    $hadobj = TRUE;
    return $v;
  }
  return $v;
}
// Bootstrap-free DB access: `drush @hostmaster php-script` needs a working
// hostmaster bootstrap, which an xmass target does not have at §5 time (its
// panel settings still point at the pre-restore DB) — the pass then
// silently no-ops and panel-FQDN variables survive the rename. Talk to the
// live DB directly instead, over the same credentials the rest of §5 uses.
$h = getenv('RAH_DB_HOST'); if ($h === FALSE || $h === '') { $h = 'localhost'; }
$prt = getenv('RAH_DB_PORT'); if ($prt === FALSE || $prt === '') { $prt = '3306'; }
$conn = @mysqli_connect($h, getenv('RAH_DB_USER'), getenv('RAH_DB_PASS'),
  getenv('RAH_DB_NAME'), (int) $prt);
if (!$conn) {
  print "RAH-ERROR: cannot connect to database '" . getenv('RAH_DB_NAME') . "'\n";
  exit(1);
}
$guard = (strpos($new, $old) !== FALSE);
$fixed = 0;
$objrows = array();
$broken = array();
$esc = mysqli_real_escape_string($conn, $old);
$res = mysqli_query($conn,
  "SELECT name, value FROM variable WHERE value LIKE '%" . $esc . "%'");
if (!$res) {
  print "RAH-ERROR: variable query failed\n";
  exit(1);
}
$stmt = mysqli_prepare($conn, "UPDATE variable SET value = ? WHERE name = ?");
if (!$stmt) {
  print "RAH-ERROR: update prepare failed\n";
  exit(1);
}
while ($row = mysqli_fetch_assoc($res)) {
  $name = $row['name'];
  $raw = $row['value'];
  $val = @unserialize($raw);
  if ($val === FALSE && $raw !== serialize(FALSE)) {
    $broken[] = $name;
    continue;
  }
  $hadobj = FALSE;
  $new_val = rah_replace($val, $old, $new, $hadobj, $guard);
  if ($hadobj) {
    $objrows[] = $name;
  }
  // Count and write only real changes: in a NEW-contains-OLD rename every
  // NEW-carrying value matches the %OLD% candidate query forever, and an
  // unconditional write would report converged rows as "fixed" on every
  // re-run.
  $new_raw = serialize($new_val);
  if ($new_raw !== $raw) {
    mysqli_stmt_bind_param($stmt, 'ss', $new_raw, $name);
    if (!mysqli_stmt_execute($stmt)) {
      print "RAH-ERROR: update failed for " . $name . "\n";
      exit(1);
    }
    $fixed++;
  }
}
if ($fixed > 0) {
  // variable_set() would have invalidated the bootstrap variables cache;
  // replicate that without a bootstrap (gated: cache layouts vary).
  $ct = mysqli_query($conn, "SHOW TABLES LIKE 'cache_bootstrap'");
  if ($ct && mysqli_num_rows($ct) > 0) {
    mysqli_query($conn, "DELETE FROM cache_bootstrap WHERE cid = 'variables'");
  }
}
print "RAH: variables re-serialized: " . $fixed . "\n";
if (count($objrows)) {
  print "RAH: object values left untouched in: " . implode(', ', $objrows) . "\n";
}
if (count($broken)) {
  print "RAH: unserialize already failing (left as-is): " . implode(', ', $broken) . "\n";
}
print "RAH-DONE\n";
PHPEOF
  } > "${_PHP}"
  chmod 644 "${_PHP}"

  local _MY_U _MY_W
  _MY_U=$(grep -m1 "^user" /root/.my.cnf 2>/dev/null | cut -d= -f2- | tr -d " \"'")
  _MY_W=$(grep -m1 "^password" /root/.my.cnf 2>/dev/null | cut -d= -f2- | tr -d " \"'")
  if RAH_DB_HOST="localhost" RAH_DB_PORT="3306" \
    RAH_DB_USER="${_MY_U:-root}" RAH_DB_PASS="${_MY_W}" \
    RAH_DB_NAME="${_AEGIR_DB}" \
    php "${_PHP}" > "${_VOUT}" 2>&1 \
    && grep -q '^RAH-DONE' "${_VOUT}"; then
    grep '^RAH: ' "${_VOUT}" | sed 's/^RAH: /  /'
    rm -f "${_PHP}" "${_VOUT}"
  else
    _alrt "serialized variable repair did not confirm — last 15 lines:"
    tail -n 15 "${_VOUT}"
    _alrt "full output kept: ${_VOUT}; script kept: ${_PHP}"
  fi
  return 0
}

_rename_in_database() {
  _info "§5 Renaming hostname in Aegir database (${_AEGIR_DB}) ..."

  _TS=$(date +%Y%m%d_%H%M%S)
  _DUMP_ORIG="${_BACKUP_DIR}/aegirdb_${_TS}_orig.sql"

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would dump ${_AEGIR_DB} to ${_DUMP_ORIG} (backup only)"
    _info "(dry-run) Would run serialize-safe UPDATEs: '${_OLD_HOST}' -> '${_NEW_HOST}'"
    _info "(dry-run) Would repair serialized variable values via php/mysqli"
    return
  fi

  mkdir -p "${_BACKUP_DIR}"
  # Nothing here is secret from the account user — the dumps are the
  # account's own hostmaster DB.
  chmod 755 "${_BACKUP_DIR}"

  # Backup only — never sed-patched, never re-imported
  _info "  Dumping ${_AEGIR_DB} (pre-rename backup) ..."
  mysqldump \
    --defaults-file=/root/.my.cnf \
    --single-transaction \
    --quick \
    --no-autocommit \
    --skip-add-locks \
    --no-tablespaces \
    --hex-blob \
    "${_AEGIR_DB}" \
    > "${_DUMP_ORIG}"

  _RAH_DUMP_RC=$?
  ### This is the ONLY copy of the Ægir database before a run of in-place
  ### UPDATEs rewrites identity rows across it. `-s` alone accepts a dump
  ### that died a byte in, so demand the dumper's own exit status and its
  ### closing marker too.
  if [ "${_RAH_DUMP_RC}" -ne "0" ] \
    || [ ! -s "${_DUMP_ORIG}" ] \
    || ! tail -5 "${_DUMP_ORIG}" 2>/dev/null | grep -q "Dump completed"; then
    _die "pre-rename backup of ${_AEGIR_DB} is missing, truncated or failed (rc=${_RAH_DUMP_RC}) -- refusing to rewrite the database without a complete backup: ${_DUMP_ORIG}"
  fi

  _info "  Backup size: $(du -sh "${_DUMP_ORIG}" | cut -f1), kept in ${_BACKUP_DIR}"

  # Identity rows first, keyed by hosting_context nid (aegir2boa-stage2
  # pattern): server verifies regenerate remote_host FROM the server node
  # title, so it must become the new FQDN even when the stored title is not
  # the exact string the sweeps below key on (e.g. a short nodename).
  local _SRV_NID _HM_NID
  _SRV_NID=$(_sql "SELECT nid FROM hosting_context WHERE name = 'server_master'")
  _HM_NID=$(_sql "SELECT nid FROM hosting_context WHERE name = 'hostmaster'")
  _SRV_NID=${_SRV_NID//[^0-9]/}
  _HM_NID=${_HM_NID//[^0-9]/}
  if [ -z "${_SRV_NID}" ] || [ -z "${_HM_NID}" ]; then
    _die "hosting_context misses server_master/hostmaster — ${_AEGIR_DB} is not an Aegir hostmaster DB?"
  fi
  # The hostmaster REPLACE carries the same already-renamed guard as
  # _sql_replace_col: on a forced re-run with NEW containing OLD it would
  # otherwise double the title. The server_master SET is idempotent as-is.
  local _HMG=""
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _HMG=" AND title NOT LIKE '%${_NEW_HOST}%'" ;;
  esac
  _sql "UPDATE node SET title = '${_NEW_HOST}' WHERE nid = ${_SRV_NID}"
  _sql "UPDATE node_revision SET title = '${_NEW_HOST}' WHERE nid = ${_SRV_NID}"
  _sql "UPDATE node SET title = REPLACE(title, '${_OLD_HOST}', '${_NEW_HOST}') WHERE nid = ${_HM_NID}${_HMG}"
  _sql "UPDATE node_revision SET title = REPLACE(title, '${_OLD_HOST}', '${_NEW_HOST}') WHERE nid = ${_HM_NID}${_HMG}"
  # The panel's frontend record must name the DB the panel actually lives
  # in: xoct imports the panel dump into the TARGET-named DB, so the
  # imported hosting_site row still carries the SOURCE-derived name — a
  # frontend-driven panel verify would then push the dead name back into
  # the backend context. Tautological (no-op) everywhere else.
  if _sql_table_exists hosting_site; then
    _sql "UPDATE hosting_site SET db_name = '${_AEGIR_DB}' WHERE nid = ${_HM_NID}"
  fi
  _info "  Identity rows updated (server_master nid ${_SRV_NID}, hostmaster nid ${_HM_NID})"

  # Plain-varchar sweeps: REPLACE() cannot corrupt these columns, and they
  # cover panel contexts plus sites/aliases living on subdomains of the
  # renamed FQDN — the same scope the old blanket sed renamed here.
  _sql_replace_col hosting_context name
  _sql_replace_col node title
  _sql_replace_col node_revision title
  _sql_replace_col hosting_platform publish_path
  _sql_replace_col hosting_site_alias alias
  _sql_replace_col hosting_site_alias redirection
  _sql_replace_col users mail
  _sql_replace_col users init

  _repair_serialized_variables

  # Drop the caches wholesale: cache blobs carried over from the old
  # hostname keep it inside serialized (often hex-dumped) values that no
  # safe rewrite should chase — everything in them regenerates.
  _run_as_aegir "drush8 @hostmaster cc all" > /dev/null 2>&1 \
    || _alrt "drush cc all returned non-zero after the DB rename"

  # Honest residual report — task history keeps old-host rows by design.
  # Same already-renamed guard as the sweeps, so a NEW-contains-OLD rename
  # does not count every renamed value as residual forever.
  local _RES_VAR="n/a" _RES_TASKS="n/a" _RG=""
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _RG=" AND value NOT LIKE '%${_NEW_HOST}%'" ;;
  esac
  if _sql_table_exists variable; then
    _RES_VAR=$(_sql "SELECT COUNT(*) FROM variable WHERE value LIKE '%${_OLD_HOST}%'${_RG}")
  fi
  if _sql_table_exists hosting_task_arguments; then
    _RES_TASKS=$(_sql "SELECT COUNT(*) FROM hosting_task_arguments WHERE value LIKE '%${_OLD_HOST}%'${_RG}")
  fi
  _info "  Residual '${_OLD_HOST}' refs: variable=${_RES_VAR} task-history=${_RES_TASKS}"

  _info "  DB rename complete. Pre-rename backup kept in ${_BACKUP_DIR}"
}

###-------------§5b ACCOUNT AXIS---------###

# Rename-mode migrations (xoct import <src> ... <dst>) land the source
# account's data under /data/disk/<dst>, but the imported hostmaster DB and
# panel identity still say <src>: publish paths point at a tree that does
# not exist and the panel is named after the source account, so the first
# DB-driven regeneration re-stamps the stale values over the transfer-time
# fixes. These passes move the ACCOUNT axis: panel identity to
# <new>.<NEWFQDN> and /data/disk/<old> paths to /data/disk/<new> — and
# nothing else. Customer-site URIs (including sites living on the account
# subdomain, e.g. shop.<old>.<FQDN>) are deliberately untouched: a site's
# name belongs to the site, so front-label rewrites are exact-match or
# '/'-anchored only, never a free substring sweep. Both passes converge on
# re-runs (trailing-slash path anchors; already-renamed guards).

_rename_account_on_disk() {
  [ "${_ACCT_AXIS}" = "YES" ] || return 0
  _OLD_FRONT="${_OLD_ACCT}.${_NEW_HOST}"
  _NEW_FRONT="${_NEW_ACCT}.${_NEW_HOST}"
  _info "§5b Renaming account axis on disk: ${_OLD_ACCT} -> ${_NEW_ACCT} (panel ${_OLD_FRONT} -> ${_NEW_FRONT}) ..."

  local _ACCT_SED_GUARD=""
  case "${_NEW_FRONT}" in
    *"${_OLD_FRONT}"*) _ACCT_SED_GUARD="/${_NEW_FRONT}/!" ;;
  esac

  # Panel site dir: the fresh install already created sites/<new front>
  # with valid credentials for the DB the import landed in — the panel must
  # adopt it. Park the imported <old front> dir instead of leaving it in
  # place: §7's queue imports orphan dirs under a platform as brand-new
  # sites. Without a fresh dir (no-fresh-install edge) rename instead.
  local _D _SITES _NEWD
  for _D in $(find "${_AEGIR_ROOT}" -maxdepth 5 -type d -path '*/sites/*' -name "${_OLD_FRONT}" 2>/dev/null | sort); do
    _SITES=$(dirname "${_D}")
    _NEWD="${_SITES}/${_NEW_FRONT}"
    if [ -d "${_NEWD}" ]; then
      _info "  parking imported panel dir ${_D} (fresh ${_NEW_FRONT} adopted)"
      [ "${_DRY_RUN}" = "YES" ] || mkdir -p "${_BACKUP_DIR}"
      _maybe_run mv -f \'"${_D}"\' \'"${_BACKUP_DIR}/parked_${_TS}_${_OLD_FRONT}"\'
    else
      _alrt "no fresh ${_NEW_FRONT} dir next to ${_D} — renaming the imported dir instead"
      _maybe_run mv -f \'"${_D}"\' \'"${_NEWD}"\'
    fi
  done

  # Hostmaster aliases (panel-own files ONLY — per-site alias files keep
  # their URIs): front label plus the path pair.
  local _F
  for _F in "${_DRUSH_DIR}/hostmaster.alias.drushrc.php" "${_DRUSH_DIR}/hm.alias.drushrc.php"; do
    [ -f "${_F}" ] || continue
    if grep -q "${_OLD_FRONT}\|/data/disk/${_OLD_ACCT}/" "${_F}" 2>/dev/null; then
      _info "  sed in-place: ${_F}"
      _maybe_run sed -i \
        -e "\"${_ACCT_SED_GUARD}s/${_OLD_FRONT}/${_NEW_FRONT}/g\"" \
        -e "\"s#/data/disk/${_OLD_ACCT}/#/data/disk/${_NEW_ACCT}/#g\"" \
        \'"${_F}"\'
    fi
  done

  # All .drush files: path pair + home/socket tokens only (URI-safe).
  for _F in $(find "${_DRUSH_DIR}" -maxdepth 1 -type f -name '*.drushrc.php' 2>/dev/null | sort); do
    if grep -q "/data/disk/${_OLD_ACCT}/\|/home/${_OLD_ACCT}\.ftp" "${_F}" 2>/dev/null; then
      _info "  sed in-place: ${_F}"
      _maybe_run sed -i \
        -e "\"s#/data/disk/${_OLD_ACCT}/#/data/disk/${_NEW_ACCT}/#g\"" \
        -e "\"s#/home/${_OLD_ACCT}\.ftp#/home/${_NEW_ACCT}.ftp#g\"" \
        \'"${_F}"\'
    fi
  done

  # Vhosts: every file gets the URI-safe pairs (paths, ftp home, fpm socket
  # tokens); ONLY the panel's own vhost files (exact <old front> basename,
  # incl. disabled/ssl-prefixed forms) get the front label + a rename. A
  # customer vhost like shop.<old front> keeps its server_name.
  if [ -d "${_VHOSTD}" ]; then
    local _BASE _NEWB
    for _F in $(find "${_VHOSTD}" -maxdepth 1 -type f 2>/dev/null | sort); do
      _BASE=$(basename "${_F}")
      if grep -q "/data/disk/${_OLD_ACCT}/\|/home/${_OLD_ACCT}\.ftp\|user_socket \"${_OLD_ACCT}[.\"]" "${_F}" 2>/dev/null; then
        _info "  sed in-place content: ${_F}"
        _maybe_run sed -i \
          -e "\"s#/data/disk/${_OLD_ACCT}/#/data/disk/${_NEW_ACCT}/#g\"" \
          -e "\"s#/home/${_OLD_ACCT}\.ftp#/home/${_NEW_ACCT}.ftp#g\"" \
          -e "\"s#user_socket \\\"${_OLD_ACCT}\.#user_socket \\\"${_NEW_ACCT}.#g\"" \
          -e "\"s#user_socket \\\"${_OLD_ACCT}\\\"#user_socket \\\"${_NEW_ACCT}\\\"#g\"" \
          \'"${_F}"\'
      fi
      # Exact-label matching is the re-run convergence here: after the
      # first pass the panel vhost is NEW-front-named and matches none of
      # these labels, so a repeat run skips it.
      case "${_BASE}" in
        "${_OLD_FRONT}"|".${_OLD_FRONT}"|"https.${_OLD_FRONT}")
          _NEWB="${_BASE/${_OLD_FRONT}/${_NEW_FRONT}}"
          if [ -e "${_VHOSTD}/${_NEWB}" ]; then
            _info "  parking panel vhost ${_BASE} (fresh ${_NEWB} present)"
            [ "${_DRY_RUN}" = "YES" ] || mkdir -p "${_BACKUP_DIR}"
            _maybe_run mv -f \'"${_F}"\' \'"${_BACKUP_DIR}/parked_${_TS}_vhost_${_BASE}"\'
          else
            _info "  sed + rename panel vhost: ${_BASE} -> ${_NEWB}"
            _maybe_run sed -i "\"${_ACCT_SED_GUARD}s/${_OLD_FRONT}/${_NEW_FRONT}/g\"" \'"${_F}"\'
            _maybe_run mv -f \'"${_F}"\' \'"${_VHOSTD}/${_NEWB}"\'
          fi
        ;;
      esac
    done
  fi

  # Panel record in the platform alias maps: the same maintain() asymmetry
  # §4c covers on the host axis applies to the account front — verifies add
  # the <new front> record but never remove the imported one (dormant while
  # the old-front dir stays parked, re-armed if such a dir ever reappears).
  # EXACT full-record token only: a free front substring would rewrite
  # tenant records living on the account subdomain (shop.<front>), whose
  # site dirs keep their names by design. The full-record token is
  # prefix-extension-safe (o1 -> o11) without a guard.
  _rewrite_sites_php_files \
    "'www.${_OLD_FRONT}' => '${_OLD_FRONT}'" \
    "'www.${_NEW_FRONT}' => '${_NEW_FRONT}'" \
    "" "${_OLD_FRONT}"
}

_sql_replace_path_col() {
  # /data/disk/<old>/ -> /data/disk/<new>/ over one start-anchored varchar
  # column; the trailing slash makes re-runs convergent even when the new
  # account name extends the old one (o1 -> o11). A value equal to the bare
  # old root converges via the exact-match arm.
  local _T="$1" _C="$2" _N
  _sql_table_exists "${_T}" || return 0
  _N=$(_sql "SELECT COUNT(*) FROM ${_T} WHERE ${_C} LIKE '/data/disk/${_OLD_ACCT}/%' OR ${_C} = '/data/disk/${_OLD_ACCT}'")
  if [ "${_N:-0}" -gt 0 ]; then
    _sql "UPDATE ${_T} SET ${_C} = REPLACE(${_C}, '/data/disk/${_OLD_ACCT}/', '/data/disk/${_NEW_ACCT}/') WHERE ${_C} LIKE '/data/disk/${_OLD_ACCT}/%'"
    _sql "UPDATE ${_T} SET ${_C} = '/data/disk/${_NEW_ACCT}' WHERE ${_C} = '/data/disk/${_OLD_ACCT}'"
    _info "  ${_T}.${_C}: ${_N} row(s) re-pathed"
  fi
}

_rename_account_in_database() {
  [ "${_ACCT_AXIS}" = "YES" ] || return 0
  # Same derivation as the on-disk pass — repeated so neither §5b half
  # depends on the other having run first.
  _OLD_FRONT="${_OLD_ACCT}.${_NEW_HOST}"
  _NEW_FRONT="${_NEW_ACCT}.${_NEW_HOST}"
  _info "§5b Renaming account axis in Aegir database (${_AEGIR_DB}) ..."

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would move panel identity ${_OLD_FRONT} -> ${_NEW_FRONT} (nid-keyed)"
    _info "(dry-run) Would re-path /data/disk/${_OLD_ACCT} -> /data/disk/${_NEW_ACCT} in platform/git/backup/package rows"
    _info "(dry-run) Would repair path/front values in serialized variables via php/mysqli"
    return
  fi

  # Panel identity, nid-keyed (the panel's hosting_context is named
  # 'hostmaster' — account-free — so only the node title carries the front).
  local _HM_NID _FG=""
  _HM_NID=$(_sql "SELECT nid FROM hosting_context WHERE name = 'hostmaster'")
  _HM_NID=${_HM_NID//[^0-9]/}
  if [ -z "${_HM_NID}" ]; then
    _die "hosting_context misses hostmaster — ${_AEGIR_DB} is not an Aegir hostmaster DB?"
  fi
  case "${_NEW_FRONT}" in
    *"${_OLD_FRONT}"*) _FG=" AND title NOT LIKE '%${_NEW_FRONT}%'" ;;
  esac
  _sql "UPDATE node SET title = REPLACE(title, '${_OLD_FRONT}', '${_NEW_FRONT}') WHERE nid = ${_HM_NID}${_FG}"
  _sql "UPDATE node_revision SET title = REPLACE(title, '${_OLD_FRONT}', '${_NEW_FRONT}') WHERE nid = ${_HM_NID}${_FG}"
  _info "  Panel identity rows updated (hostmaster nid ${_HM_NID})"

  # Start-anchored path rows the account owns (task history stays, matching
  # the host axis policy — it shows up in the residual report instead).
  _sql_replace_path_col hosting_platform publish_path
  _sql_replace_path_col hosting_git repo_path
  _sql_replace_path_col hosting_site_backups filename
  _sql_replace_path_col hosting_package_instance filename

  _repair_account_variables

  _run_as_aegir "drush8 @hostmaster cc all" > /dev/null 2>&1 \
    || _alrt "drush cc all returned non-zero after the account-axis rename"

  # Residual report, account axis: trailing-slash pattern so converged
  # prefix-extension renames (o1 -> o11) do not count forever.
  local _RES_PATH="n/a"
  if _sql_table_exists variable; then
    _RES_PATH=$(_sql "SELECT COUNT(*) FROM variable WHERE value LIKE '%/data/disk/${_OLD_ACCT}/%'")
  fi
  _info "  Residual '/data/disk/${_OLD_ACCT}/' refs in variable: ${_RES_PATH}"
}

_repair_account_variables() {
  # Same bootstrap-free serialize-safe machinery as the host axis, with the
  # account-axis pairs and their anchors: the path pair is a free substring
  # (unambiguous, trailing-slash-convergent), the front pair applies only
  # '/'-anchored or to whole values so customer URIs on the account
  # subdomain (shop.<old front>) can never match.
  _sql_table_exists variable || {
    _info "  variable table absent (Backdrop hostmaster?) — account variable pass skipped"
    return 0
  }

  local _CNT _PHP _VOUT
  _CNT=$(_sql "SELECT COUNT(*) FROM variable WHERE value LIKE '%/data/disk/${_OLD_ACCT}/%' OR value LIKE '%/${_OLD_FRONT}%' OR value LIKE '%\"${_OLD_FRONT}%'")
  if [ "${_CNT:-0}" -eq 0 ]; then
    _info "  variable table: no values reference the ${_OLD_ACCT} account axis"
    return 0
  fi

  _info "  Repairing ${_CNT} account-axis variable value(s) via php/mysqli ..."
  mkdir -p "${_BACKUP_DIR}"
  _PHP="${_BACKUP_DIR}/acctfix_${_TS}.php"
  _VOUT="${_BACKUP_DIR}/acctfix_${_TS}.log"
  {
    printf '<?php\n$pOld = '\''/data/disk/%s/'\'';\n$pNew = '\''/data/disk/%s/'\'';\n$fOld = '\''%s'\'';\n$fNew = '\''%s'\'';\n' \
      "${_OLD_ACCT}" "${_NEW_ACCT}" "${_OLD_FRONT}" "${_NEW_FRONT}"
    cat <<'PHPEOF'
$fGuard = (strpos($fNew, $fOld) !== FALSE);
function acct_fix_str($s) {
  global $pOld, $pNew, $fOld, $fNew, $fGuard;
  if ($s === rtrim($pOld, '/')) {
    return rtrim($pNew, '/');
  }
  $s = str_replace($pOld, $pNew, $s);
  if ($s === $fOld) {
    return $fNew;
  }
  // A front at string START is quote-anchored in the serialized form —
  // still unambiguous (customer subdomains always carry a label + dot
  // BEFORE the front, so they never sit at offset 0).
  if (strpos($s, $fOld) === 0 && !($fGuard && strpos($s, $fNew) === 0)) {
    $s = $fNew . substr($s, strlen($fOld));
  }
  if (!($fGuard && strpos($s, '/' . $fNew) !== FALSE)) {
    $s = str_replace('/' . $fOld, '/' . $fNew, $s);
  }
  return $s;
}
function acct_fix($v, &$hadobj) {
  if (is_string($v)) {
    return acct_fix_str($v);
  }
  if (is_array($v)) {
    $out = array();
    foreach ($v as $k => $item) {
      if (is_string($k)) {
        $k = acct_fix_str($k);
      }
      $out[$k] = acct_fix($item, $hadobj);
    }
    return $out;
  }
  if (is_object($v)) {
    $hadobj = TRUE;
    return $v;
  }
  return $v;
}
$h = getenv('RAH_DB_HOST'); if ($h === FALSE || $h === '') { $h = 'localhost'; }
$prt = getenv('RAH_DB_PORT'); if ($prt === FALSE || $prt === '') { $prt = '3306'; }
$conn = @mysqli_connect($h, getenv('RAH_DB_USER'), getenv('RAH_DB_PASS'),
  getenv('RAH_DB_NAME'), (int) $prt);
if (!$conn) {
  print "RAH-ERROR: cannot connect to database '" . getenv('RAH_DB_NAME') . "'\n";
  exit(1);
}
$fixed = 0;
$objrows = array();
$broken = array();
$e1 = mysqli_real_escape_string($conn, $pOld);
$e2 = mysqli_real_escape_string($conn, '/' . $fOld);
$e3 = mysqli_real_escape_string($conn, '"' . $fOld);
$res = mysqli_query($conn,
  "SELECT name, value FROM variable WHERE value LIKE '%" . $e1 . "%' OR value LIKE '%" . $e2 . "%' OR value LIKE '%" . $e3 . "%'");
if (!$res) {
  print "RAH-ERROR: variable query failed\n";
  exit(1);
}
$stmt = mysqli_prepare($conn, "UPDATE variable SET value = ? WHERE name = ?");
if (!$stmt) {
  print "RAH-ERROR: update prepare failed\n";
  exit(1);
}
while ($row = mysqli_fetch_assoc($res)) {
  $name = $row['name'];
  $raw = $row['value'];
  $val = @unserialize($raw);
  if ($val === FALSE && $raw !== serialize(FALSE)) {
    $broken[] = $name;
    continue;
  }
  $hadobj = FALSE;
  $new_val = acct_fix($val, $hadobj);
  if ($hadobj) {
    $objrows[] = $name;
  }
  $new_raw = serialize($new_val);
  if ($new_raw !== $raw) {
    mysqli_stmt_bind_param($stmt, 'ss', $new_raw, $name);
    if (!mysqli_stmt_execute($stmt)) {
      print "RAH-ERROR: update failed for " . $name . "\n";
      exit(1);
    }
    $fixed++;
  }
}
if ($fixed > 0) {
  $ct = mysqli_query($conn, "SHOW TABLES LIKE 'cache_bootstrap'");
  if ($ct && mysqli_num_rows($ct) > 0) {
    mysqli_query($conn, "DELETE FROM cache_bootstrap WHERE cid = 'variables'");
  }
}
print "RAH: account-axis variables re-serialized: " . $fixed . "\n";
if (count($objrows)) {
  print "RAH: object values left untouched in: " . implode(', ', $objrows) . "\n";
}
if (count($broken)) {
  print "RAH: unserialize already failing (left as-is): " . implode(', ', $broken) . "\n";
}
print "RAH-DONE\n";
PHPEOF
  } > "${_PHP}"
  chmod 644 "${_PHP}"

  local _MY_U _MY_W
  _MY_U=$(grep -m1 "^user" /root/.my.cnf 2>/dev/null | cut -d= -f2- | tr -d " \"'")
  _MY_W=$(grep -m1 "^password" /root/.my.cnf 2>/dev/null | cut -d= -f2- | tr -d " \"'")
  if RAH_DB_HOST="localhost" RAH_DB_PORT="3306" \
    RAH_DB_USER="${_MY_U:-root}" RAH_DB_PASS="${_MY_W}" \
    RAH_DB_NAME="${_AEGIR_DB}" \
    php "${_PHP}" > "${_VOUT}" 2>&1 \
    && grep -q '^RAH-DONE' "${_VOUT}"; then
    grep '^RAH: ' "${_VOUT}" | sed 's/^RAH: /  /'
    rm -f "${_PHP}" "${_VOUT}"
  else
    _alrt "account-axis variable repair did not confirm — last 15 lines:"
    tail -n 15 "${_VOUT}"
    _alrt "full output kept: ${_VOUT}; script kept: ${_PHP}"
  fi
  return 0
}

###-------------§6 RELOAD NGINX----------###

###-------------§5b HOST-LEVEL NAMES-----###

# The box-level names none of the Aegir surfaces above reach: postfix's
# myhostname (and a mydestination entry naming the box), /etc/mailname, and
# the self-signed fallback certificate nginx presents for a name it does not
# serve -- all written once, at install, from the hostname of the day. A box
# renamed in place, cloned, or restored from an image went on introducing
# itself by a former name in every mail it sent and on that certificate.
# Master root only (the box's own name is the master's). A value is renamed
# only when it is one of the box's former names: the old Aegir hostname, or
# the name BOA's own fallback certificate was issued for -- an image restored
# and renamed by an older tool leaves postfix on its build-time name, which
# only that certificate still records. A myhostname or a certificate set to
# anything else is left alone.
_rename_host_identity() {
  [ "${_AEGIR_ROOT}" = "/var/aegir" ] || return 0
  _info "§5b Renaming the host-level names (postfix, mailname, fallback certificate) ..."
  local _crt=/etc/ssl/private/nginx-wild-ssl.crt
  local _key=/etc/ssl/private/nginx-wild-ssl.key
  local _subj _iss _built="" _former _cur _val _tok _new _seen _hit _tmp _ts
  local -a _toks
  _ts=$(date +%Y%m%d_%H%M%S)
  _HOST_NAMES_DONE=""
  # BOA's own certificate: self-signed, issued with the install subject.
  if [ -s "${_crt}" ] && [ -s "${_key}" ] && command -v openssl > /dev/null 2>&1; then
    _subj=$(openssl x509 -in "${_crt}" -noout -subject -nameopt RFC2253 2>/dev/null)
    _iss=$(openssl x509 -in "${_crt}" -noout -issuer -nameopt RFC2253 2>/dev/null)
    _subj="${_subj#subject=}"
    _iss="${_iss#issuer=}"
    if [ -n "${_subj}" ] && [ "${_subj}" = "${_iss}" ] \
      && [[ ",${_subj}," == *",O=Aegir,"* ]] && [[ ",${_subj}," == *",OU=Cloud,"* ]]; then
      _built=$(printf '%s' "${_subj}" | sed -n 's/^\(.*,\)\{0,1\}CN=\*\.\([^,]*\).*/\2/p')
      _built=${_built//[^a-zA-Z0-9.\-]/}
    fi
  fi
  _former=" ${_OLD_HOST} "
  if [ -n "${_built}" ] && [ "${_built}" != "${_NEW_HOST}" ]; then
    _former="${_former}${_built} "
  fi
  if [ -n "${_built}" ] && [ "${_built}" != "${_NEW_HOST}" ]; then
    _info "  fallback certificate: CN=*.${_built} -> CN=*.${_NEW_HOST} (same key)"
    if [ "${_DRY_RUN}" = "YES" ]; then
      echo "DRY:  openssl req -x509 -new -key ${_key} -subj .../CN=*.${_NEW_HOST} -out ${_crt}"
      _HOST_NAMES_DONE="${_HOST_NAMES_DONE} fallback-certificate"
    else
      mkdir -p "${_BACKUP_DIR}"
      cp -a "${_crt}" "${_BACKUP_DIR}/nginx-wild-ssl.crt_${_ts}"
      _tmp="${_crt}.rename.$$"
      if openssl req -x509 -nodes -sha256 -days 7300 -new -key "${_key}" \
          -subj "/C=US/ST=New York/O=Aegir/OU=Cloud/L=New York/CN=*.${_NEW_HOST}" \
          -out "${_tmp}" -batch 2> /dev/null && [ -s "${_tmp}" ]; then
        chown --reference="${_crt}" "${_tmp}"
        chmod --reference="${_crt}" "${_tmp}"
        mv -f "${_tmp}" "${_crt}"
        _HOST_NAMES_DONE="${_HOST_NAMES_DONE} fallback-certificate"
      else
        rm -f "${_tmp}"
        _alrt "§5b could not re-issue ${_crt} for *.${_NEW_HOST} -- left as it was"
        _HOST_NAMES_DONE="${_HOST_NAMES_DONE} fallback-certificate(FAILED)"
      fi
    fi
  fi
  if command -v postconf > /dev/null 2>&1 && [ -e "/etc/postfix/main.cf" ]; then
    # Never through _maybe_run: its eval would expand the $myhostname-style
    # references a postfix value carries.
    _cur=$(postconf -h myhostname 2>/dev/null)
    if [ -n "${_cur}" ] && [[ "${_former}" == *" ${_cur} "* ]]; then
      _info "  postfix myhostname: ${_cur} -> ${_NEW_HOST}"
      if [ "${_DRY_RUN}" = "YES" ]; then
        echo "DRY:  postconf -e 'myhostname = ${_NEW_HOST}'"
      else
        postconf -e "myhostname = ${_NEW_HOST}"
      fi
      _HOST_NAMES_DONE="${_HOST_NAMES_DONE} postfix-myhostname"
    fi
    # mydestination: a token that is a former name becomes the new name, or
    # goes when the new name is already listed; every other token is kept,
    # and a value naming no former name is never rewritten.
    _val=$(postconf -h mydestination 2>/dev/null)
    _toks=()
    IFS=', ' read -r -a _toks <<< "${_val}"
    _hit=NO
    _seen=NO
    for _tok in "${_toks[@]}"; do
      [ "${_tok}" = "${_NEW_HOST}" ] && _seen=YES
      [ -n "${_tok}" ] && [[ "${_former}" == *" ${_tok} "* ]] && _hit=YES
    done
    if [ "${_hit}" = "YES" ]; then
      _new=""
      for _tok in "${_toks[@]}"; do
        if [ -n "${_tok}" ] && [[ "${_former}" == *" ${_tok} "* ]]; then
          [ "${_seen}" = "YES" ] && continue
          _tok="${_NEW_HOST}"
          _seen=YES
        fi
        _new="${_new:+${_new}, }${_tok}"
      done
      _info "  postfix mydestination: ${_val} -> ${_new}"
      if [ "${_DRY_RUN}" = "YES" ]; then
        echo "DRY:  postconf -e 'mydestination = ${_new}'"
      else
        postconf -e "mydestination = ${_new}"
      fi
      _HOST_NAMES_DONE="${_HOST_NAMES_DONE} postfix-mydestination"
    fi
    if [ "${_DRY_RUN}" != "YES" ] && [[ "${_HOST_NAMES_DONE}" == *postfix* ]] \
      && postfix status > /dev/null 2>&1; then
      postfix reload > /dev/null 2>&1
    fi
  fi
  if [ -s "/etc/mailname" ]; then
    _cur=$(head -n 1 /etc/mailname | tr -d '[:space:]')
    if [ -n "${_cur}" ] && [[ "${_former}" == *" ${_cur} "* ]]; then
      _info "  /etc/mailname: ${_cur} -> ${_NEW_HOST}"
      _maybe_run "echo '${_NEW_HOST}' > /etc/mailname"
      _HOST_NAMES_DONE="${_HOST_NAMES_DONE} mailname"
    fi
  fi
  [ -n "${_HOST_NAMES_DONE}" ] || _info "  nothing names a former hostname"
}

_reload_nginx() {
  _info "§6 Reloading nginx ..."
  # Only a config that passes its own test is reloaded. A failed reload is
  # harmless in itself (nginx keeps the running config), but an invalid
  # config left on disk turns the next unrelated restart -- the web-layer
  # watchdog runs every minute -- into a box-wide outage, and this box may
  # already be serving relayed visitors while it is renamed.
  if [ "${_DRY_RUN}" = "YES" ]; then
    _maybe_run nginx -t
    _maybe_run service nginx reload
  elif nginx -t &> /dev/null; then
    _maybe_run service nginx reload
  else
    _alrt "§6 nginx -t FAILED after the rename rewrote the vhosts -- NOT reloaded:"
    nginx -t 2>&1 | tail -5
    _alrt "§6 nginx keeps serving its previous config; fix the reported error, then: nginx -t && service nginx reload"
  fi
}

###-------------§7 AEGIR TASK QUEUE------###

_run_as_aegir() {
  # Run a drush command as the Aegir user derived from the aegir root path.
  # Uses login shell (-) so .bash_profile is sourced and drush PATH is set.
  su -s /bin/bash - "${_AEGIR_USER}" -c "$1"
}

_queue_renamed_site_verifies() {
  # Restored from the old xboa procedure, which scheduled
  # `hosting-task @<site> verify --force` for every site it moved. The
  # rewrite dropped it and queued only SERVER verifies, which regenerate no
  # per-site artefact at all — the whole of B7. §2c now leaves each renamed
  # site correct on disk without any of this; this queues provision's own
  # regeneration on top, from the panel node, exactly as the old procedure
  # did. Bounded by the sites §2c actually moved, so a box whose tenants do
  # not embed the hostname queues nothing. Grav and Textpattern capsules are
  # deliberately outside that set: §2c re-points their own uri-bound surfaces
  # directly, and their verify is provision's class-specific task, carrying
  # its own PHP floor and its own tree repair.
  local _U
  [ "${#_RENAMED_SITE_URIS[@]}" -eq 0 ] && return 0
  for _U in $(printf '%s\n' "${_RENAMED_SITE_URIS[@]}" | sort -u); do
    if [ "${_DRY_RUN}" = "YES" ]; then
      _info "    (dry-run) would queue site verify: ${_U}"
      continue
    fi
    _safe_name "${_U}" "site uri" || continue
    _info "    queueing site verify: ${_U}"
    _run_as_aegir "drush8 @hostmaster hosting-task @${_U} verify --force"
  done
  return 0
}

_run_aegir_tasks() {
  _info "§7 Flushing Drush cache and running Aegir task queue (5 passes) ..."
  _info "    Each pass: cc drush + server verify tasks + dispatch + hosting-tasks"
  _info "    Server verifies refresh the server-level records and config; the per-site"
  _info "    verifies queued below regenerate each RENAMED site's own artefacts."

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would run 5 passes of drush cc + hosting task queue"
    _queue_renamed_site_verifies
    return
  fi

  local _pass
  for _pass in 1 2 3 4 5; do
    _info "  Pass ${_pass}/5 ..."

    _run_as_aegir "drush8 cc drush > /dev/null 2>&1"

    _run_as_aegir "drush8 @hostmaster \
      hosting-task @server_master verify --force"

    _run_as_aegir "drush8 @hostmaster \
      hosting-task @server_localhost verify --force"

    if [ "${_pass}" -eq 1 ]; then
      _queue_renamed_site_verifies
    fi

    _run_as_aegir "drush8 @hostmaster hosting-dispatch"

    sleep 10

    _run_as_aegir "drush8 @hostmaster hosting-tasks --force"

    sleep 10

    _info "  Pass ${_pass}/5 complete"
  done

  _info "§7 Aegir task queue complete"
}

###-------------§8 HOSTMASTER VERIFY-----###

_verify_hostmaster() {
  # §7's queued tasks verify only the SERVER contexts; the hostmaster SITE's
  # own settings.php (file paths etc.) is re-rendered only by a provision
  # verify of the site itself -- without it the panel answers HTTP 400 on
  # the new hostname.
  _info "§8 Synchronous hostmaster site verify (regenerates settings.php) ..."

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would run: drush8 @hostmaster provision-verify"
    return
  fi

  # Capture the verify output: during a migration cutover this is the step
  # most likely to hiccup, and a bare ALRT with the detail thrown away left
  # nothing to debug with.
  local _VLOG
  _VLOG="${_BACKUP_DIR}/hm_verify_$(date +%Y%m%d_%H%M%S).log"
  mkdir -p "${_BACKUP_DIR}"
  if _run_as_aegir "drush8 @hostmaster provision-verify" > "${_VLOG}" 2>&1; then
    rm -f "${_VLOG}"
  else
    _alrt "hostmaster provision-verify returned non-zero — last 15 lines:"
    tail -n 15 "${_VLOG}"
    _alrt "full output kept: ${_VLOG}"
  fi

  _info "§8 Hostmaster site verify complete"
}

###-------------§9 SERVING GATE----------###

_verify_renamed_sites_serve() {
  # The last thing an operator does by hand after a rename is curl a site and
  # decide whether it worked. That judgement is NOT safe to leave to a human,
  # and this is the measurement that says so: PHP resolves settings.php
  # through a realpath cache that is per FPM WORKER with a default 120s TTL,
  # so a correct file is not necessarily observed yet. Measured on the xb1
  # rig: 36s to become visible even when the file is rewritten through its
  # existing inode, and still not visible after THREE MINUTES when the inode
  # was replaced (which is what `sed -i` does, and why this tool no longer
  # uses it here).
  #
  # Both operator mistakes in that window are expensive. Calling it broken
  # rolls back a migration that was fine; calling it fine because one early
  # curl happened to hit a warm worker ships a box whose sites answer 400.
  # So the tool waits, decides, and says which -- bounded, never forever.
  #
  # The set is every site on the new hostname, not only the dirs THIS run
  # moved. A run that refuses at §7 (a stray dir beside a renamed one) has
  # already moved every site of the root; the resume finds nothing to move,
  # and bounding the gate to the moved set left those sites confirmed by
  # neither run -- the summary printed no Sites line at all while an
  # operator read "Rename complete". Found by gate ring G1-R57 (2026-09-14)
  # and ruled a defect.
  local _U _code _deadline _md5 _bad="" _ALL
  _ALL=$(printf '%s\n' "${_RENAMED_SITE_URIS[@]}" "${_SERVE_CHECK_URIS[@]}" \
    | sed '/^$/d' | sort -u)
  [ -z "${_ALL}" ] && return 0

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "§9 (dry-run) Would confirm each renamed site serves before reporting success"
    return 0
  fi

  # A 200 is not proof. An unknown Host lands on the box's catch-all vhost,
  # which answers 200 with an "Under Construction" page, so a status-only
  # gate passes for a site that does not exist at all -- caught by pointing
  # this very gate at a made-up hostname. Take the catch-all's answer once
  # and treat any 200 identical to it as NOT serving. Self-calibrating, so
  # nothing here depends on what that page happens to say.
  local _base _body
  # /tmp is world-writable, so a fixed name can be pre-created by anyone. That
  # does not overwrite anything here (BOA ships protected_symlinks/
  # protected_regular), but it can make the body unreadable, which would
  # silently disable the catch-all comparison below and pass a site that does
  # not serve. Unguessable name, and no gate at all beats a lying gate.
  _body=$(mktemp /tmp/.rename-serve.XXXXXX 2>/dev/null) || {
    _alrt "§9 cannot stage probe output under /tmp — serving gate skipped"
    return 0
  }
  _base=$(curl -s -A iCab --max-time 20 \
    -H "Host: no-such-site.rename-probe.invalid" "http://127.0.0.1/" 2>/dev/null \
    | md5sum | cut -d' ' -f1)

  # A suspended account answers 503 on every name by design (its billing
  # gate), so probing it only burns the wait and ends in a false alarm --
  # xmass's own panel probe skips such an account for the same reason.
  local _susp=""
  case "${_AEGIR_ROOT}" in
    /data/disk/o*) [ -e "/data/conf/suspended/${_AEGIR_ROOT##*/}.pid" ] && _susp=YES ;;
  esac
  _info "§9 Confirming each renamed site actually serves (up to ${_SERVE_WAIT}s each) ..."
  local _VH
  _SERVE_N=0
  for _U in ${_ALL}; do
    if [ "${_susp}" = "YES" ]; then
      _info "    ${_U}: account suspended -- 503 by design, not probed"
      _SERVE_SKIPPED_N=$((_SERVE_SKIPPED_N + 1))
      continue
    fi
    # The gate is for sites nginx serves. A site disabled in the panel keeps
    # its dir and settings.php but carries the placeholder vhost, whose body
    # IS the catch-all page the probe below calibrates against, so probing it
    # could only end in a false NOT SERVING after the full wait. Judged here,
    # after §4 and §6, where the vhost under the new name is final.
    _VH="${_AEGIR_ROOT}/config/server_master/nginx/vhost.d/${_U}"
    if [ ! -f "${_VH}" ]; then
      _info "    ${_U}: no vhost -- not probed"
      _SERVE_SKIPPED_N=$((_SERVE_SKIPPED_N + 1))
      continue
    elif grep -qE 'Do not reveal Aegir front-end URL|root[[:space:]]+/var/www/nginx-default' "${_VH}" 2>/dev/null; then
      _info "    ${_U}: disabled -- placeholder vhost by design, not probed"
      _SERVE_SKIPPED_N=$((_SERVE_SKIPPED_N + 1))
      continue
    fi
    _deadline=$(( $(date +%s) + _SERVE_WAIT ))
    _code=""
    while [ "$(date +%s)" -lt "${_deadline}" ]; do
      _code=$(curl -s -o "${_body}" -w '%{http_code}' -A iCab --max-time 20 \
        -H "Host: ${_U}" "http://127.0.0.1/" 2>/dev/null)
      if [ "${_code}" = "200" ] && [ -n "${_base}" ]; then
        _md5=$(md5sum < "${_body}" 2>/dev/null | cut -d' ' -f1)
        if [ -z "${_md5}" ] || [ "${_md5}" = "${_base}" ]; then
          # Either the catch-all answered, or the body could not be read at
          # all -- an unread body proves nothing, so it is not a pass either.
          # Keep waiting: a site whose settings.php was just rewritten can
          # still be in the realpath-cache window.
          _code="catchall"
        fi
      fi
      case "${_code}" in
        200|301|302|401|403) break ;;
      esac
      sleep 5
    done
    rm -f "${_body}"
    case "${_code}" in
      200|301|302)
        _info "    ${_U} serves (${_code})"
        _SERVE_N=$((_SERVE_N + 1))
      ;;
      401|403)
        # basic auth or an IP allow-list in front of the site: the answer
        # proves the vhost is live and routed to the right site
        _info "    ${_U} serves (${_code}, protected)"
        _SERVE_N=$((_SERVE_N + 1))
      ;;
      *)
        _alrt "    ${_U} does NOT serve (${_code}) after ${_SERVE_WAIT}s"
        _bad="${_bad} ${_U}"
      ;;
    esac
  done

  if [ -n "${_bad}" ]; then
    _SERVE_FAILED="${_bad}"
    _alrt "§9 sites still not serving:${_bad}"
    _alrt "    A 400 here is the trusted_host_patterns check: compare the site's"
    _alrt "    settings.php against its directory name before anything else."
  else
    _info "§9 every renamed site serves"
  fi
  return 0
}

###-------------SUMMARY------------------###

_print_summary() {
  echo ""
  echo "======================================================"
  if [ "${_DRY_RUN}" = "YES" ]; then
    echo "  DRY-RUN complete — no files were modified"
  else
    echo "  Rename complete"
  fi
  echo "  Aegir root   : ${_AEGIR_ROOT}"
  echo "  Old hostname : ${_OLD_HOST}"
  echo "  New hostname : ${_NEW_HOST}"
  echo "  Tenant dirs  : ${_TENANT_DIRS_N} moved onto the new hostname"
  if [ "${_CAPSULE_DIRS_N}" -gt 0 ]; then
    echo "  Capsules     : ${_CAPSULE_DIRS_N} Grav/Textpattern site dir(s) among them, class surfaces re-pointed"
  fi
  if [ "${_UNPARKED_N}" -gt 0 ]; then
    echo "  Un-parked    : ${_UNPARKED_N} capsule(s) reinstated from backups/rename-hostname/stray-sites/"
  fi
  if [ "${_STRAY_LEFT_N}" -gt 0 ]; then
    echo "  ATTENTION    : ${_STRAY_LEFT_N} host-derived dir(s) still parked in backups/rename-hostname/stray-sites/ — see the ALRT lines above"
  fi
  if [ "${_SETTINGS_SKIPPED_N}" -gt 0 ]; then
    echo "  ATTENTION    : ${_SETTINGS_SKIPPED_N} settings.php left untouched — see the ALRT lines above"
  fi
  if [ -n "${_SERVE_FAILED}" ]; then
    echo "  NOT SERVING  :${_SERVE_FAILED}"
  elif [ "${_SERVE_N}" -gt 0 ] && [ "${_DRY_RUN}" != "YES" ]; then
    echo "  Sites        : all ${_SERVE_N} renamed site(s) confirmed serving"
  fi
  if [ "${_SERVE_SKIPPED_N}" -gt 0 ] && [ "${_DRY_RUN}" != "YES" ]; then
    echo "  Not probed   : ${_SERVE_SKIPPED_N} site(s) -- suspended account, disabled placeholder or no vhost (see §9)"
  fi
  if [ -n "${_HOST_NAMES_DONE}" ]; then
    echo "  Host names   :${_HOST_NAMES_DONE}"
  fi
  if [ "${_ACCT_AXIS}" = "YES" ]; then
    echo "  Old account  : ${_OLD_ACCT}"
    echo "  New account  : ${_NEW_ACCT}"
  fi
  echo "======================================================"
  echo ""
}

