#!/bin/bash

###
### renameaegirhost — in-place rename of the Aegir hostname on BOA
###
### Usage: renameaegirhost --aegir-root PATH [--dry-run] [--force-old OLDFQDN]
###
###   --aegir-root PATH  Aegir home directory (required); validated as a real
###                      Aegir root before any changes are made.
###      Examples:
###      --aegir-root /var/aegir    (BOA master)
###      --aegir-root /data/disk/o1 (BOA octopus account)
###   --dry-run    Print what would be changed; make no modifications
###   --force-old FQDN   Override auto-detected old hostname with FQDN
###
### What it does:
###   §1  Detect old hostname from <aegir-root>/.drush/server_master.alias.drushrc.php
###   §2  Detect new hostname from system FQDN (hostname -f)
###   §3  Rewrite all Drush alias files in <aegir-root>/.drush/
###   §4  Rename + rewrite vhost files in <aegir-root>/config/server_master/nginx/vhost.d/
###   §5  Rename the hostname inside the Aegir DB with serialize-safe, targeted
###       statements: identity rows keyed by hosting_context nid, REPLACE()
###       sweeps over plain-varchar columns, and an unserialize/replace/
###       re-serialize pass over the variable table. Never a blanket dump+sed:
###       that corrupts PHP-serialized byte lengths when the FQDN length
###       changes, and (with --hex-blob) never reached blob values anyway.
###       A plain dump is still taken first, as a backup only.
###   §6  Reload nginx
###   §7  Flush Drush cache and run Aegir task queue (5 passes) to regenerate
###       all aliases, vhosts, and db-host entries from the updated database.
###       Assumes BOA cron is not running (caller must ensure this).
###

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

###-------------DEFAULTS------------------###

_AEGIR_ROOT=""
_DRY_RUN=NO
_FORCE_OLD=""

###-------------ARGUMENT PARSING----------###

while [ $# -gt 0 ]; do
  case "$1" in
    --aegir-root)
      _AEGIR_ROOT="$2"
      shift 2
      ;;
    --dry-run)
      _DRY_RUN=YES
      shift
      ;;
    --force-old)
      _FORCE_OLD="$2"
      shift 2
      ;;
    -h|--help)
      sed -n '/^###/{ s/^### \?//; p }' "$0"
      exit 0
      ;;
    *)
      echo "ERROR: Unknown argument: $1"
      echo "Usage: $0 --aegir-root PATH [--dry-run] [--force-old OLDFQDN]"
      exit 1
      ;;
  esac
done

if [ -z "${_AEGIR_ROOT}" ]; then
  echo "ERROR: --aegir-root PATH is required"
  echo "Usage: $0 --aegir-root PATH [--dry-run] [--force-old OLDFQDN]"
  exit 1
fi

# Derive all paths and username from _AEGIR_ROOT now that args are fully parsed
_DRUSH_DIR=${_AEGIR_ROOT}/.drush
_VHOSTD=${_AEGIR_ROOT}/config/server_master/nginx/vhost.d
_BACKUP_DIR=${_AEGIR_ROOT}/backups/rename-hostname
_AEGIR_USER=$(basename "${_AEGIR_ROOT}")

###-------------HELPERS-------------------###

_info() {
  echo "INFO: $*"
}

_alrt() {
  echo "ALRT: $*"
}

_die() {
  echo "ERROR: $*"
  exit 1
}

_maybe_run() {
  # Execute command unless --dry-run; always echo it
  if [ "${_DRY_RUN}" = "YES" ]; then
    echo "DRY:  $*"
  else
    eval "$@"
  fi
}

###-------------CHECKS--------------------###

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    _die "This script must be run as root"
  fi

  _DF_TEST="$(df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 { gsub(/%/,"",$u); print $u }')"
  if [ -n "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    _die "Disk usage is at ${_DF_TEST}% — aborting (must be below 90%)"
  fi

  if [ ! -d "${_AEGIR_ROOT}" ]; then
    _die "Aegir root not found: ${_AEGIR_ROOT}"
  fi

  # Validate the directory actually looks like an Aegir root before touching anything
  _aegir_root_ok=YES
  for _required_subdir in \
    .drush \
    config/server_master \
    backups \
  ; do
    if [ ! -d "${_AEGIR_ROOT}/${_required_subdir}" ]; then
      _alrt "Expected Aegir subdir missing: ${_AEGIR_ROOT}/${_required_subdir}"
      _aegir_root_ok=NO
    fi
  done
  if [ "${_aegir_root_ok}" = "NO" ]; then
    _die "'${_AEGIR_ROOT}' does not look like a valid Aegir root (missing subdirs above)"
  fi

  if [ ! -f "${_DRUSH_DIR}/server_master.alias.drushrc.php" ]; then
    _die "server_master.alias.drushrc.php not found in ${_DRUSH_DIR}"
  fi

  _info "Aegir root : ${_AEGIR_ROOT}"
  _info "Aegir user : ${_AEGIR_USER}"
}

###-------------§1 DETECT OLD HOSTNAME---###

_detect_old_hostname() {
  if [ -n "${_FORCE_OLD}" ]; then
    # Same charset guard as auto-detection — the value feeds sed and SQL
    _OLD_HOST="${_FORCE_OLD//[^a-zA-Z0-9.\-]/}"
    if [ -z "${_OLD_HOST}" ]; then
      _die "--force-old value '${_FORCE_OLD}' is not a usable hostname"
    fi
    _info "Old hostname forced via --force-old: ${_OLD_HOST}"
    return
  fi

  # Extract remote_host from server_master alias — this is the authoritative
  # hostname stored in the Aegir drush config
  _OLD_HOST=$(grep "remote_host" \
    "${_DRUSH_DIR}/server_master.alias.drushrc.php" \
    | head -1 \
    | sed "s/.*remote_host.*=>//; s/[' ,;]//g")

  _OLD_HOST=${_OLD_HOST//[^a-zA-Z0-9.\-]/}

  if [ -z "${_OLD_HOST}" ]; then
    _die "Could not detect old hostname from server_master.alias.drushrc.php"
  fi

  _info "Detected old hostname: ${_OLD_HOST}"
}

###-------------§2 DETECT NEW HOSTNAME---###

_detect_new_hostname() {
  _NEW_HOST=$(hostname -f 2>/dev/null | tr -d '\n')
  # Same charset guard as §1 — the value feeds sed and SQL
  _NEW_HOST=${_NEW_HOST//[^a-zA-Z0-9.\-]/}

  if [ -z "${_NEW_HOST}" ]; then
    _die "Could not determine system FQDN via hostname -f"
  fi

  # Sanity: must contain at least one dot (real FQDN)
  if [[ "${_NEW_HOST}" != *.* ]]; then
    _die "System hostname '${_NEW_HOST}' does not look like a FQDN (no dot). " \
       "Set it correctly in /etc/hostname and /etc/hosts first."
  fi

  _info "New hostname (system FQDN): ${_NEW_HOST}"

  if [ "${_OLD_HOST}" = "${_NEW_HOST}" ]; then
    _info "Old and new hostname are identical — nothing to do."
    exit 0
  fi
}

###-------------BACKUP--------------------###

_backup_files() {
  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would create backup in ${_BACKUP_DIR}"
    return
  fi

  mkdir -p "${_BACKUP_DIR}"
  _TS=$(date +%Y%m%d_%H%M%S)

  cp -a "${_DRUSH_DIR}" "${_BACKUP_DIR}/drush_${_TS}"
  _info "Drush dir backed up to ${_BACKUP_DIR}/drush_${_TS}"

  if [ -d "${_VHOSTD}" ]; then
    cp -a "${_VHOSTD}" "${_BACKUP_DIR}/vhost.d_${_TS}"
    _info "vhost.d backed up to ${_BACKUP_DIR}/vhost.d_${_TS}"
  fi

  _info "Backup timestamp: ${_TS}"
}

###-------------§2b HOSTMASTER SITE DIR--###

_rename_hostmaster_site_dir() {
  # The hostmaster frontend site dir is host-derived (sites/<user>.FQDN) and
  # must follow the rename BEFORE §3 rewrites the aliases: §5 re-derives the
  # drushrc path from the (by then rewritten) alias and would die against an
  # OLD-named dir. GUARD (load-bearing for xoct/xmass): when a NEW-named dir
  # already exists (fresh-install migration targets), skip -- renaming the
  # source's OLD-named dir over it would clobber the target's correct
  # settings.php.
  local _HM_RAW
  _HM_RAW=$(grep "site_path'" \
    "${_DRUSH_DIR}/hostmaster.alias.drushrc.php" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g" \
    | tr -d ' ')
  if [ -z "${_HM_RAW}" ]; then
    _alrt "Could not extract site_path for the site-dir rename; leaving to §5"
    return 0
  fi
  local _HM_DIR_NEW="${_HM_RAW//${_OLD_HOST}/${_NEW_HOST}}"
  local _HM_DIR_OLD="${_HM_DIR_NEW//${_NEW_HOST}/${_OLD_HOST}}"
  if [ "${_HM_DIR_OLD}" = "${_HM_DIR_NEW}" ]; then
    return 0
  fi
  if [ -d "${_HM_DIR_NEW}" ]; then
    _info "Hostmaster site dir already ${_HM_DIR_NEW##*/} — not renaming"
    return 0
  fi
  if [ -d "${_HM_DIR_OLD}" ]; then
    _info "Renaming hostmaster site dir: ${_HM_DIR_OLD##*/} -> ${_HM_DIR_NEW##*/}"
    _maybe_run mv -f \'"${_HM_DIR_OLD}"\' \'"${_HM_DIR_NEW}"\'
  else
    _alrt "Neither ${_HM_DIR_OLD##*/} nor ${_HM_DIR_NEW##*/} found on disk"
  fi
}

###-------------§3 REWRITE DRUSH FILES---###

_rewrite_drush_files() {
  _info "§3 Rewriting Drush alias files in ${_DRUSH_DIR} ..."

  for _F in $(find "${_DRUSH_DIR}" -maxdepth 1 -type f -name '*.drushrc.php' | sort); do
    if grep -q "${_OLD_HOST}" "${_F}" 2>/dev/null; then
      _info "  sed in-place: ${_F}"
      _maybe_run sed -i "s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_F}"\'
    fi
  done
}

###-------------§4 RENAME + REWRITE VHOSTS-###

_rewrite_vhosts() {
  if [ ! -d "${_VHOSTD}" ]; then
    _alrt "vhost.d dir not found: ${_VHOSTD} — skipping vhost step"
    return
  fi

  _info "§4 Rewriting vhost files in ${_VHOSTD} ..."

  for _F in $(find "${_VHOSTD}" -maxdepth 1 -type f | sort); do
    _BASENAME=$(basename "${_F}")

    # Rewrite content regardless of filename
    if grep -q "${_OLD_HOST}" "${_F}" 2>/dev/null; then
      _info "  sed in-place content: ${_F}"
      _maybe_run sed -i "s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_F}"\'
    fi

    # Rename the file if old hostname appears in the filename
    if [[ "${_BASENAME}" == *"${_OLD_HOST}"* ]]; then
      _NEW_BASENAME="${_BASENAME//${_OLD_HOST}/${_NEW_HOST}}"
      _NEW_F="${_VHOSTD}/${_NEW_BASENAME}"
      _info "  rename: ${_BASENAME} -> ${_NEW_BASENAME}"
      _maybe_run mv -f \'"${_F}"\' \'"${_NEW_F}"\'
    fi
  done
}

###-------------§4b OCTOPUS CONTROL CNF--###

_rewrite_octopus_cnf() {
  # Octopus roots only: /root/.<oN>.octopus.cnf (_DOMAIN etc.) drives future
  # octopus up-* runs and must follow the rename. The master root has no
  # octopus cnf. Idempotent: no-op when the old FQDN is absent (migration
  # targets get a correct cnf from their fresh install).
  [[ "${_AEGIR_ROOT}" == /data/disk/* ]] || return 0
  local _OCT_CNF="/root/.${_AEGIR_USER}.octopus.cnf"
  [ -e "${_OCT_CNF}" ] || return 0
  if grep -q "${_OLD_HOST}" "${_OCT_CNF}" 2>/dev/null; then
    _info "Rewriting ${_OCT_CNF} (_DOMAIN etc.) ..."
    _maybe_run sed -i "s/${_OLD_HOST}/${_NEW_HOST}/g" \'"${_OCT_CNF}"\'
  fi
}

###-------------§5 DATABASE RENAME-------###

_detect_aegir_db() {
  # The Aegir hostmaster DB name lives in the hostmaster site's drushrc.php
  # Path is derived from the site_path in hostmaster.alias.drushrc.php
  _HM_SITE_PATH=$(grep "site_path'" \
    "${_DRUSH_DIR}/hostmaster.alias.drushrc.php" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g" \
    | tr -d ' ')

  if [ -z "${_HM_SITE_PATH}" ]; then
    _die "Could not extract site_path from hostmaster.alias.drushrc.php"
  fi

  _HM_DRUSHRC="${_HM_SITE_PATH}/drushrc.php"

  if [ ! -f "${_HM_DRUSHRC}" ]; then
    # Resume/dry-run tolerance: the alias may hold either hostname variant
    # while the on-disk dir holds the other (e.g. dry-run skips the §3
    # rewrite; a resumed run may find the dir already renamed). Try the
    # other variant before giving up.
    _HM_SITE_ALT="${_HM_SITE_PATH//${_NEW_HOST}/${_OLD_HOST}}"
    if [ "${_HM_SITE_ALT}" = "${_HM_SITE_PATH}" ]; then
      _HM_SITE_ALT="${_HM_SITE_PATH//${_OLD_HOST}/${_NEW_HOST}}"
    fi
    if [ -f "${_HM_SITE_ALT}/drushrc.php" ]; then
      _HM_DRUSHRC="${_HM_SITE_ALT}/drushrc.php"
    fi
  fi

  if [ ! -f "${_HM_DRUSHRC}" ]; then
    _die "Hostmaster drushrc.php not found: ${_HM_DRUSHRC}"
  fi

  _AEGIR_DB=$(grep "options\['db_name'\]" "${_HM_DRUSHRC}" \
    | head -1 \
    | sed "s/.*=//; s/[' ,;]//g" \
    | tr -d ' ')
  _AEGIR_DB=${_AEGIR_DB//[^a-zA-Z0-9_]/}

  if [ -z "${_AEGIR_DB}" ]; then
    _die "Could not detect Aegir DB name from ${_HM_DRUSHRC}"
  fi

  _info "Detected Aegir database: ${_AEGIR_DB}"
}

_sql() {
  # Batch/silent query against the Aegir DB; -N drops headers so callers can
  # capture single values.
  mysql --defaults-file=/root/.my.cnf -N -B "${_AEGIR_DB}" -e "$1"
}

_sql_table_exists() {
  # Hostmaster on Backdrop lacks some D7 tables (e.g. variable), so every §5
  # step is existence-gated: one schema must never break the other.
  [ -n "$(_sql "SHOW TABLES LIKE '$1'")" ]
}

_sql_replace_col() {
  # REPLACE() sweep over one plain-varchar column. Never point this at
  # serialized/blob storage — that is what the variable pass below is for.
  # When NEW contains OLD (a subdomain-augmenting rename), a REPLACE applied
  # to an already-renamed value doubles it (sub.example.com ->
  # sub.sub.example.com — the nid-keyed identity rows and any forced re-run
  # would hit this), so such rows are skipped; single-domain columns never
  # legitimately hold both values.
  local _T="$1" _C="$2" _N _G=""
  _sql_table_exists "${_T}" || return 0
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _G=" AND ${_C} NOT LIKE '%${_NEW_HOST}%'" ;;
  esac
  _N=$(_sql "SELECT COUNT(*) FROM ${_T} WHERE ${_C} LIKE '%${_OLD_HOST}%'${_G}")
  if [ "${_N:-0}" -gt 0 ]; then
    _sql "UPDATE ${_T} SET ${_C} = REPLACE(${_C}, '${_OLD_HOST}', '${_NEW_HOST}') WHERE ${_C} LIKE '%${_OLD_HOST}%'${_G}"
    _info "  ${_T}.${_C}: ${_N} row(s) renamed"
  fi
}

_repair_serialized_variables() {
  # D7 stores every variable PHP-serialized in a blob column. A text-level
  # replacement either corrupts the declared s:N:"..." byte lengths (value
  # silently unserializes to FALSE) or, in a --hex-blob dump, never reaches
  # the value at all. unserialize -> str_replace -> variable_set() instead:
  # correct lengths by construction and the variable cache stays coherent.
  _sql_table_exists variable || {
    _info "  variable table absent (Backdrop hostmaster?) — serialized pass skipped"
    return 0
  }

  local _CNT _PHP _VOUT
  _CNT=$(_sql "SELECT COUNT(*) FROM variable WHERE value LIKE '%${_OLD_HOST}%'")
  if [ "${_CNT:-0}" -eq 0 ]; then
    _info "  variable table: no values reference ${_OLD_HOST}"
    return 0
  fi

  _info "  Repairing ${_CNT} serialized variable value(s) via drush ..."
  _PHP="${_BACKUP_DIR}/varfix_${_TS}.php"
  _VOUT="${_BACKUP_DIR}/varfix_${_TS}.log"
  {
    printf '<?php\n$old = '\''%s'\'';\n$new = '\''%s'\'';\n' "${_OLD_HOST}" "${_NEW_HOST}"
    cat <<'PHPEOF'
// When $new contains $old (subdomain-augmenting rename), re-applying the
// replace to an already-renamed string would double it — skip strings
// already carrying $new in that case (mirrors the SQL sweep guard).
function rah_replace($v, $old, $new, &$hadobj, $guard) {
  if (is_string($v)) {
    if ($guard && strpos($v, $new) !== FALSE) {
      return $v;
    }
    return str_replace($old, $new, $v);
  }
  if (is_array($v)) {
    $out = array();
    foreach ($v as $k => $item) {
      if (is_string($k) && !($guard && strpos($k, $new) !== FALSE)) {
        $k = str_replace($old, $new, $k);
      }
      $out[$k] = rah_replace($item, $old, $new, $hadobj, $guard);
    }
    return $out;
  }
  if (is_object($v)) {
    // Leave objects untouched: re-building an arbitrary (possibly
    // incomplete) class instance is riskier than a reported residual.
    $hadobj = TRUE;
    return $v;
  }
  return $v;
}
$guard = (strpos($new, $old) !== FALSE);
$fixed = 0;
$objrows = array();
$broken = array();
$rows = db_query("SELECT name FROM {variable} WHERE value LIKE :pat",
  array(':pat' => '%' . db_like($old) . '%'))->fetchCol();
foreach ($rows as $name) {
  $raw = db_query("SELECT value FROM {variable} WHERE name = :n",
    array(':n' => $name))->fetchField();
  $val = @unserialize($raw);
  if ($val === FALSE && $raw !== serialize(FALSE)) {
    $broken[] = $name;
    continue;
  }
  $hadobj = FALSE;
  variable_set($name, rah_replace($val, $old, $new, $hadobj, $guard));
  if ($hadobj) {
    $objrows[] = $name;
  }
  $fixed++;
}
print "RAH: variables re-serialized: " . $fixed . "\n";
if (count($objrows)) {
  print "RAH: object values left untouched in: " . implode(', ', $objrows) . "\n";
}
if (count($broken)) {
  print "RAH: unserialize already failing (left as-is): " . implode(', ', $broken) . "\n";
}
print "RAH-DONE\n";
PHPEOF
  } > "${_PHP}"
  chmod 644 "${_PHP}"

  if _run_as_aegir "drush8 @hostmaster php-script ${_PHP}" > "${_VOUT}" 2>&1 \
    && grep -q '^RAH-DONE' "${_VOUT}"; then
    grep '^RAH: ' "${_VOUT}" | sed 's/^RAH: /  /'
    rm -f "${_PHP}" "${_VOUT}"
  else
    _alrt "serialized variable repair did not confirm — last 15 lines:"
    tail -n 15 "${_VOUT}"
    _alrt "full output kept: ${_VOUT}; script kept: ${_PHP}"
  fi
  return 0
}

_rename_in_database() {
  _info "§5 Renaming hostname in Aegir database (${_AEGIR_DB}) ..."

  _TS=$(date +%Y%m%d_%H%M%S)
  _DUMP_ORIG="${_BACKUP_DIR}/aegirdb_${_TS}_orig.sql"

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would dump ${_AEGIR_DB} to ${_DUMP_ORIG} (backup only)"
    _info "(dry-run) Would run serialize-safe UPDATEs: '${_OLD_HOST}' -> '${_NEW_HOST}'"
    _info "(dry-run) Would repair serialized variable values via drush php-script"
    return
  fi

  mkdir -p "${_BACKUP_DIR}"
  # The php-script pass below runs as ${_AEGIR_USER} and must read its
  # staged script from this root-created dir even under a strict root
  # umask. Nothing here is secret from that user — the dumps are the
  # account's own hostmaster DB.
  chmod 755 "${_BACKUP_DIR}"

  # Backup only — never sed-patched, never re-imported
  _info "  Dumping ${_AEGIR_DB} (pre-rename backup) ..."
  mysqldump \
    --defaults-file=/root/.my.cnf \
    --single-transaction \
    --quick \
    --no-autocommit \
    --skip-add-locks \
    --no-tablespaces \
    --hex-blob \
    "${_AEGIR_DB}" \
    > "${_DUMP_ORIG}"

  if [ ! -s "${_DUMP_ORIG}" ]; then
    _die "mysqldump produced an empty file: ${_DUMP_ORIG}"
  fi

  _info "  Backup size: $(du -sh "${_DUMP_ORIG}" | cut -f1), kept in ${_BACKUP_DIR}"

  # Identity rows first, keyed by hosting_context nid (aegir2boa-stage2
  # pattern): server verifies regenerate remote_host FROM the server node
  # title, so it must become the new FQDN even when the stored title is not
  # the exact string the sweeps below key on (e.g. a short nodename).
  local _SRV_NID _HM_NID
  _SRV_NID=$(_sql "SELECT nid FROM hosting_context WHERE name = 'server_master'")
  _HM_NID=$(_sql "SELECT nid FROM hosting_context WHERE name = 'hostmaster'")
  _SRV_NID=${_SRV_NID//[^0-9]/}
  _HM_NID=${_HM_NID//[^0-9]/}
  if [ -z "${_SRV_NID}" ] || [ -z "${_HM_NID}" ]; then
    _die "hosting_context misses server_master/hostmaster — ${_AEGIR_DB} is not an Aegir hostmaster DB?"
  fi
  # The hostmaster REPLACE carries the same already-renamed guard as
  # _sql_replace_col: on a forced re-run with NEW containing OLD it would
  # otherwise double the title. The server_master SET is idempotent as-is.
  local _HMG=""
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _HMG=" AND title NOT LIKE '%${_NEW_HOST}%'" ;;
  esac
  _sql "UPDATE node SET title = '${_NEW_HOST}' WHERE nid = ${_SRV_NID}"
  _sql "UPDATE node_revision SET title = '${_NEW_HOST}' WHERE nid = ${_SRV_NID}"
  _sql "UPDATE node SET title = REPLACE(title, '${_OLD_HOST}', '${_NEW_HOST}') WHERE nid = ${_HM_NID}${_HMG}"
  _sql "UPDATE node_revision SET title = REPLACE(title, '${_OLD_HOST}', '${_NEW_HOST}') WHERE nid = ${_HM_NID}${_HMG}"
  _info "  Identity rows updated (server_master nid ${_SRV_NID}, hostmaster nid ${_HM_NID})"

  # Plain-varchar sweeps: REPLACE() cannot corrupt these columns, and they
  # cover panel contexts plus sites/aliases living on subdomains of the
  # renamed FQDN — the same scope the old blanket sed renamed here.
  _sql_replace_col hosting_context name
  _sql_replace_col node title
  _sql_replace_col node_revision title
  _sql_replace_col hosting_platform publish_path
  _sql_replace_col hosting_site_alias alias
  _sql_replace_col hosting_site_alias redirection
  _sql_replace_col users mail
  _sql_replace_col users init

  _repair_serialized_variables

  # Drop the caches wholesale: cache blobs carried over from the old
  # hostname keep it inside serialized (often hex-dumped) values that no
  # safe rewrite should chase — everything in them regenerates.
  _run_as_aegir "drush8 @hostmaster cc all" > /dev/null 2>&1 \
    || _alrt "drush cc all returned non-zero after the DB rename"

  # Honest residual report — task history keeps old-host rows by design.
  # Same already-renamed guard as the sweeps, so a NEW-contains-OLD rename
  # does not count every renamed value as residual forever.
  local _RES_VAR="n/a" _RES_TASKS="n/a" _RG=""
  case "${_NEW_HOST}" in
    *"${_OLD_HOST}"*) _RG=" AND value NOT LIKE '%${_NEW_HOST}%'" ;;
  esac
  if _sql_table_exists variable; then
    _RES_VAR=$(_sql "SELECT COUNT(*) FROM variable WHERE value LIKE '%${_OLD_HOST}%'${_RG}")
  fi
  if _sql_table_exists hosting_task_arguments; then
    _RES_TASKS=$(_sql "SELECT COUNT(*) FROM hosting_task_arguments WHERE value LIKE '%${_OLD_HOST}%'${_RG}")
  fi
  _info "  Residual '${_OLD_HOST}' refs: variable=${_RES_VAR} task-history=${_RES_TASKS}"

  _info "  DB rename complete. Pre-rename backup kept in ${_BACKUP_DIR}"
}

###-------------§6 RELOAD NGINX----------###

_reload_nginx() {
  _info "§6 Reloading nginx ..."
  _maybe_run nginx -t
  _maybe_run service nginx reload
}

###-------------§7 AEGIR TASK QUEUE------###

_run_as_aegir() {
  # Run a drush command as the Aegir user derived from the aegir root path.
  # Uses login shell (-) so .bash_profile is sourced and drush PATH is set.
  su -s /bin/bash - "${_AEGIR_USER}" -c "$1"
}

_run_aegir_tasks() {
  _info "§7 Flushing Drush cache and running Aegir task queue (5 passes) ..."
  _info "    Each pass: cc drush + server verify tasks + dispatch + hosting-tasks"
  _info "    This regenerates aliases, db-host entries, and nginx vhosts on disk."

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would run 5 passes of drush cc + hosting task queue"
    return
  fi

  local _pass
  for _pass in 1 2 3 4 5; do
    _info "  Pass ${_pass}/5 ..."

    _run_as_aegir "drush8 cc drush > /dev/null 2>&1"

    _run_as_aegir "drush8 @hostmaster \
      hosting-task @server_master verify --force"

    _run_as_aegir "drush8 @hostmaster \
      hosting-task @server_localhost verify --force"

    _run_as_aegir "drush8 @hostmaster hosting-dispatch"

    sleep 10

    _run_as_aegir "drush8 @hostmaster hosting-tasks --force"

    sleep 10

    _info "  Pass ${_pass}/5 complete"
  done

  _info "§7 Aegir task queue complete"
}

###-------------§8 HOSTMASTER VERIFY-----###

_verify_hostmaster() {
  # §7's queued tasks verify only the SERVER contexts; the hostmaster SITE's
  # own settings.php (file paths etc.) is re-rendered only by a provision
  # verify of the site itself -- without it the panel answers HTTP 400 on
  # the new hostname.
  _info "§8 Synchronous hostmaster site verify (regenerates settings.php) ..."

  if [ "${_DRY_RUN}" = "YES" ]; then
    _info "(dry-run) Would run: drush8 @hostmaster provision-verify"
    return
  fi

  # Capture the verify output: during a migration cutover this is the step
  # most likely to hiccup, and a bare ALRT with the detail thrown away left
  # nothing to debug with.
  local _VLOG
  _VLOG="${_BACKUP_DIR}/hm_verify_$(date +%Y%m%d_%H%M%S).log"
  mkdir -p "${_BACKUP_DIR}"
  if _run_as_aegir "drush8 @hostmaster provision-verify" > "${_VLOG}" 2>&1; then
    rm -f "${_VLOG}"
  else
    _alrt "hostmaster provision-verify returned non-zero — last 15 lines:"
    tail -n 15 "${_VLOG}"
    _alrt "full output kept: ${_VLOG}"
  fi

  _info "§8 Hostmaster site verify complete"
}

###-------------SUMMARY------------------###

_print_summary() {
  echo ""
  echo "======================================================"
  if [ "${_DRY_RUN}" = "YES" ]; then
    echo "  DRY-RUN complete — no files were modified"
  else
    echo "  Rename complete"
  fi
  echo "  Aegir root   : ${_AEGIR_ROOT}"
  echo "  Old hostname : ${_OLD_HOST}"
  echo "  New hostname : ${_NEW_HOST}"
  echo "======================================================"
  echo ""
}

###-------------MAIN---------------------###

_check_root
_detect_old_hostname
_detect_new_hostname
_backup_files
_rename_hostmaster_site_dir
_rewrite_drush_files
_rewrite_vhosts
_rewrite_octopus_cnf
_detect_aegir_db
_rename_in_database
_reload_nginx
_run_aegir_tasks
_verify_hostmaster
_print_summary

exit 0
