###----------------------------------------###
### How To: Launch AUTO-INIT properly      ###
###----------------------------------------###
###
###  Use clean minimal Debian OS based VPS.
###
###  Initialise the system before installing
###  BOA to remove systemd and quickly
###  upgrade to latest Devuan OS version.
###
###   $ wget -qO- http://files.aegir.cc/BOA.sh.txt | bash
###   $ autoinit
###
###  Once started, the autoinit will launch
###  a series of upgrades and reboots until
###  you get a basic latest system installed
###  to be able to run standard BOA install.
###
###  The script logs its actions in the files
###  you can examine later:
###
###   $ cat /root/.autoinit.log
###
###  There's also a very verbose extra log:
###
###   $ cat /root/.autoinit-verbose.log
###
###----------------------------------------###


###----------------------------------------###
### DON'T EDIT ANYTHING BELOW THIS LINE    ###
###----------------------------------------###

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=dev

###
### Variables
###
_initFile="/root/.init-to-devuan-ctrl.cnf"
_barCnf="/root/.barracuda.cnf"
_logInt="/root/.autoinit.log"
_logSlt="/root/.autoinit-verbose.log"
_aptAllow="--allow-unauthenticated"
_INITINS="/usr/bin/apt-get ${_aptAllow} -y install"
_dstUpArg="-fuy -q ${_aptAllow} --config-file /opt/apt/apt.conf.noi.dist"
_nrmUpArg="-fuy -q ${_aptAllow} --config-file /opt/apt/apt.conf.noi.nrml"

###
### Avoid too many questions
###
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
if [ -z "${TERM+x}" ]; then
  export TERM=vt100
fi

###
### The lock is always cleared even if apt bails
###
trap 'rm -f /run/autoinit.pid' EXIT

###
### Noticeable messages
###
_msg() {
  echo "AutoInit v.${_tRee} [$(date +%T)] ==> $*"
}

###
### Only root allowed
###
_init_root() {
  if [ "$(id -u)" -eq 0 ]; then
    [ -e "/var/lib/man-db/auto-update" ] && rm -f /var/lib/man-db/auto-update
  else
    _msg "[init] root ==> ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST=$(df -kTh / -l \
    | grep '/' \
    | sed 's/\%//g' \
    | awk '{print $6}' >> "${_logSlt}")
  _DF_TEST=${_DF_TEST//[^0-9]/}
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    _msg "[init] root ==> ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    _msg "[init] root ==> ERROR: We can not proceed until it is below 90/100"
    sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
    sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
    exit 1
  fi
}

###
### Atomic unlock to prevent TOCTOU race
###
_single_instance_unlock() {
  _FD="$1"; _PATH="$2"
  if command -v flock >/dev/null 2>&1; then
    flock -u "${_FD}" 2>/dev/null || true
    eval "exec ${_FD}>&-"
    rm -f "${_PATH}" 2>/dev/null || true
  else
    rm -rf "${_PATH}" 2>/dev/null || true
  fi
}

###
### Atomic lock to prevent TOCTOU race
###
_single_instance_lock() {
  # Ensure not too many instances are running
  # usage: _single_instance_lock [lockfile_path] [fd]
  # default lock: /run/<script>.lock (falls back to /run or /tmp)
  _SELF_NAME="${_SELF_NAME:-$(basename "$0")}"
  _LOCK_FD="${2:-9}"
  if [ -n "${1:-}" ]; then
    _LOCK_PATH="$1"
  else
    _DIR="/run"; [ -w "$_DIR" ] || _DIR="/run"; [ -w "$_DIR" ] || _DIR="/tmp"
    _LOCK_PATH="${_DIR}/${_SELF_NAME%.sh}.lock"
  fi

  if command -v flock >/dev/null 2>&1; then
    eval "exec ${_LOCK_FD}>\"${_LOCK_PATH}\""
    if ! flock -n "${_LOCK_FD}"; then
      echo "${_SELF_NAME}: another instance is running; exiting."
      exit 0
    fi
    printf '%s\n' "$$" 1>&"${_LOCK_FD}" 2>/dev/null || true   # optional: PID note
    trap "_single_instance_unlock ${_LOCK_FD} '${_LOCK_PATH}'" EXIT INT TERM HUP
  else
    # mkdir is atomic; directory presence == lock held
    if ! mkdir "${_LOCK_PATH}" 2>/dev/null; then
      echo "${_SELF_NAME}: another instance is running; exiting."
      exit 0
    fi
    echo "$$" > "${_LOCK_PATH}/pid" 2>/dev/null || true
    trap "rm -rf '${_LOCK_PATH}'" EXIT INT TERM HUP
  fi
}

###
### Mode selection
###
_init_mode() {
  # Usage: autoinit [minimal|full] [vanilla|classic|predictable]
  # Default: "minimal". Persisted across reboots via cron argument.
  if [ -z "${_SET_MODE}" ]; then
    case "${1:-minimal}" in
      minimal|*) _SET_MODE="minimal" ;;
      full)      _SET_MODE="full" ;;
    esac
  fi
  if [ ! -e "/root/.mode.selected.${_SET_MODE}.cnf" ]; then
    touch /root/.mode.selected.${_SET_MODE}.cnf
    chattr +i /root/.mode.selected.${_SET_MODE}.cnf
  fi
  _msg "[init] mode ==> Mode selected: ${_SET_MODE}" >> "${_logInt}"
}

###
### Networking Interface Naming Convention
###
_init_ninc() {
  # Usage: autoinit [minimal|full] [vanilla|classic|predictable]
  # Default: "vanilla". Persisted across reboots via cron argument.
  if [ -z "${_SET_NINC}" ]; then
    case "${2:-vanilla}" in
      vanilla|*)   _SET_NINC="vanilla" ;;
      auto)        _SET_NINC="auto" ;;
      classic)     _SET_NINC="classic" ;;
      predictable) _SET_NINC="predictable" ;;
    esac
  fi
  if [ ! -e "/root/.ninc.selected.${_SET_NINC}.cnf" ]; then
    touch /root/.ninc.selected.${_SET_NINC}.cnf
    chattr +i /root/.ninc.selected.${_SET_NINC}.cnf
  fi
  _msg "[init] ninc ==> NINC selected: ${_SET_NINC}" >> "${_logInt}"
}

###
### Check Manufacturer Compatibility
###
_init_mnfr() {
  # Install dmidecode if not present
  if ! command -v dmidecode &> /dev/null; then
    /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
    /usr/bin/dpkg --configure -a >> "${_logSlt}"
    ${_INITINS} dmidecode &> /dev/null
  fi
  # Check if dmidecode is available
  _DMI_TEST="$(which dmidecode)"
  if [ -x "${_DMI_TEST}" ]; then
    _HOST_INFO="$(dmidecode -s system-manufacturer)"
  else
    _HOST_INFO="Unknown, dmidecode not available"
  fi
  # Check for Amazon EC2 in the system manufacturer field
  if dmidecode -s system-manufacturer | grep -i 'Amazon EC2' &> /dev/null; then
    _VMFAMILY="AWS"
    _msg "[init] mnfr ==> Not supported environment detected: ${_HOST_INFO}" >> "${_logInt}"
    _msg "[init] mnfr ==> Please check https://bit.ly/boa-caveats" >> "${_logInt}"
    _msg "[init] mnfr ==> Bye!" >> "${_logInt}"
    echo "[init] mnfr ==> Not supported environment detected: ${_HOST_INFO}"
    echo "[init] mnfr ==> Please check https://bit.ly/boa-caveats"
    echo "[init] mnfr ==> Bye!"
    sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
    sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
    exit 1
  elif [[ "${_HOST_INFO}" =~ "Unknown" ]] || [ -z "${_HOST_INFO}" ]; then
    _msg "[init] mnfr ==> Mysterious environment: ${_HOST_INFO}" >> "${_logInt}"
    _msg "[init] mnfr ==> Please check https://bit.ly/boa-caveats" >> "${_logInt}"
    _msg "[init] mnfr ==> Bye!" >> "${_logInt}"
    echo "[init] mnfr ==> Mysterious environment: ${_HOST_INFO}"
    echo "[init] mnfr ==> Please check https://bit.ly/boa-caveats"
    echo "[init] mnfr ==> Bye!"
    sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
    sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
    exit 1
  fi
}

###
### Check Aegir
###
_init_aegir() {
  if [ -e "/var/aegir" ]; then
    echo
    echo "[init] aegir ==> ERROR: This script can not be used once BOA is installed"
    echo
    sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
    exit 1
  fi
}

###
### Check Systemd
###
_init_no_systemd() {
  if [ -e "/lib/systemd/systemd" ]; then
    echo " " >> "${_logInt}"
    _msg "[init] nosd ==> OOPS: Systemd still not removed cleanly" >> "${_logInt}"
    echo " " >> "${_logInt}"
  fi
}

###
### Fix locales
###
_init_locales() {
  _isLoc="$(which locale)"
  if [ ! -x "${_isLoc}" ] || [ -z "${_isLoc}" ]; then
    /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
    /usr/bin/dpkg --configure -a >> "${_logSlt}"
    ${_INITINS} locales &> /dev/null
    [ "${_SET_MODE}" = "full" ] && ${_INITINS} locales-all &> /dev/null
  fi
  _LOC_TEST=$(locale 2>&1)
  if [[ "${_LOC_TEST}" =~ LANG=.*UTF-8 ]]; then
    _LOCALE_TEST=OK
  fi
  if [[ "${_LOC_TEST}" =~ "Cannot" ]]; then
    _LOCALE_TEST=BROKEN
  fi
  if [ "${_LOCALE_TEST}" = "BROKEN" ]; then
    _LOCALE_GEN_TEST=$(grep -v "^#" /etc/locale.gen 2>&1)
    if [[ ! "${_LOCALE_GEN_TEST}" =~ "en_US.UTF-8 UTF-8" ]]; then
      echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
    fi
    sed -i "/^$/d" /etc/locale.gen
    locale-gen &> /dev/null
    locale-gen en_US.UTF-8 &> /dev/null
    # Explicitly enforce all locale settings
    update-locale \
      LANG=en_US.UTF-8 \
      LC_CTYPE=en_US.UTF-8 \
      LC_COLLATE=POSIX \
      LC_NUMERIC=POSIX \
      LC_TIME=en_US.UTF-8 \
      LC_MONETARY=en_US.UTF-8 \
      LC_MESSAGES=en_US.UTF-8 \
      LC_PAPER=en_US.UTF-8 \
      LC_NAME=en_US.UTF-8 \
      LC_ADDRESS=en_US.UTF-8 \
      LC_TELEPHONE=en_US.UTF-8 \
      LC_MEASUREMENT=en_US.UTF-8 \
      LC_IDENTIFICATION=en_US.UTF-8 \
      LC_ALL= &> /dev/null
    # Define all locale settings on the fly to prevent unnecessary
    # warnings during installation of packages.
    export LANG=en_US.UTF-8 &> /dev/null
    export LC_CTYPE=en_US.UTF-8 &> /dev/null
    export LC_COLLATE=POSIX &> /dev/null
    export LC_NUMERIC=POSIX &> /dev/null
    export LC_TIME=en_US.UTF-8 &> /dev/null
    export LC_MONETARY=en_US.UTF-8 &> /dev/null
    export LC_MESSAGES=en_US.UTF-8 &> /dev/null
    export LC_PAPER=en_US.UTF-8 &> /dev/null
    export LC_NAME=en_US.UTF-8 &> /dev/null
    export LC_ADDRESS=en_US.UTF-8 &> /dev/null
    export LC_TELEPHONE=en_US.UTF-8 &> /dev/null
    export LC_MEASUREMENT=en_US.UTF-8 &> /dev/null
    export LC_IDENTIFICATION=en_US.UTF-8 &> /dev/null
    export LC_ALL= &> /dev/null
  else
    _LOCALE_GEN_TEST=$(grep -v "^#" /etc/locale.gen 2>&1)
    if [[ ! "${_LOCALE_GEN_TEST}" =~ "en_US.UTF-8 UTF-8" ]]; then
      echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
    fi
    sed -i "/^$/d" /etc/locale.gen
    locale-gen &> /dev/null
    locale-gen en_US.UTF-8 &> /dev/null
    # Explicitly enforce locale settings required for consistency
    update-locale \
      LANG=en_US.UTF-8 \
      LC_CTYPE=en_US.UTF-8 \
      LC_COLLATE=POSIX \
      LC_NUMERIC=POSIX \
      LC_ALL= &> /dev/null
    # Define locale settings required for consistency also on the fly
    export LC_COLLATE=POSIX &> /dev/null
    export LC_NUMERIC=POSIX &> /dev/null
    export LC_ALL= &> /dev/null
  fi
  _LOCALES_BASHRC_TEST=$(grep LC_COLLATE /root/.bashrc 2>&1)
  if [[ ! "${_LOCALES_BASHRC_TEST}" =~ "LC_COLLATE" ]]; then
    printf "\n" >> /root/.bashrc
    echo "export LANG=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_CTYPE=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_COLLATE=POSIX" >> /root/.bashrc
    echo "export LC_NUMERIC=POSIX" >> /root/.bashrc
    echo "export LC_TIME=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_MONETARY=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_MESSAGES=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_PAPER=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_NAME=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_ADDRESS=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_TELEPHONE=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_MEASUREMENT=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_IDENTIFICATION=en_US.UTF-8" >> /root/.bashrc
    echo "export LC_ALL=" >> /root/.bashrc
    printf "\n" >> /root/.bashrc
  fi
}

###
### Check cron
###
_init_cron() {
  _isCrn="$(which cron)"
  if [ ! -x "${_isCrn}" ] || [ -z "${_isCrn}" ]; then
    /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
    /usr/bin/dpkg --configure -a >> "${_logSlt}"
    ${_INITINS} cron >> "${_logSlt}"
  fi
}

###
### Should we launch boa install?
###
_if_launch_boa_install() {
  _BOA_LOGFILE="/root/.boa.install.command.cnf"
  if [[ -s "${_BOA_LOGFILE}" ]]; then
    _BOA_COMMAND=$(cat "${_BOA_LOGFILE}")
    _BOA_COMMAND=$(echo "${_BOA_COMMAND}" | sed -E "s/noscreen//g")
    if [[ "${_BOA_COMMAND}" =~ " silent" ]] \
      || [[ "${_BOA_COMMAND}" =~ " system" ]]; then
      _BOA_INSTALL_COMMAND="${_BOA_COMMAND}"
    else
      _BOA_INSTALL_COMMAND="${_BOA_COMMAND} silent"
    fi
    if [[ "${_BOA_COMMAND}" =~ "boa in-lts" ]] \
      || [[ "${_BOA_COMMAND}" =~ "boa in-dev" ]]; then
      _msg "_if_launch_boa_install ==> Time for ${_BOA_INSTALL_COMMAND} noscreen" >> "${_logInt}"
      eval "${_BOA_INSTALL_COMMAND} noscreen"
      wait
      mv -f ${_BOA_LOGFILE} /var/backups/
    fi
  fi
}

###
### Disable AppArmor
###
_disable_apparmor_utils() {
  if [ -e "/etc/apparmor.d" ] && [ -e "/var/cache/apparmor" ]; then
    rm -rf /var/cache/apparmor/* &> /dev/null
    apparmor_parser -r /etc/apparmor.d/* &> /dev/null
    aa-complain /etc/apparmor.d/* &> /dev/null
  fi
  if [ -x "/etc/init.d/apparmor" ]; then
    service apparmor stop &> /dev/null
    update-rc.d -f apparmor remove &> /dev/null
    service auditd stop &> /dev/null
    update-rc.d -f auditd remove &> /dev/null
  fi
  if [ -x "/usr/sbin/aa-teardown" ]; then
    aa-teardown &> /dev/null
  fi
  [ ! -e "/root/.disable.apparmor.cnf" ] && touch /root/.disable.apparmor.cnf
}

###
### Install AppArmor
###
_install_apparmor() {
  _isAppArmorRevFile="/sys/kernel/security/apparmor/revision"
  _isAppArmorGrubFile="/etc/default/grub.d/apparmor.cfg"
  _isAppArmorComplain="$(which aa-complain)"
  _isAppArmorStatus="$(which aa-status)"
  _isAppArmorGrub=NO
  if [ -e "${_isAppArmorGrubFile}" ]; then
    _GRUB_APPARMOR_TEST=$(grep "apparmor=1 security=apparmor" ${_isAppArmorGrubFile})
    if [[ "${_GRUB_APPARMOR_TEST}" =~ "apparmor=1 security=apparmor" ]]; then
      _isAppArmorGrub=YES
    fi
  fi
  if [ ! -e "${_isAppArmorRevFile}" ] \
    || [ ! -e "${_isAppArmorGrubFile}" ] \
    || [ -z "${_isAppArmorComplain}" ] \
    || [ -z "${_isAppArmorStatus}" ] \
    || [ "${_isAppArmorGrub}" = "NO" ]; then
    _msg "_install_apparmor ==> Installing AppArmor Tools early..." >> "${_logInt}"
    echo " " >> "${_logInt}"
    ${_INITINS} auditd \
      apparmor \
      apparmor-utils \
      apparmor-notify \
      apparmor-profiles -qq >> "${_logSlt}"
    mkdir -p /etc/default/grub.d
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT apparmor=1 security=apparmor"' \
      | tee ${_isAppArmorGrubFile} &> /dev/null
    update-grub >> "${_logSlt}"
  fi
  _isAppArmOn=N
  if [ -e "/sys/module/apparmor/parameters/enabled" ]; then
    _isAppArmOn="$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null | tr -d '\n')"
  fi
  if [ "${_isAppArmOn}" = "Y" ]; then
    _disable_apparmor_utils
  fi
}

###
### Grub and Ifnames
###
_ifnames_grub() {

  _USE_NINC=NO
  _NEW_GRUB=DEMO

  if [ -e "/root/.ignore.ifnames.cnf" ]; then
    return 1  # Exit the function but continue the script
  else
    [ -e "/root/.ninc.selected.predictable.cnf" ] && _USE_NINC=predictable && _NEW_GRUB=LIVE
    [ -e "/root/.ninc.selected.classic.cnf" ]     && _USE_NINC=classic     && _NEW_GRUB=LIVE
    [ -e "/root/.ninc.selected.auto.cnf" ]        && _USE_NINC=auto        && _NEW_GRUB=LIVE
    [ -e "/root/.ninc.selected.vanilla.cnf" ]     && _USE_NINC=vanilla
  fi

  if [ "${_USE_NINC}" = "vanilla" ] || [ "${_USE_NINC}" = "NO" ]; then
    return 1  # Exit the function but continue the script
  fi

  _IS_IFACE=$(ip a 2>&1)
  _ADD_GRUB_CMD=""
  _GRUB_FILE="/etc/default/grub"

  if [ -e "${_GRUB_FILE}" ]; then
    if echo "${_IS_IFACE}" | grep -qE "eth[0-9]+"; then
      _USE_IFNAMES="CLASSIC"
      _msg "_ifnames_grub ==> GRUB: Classic ethX interface naming found." >> "${_logInt}"
    elif echo "${_IS_IFACE}" | grep -qE "(ens|enp|eno|wlp|wlo)[0-9]+:"; then
      _USE_IFNAMES="PREDICTABLE"
      _msg "_ifnames_grub ==> GRUB: Predictable (ensX, enpX, enoX, wlpX, wloX) interface naming found." >> "${_logInt}"
    else
      _USE_IFNAMES="DONTMODIFY"
      _msg "_ifnames_grub ==> GRUB: config exists, but no recognized network interface naming found." >> "${_logInt}"
    fi

    # Extract the current GRUB_CMDLINE_LINUX line
    _GRUB_CMDLINE_LINUX=$(grep -E "^GRUB_CMDLINE_LINUX=" "${_GRUB_FILE}")
    _msg "_ifnames_grub ==> GRUB: Current config is ${_GRUB_CMDLINE_LINUX}" >> "${_logInt}"

    # Initialize variables to check for existing options
    _SYS_NET_IFNAMES=$(echo "${_GRUB_CMDLINE_LINUX}" | grep -o "net.ifnames=[01]")
    _SYS_BIOSDEVNAME=$(echo "${_GRUB_CMDLINE_LINUX}" | grep -o "biosdevname=[01]")
    _SYS_MEMHP_STATE=$(echo "${_GRUB_CMDLINE_LINUX}" | grep -o "memhp_default_state=online")

    # Function to append option to _ADD_GRUB_CMD
    _append_grub_cmd_option() {
      _option="$1"
      if [[ -z "${_ADD_GRUB_CMD}" ]]; then
        _ADD_GRUB_CMD="${_option}"
      else
        _ADD_GRUB_CMD="${_ADD_GRUB_CMD} ${_option}"
      fi
    }

    # Always add memhp_default_state=online
    _append_grub_cmd_option "memhp_default_state=online"

    if [[ "${_USE_IFNAMES}" == "CLASSIC" ]]; then
      # Always set net.ifnames=0 and biosdevname=0
      _append_grub_cmd_option "net.ifnames=0"
      _append_grub_cmd_option "biosdevname=0"
    elif [[ "${_USE_IFNAMES}" == "PREDICTABLE" ]]; then
      # Always set net.ifnames=1 and biosdevname=1
      _append_grub_cmd_option "net.ifnames=1"
      _append_grub_cmd_option "biosdevname=1"
    fi

    if [[ -n "${_ADD_GRUB_CMD}" ]]; then
      # Backup the GRUB file
      cp "${_GRUB_FILE}" "${_GRUB_FILE}.bak"

      # Remove existing options from GRUB_CMDLINE_LINUX
      _NEW_GRUB_CMDLINE_LINUX=$(echo "${_GRUB_CMDLINE_LINUX}" | sed -E "s/(net.ifnames=[01]|biosdevname=[01]|memhp_default_state=online)//g")

      # Clean up extra spaces and trailing spaces before the closing quote
      _NEW_GRUB_CMDLINE_LINUX=$(echo "${_NEW_GRUB_CMDLINE_LINUX}" | tr -s ' ' | sed -E 's/\s*"$/"/')

      # Extract current kernel parameters
      _CURRENT_CMDLINE=$(echo "${_NEW_GRUB_CMDLINE_LINUX}" | sed -E 's/^GRUB_CMDLINE_LINUX="(.*)"$/\1/')

      # Append new options
      _UPDATED_CMDLINE="${_CURRENT_CMDLINE} ${_ADD_GRUB_CMD}"
      _UPDATED_CMDLINE=$(echo "${_UPDATED_CMDLINE}" | sed 's/^ *//;s/ *$//')

      # Form the new GRUB_CMDLINE_LINUX line
      _NEW_GRUB_CMDLINE_LINUX="GRUB_CMDLINE_LINUX=\"${_UPDATED_CMDLINE}\""

      echo " " >> "${_logInt}"
      if [[ "${_NEW_GRUB}" == "LIVE" ]]; then
        # Update the GRUB file
        _msg "_ifnames_grub ==> GRUB: Networking Interface Naming Convention selected: ${_USE_NINC}" >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: Update in the LIVE MODE" >> "${_logInt}"
        sed -i "s|^GRUB_CMDLINE_LINUX=.*|${_NEW_GRUB_CMDLINE_LINUX}|" "${_GRUB_FILE}"
        _msg "_ifnames_grub ==> GRUB_CMDLINE_LINUX has been updated with ${_UPDATED_CMDLINE}" >> "${_logInt}"
      elif [[ "${_NEW_GRUB}" == "DEMO" ]]; then
        # Demo info
        _msg "_ifnames_grub ==> GRUB: Networking Interface Naming Convention selected: ${_USE_NINC}" >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: Update in the DEMO MODE" >> "${_logInt}"
        echo " " >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB_CMDLINE_LINUX would be updated with:" >> "${_logInt}"
        _msg "   ${_UPDATED_CMDLINE}" >> "${_logInt}"
        echo " " >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: Update in the LIVE MODE requires presence of control file:" >> "${_logInt}"
        _msg "   /root/.ninc.selected.auto.cnf" >> "${_logInt}"
        echo " "
        _msg "_ifnames_grub ==> GRUB: Note that this extra control file must not exist:" >> "${_logInt}"
        _msg "   /root/.ignore.ifnames.cnf" >> "${_logInt}"
        echo " " >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: This requirement serves as a double-check to confirm" >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: that you are aware of and agree to auto-update GRUB configuration." >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: Incorrect GRUB settings can render your virtual machine unbootable" >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: necessitating a rescue operation using a CD-ROM or ISO image." >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: For this reason, running BOA directly on physical hardware (bare metal) is not supported" >> "${_logInt}"
        echo " " >> "${_logInt}"
        _msg "_ifnames_grub ==> GRUB: NEVER USE LIVE MODE IF YOU ARE NOT SURE IF YOU NEED IT" >> "${_logInt}"
      fi
      echo " " >> "${_logInt}"
    fi
  else
    _msg "_ifnames_grub ==> GRUB config does not exist." >> "${_logInt}"
  fi
}

###
### Prefer Devuan APT sources
###
_prefer_devuan_repositories() {
  # Prefer Devuan; force base-files from Devuan (handles lower version vs Debian).
  mkdir -p /etc/apt/preferences.d
  cat >/etc/apt/preferences.d/99-prefer-devuan <<'EOF'
Package: *
Pin: release o=Devuan
Pin-Priority: 700

Package: base-files
Pin: release o=Devuan
Pin-Priority: 1001
EOF
  /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
  /usr/bin/dpkg --configure -a >> "${_logSlt}"
}

###
### Prepare system
###
_init_prepare() {
  if [ ! -e "/etc/apt/apt.conf.d/00sandboxoff" ] \
    && [ -e "/etc/apt/apt.conf.d" ]; then
    echo "APT::Sandbox::User \"root\";" > /etc/apt/apt.conf.d/00sandboxoff
  fi
  if [ ! -e "/opt/apt/apt.conf.noi.dist" ] \
    || [ ! -e "/opt/apt/apt.conf.noi.nrml" ]; then
    mkdir -p /opt/apt
    echo "APT::Get::Assume-Yes \"true\";" > /opt/apt/apt.conf.noi.dist
    echo "APT::Get::Show-Upgraded \"true\";" >> /opt/apt/apt.conf.noi.dist
    echo "APT::Get::Install-Recommends \"false\";" >> /opt/apt/apt.conf.noi.dist
    echo "APT::Get::Install-Suggests \"false\";" >> /opt/apt/apt.conf.noi.dist
    echo "APT::Quiet \"true\";" >> /opt/apt/apt.conf.noi.dist
    echo "DPkg::Options {\"--force-confnew\";\"--force-confmiss\";};" >> /opt/apt/apt.conf.noi.dist
    echo "DPkg::Pre-Install-Pkgs {\"/usr/sbin/dpkg-preconfigure --apt\";};" >> /opt/apt/apt.conf.noi.dist
    echo "Dir::Etc::SourceList \"/etc/apt/sources.list\";" >> /opt/apt/apt.conf.noi.dist
    echo "APT::Get::Assume-Yes \"true\";" > /opt/apt/apt.conf.noi.nrml
    echo "APT::Get::Show-Upgraded \"true\";" >> /opt/apt/apt.conf.noi.nrml
    echo "APT::Get::Install-Recommends \"false\";" >> /opt/apt/apt.conf.noi.nrml
    echo "APT::Get::Install-Suggests \"false\";" >> /opt/apt/apt.conf.noi.nrml
    echo "APT::Quiet \"true\";" >> /opt/apt/apt.conf.noi.nrml
    echo "DPkg::Options {\"--force-confdef\";\"--force-confmiss\";\"--force-confold\"};" >> /opt/apt/apt.conf.noi.nrml
    echo "DPkg::Pre-Install-Pkgs {\"/usr/sbin/dpkg-preconfigure --apt\";};" >> /opt/apt/apt.conf.noi.nrml
    echo "Dir::Etc::SourceList \"/etc/apt/sources.list\";" >> /opt/apt/apt.conf.noi.nrml
  fi

  ###
  ### Grub and Ifnames
  ###
  _ifnames_grub

  if [[ -n "${_ADD_GRUB_CMD}" ]] && [[ "${_NEW_GRUB}" == "LIVE" ]]; then
    touch /run/autoinit.pid
    update-grub >> "${_logSlt}"
    sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
    echo "*/1 *   * * *   root    bash /opt/local/bin/autoinit ${_SET_MODE} ${_USE_NINC}" >> /etc/crontab
    if [ -x "/opt/local/bin/killer" ]; then
      sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
      echo "*/1 *   * * *   root    bash /opt/local/bin/killer" >> /etc/crontab
    fi
    _msg "[init] prep ==> Time for reboot and next upgrade cycle..." >> "${_logInt}"
    echo " " >> "${_logInt}"
    if [ -e "/root/.manual-autoinit-reboot.cnf" ]; then
      service cron stop
      sleep 90
      rm -f /run/autoinit.pid
    else
      rm -f /run/autoinit.pid
      shutdown -r now
    fi
    exit 0
  else
    if [ ! -x "/usr/bin/mc" ]; then
      touch /run/autoinit.pid
      if [ -e "/root/.autoinit-early-upgrade.cnf" ]; then
        _msg "[init] prep ==> Let's update existing system first..." >> "${_logInt}"
        if pgrep -f unattended-upgrades >/dev/null 2>&1; then
          pkill -9 -f unattended-upgrades
        fi
        /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
        /usr/bin/dpkg --configure -a >> "${_logSlt}"
        /usr/bin/apt-get upgrade ${_nrmUpArg} >> "${_logSlt}"
        /usr/bin/dpkg --configure -a >> "${_logSlt}"
        /usr/bin/apt-get -f install ${_aptAllow} -y -qq >> "${_logSlt}"
      fi
      ${_INITINS} lsb-release >> "${_logSlt}"
      _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
      _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
      _msg "[init] prep ==> We need to install some tools early..." >> "${_logInt}"
      /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
      /usr/bin/dpkg --configure -a >> "${_logSlt}"
      if [ "${_SET_MODE}" = "full" ] && [ "${_VMFAMILY}" != "AWS" ]; then
        /usr/bin/apt-get remove chrony -y --purge --auto-remove -qq >> "${_logSlt}"
        _INITD_TEST=$(ls -la /etc/init.d/*cloud* 2>&1)
        _aptAkamaiLst="/etc/apt/sources.list.d/akamai-linux-team.list"
        _aptCloudInit="/etc/apt/preferences.d/99linode-cloudinit"
        _etcCloudCfgd="/etc/cloud/cloud.cfg.d"
        if [[ ! "${_INITD_TEST}" =~ "No such file" ]] \
          || [ -e "${_aptAkamaiLst}" ] \
          || [ -e "${_aptCloudInit}" ] \
          || [ -e "${_etcCloudCfgd}" ]; then
          /usr/bin/apt-get remove cloud-utils cloud-init -y --purge --auto-remove -qq >> "${_logSlt}"
          /usr/bin/apt-get remove cloud-image-utils cloud-guest-utils -y --purge --auto-remove -qq >> "${_logSlt}"
          /usr/bin/apt-get autoremove --purge -y >> "${_logSlt}"
          /usr/bin/apt-get autoclean -y >> "${_logSlt}"
          [ -e "${_etcCloudCfgd}" ] && mv -f /etc/cloud /var/backups/
          [ -e "${_aptAkamaiLst}" ] && mv -f ${_aptAkamaiLst} /var/backups/
          [ -e "${_aptCloudInit}" ] && mv -f ${_aptCloudInit} /var/backups/
        fi
      fi
      ${_INITINS} aptitude  >> "${_logSlt}"
      ${_INITINS} bc        >> "${_logSlt}"
      ${_INITINS} cron      >> "${_logSlt}"
      ${_INITINS} curl      >> "${_logSlt}"
      ${_INITINS} dnsutils  >> "${_logSlt}"
      ${_INITINS} hostname  >> "${_logSlt}"
      ${_INITINS} mc        >> "${_logSlt}"
      ${_INITINS} net-tools >> "${_logSlt}"
      ${_INITINS} netcat-traditional  >> "${_logSlt}"
      ${_INITINS} ntpsec-ntpdate      >> "${_logSlt}"
      if [ "${_SET_MODE}" = "full" ]; then
        ${_INITINS} build-essential   >> "${_logSlt}"
        ${_INITINS} git               >> "${_logSlt}"
        ${_INITINS} libgd-dev         >> "${_logSlt}"
        ${_INITINS} libmagickwand-dev >> "${_logSlt}"
      fi
      sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
      echo "*/1 *   * * *   root    bash /opt/local/bin/autoinit ${_SET_MODE} ${_USE_NINC}" >> /etc/crontab
      if [ -x "/opt/local/bin/killer" ]; then
        sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
        echo "*/1 *   * * *   root    bash /opt/local/bin/killer" >> /etc/crontab
      fi
      [ "${_SET_MODE}" = "full" ] && _install_apparmor
      touch ${_initFile}
      _msg "[init] prep ==> Time for reboot and next upgrade cycle..." >> "${_logInt}"
      echo " " >> "${_logInt}"
      if [ -e "/root/.manual-autoinit-reboot.cnf" ]; then
        service cron stop
        sleep 90
        rm -f /run/autoinit.pid
      else
        rm -f /run/autoinit.pid
        shutdown -r now
      fi
      exit 0
    fi
  fi
}

###
### Ensure Devuan base-files
###
_ensure_devuan_bf() {
  # Ensure Devuan base-files is applied so /etc/os-release reflects Devuan/daedalus
  _msg "_ensure_devuan_bf ==> Ensuring Devuan base-files is applied (force-confnew)" >> "${_logInt}"
  _BF_CANDIDATE=$(apt-cache policy base-files 2>/dev/null | awk '/Candidate: /{print $2; exit}')
  _APTOPTS="-o Dpkg::Options::=--force-confnew \
            -o Dpkg::Options::=--force-overwrite \
            -o Dpkg::Options::=--force-confdef"
  if [ ! -z "${_BF_CANDIDATE}" ]; then
    /usr/bin/apt-get ${_aptAllow} -y ${_APTOPTS} install \
    base-files="${_BF_CANDIDATE}" --allow-downgrades >> "${_logSlt}" 2>&1 || true
  else
    /usr/bin/apt-get ${_aptAllow} -y ${_APTOPTS} install \
    base-files --allow-downgrades >> "${_logSlt}" 2>&1 || true
  fi
  # If /etc/os-release still says Debian, try to refresh from the installed base-files
  if grep -qi 'ID=debian' /etc/os-release 2>/dev/null; then
    if [ -f /usr/lib/os-release ]; then
      cp -f /usr/lib/os-release /etc/os-release || true
    elif [ -f /usr/share/base-files/os-release ]; then
      cp -f /usr/share/base-files/os-release /etc/os-release || true
    fi
  fi
}


# --- BEGIN: Devuan Excalibur systemd → sysvinit keep-SSH helper ----

_pkg_installed() { /usr/bin/dpkg -s "$1" >/dev/null 2>&1; }

# Ensure anacron exists to satisfy logrotate alternatives when systemd is gone
_ensure_cron_provider() {
  if ! _pkg_installed "cron" && ! _pkg_installed "anacron"; then
    _msg "[init] Installing anacron as cron provider" >> "${_logInt}"
    ${_INITINS} anacron >> "${_logSlt}"
  fi
  /usr/bin/apt-mark manual anacron >> "${_logSlt}"
  _init_cron
}

# Install elogind before touching libsystemd0 (Devuan way)
_switch_to_elogind_stack() {
  _msg "[init] Installing elogind stack (libelogind0, libpam-elogind, compat)" >> "${_logInt}"
  ${_INITINS} libelogind0 libpam-elogind libelogind-compat >> "${_logSlt}"
}

# Build & install a minimal package that Provides: systemd (so openssh-server stays)
_install_systemd_dummy() {

  _msg "[init] Creating minimal systemd-dummy provider" >> "${_logInt}"
  _DROOT="/root/.autoinit-systemd-dummy"
  mkdir -p "${_DROOT}/DEBIAN"
  cat > "${_DROOT}/DEBIAN/control" <<'EOF'
Package: systemd-dummy
Version: 1.0
Section: base
Priority: optional
Architecture: all
Maintainer: Omega8cc Autoinit <root@localhost>
Provides: systemd
Description: Dummy package that provides 'systemd' virtual for sysvinit systems
EOF

  /usr/bin/dpkg-deb --build "${_DROOT}" >> "${_logSlt}"
  wait
  ${_INITINS} "${_DROOT}.deb" >> "${_logSlt}"

  # sanity check
  if ! /usr/bin/dpkg-query -W -f='${Provides}\n' systemd-dummy 2>/dev/null | grep 'systemd'; then
    echo "[init][ERROR] systemd-dummy failed to provide 'systemd'" >> "${_logInt}"
  fi
}

# Mark critical daemons as manual so metas/solver don't toss them
_protect_daemons() {
  _msg "[init] Marking core daemons manual: openssh, cron" >> "${_logInt}"
  /usr/bin/apt-mark manual ssh openssh-server openssh-sftp-server task-ssh-server >> "${_logSlt}"
  /usr/bin/apt-mark manual cron cron-daemon-common >> "${_logSlt}"
}

# Safety: ensure openssh-server present & configured now
_ensure_openssh_server() {
  if ! _pkg_installed "cron"; then
    _msg "[init] Installing cron" >> "${_logInt}"
    ${_INITINS} cron cron-daemon-common >> "${_logSlt}"
  fi
  if ! _pkg_installed "opensysusers"; then
    _msg "[init] Installing opensysusers" >> "${_logInt}"
    ${_INITINS} opensysusers >> "${_logSlt}"
  fi
  if ! _pkg_installed "openssh-server"; then
    _msg "[init] Installing openssh-server" >> "${_logInt}"
    ${_INITINS} ssh openssh-server openssh-sftp-server task-ssh-server >> "${_logSlt}"
  fi
  if ! _pkg_installed "ssh"; then
    _msg "[init] Installing ssh" >> "${_logInt}"
    ${_INITINS} ssh openssh-server openssh-sftp-server task-ssh-server >> "${_logSlt}"
  fi
  # (optional) make sure it is enabled under sysvinit
  if [ -x "/etc/init.d/ssh" ]; then
    service ssh status >/dev/null 2>&1 || service ssh start >> "${_logSlt}"
  fi
}

# Before real removal, simulate and auto-heal if SSH would be removed.
_purge_systemd_keep_ssh() {

  _install_systemd_dummy

  _msg "[init] Simulating 'apt-get remove systemd'" >> "${_logInt}"
  if /usr/bin/apt-get -s remove systemd 2>/dev/null | grep -E 'Remv (openssh-server|ssh)\b'; then
    _msg "[init] APT would remove SSH; installing dummy provider" >> "${_logInt}"
    _msg "[init] Re-simulating removal" >> "${_logInt}"
    if /usr/bin/apt-get -s remove systemd 2>/dev/null | grep -E 'Remv (openssh-server|ssh)\b'; then
      _msg "[init][ERROR] SSH still slated for removal even with systemd-dummy present" >> "${_logInt}"
    fi
  else
    _msg "[init] Simulating 'apt-get remove systemd' appeared clean" >> "${_logInt}"
  fi

  _msg "[init] Purging systemd safely" >> "${_logInt}"
  /usr/bin/apt-get purge systemd libnss-systemd -y -qq >> "${_logSlt}"

  # Some builds still leave libsystemd0 behind; elogind step should allow its removal.
#   if _pkg_installed "libsystemd0"; then
#     _msg "[init] Removing libsystemd0 (elogind present)" >> "${_logInt}"
#     /usr/bin/apt-get remove libsystemd0 -y --purge --auto-remove -qq >> "${_logSlt}"
#   fi

  # Clean stragglers, but do not autoremove SSH/SFTP bits
#   _msg "[init] Autoremove harmless leftovers (kept minimal)" >> "${_logInt}"
#   /usr/bin/apt-get autoremove --purge -y -qq >> "${_logSlt}"
#   /usr/bin/apt-get autoclean -y -qq >> "${_logSlt}"
}

# High-level orchestrator to call in the off-systemd phase
_autoinit_devuan_protect_essential() {
  _ensure_cron_provider
#   _switch_to_elogind_stack
  _ensure_openssh_server
  _protect_daemons
  _purge_systemd_keep_ssh
  _ensure_openssh_server
  _msg "[init] systemd purged while keeping openssh-server intact" >> "${_logInt}"
  return 0
}

# --- END: Devuan Excalibur systemd → sysvinit keep-SSH helper ----

###
### Sync base-files if needed
###
_init_base_sync() {
  if [ -e "/root/.top-daedalus.cnf" ]; then
    # Initialize the update flag to NO
    _needsBaseFilesUpdate=NO
    # Check if /etc/os-release mentions 'daedalus'
    if grep -i 'daedalus' /etc/os-release &> /dev/null; then
      _msg "[init] base ==> The /etc/os-release already mentions daedalus" >> "${_logInt}"
    else
      _msg "[init] base ==> The /etc/os-release doesn't mention daedalus yet" >> "${_logInt}"
      _needsBaseFilesUpdate=YES
    fi
    # Check if apt policy for base-files mentions 'daedalus'
    if apt policy base-files | grep -i 'daedalus' &> /dev/null; then
      _msg "[init] base ==> The apt policy base-files already mentions daedalus" >> "${_logInt}"
    else
      _msg "[init] base ==> The apt policy base-files doesn't mention daedalus yet" >> "${_logInt}"
      _needsBaseFilesUpdate=YES
    fi
    # If any of the above checks require an update, perform the upgrade
    if [ "${_needsBaseFilesUpdate}" = "YES" ]; then
      _msg "[init] base ==> Upgrading base-files from Devuan repository (dynamic candidate)" >> "${_logInt}"
      _ensure_devuan_bf
    fi
  fi
  if [ -e "/root/.top-excalibur.cnf" ]; then
    # Initialize the update flag to NO
    _needsBaseFilesUpdate=NO
    # Check if /etc/os-release mentions 'excalibur'
    if grep -i 'excalibur' /etc/os-release &> /dev/null; then
      _msg "[init] base ==> The /etc/os-release already mentions excalibur" >> "${_logInt}"
    else
      _msg "[init] base ==> The /etc/os-release doesn't mention excalibur yet" >> "${_logInt}"
      _needsBaseFilesUpdate=YES
    fi
    # Check if apt policy for base-files mentions 'excalibur'
    if apt policy base-files | grep -i 'excalibur' &> /dev/null; then
      _msg "[init] base ==> The apt policy base-files already mentions excalibur" >> "${_logInt}"
    else
      _msg "[init] base ==> The apt policy base-files doesn't mention excalibur yet" >> "${_logInt}"
      _needsBaseFilesUpdate=YES
    fi
    # If any of the above checks require an update, perform the upgrade
    if [ "${_needsBaseFilesUpdate}" = "YES" ]; then
      _msg "[init] base ==> Upgrading base-files from Devuan repository (dynamic candidate)" >> "${_logInt}"
      _ensure_devuan_bf
    fi
  fi
}

###
### Final procedure to make the system ready
###
_init_post_ready() {
  _msg "[init] post ==> Final OS post-upgrade to ${_OS_DIST}/${_OS_CODE} procedure..." >> "${_logInt}"
  /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
  /usr/bin/dpkg --configure -a >> "${_logSlt}"
  /usr/bin/apt-get upgrade ${_nrmUpArg} >> "${_logSlt}"
  /usr/bin/apt-get dist-upgrade ${_dstUpArg} >> "${_logSlt}"
  /usr/bin/apt-get -f install ${_aptAllow} -y -qq >> "${_logSlt}"
  /usr/bin/dpkg --configure -a >> "${_logSlt}"
}

###
### Remove and block systemd
###
_init_offsystemd() {
  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  touch /run/autoinit.pid
  _msg "[init] offd ==> Launching a quick dist-upgrade..." >> "${_logInt}"
  if [ ! -e "/etc/apt/preferences.d/offsystemd" ]; then
    rm -f /etc/apt/preferences.d/systemd
    echo -e 'Package: systemd\nPin: release *\nPin-Priority: -1' > /etc/apt/preferences.d/offsystemd
    echo -e '\n\nPackage: *systemd*\nPin: release *\nPin-Priority: -1' >> /etc/apt/preferences.d/offsystemd
  fi
  /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
  /usr/bin/dpkg --configure -a >> "${_logSlt}"
  if [ -e "/root/.top-excalibur.cnf" ]; then
    _msg "[init] offd ==> Installing elogind on ${_OS_CODE} early" >> "${_logInt}"
    /usr/bin/apt-get -o Dpkg::Options::="--force-overwrite" install elogind >> "${_logSlt}"
  fi
  /usr/bin/apt-get dist-upgrade ${_dstUpArg} >> "${_logSlt}"
  [ -e "/var/lib/man-db/auto-update" ] && rm -f /var/lib/man-db/auto-update

  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  _msg "[init] offd ==> Your system now runs on ${_OS_DIST}/${_OS_CODE}" >> "${_logInt}"
  _msg "[init] offd ==> Removing systemd on ${_OS_CODE}" >> "${_logInt}"

  _autoinit_devuan_protect_essential

  _msg "[init] offd ==> Final cleanup for systemd on ${_OS_CODE}" >> "${_logInt}"
  /usr/bin/apt-get remove systemd-timesyncd -y -qq >> "${_logSlt}"
  /usr/bin/apt-get remove systemd-dummy -y -qq >> "${_logSlt}"
  /usr/bin/apt-get purge systemd libnss-systemd -y -qq >> "${_logSlt}"

  if [ ! -e "/etc/network/interfaces" ]; then
    _msg "[init] offd ==> Update networking to fix missing /etc/network/interfaces..." >> "${_logInt}"
    /opt/local/bin/vmnetfix --mode full >> "${_logSlt}"
    wait
  fi

  _msg "[init] offd ==> Time for reboot and next upgrade cycle..." >> "${_logInt}"
  echo " " >> "${_logInt}"
  touch /root/.run-offsystemd-devuan-init.cnf
  if [ -e "/root/.manual-autoinit-reboot.cnf" ]; then
    service cron stop
    sleep 90
    rm -f /run/autoinit.pid
  else
    rm -f /run/autoinit.pid
    shutdown -r now
  fi
  exit 0
}

###
### Find the best Devuan APT sources mirror
###
_find_fast_devuan_mirror() {
  _ffDevuan="$(which ffdevuan)"
  if [ -x "${_ffDevuan}" ]; then
    bash ${_ffDevuan} >> "${_logSlt}"
    wait
  fi
  _ffMirr=/opt/local/bin/ffmirror
  if [ -x "${_ffMirr}" ]; then
    _ffList="/var/log/boa/devaun-fast-mirrors-list.txt"
    mkdir -p /var/log/boa/
    _BROKEN_FFLIST=$(grep "merged" ${_ffList} 2>&1)
    if [ ! -e "${_ffList}" ] || [[ ! "${_BROKEN_FFLIST}" =~ "merged" ]]; then
      echo "https://mirrors.dotsrc.org/devuan/merged"  > ${_ffList}
      echo "https://mirror.akardam.net/devuan/merged" >> ${_ffList}
      echo "https://mirror.hootsoftware.com/devuan/merged" >> ${_ffList}
    fi
    if [ -e "${_ffList}" ]; then
      _BROKEN_FFMIRR_TEST=$(grep "stuff" ${_ffMirr} 2>&1)
      if [[ "${_BROKEN_FFMIRR_TEST}" =~ "stuff" ]] \
        || [[ ! "${_BROKEN_FFLIST}" =~ "merged" ]]; then
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _CHECK_MIRROR=$(bash ${_ffMirr} < ${_ffList} 2>&1)
        _USE_MIR="${_CHECK_MIRROR}"
        [[ "${_USE_MIR}" =~ "printf" ]] && _USE_MIR="https://mirrors.dotsrc.org/devuan/merged"
      else
        _USE_MIR="https://mirrors.dotsrc.org/devuan/merged"
      fi
    else
      _USE_MIR="https://mirrors.dotsrc.org/devuan/merged"
    fi
  else
    _USE_MIR="https://mirrors.dotsrc.org/devuan/merged"
  fi
  echo "${_USE_MIR}"
}

###
### Init cycle procedure
###
_init_cycle() {
  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  touch /run/autoinit.pid
  _msg "[init] cycl ==> Your current system is ${_OS_DIST}/${_OS_CODE}" >> "${_logInt}"
  _NEW_SYS=Devuan
  _OLD_SYS=Devuan
  [ ! -e "/etc/network/interfaces" ] && touch /root/.autoinit-yes-vmnetfix.cnf
  if [ "${_OS_CODE}" = "trixie" ]; then
    _NEW_OS_CODE=excalibur
    _OLD_SYS=Debian
    [ ! -e "/root/.top-excalibur.cnf" ] && touch /root/.top-excalibur.cnf
  elif [ "${_OS_CODE}" = "bookworm" ]; then
    _NEW_OS_CODE=daedalus
    _OLD_SYS=Debian
    [ ! -e "/root/.top-daedalus.cnf" ] && touch /root/.top-daedalus.cnf
  elif [ "${_OS_CODE}" = "chimaera" ]; then
    _NEW_OS_CODE=daedalus
    [ ! -e "/root/.top-daedalus.cnf" ] && touch /root/.top-daedalus.cnf
  elif [ "${_OS_CODE}" = "bullseye" ]; then
    _NEW_OS_CODE=chimaera
    _OLD_SYS=Debian
    [ ! -e "/root/.top-daedalus.cnf" ] && touch /root/.top-daedalus.cnf
  elif [ "${_OS_CODE}" = "buster" ]; then
    _NEW_OS_CODE=beowulf
    _OLD_SYS=Debian
    [ ! -e "/root/.top-daedalus.cnf" ] && touch /root/.top-daedalus.cnf
  elif [ "${_OS_CODE}" = "beowulf" ]; then
    _NEW_OS_CODE=chimaera
    [ ! -e "/root/.top-daedalus.cnf" ] && touch /root/.top-daedalus.cnf
  elif [ "${_OS_CODE}" = "daedalus" ] || [ "${_OS_CODE}" = "excalibur" ]; then
    _NEW_OS_CODE=
    _NEW_SYS=
  else
    _msg "[init] cycl ==> This procedure does not support ${_OS_DIST}/${_OS_CODE}" >> "${_logInt}"
    _msg "[init] cycl ==> Bye!" >> "${_logInt}"
    sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
    sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
    echo " " >> "${_logInt}"
    exit 1
  fi
  if [ "${_OLD_SYS}" = "Devuan" ]; then
    /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
    /usr/bin/dpkg --configure -a >> "${_logSlt}"
    /usr/bin/apt-get upgrade ${_nrmUpArg} >> "${_logSlt}"
  fi
  if [ ! -z "${_NEW_OS_CODE}" ] && [ ! -z "${_NEW_SYS}" ]; then
    if [ -e "/root/.autoinit-yes-vmnetfix.cnf" ]; then
      _msg "[init] cycl ==> Update networking with vmnetfix early..." >> "${_logInt}"
      /opt/local/bin/vmnetfix --mode full >> "${_logSlt}"
      wait
    fi
    _msg "[init] cycl ==> Running APT Cleanup..." >> "${_logInt}"
    /opt/local/bin/aptcleanup >> "${_logSlt}"
    wait
    _msg "[init] cycl ==> Launching a quick upgrade to ${_NEW_SYS}/${_NEW_OS_CODE}" >> "${_logInt}"
    _aptLiSys="/etc/apt/sources.list"
    if [ "${_NEW_OS_CODE}" = "beowulf" ]; then
      _TGT_MRR="http://archive.devuan.org/merged"
    else
      _TGT_MRR=$(_find_fast_devuan_mirror)
    fi
    : "${_TGT_MRR:=https://mirrors.dotsrc.org/devuan/merged}"
    _msg "[init] cycl ==> Using Devuan mirror: ${_TGT_MRR}" >> "${_logInt}"
    echo "## DEVUAN MAIN REPOSITORIES" > ${_aptLiSys}
    echo "deb ${_TGT_MRR} ${_NEW_OS_CODE} main" >> ${_aptLiSys}
    echo "deb-src ${_TGT_MRR} ${_NEW_OS_CODE} main" >> ${_aptLiSys}
    echo "" >> ${_aptLiSys}
    if [ "${_NEW_OS_CODE}" != "beowulf" ]; then
      echo "## MAJOR BUG FIX UPDATES produced after the final release" >> ${_aptLiSys}
      echo "deb ${_TGT_MRR} ${_NEW_OS_CODE}-updates main" >> ${_aptLiSys}
      echo "deb-src ${_TGT_MRR} ${_NEW_OS_CODE}-updates main" >> ${_aptLiSys}
      echo "" >> ${_aptLiSys}
    fi
    echo "## DEVUAN SECURITY UPDATES" >> ${_aptLiSys}
    echo "deb ${_TGT_MRR} ${_NEW_OS_CODE}-security main" >> ${_aptLiSys}
    echo "deb-src ${_TGT_MRR} ${_NEW_OS_CODE}-security main" >> ${_aptLiSys}
    _prefer_devuan_repositories
    /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
    /usr/bin/dpkg --configure -a >> "${_logSlt}"
    if [ "${_OLD_SYS}" = "Debian" ]; then
      ${_INITINS} devuan-keyring >> "${_logSlt}"
    else
      /usr/bin/dpkg --configure -a >> "${_logSlt}"
    fi
    /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
    /usr/bin/apt-get upgrade ${_dstUpArg} >> "${_logSlt}"
    if [ "${_OLD_SYS}" = "Debian" ]; then
      /usr/bin/apt-get update --allow-insecure-repositories >> "${_logSlt}"
      /usr/bin/dpkg --configure -a >> "${_logSlt}"
      if [ "${_NEW_OS_CODE}" = "excalibur" ] || [ -e "/root/.top-excalibur.cnf" ]; then
        ${_INITINS} eudev sysvinit-core systemd-sysv- --allow-remove-essential -qq >> "${_logSlt}"
      else
        ${_INITINS} eudev sysvinit-core -qq >> "${_logSlt}"
      fi
      /usr/bin/apt-get -f install ${_aptAllow} -y -qq >> "${_logSlt}"
      if [ "${_NEW_OS_CODE}" = "excalibur" ] || [ -e "/root/.top-excalibur.cnf" ]; then
        ${_INITINS} eudev sysvinit-core systemd-sysv- --allow-remove-essential -qq >> "${_logSlt}"
      else
        ${_INITINS} eudev sysvinit-core -qq >> "${_logSlt}"
      fi
      /usr/bin/apt-get -f install ${_aptAllow} -y -qq >> "${_logSlt}"
      /usr/bin/dpkg --configure -a >> "${_logSlt}"
    else
      [ -e "/var/lib/man-db/auto-update" ] && rm -f /var/lib/man-db/auto-update
      /usr/bin/apt-get dist-upgrade ${_dstUpArg} >> "${_logSlt}"
      /usr/bin/apt-get -f install ${_aptAllow} -y -qq >> "${_logSlt}"
      [ -e "/var/lib/man-db/auto-update" ] && rm -f /var/lib/man-db/auto-update
      /usr/bin/apt-get autoremove --purge -y -qq >> "${_logSlt}"
      /usr/bin/apt-get autoclean -y -qq >> "${_logSlt}"
    fi
  fi
  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  if [ "${_OLD_SYS}" = "Debian" ]; then
    if [ -e "/root/.autoinit-yes-vmnetfix.cnf" ]; then
      _msg "[init] cycl ==> Update networking with vmnetfix just in case before reboot..." >> "${_logInt}"
      /opt/local/bin/vmnetfix --mode full >> "${_logSlt}"
      wait
    fi
    _msg "[init] cycl ==> Time for reboot and next upgrade cycle..." >> "${_logInt}"
    echo " " >> "${_logInt}"
    touch /root/.run-cycle-devuan-init.cnf
    if [ -e "/root/.manual-autoinit-reboot.cnf" ]; then
      service cron stop
      sleep 90
      rm -f /run/autoinit.pid
    else
      rm -f /run/autoinit.pid
      shutdown -r now
    fi
    exit 0
  else
    if [ "${_OS_CODE}" = "daedalus" ] || [ "${_OS_CODE}" = "excalibur" ]; then
      _init_base_sync
      _init_post_ready
      _init_no_systemd
      _msg "[init] cycl ==> Your system now runs on ${_OS_DIST}/${_OS_CODE}" >> "${_logInt}"
      if [ ! -e "/etc/network/interfaces" ]; then
        _msg "[init] cycl ==> Update networking to fix missing /etc/network/interfaces..." >> "${_logInt}"
        /opt/local/bin/vmnetfix --mode full >> "${_logSlt}"
        wait
      fi
      _msg "[init] cycl ==> Running APT Cleanup.." >> "${_logInt}"
      /opt/local/bin/aptcleanup >> "${_logSlt}"
      wait
      _msg "[init] cycl ==> The system is now ready for boa install" >> "${_logInt}"
      rm -f /root/.init-to-devuan-ctrl.cnf
      sed -i "s/.*autoinit.*//gi" /etc/crontab &> /dev/null
      _if_launch_boa_install
    else
      _msg "[init] cycl ==> Your system now runs on ${_OS_DIST}/${_OS_CODE}" >> "${_logInt}"
      if [ ! -e "/etc/network/interfaces" ]; then
        _msg "[init] cycl ==> Update networking to fix missing /etc/network/interfaces..." >> "${_logInt}"
        /opt/local/bin/vmnetfix --mode full >> "${_logSlt}"
        wait
      fi
      _msg "[init] cycl ==> Time for reboot and next upgrade cycle..." >> "${_logInt}"
    fi
    echo " " >> "${_logInt}"
    touch /root/.run-cycle-devuan-init.cnf
    touch /root/.run-cycle-${_OS_CODE}-init.cnf
    if [ -e "/root/.manual-autoinit-reboot.cnf" ]; then
      service cron stop
      sleep 90
      rm -f /run/autoinit.pid
    else
      rm -f /run/autoinit.pid
      shutdown -r now
    fi
    exit 0
  fi
}

###
### Display welcome info
###
_init_info() {
  echo "[init] info ==> The system will reboot and continue several times..."
  sleep 3
  echo "[init] info ==> until it is ugraded to latest Devuan version."
  sleep 3
  echo "[init] info ==> Once all upgrades are complete, you can run boa install"
  sleep 3
  echo "[init] info ==> Let's go! It will take only ten minutes max!"
  sleep 3
  echo "..."
}

###
### Init info or prepare
###
_init_conf() {
  if [ ! -e "${_initFile}" ]; then
    if [ ! -x "/usr/bin/mc" ]; then
      _init_mnfr
      _init_info
    fi
    _init_prepare &> /dev/null
  fi
}

###
### Init start
###
_init_start() {
  _init_conf
  if [ -e "${_initFile}" ]; then
    if [ -e "/root/.run-cycle-devuan-init.cnf" ]; then
      if [ ! -e "/root/.run-offsystemd-devuan-init.cnf" ]; then
        _init_offsystemd
      fi
    fi
    _init_cycle
  fi
}

###
### Init launch
###
_init_launch() {
  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  touch /run/autoinit.pid
  if pgrep -f unattended-upgrades >/dev/null 2>&1; then
    pkill -9 -f unattended-upgrades
  fi
  if [ ! -e "/root/.autoinit.log" ]; then
    echo "[init] lnch ==> Launching BOA System INIT on ${_OS_DIST}/${_OS_CODE}..."
    _msg "[init] lnch ==> Launching BOA System INIT on ${_OS_DIST}/${_OS_CODE}..." >> "${_logInt}"
  fi
  sleep 15
  _TIME_IS=$(date)
  _UPTIME=$(uptime)
  _msg "[init] lnch ==> Date/Time: ${_TIME_IS}" >> "${_logInt}"
  _msg "[init] lnch ==> Uptime: ${_UPTIME}" >> "${_logInt}"
  _init_mode
  _init_ninc
  _init_locales
  _init_cron
  _init_start
}

### ---------------------------- Prepare for _init_launch
_init_root
_init_aegir
_single_instance_lock
cd /root/

### ---------------------------- Auto-enable debug on dev
if [ "${_tRee}" = "dev" ]; then
  [ ! -e "/root/.debug-boa-installer.cnf" ] && touch /root/.debug-boa-installer.cnf
  [ ! -e "/root/.debug-octopus-installer.cnf" ] && touch /root/.debug-octopus-installer.cnf
fi

### ---------------------------- Extra protection with pid file
if [ -e "/run/autoinit.pid" ]; then
  echo " " >> "${_logSlt}"
  _msg "The /run/autoinit.pid is blocking this run..." >> "${_logSlt}"
  echo " " >> "${_logSlt}"
  exit 1
else
  ### -------------------------- Let's go!
  _init_launch
fi

exit 0
