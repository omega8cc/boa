  ${_DCY_PRN_CMD} remove-older-than ${KEEP_WITHIN} --force ${_BACKUP_TARGET} >> ${_LOGFILE}
  wait
}

_collection_status() {
  echo "Running collection-status for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
