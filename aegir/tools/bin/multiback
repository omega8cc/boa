}

_collection_status() {
  echo "Running collection-status for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
  echo "Command is ${_DCY_UTL_CMD} collection-status ${_BACKUP_TARGET}"
  ${_DCY_UTL_CMD} collection-status ${_BACKUP_TARGET} >> ${_LOGFILE}
  wait
}

# Function to only repair incomplete backup sets
_repair_only() {
  echo "Running repair via cleanup --force for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
  echo "Command is ${_DCY_PRN_CMD} cleanup --force ${_BACKUP_TARGET}"
  ${_DCY_PRN_CMD} cleanup --force ${_BACKUP_TARGET} >> ${_LOGFILE}
  wait
}

# Function to repair incomplete backup sets
_repair() {
  _repair_only
  _collection_status
}

# Function to check if repair incomplete backup sets is needed
_check_if_repair() {
  if grep -q "found incomplete backup sets" "${_LOGFILE}"; then
    _repair_only
  fi
}

# Function to check if backup worked cleanly or log the errors
_check_if_worked_cleanly_or_log_err() {
  # Dispatch-level _USER, never the wrapper's exported _user: a manual
  # run inherits no _user, so the tenant branch collapsed to
  # /data/disk//... and the OK/ERR file landed under /data/disk/static/.
  local _user="${_USER}"
  local _logs_dir
  if [ "${_user}" = "global" ] || [ "${_user}" = "data" ] || [ "${_user}" = "custom" ]; then
    _logs_dir="/root/.remote_backups/logs"
  else
    _logs_dir="/data/disk/${_user}/static/control/remote_backups/logs"
    # These paths hang off static/control, which the tenant owns, so every
    # component is a name it can replace with a symlink -- and both verbs
    # below follow one: cp writes THROUGH a planted destination link, and
    # a link pointing at an existing directory makes the -e test true, so
    # the mkdir is skipped and root's write lands in that directory. Same
    # refusal shape as mybackup's credentials guard. The sentinel is a
    # diagnostic, so refusing skips it without touching the run's status;
    # the freshness notice then reports the missing sentinel, which is the
    # right outcome for an account that planted the link.
    local _p
    for _p in "/data/disk/${_user}/static" \
      "/data/disk/${_user}/static/control" \
      "/data/disk/${_user}/static/control/remote_backups" \
      "${_logs_dir}"; do
      if [ -L "${_p}" ]; then
        echo "[$(date)] REFUSED sentinel for ${_user}: ${_p} is a symlink" \
          >> /var/log/mybackup_invalid_queued.log
        return 0
      fi
    done
  fi
  local _sentinel
  if grep -q "Backup Statistics" "${_LOGFILE}"; then
    _sentinel="${_logs_dir}/OK-${_BUCKET_NAME}.log"
  else
    _sentinel="${_logs_dir}/ERR-${_BUCKET_NAME}.log"
  fi
  case "${_logs_dir}" in
    /data/disk/*)
      # The loop above and a write by path are two steps: logs/ is made
      # inside the real remote_backups (mkdir never follows a link at the
      # name) and the sentinel is put inside the real logs/.
      _acct_in_real_dir "${_logs_dir%/*}" mkdir -- ./logs 2> /dev/null
      _acct_in_real_dir "${_logs_dir}" _acct_copy_put_here \
        "${_sentinel##*/}" "${_LOGFILE}"
      return 0
      ;;
  esac
  [ ! -d "${_logs_dir}" ] && mkdir -p "${_logs_dir}"
  [ -d "${_logs_dir}" ] || return 0
  # rm unlinks a planted leaf link itself, never what it points at.
  [ -L "${_sentinel}" ] && rm -f "${_sentinel}"
  cp -af "${_LOGFILE}" "${_sentinel}"
}

# The root file $2 copied to ./$1 in the current (pinned) directory with its
# content, read/write bits and times (root's own file, so root's owner as a
# fresh file gets it), as a fresh file created exclusively and renamed over
# the name, so a link or a FIFO put at the name is replaced, never followed
# or opened. The temp is created, written, moded and timed through one handle
# opened O_EXCL|O_NOFOLLOW (_ACCT_COPY_PUT_PL, the times of the file as read,
# in whole seconds): nothing runs by name on it, as the directory is the
# account's (a hard link renamed over the temp name before a touch by name
# would take the times).
_ACCT_COPY_PUT_PL='use Fcntl; use IO::Handle; my ($n) = @ARGV; local $/; my $d = <STDIN>; my @s = stat(STDIN) or exit 1; sysopen(my $h, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; (print {$h} $d) or exit 1; $h->flush or exit 1; chmod($s[2] & 0666, $h) or exit 1; utime($s[8], $s[9], $h) or exit 1; close($h) or exit 1; exit 0'
_acct_copy_put_here() {
  local _t="./.${1}.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if perl -e "${_ACCT_COPY_PUT_PL}" "${_t}" 2> /dev/null < "${2}" \
    && mv -f -T -- "${_t}" "./${1}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}

# Function to wipe the bucket completely. Duplicity 3.2.0.2 has no verb
# that empties a repository: remove-all-but-n-full asserts on n=0, and
# every removal verb keeps the newest matched chain by construction --
# "manually purge the repository" is duplicity's own advice. So the wipe
# drives duplicity's backend layer directly under the interpreter that
# runs duplicity itself: same target URL, same credentials env, every
# supported scheme. Only files duplicity's own naming parser recognizes
# are deleted, and deleting repeats until a re-list comes back clean, so
# a failure can never masquerade as a completed wipe. A clean listing is
# the strongest proof this layer has: bucket-level versioning or
# soft-delete can retain unlisted older versions no duplicity backend
# exposes, so the driver states the limit instead of overclaiming.
_wipe() {
  local _dcyBin _pyBin _wipeOut _wipeRC _wipeScrub
  echo "Running wipe via duplicity backend-level deletion for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
  _dcyBin=$(readlink -f /usr/local/bin/duplicity 2>/dev/null)
  _pyBin=$(head -1 "${_dcyBin}" 2>/dev/null | tr -d '\r' | sed 's/^#!//; s/^[[:space:]]*//')
  _pyBin="${_pyBin%% *}"
  if [[ -z "${_pyBin}" ]] || [[ ! -x "${_pyBin}" ]]; then
    echo "ERROR: wipe FAILED for ${_BUCKET_NAME}: no python interpreter behind /usr/local/bin/duplicity"
    echo "ERROR: wipe FAILED for ${_BUCKET_NAME}: no python interpreter behind /usr/local/bin/duplicity" >> ${_LOGFILE}
    return 1
  fi
  echo "Command is ${_pyBin} (duplicity backend wipe driver) ${_BACKUP_TARGET}"
  _wipeOut=$("${_pyBin}" - ${_BACKUP_TARGET} 2>&1 <<'WIPEDRV'
import sys

try:
    from duplicity import backend, config, file_naming, log
except ImportError as e:
    print(f"wipe driver: cannot import duplicity: {e}")
    sys.exit(2)

log.setup()

args = sys.argv[1:]
if not args:
    print("wipe driver: no target URL given")
    sys.exit(2)
url = args.pop(0)
while args:
    flag = args.pop(0)
    if flag == "--s3-endpoint-url" and args:
        config.s3_endpoint_url = args.pop(0)
    elif flag == "--s3-region-name" and args:
        config.s3_region_name = args.pop(0)
    elif flag == "--s3-use-ia":
        pass
    else:
        print(f"wipe driver: unknown target option: {flag}")
        sys.exit(2)

# The delete-pass loop already re-attempts anything still listed, so
# duplicity's default 5 spaced attempts per call would only multiply
# the worst case (all output is captured, so a stall is silent).
config.num_retries = 2

try:
    backend.import_backends()
    remote = backend.get_backend(url)
    if remote is None:
        print("wipe driver: target is not a recognized backend URL")
        sys.exit(2)
    names = remote.list()
    doomed = [f for f in names if file_naming.parse(f)]
    foreign = len(names) - len(doomed)
    if foreign:
        print(f"wipe driver: leaving {foreign} non-duplicity file(s) untouched")
    if doomed:
        # A deleted name can come back in the next listing: on a
        # versioning bucket removing the newest version reveals the one
        # below it (b2 deletes exactly one version per call), and the
        # backend wrapper downgrades per-file delete failures to
        # warnings. So deleting repeats until a listing comes back
        # clean; the verified claim rests on an empty listing, never on
        # delete calls having been issued.
        issued = 0
        passes = 0
        while True:
            passes += 1
            print(f"wipe driver: deleting {len(doomed)} duplicity file(s)")
            for f in doomed:
                print(f"wipe driver: deleting {f.decode('ascii', 'replace')}")
            remote.delete(doomed)
            issued += len(doomed)
            doomed = [f for f in remote.list() if file_naming.parse(f)]
            if not doomed:
                break
            if passes == 5:
                print(f"wipe driver: FAILED: {len(doomed)} duplicity file(s) still listed after {passes} delete passes")
                print("wipe driver: re-running purge continues the wipe if deletions were succeeding")
                sys.exit(1)
            print(f"wipe driver: {len(doomed)} duplicity file(s) listed again -- older versions revealed or a delete failed; deleting again")
        print(f"wipe driver: verified: no duplicity-named files remain listed at the target ({issued} deletion(s) in {passes} pass(es))")
    else:
        print("wipe driver: no duplicity files at the target, nothing to delete")
    if not url.lower().startswith("file:"):
        print("wipe driver: note: bucket-level versioning or soft-delete, where enabled, can retain unlisted older versions this client cannot see; those follow the provider's lifecycle settings")
except SystemExit:
    raise
except Exception as e:
    print(f"wipe driver: FAILED: {e.__class__.__name__}: {e}")
    sys.exit(1)
sys.exit(0)
WIPEDRV
  )
  _wipeRC=$?
  # Same scrub as the connection test: strip URL userinfo and redact the
  # b2 values wherever error text quotes them (URL-encoded, glob-safe).
  _wipeScrub=$(echo "${_wipeOut}" | sed 's|://[^@[:space:]]*@|://|g')
  if [[ -n "${B2_APPLICATION_KEY}" ]]; then
    _wipeScrub="${_wipeScrub//${B2_APPLICATION_KEY}/[redacted]}"
  fi
  if [[ -n "${B2_ACCOUNT_ID}" ]]; then
    _wipeScrub="${_wipeScrub//${B2_ACCOUNT_ID}/[redacted]}"
  fi
  echo "${_wipeScrub}" >> ${_LOGFILE}
  if [[ "${_wipeRC}" -ne 0 ]]; then
    echo "${_wipeScrub}"
    echo "ERROR: wipe FAILED for ${_BUCKET_NAME} with exit code ${_wipeRC}"
    echo "ERROR: remote backup data may still exist at the target"
    echo "ERROR: wipe FAILED for ${_BUCKET_NAME} with exit code ${_wipeRC}" >> ${_LOGFILE}
    echo "ERROR: remote backup data may still exist at the target" >> ${_LOGFILE}
    return 1
  fi
  [[ -n "${_NAME}" ]] && rm -rf "/root/.cache/duplicity/${_NAME}"
  echo "Wipe completed for ${_BUCKET_NAME}; local duplicity cache ${_NAME} removed"
  echo "Wipe completed for ${_BUCKET_NAME}; local duplicity cache ${_NAME} removed" >> ${_LOGFILE}
}

# Function to purge all backup sets. The wipe works at the backend level
# and removes damaged collections too, so no repair leg runs first; the
# collection status runs only after a verified wipe -- a failed wipe must
# never be followed by a healthy-looking status report.
_purge() {
  if _wipe; then
    _collection_status
  else
    echo "Purge FAILED for ${_BUCKET_NAME}, see ${_LOGFILE}"
    echo "Purge FAILED for ${_BUCKET_NAME}" >> ${_LOGFILE}
    exit 1
  fi
}

# Function to run weekly cleanup
_weekly_cleanup() {
  if [ -e "${_LOGPTH}/${_BUCKET_NAME}.archive.log" ] \
    && [ ! -e "${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.cleanup.log" ] \
    && [ "${_DOW}" = 7 ] \
    && [ "${_cached}" = "YES" ]; then
    _test "only"
    _remove_older_than
    echo "$(date)" >> ${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.cleanup.log
  else
    _test "only"
  fi
}

# Function to clean up old backups
_cleanup() {
  _remove_older_than
  _collection_status
}

# Function to perform backup
_run_backup() {
  export _FULL_BACK_CMD="${_DCY_BUP_CMD} ${_BATCH_EXCLUDE} ${_BATCH_INCLUDE} --exclude '**' / ${_BACKUP_TARGET}"
  echo "Running in ${_MODE} mode for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
  echo "$(date)" >> ${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.${_MODE}.log
  # Stderr is captured too: duplicity routes errors there, so without it
  # the emailed log misses why a run failed and the no-signatures retry
  # below has nothing to detect. The operands are word-split but never
  # globbed by the shell: a pattern there is duplicity's, and an account's
  # regexp operand must not expand to the names it keeps in its own tree.
  set -f
  ${_DCY_BUP_CMD} ${_BATCH_EXCLUDE} ${_BATCH_INCLUDE} --exclude '**' / ${_BACKUP_TARGET} >> ${_LOGFILE} 2>&1
  _BUP_RC=$?
  set +f
  wait
  # An explicit incremental against a remote with no signatures is a
  # fatal in duplicity, never a promotion -- only the implied-inc backup
  # verb switches to full there. After an emptied remote (provider
  # account swap, bucket wipe) the local archive log keeps voting
  # incremental, so every leg would fatal forever. Retry once as full;
  # _MODE is corrected first so the per-mode day log, the monthly-full
  # gate and the emailed subject describe the run that happened.
  if [ "${_BUP_RC}" -ne 0 ] \
    && [ "${_MODE}" = "incremental" ] \
    && grep -q "Old signatures not found and incremental specified" "${_LOGFILE}"; then
    export _MODE="full"
    _set_cmd
    echo "Remote has no signatures; retrying in ${_MODE} mode for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
    echo "$(date)" >> ${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.${_MODE}.log
    set -f
    ${_DCY_BUP_CMD} ${_BATCH_EXCLUDE} ${_BATCH_INCLUDE} --exclude '**' / ${_BACKUP_TARGET} >> ${_LOGFILE} 2>&1
    _BUP_RC=$?
    set +f
    wait
  fi
  export _BUP_RC
  _print_env "multiback_run_backup"
}

# Function to prepare backup
_backup() {
  _backup_prepare
  _set_mode
  _set_cmd
  _run_backup
  _check_if_repair
  _weekly_cleanup
  _check_if_worked_cleanly_or_log_err
  if [ -n "${_MY_EMAIL}" ] && [ "${_INCIDENT_REPORT}" != "OFF" ]; then
    boa info  >> ${_LOGFILE}
    echo "Sending email report on $(date)" >> ${_LOGFILE}
    echo >> ${_LOGFILE}
    s-nail -s "Backup report (${_MODE}) for ${_BUCKET_NAME} on $(date)" ${_MY_EMAIL} < ${_LOGFILE}
  fi
  cat ${_LOGFILE} >> ${_LOGPTH}/${_BUCKET_NAME}.archive.log
  rm -f ${_LOGFILE}
  _print_env "multiback_backup"
  # Propagated only after the classifier, cleanup and report steps, so
  # the ERR file and the emailed log still happen on a failed backup.
  # The sequential wrapper's verdict is this exit code; with it
  # discarded a fatal run was reported as completed successfully. The
  # EXIT trap's bare exit preserves this status after the pid cleanup.
  if [ "${_BUP_RC:-0}" -ne 0 ]; then
    exit "${_BUP_RC}"
  fi
}

### Legacy procedure for reference
#
#   Note: Be careful while restoring not to prepend a slash to the path!
#
# $ backboa restore file [time] destination
#
#   Restoring a single file to tmp/
#   $ backboa restore data/disk/o1/backups/foo.tar.gz tmp/foo.tar.gz
#
#   Restoring an older version of a directory to tmp/ - interval or full date
#   $ backboa restore data/disk/o1/backups 7D8h8s tmp/backups
#   $ backboa restore data/disk/o1/backups 2014/11/11 tmp/backups
#
# _restore() {
#   if [ $# = 2 ]; then
#     echo "Command is ${_DCY_UTL_CMD} restore --path-to-restore $1 ${_BACKUP_TARGET} $2"
#     ${_DCY_UTL_CMD} restore --path-to-restore $1 ${_BACKUP_TARGET} $2
#   else
#     echo "Command is ${_DCY_UTL_CMD} restore --path-to-restore $1 --time $2 ${_BACKUP_TARGET} $3"
#     ${_DCY_UTL_CMD} restore --path-to-restore $1 --time $2 ${_BACKUP_TARGET} $3
#   fi
# }
#
### Legacy procedure for reference

### Duplicity man page https://duplicity.gitlab.io/devel/duplicity.1.html#name
#
#   duplicity [backup|full|incremental] [options] source_directory target_url
#   duplicity verify [options] [--compare-data] [--path-to-restore <relpath>] [--time time] source_url target_directory
#   duplicity collection-status [options] [--file-changed <relpath>] [--show-changes-in-set <index>] [--jsonstat]] target_url
#   duplicity list-current-files [options] [--time time] target_url
#   duplicity [restore] [options] [--path-to-restore <relpath>] [--time time] source_url target_directory
#   duplicity remove-older-than <time> [options] [--force] target_url
#   duplicity remove-all-but-n-full <count> [options] [--force] target_url
#   duplicity remove-all-inc-of-but-n-full <count> [options] [--force] target_url
#   duplicity cleanup [options] [--force] target_url
#
#   Duplicity enters restore mode because the URL comes before the local directory.
#   If we wanted to restore just the file "Mail/article" in /home/me as it was three days ago into /home/me/restored_file:
#
#   duplicity -t 3D --path-to-restore Mail/article sftp://uid@other.host/some_dir /home/me/restored_file
#
#   duplicity [restore] [options] [--path-to-restore <relpath>] [--time time] source_url target_directory
#
### Duplicity man page

### Restore Command in mybackup for reference
#
#   mybackup restore <SERVICE> [RESTORE_PATH] [RESTORE_TIME]
#   mybackup restore aws data/disk/your_username/static/projects 7D
#
# - <SERVICE>: The cloud storage service used for your backups (e.g., aws, b2, wasabi).
# - [RESTORE_PATH] (optional): The absolute path (no leading slash) of the file or directory to restore.
# - [RESTORE_TIME] (optional): The point in time for the restore, specified in human-readable formats like:
#   - 1D (1 day ago)
#   - 7D (7 days ago)
#   - 1M (1 month ago)
#
### Restore Command in mybackup for reference

# Restores through links. Backups keep links as links, so an account's
# relocated files store (static/files -> <mount>/files/<oN>/static/files)
# and the relocated archive (/data/disk/arch -> <mount>/files/system/arch)
# are held under their own paths, and a site's files/ and private/ (and the
# account's backups/) are links into static/files. A path at or below
# static/files or the archive is restored from where its content is held:
# the store first, the path as given only when duplicity reports the store
# path not found (backups made while links were followed hold the content
# under the link's own path). A path below any other name the archive holds
# as a link into the same account's tree is restored from where that link
# leads. A link in the restored tree that leads to the same account's
# static/files or store is replaced by that content as of the same time, one
# restore per site store, up to _RST_LINK_MAX of them and while the target
# filesystem keeps a tenth of its size free; every other one is reported with
# the command that restores it. The same helpers are in multiback and
# mybackup.
#
# $1 = the restore verb, $2 = the listing verb (both without time and target),
# $3 = the time or empty, $4 = scope (acct, data, global or custom), $5 = the
# account for acct, $6 = the log for the reports (empty: stdout, as it runs),
# $7 = the command that restores one path to the same place, for the reports.
# _RST_TMP is a private directory for the run's own files; fails without one.
_rst_setup() {
  local _t=""
  [ -n "${3}" ] && _t=" --time $(printf '%q' "${3}")"
  _RST_CMD="${1}${_t} ${_BACKUP_TARGET}"
  _RST_LST="${2}${_t} ${_BACKUP_TARGET}"
  _RST_TIME="${3}"
  _RST_SCOPE="${4}"
  _RST_ACCT="${5}"
  _RST_LOG="${6}"
  _RST_AGAIN="${7}"
  _RST_LINK_MAX=10
  _RST_LAST=""
  _RST_GIVEN=""
  _RST_DONE=""
  _RST_OUT=""
  _RST_HOPS=0
  declare -gA _RST_STO=()
  [ -n "${_RST_TMP}" ] && [ -d "${_RST_TMP}" ] && [ ! -L "${_RST_TMP}" ]
}
_rst_note() {
  if [ -n "${_RST_LOG}" ]; then
    printf '%s\n' "$*" >> "${_RST_LOG}"
  else
    printf '%s\n' "$*"
  fi
}
# True for a path of plain names only: no empty, '.' or '..' name, and
# nothing outside [A-Za-z0-9._-] in a name.
_rst_plain() {
  [[ "${1}" =~ ^/?[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] || return 1
  case "/${1#/}/" in
    */./*|*/../*) return 1 ;;
  esac
  return 0
}
# True when archive path $1 is $2 or below it; an empty $2 is everything.
_rst_under() {
  [ -z "${2}" ] && return 0
  case "${1}" in
    "${2}"|"${2}/"*) return 0 ;;
  esac
  return 1
}
# Archive path $1 (empty: everything) restored to $2. duplicity runs in the C
# locale, so the message matched here is its own English one. With a log,
# its output goes there once the attempt is final; without one, it goes to
# stdout as it runs, all but that message. Returns 2 when duplicity reports
# the path not found in the archive (what was held back is then kept in
# _RST_OUT for the caller, which may still try another path, and says it
# only when none is left), 1 on any other failure.
_rst_one() {
  local _c="${_RST_CMD}" _o="${_RST_TMP}/rst.out" _m="not found in archive" _rc
  [ -n "${1}" ] && _c="${_c} --path-to-restore $(printf '%q' "${1}")"
  _c="${_c} $(printf '%q' "${2}")"
  echo "Command is ${_c}"
  _RST_OUT=""
  if [ -n "${_RST_LOG}" ]; then
    eval "LANGUAGE= LC_ALL=C ${_c}" > "${_o}" 2>&1
    _rc=$?
  else
    eval "LANGUAGE= LC_ALL=C ${_c}" 2>&1 | tee -- "${_o}" \
      | LC_ALL=C grep --line-buffered -a -v -F -e "${_m}"
    _rc="${PIPESTATUS[0]}"
  fi
  if [ "${_rc}" != 0 ] && grep -q -F -e "${_m}" -- "${_o}"; then
    if [ -n "${_RST_LOG}" ]; then
      _RST_OUT="$(cat -- "${_o}")"
    else
      _RST_OUT="$(LC_ALL=C grep -a -F -e "${_m}" -- "${_o}")"
    fi
    return 2
  fi
  if [ -n "${_RST_LOG}" ]; then
    cat -- "${_o}" >> "${_RST_LOG}"
  fi
  [ "${_rc}" = 0 ] || return 1
  _RST_LAST="${1}"
  return 0
}
# The owner (account, or arch) of a store that may hold archive path $1 in
# this scope, and the link its store hangs off; nothing for any other path.
_rst_owner() {
  local _a
  case "${1}" in
    data/disk/arch|data/disk/arch/*)
      [ "${_RST_SCOPE}" = global ] && echo "arch data/disk/arch"
      return 0
      ;;
    data/disk/?*/static/files|data/disk/?*/static/files/*)
      _a="${1#data/disk/}"
      _a="${_a%%/*}"
      ;;
    *) return 0 ;;
  esac
  case "${1}" in
    "data/disk/${_a}/static/files"|"data/disk/${_a}/static/files/"*) ;;
    *) return 0 ;;
  esac
  case "${_RST_SCOPE}:${_a}" in
    data:arch) return 0 ;;
    data:*|acct:"${_RST_ACCT}") echo "${_a} data/disk/${_a}/static/files" ;;
  esac
  return 0
}
# Sets _RST_S to the archive path of $1's store (an account, or arch) read
# from the live link; empty when there is none.
_rst_store_live() {
  local _k="live:${1}"
  if [ -z "${_RST_STO[${_k}]+x}" ]; then
    case "${1}" in
      arch) _RST_STO[${_k}]="$(_arch_relocated_store)" ;;
      *) _RST_STO[${_k}]="$(_acct_relocated_store "${1}")" ;;
    esac
  fi
  _RST_S="${_RST_STO[${_k}]#/}"
}
# The deepest name at or above archive path $1 that the archive lists at the
# restore time, after 1 when it lists anything below that name and 0 when it
# does not; nothing when no such name is listed. Read from duplicity's
# listing as it streams (time columns cut off), so no copy of it is kept.
_rst_listed() {
  eval "LANGUAGE= LC_ALL=C ${_RST_LST}" 2> /dev/null \
    | sed -E 's/^([^ ]+ +){5}//' \
    | _RST_Q="${1}" awk '
      BEGIN {
        n = split(ENVIRON["_RST_Q"], c, "/")
        for (i = 1; i <= n; i++) q[i] = (i == 1) ? c[1] : q[i - 1] "/" c[i]
      }
      {
        for (i = 1; i <= n; i++) {
          if (($0 "") == q[i]) s[i] = 1
          else if (index($0, q[i] "/") == 1) k[i] = 1
        }
      }
      END {
        for (i = n; i >= 1; i--) if (s[i]) { print (k[i] ? 1 : 0), q[i]; exit }
      }'
}
# Sets _RST_L to the text of the link archive path $1 holds at the restore
# time, read by restoring that one entry into a private directory; empty when
# it is not a link there.
_rst_link_text() {
  local _tmp
  _RST_L=""
  _tmp="$(mktemp -d "${_RST_TMP}/rst.entry.XXXXXX" 2> /dev/null)" || return 0
  if _rst_one "${1}" "${_tmp}/entry" && [ -L "${_tmp}/entry" ]; then
    _RST_L="$(readlink -- "${_tmp}/entry" 2> /dev/null)"
  fi
  rm -rf -- "${_tmp}"
  return 0
}
# Sets _RST_S to the store behind the link $2 as the archive holds it at the
# restore time, for a box where the live link is gone: read only when the
# entry is a link there (restoring that one entry), never by restoring a
# directory. $1 = the owner (an account, or arch).
_rst_store_archive() {
  local _a="${1}" _e="${2}" _k="archive:${1}"
  if [ -z "${_RST_STO[${_k}]+x}" ]; then
    _RST_STO[${_k}]=""
    if [ "$(_rst_listed "${_e}")" = "0 ${_e}" ]; then
      _rst_link_text "${_e}"
      if _rst_plain "${_RST_L}"; then
        case "${_a}:${_RST_L}" in
          arch:/?*) _RST_STO[${_k}]="${_RST_L#/}" ;;
          "${_a}:/mnt/"?*"/files/${_a}/static/files") _RST_STO[${_k}]="${_RST_L#/}" ;;
        esac
      fi
    fi
  fi
  _RST_S="${_RST_STO[${_k}]}"
}
# Archive path $1 restored to $2 when a name above it is held as a link into
# the same account's tree (a site's files/ or private/, the account's
# backups/): the deepest name above $1 that the archive lists with nothing
# below it is read as a link, and the rest of the path is restored from where
# it leads, below the account's /data/disk/<oN> (through _rst_path, so the
# store first) or in its store. Returns 2 when there is no such link.
_rst_via_link() {
  local _p="${1}" _t="${2}" _k _e _a _c _rc
  [ "${_RST_HOPS}" -lt 4 ] || return 2
  read -r _k _e <<< "$(_rst_listed "${_p%/*}")"
  [ "${_k}" = 0 ] && [ -n "${_e}" ] && [ "${_e}" != "${_p}" ] || return 2
  case "${_e}" in
    data/disk/?*/?*) _a="${_e#data/disk/}"; _a="${_a%%/*}" ;;
    home/?*.ftp/?*) _a="${_e#home/}"; _a="${_a%%/*}"; _a="${_a%.ftp}" ;;
    *) return 2 ;;
  esac
  case "${_RST_SCOPE}:${_a}" in
    data:arch) return 2 ;;
    data:*|acct:"${_RST_ACCT}") ;;
    *) return 2 ;;
  esac
  _rst_link_text "${_e}"
  _rst_plain "${_RST_L}" || return 2
  _c="${_RST_L#/}${_p#"${_e}"}"
  [ "${_c}" != "${_p}" ] || return 2
  case "${_RST_L}" in
    /data/disk/"${_a}"|/data/disk/"${_a}"/*) ;;
    /mnt/?*/files/"${_a}"/static/files|/mnt/?*/files/"${_a}"/static/files/*)
      _rst_store_live "${_a}"
      [ -z "${_RST_S}" ] || _rst_under "${_c}" "${_RST_S}" || return 2
      ;;
    *) return 2 ;;
  esac
  _rst_note "$(printf '%q' "${_e}") is a link to ${_RST_L}: restoring $(printf '%q' "${_c}")"
  _RST_HOPS=$(( _RST_HOPS + 1 ))
  _rst_path "${_c}" "${_t}"
  _rc=$?
  _RST_HOPS=$(( _RST_HOPS - 1 ))
  return "${_rc}"
}
# Archive path $1 restored to $2 from where its content is held.
_rst_path() {
  local _p="${1}" _t="${2}" _a="" _e="" _s="" _o _rc
  _o="$(_rst_owner "${_p}")"
  [ -n "${_o}" ] && read -r _a _e <<< "${_o}"
  if [ -n "${_a}" ]; then
    _rst_store_live "${_a}"
    _s="${_RST_S}"
    if [ -n "${_s}" ]; then
      _rst_one "${_s}${_p#"${_e}"}" "${_t}"
      _rc=$?
      [ "${_rc}" = 2 ] || return "${_rc}"
    fi
  fi
  _rst_one "${_p}" "${_t}"
  _rc=$?
  if [ "${_rc}" = 2 ] && [ -n "${_a}" ] && [ -z "${_s}" ] && [ "${_p}" != "${_e}" ]; then
    _rst_store_archive "${_a}" "${_e}"
    if [ -n "${_RST_S}" ]; then
      _rst_one "${_RST_S}${_p#"${_e}"}" "${_t}"
      _rc=$?
    fi
  fi
  if [ "${_rc}" = 2 ] && [ -z "${_a}" ]; then
    _o="${_RST_OUT}"
    _rst_via_link "${_p}" "${_t}"
    _rc=$?
    [ "${_rc}" = 2 ] && _RST_OUT="${_o}"
  fi
  [ "${_rc}" = 2 ] && [ "${_RST_HOPS}" = 0 ] && [ -n "${_RST_OUT}" ] \
    && _rst_note "${_RST_OUT}"
  return "${_rc}"
}
# The link $1 (archive position $2, leading to $3) replaced by what the rest
# of the arguments restore to a new name beside it; reported either way.
_rst_put_link() {
  local _l="${1}" _pos="${2}" _t="${3}" _tmp="${1}.rst.$$"
  shift 3
  if [ ! -e "${_tmp}" ] && [ ! -L "${_tmp}" ] && "$@" "${_tmp}"; then
    if rm -f -- "${_l}" && mv -T -- "${_tmp}" "${_l}"; then
      _rst_note "Restored $(printf '%q' "${_pos}"), a link to ${_t}, from ${_RST_LAST}"
      return 0
    fi
    [ -L "${_l}" ] || ln -s -- "${_t}" "${_l}"
  fi
  rm -rf -- "${_tmp}"
  _rst_note "Not restored: $(printf '%q' "${_pos}") is a link to ${_t}; its content was not found at the restore time"
  return 1
}
# The link $1 (archive position $2, leading to $3) replaced by $4, the part of
# a restored store it leads to, restored from archive path $5; reported
# either way.
_rst_put_from() {
  if [ -e "${4}" ] || [ -L "${4}" ]; then
    if rm -f -- "${1}" && mv -T -- "${4}" "${1}"; then
      _rst_note "Restored $(printf '%q' "${2}"), a link to ${3}, from ${5}"
      return 0
    fi
    [ -e "${1}" ] || [ -L "${1}" ] || ln -s -- "${3}" "${1}"
  fi
  _rst_note "Not restored: $(printf '%q' "${2}") is a link to ${3}; its content was not found at the restore time"
  return 1
}
# True while the filesystem holding $1 keeps a tenth of its size free, or
# when df cannot tell.
_rst_room() {
  local _s _f
  read -r _s _f <<< "$(df -P -k -- "${1}" 2> /dev/null | awk 'NR == 2 { print $2, $4 }')"
  [[ "${_s}" =~ ^[0-9]+$ ]] && [[ "${_f}" =~ ^[0-9]+$ ]] || return 0
  [ $(( _f * 10 )) -ge "${_s}" ]
}
# Links in the restored tree $1 that lead to the same account's static/files
# or store (or, for the global archive, the relocated arch): each is replaced
# by that content as of the same time, unless this restore already holds it
# (_RST_GIVEN is the path asked for, _RST_DONE the path restored). The links
# into one site store (static/files/<name>) are served by one restore of it.
# Past _RST_LINK_MAX site stores, or once the filesystem has less than a
# tenth free, links are kept and reported with the command that restores
# their store. Any other link is left as it is.
_rst_links() {
  local _top="${1}" _l _rel _pos _t _a _c _d _g _k _i _j _src _ok _ps
  local _kept=0 _stop="" _links=() _keys=() _gl=() _gp=() _gt=() _gc=() _gk=()
  local -A _how=()
  mapfile -d '' -t _links < <(find -P "${_top}" -type l -print0 2> /dev/null)
  for _l in "${_links[@]}"; do
    _rel="${_l#"${_top}"}"
    _rel="${_rel#/}"
    if [ -n "${_RST_GIVEN}" ]; then
      _pos="${_RST_GIVEN}${_rel:+/${_rel}}"
    else
      _pos="${_rel}"
    fi
    _t="$(readlink -- "${_l}" 2> /dev/null)"
    case "${_t}" in
      /*) _rst_plain "${_t}" || continue ;;
      *) continue ;;
    esac
    _c="${_t#/}"
    case "${_pos}" in
      data/disk/arch)
        [ "${_RST_SCOPE}" = global ] || continue
        _rst_under "${_c}" "${_RST_DONE}" && continue
        _rst_put_link "${_l}" "${_pos}" "${_t}" _rst_one "${_c}"
        continue
        ;;
      data/disk/?*/?*) _a="${_pos#data/disk/}"; _a="${_a%%/*}" ;;
      home/?*.ftp/?*) _a="${_pos#home/}"; _a="${_a%%/*}"; _a="${_a%.ftp}" ;;
      *) continue ;;
    esac
    case "${_RST_SCOPE}:${_a}" in
      data:arch) continue ;;
      data:*|acct:"${_RST_ACCT}") ;;
      *) continue ;;
    esac
    _d="/data/disk/${_a}/static/files"
    case "${_t}" in
      "${_d}"|"${_d}/"*)
        if _rst_under "${_c}" "${_RST_GIVEN}"; then
          _kept=$(( _kept + 1 ))
          continue
        fi
        _g="${_d#/}"
        ;;
      /mnt/?*/files/"${_a}"/static/files|/mnt/?*/files/"${_a}"/static/files/*)
        _rst_store_live "${_a}"
        if [ -n "${_RST_S}" ] && ! _rst_under "${_c}" "${_RST_S}"; then
          continue
        fi
        _rst_under "${_c}" "${_RST_DONE}" && continue
        _g="${_c%%"/files/${_a}/static/files"*}/files/${_a}/static/files"
        ;;
      *) continue ;;
    esac
    _k="${_c#"${_g}"}"
    _k="${_k#/}"
    _k="${_g}${_k:+/${_k%%/*}}"
    _gl+=("${_l}")
    _gp+=("${_pos}")
    _gt+=("${_t}")
    _gc+=("${_c}")
    _gk+=("${_k}")
    if [ -z "${_how[${_k}]+x}" ]; then
      _keys+=("${_k}")
      _how[${_k}]=_rst_one
      [ "${_g}" = "${_d#/}" ] && _how[${_k}]=_rst_path
    fi
  done
  _stop="${#_keys[@]}"
  if [ "${_stop}" -gt "${_RST_LINK_MAX}" ]; then
    _rst_note "${_stop} site stores are behind links in this restore: the links into the first ${_RST_LINK_MAX} are restored, the others are kept as links"
    _stop="${_RST_LINK_MAX}"
  fi
  for (( _i = 0; _i < _stop; _i++ )); do
    if ! _rst_room "${_top}"; then
      _rst_note "Less than a tenth of the restore's filesystem is free: the remaining links are kept as links"
      _stop="${_i}"
      break
    fi
    _k="${_keys[_i]}"
    _src="${_top}.rst.${_i}.$$"
    _ok=NO
    if [ ! -e "${_src}" ] && [ ! -L "${_src}" ] \
      && "${_how[${_k}]}" "${_k}" "${_src}"; then
      _ok=YES
    fi
    for (( _j = 0; _j < ${#_gk[@]}; _j++ )); do
      [ "${_gk[_j]}" = "${_k}" ] || continue
      if [ "${_ok}" = YES ]; then
        _rel="${_gc[_j]#"${_k}"}"
        _rst_put_from "${_gl[_j]}" "${_gp[_j]}" "${_gt[_j]}" "${_src}${_rel}" \
          "${_RST_LAST}${_rel}"
      else
        _rst_note "Not restored: $(printf '%q' "${_gp[_j]}") is a link to ${_gt[_j]}; its content was not found at the restore time"
      fi
    done
    rm -rf -- "${_src}"
  done
  for (( _i = _stop; _i < ${#_keys[@]}; _i++ )); do
    _k="${_keys[_i]}"
    _ps=""
    for (( _j = 0; _j < ${#_gk[@]}; _j++ )); do
      [ "${_gk[_j]}" = "${_k}" ] && _ps="${_ps} $(printf '%q' "${_gp[_j]}")"
    done
    _rst_note "Kept as links:${_ps}; to restore their content: ${_RST_AGAIN:+${_RST_AGAIN} }$(printf '%q' "${_k}")${_RST_TIME:+ $(printf '%q' "${_RST_TIME}")}"
  done
  if [ "${_kept}" -gt 0 ]; then
    _rst_note "${_kept} link(s) into static/files kept as links: their content is in this restore under the account's static/files"
  fi
  return 0
}

# In the current (real) target directory: the restore runs inside a fresh
# directory only root can open, so no one can swap a name below it while
# root writes there, and the finished tree is renamed to ./$2 in one step.
# $1 = the archive path, $2 = the name.
_rst_staged_here() {
  local _st _stid _want _rc
  if [ -e "./${2}" ] || [ -L "./${2}" ]; then
    echo "Error: $(pwd -P)/${2} already exists. Unable to proceed."
    return 1
  fi
  _st="$(mktemp -d ./.multiback-restore.XXXXXX 2> /dev/null)" || return 1
  _want="$(pwd -P)/${_st#./}"
  if ! cd -P -- "${_st}" 2> /dev/null || [ "$(pwd -P)" != "${_want}" ] \
    || [ "$(stat -c '%u %a' .)" != "0 700" ]; then
    echo "Error: the staging directory ${_want} is not root's own. Unable to proceed."
    return 1
  fi
  _stid="$(stat -c '%d:%i' .)"
  _rst_path "${1}" "./${2}"
  _rc=$?
  if [ "${_rc}" = 0 ]; then
    _RST_GIVEN="${1}"
    _RST_DONE="${_RST_LAST}"
    _rst_links "./${2}"
    if [ -e "../${2}" ] || [ -L "../${2}" ] || ! mv -T -- "./${2}" "../${2}"; then
      echo "Error: the restored tree is left in ${_want}/${2}"
      return 1
    fi
  else
    rm -rf -- "./${2}"
  fi
  cd .. || return 1
  [ "$(stat -c '%d:%i' -- "./${_st#./}" 2> /dev/null)" = "${_stid}" ] \
    && rmdir -- "./${_st#./}"
  return "${_rc}"
}

# Run "$@" inside the directory at the resolved path $1, only when pwd -P
# there is $1, so no name on it is a link; once entered, ./name stays there
# whatever is swapped.
_rst_in_dir() {
  local _d="${1}"
  shift
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_d}" ] && "$@" )
}
# ./$1 made in the current (pinned) directory unless the name is taken.
_acct_mkdir_here() {
  [ -e "./${1}" ] || [ -L "./${1}" ] || mkdir -- "./${1}"
}
# The resolved path $1 made where missing, one name at a time inside its real
# parent (mkdir never follows a link at the name); true when all of $1 is
# then a real directory.
_rst_mkdir_path() {
  local _d="${1}" _rest="" _n
  while [ -n "${_d}" ] && [ ! -e "${_d}" ] && [ ! -L "${_d}" ]; do
    _rest="${_d##*/}${_rest:+/${_rest}}"
    _d="${_d%/*}"
  done
  [ -n "${_d}" ] || _d=/
  while [ -n "${_rest}" ]; do
    _n="${_rest%%/*}"
    if [ "${_n}" = "${_rest}" ]; then
      _rest=""
    else
      _rest="${_rest#*/}"
    fi
    _rst_in_dir "${_d}" _acct_mkdir_here "${_n}" || return 1
    _d="${_d%/}/${_n}"
  done
  _rst_in_dir "${_d}" true
}
# The account whose ground the absolute path $1 is in: /data/disk/<oN>/...,
# /home/<name>/... (<oN> is <name> up to its first dot) or the account's
# store <mount>/files/<oN>/static/files/... under /mnt; nothing otherwise.
_rst_ground_acct() {
  local _a=""
  case "${1}" in
    /data/disk/?*)
      _a="${1#/data/disk/}"
      _a="${_a%%/*}"
      ;;
    /home/?*)
      _a="${1#/home/}"
      _a="${_a%%/*}"
      _a="${_a%%.*}"
      ;;
    /mnt/?*/files/?*/static/files|/mnt/?*/files/?*/static/files/*)
      _a="${1#/mnt/*/files/}"
      _a="${_a%%/*}"
      ;;
  esac
  echo "${_a}"
}
# True when the resolved target $2 is where the target as given, $1 (made
# absolute, links not resolved), may lead: $1 itself; for a path in an
# account's ground, below the account's /data/disk/<oN>, the /home directory
# $1 names, or the account's store in BOA's relocated layout; anywhere when
# every link on the way to $1 is one root made in a directory only root can
# write and the link check itself walked them to $2, so a name swapped
# between the two lookups is refused. BOA's own links (a relocated store, a
# site's files/ or private/, backups/, the .ftp home links) lead to such
# places; a link an account put anywhere else is refused.
_rst_target_ok() {
  local _a _h _s
  [ "${2}" = "${1}" ] && return 0
  _a="$(_rst_ground_acct "${1}")"
  if [ -n "${_a}" ]; then
    _rst_under "${2}" "/data/disk/${_a}" && return 0
    case "${1}" in
      /home/?*)
        _h="${1#/home/}"
        _rst_under "${2}" "/home/${_h%%/*}" && return 0
        ;;
    esac
    _s="$(_acct_relocated_store "${_a}")"
    [ -n "${_s}" ] && _rst_under "${2}" "${_s}" && return 0
  fi
  _root_links_ok "${1}" && [ "${_RLK_PATH}" = "${2}" ]
}
# True when the resolved path $1 is in no account's ground, or when the top of
# its ground already exists as a real directory: an account's /data/disk/<oN>
# (or the shared /data/disk/arch), the /home/<name> it names, or an account's
# store <mount>/files/<oN>/static/files. Root makes missing names only below
# that top, never an account's own directory.
_rst_ground_made() {
  local _a _r _top
  _a="$(_rst_ground_acct "${1}")"
  [ -n "${_a}" ] || return 0
  case "${1}" in
    /data/disk/?*)
      _r="${1#/data/disk/}"
      _top="/data/disk/${_r%%/*}"
      ;;
    /home/?*)
      _r="${1#/home/}"
      _top="/home/${_r%%/*}"
      ;;
    *)
      _r="${1#/mnt/}"
      _top="/mnt/${_r%%/*}/files/${_a}/static/files"
      ;;
  esac
  [ -d "${_top}" ] && [ ! -L "${_top}" ] || return 1
  case "${_top}" in
    /data/disk/arch|/home/*) return 0 ;;
  esac
  getent passwd "${_a}" > /dev/null 2>&1
}

# Function to restore backup. The target is used where it leads only when
# that is where the target as given may lead (see _rst_target_ok), and only
# as a real directory: a missing one is made one name at a time inside its
# real parent, never an account's own directory (see _rst_ground_made), and
# the restore acts inside it by pwd -P. The tree itself is restored in root's
# staging directory there (see _rst_staged_here), so on the target's own
# filesystem. A full restore (no path) goes only to a directory outside the
# accounts' ground.
_restore() {
  # Dispatch-level _USER, never the wrapper's exported _user (see
  # _check_if_worked_cleanly_or_log_err)
  local _user="${_USER}"
  local _restore_target=$1
  local _restore_path=$2
  local _restore_time=$3
  local _clean_restore_path _last_part _final_restore_target _given _real
  local _scope=acct _rc=0

  # Remove any trailing slash from _restore_path for proper basename extraction
  _clean_restore_path="${_restore_path%/}"

  # The last part (basename) of the restore path names the restored tree
  _last_part="${_clean_restore_path##*/}"
  case "${_last_part}" in
    .|..)
      echo "Error: Invalid restore path '${_restore_path}'."
      exit 1
      ;;
  esac

  [ -n "${_restore_target}" ] || _restore_target="/data/disk/${_user}/static/restores"
  # The path judged is the path used: no '..' name folds a link away
  case "/${_restore_target}/" in
    */../*)
      echo "Error: give the restore target without '..' names, not '${_restore_target}'."
      exit 1
      ;;
  esac
  # The target as given (made absolute, links not resolved) and where it
  # leads now
  _given="$(realpath -m -s -- "${_restore_target}" 2> /dev/null)"
  _real="$(realpath -m -- "${_restore_target}" 2> /dev/null)"
  if [ -z "${_given}" ] || [ -z "${_real}" ]; then
    echo "Error: Invalid restore target '${_restore_target}'."
    exit 1
  fi
  if ! _rst_target_ok "${_given}" "${_real}"; then
    echo "Error: ${_given} leads to ${_real} through a link root did not make in a directory only root can write, outside the account's own tree and files store, or it changed while it was checked. Unable to proceed."
    exit 1
  fi
  if [ -z "${_last_part}" ] && { [ -n "$(_rst_ground_acct "${_given}")" ] \
    || [ -n "$(_rst_ground_acct "${_real}")" ]; }; then
    echo "Error: A full restore goes to a directory root owns, not ${_real}."
    exit 1
  fi
  case "${_user}" in
    global|data|custom) _scope="${_user}" ;;
  esac
  if ! _rst_setup "${_DCY_UTL_CMD} restore" "${_DCY_UTL_CMD} list-current-files" \
    "${_restore_time}" "${_scope}" "${_user}" "" \
    "multiback restore ${_SERVICE} ${_user} $(printf '%q' "${_given}")"; then
    echo "Error: no private directory for the restore. Unable to proceed."
    exit 1
  fi

  if [ ! -e "${_real}" ] && [ ! -L "${_real}" ]; then
    if ! _rst_ground_made "${_real}"; then
      echo "Error: ${_real} is not below an existing account's directory or files store. Unable to proceed."
      exit 1
    fi
    echo "Creating restore target directory: ${_real}"
    if ! _rst_mkdir_path "${_real}"; then
      echo "Error: ${_real} could not be made: a directory on the way is not a real one. Unable to proceed."
      exit 1
    fi
  fi
  if ! _rst_in_dir "${_real}" true; then
    echo "Error: ${_real} is not a real directory. Unable to proceed."
    exit 1
  fi
  if [ -z "${_last_part}" ]; then
    _final_restore_target="${_real}"
    _rst_one "" "${_real}" || _rc=1
  else
    _final_restore_target="${_real%/}/${_last_part}"
    _rst_in_dir "${_real}" _rst_staged_here \
      "${_clean_restore_path}" "${_last_part}" || _rc=1
  fi
  _acct_reclaim_restored "${_final_restore_target}"

  _print_env "multiback_restore"
  if [ "${_rc}" != 0 ]; then
    echo "Error: the restore of ${_restore_path:-everything} did not complete."
    exit 1
  fi
}

_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

_web_group_state() {
  # The account's own web group, wg-<account>, derived on the box and never
  # taken from argv or a cnf: the group its pools, backend user and shell
  # users share for its web paths once the account is converted to it.
  # Prints "<state> <gid> <group>", "none - -" when there is no such group
  # (the record is root's: run as another user, converted reads as held):
  #   none       no group of that name
  #   foreign    the group exists, but an identity outside the account holds
  #              it too: never joined nor written to; claim passes still leave
  #              its paths alone (taking them would cut the pools off)
  #   held       the group exists and only this account's identities hold it:
  #              claim passes leave its paths alone, new identities join it
  #   converted  and root's record names that gid: writers use the group
  #   phaseb     and the record says the identities have left www-data
  # The record is /root/.<account>.web-group.txt, "wg-<account> gid=<n>
  # phase=<A|B> ...", root's own file outside the account tree, so neither
  # the account nor a copy or restore of its tree can make or move it.
  # $1 = account name, one of its identities (oN.ftp, oN.<sub>, oN.web,
  # oN.NN.web), or a path under /data/disk/<oN>, /home/<oN>.*, the account's
  # gems or npm tree, or its store on attached storage
  # (/mnt/<m>/files/<oN>/static/files).
  local _a="${1}" _e _gid _u _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  # a path is read as written (an alias the account wrote can carry "..",
  # "." or "//"): normalised by text alone, never through a link, first
  case "${_a}" in
    */*) _a=$(realpath -m -s -- "${_a}" 2> /dev/null) || { echo "none - -"; return 0; } ;;
  esac
  case "${_a}" in
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    /home/*) _a="${_a#/home/}"; _a="${_a%%/*}" ;;
    /opt/user/gems/*|/opt/user/npm/*) _a="${_a#/opt/user/*/}"; _a="${_a%%/*}" ;;
    /mnt/*/files/*/static/files|/mnt/*/files/*/static/files/*)
      _a="${_a#/mnt/}"; _a="${_a#*/files/}"; _a="${_a%%/*}" ;;
    */*) echo "none - -"; return 0 ;;
  esac
  _a="${_a%%.*}"
  case "${_a}" in
    ""|all|aegir|root|www-data|wg-*|*[!a-z0-9-]*) echo "none - -"; return 0 ;;
  esac
  _e=$(getent group "wg-${_a}" 2> /dev/null) || { echo "none - -"; return 0; }
  _gid=$(printf '%s' "${_e}" | cut -d: -f3)
  case "${_gid}" in
    ""|*[!0-9]*) echo "none - -"; return 0 ;;
  esac
  # every holder of the gid: members of each group entry carrying it (a
  # second entry can share the number) and every user with it as primary
  for _u in $(getent group | awk -F: -v g="${_gid}" '$3 == g { print $4 }' | tr ',' ' ') \
    $(getent passwd | awk -F: -v g="${_gid}" '$4 == g { print $1 }'); do
    [[ "${_u}" =~ ^${_a}(\.[a-z0-9]+(-dev)?|\.[0-9]+\.web)?$ ]] \
      || { echo "foreign ${_gid} wg-${_a}"; return 0; }
  done
  _r="/root/.${_a}.web-group.txt"
  if [ -f "${_r}" ] && [ ! -L "${_r}" ] \
    && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
    read -r _rg _rgid _rph _ < "${_r}" || :
  fi
  if [ "${_rg}" != "wg-${_a}" ] || [ "${_rgid}" != "gid=${_gid}" ]; then
    echo "held ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=B" ]; then
    echo "phaseb ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=A" ]; then
    echo "converted ${_gid} wg-${_a}"
  else
    echo "held ${_gid} wg-${_a}"
  fi
}

_web_group() {
  # The group a root writer gives an account's web paths (files/, private/,
  # settings.php and the like): wg-<account> once the account is converted,
  # www-data otherwise, as always. Until the record says converted every
  # identity of the account still holds www-data (a conversion grants the web
  # group first and a revert gives www-data back before it moves any path),
  # so www-data is the old state, never an outage. Callers write
  # "${_owner}${_wg:+:${_wg}}": a missing helper, an empty answer, changes no
  # group and never hands a path to a login group. Run as any user but root,
  # which cannot read root's record, a held group answers empty: the group
  # each path has is kept. $1 as _web_group_state.
  local _s
  _s=$(_web_group_state "${1}")
  case "${_s%% *}" in
    converted|phaseb) echo "${_s##* }" ;;
    held) [ "$(id -u)" = "0" ] && echo "www-data" || echo "" ;;
    *) echo "www-data" ;;
  esac
}

# After a root-run restore: duplicity re-applies the archived ownership, so
# a pre-conversion archive lands files in the box-wide group inside a
# converted account, and a foreign box's archive lands them in whatever its
# numbers map to here -- another account's group, readable by its
# identities. The destination is resolved first (relative paths, and a
# planted symlink under a tenant-writable directory, resolve to where the
# files really are) and only a real path inside an account's tree, or inside
# its relocated files store (<mount>/files/<oN>/static/files under /mnt,
# whose static directory only root can write), is touched: it is handed to
# that account's group (the inline form), then instgrp reclaim redoes the
# whole account where it is installed (every root, the marker rule, the
# DRIFT verdict). A restore staged anywhere else is the operator's to follow
# with 'instgrp reclaim oN' once it is in place.
# Verbatim in backboa, duobackboa, multiback and mybackup. $1 = the restored
# directory or file.
_ACCT_REOWN_PL='use Fcntl; my ($u, $g, @f) = @ARGV; for my $f (@f) { sysopen(my $h, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or next; my @s = stat($h); chown($u, $g, $h) if @s && (-d _ || (-f _ && $s[3] == 1)); close($h); } exit 0'
_acct_reclaim_restored() {
  local _r _a _g _gid _m _d _w=() _x=() _wg
  _r=$(realpath -e -- "$1" 2> /dev/null) || return 0
  case "${_r}" in
    /data/disk/*) _a="${_r#/data/disk/}"; _a="${_a%%/*}" ;;
    /home/*)      _a="${_r#/home/}"; _a="${_a%%/*}"; _a="${_a%%.*}" ;;
    /mnt/?*/files/?*/static/files/?*)
      _m="${_r#/mnt/}"
      _m="${_m%%/*}"
      _a="${_r#/mnt/"${_m}"/files/}"
      _a="${_a%%/*}"
      case "${_r}" in
        /mnt/"${_m}"/files/"${_a}"/static/files/?*) ;;
        *) return 0 ;;
      esac
      _root_only "/mnt/${_m}/files/${_a}/static" || return 0
      ;;
    *) return 0 ;;
  esac
  [ -n "${_a}" ] && [ "${_a}" != "all" ] && getent passwd "${_a}" > /dev/null 2>&1 || return 0
  _g=$(_acct_group "${_a}" 2> /dev/null)
  [ -n "${_g}" ] || _g="users"
  # The account's own web group is where its web paths belong once it holds
  # one: its gid stays, numeric and only when it resolves (find refuses an
  # unknown group name, and this claim discards find's errors).
  _wg=$(_web_group_state "${_a}" | cut -d' ' -f2)
  case "${_wg}" in
    ""|*[!0-9]*) ;;
    *) _x=( ! -gid "${_wg}" ) ;;
  esac
  if [ -d "${_r}" ]; then
    _d="${_r}"
    _w=(.)
  elif [ -f "${_r}" ]; then
    _d="${_r%/*}"
    _w=("./${_r##*/}" -maxdepth 0)
  else
    return 0
  fi
  # The walk starts where cd -P lands exactly on the resolved directory, so
  # no name on the way is a link then, and a name swapped for a link after
  # the realpath above never carries it elsewhere. Each directory and
  # single-link regular file takes the group through a handle opened without
  # following a link (_ACCT_REOWN_PL, -1 keeps the owner; -- so perl takes
  # it as an argument, not a switch): the tree is the account's, so a hard
  # link, a link or a FIFO put in it is left alone, and no file outside it is
  # regrouped (nothing checks a link's own group).
  _gid=$(getent group "${_g}" 2> /dev/null | cut -d: -f3)
  if [[ "${_gid}" =~ ^[0-9]+$ ]]; then
    ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_d}" ] \
      && env PATH=/usr/local/bin:/usr/bin:/bin find -P "${_w[@]}" \
        ! -group "${_g}" ! -group www-data ! -group root "${_x[@]}" \
        \( -type d -o -type f \) \
        -execdir perl -e "${_ACCT_REOWN_PL}" -- -1 "${_gid}" {} + 2> /dev/null )
  fi
  # an instgrp older than the web group would claim the web paths into the
  # account group, which the account's pools are never in
  if [ -x "/opt/local/bin/instgrp" ] && { [ "${#_x[@]}" = "0" ] \
    || grep -qE '^[[:space:]]*_web_group_state\(\) \{' /opt/local/bin/instgrp; }; then
    bash /opt/local/bin/instgrp reclaim "${_a}" > /dev/null 2>&1
  fi
  return 0
}

# Function to set backup target based on service
_set_backup_target() {
  local _service=$1
  local _user=$2

  case "${_service}" in
    aws|aws_one_zone|aws_standard_ia)
      _load_credentials "${_service}" "${_user}"
      _construct_bucket_name "${_service}" "${_user}"

      # Define S3-specific options
      local _s3_endpoint="https://s3.dualstack.${AWS_REGION}.amazonaws.com"
      local _s3_options="--s3-endpoint-url ${_s3_endpoint} --s3-region-name ${AWS_REGION}"

      # Use intelligent-tiering options for specific services
      if [ "${_service}" = "aws_standard_ia" ] || [ "${_service}" = "aws_one_zone" ]; then
        local _s3_options="${_s3_options} --s3-use-ia"
      fi

      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} ${_s3_options}"
      ;;
    azure)
      # A per-account run always composes the connection string from the
      # account's own values; one exported by the invoking shell is root's
      case "${_user}" in
        global|data|custom) ;;
        *) unset AZURE_CONNECTION_STRING ;;
      esac
      _load_credentials "azure" "${_user}"
      _construct_bucket_name "azure" "${_user}"

      # Duplicity's azure backend reads one name, AZURE_CONNECTION_STRING,
      # and takes the container from the URL (azure://<container>); an
      # account@container URL is refused as an invalid container name. A
      # connection string carries ';', which no credentials value may, so it
      # is composed here from the documented account and key names.
      if [ -z "${AZURE_CONNECTION_STRING}" ] \
        && [ -n "${AZURE_STORAGE_ACCOUNT}" ] && [ -n "${AZURE_STORAGE_KEY}" ]; then
        export AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=${AZURE_STORAGE_ACCOUNT};AccountKey=${AZURE_STORAGE_KEY};EndpointSuffix=core.windows.net"
      fi
      export _BACKUP_TARGET="azure://${_BUCKET_NAME}"
      ;;
    b2)
      _load_credentials "b2" "${_user}"
      _construct_bucket_name "b2" "${_user}"
      export _BACKUP_TARGET="b2://${B2_ACCOUNT_ID}:${B2_APPLICATION_KEY}@${_BUCKET_NAME}"
      ;;
    cloudflare)
      _load_credentials "cloudflare" "${_user}"
      _construct_bucket_name "cloudflare" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials;
      # R2 expects the literal region "auto"
      export AWS_ACCESS_KEY_ID="${R2_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${R2_SECRET_ACCESS_KEY}"
      local _r2_endpoint="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_r2_endpoint} --s3-region-name auto"
      ;;
    do_spaces)
      _load_credentials "do_spaces" "${_user}"
      _construct_bucket_name "do_spaces" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials
      export AWS_ACCESS_KEY_ID="${DO_SPACES_KEY}"
      export AWS_SECRET_ACCESS_KEY="${DO_SPACES_SECRET}"
      local _do_endpoint="https://${DO_SPACES_REGION}.digitaloceanspaces.com"
      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_do_endpoint} --s3-region-name ${DO_SPACES_REGION}"
      ;;
    gcs)
      _load_credentials "gcs" "${_user}"
      _construct_bucket_name "gcs" "${_user}"

      # Duplicity has no native gs:// backend; use the GCS XML
      # interoperability API with HMAC keys via the boto3 backend
      # A credentials file written before the HMAC switch carries the
      # pre-HMAC key names, so stop nameably instead of handing
      # duplicity an empty key pair
      if [[ -z "${GCS_ACCESS_KEY_ID}" ]] || [[ -z "${GCS_SECRET_ACCESS_KEY}" ]]; then
        echo "Error: no GCS_ACCESS_KEY_ID / GCS_SECRET_ACCESS_KEY pair in the gcs credentials file"
        echo "Error: see README.txt in the same directory for the expected variable names"
        exit 1
      fi
      export AWS_ACCESS_KEY_ID="${GCS_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${GCS_SECRET_ACCESS_KEY}"
      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url https://storage.googleapis.com"
      ;;
    ibm)
      _load_credentials "ibm" "${_user}"
      _construct_bucket_name "ibm" "${_user}"

      # Duplicity has no native ibmcos:// backend; use the IBM COS
      # S3-compatible endpoint with HMAC service credentials
      # A credentials file written before the HMAC switch carries the
      # pre-HMAC key names, so stop nameably instead of handing
      # duplicity an empty key pair
      if [[ -z "${IBM_ACCESS_KEY_ID}" ]] || [[ -z "${IBM_SECRET_ACCESS_KEY}" ]]; then
        echo "Error: no IBM_ACCESS_KEY_ID / IBM_SECRET_ACCESS_KEY pair in the ibm credentials file"
        echo "Error: see README.txt in the same directory for the expected variable names"
        exit 1
      fi
      export AWS_ACCESS_KEY_ID="${IBM_ACCESS_KEY_ID}"
      export AWS_SECRET_ACCESS_KEY="${IBM_SECRET_ACCESS_KEY}"
      local _ibm_endpoint="https://s3.${IBM_REGION}.cloud-object-storage.appdomain.cloud"
      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_ibm_endpoint}"
      ;;
    linode)
      _load_credentials "linode" "${_user}"
      _construct_bucket_name "linode" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials
      export AWS_ACCESS_KEY_ID="${LINODE_ACCESS_KEY}"
      export AWS_SECRET_ACCESS_KEY="${LINODE_SECRET_KEY}"
      local _linode_endpoint="https://${LINODE_REGION}.linodeobjects.com"
      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_linode_endpoint} --s3-region-name ${LINODE_REGION}"
      ;;
    wasabi)
      _load_credentials "wasabi" "${_user}"
      _construct_bucket_name "wasabi" "${_user}"

      # Credentials must go via env vars — the boto3 backend reads the
      # whole URL netloc as the bucket name, never userinfo credentials
      export AWS_ACCESS_KEY_ID="${WASABI_ACCESS_KEY}"
      export AWS_SECRET_ACCESS_KEY="${WASABI_SECRET_KEY}"
      local _wasabi_endpoint="https://s3.${WASABI_REGION}.wasabisys.com"
      export _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} --s3-endpoint-url ${_wasabi_endpoint} --s3-region-name ${WASABI_REGION}"
      ;;
    *)
      echo "Error: Unknown service ${_service}"
      exit 1
      ;;
  esac

  _print_env "multiback_set_backup_target"
}

# Main script
if [ "$#" -lt 3 ]; then
  _usage
fi

export _LOGPTH="/var/log/boa"
_NOW=$(date +%y%m%d-%H%M%S)
export _NOW=${_NOW//[^0-9-]/}
_TODAY=$(date +%y%m%d)
export _TODAY=${_TODAY//[^0-9]/}
_DOW=$(date +%u)
export _DOW=${_DOW//[^1-7]/}
_DOM=$(date +%e)
export _DOM=${_DOM//[^0-9]/}
_HST=${_hName//[^a-zA-Z0-9-.]/}
_HST=$(echo -n ${_HST} | tr A-Z a-z 2>&1)
export _HST_DASH=$(echo -n ${_HST} | tr . - 2>&1)

export _ACTION=$1
export _SERVICE=$2
export _USER=$3
export _RESTORE_TARGET="${4:-/var/backups/restored/}"
export _RESTORE_PATH="${5:-}"
export _RESTORE_TIME="${6:-}"
export _PIDFILE="/run/duplicity_${_SERVICE}_${_USER}.pid"
# Default values
export _DEFAULT_KEEP_WITHIN="3M"            # Default: 3 month
export _DEFAULT_FULL_BACKUP_FREQUENCY="28D" # Default: 28 days

# Log file for validation issues
export _VALIDATION_LOG_FILE="/var/log/backup_validation_issues.log"
export _SANITIZATION_TMP_DIR="/var/tmp/backup_sanitization"
# /var/tmp is open to every user: create the directory only when the name is
# free, and set its mode only when it is root's own real directory (the
# sticky bit keeps other users from replacing an entry root owns)
mkdir -m 700 "${_SANITIZATION_TMP_DIR}" 2> /dev/null
if [ -d "${_SANITIZATION_TMP_DIR}" ] && [ ! -L "${_SANITIZATION_TMP_DIR}" ] \
  && [ "$(stat -c %u "${_SANITIZATION_TMP_DIR}" 2> /dev/null)" = "0" ]; then
  chmod 700 "${_SANITIZATION_TMP_DIR}"
fi

_print_env "multiback_main"

# Create the PID file; stale-heal happens inside, before this point the
# lock may belong to a live run, so no trap is set yet -- an exit on a
# held lock must not remove the owner's file
_create_pid_file "${_PIDFILE}"
# Root-private copies of an account's filelists (see _load_account_paths),
# and a restore's own files (see _rst_setup), removed with the lock
_LISTS_TMP="$(mktemp -d 2> /dev/null)"
_RST_TMP="${_LISTS_TMP}"
trap "rm -f '${_PIDFILE}'; [ -n '${_LISTS_TMP}' ] && rm -rf -- '${_LISTS_TMP}'; exit" EXIT
# A signal death used to leave the pid file behind; exit re-enters the
# EXIT trap above for the cleanup
trap 'exit 1' INT TERM HUP

# Load paths configuration
_load_paths "${_USER}"

case "${_ACTION}" in
  test)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    ;;
  backup)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _backup
    ;;
  cleanup)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    _cleanup
    ;;
  list)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    _list
    ;;
  purge)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    _purge
    ;;
  status)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    _status
    ;;
  repair)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    _repair
    ;;
  restore)
    _set_backup_target "${_SERVICE}" "${_USER}"
    _test
    _restore "${_RESTORE_TARGET}" "${_RESTORE_PATH}" "${_RESTORE_TIME}"
    ;;
  *)
    _usage
    ;;
esac

# The EXIT trap is the single lock releaser: an explicit release here
# opened a window in which a successor's freshly acquired lock would be
# removed again by the trap at exit

# Wipe out any exported variables to clean up env after running the backup
  export FULL_BACKUP_FREQUENCY=
  export PASSPHRASE=
  export _ACTION=
  export _BACKUP_TARGET=
