#!/bin/bash

# Environment setup
export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=dev

# Passive-mirror hold (2026-08-25 ruling): the active owns the backup
# lineage -- a mirror's own chain is redundant (its data IS the active's,
# minutes behind), doubles the offsite cost, and its site-bootstrap steps
# would log DB-write errors every pass under super_read_only. One line,
# rc 0: cron stays quiet, an operator sees why. Resumes on promotion.
if [ -e "/root/.standby.cnf" ]; then
  echo "Replication standby: backup chain held (active owns the lineage)"
  exit 0
fi

# Function to print env for debugging
_print_env() {
  if [ "$(id -u)" -eq 0 ] && [ -e "/root/.dev.server.cnf" ]; then
    _ENV=$(env 2>&1)
    echo
    echo "_ENV in $1 start"
    echo "${_ENV}"
    echo "_ENV in $1 end"
    echo
    _ENV=
  fi
}

# Function to verify BOA keys
_verify_boa_keys() {
  if [ -e "/root/.dev.server.cnf" ]; then
    echo "PROC: _verify_boa_keys in multiback"
  fi
  if [ "${_tRee}" = "pro" ] || [ "${_tRee}" = "dev" ]; then
    _allw=NO
    _crlGet="-L --max-redirs 3 -s --fail --retry 9 --retry-delay 9 -A iCab"
    _urlEnc="https://files.boa.io/enc/2024"
    _encName=$(echo ${_hName} \
      | openssl md5 \
      | awk '{ print $2}' \
      | tr -d "\n" 2>&1)
    if [[ "${_hName}" =~ ".aegir.cc"($) ]] \
      || [[ "${_hName}" =~ ".o8.io"($) ]] \
      || [[ "${_hName}" =~ ".boa.io"($) ]]; then
      _allw=YES
    fi
    # *.sslip.io hostnames (wildcard DNS to the embedded IP, zero setup)
    # pass on the dev tree only: test boxes run the dev tree end to end
    # without a per-box key; pro stays licensed outside the fleet domains.
    if [ "${_tRee}" = "dev" ] \
      && [[ "${_hName}" =~ ".sslip.io"($) ]]; then
      _allw=YES
    fi
    mkdir -p /var/opt
    rm -f /var/opt/_encN*
    curl ${_crlGet} "${_urlEnc}/${_encName}" -o /var/opt/_encN.${_encName}.tmp
    wait
    echo "${_hName}.${_encName}" > /var/opt/_encN_local.${_encName}.tmp
    wait
    if [ -e "/var/opt/_encN.${_encName}.tmp" ] && [ -e "/var/opt/_encN_local.${_encName}.tmp" ]; then
      _diffTestIf=$(diff -w -B /var/opt/_encN.${_encName}.tmp /var/opt/_encN_local.${_encName}.tmp 2>&1)
      if [ ! -z "${_diffTestIf}" ] && [ "${_allw}" = "NO" ]; then
        echo
        echo "Your system requires valid license to use this function"
        echo "Please visit https://omega8.cc/licenses to purchase your own"
        echo
        if [ -e "/var/aegir/.drush/hm.alias.drushrc.php" ] \
          && [ ! -e "/var/aegir/key/barracuda_key.txt" ]; then
          mkdir -p /var/aegir/key
          cat /var/opt/_encN_local.${_encName}.tmp > /var/aegir/key/barracuda_key.txt
        fi
        rm -f /var/opt/_encN*
        exit 0
      else
        if [ -e "/var/aegir/.drush/hm.alias.drushrc.php" ] \
          && [ ! -e "/var/aegir/key/barracuda_key.txt" ]; then
          mkdir -p /var/aegir/key
          cat /var/opt/_encN_local.${_encName}.tmp > /var/aegir/key/barracuda_key.txt
        fi
      fi
    elif [ "${_allw}" = "YES" ]; then
      # A fleet-domain host is allowed on its name alone; a key fetch that
      # failed (resolver not up yet, key server unreachable) decides nothing
      # for it, so it is noted and the tool proceeds.
      echo
      echo "NOTE: the key server could not be reached; ${_hName} is allowed by its hostname"
      echo
      rm -f /var/opt/_encN*
    else
      echo
      echo "Your system requires valid license to use this BOA feature"
      echo "Unfortunately it was not possible to verify your system status"
      echo "Please contact our support but visit https://omega8.cc/licenses first"
      echo
      exit 0
    fi
  fi
}

_if_hosted_sys() {
  if [ -e "/root/.host8.cnf" ] \
    || [[ "${_hName}" =~ ".aegir.cc"($) ]]; then
    _hostedSys=YES
  else
    _hostedSys=NO
  fi
}

# Function to calculate RAM usage percentage as an integer
_calculate_ram_usage_percent() {
  _total_ram_kb=$1
  _available_ram_kb=$2
  used_ram_kb=$((_total_ram_kb - _available_ram_kb))

  # Using integer division to get a whole number percentage
  echo $(( (used_ram_kb * 100) / _total_ram_kb ))
}

# Function to check and display system info
_check_system_ram() {
  # Get the total and available RAM in KB
  _total_ram_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  _available_ram_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')

  # Calculate RAM usage percentage
  _ram_usage_percent=$(_calculate_ram_usage_percent ${_total_ram_kb} ${_available_ram_kb})
}

# Function to check and optimize RAM and disk caches
_optimize_ram() {
  swapoff -a
  _check_system_ram
  if [ "${_ram_usage_percent}" -gt 50 ]; then
    sync && echo 3 | tee /proc/sys/vm/drop_caches
  fi
  swapon -a
}

###
### Load + normalize _INCIDENT_REPORT
###
### Legacy values:
###   NO  becomes OFF (see below)
###   YES becomes MINI (see below)
###
### Current values:
###   OFF  == Total silence, no email alerts
###   ALL  == Very noisy, good for debugging
###   MINI == Only the most important alerts (default)
###   CRIT == Only critical if _lvl=ALERT
###
_normalize_incident_report() {
  : "${_INCIDENT_REPORT:=MINI}"
  _INCIDENT_REPORT="${_INCIDENT_REPORT^^}"
  _INCIDENT_REPORT="${_INCIDENT_REPORT//[^A-Z]/}"
  ###
  ### Map legacy + validate
  ###
  case "${_INCIDENT_REPORT}" in
    NO)   _INCIDENT_REPORT="OFF"  ;;
    YES)  _INCIDENT_REPORT="MINI" ;;
    OFF|ALL|MINI|CRIT) : ;;
    *)    _INCIDENT_REPORT="MINI" ;;
  esac
}

# Function to verify root access
_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    ionice -c2 -n7 -p $$
    renice 19 -p $$
    chmod a+w /dev/null
    [ -e "/root/.gnupg" ] && chmod 700 /root/.gnupg
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
  # shellcheck disable=SC1091
  [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
  _AWS_VLV=${_AWS_VLV//[^a-z]/}
  if [ -z "${_AWS_VLV}" ]; then
    _AWS_VLV="warning"
  fi
  # Verbosity floor for the legs that delete remote data. Duplicity 3.2.0.2+
  # remove-older-than --force also deletes the newest backup set whenever that
  # set is partial/incomplete, announcing it only at notice -- duplicity's own
  # default, but below our 'warning' default, so the deletion never reached
  # the report. Notice is also the only level where remove-older-than and
  # cleanup --force list what they deleted; at 'warning' cleanup speaks only
  # when it had nothing to do. A more verbose operator choice is respected.
  case "${_AWS_VLV}" in
    i|info|d|debug) _PRN_VLV="${_AWS_VLV}" ;;
    *) _PRN_VLV="notice" ;;
  esac
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
  _cpuNr="$(cat /data/all/cpuinfo 2>/dev/null | tr -d '\n' || nproc 2>/dev/null)"
  if [ -n "${_cpuNr}" ]; then
    [ "${_cpuNr}" -gt 8 ] && _useCpu=4
    [ "${_cpuNr}" -le 8 ] && _useCpu=2
    [ "${_cpuNr}" -le 4 ] && _useCpu=1
  else
    _useCpu=1
  fi
}
_check_root
_normalize_incident_report
_optimize_ram
_if_hosted_sys
_verify_boa_keys
_print_env "multiback_init"

[ -e "/root/.pause_heavy_tasks_maint.cnf" ] && exit 0

# New OpenSSL 3.x version is required
if [ ! -x "/usr/local/ssl3/bin/openssl" ]; then
  echo "New OpenSSL 3.x version is required"
  exit 1
fi

# Function to notify about still running backup
_waiting_notify() {
  local _templog="/var/backups/multiback_waiting_queue.log"
  cat /root/.remote_backups/schedule/backup_schedule.txt > ${_templog}
  ps axf | grep multiback >> ${_templog}
  ps axf | grep duplicity >> ${_templog}
  ls -la /tmp/duplicity-*-tempdir >> ${_templog}
  tree /root/.cache/duplicity >> ${_templog}
  ls -laR /root/.cache/duplicity >> ${_templog}
  grep "Out of memory: Killed process.*duplicity" /var/log/iptables.log >> ${_templog}
  boa info  >> ${_templog}
  if [ -n "${_MY_EMAIL}" ] && [ "${_INCIDENT_REPORT}" = "ALL" ]; then
    s-nail -s "Multiback Waiting Report for [${_hName}] on $(date)" ${_MY_EMAIL} < ${_templog}
  fi
}

# Matched against genuine executions only: an interpreter with the
# duplicity script path as its argument, or duplicity as argv[0] -- the
# same anchored pair the fetch guard and the clear.sh arm use, kept
# character for character so the engine and the tools cannot drift
# apart again. Both halves of the interpreter class are load-bearing:
# duplicity runs as its venv python with an interpreter flag between
# argv[0] and the console script path, so a flagless python-only
# pattern matched no live run and left this gate inert, and the direct
# companion below cannot stand in for it because that argv[0] ends in
# a path separator rather than a space. A bare substring pgrep held
# backups back whenever any concurrent command line merely mentioned
# the literal, e.g. a probe naming /root/.cache/duplicity/ paths,
# observed live.
_CNT="$(pgrep -fc '^([^ ]*/)?((ba|da)?sh|python[0-9.]*) (-[^ ]+ )*[^ ]*duplicity( |$)' 2>/dev/null)"
_CNT="${_CNT:-0}"
_CNTD="$(pgrep -fc '^[^ ]*duplicity( |$)' 2>/dev/null)"
_CNTD="${_CNTD:-0}"
if (( _CNT + _CNTD > 0 )); then
  echo "[$(date)] Active duplicity process detected, will try again later..." >> /var/log/mybackup_waiting_queue.log
  _waiting_notify
  exit 1
fi

# Function to display usage information
_usage() {
  echo "Usage: $0 {backup|cleanup|restore} <SERVICE> <USER> [RESTORE_TARGET] [RESTORE_PATH] [RESTORE_TIME]"
  echo
  echo "Example commands:"
  echo "  Backup:"
  echo "  $0 backup aws john"
  echo "  $0 backup b2 jane"
  echo
  echo "  Cleanup:"
  echo "  $0 cleanup aws john"
  echo "  $0 cleanup gcs jane"
  echo
  echo "  Restore:"
  echo "  $0 restore aws john /restore/target /specific/path 1D"
  echo "  $0 restore b2 jane /restore/target /another/path 2W"
  echo
  echo "Supported services:"
  echo "  aws, aws_one_zone, aws_standard_ia, azure, b2, cloudflare, do_spaces, gcs, ibm, linode, wasabi"
  echo
  echo "NOTE: [RESTORE_PATH] must be an absolute path (no leading slash) of the file or directory to restore"
  echo
  exit 1
}

# Liveness for a recorded lock owner: the pid must exist AND still look
# like this tooling. A pid recycled by an unrelated long-lived process
# must not hold a backup lock forever, while a live run (a monthly full
# can span many 6-hour cycles) must never lose its lock. /proc is used
# instead of kill -0 because kill -0 reports EPERM for a live pid owned
# by another user. An unreadable or empty cmdline means the process
# exited (or is a zombie) between the checks: dead.
_pid_is_live() {
  local _pid=$1 _cmd
  [[ "${_pid}" =~ ^[0-9]+$ ]] || return 1
  [ -d "/proc/${_pid}" ] || return 1
  _cmd=$(tr '\0' ' ' < "/proc/${_pid}/cmdline" 2>/dev/null)
  [ -n "${_cmd}" ] || return 1
  case "${_cmd}" in
    *duplicity*|*multiback*|*mybackup*|*backboa*|*sequential_backups*) return 0 ;;
    *) return 1 ;;
  esac
}

# Function to create PID file; heals stale leftovers (dead owner,
# recycled pid, empty file) instead of treating any existing file as a
# live run -- a leftover from an interrupted run used to block every
# later cycle until removed by hand. A live owner's lock is never
# touched. Claim discipline against concurrent starters: the create is
# an atomic noclobber write that never overwrites; a stale file is
# removed only while it still holds the same dead pid, so a lock
# re-created in the gap is never swept up; and every successful claim
# is read back, so a starter whose fresh claim was swept by a slower
# healer detects the loss and re-enters instead of running unlocked.
_create_pid_file() {
  local _pidfile=$1 _old_pid _now_pid _try=0
  while [ "${_try}" -lt 3 ]; do
    _try=$((_try + 1))
    if ( set -o noclobber; echo $$ > "${_pidfile}" ) 2>/dev/null; then
      _now_pid=$(tr -dc '0-9' < "${_pidfile}" 2>/dev/null)
      if [ "${_now_pid}" = "$$" ]; then
        return 0
      fi
      continue
    fi
    _old_pid=$(tr -dc '0-9' < "${_pidfile}" 2>/dev/null)
    if _pid_is_live "${_old_pid}"; then
      echo "Process already running with PID ${_old_pid} holding ${_pidfile}"
      exit 1
    fi
    _now_pid=$(tr -dc '0-9' < "${_pidfile}" 2>/dev/null)
    if [ "${_now_pid}" = "${_old_pid}" ]; then
      echo "Removing stale PID file ${_pidfile} (pid ${_old_pid:-empty} not running)"
      rm -f "${_pidfile}"
    fi
  done
  echo "Process already running with PID file ${_pidfile}"
  exit 1
}

# Function to remove PID file
_remove_pid_file() {
  local _pidfile=$1
  if [ -f "${_pidfile}" ]; then
    rm -f "${_pidfile}" || {
      echo "Warning: Failed to remove PID file: ${_pidfile}"
    }
  fi
}

# Function to log validation issues
_log_issue() {
  local _type=$1
  local _file=$2
  local _message=$3
  echo "[$(date)] Validation issue type: [${_type}] in file: [${_file}] with error: ${_message}" >> "${_VALIDATION_LOG_FILE}"
  if [ -n "${_MY_EMAIL}" ] && [ "${_INCIDENT_REPORT}" = "ALL" ]; then
    # Alert the admin
    boa info  >> ${_LOGFILE}
    echo "Sending Backup Validation Alert to ${_MY_EMAIL} on $(date)" >> ${_LOGFILE}
    s-nail -s "Backup Validation Alert for [$(hostname)] on $(date)" ${_MY_EMAIL} < ${_LOGFILE}
  fi
}

# Helper function to URL-encode using jq
_url_encode() {
  printf '%s' "$1" | jq -s -R -r @uri
}

# Function to escape values
_escape_value() {
  printf '%q' "$1"
}

# The names a per-account credentials file may set: the account writes that
# file, and this runs as root, so any other name (LD_PRELOAD, PATH, BASH_ENV,
# PYTHONPATH, AWS_CONFIG_FILE and the like) would steer root's own process.
# Such a line is ignored and logged; the backup runs on without it.
_CRED_NAMES_ALLOWED="KEEP_WITHIN FULL_BACKUP_FREQUENCY AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION AWS_DEFAULT_REGION AWS_SESSION_TOKEN AZURE_STORAGE_ACCOUNT AZURE_STORAGE_KEY AZURE_STORAGE_CONNECTION_STRING AZURE_CONNECTION_STRING B2_ACCOUNT_ID B2_APPLICATION_KEY DO_SPACES_KEY DO_SPACES_SECRET DO_SPACES_REGION GCS_ACCESS_KEY_ID GCS_SECRET_ACCESS_KEY IBM_ACCESS_KEY_ID IBM_SECRET_ACCESS_KEY IBM_REGION LINODE_ACCESS_KEY LINODE_SECRET_KEY LINODE_REGION R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_ACCOUNT_ID WASABI_ACCESS_KEY WASABI_SECRET_KEY WASABI_REGION"
_cred_name_allowed() {
  case " ${_CRED_NAMES_ALLOWED} " in
    *" ${1} "*) return 0 ;;
  esac
  return 1
}
# The names whose value goes into the target URL, which reaches the duplicity
# command line unquoted.
_cred_name_plain() {
  case "${1}" in
    AWS_REGION|DO_SPACES_REGION|IBM_REGION|LINODE_REGION|R2_ACCOUNT_ID|WASABI_REGION) return 0 ;;
  esac
  return 1
}

# An account owns /data/disk/<oN> and, through its .ftp login, static/control,
# so any name below either can be a link or a FIFO, and a whole directory on
# the way can be one. Root reads and writes there only inside the real
# directory. _acct_in_real_dir and _acct_read_here are copies of the helpers
# in lib/functions/helper.sh.inc.
#
# Run "$@" inside the real directory $1: below /data/disk and /home every name
# on the path must be a real directory; once entered, ./name stays there
# whatever is swapped.
_acct_in_real_dir() {
  local _d="${1}" _a="" _want
  shift
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
  esac
  if [ -n "${_a}" ]; then
    _want="$(cd -P -- "${_a}" 2> /dev/null && pwd -P)${_d#"${_a}"}"
  else
    _want="$(cd -P -- "${_d%/*}" 2> /dev/null && pwd -P)/${_d##*/}"
  fi
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_want}" ] && "$@" )
}
# ./$1 in the current (pinned) directory: never through a link, never blocked
# on a FIFO, at most 1 MiB. Empty for anything else.
_acct_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2> /dev/null
}
# ./$1 read as _acct_read_here reads it, only when it is a non-empty regular
# file (what [ -s ] accepted before); fails otherwise.
_acct_read_file_here() {
  [ -f "./${1}" ] && [ ! -L "./${1}" ] && [ -s "./${1}" ] || return 1
  _acct_read_here "${1}"
}
# True when $1 is root's and no one else can write it: owned by root, not
# writable by others, group-writable only for group root.
_root_only() {
  local _s _u _g _m
  _s="$(stat -c '%u %g %a' -- "${1}" 2> /dev/null)" || return 1
  read -r _u _g _m <<< "${_s}"
  [ "${_u}" = 0 ] || return 1
  (( 0${_m} & 2 )) && return 1
  (( 0${_m} & 16 )) && [ "${_g}" != 0 ] && return 1
  return 0
}
# ./$1 in the current (pinned) directory, read only when this directory and
# the file are root's alone: an account can swap its own remote_backups for a
# directory it made, but never make one root owns. Returns 2 when the
# directory or the file is not root's, 1 when the file is missing.
_acct_read_root_here() {
  _root_only . || return 2
  [ -f "./${1}" ] && [ ! -L "./${1}" ] || return 1
  _root_only "./${1}" || return 2
  _acct_read_here "${1}"
}

# Function to sanitize and validate credentials file. $3 is its content, read
# by the caller.
_validate_credentials() {
  local _cred_file="$1"
  local _service="$2"
  local _line_number=0

  while IFS= read -r _line || [ -n "${_line}" ]; do
    _line_number=$(( _line_number + 1 ))

    # Trim leading and trailing whitespace
    _line="${_line#"${_line%%[![:space:]]*}"}"
    _line="${_line%"${_line##*[![:space:]]}"}"

    # Skip empty lines immediately
    if [[ -z "${_line}" ]]; then
      continue
    fi

    # Remove full-line comments: lines that *start* with '#'
    if [[ "${_line}" == \#* ]]; then
      continue
    fi

    # Remove anything after (and including) the first '#' for inline comments
    # (This is a naive approach that does not consider # within quotes)
    if [[ "${_line}" == *"#"* ]]; then
      _line="${_line%%#*}"
      # Re-trim after removing the comment
      _line="${_line#"${_line%%[![:space:]]*}"}"
      _line="${_line%"${_line##*[![:space:]]}"}"
    fi

    # Skip if there's nothing left after stripping inline comment
    if [[ -z "${_line}" ]]; then
      continue
    fi

    # Remove 'export ' prefix if present
    _line="${_line#export }"

    # Validate the variable assignment (key=value)
    if [[ "${_line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(\".*\"|'.*'|[^[:space:]]+)$ ]]; then
      export _varname="${BASH_REMATCH[1]}"
      export _value="${BASH_REMATCH[2]}"

      # a per-account file (the tenant's) sets only the names above
      case "${_cred_file}" in
        /data/disk/*)
          if ! _cred_name_allowed "${_varname}"; then
            _log_issue "credentials" "${_cred_file}" \
              "Name not allowed at line ${_line_number}: ${_varname}"
            continue
          fi
          ;;
      esac

      # Remove surrounding quotes if present
      if [[ "${_value}" =~ ^\".*\"$ || "${_value}" =~ ^\'.*\'$ ]]; then
        export _value="${_value:1:-1}"
      fi

      # Check for forbidden characters in value; the value itself is never
      # logged (a key refused here is still a key)
      if echo "${_value}" | grep -q -E '[$`(){};&|<>]'; then
        _log_issue "credentials" "${_cred_file}" \
          "Forbidden characters in the value of ${_varname} at line ${_line_number}"
        continue
      fi

      # A region or an account id goes into the target URL and so onto the
      # duplicity command line: a plain name only, never a quoted value with
      # spaces that would add options to it
      if _cred_name_plain "${_varname}" \
        && [[ ! "${_value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        _log_issue "credentials" "${_cred_file}" \
          "Not a plain name in the value of ${_varname} at line ${_line_number}"
        continue
      fi

      # Safely export the variable. b2 alone embeds its key and secret
      # inside the duplicity target URL, so a reserved character in
      # either would corrupt the URL; percent-encode its values. Every
      # other service authenticates via env vars, where an encoded
      # value would break auth, so their values must stay verbatim.
      if [ "${_service}" = "b2" ]; then
        export ${_varname}=$(_url_encode "${_value}")
      else
        export ${_varname}="${_value}"
      fi
    else
      _log_issue "credentials" "${_cred_file}" \
        "Invalid syntax at line ${_line_number}"
    fi
  done <<< "${3}"

  _print_env "multiback_validate_credentials"
}

# Function to load credentials
_load_credentials() {
  local _service="$1"
  local _user="$2"
  local _acct=NO _cred_dir _secret_dir _cred_body _secret_body
  if [ "${_user}" != "arch" ] \
    && [ "${_user}" != "data" ] \
    && [ "${_user}" != "global" ] \
    && [ "${_user}" != "static" ] \
    && [ "${_user}" != "custom" ]; then
    _acct=YES
    _cred_dir="/data/disk/${_user}/static/control/remote_backups/credentials"
    _secret_dir="/data/disk/${_user}/remote_backups"
    local _cred_file="${_cred_dir}/${_service}.txt"
    local _secret_file="${_secret_dir}/.secret.txt"
    # The credentials hang off static/control, which the tenant owns: refuse
    # when any name on the way, or the file itself, is a link (a planted one
    # would hand root another account's credentials), as mybackup does.
    local _p
    for _p in "/data/disk/${_user}/static" \
      "/data/disk/${_user}/static/control" \
      "/data/disk/${_user}/static/control/remote_backups" \
      "/data/disk/${_user}/static/control/remote_backups/credentials" \
      "${_cred_file}"; do
      if [ -L "${_p}" ]; then
        echo "[$(date)] REFUSED credentials for ${_user}: ${_p} is a symlink" \
          >> /var/log/mybackup_invalid_queued.log
        echo "Error: ${_p} is a symlink. Unable to proceed."
        exit 1
      fi
    done
  fi
  if [ "${_user}" = "global" ] || [ "${_user}" = "data" ] || [ "${_user}" = "custom" ]; then
    local _cred_file="/root/.remote_backups/credentials/${_service}.txt"
    local _secret_file="/root/.remote_backups/.secret.txt"
  fi

  if [ "${_acct}" = "YES" ]; then
    # The check above and a read by path are two steps, and any directory on
    # the way can be swapped between them: both files are read inside their
    # real directories, never through a link or from a FIFO.
    if _secret_body="$(_acct_in_real_dir "${_secret_dir}" \
      _acct_read_file_here .secret.txt)"; then
      export PASSPHRASE="${_secret_body}"
    else
      echo "Secret file ${_secret_file} not found. Unable to proceed."
      exit 1
    fi
    if ! _cred_body="$(_acct_in_real_dir "${_cred_dir}" \
      _acct_read_file_here "${_service}.txt")"; then
      echo "Error: Credentials file '${_cred_file}' not found."
      exit 1
    fi
  else
    if [ -s "${_secret_file}" ]; then
      export PASSPHRASE=$(cat "${_secret_file}")
    else
      echo "Secret file ${_secret_file} not found. Unable to proceed."
      exit 1
    fi

    if [ ! -s "${_cred_file}" ]; then
      echo "Error: Credentials file '${_cred_file}' not found."
      exit 1
    fi
    _cred_body="$(timeout 10 dd if="${_cred_file}" iflag=nofollow,nonblock,fullblock \
      bs=1048576 count=1 status=none 2>/dev/null)"
  fi

  _validate_credentials "${_cred_file}" "${_service}" "${_cred_body}"
  _print_env "multiback_load_credentials"
}

# Function to load paths configuration
_load_paths() {
  local _user="$1"
  if [ "${_user}" != "arch" ] \
    && [ "${_user}" != "data" ] \
    && [ "${_user}" != "global" ] \
    && [ "${_user}" != "static" ] \
    && [ "${_user}" != "custom" ]; then
    local _paths_file="/data/disk/${_user}/remote_backups/paths/paths.txt"
  elif [ "${_user}" = "global" ] || [ "${_user}" = "data" ] || [ "${_user}" = "custom" ]; then
    local _paths_file="/root/.remote_backups/paths/${_user}_paths.txt"
  fi

  case "${_paths_file}" in
    /data/disk/*)
      _load_account_paths "${_user}" "${_paths_file}"
      _print_env "multiback_load_paths"
      return 0
      ;;
  esac

  if [ ! -f "${_paths_file}" ]; then
    echo "Error: Paths configuration file '${_paths_file}' not found."
    exit 1
  fi

  if [ "${_user}" != "arch" ]; then
    source "${_paths_file}"
  fi
  _print_env "multiback_load_paths"
}

# An account's paths.txt is root's file in root's remote_backups/paths, but
# the account owns /data/disk/<oN> and can swap remote_backups itself for a
# directory it made. The file is sourced by root, so it is read once, inside
# the real directory, and only when that directory and the file are root's
# alone; anything else refuses the run. The filelists it names are opened by
# duplicity by path much later, so duplicity gets root-private copies taken
# from the same directory now. $1 = account, $2 = its paths.txt.
_load_account_paths() {
  local _user="$1" _paths_file="$2" _paths_dir="${2%/*}" _body _rc _v _n
  _body="$(_acct_in_real_dir "${_paths_dir}" _acct_read_root_here "${_paths_file##*/}")"
  _rc=$?
  if [ "${_rc}" != 0 ]; then
    if [ "${_rc}" = 2 ] || { [ -e "${_paths_dir}" ] \
      && ! _acct_in_real_dir "${_paths_dir}" true; }; then
      echo "[$(date)] REFUSED paths for ${_user}: ${_paths_dir} is not root's own directory" \
        >> /var/log/mybackup_invalid_queued.log
      echo "Error: ${_paths_dir} is not root's own directory. Unable to proceed."
      exit 1
    fi
    echo "Error: Paths configuration file '${_paths_file}' not found."
    exit 1
  fi
  if [ -z "${_LISTS_TMP}" ] || [ ! -d "${_LISTS_TMP}" ]; then
    echo "Error: no private directory for the filelists of ${_user}. Unable to proceed."
    exit 1
  fi
  eval "${_body}"
  for _v in _INCLUDE_LIST _EXCLUDE_LIST; do
    _n="${!_v}"
    case "${_n}" in
      "${_paths_dir}"/*) _n="${_n##*/}" ;;
      *) continue ;;
    esac
    printf -v "${_v}" '%s' "${_LISTS_TMP}/${_n}"
    _acct_in_real_dir "${_paths_dir}" _acct_copy_root_here "${_n}" "${_LISTS_TMP}/${_n}"
  done
}
# ./$1 in the current (pinned) root-only directory copied to the new file $2
# when it is root's own regular file; nothing is created otherwise.
_acct_copy_root_here() {
  _root_only . && [ -f "./${1}" ] && [ ! -L "./${1}" ] && _root_only "./${1}" || return 1
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock of="${2}" conv=excl \
    status=none 2> /dev/null
}

# Function to validate duration format and fallback to default
_validate_or_default_duration() {
  local _value=$1
  local _var_name=$2
  local _default=$3

  # Supported formats: number followed by D (days), W (weeks), M (months), Y (years)
  if [[ ! "${_value}" =~ ^[0-9]+[DWMY]$ ]] || [[ "${_value}" =~ ^[0][DWMY]$ ]]; then
    echo "Warning: Invalid value '${_value}' for ${_var_name}. Using default '${_default}'."
    eval "${_var_name}='${_default}'"
    _print_env "multiback_validate_or_default_duration"
  fi

  # Enforced min value for KEEP_WITHIN (1M)
  if [ "${_var_name}" = "KEEP_WITHIN" ] && [[ ! "${_value}" =~ ^[0-9]+[MY]$ ]]; then
    echo "Warning: Invalid value '${_value}' for ${_var_name}. It must be at least 1M. Using default '${_default}'."
    eval "${_var_name}='${_default}'"
    _print_env "multiback_validate_or_default_duration_keep"
  fi

  # Enforced min and max value for FULL_BACKUP_FREQUENCY (7D to 60D)
  if [ "${_var_name}" = "FULL_BACKUP_FREQUENCY" ] && [[ ! "${_value}" =~ ^([7-9]|[1-5][0-9]|60)D$ ]]; then
    echo "Warning: Invalid value '${_value}' for ${_var_name}. It must be between 7D and 60D. Using default '${_default}'."
    eval "${_var_name}='${_default}'"
    _print_env "multiback_validate_or_default_duration_freq"
  fi
}

# Function to construct _BUCKET_NAME
_construct_bucket_name() {
  local _service_abbr=$1
  local _user=$2
  _service_dash=$(echo -n ${_service_abbr} | tr _ -)
  _hst_dash=$(echo -n ${_hName} | tr . -)
  export _BUCKET_NAME="back-to-${_user}-${_hst_dash}-${_service_dash}"
  export _NAME="${_user}-${_service_dash}"
  export _LOGFILE="${_LOGPTH}/${_BUCKET_NAME}.log"
  _print_env "multiback_construct_bucket_name"
}

# Function to generate duplicity-compatible include directives
_generate_include_directives() {
  local _source=$1
  local _include=""
  for _cdir in ${_source}; do
    _include="${_include} --include ${_cdir}"
  done
  echo "${_include}"
}

# The real path of account $1's files store when static/files is a link to
# the account's own store in BOA's relocated layout (migratefs, xoct, xcopy
# and xmass: <mount>/files/<oN>/static/files under /mnt, in a directory only
# root can write, so no account made it), with a plain path only; nothing
# else.
_acct_relocated_store() {
  local _a="${1}" _sto
  [ -L "/data/disk/${_a}/static/files" ] || return 0
  _sto=$(readlink -f "/data/disk/${_a}/static/files" 2> /dev/null)
  case "${_sto}" in
    *[!A-Za-z0-9._/-]*) return 0 ;;
    /mnt/?*/files/"${_a}"/static/files)
      [ -d "${_sto}" ] && _root_only "${_sto%/files}" && echo "${_sto}"
      ;;
  esac
  return 0
}

# True when every link on the way to $1 is a link root owns in a directory
# only root can write, so no account chose where it leads. $2 = depth.
_root_links_ok() {
  local _rest="${1#/}" _p="" _c _t _n="${2:-0}"
  [ "${_n}" -lt 8 ] || return 1
  while [ -n "${_rest}" ]; do
    _c="${_rest%%/*}"
    if [ "${_c}" = "${_rest}" ]; then
      _rest=""
    else
      _rest="${_rest#*/}"
    fi
    [ -n "${_c}" ] || continue
    _p="${_p}/${_c}"
    [ -L "${_p}" ] || continue
    [ "$(stat -c %u -- "${_p}" 2> /dev/null)" = 0 ] || return 1
    _root_only "${_p%/*}/" || return 1
    _t="$(readlink -- "${_p}" 2> /dev/null)" || return 1
    case "${_t}" in
      /*) ;;
      *) _t="${_p%/*}/${_t}" ;;
    esac
    _root_links_ok "${_t}" $(( _n + 1 )) || return 1
  done
  return 0
}

# The real path of the shared archive when /data/disk/arch is a link root made
# (migratefs, xoct, xcopy and xmass: <mount>/files/system/arch), with a plain
# path only; nothing else.
_arch_relocated_store() {
  local _s
  [ -L /data/disk/arch ] && _root_links_ok /data/disk/arch || return 0
  _s=$(readlink -f /data/disk/arch 2> /dev/null)
  case "${_s}" in
    ""|*[!A-Za-z0-9._/-]*) return 0 ;;
  esac
  [ -d "${_s}" ] && echo "${_s}"
  return 0
}

# A line for the emailed report and the validation log about content this
# run does not hold. $1 = the message.
_store_report() {
  echo "[$(date)] ${1}" >> "${_LOGFILE}"
  echo "[$(date)] ${_BUCKET_NAME}: ${1}" >> "${_VALIDATION_LOG_FILE}"
}

# Account $1's relocated files store, added to the run by its own path when
# the run includes the account's static/files (that operand or a directory
# above it): every exclude that covers static/files, or a path below it, is
# repeated for the store first, since duplicity takes the first match. A
# static/files link to anything but the store that leads outside the trees
# the run includes is reported, never followed. $2 = the run's include
# operands, $3 = its exclude operands.
_acct_store_add() {
  local _a="${1}" _d="/data/disk/${1}/static/files" _s _r _w _i _x _in=NO _add=""
  read -r -a _w <<< "${2}"
  for (( _i = 0; _i + 1 < ${#_w[@]}; _i++ )); do
    [ "${_w[_i]}" = "--include" ] || continue
    _x="${_w[_i+1]%/}"
    case "${_d}/" in
      "${_x}/"*) _in=YES ;;
    esac
  done
  [ "${_in}" = YES ] && [ -L "${_d}" ] || return 0
  _s=$(_acct_relocated_store "${_a}")
  if [ -z "${_s}" ]; then
    _r=$(readlink -f -- "${_d}" 2> /dev/null)
    if [ -n "${_r}" ] && [ -e "${_r}" ]; then
      for (( _i = 0; _i + 1 < ${#_w[@]}; _i++ )); do
        [ "${_w[_i]}" = "--include" ] || continue
        _x="${_w[_i+1]%/}"
        case "${_r}/" in
          "${_x}/"*) return 0 ;;
        esac
      done
    fi
    _store_report "Not in this backup: ${_d} is a link to $(printf '%q' "${_r:-a missing target}"), not the account's store in BOA's layout (<mount>/files/${_a}/static/files); only the link is backed up"
    return 0
  fi
  read -r -a _w <<< "${3}"
  for (( _i = 0; _i + 1 < ${#_w[@]}; _i++ )); do
    _x="${_w[_i+1]}"
    case "${_w[_i]}" in
      --exclude)
        _x="${_x%/}"
        case "${_x}" in
          "${_d}") _add="${_add} --exclude ${_s}" ;;
          "${_d}/"*) _add="${_add} --exclude ${_s}/${_x#"${_d}/"}" ;;
          *)
            case "${_d}/" in
              "${_x}/"*) _add="${_add} --exclude ${_s}" ;;
            esac
            ;;
        esac
        ;;
      --exclude-regexp)
        case "${_x}" in
          "^${_d}"*) _add="${_add} --exclude-regexp ^${_s//./\\.}${_x#"^${_d}"}" ;;
          "${_d}"*) _add="${_add} --exclude-regexp ${_s//./\\.}${_x#"${_d}"}" ;;
        esac
        ;;
    esac
  done
  _BATCH_EXCLUDE="${_BATCH_EXCLUDE}${_add}"
  _BATCH_INCLUDE="${_BATCH_INCLUDE} --include ${_s}"
}

# The global and custom runs (root's own lists and buckets): an operand that
# reaches its content through a link, such as a relocated /data/disk/arch, is
# included by its resolved path too, only when root made every link on the
# way; otherwise the operand is reported. Globs, regexps and odd names are
# left to duplicity.
_root_link_includes() {
  local _ops=() _w _i _x _r _l
  read -r -a _w <<< "${_SOURCE}"
  _ops+=("${_w[@]}")
  read -r -a _w <<< "${_INCLUDE_PATHS}"
  for (( _i = 0; _i + 1 < ${#_w[@]}; _i++ )); do
    [ "${_w[_i]}" = "--include" ] && _ops+=("${_w[_i+1]}")
  done
  if [ -s "${_INCLUDE_LIST}" ]; then
    while IFS= read -r _l || [ -n "${_l}" ]; do
      _ops+=("${_l#+ }")
    done < "${_INCLUDE_LIST}"
  fi
  for _x in "${_ops[@]}"; do
    case "${_x}" in
      /*) ;;
      *) continue ;;
    esac
    case "${_x}" in
      *[!A-Za-z0-9._/-]*) continue ;;
    esac
    _r=$(readlink -f -- "${_x}" 2> /dev/null)
    if [ -z "${_r}" ]; then
      [ -L "${_x}" ] || continue
    elif [ "${_r}" = "${_x}" ] || [ "${_r}" = "${_x%/}" ]; then
      continue
    fi
    if [ -n "${_r}" ] && [ -e "${_r}" ] && _root_links_ok "${_x}" \
      && [[ "${_r}" != *[!A-Za-z0-9._/-]* ]]; then
      _BATCH_INCLUDE="${_BATCH_INCLUDE} --include ${_r}"
    else
      _store_report "Not in this backup: ${_x} reaches its content through a link root did not make, or one that leads nowhere; only the link is backed up"
    fi
  done
}

# Backups never follow links, so content held behind one is added to the
# include set by its own path: an account's relocated files store for a
# per-account run, every included account's for the data run, and root-made
# links for the global and custom runs.
_acct_store_includes() {
  local _a
  case "${_USER}" in
    global|custom)
      _root_link_includes
      ;;
    data)
      for _a in /data/disk/*; do
        [ -d "${_a}/static" ] || continue
        _acct_store_add "${_a##*/}" "${_INCLUDE_PATHS}" "${_EXCLUDE_PATHS}"
      done
      ;;
    *)
      _acct_store_add "${_USER}" "${_USER_INCLUDE_PATHS}" "${_USER_EXCLUDE_PATHS}"
      ;;
  esac
  return 0
}

# Function to prepare backup directives
_backup_prepare() {
  if [ -e "/root/.cache/duplicity/${_NAME}" ]; then
    _CacheTest=$(find /root/.cache/duplicity/${_NAME} \
      -maxdepth 1 \
      -mindepth 1 \
      -type f \
      | sort 2>&1)
    if [[ "${_CacheTest}" =~ "No such file or directory" ]] \
      || [ -z "${_CacheTest}" ]; then
      export _cached=NO
    else
      export _cached=YES
    fi
  fi
  # Generate include directives dynamically
  [ -n "${_SOURCE}" ] && _SRC_INCLUDE=$(_generate_include_directives "${_SOURCE}")
  #
  [ -n "${_INCLUDE_PATHS}" ] && _MERGED_ALL_INCLUDE="${_INCLUDE_PATHS}"
  [ -n "${_EXCLUDE_PATHS}" ] && _MERGED_ALL_EXCLUDE="${_EXCLUDE_PATHS}"
  #
  [ -n "${_USER_INCLUDE_PATHS}" ] && _USER_MERGED_ALL_INCLUDE="${_USER_INCLUDE_PATHS}"
  [ -n "${_USER_EXCLUDE_PATHS}" ] && _USER_MERGED_ALL_EXCLUDE="${_USER_EXCLUDE_PATHS}"
  #
  [ -s "${_INCLUDE_LIST}" ] && _LST_INCLUDE="--include-filelist ${_INCLUDE_LIST}"
  [ -s "${_EXCLUDE_LIST}" ] && _LST_EXCLUDE="--exclude-filelist ${_EXCLUDE_LIST}"
  ###
  [ -n "${_MERGED_ALL_INCLUDE}" ] && _BATCH_INCLUDE="${_MERGED_ALL_INCLUDE}"
  [ -n "${_USER_MERGED_ALL_INCLUDE}" ] && _BATCH_INCLUDE="${_USER_MERGED_ALL_INCLUDE}"
  [ -n "${_LST_INCLUDE}" ] && _BATCH_INCLUDE="${_BATCH_INCLUDE} ${_LST_INCLUDE}"
  [ -n "${_SRC_INCLUDE}" ] && _BATCH_INCLUDE="${_BATCH_INCLUDE} ${_SRC_INCLUDE}"
  #
  [ -n "${_MERGED_ALL_EXCLUDE}" ] && _BATCH_EXCLUDE="${_MERGED_ALL_EXCLUDE}"
  [ -n "${_USER_MERGED_ALL_EXCLUDE}" ] && _BATCH_EXCLUDE="${_USER_MERGED_ALL_EXCLUDE}"
  [ -n "${_LST_EXCLUDE}" ] && _BATCH_EXCLUDE="${_BATCH_EXCLUDE} ${_LST_EXCLUDE}"
  #
  _acct_store_includes
  export _BATCH_INCLUDE
  export _BATCH_EXCLUDE

  _print_env "multiback_backup_prepare"
}


# Function to set backup mode
_set_mode() {
  local _user="${_USER}"
  [ -z "${_MODE}" ] && _MODE="backup"
  if [ -e "${_LOGPTH}/${_BUCKET_NAME}.archive.log" ] && [ "${_cached}" = "YES" ]; then
    export _MODE="incremental"
  else
    [ ! -e "${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.full.log" ] && export _MODE="full"
  fi
  [ -e "/root/.dev.server.cnf" ] && echo "The _MODE has been set to (${_MODE}) in _set_mode for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
  if [ "${_hostedSys}" = "YES" ]; then
    if [ "${_user}" = "global" ] || [ "${_user}" = "data" ] || [ "${_user}" = "custom" ]; then
      if [ "${_DOM}" = 1 ] && [ ! -e "${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.full.log" ]; then
        _MODE="full"
        echo "The _MODE has been re-set to (${_MODE}) in _set_mode for ${_BUCKET_NAME} on $(date)" >> ${_LOGFILE}
      fi
    fi
  else
    [ -e "/root/.dev.server.cnf" ] && echo "The FULL_BACKUP_FREQUENCY is (${FULL_BACKUP_FREQUENCY}) for ${_BUCKET_NAME}" >> ${_LOGFILE}
  fi
  export _MODE
  _print_env "multiback_set_mode"
}

# Function to construct backup command
_set_cmd() {
  local _user="${_USER}"
  if [ -z "${KEEP_WITHIN}" ] && [ -n "${_AWS_TTL}" ]; then
    export KEEP_WITHIN="${_AWS_TTL}"
  fi
  if [ -z "${FULL_BACKUP_FREQUENCY}" ] && [ -n "${_AWS_FLC}" ]; then
    export FULL_BACKUP_FREQUENCY="${_AWS_FLC}"
  fi

  # Validate or set default for KEEP_WITHIN
  _validate_or_default_duration "${KEEP_WITHIN}" "KEEP_WITHIN" "${_DEFAULT_KEEP_WITHIN}"

  # Validate or set default for FULL_BACKUP_FREQUENCY
  _validate_or_default_duration "${FULL_BACKUP_FREQUENCY}" "FULL_BACKUP_FREQUENCY" "${_DEFAULT_FULL_BACKUP_FREQUENCY}"

  ### Links are backed up as links, never followed: the trees are the
  ### accounts' own and a link there may lead anywhere root can read. An
  ### account's relocated files store is included by its own path instead
  ### (see _acct_store_includes).
  ### Default backup command with encryption
  export _DCY_BUP_CMD="/usr/local/bin/duplicity ${_MODE} \
    -v ${_AWS_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --concurrency ${_useCpu} \
    --full-if-older-than ${FULL_BACKUP_FREQUENCY} \
    --volsize 300"

  ### Default utility command with encryption
  export _DCY_UTL_CMD="/usr/local/bin/duplicity \
    -v ${_AWS_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --concurrency ${_useCpu}"

  ### Utility command with encryption at the _PRN_VLV floor; only for the
  ### legs that delete remote data (remove-older-than, cleanup --force),
  ### so remote deletions are always logged. The purge wipe deletes via
  ### the backend driver in _wipe and logs unconditionally. Deletion
  ### legs also cap the retry budget: a file already absent on the
  ### backend fails identically on every attempt, and the default five
  ### spaced attempts per file turned one historically damaged chain
  ### into a retention stall of many hours that starved the whole
  ### 6-hourly schedule on a hosted box (observed live).
  export _DCY_PRN_CMD="/usr/local/bin/duplicity \
    -v ${_PRN_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --num-retries 2 \
    --backend-retry-delay 5 \
    --concurrency ${_useCpu}"

  ### Custom backup command with encryption and enforced own FULL_BACKUP_FREQUENCY
  export _FBF_BUP_CMD="/usr/local/bin/duplicity ${_MODE} \
    -v ${_AWS_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --concurrency ${_useCpu} \
    --volsize 300"

  ### Custom backup command without encryption and enforced own FULL_BACKUP_FREQUENCY
  export _NOE_BUP_CMD="/usr/local/bin/duplicity ${_MODE} \
    -v ${_AWS_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --concurrency ${_useCpu} \
    --no-encryption \
    --volsize 300"

  ### Custom utility command without encryption
  export _NOE_UTL_CMD="/usr/local/bin/duplicity \
    -v ${_AWS_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --no-encryption \
    --concurrency ${_useCpu}"

  ### Custom prune command without encryption at the _PRN_VLV floor;
  ### same capped retry budget as _DCY_PRN_CMD, see the note there
  export _NOE_PRN_CMD="/usr/local/bin/duplicity \
    -v ${_PRN_VLV} \
    --name=${_NAME} \
    --allow-source-mismatch \
    --no-encryption \
    --num-retries 2 \
    --backend-retry-delay 5 \
    --concurrency ${_useCpu}"

  if [ "${_hostedSys}" = "YES" ]; then
    if [ "${_user}" = "global" ] || [ "${_user}" = "data" ]; then
      export _DCY_BUP_CMD="${_FBF_BUP_CMD}"
    elif [ "${_user}" = "custom" ]; then
      export _DCY_BUP_CMD="${_NOE_BUP_CMD}"
      export _DCY_UTL_CMD="${_NOE_UTL_CMD}"
      export _DCY_PRN_CMD="${_NOE_PRN_CMD}"
    fi
  fi

  _print_env "multiback_set_cmd"
}

_test() {
  local _mode="$1"
  if [ "${_mode}" != "only" ]; then
    _set_mode
    _set_cmd
  fi
  echo "Running ${_BUCKET_NAME} connection test, please wait..."
  echo "Command is ${_DCY_UTL_CMD} cleanup --dry-run --timeout 8 ${_BACKUP_TARGET}"
  _ConnTest=$(${_DCY_UTL_CMD} cleanup --dry-run --timeout 8 ${_BACKUP_TARGET} 2>&1)
  _ConnRC=$?
  # A non-zero duplicity exit fails the test -- auth and URL errors never
  # matched the historic patterns and reported a false OK. The patterns
  # stay as a net for faults duplicity reports without a failing exit.
  # Message-only by design: a non-zero multiback exit here would make
  # backchain abort a chain that still has a backup to run.
  if [[ "${_ConnRC}" -ne 0 ]] \
    || [[ "${_ConnTest}" =~ "No connection to backend" ]] \
    || [[ "${_ConnTest}" =~ "does not exist" ]] \
    || [[ "${_ConnTest}" =~ "IllegalLocationConstraintException" ]]; then
    echo "Sorry, I can't connect to ${_BUCKET_NAME}"
    # Raw duplicity output goes to a side log: _LOGFILE is later grepped
    # for the repair and OK/ERR sentinels, so foreign text stays out.
    # The b2 target embeds credentials and error text can quote the URL
    # or bare netloc, so URL userinfo is stripped and the b2 values are
    # redacted wherever they appear (URL-encoded, hence glob-safe); the
    # file stays root-only, and appending keeps same-day runs a report
    # already points to.
    _ConnErrLog="${_LOGPTH}/${_BUCKET_NAME}.${_TODAY}.conn-test-err.log"
    touch "${_ConnErrLog}"
    chmod 600 "${_ConnErrLog}"
    _ConnScrub=$(echo "${_ConnTest}" | sed 's|://[^@[:space:]]*@|://|g')
    if [[ -n "${B2_APPLICATION_KEY}" ]]; then
      _ConnScrub="${_ConnScrub//${B2_APPLICATION_KEY}/[redacted]}"
    fi
    if [[ -n "${B2_ACCOUNT_ID}" ]]; then
      _ConnScrub="${_ConnScrub//${B2_ACCOUNT_ID}/[redacted]}"
    fi
    echo "--- $(date) exit code ${_ConnRC} ---" >> "${_ConnErrLog}"
    echo "${_ConnScrub}" >> "${_ConnErrLog}"
    echo >> ${_LOGFILE}
    echo "Sorry, I can't connect to ${_BUCKET_NAME}" >> ${_LOGFILE}
    echo "The duplicity exit code was ${_ConnRC}" >> ${_LOGFILE}
    echo "Full output: ${_ConnErrLog}" >> ${_LOGFILE}
    echo "Please check the credentials and if the bucket has expected name:" >> ${_LOGFILE}
    echo " ${_BUCKET_NAME}" >> ${_LOGFILE}
    echo "This bucket must exist in the specified ${_SERVICE} region" >> ${_LOGFILE}
    echo >> ${_LOGFILE}
  else
    echo "OK, I can connect to ${_BUCKET_NAME}"
  fi
}

# Function to check collection-status only
_status() {
  echo "Command is ${_DCY_UTL_CMD} collection-status ${_BACKUP_TARGET}"
  ${_DCY_UTL_CMD} collection-status ${_BACKUP_TARGET}
  wait
}

