#!/bin/bash

export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

### The statements a dump carries that the site's own database user may not
### run: the binary-log switch and the GTID state of a dump taken where GTID
### is on (ERROR 1227; the GTID set can span lines, one server per line, so
### the statement goes through its closing quote), a routine's or an event's
### definer, a trigger's definer in double quotes (ANSI_QUOTES), and ALTER
### DATABASE lines naming the dumped database (ERROR 1044; without the name
### they apply to the database being loaded). Only a line that starts with
### the statement is changed: a data row starts with its INSERT. Plain awk,
### read the same by mawk and gawk. The quote comes in as q.
# shellcheck disable=SC2016  # an awk program: $0 is awk's, never the shell's
_SQLMAGIC_STATEMENTS_AWK='
gtid { if ($0 ~ (q ";[ \t]*$")) gtid = 0; next }
/^SET @@GLOBAL\.GTID_PURGED=/ { if ($0 !~ (q ";[ \t]*$")) gtid = 1; next }
/^SET @@SESSION\.SQL_LOG_BIN *= *(0|@MYSQLDUMP_TEMP_LOG_BIN) *;[ \t]*$/ { next }
/^CREATE DEFINER=(`[^`]*`|"[^"]*")@(`[^`]*`|"[^"]*") (PROCEDURE|FUNCTION) / {
  sub(/^CREATE DEFINER=(`[^`]*`|"[^"]*")@(`[^`]*`|"[^"]*") /, "CREATE ")
}
/^\/\*!50106 CREATE\*\/ \/\*!50117 DEFINER=/ {
  sub(/\/\*!50117 DEFINER=(`[^`]*`|"[^"]*")@(`[^`]*`|"[^"]*")[ \t]*\*\//, "")
}
/^\/\*!50003 CREATE\*\/ \/\*!50017 DEFINER="/ {
  sub(/\/\*!50017 DEFINER="[^"]*"@"[^"]*"[ \t]*\*\//, "")
}
/^ALTER DATABASE (`[^`]*`|"[^"]*") CHARACTER SET [A-Za-z0-9_]+ COLLATE [A-Za-z0-9_]+ ;+[ \t]*$/ {
  sub(/^ALTER DATABASE (`[^`]*`|"[^"]*") /, "ALTER DATABASE ")
}
{ print }
'

_sqlmagic_fix() {
  if [ -f "${_sOurce}" ]; then
    ### A pipeline reports only its LAST element, so a failed read or a
    ### full disk left a truncated (or empty) target that was still
    ### announced as the fixed dump -- which an operator then restores.
    if ! ( set -o pipefail
           cat ${_sOurce} \
             | sed 's|/\*!50001 CREATE ALGORITHM=UNDEFINED \*/|/\*!50001 CREATE \*/|g;
             s|/\*!50017 DEFINER=`[^`]*`@`[^`]*`\s*\*/||g' \
             | sed '/\*!50013 DEFINER=.*/ d' \
             | awk -v q="'" "${_SQLMAGIC_STATEMENTS_AWK}" > ${_tarGet} ); then
      echo "ERROR: could not rewrite ${_sOurce} into ${_tarGet}"
      rm -f ${_tarGet}
      echo "Bye"
      exit 1
    fi
    if ! sed -i "s/^INSERT INTO/INSERT IGNORE INTO/g" ${_tarGet}; then
      echo "ERROR: could not apply the INSERT IGNORE pass to ${_tarGet}"
      rm -f ${_tarGet}
      echo "Bye"
      exit 1
    fi
    if [ ! -s "${_tarGet}" ]; then
      echo "ERROR: ${_tarGet} came out empty -- refusing to call it a fixed dump"
      rm -f ${_tarGet}
      echo "Bye"
      exit 1
    fi
    echo "Fixed database dump stored as ${_tarGet}"
    echo "Bye"
    exit 0
  else
    echo "ERROR: specified file ${_sOurce} does not exist"
    echo "Bye"
    exit 1
  fi
}

_sqlmagic_convert() {
  if [ ! -L "${HOME}/static" ]; then
    echo "ERROR: you must be logged in as a main user, typically o1.ftp"
    echo "Bye"
    exit 1
  fi
  if [ -z "${_aliAs}" ]; then
    echo "You must specify a correct drush alias for this site, for example:"
    echo "  sqlmagic convert @sitename to-innodb"
    echo "Bye"
    exit 1
  fi
  if drush ${_aliAs} status | grep "Connected" 2>&1 \
    && [ -e "${HOME}/static" ]; then
    _THIS_VN=$(drush ${_aliAs} status \
      | grep "Drupal version" \
      | cut -d: -f2 | awk '{ print $1}')
    if [ -z "${_THIS_VN}" ]; then
      echo "ERROR: Drupal version couldn't be determined, so we can't proceed"
      echo "Bye"
      exit 1
    fi
    if [[ "${_THIS_VN}" =~ (^)"6" ]]; then
      echo "Drupal ${_THIS_VN} detected, ${_kiNd} mode allowed"
    else
      _kiNd="to-innodb"
      echo "Drupal ${_THIS_VN} detected, ${_kiNd} mode forced"
    fi
    echo "It may take a long time, please wait..."
    if [ "${_kiNd}" = "to-myisam" ]; then
      _THIS_DB=$(drush ${_aliAs} status \
        | grep "Database name" \
        | cut -d: -f2 | awk '{ print $1}')
      if [ -z "${_THIS_DB}" ]; then
        echo "ERROR: Database name couldn't be determined, so we can't proceed"
        echo "Bye"
        exit 1
      fi
      _THIS_SHOW="select TABLE_NAME FROM information_schema.TABLES \
        WHERE TABLE_SCHEMA = '${_THIS_DB}' and TABLE_TYPE = 'BASE TABLE'"
      drush ${_aliAs} sql-query "${_THIS_SHOW}" \
        | tail -n +2 \
        | xargs -I '{}' echo "ALTER TABLE {} ENGINE=MYISAM;" > \
        ${HOME}/static/to_myisam_alter_table.sql
      sed -i "s/.*TABLE_NAME.*//g; s/ *$//g; /^$/d" \
        ${HOME}/static/to_myisam_alter_table.sql &> /dev/null
      wait
      perl -p -i -e \
        's/(ALTER TABLE \
        (cache_[a-z_]+|cache|sessions|users|watchdog|accesslog) \
        ENGINE=)MYISAM/\1INNODB/g' \
        ${HOME}/static/to_myisam_alter_table.sql &> /dev/null
      wait
      if [ -s "${HOME}/static/to_myisam_alter_table.sql" ]; then
        drush ${_aliAs} sqlc < ${HOME}/static/to_myisam_alter_table.sql
        echo "Site ${_aliAs} status: database converted to MyISAM"
        echo "Bye"
      else
        echo "ERROR: resulting sql file is empty, so we can't proceed!"
        echo "Bye"
        exit 1
      fi
      rm -f ${HOME}/static/to_myisam_alter_table.sql
      exit 0
    elif [ "${_kiNd}" = "to-innodb" ]; then
      _THIS_DB=$(drush ${_aliAs} status \
        | grep "Database name" \
        | cut -d: -f2 \
        | awk '{ print $1}')
      if [ -z "${_THIS_DB}" ]; then
        echo "ERROR: Database name couldn't be determined, so we can't proceed"
        echo "Bye"
        exit 1
      fi
      _THIS_SHOW="select TABLE_NAME FROM information_schema.TABLES \
        WHERE TABLE_SCHEMA = '${_THIS_DB}' and TABLE_TYPE = 'BASE TABLE'"
      drush ${_aliAs} sql-query "${_THIS_SHOW}" \
        | tail -n +2 \
        | xargs -I '{}' echo "ALTER TABLE {} ENGINE=INNODB;" > \
        ${HOME}/static/to_innodb_alter_table.sql
      sed -i "s/.*TABLE_NAME.*//g; s/ *$//g; /^$/d" \
        ${HOME}/static/to_innodb_alter_table.sql &> /dev/null
      wait
      if [ -s "${HOME}/static/to_innodb_alter_table.sql" ]; then
        drush ${_aliAs} sqlc < ${HOME}/static/to_innodb_alter_table.sql
        echo "Site ${_aliAs} status: database converted to InnoDB"
        echo "Bye"
      else
        echo "ERROR: resulting sql file is empty, so we can't proceed!"
        echo "Bye"
        exit 1
      fi
      rm -f ${HOME}/static/to_innodb_alter_table.sql
      exit 0
    else
      echo "Invalid target format - use either to-myisam or to-innodb"
      echo "Bye"
      exit 1
    fi
  else
    echo "ERROR: Drush couldn't determine this site's status"
    echo "Bye"
    exit 1
  fi
}

case "$1" in
  fix)     _sOurce="./$2"
           _tarGet="./fixed-$2"
           _sqlmagic_fix
  ;;
  convert) _aliAs="$2"
           _kiNd="$3"
           _sqlmagic_convert
  ;;
  *)       echo "Usage: sqlmagic { fix file.sql | convert @sitename ( to-myisam | to-innodb ) }"
           exit 1
  ;;
esac

exit 0
