#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

### match the box's installed BOA tree -- the hardcoded dev asked the target
### for a dev-tree account (boa in-octopus ... ${_tRee}) from an lts or pro
### box, which sends it through the dev-licence gate. Derive from the box's
### own self-report; fall back to the newest tools ctrl marker, then to the
### historical dev default. Verbatim in xoct and xmass.
_tRee=$(boa info 2>/dev/null \
  | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
  | tail -1 \
  | grep -oE '(dev|lts|pro)$')
if [ -z "${_tRee}" ]; then
  _tRee=$(ls -t /var/log/boa/*.ctrl.* 2>/dev/null \
    | head -1 \
    | grep -oE '\.(dev|lts|pro)\.' \
    | tr -d '.')
fi
[ -z "${_tRee}" ] && _tRee=dev
export _tRee
_xSrl=$(boa info 2>/dev/null \
  | grep -oE "BOA-[0-9.]+-${_tRee}-[0-9a-zA-Z]+" \
  | tail -1 \
  | awk -F- '{ print $NF }')
[ -z "${_xSrl}" ] && _xSrl="588855${_tRee}T01"
export _xSrl

_WEBG=www-data
_THIS_DB_PORT=3306
_ieni="--ignore-errors"

###
### Avoid too many questions
###
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
if [ -z "${TERM+x}" ]; then
  export TERM=vt100
fi

###-------------SYSTEM-----------------###

_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

#
# Re-group an account's tree ON A REMOTE BOX after a copy landed there
# (transfer, sync, cutover): the copy carries this box's numeric gids, and
# on the destination those are no group at all or -- every box allocates
# account gids from the same system range -- ANOTHER account's group, whose
# identities could then read the copied credential files. instgrp reclaim
# does the whole pass where it is installed (every root incl. the sub-user
# homes and a relocated store, the marker rule, the DRIFT verdict); a
# destination without the tool gets the inline form over the same roots.
# The destination is converted when its account group exists and the
# backend or the shell identity carries it as primary (one identity that
# fell back to 'users' must not turn this into a flatten). Returns the
# pass's rc (0 clean, 2 drift left, 3 identities disagree, 4 deferred: a
# BOA run stayed live there for the whole bounded wait, so the inline form
# ran instead of the tool). Verbatim in xoct, xcopy and xmass.
# $1 = account on the destination, $2 = destination host.
_acct_regroup_remote() {
  local _X_A="$1" _X_H="$2" _X_RC
  [ -n "${_X_A}" ] && [ -n "${_X_H}" ] || return 0
  ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_X_H}" "bash -s" <<REMOTE
_A='${_X_A}'
_DEFERRED=0
if [ -x /opt/local/bin/instgrp ]; then
  # A live run on the destination (its own octopus finisher, a tool
  # refresh) makes reclaim defer with rc 4 for a short window; wait it out,
  # bounded. When it never clears, the inline form below runs instead: a
  # destination carrying log/proxied.pid is never visited by the nightly
  # (owl.sh skips it), so the pass must complete here or not at all.
  _T=0
  while :; do
    # --force: the destination's own log/proxied.pid is its demotion artefact
    # from an earlier cutover (a failback), not "served from elsewhere"; the
    # tree this run just wrote is exactly what needs the file half, and the
    # tool's freeze gate would otherwise refuse it for good
    bash /opt/local/bin/instgrp reclaim "\${_A}" --force
    _R=\$?
    [ "\${_R}" = "4" ] || exit "\${_R}"
    [ "\${_T}" -lt 12 ] || { _DEFERRED=1; break; }
    _T=\$((_T + 1))
    sleep 15
  done
fi
_G=users
if getent group "\${_A}" > /dev/null 2>&1; then
  [ "\$(id -gn "\${_A}" 2>/dev/null)" = "\${_A}" ] && _G="\${_A}"
  [ "\$(id -gn "\${_A}.ftp" 2>/dev/null)" = "\${_A}" ] && _G="\${_A}"
fi
_MP=""; _N=0
for _M in /mnt/*; do
  [ -d "\${_M}" ] && mountpoint -q "\${_M}" 2>/dev/null && { _MP="\${_M}"; _N=\$((_N + 1)); }
done
[ "\${_N}" = "1" ] || _MP=""
for _R in "/data/disk/\${_A}" "/home/\${_A}.ftp" /home/"\${_A}".* "/opt/user/gems/\${_A}" /opt/user/gems/"\${_A}".* "/opt/user/npm/\${_A}" /opt/user/npm/"\${_A}".* "\${_MP:+\${_MP}/files/\${_A}/static/files}"; do
  [ -n "\${_R}" ] && [ -d "\${_R}" ] && [ ! -L "\${_R}" ] || continue
  # the FPM pool users' homes (oN.web, oN.NN.web) are www-data's, never the
  # account's: the same root set the tool walks
  case "\${_R}" in /home/*.web) continue ;; esac
  find -P "\${_R}" ! -group "\${_G}" ! -group www-data ! -group root -execdir chgrp -h "\${_G}" {} + 2>/dev/null
done
# log/ is the account's own: the record is read and removed only inside the
# real directory, never through a link or into a FIFO put there
_W="\$(cd -P /data/disk 2>/dev/null && pwd -P)/\${_A}/log"
( cd -P -- "/data/disk/\${_A}/log" 2>/dev/null && [ "\$(pwd -P)" = "\${_W}" ] \
    && [ -f ./instance-group.txt ] || exit 0
  _GID=\$(getent group "\${_A}" 2>/dev/null | cut -d: -f3)
  { [ "\${_G}" = "\${_A}" ] \
    && timeout 10 dd if=./instance-group.txt iflag=nofollow,nonblock,fullblock \
      bs=1048576 count=1 status=none 2>/dev/null | grep -q " gid=\${_GID}\$"; } \
    || rm -f -- ./instance-group.txt )
if [ "\${_DEFERRED}" = "1" ]; then
  echo "INFO: target group pass for \${_A}: the tool deferred 13 times (a BOA run live there); the inline form ran instead, group \${_G}"
  exit 4
fi
echo "INFO: target group pass for \${_A}: group \${_G} (inline form, instgrp not installed there)"
exit 0
REMOTE
  _X_RC=$?
  [ "${_X_RC}" = "0" ] || echo "ALERT: target group pass for ${_X_A} on ${_X_H} returned ${_X_RC} (2 drift left, 3 identities disagree, 4 deferred (the inline form ran), 255 ssh); run 'instgrp status ${_X_A}' there"
  return "${_X_RC}"
}

_enable_chattr() {
  _isTest="$1"
  _isTest=${_isTest//[^a-z0-9]/}
  if [ ! -z "${_isTest}" ] && [ -d "/home/$1/" ]; then
    if [ "$1" != "${_THIS_HM_USER}.ftp" ]; then
      chattr +i /home/$1/
    else
      if [ -d "/home/$1/platforms/" ]; then
        chattr +i /home/$1/platforms/
        chattr +i /home/$1/platforms/*
      fi
    fi
    if [ -d "/home/$1/.drush/" ]; then
      chattr +i /home/$1/.drush/
    fi
    if [ -d "/home/$1/.drush/usr/" ]; then
      chattr +i /home/$1/.drush/usr/
    fi
    if [ -d "/home/$1/.bazaar/" ]; then
      chattr +i /home/$1/.bazaar/
    fi
  fi
}

_disable_chattr() {
  _isTest="$1"
  _isTest=${_isTest//[^a-z0-9]/}
  if [ ! -z "${_isTest}" ] && [ -d "/home/$1/" ]; then
    if [ "$1" != "${_THIS_HM_USER}.ftp" ]; then
      if [ -d "/home/$1/" ]; then
        chattr -i /home/$1/
      fi
    else
      if [ -d "/home/$1/platforms/" ]; then
        chattr -i /home/$1/platforms/
        chattr -i /home/$1/platforms/*
      fi
    fi
    if [ -d "/home/$1/.drush/" ]; then
      chattr -i /home/$1/.drush/
    fi
    if [ -d "/home/$1/.drush/usr/" ]; then
      chattr -i /home/$1/.drush/usr/
    fi
    # a CLI php.ini an earlier release left, for the ltd worker to remove
    if [ -f "/home/$1/.drush/php.ini" ] && [ ! -L "/home/$1/.drush" ] \
      && [ ! -L "/home/$1/.drush/php.ini" ]; then
      chattr -i /home/$1/.drush/php.ini
    fi
    if [ -d "/home/$1/.bazaar/" ]; then
      chattr -i /home/$1/.bazaar/
    fi
  fi
}

_run_drush8_hmr_cmd() {
  su -s /bin/bash - ${_THIS_HM_USER} -c "drush8 @hostmaster $1"
  wait
}

_run_drush8_nosilent_cmd() {
  su -s /bin/bash - ${_THIS_HM_USER} -c "drush8 @${_Dom} $1"
  wait
}

_migrate_sites() {
  # Account tree group, derived once for this run's account.
  _octGrp=$(_acct_group "${_oct}")
  for _Site in `find ${_USR}/config/server_master/nginx/vhost.d -maxdepth 1 -mindepth 1 -type f | sort`
  do
    _Dom=`echo ${_Site} | cut -d'/' -f9 | awk '{ print $1}'`
    _Vht="${_USR}/config/server_master/nginx/vhost.d/${_Dom}"
    _Vhd="${_USR}/config/server_master/nginx/vhost.d/.${_Dom}"
    _Vhs="${_USR}/config/server_master/nginx/vhost.d/https.${_Dom}"
    # vhost.d is under config/, which belongs to oN: the owner and mode are
    # re-asserted inside the real directory, on names that are regular files
    # there, with chown -h and a no-follow fchmod -- a link the account put at
    # either name is skipped, never handed to the account.
    if [ ! -z "${_oct}" ]; then
      _xcopy_vhd_reassert "${_Vht%/*}" "${_oct}:${_octGrp}" "${_Dom}"
      _xcopy_vhd_reassert "${_Vht%/*}" "${_oct}:${_octGrp}" ".${_Dom}"
    fi
    if [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ]; then
      echo Dom is ${_Dom}
      # .drush is oN's: the alias read inside the real directory, never
      # through a link or into a FIFO put at the name
      _Dir=$(_xcopy_read_in "${_USR}/.drush" "${_Dom}.alias.drushrc.php" | grep "site_path'" | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,']//g")
      _Plr=$(_xcopy_read_in "${_USR}/.drush" "${_Dom}.alias.drushrc.php" | grep "root'" | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,']//g")
      # site_path comes from the account's own alias and points into its own
      # tree: it is confined to the account and drushrc.php is read inside its
      # real directory, so root reads and writes a site only there. _DIR_OK
      # gates every db and drushrc step below; a refused site is counted as
      # failed on import and export. The per-site values start empty on every
      # pass, so no refusal ever names another site's.
      _DBN="" _DBU="" _DBP="" _DBP_LIT="" _DRC=""
      _DIR_OK=NO
      case "${_Dir}/" in
        "${_USR}"/*) _xcopy_in_real_dir "${_Dir}" true && _DIR_OK=YES ;;
      esac
      [ "${_DIR_OK}" = "YES" ] \
        || echo "ALRT: site ${_Dom} on ${_oct}: site_path ${_Dir} is outside the account or not a real directory -- its db/drushrc steps are skipped"
      _OWN_DB=NO
      if { [ "${_cmd}" = "import" ] || [ "${_cmd}" = "export" ]; } \
        && [ "${_DIR_OK}" = "YES" ]; then
        _xcopy_sql_maint_hold
        # drushrc.php is written with var_export(): each value is a single-quoted
        # literal in which only the quote and the backslash are escaped. Read the
        # whole file once inside its real directory, then parse the fields.
        _DRC=$(_xcopy_read_in "${_Dir}" drushrc.php)
        _DBN=$(printf '%s\n' "${_DRC}" | grep "options\['db_name'\] = " | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,';]//g")
        _DBN=${_DBN//[^a-zA-Z0-9_]/}
        _DBU=$(printf '%s\n' "${_DRC}" | sed -n "s/^\$options\['db_user'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" | head -1)
        _DBP_LIT=$(printf '%s\n' "${_DRC}" | sed -n 's/^[[:space:]]*\$options\[\x27db_passwd\x27\][[:space:]]*=[[:space:]]*\x27\(.*\)\x27;[[:space:]]*$/\1/p' \
          | head -1 | sed -e 's/\\\x27/\x27/g' -e 's/\\\\/\\/g')
        _DBP=${_DBP_LIT//[^a-zA-Z0-9_]/}
        echo "site ${_Dom} clean _DBN is ${_DBN}"
        # A database is dumped, or loaded over, only when the site's own
        # db_user equals db_name and its credentials open it.
        if [ -n "${_DBN}" ] && [ "${_DBU}" = "${_DBN}" ] \
          && _xcopy_cred_ok "${_DBN}" "${_DBP_LIT}"; then
          _OWN_DB=YES
        fi
      fi
      if [ "${_cmd}" = "import" ] && [ "${_DIR_OK}" != "YES" ]; then
        _XCOPY_SITE_IMPORT_OK=NO
        _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
        _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_Dom}:site-path-refused"
        echo "ALRT: site ${_Dom} on ${_oct}: NOT imported (site_path refused)"
      elif [ "${_cmd}" = "import" ]; then
        if [ "${_DBP}" != "${_DBP_LIT}" ]; then
          echo "ALRT: site ${_Dom} db_passwd carries characters outside the generated-password charset; not re-created here, fix its credentials by hand"
          _DBP=""
        fi
        echo "site ${_Dom} clean _DBP is ${_DBP}"
        # vhost.d is oN's: the saved dot-file is renamed over the live name
        # inside the real directory, so a link at either name is never followed.
        _xcopy_in_real_dir "${_Vht%/*}" mv -f -T -- "./.${_Dom}" "./${_Dom}" 2> /dev/null
        if [ ! -z "${_dst}" ]; then
          _TGT_HM_USER="${_dst}"
        else
          _TGT_HM_USER="${_oct}"
        fi
        # Derived here, inside the loop, so it can never carry over a site.
        _TGT_HM_GRP=$(_acct_group "${_TGT_HM_USER}")
        _xcopy_vhd_reassert "${_Vht%/*}" "${_TGT_HM_USER}:${_TGT_HM_GRP}" "${_Dom}"
        # db_host rewritten to localhost inside the real directories, each as a
        # fresh file renamed over the name (owner and mode kept), never through
        # a link or FIFO the account put at drushrc.php or the vhost.
        _xcopy_in_real_dir "${_Dir}" _xcopy_sed_here drushrc.php \
          "s/\$options\['db_host'\] = '.*/\$options[\'db_host\'] = \'localhost\';/g"
        _xcopy_in_real_dir "${_Vht%/*}" _xcopy_sed_here "${_Dom}" \
          "s/.*fastcgi_param.*db_host.*;/  fastcgi_param db_host   localhost;/g"
        echo "INFO: site ${_Dom} db_host on ${_TGT_HM_USER} fixed"
        if [ ! -z "${_DBN}" ] && [ ! -z "${_DBP}" ]; then
          _DB_FRESH=NO
          if [ ! -d "/var/lib/mysql/${_DBN}" ]; then
            _DB_FRESH=YES
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
              mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges
            else
              mysqladmin -u root flush-privileges
            fi
            [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL3 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -uroot"
            if [ -e "/root/.my.proxysql_adm_pwd.txt" ]; then
              _PROXYSQL_PASSWORD=$(cat /root/.my.proxysql_adm_pwd.txt 2>/dev/null | tr -d '\n')
              mysql -uadmin -p${_PROXYSQL_PASSWORD} -h127.0.0.1 -P6032 --protocol=tcp<<PROXYSQL
DELETE FROM mysql_users WHERE username='${_DBN}';
DELETE FROM mysql_query_rules WHERE username='${_DBN}';
INSERT INTO mysql_users (username,password,default_hostgroup) VALUES ('${_DBN}','${_DBP}','10');
LOAD MYSQL USERS TO RUNTIME;
SAVE MYSQL USERS FROM RUNTIME;
SAVE MYSQL USERS TO DISK;
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_DBN}',10,1);
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_DBN}',11,1);
LOAD MYSQL QUERY RULES TO RUNTIME;
SAVE MYSQL QUERY RULES TO DISK;
PROXYSQL
            fi
            mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -u root mysql<<EOFMYSQL
CREATE DATABASE ${_DBN} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${_DBN}'@'localhost';
CREATE USER IF NOT EXISTS '${_DBN}'@'%';
GRANT ALL ON ${_DBN}.* TO '${_DBN}'@'localhost' WITH GRANT OPTION;
GRANT ALL ON ${_DBN}.* TO '${_DBN}'@'%' WITH GRANT OPTION;
ALTER USER '${_DBN}'@'localhost' IDENTIFIED BY '${_DBP}';
ALTER USER '${_DBN}'@'%' IDENTIFIED BY '${_DBP}';
EOFMYSQL
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
              mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges
            else
              mysqladmin -u root flush-privileges
            fi
            echo "INFO: site ${_Dom} db setup on ${_oct} complete"
          else
            echo "ALRT: site ${_Dom} db ${_DBN} already exists!"
          fi
          # A dump is loaded over a database this run did NOT just create only
          # when the site proved it its own (_OWN_DB). A site with no dump
          # (target-native) writes nothing, so it is left to the branch below
          # unchanged.
          if [ -e "${_USR}/src/${_DBN}" ] \
            && [ "${_DB_FRESH}" != "YES" ] && [ "${_OWN_DB}" != "YES" ]; then
            _XCOPY_SITE_IMPORT_OK=NO
            _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
            _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}:not-owned"
            echo "ALRT: site ${_Dom} db ${_DBN} exists but the account cannot prove it owns it -- NOT loaded"
          elif [ -e "${_USR}/src/${_DBN}" ]; then
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
            fi
            [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL4 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
            if [ -x "/usr/local/bin/mydumper" ]; then
              _MYQUICK_ITD=$(mydumper -V 2>&1 \
                | tr -d "\n" \
                | tr -d "," \
                | tr -d "v" \
                | cut -d" " -f2 \
                | awk '{ print $1}' 2>&1)
              _DB_V=$(mysql -V 2>&1 \
                | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
                | head -1 \
                | cut -d"." -f1,2)
              _MD_V=$(mydumper --version 2>&1 \
                | tr -d "\n" \
                | cut -d" " -f6 \
                | awk '{ print $1}' \
                | cut -d"-" -f1 \
                | awk '{ print $1}' \
                | sed "s/[\,']//g" 2>&1)
              if [ "${_DEBUG_MODE}" = "YES" ]; then
                echo "INFO: Installed MyQuick ${_MYQUICK_ITD} for ${_MD_V} (${_DB_V})"
              fi
            fi
            _XCOPY_SITE_IMPORT_OK=NO
            ### src/ is oN's on the target: the dump directory is entered as a
            ### real directory of the account (never through a link swapped for
            ### its name), and myloader reads it as ./ from inside, so --directory
            ### can only name the proven directory.
            ### mydumper writes metadata into the outputdir as its LAST act;
            ### a transferred dir without it is a partial/hollow dump and
            ### loading it would silently restore an incomplete database.
            if ! _xcopy_in_real_dir "${_USR}/src/${_DBN}" test -e ./metadata; then
              _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
              _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db import SKIPPED on ${_oct}: no restorable dump (metadata missing in src/${_DBN})"
            elif _xcopy_in_real_dir "${_USR}/src/${_DBN}" myloader \
              --database=${_DBN} \
              --host=localhost \
              --defaults-file=/root/.my.cnf \
              --port=3306 \
              --directory=. \
              --threads=4 \
              --drop-table=DROP \
              --verbose=2; then
              _XCOPY_SITE_IMPORT_OK=YES
              echo "INFO: site ${_Dom} db import on ${_oct} complete"
            else
              _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
              _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db import FAILED on ${_oct}"
            fi
          else
            ### No transferred dump. A target-native site legitimately has
            ### none — only a site with NEITHER a dump NOR a populated local
            ### database is a real import failure (mirrors the xoct fix from
            ### the first suite leg's false positive).
            _XCOPY_LOCAL_TBLS=$(mysql --silent -u root -N -B -e \
              "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='${_DBN}'" 2>/dev/null | tr -d ' \n')
            if [[ "${_XCOPY_LOCAL_TBLS}" =~ ^[0-9]+$ ]] && [ "${_XCOPY_LOCAL_TBLS}" -gt "0" ]; then
              _XCOPY_SITE_IMPORT_OK=YES
              echo "INFO: site ${_Dom} has no transferred dump; local db ${_DBN} already populated (${_XCOPY_LOCAL_TBLS} tables) -- target-native site, left as-is"
            else
              _XCOPY_SITE_IMPORT_OK=NO
              _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
              _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db failure: no dump in ${_USR}/src/${_DBN} AND local db ${_DBN} is empty/absent"
            fi
          fi
          ### A verify over a failed import regenerates settings/vhost around
          ### a database that is not there -- schedule it only for clean loads.
          if [ "${_XCOPY_SITE_IMPORT_OK}" != "YES" ]; then
            echo "ALRT: site ${_Dom} verify NOT scheduled on ${_oct}: db import did not complete"
          elif [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ]; then
            _run_drush8_hmr_cmd "hosting-task @${_Dom} verify --force"
            echo "INFO: site ${_Dom} verify on ${_oct} scheduled"
          else
            echo "ALRT: site ${_Dom} verify failure due to missing ${_USR}/.drush/${_Dom}.alias.drushrc.php"
          fi
        else
          ### Counted: a site whose credentials cannot be parsed was NOT
          ### imported -- the run must not end 0 with imported.pid over it.
          _XCOPY_SITE_IMPORT_OK=NO
          _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
          _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_Dom}:empty-db-credentials"
          echo "ALRT: site ${_Dom} db failure due to empty _DBN/${_DBN} or _DBP/${_DBP}"
        fi
      elif [ "${_cmd}" = "export" ]; then
        if [ -x "/usr/local/bin/mydumper" ]; then
          _MYQUICK_ITD=$(mydumper -V 2>&1 \
            | tr -d "\n" \
            | tr -d "," \
            | tr -d "v" \
            | cut -d" " -f2 \
            | awk '{ print $1}' 2>&1)
          _DB_V=$(mysql -V 2>&1 \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
            | head -1 \
            | cut -d"." -f1,2)
          _MD_V=$(mydumper --version 2>&1 \
            | tr -d "\n" \
            | cut -d" " -f6 \
            | awk '{ print $1}' \
            | cut -d"-" -f1 \
            | awk '{ print $1}' \
            | sed "s/[\,']//g" 2>&1)
          if [ "${_DEBUG_MODE}" = "YES" ]; then
            echo "INFO: Installed MyQuick ${_MYQUICK_ITD} for ${_MD_V} (${_DB_V})"
          fi
        fi
        ### Only a database the site proved its own is dumped (see _OWN_DB).
        if [ "${_DIR_OK}" != "YES" ]; then
          _XCOPY_EXPORT_FAIL=$(( ${_XCOPY_EXPORT_FAIL:-0} + 1 ))
          _XCOPY_EXPORT_FAILED_DBS="${_XCOPY_EXPORT_FAILED_DBS} ${_Dom}:site-path-refused"
          echo "ALRT: site ${_Dom} on ${_oct}: site_path refused -- NOT dumped"
        elif [ "${_OWN_DB}" != "YES" ]; then
          _XCOPY_EXPORT_FAIL=$(( ${_XCOPY_EXPORT_FAIL:-0} + 1 ))
          _XCOPY_EXPORT_FAILED_DBS="${_XCOPY_EXPORT_FAILED_DBS} ${_DBN:-${_Dom}}:not-owned"
          echo "ALRT: site ${_Dom} on ${_oct}: cannot prove ${_DBN:-its database} is the account's own -- NOT dumped"
        else
        ### src/ is oN's: the per-db directory is made a real directory here (a
        ### link the account put at its name is removed) and mydumper writes it
        ### as ./ from inside, so --clear can only act on the proven directory.
        _xcopy_in_real_dir "${_USR}/src" _xcopy_realdir_here "${_DBN}"
        ### Any non-transactional table makes mydumper abort the whole
        ### database unless --trx-tables=0 is passed; mirrors mysql_backup.sh.
        _NON_TRX_COUNT=$(mysql -u root -s -N -e "SELECT COUNT(*) FROM \
information_schema.TABLES WHERE TABLE_SCHEMA='${_DBN}' AND \
TABLE_TYPE='BASE TABLE' AND ENGINE IS NOT NULL AND \
ENGINE NOT IN ('InnoDB')" 2> /dev/null)
        _MYDUMPER_TRX_OPT=""
        if [[ "${_NON_TRX_COUNT}" =~ ^[0-9]+$ ]] && [[ "${_NON_TRX_COUNT}" -gt "0" ]]; then
          _MYDUMPER_TRX_OPT="--trx-tables=0"
        fi
        ### mydumper 1.x fixed the adaptive chunker (0.21.x truncated a chunk's
        ### file to 0 bytes when a split landed past the last existing key,
        ### exiting clean), so on 1.x tables are chunked and dumped in parallel
        ### again; older builds keep chunking off (--rows=-1). A fixed --rows=N
        ### walks a sparse key span to inode exhaustion; mirrors mysql_backup.sh.
        ### Probed per call and anchored on the banner line, as in the
        ### nightly: a stray line ahead of it cannot pass as a version.
        _MYDUMPER_ROWS_OPT="--rows=-1"
        _MYDUMPER_MAJOR=$(mydumper -V 2>&1 | grep -m1 "^mydumper v" | cut -d" " -f2 | tr -d "v" | cut -d"." -f1)
        case "${_MYDUMPER_MAJOR}" in
          [1-9]*) _MYDUMPER_ROWS_OPT="" ;;
        esac
        ### _MYDUMPER_TRX_OPT and _MYDUMPER_ROWS_OPT unquoted by design: empty must expand to no argument.
        if _xcopy_in_real_dir "${_USR}/src/${_DBN}" mydumper ${_MYDUMPER_TRX_OPT} \
          --database=${_DBN} \
          --host=localhost \
          --defaults-file=/root/.my.cnf \
          --port=3306 \
          --outputdir=. \
          ${_MYDUMPER_ROWS_OPT} \
          --build-empty-files \
          --threads=4 \
          --long-query-guard=900 \
          --clear \
          --verbose=2 \
          && _xcopy_in_real_dir "${_USR}/src/${_DBN}" test -e ./metadata; then
          echo "INFO: site ${_Dom} db export on ${_oct} complete"
        else
          ### Counted, not just echoed: the run verdict must never stamp
          ### exported.pid over a failed or hollow site dump.
          _XCOPY_EXPORT_FAIL=$(( ${_XCOPY_EXPORT_FAIL:-0} + 1 ))
          _XCOPY_EXPORT_FAILED_DBS="${_XCOPY_EXPORT_FAILED_DBS} ${_DBN}"
          echo "ALRT: site ${_Dom} db export FAILED on ${_oct}"
        fi
        fi
      elif [ "${_cmd}" = "fooproxy" ]; then
        if [ -e "${_USR}/log/exported.pid" ] && [ ! -z "${_tgt}" ]; then
          if [ -e "${_Vht}" ]; then
            # vhost.d is oN's: the names are read inside the real directory,
            # and only host-name words reach the server_name line built below.
            _NMS=`_xcopy_read_in "${_Vht%/*}" "${_Vht##*/}" | grep "server_name" | sed "s/server_name//g; s/;//g" | sort | uniq | tr -d "\n" | sed "s/  / /g; s/  / /g; s/  / /g" | sort | uniq`
            _NMS="$(_xcopy_host_words "${_NMS}")"
            # vhost.d is oN's: every write runs inside the real directory on
            # ./names -- the template is rendered into a fresh file (not cp -a
            # onto the name then sed -i), the save is a pinned mv -f -T, and the
            # owner/mode are re-asserted with chown -h and a no-follow fchmod.
            if [ -e "${_USR}/config/server_master/ssl.d/${_Dom}/openssl.key" ] \
              && [ -e "/var/xdrago/conf/https_proxy_le.conf" ]; then
              _xcopy_in_real_dir "${_Vhs%/*}" _xcopy_tpl_to_here \
                /var/xdrago/conf/https_proxy_le.conf "https.${_Dom}" \
                -e "s/.*server_name.*;/  server_name  ${_NMS};/g" \
                -e "s/_target_ip/${_tgt}/g" \
                -e "s/_oct_uid/${_oct}/g" \
                -e "s/_domain_name/${_Dom}/g"
              _xcopy_vhd_reassert "${_Vhs%/*}" "${_oct}:${_octGrp}" "https.${_Dom}"
            fi
            _xcopy_in_real_dir "${_Vht%/*}" mv -f -T -- "./${_Dom}" "./.${_Dom}"
            _xcopy_in_real_dir "${_Vht%/*}" _xcopy_tpl_to_here \
              /var/xdrago/conf/proxy.conf "${_Dom}" \
              -e "s/.*server_name.*;/  server_name  ${_NMS};/g" \
              -e "s/_target_ip/${_tgt}/g"
            _xcopy_vhd_reassert "${_Vht%/*}" "${_oct}:${_octGrp}" "${_Dom}"
            echo "INFO: site ${_Dom} proxy conversion on ${_oct} complete"
          else
            echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed due to missing ${_Vht}"
          fi
        else
          echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed due to empty tgt/${_tgt}"
        fi
      fi
    fi
  done
}

_migrate_prepare() {
  # The watchdog stands down for the database verbs (_xcopy_sql_maint_hold);
  # released at the end of this function, or by the EXIT trap.
  case "${_cmd}" in
    import|export) _xcopy_sql_maint_hold ;;
  esac
  _THIS_HM_USER=${_oct}
  _USR=/data/disk/${_oct}
  # .drush and log/ are oN's: read inside the real directories, never
  # through a link or into a FIFO put at a name there
  _THIS_HM_SITE=$(_xcopy_read_in "${_USR}/.drush" hostmaster.alias.drushrc.php \
    | grep "site_path'" \
    | cut -d: -f2 \
    | awk '{ print $3}' \
    | sed "s/[\,']//g")
  echo _THIS_HM_USER ${_THIS_HM_USER}
  echo _USR ${_USR}
  echo _THIS_HM_SITE ${_THIS_HM_SITE}
  if [ -e "${_USR}/log/option.txt" ]; then
    _CLIENT_OPTION=$(_xcopy_read_in "${_USR}/log" option.txt)
    _CLIENT_OPTION=`echo -n ${_CLIENT_OPTION} | tr -d "\n"`
  fi
  if [ -e "${_USR}/log/cores.txt" ]; then
    _CLIENT_CORES=$(_xcopy_read_in "${_USR}/log" cores.txt)
    _CLIENT_CORES=`echo -n ${_CLIENT_CORES} | tr -d "\n"`
  fi
  if [ -e "${_USR}/log/subscr.txt" ]; then
    _CLIENT_SUBSCR=$(_xcopy_read_in "${_USR}/log" subscr.txt)
    _CLIENT_SUBSCR=`echo -n ${_CLIENT_SUBSCR} | tr -d "\n"`
  fi
  if [ -e "${_USR}/log/email.txt" ]; then
    _CLIENT_EMAIL="mem@tkm.cc"
    _CLIENT_EMAIL=${_CLIENT_EMAIL//\\\@/\@}
  fi

  [ -z "${_THIS_DB_PORT}" ] && _THIS_DB_PORT=3306
  [ -z "${_CLIENT_OPTION}" ] && _CLIENT_OPTION=EDGE
  [ -z "${_CLIENT_SUBSCR}" ] && _CLIENT_SUBSCR=M
  [ -z "${_CLIENT_CORES}" ]  && _CLIENT_CORES=1
  [ -z "${_CLIENT_EMAIL}" ]  && _CLIENT_EMAIL="inbox@boa.io"

  echo "_CLIENT_EMAIL is ${_CLIENT_EMAIL}"
  echo "_THIS_HM_USER is ${_THIS_HM_USER}"
  echo "_CLIENT_OPTION is ${_CLIENT_OPTION}"
  echo "_CLIENT_SUBSCR is ${_CLIENT_SUBSCR}"
  echo "_CLIENT_CORES is ${_CLIENT_CORES}"

  su -s /bin/bash ${_THIS_HM_USER} -c "drush8 cc drush"
  wait
  _disable_chattr ${_THIS_HM_USER}.ftp
  rm -rf /home/${_THIS_HM_USER}.ftp/drush-backups
  _run_drush8_hmr_cmd "sqlq \"DELETE FROM hosting_task WHERE task_type='delete' AND task_status='-1'\""
  _run_drush8_hmr_cmd "sqlq \"DELETE FROM hosting_task WHERE task_type='delete' AND task_status='0' AND executed='0'\""
  # clients/ belongs to oN: enter only real client subdirectories and remove
  # only their own backups, then prune dangling links from inside the real
  # clients/ -- never rm -rf or symlinks -dr through a link at clients or a
  # client name.
  _xcopy_clean_clients "${_USR}/clients"
  # The .ftp home and the panel site are the account's: the dangling-link
  # prune runs inside the real home, and drushrc.php is read inside its real
  # directory, never through a link or into a FIFO.
  if [ -d "/home/${_THIS_HM_USER}.ftp" ]; then
    _xcopy_in_real_dir "/home/${_THIS_HM_USER}.ftp" symlinks -dr .
    rm -f /home/${_THIS_HM_USER}.ftp/{.profile,.bash_logout,.bash_profile,.bashrc}
  fi
  if [ -e "${_THIS_HM_SITE}/drushrc.php" ]; then
    _HDB=`_xcopy_read_in "${_THIS_HM_SITE}" drushrc.php \
      | grep "options\['db_name'\] = " \
      | cut -d: -f2 \
      | awk '{ print $3}' \
      | sed "s/[\,';]//g"`
    echo "raw _HDB is ${_HDB}"
    _HDB=${_HDB//[^a-zA-Z0-9_]/}
    echo "clean _HDB is ${_HDB}"
  else
    echo "no ${_THIS_HM_SITE}/drushrc.php found"
  fi
  # src/ belongs to oN: make it a real directory (a link the account put at the
  # name is removed) so the dump below cannot be steered elsewhere.
  _xcopy_in_real_dir "${_USR}" _xcopy_realdir_here src
  if [ "${_cmd}" = "export" ] \
    && [ ! -z "${_HDB}" ] \
    && [ ! -e "${_USR}/src/prev_hostmaster.sql" ] \
    && [ ! -e "${_USR}/log/exported.pid" ]; then
      # Full hostmaster DB dump. renameaegirhost rewrites the source host/IP
      # across the entire DB on import and its task queue regenerates db-host
      # and alias entries, so a per-table allowlist (which silently dropped any
      # unlisted or newly added schema table) is no longer needed.
      # Written into the real src/ as a fresh file renamed over the name, so a
      # link the account put at prev_hostmaster.sql (even a dangling one, past
      # the -e guard above) is replaced, never followed to create its target.
      if _xcopy_in_real_dir "${_USR}/src" _xcopy_dump_hm_here \
        mysqldump -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp \
        --single-transaction \
        --quick \
        --no-autocommit \
        --skip-add-locks \
        --no-tablespaces \
        --hex-blob ${_HDB}; then
        _XCOPY_HM_DUMP_OK=YES
      else
        _XCOPY_HM_DUMP_OK=NO
      fi
    ### The redirect pre-creates the file, so the old existence test read a
    ### failed mysqldump as success and stamped exported.pid over a zero-byte
    ### or truncated panel dump. Demand rc=0 AND a non-empty file; the stamp
    ### itself moves to the run verdict AFTER _migrate_sites.
    if [ "${_XCOPY_HM_DUMP_OK}" = "YES" ] \
      && [ -s "${_USR}/src/prev_hostmaster.sql" ]; then
      echo "INFO: hostmaster ${_oct} db export complete"
    else
      ### Remove the debris so a re-run redumps from scratch instead of
      ### skipping the hostmaster block on the pre-created file.
      _xcopy_in_real_dir "${_USR}/src" rm -f -- ./prev_hostmaster.sql
      echo "ALRT: hostmaster ${_oct} db export FAILED (mysqldump error or empty dump)"
      exit 1
    fi
  fi
  if [ "${_cmd}" = "import" ] \
    && [ -e "${_USR}/config/includes/nginx_vhost_common.conf" ] \
    && [ ! -z "${_HDB}" ] \
    && [ -e "${_USR}/src/prev_hostmaster.sql" ] \
    && [ ! -e "${_USR}/log/imported.pid" ]; then
    if [ ! -z "${_dst}" ]; then
      if [ "${_oct}" = "${_dst}" ]; then
        [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL5 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
        ### Never stamp the account imported over a failed panel restore --
        ### the marker is what blocks a re-import, so a swallowed failure
        ### here strands the account permanently. xoct already checks this.
        ### src/ is oN's on the target: the dump is streamed from inside the
        ### real directory (never through a link) and fed with --binary-mode,
        ### so the client runs no \! or system command from the dump; pipefail
        ### keeps a streaming failure from passing.
        if ! ( set -o pipefail
          _xcopy_in_real_dir "${_USR}/src" _xcopy_cat_here prev_hostmaster.sql \
            | mysql --binary-mode --silent -u root -h${_SQL_CONNECT} \
              -P${_THIS_DB_PORT} --protocol=tcp ${_HDB} ); then
          echo "ERROR: hostmaster dump import into ${_HDB} FAILED -- this import is INCOMPLETE"
          echo "ERROR: nothing was stamped; fix the cause, then re-run the FULL import"
          exit 1
        fi
        _run_drush8_hmr_cmd "variable-set --always-set site_frontpage 'hosting/sites'"
        ### Clear the travelled source-role latches with the stamp -- they
        ### block this box from ever being a source itself (see xoct).
        ### log/ is oN's: removed and stamped inside the real directory.
        _xcopy_in_real_dir "${_USR}/log" rm -f -- ./exported.pid ./transferred.pid \
          ./export_failed.pid ./proxy-failed.pid
        _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here imported.pid
      fi
    else
      [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL6 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
      ### src/ is oN's on the target: streamed from inside the real directory
      ### and fed with --binary-mode (see the rename-mode branch above).
      if ! ( set -o pipefail
        _xcopy_in_real_dir "${_USR}/src" _xcopy_cat_here prev_hostmaster.sql \
          | mysql --binary-mode --silent -u root -h${_SQL_CONNECT} \
            -P${_THIS_DB_PORT} --protocol=tcp ${_HDB} ); then
        echo "ERROR: hostmaster dump import into ${_HDB} FAILED -- this import is INCOMPLETE"
        echo "ERROR: nothing was stamped; fix the cause, then re-run the FULL import"
        exit 1
      fi
      _run_drush8_hmr_cmd "variable-set --always-set site_frontpage 'hosting/sites'"
      ### Clear the travelled source-role latches with the stamp -- they
      ### block this box from ever being a source itself (see xoct).
      ### log/ is oN's: removed and stamped inside the real directory.
      _xcopy_in_real_dir "${_USR}/log" rm -f -- ./exported.pid ./transferred.pid \
        ./export_failed.pid ./proxy-failed.pid
      _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here imported.pid
    fi

    if [ "${_fix}" = "fix" ]; then
      _DOMAIN=$(_xcopy_read_in "${_USR}/log" domain.txt)
      _DOMAIN=`echo -n ${_DOMAIN} | tr -d "\n"`

      _vSet="variable-set --always-set"
      _run_drush8_hmr_cmd "${_vSet} hosting_client_send_welcome 0" &> /dev/null
    fi

  fi
  if [ "${_cmd}" = "create" ]; then
    if [ ! -z "${_dst}" ]; then
      _TGT_HM_USER="${_dst}"
    else
      _TGT_HM_USER="${_oct}"
    fi
    if [ ! -z "${_CLIENT_EMAIL}" ] \
      && [ ! -z "${_TGT_HM_USER}" ] \
      && [ ! -z "${_CLIENT_OPTION}" ] \
      && [ ! -z "${_CLIENT_SUBSCR}" ] \
      && [ ! -z "${_CLIENT_CORES}" ]; then
      ssh root@${_tgt} "/opt/local/bin/boa in-octopus ${_CLIENT_EMAIL} ${_TGT_HM_USER} ${_tRee} ${_CLIENT_OPTION} ${_CLIENT_SUBSCR} ${_CLIENT_CORES} noscreen"
      ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/.ctrl/ssl-demo-mode.pid"
      ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/config"
      ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/config.sh"
      echo "Waiting 8 minutes before attempting to run enforced post-install upgrade..."
      sleep 500
      ### Arm the enforced post-install upgrade only when the install's own
      ### in-flow upgrade has not run yet (octopus_log carries a single line).
      ### The old guard keyed on log/upgrademail.txt, which a silent install
      ### never writes, so it armed a full pass on every re-run; and the pid
      ### cleanup ran AFTER the arm, deleting the trigger it had just created.
      _xcopy_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" 'rm -f -- ./*.pid'
      ### log/ is oN's there too: octopus_log.txt is counted as read inside
      ### the real directory, never through a link or from a FIFO. Both
      ### control files are put fresh as root, then handed to the main login
      ### as the queue's own writer does (the group asked of the target).
      if _xcopy_remote_in "${_tgt}" "/data/disk/${_TGT_HM_USER}/log" \
        '[ "$(_rr octopus_log.txt | wc -l)" -lt 2 ]'; then
        _xcopy_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" \
          "_rp platforms.info \"\$(_rr platforms.info; echo UP)\"; _rp run-upgrade.pid; _g=\$(id -gn ${_TGT_HM_USER} 2> /dev/null); [ \"\${_g}\" = ${_TGT_HM_USER} ] || _g=users; chown -h ${_TGT_HM_USER}.ftp:\${_g} ./platforms.info ./run-upgrade.pid 2> /dev/null"
      fi
      echo "INFO: new octopus ${_TGT_HM_USER} setup on ${_tgt} complete"
    else
      echo "ALRT: new octopus ${_TGT_HM_USER} setup on ${_tgt} failed because of missing arguments"
      exit 1
    fi
  fi
  if [ "${_cmd}" = "import" ] \
    || [ "${_cmd}" = "export" ] \
    || [ "${_cmd}" = "fooproxy" ]; then
    _migrate_sites
  fi
  if [ "${_cmd}" = "export" ]; then
    if [ "${_XCOPY_EXPORT_FAIL:-0}" != "0" ]; then
      ### Parsed never sourced. Travels with the log/ transfer sync, so the
      ### import side refuses on it even when the operator skips the source
      ### side gate. log/ is oN's: the markers are put and removed inside the
      ### real directory, never through a link put at the name.
      {
        echo "failed=${_XCOPY_EXPORT_FAIL}"
        echo "dbs=${_XCOPY_EXPORT_FAILED_DBS# }"
        echo "time=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
      } | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here export_failed.pid
      echo "ALRT: export for ${_oct}: ${_XCOPY_EXPORT_FAIL} site database export(s) FAILED:${_XCOPY_EXPORT_FAILED_DBS}"
      echo "ERROR: NOT stamping exported.pid; transfer and import will refuse this account"
      echo "ERROR: fix the cause, then re-run 'xcopy export ${_oct} ${_tgt}${_dst:+ ${_dst}}'"
      echo "ERROR: (site dumps are redone in place; the hostmaster dump is kept)"
      _XCOPY_RUN_FAIL=YES
    elif [ -s "${_USR}/src/prev_hostmaster.sql" ]; then
      _xcopy_in_real_dir "${_USR}/log" rm -f -- ./export_failed.pid
      _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here exported.pid
      echo "INFO: export for ${_oct}: every site database dump completed; exported.pid stamped"
    fi
  fi
  if [ "${_cmd}" = "import" ]; then
    if [ "${_XCOPY_IMPORT_FAIL:-0}" != "0" ]; then
      {
        echo "failed=${_XCOPY_IMPORT_FAIL}"
        echo "dbs=${_XCOPY_IMPORT_FAILED_DBS# }"
        echo "time=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
      } | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here import_failed.pid
      echo "ALRT: import for ${_oct}: ${_XCOPY_IMPORT_FAIL} site database import(s) FAILED or SKIPPED:${_XCOPY_IMPORT_FAILED_DBS}"
      echo "ERROR: their verifies were NOT scheduled; sites with clean loads were imported normally"
      echo "ERROR: recovery -- fix the cause (re-export/re-transfer the failed dumps if hollow), then:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xcopy import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}"
      _XCOPY_RUN_FAIL=YES
    else
      _xcopy_in_real_dir "${_USR}/log" rm -f -- ./import_failed.pid
    fi
  fi
  _xcopy_sql_maint_release
  echo Done ${_cmd} for ${_USR}
  _enable_chattr ${_THIS_HM_USER}.ftp
}

# --- storage-aware store relocation (attached /mnt vs root, source vs target) ------
#
# A store directory (static/files, arch, or a legacy /mnt-anchored symlink) is
# transferred to the target honouring BOTH sides' disk reality:
#   source on a mount (symlink -> /mnt/...) + target HAS a mount -> MIRROR onto the
#       target mount and re-point the link there (even if root has room)
#   source on a mount + target has NO mount                      -> DE-REFERENCE to a
#       real dir on the target root
#   source a real dir on root                                    -> keep a real dir on
#       root; use the target mount only as a fallback if root cannot fit it
# DENY (non-zero) only when: a source symlink is dangling (attached disk not mounted),
# the target has MULTIPLE /mnt mounts, or the store fits nowhere.

# Print the target's single attached mountpoint under /mnt, "MULTI" if more than one,
# or nothing if none. Same detection migratefs + the lshell FTP-jail use.
# Prints "MULTI" (more than one), the single mountpoint path, or "NONE" (zero mounts).
# Empty output therefore means ONLY that the ssh query itself failed -> caller aborts,
# so a transient ssh hiccup never silently downgrades a mirror to a root de-reference.
_xcopy_detect_target_mnt() {
  ssh root@"$1" 'p=$(stat -c "%d" /mnt 2>/dev/null); n=0; h=""; for m in /mnt/*; do [ -d "$m" ] || continue; if mountpoint -q "$m" 2>/dev/null || { [ -n "$p" ] && [ "$(stat -c "%d" "$m" 2>/dev/null)" != "$p" ]; }; then h="$m"; n=$((n+1)); fi; done; if [ "$n" -gt 1 ]; then echo MULTI; elif [ "$n" -eq 1 ]; then printf "%s" "$h"; else echo NONE; fi'
}

# Resolve the target's attached mount into _TGT_MNT ("" = none), aborting the run on a
# failed query, an empty target host, or more than one mount. $1 = target host.
_xcopy_resolve_target_mnt() {
  local _raw
  if [ -z "$1" ]; then
    echo "ERROR: empty target host — refusing"
    exit 1
  fi
  _raw="$(_xcopy_detect_target_mnt "$1")"
  case "${_raw}" in
    MULTI)
      echo "ERROR: target $1 has multiple /mnt mounts; BOA supports a single attached mount — refusing"
      exit 1
      ;;
    NONE) _TGT_MNT="" ;;
    "")
      echo "ERROR: could not query /mnt on target $1 (ssh failed?) — refusing"
      exit 1
      ;;
    *) _TGT_MNT="${_raw}" ;;
  esac
}

# 0 if the target filesystem that would host <dest> (nearest existing ancestor) has
# room for <needKB>. Unknown size or unknown avail -> assume ok (do not block).
# --- DRY/live gate (autosymlink --batch model, keyed per account+target) -----------
# Default is a read-only DRY run that records CLEAN/NOT_CLEAN; --live proceeds only if
# the last run for THIS account+target was a CLEAN DRY, then invalidates it so one dry
# can never arm two lives.
_xcopy_state_file() {
  local _key
  _key="$(printf '%s_%s' "$1" "$2" | tr -c 'A-Za-z0-9._-' '_')"
  printf '/var/log/boa/xcopy.migrate.%s.state' "${_key}"
}
_xcopy_write_state() {   # 1 oct 2 tgt 3 status 4 mode
  local _sf; _sf="$(_xcopy_state_file "$1" "$2")"
  mkdir -p /var/log/boa 2>/dev/null
  { echo "_LAST_MODE=$4"; echo "_LAST_STATUS=$3"; echo "_LAST_TS=$(date '+%Y-%m-%d %H:%M:%S')"; } > "${_sf}"
}
_xcopy_require_clean_dry() {   # 1 oct 2 tgt -- exit unless last run was a CLEAN DRY
  local _sf _m _s; _sf="$(_xcopy_state_file "$1" "$2")"
  if [ ! -f "${_sf}" ]; then
    echo "ERROR: --live requires a prior CLEAN dry run for ${1} -> ${2}; run without --live first"
    exit 1
  fi
  _m=$(grep '^_LAST_MODE=' "${_sf}" | head -n1 | cut -d= -f2-)
  _s=$(grep '^_LAST_STATUS=' "${_sf}" | head -n1 | cut -d= -f2-)
  if [ "${_m}" != "DRY" ] || [ "${_s}" != "CLEAN" ]; then
    echo "ERROR: --live needs the last run for ${1} -> ${2} to be a CLEAN dry run (got mode=${_m:-none} status=${_s:-none}); re-run the dry run and clear any DENY first"
    exit 1
  fi
  _xcopy_write_state "$1" "$2" "LIVE" "LIVE"   # consume the clean-dry token
}
_xcopy_finalize_dry() {   # 1 oct 2 tgt
  if [ "${_XCOPY_NOT_CLEAN}" = "NO" ]; then
    echo "[DRY] CLEAN: no blocking issues. Re-run the same command with --live to perform the migration."
    _xcopy_write_state "$1" "$2" "CLEAN" "DRY"
  else
    echo "[DRY] NOT CLEAN: see DENY line(s) above. --live is refused until resolved."
    _xcopy_write_state "$1" "$2" "NOT_CLEAN" "DRY"
  fi
}
# An account's static/control is its main login's, and oN owns the rest of
# /data/disk/oN (log/, .drush): either can put a link or a FIFO at any name
# there, or at the directory itself. Root reads and writes those names only
# through these. Run "$@" inside the real directory $1: below /data/disk and
# /home every name on the path must be a real directory; once entered,
# ./name stays there whatever is swapped.
_xcopy_in_real_dir() {
  local _d="${1}" _want
  shift
  _want="$(_xcopy_real_want "${_d}")"
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_want}" ] && "$@" )
}
# ./$1 in the current (pinned) directory: never through a link, never
# blocked on a FIFO, at most 1 MiB; empty for anything else.
_xcopy_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2> /dev/null
}
# $2 in the real directory $1, read as _xcopy_read_here reads it.
### The words of $1 that are host names (letters, digits, dots, dashes, a
### leading wildcard), space-separated; anything else is dropped.
_xcopy_host_words() {
  local _w _o=""
  for _w in ${1}; do
    [[ "${_w}" =~ ^[A-Za-z0-9*][A-Za-z0-9.*-]*$ ]] || continue
    [ "${#_w}" -le 253 ] || continue
    _o="${_o} ${_w}"
  done
  printf '%s' "${_o# }"
}
_xcopy_read_in() {
  _xcopy_in_real_dir "${1}" _xcopy_read_here "${2}"
}
# ./$1 in the current (pinned) directory with exactly the bytes read from
# stdin (0644): a fresh file created exclusively, then renamed over the name,
# so a link or FIFO put there is replaced, never followed or opened.
_xcopy_write_here() {
  local _t="./.${1}.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  ( umask 022
    dd of="${_t}" conv=excl status=none 2> /dev/null ) \
    && mv -f -T -- "${_t}" "./${1}" && return 0
  rm -f -- "${_t}"
  return 1
}
# ./$1 in the current (pinned) directory as an empty marker, put the same way.
_xcopy_touch_here() {
  _xcopy_write_here "${1}" < /dev/null
}

# The same rule on the target box: the commands $3 run on the target $1
# inside the real directory $2 (below /data/disk or /home every name on the
# path a real directory), where _rr reads a name without following a link or
# blocking on a FIFO and _rp puts one as a fresh file renamed over the name
# (empty when no content is given). The target account is the tenant's once
# its identity has travelled.
_XCOPY_REMOTE_CTRL_FN='_rr() { timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2> /dev/null; }
_rp() { local _t="./.${1}.put.$$.${RANDOM}"; rm -f -- "${_t}"; if ( umask 022; { [ -n "${2}" ] && printf "%s\n" "${2}"; true; } | dd of="${_t}" conv=excl status=none 2> /dev/null ) && mv -f -T -- "${_t}" "./${1}"; then return 0; fi; rm -f -- "${_t}"; return 1; }'
_xcopy_remote_in() {
  local _a=/data/disk
  case "${2}" in /home/?*) _a=/home ;; esac
  ssh root@"${1}" "${_XCOPY_REMOTE_CTRL_FN}
_w=\"\$(cd -P ${_a} 2> /dev/null && pwd -P)${2#"${_a}"}\"
cd -P -- \"${2}\" 2> /dev/null && [ \"\$(pwd -P)\" = \"\${_w}\" ] && { ${3}; }"
}
# The commands $3 inside the real static/control of the account $2 there.
_xcopy_remote_ctrl() {
  _xcopy_remote_in "${1}" "/data/disk/${2}/static/control" "${3}"
}
# An --rsync-path that starts the receiving rsync on the target inside the
# real directory $1, so the destination is given as ./ and never resolves
# through a link the account put there; the copy fails when $1 is not that
# directory.
_xcopy_rsync_path_in() {
  local _a=/data/disk
  case "${1}" in
    /home/?*) _a=/home ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  printf '%s' "cd -P -- '${1}' && [ \"\$(pwd -P)\" = \"\$(cd -P ${_a} && pwd -P)${1#"${_a}"}\" ] && rsync"
}
# The entries of the current (pinned) directory the glob $3 names (empty:
# the directory's contents), expanded here, copied with the rsync options
# that follow into the real directory $2 on the target $1: neither end
# resolves a name on its path through a link the account put there.
_xcopy_copy_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xcopy_rsync "$@" --rsync-path="$(_xcopy_rsync_path_in "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
# As _xcopy_rsync_path_in, but the last name of $1 is made a real directory
# first (a link the account put there is removed, a missing directory made):
# for a leg whose target directory the install does not create.
_xcopy_rsync_path_mk_in() {
  local _d="${1}" _a=/data/disk _p _n
  case "${_d}" in
    /home/?*) _a=/home ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  _p="${_d%/*}"
  _n="${_d##*/}"
  printf '%s' "_a=\"\$(cd -P ${_a} && pwd -P)\"; cd -P -- '${_p}' && [ \"\$(pwd -P)\" = \"\${_a}${_p#"${_a}"}\" ] && { [ -L './${_n}' ] && rm -f './${_n}'; [ -d './${_n}' ] || mkdir './${_n}'; } && cd -P -- './${_n}' && [ \"\$(pwd -P)\" = \"\${_a}${_d#"${_a}"}\" ] && rsync"
}
# The entries of the current (pinned) directory the glob $3 names copied into
# the real directory $2 on the target $1, the target directory created when
# missing (a link there removed first).
_xcopy_copy_mk_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xcopy_rsync "$@" --rsync-path="$(_xcopy_rsync_path_mk_in "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
### Where the directory $1 resolves when every name on its path below
### /data/disk, /home or /opt/user (the client toolchain trees) is a real
### directory; elsewhere, its last name inside its resolved parent.
_xcopy_real_want() {
  local _d="${1}" _a=""
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  if [ -n "${_a}" ]; then
    printf '%s' "$(cd -P -- "${_a}" 2> /dev/null && pwd -P)${_d#"${_a}"}"
  else
    printf '%s' "$(cd -P -- "${_d%/*}" 2> /dev/null && pwd -P)/${_d##*/}"
  fi
}
### "$@" run inside the canonical directory $1, only once pwd -P lands
### exactly there.
_xcopy_in_canon_dir() {
  local _d="${1}"
  shift
  case "${_d}" in
    /?*) ;;
    *) return 1 ;;
  esac
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_d}" ] && "$@" )
}
### The --rsync-path that starts the receiver inside the canonical directory
### $1 on the target, and only once pwd -P says it is there.
_xcopy_canon_rpath() {
  local _q
  _q="$(_shq "${1}")"
  printf '%s' "cd -P -- '${_q}' && [ \"\$(pwd -P)\" = '${_q}' ] && rsync"
}
### Whether the canonical path $2 belongs to the account $1: its own tree,
### or its own part of an attached store, <mount>/files/<oN>/, the layout
### migratefs moves static/files to. Another account's tree or store, and
### anything else a link can name, never passes.
_xcopy_own_path() {
  local _a="${1}" _p="${2}" _t _r
  case "${_a}" in
    ''|.|..|*/*) return 1 ;;
  esac
  case "${_p}" in
    /?*) ;;
    *) return 1 ;;
  esac
  case "${_p}/" in
    *//*|*/./*|*/../*) return 1 ;;
  esac
  _t="$(_xcopy_real_want "/data/disk/${_a}")"
  if [ "${_t}" != "/${_a}" ]; then
    case "${_p}/" in
      "${_t}"/*) return 0 ;;
    esac
  fi
  case "${_p}" in
    /mnt/?*/files/?*)
      _r="${_p#/mnt/}"
      _r="${_r#*/}"
      case "${_r}/" in
        "files/${_a}"/*) return 0 ;;
      esac
      ;;
  esac
  return 1
}
### The canonical path $2 is the account $1's own ($3 = tree: its tree or
### store; uid: also anything owned by one of its identities, <oN>,
### <oN>.ftp or a sub-user <oN>.<name>).
_xcopy_store_is_own() {
  local _o
  _xcopy_own_path "${1}" "${2}" && return 0
  [ "${3}" = "uid" ] || return 1
  _o="$(stat -c '%U' -- "${2}" 2> /dev/null)" || return 1
  case "${_o}" in
    "${1}"|"${1}".?*) return 0 ;;
  esac
  return 1
}
### Run on the target with the account's name in $1: enter the real parent
### of $2, made as mkdir -p makes it, once the nearest existing name on the
### way and then the parent itself resolve into the account's own tree or
### store. Run in the shell that then acts on ./<last name>.
_xcopy_own_parent_cd() {
  local _a="${1}" _p="${2%/*}" _e
  [ -n "${_p}" ] || return 1
  _e="${_p}"
  while [ -n "${_e}" ] && [ ! -e "${_e}" ]; do
    _e="${_e%/*}"
  done
  _xcopy_own_path "${_a}" "$(cd -P -- "${_e:-/}" 2> /dev/null && pwd -P)" \
    || return 1
  mkdir -p -- "${_p}" 2> /dev/null
  cd -P -- "${_p}" 2> /dev/null || return 1
  _xcopy_own_path "${_a}" "$(pwd -P)"
}
### Run there as above: make the directory $3 of the account $2 ready for a
### copy and print XCREAL with its canonical path. A link at the last name
### stays when it resolves into the account's own tree or store and $1 is
### keep (the backups mover's link); otherwise it gives way to a directory.
_xcopy_own_dir_ready() {
  local _m="${1}" _a="${2}" _n="${3##*/}" _r
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xcopy_own_parent_cd "${_a}" "${3}" || return 1
  if [ -L "./${_n}" ]; then
    _r="$(cd -P -- "./${_n}" 2> /dev/null && pwd -P)"
    if [ "${_m}" != "keep" ] || ! _xcopy_own_path "${_a}" "${_r}"; then
      rm -f -- "./${_n}" || return 1
    fi
  elif [ -e "./${_n}" ] && [ ! -d "./${_n}" ]; then
    rm -f -- "./${_n}" || return 1
  fi
  [ -d "./${_n}" ] || mkdir -- "./${_n}" || return 1
  cd -P -- "./${_n}" 2> /dev/null || return 1
  _r="$(pwd -P)"
  _xcopy_own_path "${_a}" "${_r}" || return 1
  printf 'XCREAL %s\n' "${_r}"
}
### Run there as above: put the link $2 -> $3 of the account $1 in place of
### whatever holds the name, inside its real parent.
_xcopy_own_link_ready() {
  local _n="${2##*/}"
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xcopy_own_parent_cd "${1}" "${2}" || return 1
  if [ -L "./${_n}" ]; then
    rm -f -- "./${_n}"
  elif [ -d "./${_n}" ]; then
    rm -rf -- "./${_n}"
  elif [ -e "./${_n}" ]; then
    rm -f -- "./${_n}"
  fi
  ln -sfn -- "${3}" "./${_n}" || return 1
  printf 'XCREAL %s/%s\n' "$(pwd -P)" "${_n}"
}
### Run there as above: link the account $1's name $2 to its store entry $3
### only once $3 is a directory in the account's own tree or store, so a
### directory at $2 never gives way to a link that leads nowhere.
_xcopy_own_store_link_ready() {
  _xcopy_own_path "${1}" "$(cd -P -- "${3}" 2> /dev/null && pwd -P)" || return 1
  _xcopy_own_link_ready "${1}" "${2}" "${3}"
}
### Run there: make the store copy's directory $1 under the attached mount
### and print XCREAL with its canonical path, only when no name below /mnt
### on the way is a link (checked before anything is made, and again after).
_xcopy_real_mnt_dir() {
  local _d="${1}" _c _e
  case "${_d}/" in
    /mnt/?*/?*) ;;
    *) return 1 ;;
  esac
  case "${_d}/" in
    *//*|*/./*|*/../*) return 1 ;;
  esac
  _c="$(cd -P -- /mnt 2> /dev/null && pwd -P)" || return 1
  [ -n "${_c}" ] || return 1
  _e="${_d}"
  while [ -n "${_e}" ] && [ ! -e "${_e}" ]; do
    _e="${_e%/*}"
  done
  [ "$(cd -P -- "${_e:-/}" 2> /dev/null && pwd -P)" = "${_c}${_e#/mnt}" ] || return 1
  mkdir -p -- "${_d}" 2> /dev/null
  _c="${_c}${_d#/mnt}"
  cd -P -- "${_d}" 2> /dev/null || return 1
  [ "$(pwd -P)" = "${_c}" ] || return 1
  printf 'XCREAL %s\n' "${_c}"
}
### Run one of the placement helpers above as root on the box $1, with the
### helper's name and arguments after it; prints the canonical path its
### XCREAL line names and fails when there is none.
_xcopy_tgt_place() {
  local _h="${1}" _out _x _args=""
  shift
  for _x in "$@"; do
    _args="${_args} '$(_shq "${_x}")'"
  done
  _out="$( { declare -f _xcopy_real_want _xcopy_own_path _xcopy_own_parent_cd \
      _xcopy_own_dir_ready _xcopy_own_link_ready _xcopy_own_store_link_ready \
      _xcopy_real_mnt_dir
    printf '%s\n' '"$@"'; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=30 root@"${_h}" \
      "bash -s --${_args}" 2> /dev/null)"
  _out="$(printf '%s\n' "${_out}" | grep -m1 '^XCREAL /')"
  [ -n "${_out}" ] || return 1
  printf '%s' "${_out#XCREAL }"
}
### A transfer leg's source directory $1: true when it is a real directory
### to copy from. A missing one is skipped quietly; one that is not a real
### directory (a link on its path) is refused: nothing is followed, the dry
### run is not clean and a live transfer is not complete.
_xcopy_leg_ok() {
  [ -e "${1}" ] || [ -L "${1}" ] || return 1
  _xcopy_in_real_dir "${1}" true && return 0
  echo "DENY: ${1} is not a real directory (a link on its path) -- not followed, not copied"
  _XCOPY_NOT_CLEAN=YES
  [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=1
  return 1
}
### backups/ or backup-exports/ ($5) of the account tree $1 carried to the
### account tree $2 on the target $3 ($4 the rsync error option). On a box
### whose files store sits on its own device the nightly moves both into
### static/files/.<name> and leaves a link: the store leg carries that
### content, so the link is reproduced on the target once the store copy is
### there, and only when it names one plain entry straight under
### static/files. Any other backups/ is copied from inside the real
### directory it resolves to when that is the account's own tree or store,
### into the target's backups/, whose mover link is kept when it resolves
### into the account's own tree or store there; anything else is refused.
### backup-exports/ travels only as that link, as it always did.
_xcopy_backups_leg() {
  local _u="${1}" _d="${2}" _h="${3}" _ie="${4}" _n="${5}" _l _b _r _to
  _l="$(readlink "${_u}/${_n}" 2> /dev/null)"
  _b="${_l#"${_u}/static/files/"}"
  if [ -L "${_u}/${_n}" ] && [ "${_b}" != "${_l}" ] \
    && [[ "${_b}" =~ ^[A-Za-z0-9._-]+$ ]] \
    && [ "${_b}" != "." ] && [ "${_b}" != ".." ]; then
    if [ "${_MODE}" = "LIVE" ]; then
      _xcopy_tgt_place "${_h}" _xcopy_own_store_link_ready "${_d##*/}" "${_d}/${_n}" \
        "${_d}/static/files/${_b}" > /dev/null \
        || echo "ALRT: ${_d}/${_n} on ${_h} not linked to static/files/${_b} (no store copy of it there in the account's own tree or store)"
    else
      echo "[DRY-PLAN] would link ${_d}/${_n} -> ${_d}/static/files/${_b} on ${_h}"
    fi
    return 0
  fi
  [ "${_n}" = "backups" ] || return 0
  [ -e "${_u}/${_n}" ] || [ -L "${_u}/${_n}" ] || return 0
  _r="$(cd -P -- "${_u}/${_n}" 2> /dev/null && pwd -P)"
  if [ -z "${_r}" ] || ! _xcopy_own_path "${_u##*/}" "${_r}"; then
    echo "DENY: ${_u}/${_n} resolves to ${_r:-nothing}, outside the account's own tree and store -- not followed, not copied"
    _XCOPY_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=1
    return 1
  fi
  _to=""
  if [ "${_MODE}" = "LIVE" ]; then
    _to="$(_xcopy_tgt_place "${_h}" _xcopy_own_dir_ready keep "${_d##*/}" "${_d}/${_n}")"
    if [ -z "${_to}" ]; then
      echo "DENY: ${_d}/${_n} on ${_h} does not resolve into the account's own tree or store -- not copied"
      _XCOPY_NOT_CLEAN=YES
      _XCOPY_STORE_RC=1
      return 1
    fi
  fi
  # shellcheck disable=SC2086
  _xcopy_in_canon_dir "${_r}" _xcopy_copy_canon_here "${_h}" "${_to:-${_d}/${_n}}" '*' \
    -aEAXqu ${_ie} &> /dev/null
  return 0
}
### As _xcopy_copy_here, but the receiver starts in the canonical directory $2
### the target reported (see _xcopy_tgt_place).
_xcopy_copy_canon_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xcopy_rsync "$@" --rsync-path="$(_xcopy_canon_rpath "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
# ./$1 in the current (pinned) directory put at ./$2 through sed "${@:3}":
# only a regular file under 1 MiB is read, never through a link or into a
# FIFO; the result is a fresh file with the source's numeric owner (chown -h)
# and mode (by umask, never a chmod by name), renamed over ./$2. For a plain
# file this is what sed -i (and cp -a, empty program) wrote, without their
# reach through a link put at the name.
_xcopy_sed_to() {
  local _s="${1}" _n="${2}" _st _own _m _sz _ft _t
  shift 2
  _st="$(LC_ALL=C stat -c '%u:%g %a %s %F' -- "./${_s}" 2> /dev/null)" || return 1
  case "${_st}" in
    *" regular file"|*" regular empty file") ;;
    *) return 1 ;;
  esac
  read -r _own _m _sz _ft <<< "${_st}"
  [ "${_sz}" -lt 1048576 ] || return 1
  _t="./.${_n}.sed.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    umask "$(printf '%03o' $(( 0777 & ~0${_m} )))"
    _xcopy_read_here "${_s}" | sed "$@" \
      | dd of="${_t}" conv=excl status=none 2> /dev/null ); then
    chown -h "${_own}" "${_t}" 2> /dev/null
    mv -f -T -- "${_t}" "./${_n}" && return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# ./$1 rewritten in place by sed "${@:2}", as _xcopy_sed_to does it.
_xcopy_sed_here() {
  local _n="${1}"
  shift
  _xcopy_sed_to "${_n}" "${_n}" "$@"
}
# ./$2 built from the template file $1 (absolute, root-owned) piped through
# sed "${@:3}" into a fresh exclusive file (0600) renamed over the name: a
# link put at the destination is replaced, never written through.
_xcopy_tpl_to_here() {
  local _tpl="${1}" _n="${2}" _t
  shift 2
  _t="./.${_n}.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    umask 077
    sed "$@" -- "${_tpl}" | dd of="${_t}" conv=excl status=none 2> /dev/null ); then
    mv -f -T -- "${_t}" "./${_n}" && return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# chmod $1 on the regular files ./$2 ... of the current (pinned) directory
# WITHOUT following a link.
_XCOPY_FCHMOD_PL='use Fcntl;
my $m = shift @ARGV;
for my $f (@ARGV) {
  sysopen(my $h, $f, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
  chmod(oct($m), $h) if -f $h;
  close($h);
}'
_xcopy_fchmod_here() {
  local _m="${1}"
  shift
  [ "$#" -gt 0 ] || return 0
  perl -e "${_XCOPY_FCHMOD_PL}" "${_m}" "$@" 2> /dev/null
}
# Re-assert owner:group $1 and mode $2 on the regular file ./$3 of the current
# (pinned) directory: skips a non-regular name, uses chown -h and a no-follow
# fchmod, so a link the account put at the name never hands its target away.
_xcopy_reassert_here() {
  local _own="${1}" _m="${2}" _n="${3}"
  [ -f "./${_n}" ] && [ ! -L "./${_n}" ] || return 0
  chown -h "${_own}" "./${_n}" 2> /dev/null
  _xcopy_fchmod_here "${_m}" "./${_n}"
}
# The same, run inside the real vhost.d directory $1. $2 owner:group, $3 the
# vhost name, $4 the mode (default 600).
_xcopy_vhd_reassert() {
  _xcopy_in_real_dir "${1}" _xcopy_reassert_here "${2}" "${4:-600}" "${3}"
}
# The account proves it owns a database by logging in as its own user and
# using it (BOA sets db_user == db_name). $1 = db (== user), $2 = password.
_xcopy_cred_ok() {
  [ -n "$1" ] && [ -n "$2" ] \
    && mysql -u"$1" -p"$2" -h"${_SQL_CONNECT:-localhost}" \
      -P"${_THIS_DB_PORT:-3306}" --protocol=tcp -N -B \
      -e "USE \`$1\`" > /dev/null 2>&1
}
# The real (non-link) subdirectory names of the current (pinned) directory.
_xcopy_real_subdirs_here() {
  local _e
  for _e in ./*; do
    [ -d "${_e}" ] && [ ! -L "${_e}" ] && printf '%s\n' "${_e#./}"
  done
}
# clients/ ($1) is oN's: enter only real client subdirectories, remove only
# their own ./backups, then prune dangling links from inside the real dir --
# never rm -rf or symlinks -dr through a link at clients or a client name.
_xcopy_clean_clients() {
  local _cd="${1}" _c
  _xcopy_in_real_dir "${_cd}" true || return 0
  _xcopy_in_real_dir "${_cd}" _xcopy_real_subdirs_here | while IFS= read -r _c; do
    [ -n "${_c}" ] || continue
    _xcopy_in_real_dir "${_cd}/${_c}" rm -rf -- ./backups
  done
  _xcopy_in_real_dir "${_cd}" symlinks -dr .
}
# ./$1 made a real directory in the current (pinned) parent: a link the account
# put at the name is removed, a missing directory created.
_xcopy_realdir_here() {
  [ -L "./${1}" ] && rm -f -- "./${1}"
  [ -d "./${1}" ] || mkdir -p -- "./${1}"
}
# The whole regular file ./$1 of the current (pinned) directory streamed to
# stdout without following a link (unbounded, for a DB dump): a link put at the
# name yields nothing, a FIFO never blocks past the read.
_xcopy_cat_here() {
  dd if="./${1}" iflag=nofollow,nonblock status=none 2> /dev/null
}
# The hostmaster dump the command "$@" writes on stdout, captured into the
# current (pinned) src/ directory as a fresh exclusive file renamed over
# ./prev_hostmaster.sql: the command's exit code survives the pipe, a link the
# account put at the name is replaced, and a zero-byte result is refused.
_xcopy_dump_hm_here() {
  local _t="./.prev_hostmaster.sql.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    umask 077
    "$@" | dd of="${_t}" conv=excl status=none 2> /dev/null ) \
    && [ -s "${_t}" ]; then
    mv -f -T -- "${_t}" ./prev_hostmaster.sql && return 0
  fi
  rm -f -- "${_t}"
  return 1
}

# Mode-aware rsync: performs the transfer in LIVE, only reports it in DRY.
_xcopy_rsync() {
  if [ "${_MODE}" = "LIVE" ]; then
    # Trailing (after "$@") is deliberate: callers pass -a/-aEAX which implies
    # -D; rsync honours the LAST matching option, so these must follow -a to
    # actually drop device/fifo/socket nodes. Never transfer specials.
    rsync "$@" --no-devices --no-specials
  else
    echo "[DRY-PLAN] would rsync: $*"
  fi
}

# Solr indices can be large; fold them into the disk-space gate. Checks that <src>
# fits at its target destination dir (which follows the target's /var/solrN symlink
# onto a mount, or lands on root). Returns 0 if it fits (or src absent), 1 + DENY +
# NOT_CLEAN otherwise. Placement is unchanged (data-only rsync) — this only gates.
_xcopy_solr_check() {   # 1 src  2 target-dest-dir  3 label
  local _sz
  [ -e "$1" ] || return 0
  # -L: a symlink operand (e.g. a backups dir relocated into the store)
  # measures 0 with plain du, which waves the fit gate through unmeasured.
  _sz="$(du -skL "$1" 2>/dev/null | awk '{print $1}')"
  _xcopy_target_fits "${_tgt}" "$2" "${_sz}" && return 0
  echo "DENY: $3: ${_sz:-?}K does not fit at target $2 — free space and retry"
  _XCOPY_NOT_CLEAN=YES
  return 1
}

_xcopy_target_fits() {
  local _av _q
  _q="$(_shq "$2")"
  _av=$(ssh root@"$1" "p='${_q}'; while [ -n \"\$p\" ] && [ \"\$p\" != / ] && [ ! -d \"\$p\" ]; do p=\$(dirname \"\$p\"); done; df -Pk \"\$p\" 2>/dev/null | awk 'NR==2{print \$4}'" 2>/dev/null)
  if [ -z "$3" ] || [ -z "${_av}" ]; then return 0; fi
  [ "${_av}" -ge "$3" ]
}

# Single-quote-escape a value for safe embedding in a remote 'single-quoted' ssh arg
# (covers a legacy path that might contain a quote).
_shq() { printf "%s" "$1" | sed "s/'/'\\\\''/g"; }

# De-reference: real dir at <dstRoot> on the target root; rsync the contents in.
# Returns non-zero if the copy fails (caller denies). The copy leaves from
# inside the resolved source directory ($2, canonical). With an account ($5)
# the target directory is made inside a real parent in that account's own
# tree or store, and the receiver starts only in the directory it reported.
_xcopy_put_on_root() {
  local _th="$1" _real="$2" _dstRoot="$3" _ie="$4" _acct="$5" _q _dreal
  if [ -n "${_acct}" ]; then
    _dreal="$(_xcopy_tgt_place "${_th}" _xcopy_own_dir_ready dir "${_acct}" "${_dstRoot}")"
    if [ -z "${_dreal}" ]; then
      echo "DENY: ${_dstRoot} on the target does not resolve into ${_acct}'s own tree or store -- nothing copied"
      return 3
    fi
    if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
      --rsync-path="$(_xcopy_canon_rpath "${_dreal}")" -e ssh ./ root@"${_th}":./; then
      echo "DENY: rsync to ${_dstRoot} on target root failed"
      return 3
    fi
    return 0
  fi
  _q="$(_shq "${_dstRoot}")"
  ssh root@"${_th}" "if [ -L '${_q}' ]; then rm -f '${_q}'; elif [ -e '${_q}' ] && [ ! -d '${_q}' ]; then rm -f '${_q}'; fi; mkdir -p '${_q}'"
  if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} -e ssh ./ root@"${_th}":"${_dstRoot}/"; then
    echo "DENY: rsync to ${_dstRoot} on target root failed"
    return 3
  fi
}

# Mirror: rsync contents to <mntDest> on the target mount, then make <dstRoot> a symlink
# to it. The store ends up on the mount AND stays on the source, so a stale prior copy
# at <dstRoot> (e.g. an earlier de-reference to root now being moved onto a freshly
# attached disk) is safe to replace once the mount copy is confirmed. Returns non-zero
# on any failure (caller denies); the remote replace is fenced to /data/disk.
# The copy leaves from inside the resolved source directory ($2, canonical).
# With an account ($7) the mount copy lands only in a directory no link on
# the way leads to, and the link is placed inside the real parent of
# <dstRoot>, which must lie in that account's own tree or store.
_xcopy_put_on_mount() {
  local _th="$1" _real="$2" _mntDest="$3" _dstRoot="$4" _ie="$5" _lbl="$6" _acct="$7"
  local _qm _qd _mreal
  _qm="$(_shq "${_mntDest}")"; _qd="$(_shq "${_dstRoot}")"
  if [ -n "${_acct}" ]; then
    _mreal="$(_xcopy_tgt_place "${_th}" _xcopy_real_mnt_dir "${_mntDest}")"
    if [ -z "${_mreal}" ]; then
      echo "DENY: ${_lbl}: ${_mntDest} on the target is not a real directory under its mount -- nothing copied"
      return 3
    fi
    if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
      --rsync-path="$(_xcopy_canon_rpath "${_mreal}")" -e ssh ./ root@"${_th}":./; then
      echo "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed; target link left untouched"
      return 3
    fi
    if [ -z "$(_xcopy_tgt_place "${_th}" _xcopy_own_link_ready "${_acct}" "${_dstRoot}" "${_mntDest}")" ]; then
      echo "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target (its parent is not ${_acct}'s own there)"
      return 3
    fi
    return 0
  fi
  ssh root@"${_th}" "mkdir -p '${_qm}'"
  if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} -e ssh ./ root@"${_th}":"${_mntDest}/"; then
    echo "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed; target link left untouched"
    return 3
  fi
  if ! ssh root@"${_th}" "d='${_qd}'; case \"\$d\" in /data/disk/*) : ;; *) echo 'refuse: dstRoot outside /data/disk'; exit 9 ;; esac; if [ -L \"\$d\" ]; then rm -f \"\$d\"; elif [ -d \"\$d\" ]; then rm -rf \"\$d\"; elif [ -e \"\$d\" ]; then rm -f \"\$d\"; fi; mkdir -p \"\$(dirname \"\$d\")\"; ln -sfn '${_qm}' \"\$d\""; then
    echo "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target"
    return 3
  fi
}

# Storage-aware transfer of one store. Args:
#   1 source path  2 dest path on target root  3 mount-relative dest ("" => derive)
#   4 target host  5 target mount ("path"|""|"MULTI")  6 ieni  7 label
#   8 the account whose store this is ("" for a box tree such as arch)
#   9 what the account's store may resolve to: tree (its own tree or its
#     store under <mount>/files/<oN>/, the default) or uid (also anything
#     its identities own)
# The source is resolved once and copied from inside that real directory;
# an account's store that resolves anywhere else is refused, never followed.
_xcopy_handle_store() {
  local _src="$1" _dstRoot="$2" _mntRel="$3" _th="$4" _tm="$5" _ie="$6" _lbl="$7"
  local _acct="$8" _rule="${9:-tree}" _dacct=""
  local _real _link _sz _onMnt=NO _mntDest="" _act="" _reason="" _rc=0

  if [ ! -e "${_src}" ] && [ ! -L "${_src}" ]; then
    return 0
  fi
  if [ -n "${_acct}" ]; then
    _dacct="${_dstRoot#/data/disk/}"
    _dacct="${_dacct%%/*}"
  fi

  # --- classify + resolve the source ---
  if [ "${_tm}" = "MULTI" ]; then
    _act=DENY; _reason="target has multiple /mnt mounts; cannot choose one"
  elif [ -n "${_acct}" ] && { [ "${_dstRoot}" = "/data/disk/${_dacct}" ] \
    || [ "${_dstRoot#/data/disk/}" = "${_dstRoot}" ]; }; then
    _act=DENY; _reason="${_dstRoot} is not a path inside an account on the target"
  elif [ -L "${_src}" ]; then
    _link="$(readlink "${_src}" 2>/dev/null)"
    _real="$(readlink -f "${_src}" 2>/dev/null)"
    if [ -z "${_real}" ] || [ ! -d "${_real}" ]; then
      _act=DENY; _reason="${_src} is a dangling symlink (attached disk not mounted?)"
    elif [ -n "${_acct}" ] && ! _xcopy_store_is_own "${_acct}" "${_real}" "${_rule}"; then
      _act=DENY; _reason="${_src} resolves to ${_real}, outside ${_acct}'s own tree and store -- not followed"
    else
      case "${_link}" in /mnt/*) _onMnt=YES ;; esac
    fi
  elif [ -d "${_src}" ]; then
    _real="$(cd -P -- "${_src}" 2>/dev/null && pwd -P)"
    if [ -z "${_real}" ]; then
      _act=DENY; _reason="${_src} cannot be entered"
    elif [ -n "${_acct}" ] && ! _xcopy_store_is_own "${_acct}" "${_real}" "${_rule}"; then
      _act=DENY; _reason="${_src} resolves to ${_real}, outside ${_acct}'s own tree and store -- not followed"
    fi
  else
    return 0
  fi

  # --- decide (mirror / root / deny), source-shape preferred, space-checked ---
  if [ -z "${_act}" ]; then
    _sz="$(du -sk "${_real}" 2>/dev/null | awk '{print $1}')"
    if [ -z "${_mntRel}" ] && [ "${_onMnt}" = "YES" ]; then
      _mntRel="${_real#/mnt/*/}"
    fi
    [ -n "${_tm}" ] && [ -n "${_mntRel}" ] && _mntDest="${_tm}/${_mntRel}"
    if [ "${_onMnt}" = "YES" ] && [ -n "${_mntDest}" ]; then
      if _xcopy_target_fits "${_th}" "${_mntDest}" "${_sz}"; then _act=MIRROR
      elif _xcopy_target_fits "${_th}" "${_dstRoot}" "${_sz}"; then _act=ROOT
      else _act=DENY; _reason="does not fit on target mount (${_mntDest}) nor root (${_dstRoot})"; fi
    else
      if _xcopy_target_fits "${_th}" "${_dstRoot}" "${_sz}"; then _act=ROOT
      elif [ -n "${_mntDest}" ]; then _act=MIRROR
      else _act=DENY; _reason="does not fit on target root (${_dstRoot}) and no usable target mount"; fi
    fi
  fi

  # --- execute per mode: DRY reports the plan + flags NOT CLEAN on any deny; LIVE acts ---
  case "${_act}" in
    DENY)
      echo "DENY: ${_lbl}: ${_reason} — free space / fix and retry"
      _XCOPY_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && return 3
      return 0
      ;;
    MIRROR)
      if [ "${_MODE}" = "LIVE" ]; then
        _xcopy_put_on_mount "${_th}" "${_real}" "${_mntDest}" "${_dstRoot}" "${_ie}" "${_lbl}" "${_dacct}" \
          || { _rc=$?; _XCOPY_NOT_CLEAN=YES; return "${_rc}"; }
        echo "INFO: ${_lbl}: mirrored to target mount ${_mntDest}, symlinked ${_dstRoot}"
      else
        echo "[DRY-PLAN] ${_lbl}: would mirror onto target mount ${_mntDest} and symlink ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
    ROOT)
      if [ "${_MODE}" = "LIVE" ]; then
        _xcopy_put_on_root "${_th}" "${_real}" "${_dstRoot}" "${_ie}" "${_dacct}" \
          || { _rc=$?; _XCOPY_NOT_CLEAN=YES; return "${_rc}"; }
        echo "INFO: ${_lbl}: real dir on target root ${_dstRoot}"
      else
        echo "[DRY-PLAN] ${_lbl}: would place real dir on target root ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
  esac
  return 0
}

# Catch-all: any symlink (besides static/files, handled explicitly) whose OWN target
# is /mnt/... gets the same storage-aware treatment, so non-standard legacy links are
# never left dangling on the target. Sets _XCOPY_STORE_RC on any DENY. NOTE: on a rename
# the derived on-mount path keeps the SOURCE account name for a legacy link (it still
# resolves; only the mount-relative path is cosmetically old-named). A link is carried
# only when it resolves into the account's own tree or store, or to content one of its
# identities owns (such an old-named path); anything else is a DENY.
_xcopy_catchall_mnt_symlinks() {
  local _root="$1" _dstRoot="$2" _th="$3" _tm="$4" _ie="$5"
  local _l _lt _rel _dl
  while IFS= read -r _l; do
    [ -n "${_l}" ] || continue
    [ "${_l}" = "${_root}/static/files" ] && continue
    _lt="$(readlink "${_l}" 2>/dev/null)"
    case "${_lt}" in /mnt/*) : ;; *) continue ;; esac
    _rel="${_l#"${_root}"/}"
    _dl="${_dstRoot}/${_rel}"
    _xcopy_handle_store "${_l}" "${_dl}" "" "${_th}" "${_tm}" "${_ie}" "legacy symlink ${_rel}" \
      "${_root##*/}" uid || _XCOPY_STORE_RC=$?
  done <<EOF
$(find "${_root}" -type l 2>/dev/null)
EOF
}

_xcopy_transfer_static_symlink_safe() {
  _X_SRC_USR="$1"
  _X_TGT_HOST="$2"
  _X_DST_USR="$3"
  _X_IENI="$4"
  _X_TGT_MNT="$5"

  _X_SRC_STATIC="${_X_SRC_USR}/static"
  _X_DST_STATIC="${_X_DST_USR}/static"
  _X_DST_STATIC_FILES="${_X_DST_USR}/static/files"
  _X_DST_ACCT="$(basename "${_X_DST_USR}")"

  if [ ! -d "${_X_SRC_STATIC}" ]; then
    return 0
  fi

  echo "INFO: Static sync pass 1/2 (preserve symlinks, exclude static/files)"
  mkdir -p "${_X_SRC_USR}/static"
  ### Anchored to the transfer root: the unanchored form dropped EVERY path
  ### component named "files" anywhere beneath static/ (silent data loss on
  ### codebases that ship nested files/ dirs). Mirrors the xoct call site.
  ### static/ is the account's on both boxes: the copy runs from inside the
  ### real directory with a relative source, and the receiving rsync starts
  ### inside the real static/ on the target, so neither end resolves static/
  ### through a link put in its place. A static/ that is not a real
  ### directory here is never followed, and the transfer is not complete.
  if ! _xcopy_in_real_dir "${_X_SRC_STATIC}" true; then
    echo "DENY: ${_X_SRC_STATIC} is not a real directory -- not followed; static/ not copied"
    _XCOPY_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=1
    return 1
  fi
  _xcopy_in_real_dir "${_X_SRC_STATIC}" _xcopy_copy_here "${_X_TGT_HOST}" \
    "${_X_DST_STATIC}" '' -aEAXqu ${_X_IENI} --exclude=/files

  echo "INFO: Static sync pass 2/2 (materialize/mirror static/files per target disk reality)"
  # Canonical mount layout uses the DEST account name, so a rename lands correctly.
  _xcopy_handle_store \
    "${_X_SRC_USR}/static/files" \
    "${_X_DST_STATIC_FILES}" \
    "files/${_X_DST_ACCT}/static/files" \
    "${_X_TGT_HOST}" "${_X_TGT_MNT}" "${_X_IENI}" \
    "static/files (${_X_DST_ACCT})" "${_X_SRC_USR##*/}" || _XCOPY_STORE_RC=$?
}

_migrate_init() {
  _USR=/data/disk/${_oct}
  if [ "${_oct}" = "arch" ] \
    || [ "${_oct}" = "all" ] \
    || [ "${_oct}" = "lost+found" ] \
    || [ "${_oct}" = "lostfound" ] \
    || [ "${_oct}" = "backups" ] \
    || [ "${_oct}" = "codebases-cleanup" ]; then
    echo "_USR ${_oct} is not eligible for migration: system dir"
    exit 1
  fi
  if [ ! -e "${_USR}/tools/le/dehydrated" ] && [ "${_oct}" != "shared" ]; then
    echo
    echo "ERROR: This version of xcopy migration tool supports only BOA-3.2.2 or newer"
    echo "ERROR: Please upgrade ${_oct} instance to current BOA head before trying again"
    echo "Bye."
    echo
    exit 1
  fi
  if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
    _SQL_CONNECT=127.0.0.1
    _THIS_DB_PORT=6033
  fi
  if [ "${_oct}" = "xusage" ]; then
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} start"
    if [ -e "/var/log/boa/usage" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/log/boa/usage/* root@${_tgt}:/var/log/boa/usage/
      echo "INFO: ${_cmd} for ${_oct} /var/log/boa/usage complete"
    fi
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} complete"
  elif [ "${_oct}" = "shared" ]; then
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} start"
    # Refuse an empty target: an empty ssh host resolves to localhost, so the arch
    # step's remote mkdir/rm would run against THIS (source) box and could delete the
    # live arch symlink. Never proceed with the shared sync without a real target.
    # Resolve the target's attached mount (aborts on empty/unreachable/multi-mount).
    _xcopy_resolve_target_mnt "${_tgt}"
    # --live requires a prior CLEAN dry run for this shared+target.
    [ "${_MODE}" = "LIVE" ] && _xcopy_require_clean_dry "${_oct}" "${_tgt}"
    _XCOPY_STORE_RC=0
    if [ -d "/data/all" ] && [ ! -L "/data/all" ]; then
      _xcopy_rsync -aEAXqu ${_ieni} -e ssh /data/all  root@${_tgt}:/data/
      echo "INFO: ${_cmd} for ${_oct} /data/all complete"
    fi
    if [ -d "/data/disk/all" ]; then
      _xcopy_rsync -aEAXqu ${_ieni} -e ssh /data/disk/all  root@${_tgt}:/data/
      echo "INFO: ${_cmd} for ${_oct} /data/disk/all complete"
    fi
    # arch: storage-aware -- mirror onto the target mount, or de-reference to root,
    # per the target's disk reality (canonical layout <mount>/files/system/arch).
    _xcopy_handle_store "/data/disk/arch" "/data/disk/arch" "files/system/arch" \
      "${_tgt}" "${_TGT_MNT}" "${_ieni}" "arch" || _XCOPY_STORE_RC=$?
    if [ "${_XCOPY_STORE_RC:-0}" != "0" ]; then
      echo "ERROR: ${_cmd} for ${_oct}: arch could not be placed on the target (see DENY above); refusing"
      exit 1
    fi
    ### Hard stop, matching xmass and the old tool: a Solr leg that does not
    ### fit means this account arrives WITHOUT its search indices, and
    ### nothing in the LIVE path reads _XCOPY_NOT_CLEAN, so skipping it
    ### finishes "clean" while quietly losing the data.
    if [ -e "/opt/solr4" ]; then
      if ! _xcopy_solr_check "/opt/solr4" "/opt" "solr4"; then
        echo "ERROR: solr4 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to copy ${_oct} without its search indices"
        exit 1
      fi
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /opt/solr4 root@${_tgt}:/opt/
      echo "INFO: ${_cmd} for ${_oct} /opt/solr4 complete"
    fi
    if [ -e "/var/solr7/data" ]; then
      if ! _xcopy_solr_check "/var/solr7/data" "/var/solr7" "solr7"; then
        echo "ERROR: solr7 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to copy ${_oct} without its search indices"
        exit 1
      fi
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/solr7/data root@${_tgt}:/var/solr7/
      echo "INFO: ${_cmd} for ${_oct} /var/solr7/data complete"
    fi
    if [ -e "/var/solr9/data" ]; then
      if ! _xcopy_solr_check "/var/solr9/data" "/var/solr9" "solr9"; then
        echo "ERROR: solr9 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to copy ${_oct} without its search indices"
        exit 1
      fi
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/solr9/data root@${_tgt}:/var/solr9/
      echo "INFO: ${_cmd} for ${_oct} /var/solr9/data complete"
    fi
    if [ -e "/var/www/static" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/www/static root@${_tgt}:/var/www/
      echo "INFO: ${_cmd} for ${_oct} /var/www/static complete"
    fi
    if [ -e "/etc/bind" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /etc/bind root@${_tgt}:/etc/
      echo "INFO: ${_cmd} for ${_oct} /etc/bind complete"
    fi
    if [ -e "/var/log/boa/usage" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/log/boa/usage root@${_tgt}:/var/log/boa/
      echo "INFO: ${_cmd} for ${_oct} /var/log/boa/usage complete"
    fi
    if [ -e "/data/disk/legacy" ]; then
      echo "INFO: ${_cmd} for ${_oct} /data/disk/legacy start"
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /data/disk/legacy root@${_tgt}:/data/disk/
      echo "INFO: ${_cmd} for ${_oct} /data/disk/legacy complete"
    fi
    if [ "${_MODE}" = "LIVE" ]; then
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} complete"
    else
      _xcopy_finalize_dry "${_oct}" "${_tgt}"
    fi
  else
    _USR=/data/disk/${_oct}
    if [ -e "${_USR}/log/email.txt" ]; then
      _CHECK_EMAIL=$(_xcopy_read_in "${_USR}/log" email.txt)
      _CHECK_EMAIL=`echo -n ${_CHECK_EMAIL} | tr -d "\n"`
      _CHECK_EMAIL=${_CHECK_EMAIL//\\\@/\@}
      if [ "${_CHECK_EMAIL}" = "inbox@boa.io" ] \
        || [[ "${_CHECK_EMAIL}" =~ "emaylx@" ]] \
        || [[ "${_CHECK_EMAIL}" =~ "mixomax@" ]] \
        || [[ "${_CHECK_EMAIL}" =~ "@omega8.cc" ]]; then
        _RESULT_EMAIL=OUR
      else
        _RESULT_EMAIL=OK
      fi
    fi
    if [ "${_oct}" = "arch" ] \
      || [ "${_oct}" = "all" ] \
      || [ "${_oct}" = "lost+found" ] \
      || [ "${_oct}" = "lostfound" ] \
      || [ "${_oct}" = "backups" ] \
      || [ "${_oct}" = "codebases-cleanup" ]; then
      echo "_USR ${_oct} is not eligible for migration: system dir"
      exit 1
    elif [ ! -e "${_USR}/log/cores.txt" ] \
      || [ ! -e "${_USR}/log/option.txt" ] \
      || [ ! -e "${_USR}/log/email.txt" ]; then
      echo "_USR ${_oct} is not eligible for migration: broken"
      exit 1
    elif [ -e "${_USR}/log/CANCELLED" ]; then
      echo "_USR ${_oct} is not eligible for migration: cancelled"
      exit 1
    elif [ -e "${_USR}/log/proxied.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already migrated"
      exit 1
    elif [ "${_cmd}" = "create" ] && [ -e "${_USR}/log/exported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already created"
      exit 1
    elif [ "${_cmd}" = "export" ] && [ -e "${_USR}/log/exported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already exported"
      exit 1
    elif [ "${_cmd}" = "transfer" ] && [ -e "${_USR}/log/transferred.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already transferred"
      exit 1
    elif [ "${_cmd}" = "transfer" ] && [ -e "${_USR}/log/export_failed.pid" ] \
      && [ "${_XCOPY_FORCE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: export incomplete"
      echo "ALRT: log/export_failed.pid is present -- the last export left FAILED site dumps:"
      _xcopy_read_in "${_USR}/log" export_failed.pid | sed "s/^/ALRT:   /"
      echo "INFO: re-run 'xcopy export' after fixing the cause, or pass --force to transfer anyway"
      exit 1
    elif [ "${_cmd}" = "import" ] && [ -e "${_USR}/log/export_failed.pid" ] \
      && [ "${_XCOPY_FORCE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: export incomplete"
      echo "ALRT: log/export_failed.pid travelled with this account -- the source export left FAILED site dumps:"
      _xcopy_read_in "${_USR}/log" export_failed.pid | sed "s/^/ALRT:   /"
      echo "INFO: fix and re-run export + transfer on the source, or pass --force to import anyway"
      exit 1
    elif [ "${_cmd}" = "import" ] && [ -e "${_USR}/log/imported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already imported"
      exit 1
    elif [ "${_cmd}" = "fooproxy" ] && [ -e "${_USR}/log/proxied.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already proxied"
      exit 1
    elif [ "${_RESULT_EMAIL}" = "OUR" ]; then
      echo "_USR ${_oct} is not eligible for migration: internal only"
      exit 1
    else
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} start"
      if [ "${_XCOPY_FORCE}" = "YES" ] && [ -e "${_USR}/log/export_failed.pid" ]; then
        if [ "${_cmd}" = "transfer" ] || [ "${_cmd}" = "import" ]; then
          echo "ALRT: --force: proceeding although log/export_failed.pid marks FAILED site dumps"
        fi
      fi
      if [ "${_cmd}" = "transfer" ] || [ "${_cmd}" = "pretransfer" ]; then
        if [ ! -z "${_dst}" ]; then
          _DST=/data/disk/${_dst}
        else
          _DST=/data/disk/${_oct}
        fi
        # Resolve the target's attached mount (aborts on empty/unreachable/multi-mount).
        _xcopy_resolve_target_mnt "${_tgt}"
        # --live requires a prior CLEAN dry run for this account+target.
        [ "${_MODE}" = "LIVE" ] && _xcopy_require_clean_dry "${_oct}" "${_tgt}"
        _XCOPY_STORE_RC=0
        if [ -e "${_USR}" ]; then
          # distro/ and src/ belong to oN on both boxes: each leg expands its
          # glob inside the real source directory and the receiver writes inside
          # the real target directory (created when missing), so a link the
          # account put at either name is never followed or written through.
          # A leg whose source is not a real directory is refused (DENY) by
          # _xcopy_leg_ok, never skipped quietly.
          _xcopy_leg_ok "${_USR}/distro" \
            && _xcopy_in_real_dir "${_USR}/distro" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/distro" '*' -aEAXqu ${_ieni}
          _xcopy_leg_ok "${_USR}/src" \
            && _xcopy_in_real_dir "${_USR}/src" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/src" '*' -aEAXqu ${_ieni}
          _xcopy_transfer_static_symlink_safe "${_USR}" "${_tgt}" "${_DST}" "${_ieni}" "${_TGT_MNT}"
          #
          # clients/ is oN's on both boxes: pinned both ends, target made real.
          _xcopy_leg_ok "${_USR}/clients" \
            && _xcopy_in_real_dir "${_USR}/clients" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/clients" '*' -aEAXqu ${_ieni}
          # instance-group.txt records the SOURCE box's conversion (its gid);
          # it must never travel, the destination pass writes its own.
          # log/ is oN's on both boxes: copied from inside the real directory
          # into the real directory, the glob expanded there.
          _xcopy_leg_ok "${_USR}/log" \
            && _xcopy_in_real_dir "${_USR}/log" _xcopy_copy_here "${_tgt}" "${_DST}/log" '*' \
              -aEAXqu ${_ieni} --exclude=instance-group.txt --exclude=proxy-failed.pid
          # static/control is the tenant's on both boxes: a control that is a
          # link is never followed (the glob this replaces expanded through
          # it); a real one travels by its top-level entries, from inside it
          # into the real control directory on the target. Its subdirectories
          # came with the static pass above and are never entered here by name.
          if [ -L "${_USR}/static/control" ]; then
            echo "ALRT: ${_USR}/static/control is a symlink -- not followed; no control file travels"
          elif [ -d "${_USR}/static/control" ]; then
            _xcopy_in_real_dir "${_USR}/static/control" _xcopy_copy_here "${_tgt}" \
              "${_DST}/static/control" '' -aEAXqu ${_ieni} --exclude='*/'
          fi
          #
          # backups/ and backup-exports/ follow the nightly's store layout
          # (see _xcopy_backups_leg). undo/ is oN's on both boxes: pinned both
          # ends, the target directory made real (the installer does not).
          _xcopy_backups_leg "${_USR}" "${_DST}" "${_tgt}" "${_ieni}" backups
          _xcopy_backups_leg "${_USR}" "${_DST}" "${_tgt}" "${_ieni}" backup-exports
          _xcopy_leg_ok "${_USR}/undo" \
            && _xcopy_in_real_dir "${_USR}/undo" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/undo" '*' -aEAXqu ${_ieni}
          # The account's SSH keys: from the real directory into the real one.
          _xcopy_leg_ok "/home/${_oct}.ftp/.ssh" \
            && _xcopy_in_real_dir "/home/${_oct}.ftp/.ssh" _xcopy_copy_mk_here \
              "${_tgt}" "/home/${_DST##*/}.ftp/.ssh" '' -aEAXqu ${_ieni}

          ### No excludes here, and that is deliberate. This leg used to pass
          ### --exclude=server_ and --exclude=hostmaster, which could never
          ### match anything: an rsync pattern with no slash is matched
          ### against the FINAL path component, and with no wildcard the match
          ### must be exact, so those two would only have excluded files
          ### literally named `server_` and `hostmaster` -- never
          ### `server_master.alias.drushrc.php` or
          ### `hostmaster.alias.drushrc.php`. xoct and xmass removed them
          ### already; carrying them here read as if the two aliases were
          ### being held back when they were being transferred all along.
          ### .drush is oN's on both boxes: copied from inside the real
          ### directory into the real directory, the glob expanded there.
          _xcopy_leg_ok "${_USR}/.drush" \
            && _xcopy_in_real_dir "${_USR}/.drush" _xcopy_copy_here "${_tgt}" \
              "${_DST}/.drush" '*.alias.drushrc.php' -aEAXqu ${_ieni}

          # config/ and tools/ belong to oN on both boxes: every leg below
          # expands its glob inside the real source directory and the receiver
          # writes inside the real target directory (created when missing), so a
          # link the account put at a directory name is never followed or written
          # through. Subdirectories below the top level are still walked by rsync
          # as it finds them.
          _xcopy_leg_ok "${_USR}/config/server_master/nginx/vhost.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/vhost.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/vhost.d" '*' \
              -aEAXqu ${_ieni} --exclude=host8.biz --exclude=boa.io --exclude=aegir.cc

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/pre.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/pre.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/pre.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/post.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/post.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/post.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/subdir.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/subdir.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/subdir.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/platform.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/platform.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/platform.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/ssl.d" \
            && _xcopy_in_real_dir "${_USR}/config/ssl.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/ssl.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/server_master/ssl.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/ssl.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/ssl.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/tools" \
            && _xcopy_in_real_dir "${_USR}/tools" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/tools" 'le' \
              -aEAXqu ${_ieni}

          # Catch-all: fix any OTHER /mnt-anchored symlink in the account tree that the
          # rsync -a passes above transferred as a bare (dangling-on-target) link.
          _xcopy_catchall_mnt_symlinks "${_USR}" "${_DST}" "${_tgt}" "${_TGT_MNT}" "${_ieni}"

          if [ "${_XCOPY_STORE_RC:-0}" != "0" ]; then
            echo "ERROR: ${_cmd} for ${_oct}: a store/symlink could not be placed on the target (see DENY above); NOT marking transfer complete"
            exit 1
          fi

          if [ "${_MODE}" = "LIVE" ]; then
            # The copy landed with this box's numeric gids; hand the tree
            # to the account's group on the target (mirrors xoct).
            _acct_regroup_remote "${_dst:-${_oct}}" "${_tgt}"
            echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} complete"
            # Only the real transfer marks the account migrated -- pretransfer
            # shares this completion path (warm-up rsync while the account is
            # still live) and marking it here made the documented
            # pretransfer -> export -> transfer sequence self-blocking at the
            # transferred.pid eligibility gate. Mirrors the xoct fix.
            if [ "${_cmd}" = "transfer" ]; then
              ### A transfer that passed the export gate means the source's
              ### export is clean now -- a stale export_failed.pid that
              ### travelled with an earlier --force transfer must not wedge
              ### the import on the target forever.
              ### log/ is oN's on both boxes: removed and stamped inside the
              ### real directory, never through a link put there.
              if [ ! -e "${_USR}/log/export_failed.pid" ]; then
                _xcopy_remote_in "${_tgt}" "${_DST}/log" 'rm -f -- ./export_failed.pid' &> /dev/null
              fi
              _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here transferred.pid
            fi
          else
            _xcopy_finalize_dry "${_oct}" "${_tgt}"
          fi
        fi
      else
        # shellcheck disable=SC1091
        [ -e "/root/.${_oct}.octopus.cnf" ] && source /root/.${_oct}.octopus.cnf
        ### We are using max verbose mode by default
        _migrate_prepare
          ### _NOW=$(date +%y%m%d-%H%M)
          ### mkdir -p /var/log/boa/migrate
          ### _migrate_prepare >/var/log/boa/migrate/migrate-${_oct}-${_cmd}-${_NOW}.log 2>&1
        if [ "${_cmd}" = "fooproxy" ]; then
          service nginx reload
          # log/ is oN's: stamped inside the real directory, never through a link
          echo COMPLETE | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here proxied.pid
        fi
      fi
      if [ "${_XCOPY_RUN_FAIL}" = "YES" ]; then
        ### Truthful run verdict: per-site ALRT lines above already name the
        ### failures; harness callers key on the rc.
        echo "ALRT: ${_cmd} for ${_oct} to ${_tgt} ${_dst} INCOMPLETE -- see ALRT/ERROR lines above"
        exit 1
      fi
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} complete"
      exit 0
    fi
  fi
}

_post_mig() {
  if [ -e "/vservers" ]; then
    echo You can not run _post_mig on the parent system
    echo Exit now
    exit 1
  else
    echo Running _post_mig inside vms ${_hName}
    if [ -x "/etc/init.d/solr9" ] && [ -e "/etc/default/solr9.in.sh" ]; then
      pkill -9 -f '^[^ ]*java[0-9]* .*solr9'
      service solr9 start
    fi
    if [ -x "/etc/init.d/solr7" ] && [ -e "/etc/default/solr7.in.sh" ]; then
      pkill -9 -f '^[^ ]*java[0-9]* .*solr7'
      service solr7 start
    fi
    pkill -9 -f '^[^ ]*java[0-9]* .*jetty9'
    rm -rf /tmp/{drush*,pear,jetty*}
    rm -f /var/log/jetty9/*
    if [ -e "/etc/default/jetty9" ] && [ -e "/etc/init.d/jetty9" ]; then
      service jetty9 start
    fi
    service nginx reload
    [ -e "/run/boa_wait.pid" ] && rm -f /run/boa_wait.pid
    if [ ! -e "/var/xdrago/runner.sh" ] && [ -e "/var/xdrago/.runner.sh.off" ]; then
      mv -f /var/xdrago/.runner.sh.off /var/xdrago/runner.sh
    fi
    if [ ! -e "/var/xdrago/owl.sh" ] && [ -e "/var/xdrago/.owl.sh.off" ]; then
      mv -f /var/xdrago/.owl.sh.off /var/xdrago/owl.sh
    fi
    if [ ! -e "/var/xdrago/usage.sh" ] && [ -e "/var/xdrago/.usage.sh.off" ]; then
      mv -f /var/xdrago/.usage.sh.off /var/xdrago/usage.sh
    fi
    if [ ! -e "/var/xdrago/graceful.sh" ] && [ -e "/var/xdrago/.graceful.sh.off" ]; then
      mv -f /var/xdrago/.graceful.sh.off /var/xdrago/graceful.sh
    fi
    if [ ! -e "/var/xdrago/manage_ltd_users.sh" ] && [ -e "/var/xdrago/.manage_ltd_users.sh.off" ]; then
      mv -f /var/xdrago/.manage_ltd_users.sh.off /var/xdrago/manage_ltd_users.sh
    fi
    exit 0
  fi
}

_pre_mig() {
  if [ -e "/vservers" ]; then
    echo You can not run _pre_mig on the parent system
    echo Exit now
    exit 1
  else
    echo Running _pre_mig inside vms ${_hName}
    if [ -e "/var/xdrago/runner.sh" ]; then
      mv -f /var/xdrago/runner.sh /var/xdrago/.runner.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/runner\.sh( |$)'
    fi
    if [ -e "/var/xdrago/owl.sh" ]; then
      mv -f /var/xdrago/owl.sh /var/xdrago/.owl.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/owl\.sh( |$)'
    fi
    if [ -e "/var/xdrago/usage.sh" ]; then
      mv -f /var/xdrago/usage.sh /var/xdrago/.usage.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/usage\.sh( |$)'
    fi
    if [ -e "/var/xdrago/graceful.sh" ]; then
      mv -f /var/xdrago/graceful.sh /var/xdrago/.graceful.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/graceful\.sh( |$)'
    fi
    if [ -e "/var/xdrago/manage_ltd_users.sh" ]; then
      mv -f /var/xdrago/manage_ltd_users.sh /var/xdrago/.manage_ltd_users.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/manage_ltd_users\.sh( |$)'
    fi
    if [ "${_hName}" = "${_hst}" ]; then
      echo Preparing source ${_hName} for outgoing migration...
      if [ ! -e "/root/.ssh/id_ed25519.pub" ]; then
        echo "Generating SSH (ed25519) keys for root..."
        ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519
      fi
      if [ -e "/root/.ssh/id_ed25519.pub" ]; then
        mkdir -p /var/www/nginx-default
        cp -af /root/.ssh/id_ed25519.pub /var/www/nginx-default/auth_undefined_keys.txt
      else
        echo Ops.. /root/.ssh/id_ed25519.pub does not exist in ${_hName}
      fi
    else
      echo Preparing target ${_hName} for incoming migration...
      echo Add remote id_ed25519.pub to authorized_keys here...
      mkdir -p /root/.ssh
      chmod 700 /root/.ssh
      rm -f /root/.ssh/auth_undefined_keys.txt*
      rm -f /var/www/nginx-default/auth_undefined_keys.txt*
      curl -s -A iCab "http://undefined.${_hst}/auth_undefined_keys.txt" -o /root/.ssh/auth_undefined_keys.txt
      if [ -e "/root/.ssh/auth_undefined_keys.txt" ]; then
        echo >> /root/.ssh/authorized_keys
        cat /root/.ssh/auth_undefined_keys.txt >> /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys
      else
        echo Ops.. /root/.ssh/auth_undefined_keys.txt does not exist in ${_hName}
      fi
    fi
  fi
  echo All done!
}

_sub_ssl_gen() {
  IFS=$'\12'
  for p in `cat /root/.ssl.proxy.cnf`;do
    _hmFrontExtra=""
    _domain_name=`echo $p | cut -d' ' -f1 | awk '{ print $1}'`
    _target_ip=`echo $p | cut -d' ' -f2 | awk '{ print $1}'`
    _oct_uid=`echo $p | cut -d' ' -f3 | awk '{ print $1}'`
    _oct_mail=`echo $p | cut -d' ' -f4 | awk '{ print $1}'`
    _dedicated_ip=`echo $p | cut -d' ' -f5 | awk '{ print $1}'`
    echo _domain_name.${_domain_name} _target_ip.${_target_ip} _oct_uid.${_oct_uid} _oct_mail.${_oct_mail} _dedicated_ip.${_dedicated_ip}
    if [ ! -z "${_domain_name}" ] \
      && [ ! -z "${_target_ip}" ] \
      && [ ! -z "${_oct_uid}" ] \
      && [ ! -z "${_oct_mail}" ] \
      && [ ! -z "${_dedicated_ip}" ]; then
      _oct_mail=`echo ${_oct_mail} | sed "s/\@/\\\@/g"`;
      if [ "${_target_ip}" = "${_dedicated_ip}" ]; then
        _dedicated_ip="*"
        ### extra_domain.txt holds the control panel's extra names: only the
        ### panel's own record claims them, or nginx keeps whichever proxy
        ### sorts first and a site's proxy answers for the panel. log/ is
        ### oN's: both read inside the real directory, never through a link
        ### or into a FIFO, and only host names reach the server_name line.
        _hmFront=$(_xcopy_read_in "/data/disk/${_oct_uid}/log" domain.txt | tr -d '\n')
        if [ -n "${_hmFront}" ] && [ "${_domain_name}" = "${_hmFront}" ] \
          && [ -e "/data/disk/${_oct_uid}/log/extra_domain.txt" ]; then
          _hmFrontExtra=$(_xcopy_read_in "/data/disk/${_oct_uid}/log" extra_domain.txt \
            | tr -s ' \t\r' '\n' \
            | grep -E '^[a-zA-Z0-9*][a-zA-Z0-9.*-]*$' \
            | awk 'length($0) <= 253' \
            | tr '\n' ' ')
          _hmFrontExtra="${_hmFrontExtra% }"
        fi
        if [ ! -z "${_hmFrontExtra}" ]; then
          _dedicated_sn="${_domain_name} ${_hmFrontExtra} www.${_domain_name}"
        else
          _dedicated_sn="${_domain_name} www.${_domain_name}"
        fi
        _single=YES
      else
        _dedicated_sn="_"
        _single=NO
      fi
      ###
      ### Check the directory actually written into, not an unrelated install
      ### marker. The old guard tested the real write target; the rewrite tests
      ### /var/aegir/.drush/hm.alias.drushrc.php instead and nothing here
      ### creates pre.d -- so on a master where it is missing every cp fails,
      ### each sed then edits a file that does not exist, and the loop still
      ### announces "OK created". The result is a proxy with no proxy config.
      _PreD="/var/aegir/config/server_master/nginx/pre.d"
      if [ ! -d "${_PreD}" ]; then
        mkdir -p "${_PreD}" 2>/dev/null
        [ -d "/var/aegir/config/server_master/nginx" ] \
          && chown --reference=/var/aegir/config/server_master/nginx \
             "${_PreD}" 2>/dev/null
      fi
      if [ ! -d "${_PreD}" ]; then
        echo "ERROR: ${_PreD} is missing and cannot be created"
        echo "ERROR: NO proxy config written for ${_domain_name}"
        continue
      fi
      _Pln="${_PreD}/z_${_domain_name}_pln_proxy.conf"
      _Ssl="${_PreD}/z_${_domain_name}_ssl_proxy.conf"
      ###
      if [ "${_single}" = "YES" ]; then
        rm -f ${_Pln}
      else
        cp -af /var/xdrago/conf/pln_proxy.conf      ${_Pln}
        sed -i "s/_domain_name/${_domain_name}/g"   ${_Pln}
        wait
        sed -i "s/_target_ip/${_target_ip}/g"       ${_Pln}
        wait
        sed -i "s/_oct_uid/${_oct_uid}/g"           ${_Pln}
        wait
        sed -i "s/_oct_mail/${_oct_mail}/g"         ${_Pln}
        wait
        sed -i "s/_dedicated_ip/${_dedicated_ip}/g" ${_Pln}
        wait
        sed -i "s/_dedicated_sn/${_dedicated_sn}/g" ${_Pln}
        wait
        ### Say "created" only when it is there. The unconditional echo was
        ### the reason a failed write read as a success.
        if [ -s "${_Pln}" ]; then
          echo OK created ${_Pln}
        else
          echo "ERROR: failed to write ${_Pln}"
        fi
      fi
      ###
      cp -af /var/xdrago/conf/ssl_proxy.conf        ${_Ssl}
      sed -i "s/_domain_name/${_domain_name}/g"     ${_Ssl}
      wait
      sed -i "s/_target_ip/${_target_ip}/g"         ${_Ssl}
      wait
      sed -i "s/_oct_uid/${_oct_uid}/g"             ${_Ssl}
      wait
      sed -i "s/_oct_mail/${_oct_mail}/g"           ${_Ssl}
      wait
      sed -i "s/_dedicated_ip/${_dedicated_ip}/g"   ${_Ssl}
      wait
      sed -i "s/_dedicated_sn/${_dedicated_sn}/g"   ${_Ssl}
      wait
      [ -e "/etc/nginx/no_ktls.conf" ] \
        && sed -i "/ssl_conf_command Options.*KTLS/d" ${_Ssl}
      wait
      ### The local control panel front does not offer HTTP/3. A reload
      ### hands the shared UDP sockets to the new workers, so a QUIC
      ### transfer in flight is cut within seconds of every reload, while a
      ### TCP one drains on the old worker; with reloads every few minutes
      ### a large backup download never completed. Alt-Svc clear makes a
      ### browser drop the alternative it cached from earlier visits. The
      ### proxy for a moved instance (_single=NO) keeps HTTP/3, and drops the
      ### template's IP list includes: those judge one domain, while this
      ### proxy answers every name on its address and the new host judges them.
      if [ "${_single}" = "YES" ]; then
        sed -i "/^[[:space:]]*listen .*:443 quic;/d; /^[[:space:]]*http3\(_hq\)\?[[:space:]].*on;/d" ${_Ssl}
        wait
        if ! grep -q "Alt-Svc" ${_Ssl}; then
          sed -i "s/^\([[:space:]]*\)proxy_buffering[[:space:]].*off;/&\n\1proxy_hide_header          Alt-Svc;\n\1add_header                 Alt-Svc clear always;/" ${_Ssl}
          wait
        fi
      else
        sed -i "/^[[:space:]]*include \/data\/disk\/.*\/includes\/\(ip_access\|user_admin_access\|user_admin_access_map\)\//d" ${_Ssl}
        wait
      fi
      ### The satellite pass rewrites the template's fastcgi target to the
      ### fpm socket after calling this generator; a standalone run left
      ### 127.0.0.1:9000 behind -- nothing listens there, so /sqladmin
      ### answers 502 until the next satellite pass. Do the same rewrite
      ### here: resolve the master pool from the cnf without sourcing it
      ### and rewrite only when that pool socket really listens (fail-safe:
      ### the satellite pass still converges the vhost otherwise).
      _fpmVer=$(sed -n 's/^_PHP_FPM_VERSION=//p' /root/.barracuda.cnf 2>/dev/null \
        | tail -n 1 | sed 's/[[:space:]]*#.*$//' | tr -d '" ')
      _fpmCn="www${_fpmVer//[^0-9]/}"
      if [ -n "${_fpmVer}" ] && [ -S "/var/run/${_fpmCn}.fpm.socket" ]; then
        sed -i "s/127.0.0.1:9000;/unix:\/var\/run\/${_fpmCn}.fpm.socket;/g" ${_Ssl}
        wait
      fi
      ###
      if [ -e "${_Ssl}" ]; then
        _sslFile="/etc/ssl/private/${_domain_name}.dhp"
        if [ ! -e "${_sslFile}" ]; then
          echo "We will generate .dhp file now, please wait..."
          openssl dhparam -out ${_sslFile} 2048 &> /dev/null
        else
          _PFS_TEST=$(grep "DH PARAMETERS" ${_sslFile} 2>&1)
          if [[ ! "${_PFS_TEST}" =~ "DH PARAMETERS" ]]; then
            echo "We will generate .dhp file now, please wait..."
            openssl dhparam -out ${_sslFile} 2048 &> /dev/null
          fi
        fi
      fi
      ###
      ### Say "created" only when it is there -- the same guard as the plain
      ### half above. The reload stays unconditional: reloading with one
      ### config missing is harmless, and the plain half may have landed.
      if [ -s "${_Ssl}" ]; then
        echo OK created ${_Ssl}
      else
        echo "ERROR: failed to write ${_Ssl}"
      fi
      service nginx reload
    else
      echo some variables missing in the record: $p
    fi
  done
}

_ssl_gen() {
  if [ ! -e "/root/.ssl.proxy.cnf" ]; then
    echo "please create /root/.ssl.proxy.cnf first"
    exit 1
  elif [ ! -e "/var/xdrago/conf/pln_proxy.conf" ]; then
    echo "file /var/xdrago/conf/pln_proxy.conf does not exist"
    exit 1
  elif [ ! -e "/var/xdrago/conf/ssl_proxy.conf" ]; then
    echo "file /var/xdrago/conf/ssl_proxy.conf does not exist"
    exit 1
  elif [ ! -e "/var/aegir/.drush/hm.alias.drushrc.php" ]; then
    echo "vms ${_vms} aegir master not ready"
    exit 1
  else
    [ -e "/root/.ssl.proxy.cnf" ] && _sub_ssl_gen
  fi
}

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    ionice -c2 -n7 -p $$
    chmod a+w /dev/null
    if [ ! -e "/dev/fd" ]; then
      if [ -e "/proc/self/fd" ]; then
        rm -rf /dev/fd
        ln -sfn /proc/self/fd /dev/fd
      fi
    fi
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    _ADM_EMAIL=${_MY_EMAIL//\\\@/\@}
    _BCC_EMAIL=${_MY_EMAIL//\\\@/\@}
    if [ "${_THIS_DB_HOST}" = "localhost" ] \
      || [ "${_THIS_DB_HOST}" = "FQDN" ]; then
      _SQL_CONNECT=localhost
    elif [ "${_THIS_DB_HOST}" = "127.0.0.1" ] \
      || [ "${_THIS_DB_HOST}" = "PROXYSQL" ]; then
      _SQL_CONNECT=127.0.0.1
    else
      _SQL_CONNECT="${_THIS_DB_HOST}"
    fi
    if [ "${_THIS_DB_HOST}" = "${_MY_OWNIP}" ]; then
      _SQL_CONNECT=localhost
    fi
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
}

# The DRY/live gate applies ONLY to the migration transfer commands. Utility commands
# — notably `ssl-gen` (renders proxy SSL vhosts from /root/.ssl.proxy.cnf), plus pre-mig,
# post-mig, export, import, create and proxy — run unaffected (LIVE) and their arguments
# are never touched. For transfer/pretransfer the default is a read-only DRY run and an
# explicit --live is required (accepted only after a CLEAN dry run for the same
# account+target — the autosymlink --batch model). Only --prefixed mode flags are
# recognised (and stripped), so no positional argument is ever mistaken for one.
_MODE=LIVE
_XCOPY_NOT_CLEAN=NO
_XCOPY_FORCE=""
case "$1" in
  transfer|pretransfer)
    _MODE=DRY
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --live)        _MODE=LIVE ;;
        --dry|--test)  _MODE=DRY ;;
        --force)       _XCOPY_FORCE=YES ;;
        --*)
          ### An unknown --flag must never fall through to the positionals:
          ### the next free slot is the target-account RENAME.
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  import)
    ### --force bypasses the export_failed.pid refusal only; every other
    ### import gate (imported.pid and friends) is unaffected.
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --force) _XCOPY_FORCE=YES ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
esac

###-------------SINGLE-FLIGHT LOCK-------###

# A plain owner-PID file: live owner refuses, dead owner is taken over.
#
# This was flock at first, and flock was WRONG here for a reason worth keeping
# written down. The lock lives on an open descriptor, and xcopy restarts MySQL --
# so the new mysqld inherited that descriptor and, running forever, held the
# lock forever. Every later verb was refused by a run that had finished
# minutes earlier. Any long-lived daemon a migration starts would do the same.
#
# A PID file has nothing to inherit. A stale file cannot wedge anything either,
# because liveness is what is checked, not the file's existence -- so a holder
# killed outright costs nothing. The cmdline check matters: PIDs get recycled,
# and without it a recycled number belonging to some daemon would block the
# tool indefinitely, which is the same bug in a different coat.
#
# The refusal is loud and NON-ZERO on purpose: a quiet exit 0 would let a
# harness read "another run holds it" as success.

_XCOPY_LOCK_FILE="/run/xcopy.verb.pid"

# Acquisition is atomic (noclobber): the old check-then-write let two verbs
# started in the same instant both proceed. A dead or foreign owner's file is
# removed and the create retried; the loser of any race re-examines a LIVE
# owner and refuses.
#
# The owner match is anchored to an xcopy INVOCATION ("/xcopy" or a bare "xcopy"
# word followed by arguments), never the bare substring: the old *xcopy* glob
# matched any process whose cmdline merely mentions the name -- an operator's
# tail -F of a migration log was enough -- so a recycled PID could block every
# verb forever, the exact recycled-PID bug the liveness check exists to
# prevent.
#
# The signal traps EXIT: a bash signal trap otherwise returns to the next
# statement, so a TERM would remove the lock and then keep running the
# remaining legs, unlocked.
#
# Kept in step with xmass's _take_verb_lock -- mirror any fix there.
_take_verb_lock() {
  local _owner _cmdline _tries=0
  [ "$(id -u)" = "0" ] || return 0
  while :; do
    if ( set -C; echo "$$" > "${_XCOPY_LOCK_FILE}" ) 2>/dev/null; then
      trap 'rm -f "${_XCOPY_LOCK_FILE}"' EXIT
      trap 'rm -f "${_XCOPY_LOCK_FILE}"; exit 130' INT TERM HUP
      return 0
    fi
    ### Bound the retry loop: a lock file that can be neither created nor
    ### removed (an unwritable /run) must end in the loud refusal this tool
    ### promises, never in a silent spin.
    _tries=$((_tries + 1))
    if [ "${_tries}" -gt 30 ]; then
      echo "ERROR: cannot claim ${_XCOPY_LOCK_FILE} -- refusing to run unlocked"
      exit 1
    fi
    _owner=$(tr -dc '0-9' < "${_XCOPY_LOCK_FILE}" 2>/dev/null | head -c 12)
    if [ -z "${_owner}" ] \
      && [ -n "$(find "${_XCOPY_LOCK_FILE}" -newermt '-5 seconds' 2>/dev/null)" ]; then
      ### A just-created lock can be read in the instant between its O_EXCL
      ### open and the PID write -- never reap a fresh empty file as dead.
      sleep 1
      continue
    fi
    if [ -n "${_owner}" ] && [ -d "/proc/${_owner}" ]; then
      _cmdline=$(tr '\0' ' ' < "/proc/${_owner}/cmdline" 2>/dev/null)
      case "${_cmdline}" in
        */xcopy\ *|*/xcopy|*\ xcopy\ *)
          echo "ERROR: another xcopy run is in flight (pid ${_owner}) -- refusing to start '$1'. Wait for it to finish, or clear ${_XCOPY_LOCK_FILE} if that pid is not an xcopy run."
          exit 1
        ;;
      esac
    fi
    ### Dead or foreign owner: take the file over and retry the atomic create.
    rm -f "${_XCOPY_LOCK_FILE}" 2>/dev/null \
      || { echo "ERROR: cannot remove stale ${_XCOPY_LOCK_FILE} -- refusing to run unlocked"; exit 1; }
  done
}

###-------------SQL WATCHDOG PAUSE-------###

# export dumps and import loads databases: mysqldump/mysql for the panel,
# mydumper/myloader for every site. While /run/boa_sql_maintenance.pid exists
# the mysql.sh watchdog stands down entirely, so it cannot restart MySQL or
# kill mydumper in the middle of a dump or a load.
#
# The marker carries this run's PID, so the launchers read a killed run's
# marker as released. The EXIT trap removes it on every exit the shell can
# trap, and only while it still carries this PID; a kill -9 leaves it to the
# watchdog's 240-minute staleness limit. A marker another operation holds --
# a live PID that is not ours, or a fresh empty one -- is left to its owner.
# Re-asserted before each site, so a marker its owner released mid-run is
# taken over at the next site; a background beat refreshes ours every 20
# minutes, so one dump or load longer than the staleness limit stays paused.
# The traps are armed before the marker is written and the flag is cleared
# after it is removed, so no signal can land between the two.
#
# Kept in step with xoct's _xoct_sql_maint_hold -- mirror any fix there.
_XCOPY_SQL_MAINT=""
_XCOPY_SQL_MAINT_BEAT=""
_xcopy_sql_maint_hold() {
  local _mf=/run/boa_sql_maintenance.pid _mPid _pp=$$ _pst
  # Start time of this run: a recycled PID must not keep a dead run's marker fresh.
  _pst=$(cut -d' ' -f22 /proc/$$/stat 2>/dev/null)
  if [ -e "${_mf}" ] && [ -z "$(find "${_mf}" -mmin +240 2>/dev/null)" ]; then
    _mPid=$(tr -dc '0-9' 2>/dev/null < "${_mf}")
    if [ -z "${_mPid}" ] \
      || { [ "${_mPid}" != "$$" ] && kill -0 "${_mPid}" 2>/dev/null; }; then
      [ "${_XCOPY_SQL_MAINT}" = "OTHER" ] \
        || echo "INFO: ${_mf} is held by another operation (pid ${_mPid:-none}); left to its owner"
      _XCOPY_SQL_MAINT=OTHER
      return 0
    fi
  fi
  if [ "${_XCOPY_SQL_MAINT}" != "YES" ]; then
    _XCOPY_SQL_MAINT=YES
    trap '_xcopy_sql_maint_release; rm -f "${_XCOPY_LOCK_FILE}"' EXIT
    trap 'exit 130' INT TERM HUP
    if [ -z "${_XCOPY_SQL_MAINT_BEAT}" ] || ! kill -0 "${_XCOPY_SQL_MAINT_BEAT}" 2>/dev/null; then
      # Detached, not a child of this shell: the bare `wait` calls in this
      # tool must never wait on it. Ends on its own when this run is gone
      # (kill -9, OOM): an orphaned beat would keep the watchdog paused.
      _XCOPY_SQL_MAINT_BEAT=$(
        (
          # The sleep goes with the beat, so a stopped beat leaves no process;
          # jobs -p also covers a TERM landing before $! is read.
          trap 'kill $(jobs -p) 2>/dev/null; exit 0' TERM
          while :; do
            sleep 1200 & _bs=$!
            wait "${_bs}"
            [ -z "${_pst}" ] || [ "$(cut -d' ' -f22 "/proc/${_pp}/stat" 2>/dev/null)" = "${_pst}" ] || exit 0
            kill -0 "${_pp}" 2>/dev/null || exit 0
            [ "$(tr -dc '0-9' 2>/dev/null < "${_mf}")" = "${_pp}" ] && touch -c "${_mf}"
          done
        ) > /dev/null 2>&1 < /dev/null &
        echo "$!"
      )
    fi
    echo "INFO: SQL watchdog paused for the ${_cmd} database work (${_mf})"
  fi
  echo "$$" > "${_mf}"
}
_xcopy_sql_maint_release() {
  if [ -n "${_XCOPY_SQL_MAINT_BEAT}" ]; then
    kill "${_XCOPY_SQL_MAINT_BEAT}" 2>/dev/null
    _XCOPY_SQL_MAINT_BEAT=""
  fi
  [ "${_XCOPY_SQL_MAINT}" = "YES" ] || return 0
  if [ "$(tr -dc '0-9' 2>/dev/null < /run/boa_sql_maintenance.pid)" = "$$" ]; then
    rm -f /run/boa_sql_maintenance.pid
  fi
  _XCOPY_SQL_MAINT=""
  return 0
}

case "$1" in
  export|create|import|pretransfer|transfer|noproxy|pre-mig|post-mig|ssl-gen)
    _take_verb_lock "$1"
  ;;
esac

case "$1" in
  export)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  create)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  import)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _fix="fix"
            _check_root
            _migrate_init
  ;;
  pretransfer) _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  transfer) _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  noproxy)  _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  pre-mig)  _cmd="$1"
            _hst="$2"
            _check_root
            _pre_mig
  ;;
  post-mig) _cmd="$1"
            _hst="$2"
            _check_root
            _post_mig
  ;;
  ssl-gen)  _cmd="$1"
            _vms="$2"
            _check_root
            _ssl_gen
  ;;
  *)        echo
            echo "Usage: xcopy {pre-mig} {fqdn} (source+target vms)"
            echo "Usage: xcopy {export|create|pretransfer|transfer|noproxy} {o1|shared} {target-ip} {o2}"
            echo "Usage: xcopy {import} {o1} {target-ip} (target vms)"
            echo "Usage: xcopy {post-mig} {fqdn} (source+target vms)"
            echo
            echo "Usage: xcopy {ssl-gen}"
            echo
            exit 1
  ;;
esac

exit 0
