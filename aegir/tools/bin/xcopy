#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

### This box's installed BOA tree. create installs the copy for the
### target's own tree (_mig_target_tree), with this one as the fallback
### when the target cannot say. Derive from the box's own self-report; fall
### back to the newest tools ctrl marker, then to the historical dev default.
### Verbatim in xoct and xmass.
_tRee=$(boa info 2>/dev/null \
  | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
  | tail -1 \
  | grep -oE '(dev|lts|pro)$')
if [ -z "${_tRee}" ]; then
  _tRee=$(ls -t /var/log/boa/*.ctrl.* 2>/dev/null \
    | head -1 \
    | grep -oE '\.(dev|lts|pro)\.' \
    | tr -d '.')
fi
[ -z "${_tRee}" ] && _tRee=dev
export _tRee
_xSrl=$(boa info 2>/dev/null \
  | grep -oE "BOA-[0-9.]+-${_tRee}-[0-9a-zA-Z]+" \
  | tail -1 \
  | awk -F- '{ print $NF }')
[ -z "${_xSrl}" ] && _xSrl="588855${_tRee}T01"
export _xSrl

_WEBG=www-data
_THIS_DB_PORT=3306
_ieni="--ignore-errors"

### A connection sshd drops before login (MaxStartups, or a per-source
### penalty while a scanner holds its slots) ran nothing on the far box, so
### it is opened again: up to 20 more times, 10 s apart at first and 25 s at
### most, about 8 minutes of waits: a chain of drops can then outlast the
### flood, and a stop in the middle of a move costs more than the wait. A try
### that stalls in the banner exchange counts as a drop and takes its own
### ConnectTimeout besides; a port that is silent or refuses is not tried
### again, so a call given up after its ConnectTimeout stays given up. A run
### may open a short window where a stop costs little and a call that fails
### decides it (xmass's cutover under its 503 gate, before the write freeze):
### inside it, once a chain to a host has used the whole budget, later calls
### to that host get 3 tries (45 s) until one gets through. Everywhere else
### every call gets the whole budget. ssh's own log
### (-E) decides, never what the remote command
### printed: a reset or a stall in the banner exchange, or a bare 'Connection
### closed by <host> port <n>', which ssh logs only before login (a close
### after it is 'Connection to <host> closed by remote host.', on stderr).
### rsync and scp are read on their stderr, which can also carry the far
### end's own lines, so only a line that opens with ssh's words counts, and
### an rsync only when it received 0 bytes. A host key scan that learned no
### key is run again the same way when ssh-keyscan's own words name a close
### or a reset before the banner, or it said nothing and port 22 accepts a
### plain connection. Any other failure returns at once with its
### own status and messages. Each retry adds one line to the drop log: time,
### host, try and the client's own words, never the remote command. The
### functions shadow the binaries, so every call in the tool goes through
### them; their text is the same in xmass, xoct and xcopy.
_MIG_DROP_RE='^((kex|ssh)_exchange_identification:|banner exchange:|Connection timed out during banner exchange)|^Connection closed by [^ ]+ port [0-9]+[[:space:]]*$'
_MIG_SCAN_RE='^[^ ]+: Connection closed by remote host[[:space:]]*$|^read \([^)]*\): Connection reset by peer[[:space:]]*$'
_MIG_DROP_LOG="/var/log/boa/xcopy.drop.log"
_MIG_DROP_TRIES=20
_MIG_DROP_TRIES_SPENT=3
### The hosts whose chain used the whole budget inside the short window, a
### file each: a directory, since most calls run in a subshell, named by this
### run's pid (one a dead run of the same pid left is no one's).
_MIG_DROP_SPENT="/run/mig-drop-spent.$$"
rm -rf "${_MIG_DROP_SPENT}" 2> /dev/null
_MIG_DROP_SHORT=NO
### The terminal this run was started on, when its stderr is one: each retry
### is told there whatever the call did with its own stderr, and a caller
### that reads a call's stderr never finds the notice in it.
_MIG_NOTE_TTY=""
[ -t 2 ] && { _MIG_NOTE_TTY="$(tty <&2 2> /dev/null)" || _MIG_NOTE_TTY=""; }
### Run by a migration tool that keeps the run log, stderr is that file: the
### caller hands its own terminal down instead, taken only while it is still
### this run's controlling terminal.
[ -z "${_MIG_NOTE_TTY}" ] && [ -n "${_MIG_RUNLOG:-}" ] && [ "${_MIG_RUNLOG}" != none ] \
  && [ -c "${_MIG_RUNLOG_TTY:-}" ] \
  && [ "/dev/$(ps -o tty= -p "$$" 2> /dev/null | tr -d ' ')" = "${_MIG_RUNLOG_TTY}" ] \
  && _MIG_NOTE_TTY="${_MIG_RUNLOG_TTY}"

### The host of the first root@ argument, and nothing else of the call.
_mig_drop_host() {
  local _a
  for _a in "$@"; do
    case "${_a}" in
      root@?*)
        _a="${_a#root@}"
        printf '%s' "${_a%%:*}" | tr -cd 'A-Za-z0-9._-'
        return 0
        ;;
    esac
  done
  printf '%s' '?'
}

### The wait after drop $1: 10 s, then 5 s longer each time up to 25 s, so the
### tries walk across a flood's gaps instead of meeting its windows in step.
_mig_drop_secs() {
  local _w=$(( 5 + ${1} * 5 ))
  [ "${_w}" -gt 25 ] && _w=25
  echo "${_w}"
}

### $1 open or close: the short window, which starts and ends with no host
### marked.
_mig_drop_window() {
  rm -rf "${_MIG_DROP_SPENT}" 2> /dev/null
  case "${1}" in
    open) _MIG_DROP_SHORT=YES ;;
    *) _MIG_DROP_SHORT=NO ;;
  esac
  return 0
}

### The tries a chain of drops to host $1 gets: the whole budget, or the
### short one inside the short window once a chain to it used the whole one.
_mig_drop_budget() {
  if [ "${_MIG_DROP_SHORT}" = "YES" ] && [ -e "${_MIG_DROP_SPENT}/h-${1}" ]; then
    echo "${_MIG_DROP_TRIES_SPENT}"
  else
    echo "${_MIG_DROP_TRIES}"
  fi
}

### The chain to host $1 used its budget $2 and met one more drop: inside the
### short window a whole budget marks the host, and the marks of runs that
### are gone go.
_mig_drop_spent() {
  local _f
  [ -n "${_MIG_NOTE_TTY}" ] \
    && echo "INFO: ${1}: still dropped after ${2} tries; this call gives up" 2> /dev/null > "${_MIG_NOTE_TTY}"
  [ "${_MIG_DROP_SHORT}" = "YES" ] && [ "${2}" = "${_MIG_DROP_TRIES}" ] || return 0
  for _f in /run/mig-drop-spent.*; do
    [ -e "${_f}" ] || continue
    kill -0 "${_f##*.}" 2> /dev/null || rm -rf "${_f}"
  done
  mkdir -p "${_MIG_DROP_SPENT}" 2> /dev/null && : 2> /dev/null > "${_MIG_DROP_SPENT}/h-${1}"
  return 0
}

### A call to host $1 got through: inside the short window its mark goes.
_mig_drop_through() {
  [ "${_MIG_DROP_SHORT}" = "YES" ] || return 0
  rm -f "${_MIG_DROP_SPENT}/h-${1}" 2> /dev/null
  return 0
}

### One retry noted: $1 the try, $2 the host, $3 the file holding the
### client's own messages, $4 the pattern of the lines kept from it (ssh's
### drop and close lines when not given), $5 the chain's budget.
_mig_drop_note() {
  local _k="${4:-}" _b="${5:-${_MIG_DROP_TRIES}}" _t=""
  [ -n "${_k}" ] || _k="${_MIG_DROP_RE}|^Connection (reset|closed|timed out)"
  if [ -n "${_MIG_NOTE_TTY}" ]; then
    if [ "${1}" = "1" ]; then
      _t=", each try logged in ${_MIG_DROP_LOG}"
      [ "${_b}" = "${_MIG_DROP_TRIES}" ] \
        || _t=" (an earlier chain to it used all ${_MIG_DROP_TRIES})${_t}"
    fi
    echo "INFO: ${2}: connection dropped before login; try ${1} of ${_b} in $(_mig_drop_secs "${1}") s${_t}" 2> /dev/null > "${_MIG_NOTE_TTY}"
  fi
  {
    printf '%s %s try %s: ' "$(date '+%F %T')" "${2}" "${1}"
    grep -E "${_k}" "${3}" 2> /dev/null \
      | tr -d '\r' | head -n 3 | tr '\n' ' '
    echo
  } 2> /dev/null >> "${_MIG_DROP_LOG}"
  return 0
}

ssh() {
  local _l _rc _n=0 _b="" _h
  while :; do
    _l="$(mktemp /tmp/mig-ssh.XXXXXX 2> /dev/null)" || { command ssh "$@"; return $?; }
    command ssh -E "${_l}" "$@"
    _rc=$?
    if [ "${_rc}" = "255" ] && grep -qE "${_MIG_DROP_RE}" "${_l}" 2> /dev/null; then
      _h="$(_mig_drop_host "$@")"
      [ -n "${_b}" ] || _b="$(_mig_drop_budget "${_h}")"
      if [ "${_n}" -lt "${_b}" ]; then
        _n=$(( _n + 1 ))
        _mig_drop_note "${_n}" "${_h}" "${_l}" "" "${_b}"
        rm -f "${_l}"
        sleep "$(_mig_drop_secs "${_n}")"
        continue
      fi
      _mig_drop_spent "${_h}" "${_b}"
    elif [ "${_rc}" != "255" ]; then
      _mig_drop_through "$(_mig_drop_host "$@")"
    fi
    [ -s "${_l}" ] && cat "${_l}" >&2
    rm -f "${_l}"
    return "${_rc}"
  done
}

### $1 rsync or scp, then its arguments: run with its stderr held, which is
### replayed once the call is not retried.
_mig_rsh_again() {
  local _e _rc _n=0 _b="" _h
  while :; do
    _e="$(mktemp /tmp/mig-rsh.XXXXXX 2> /dev/null)" || { command "$@"; return $?; }
    command "$@" 2> "${_e}"
    _rc=$?
    if [ "${_rc}" != "0" ] \
      && grep -qE "${_MIG_DROP_RE}" "${_e}" 2> /dev/null \
      && { [ "${1}" != "rsync" ] || grep -qF '(0 bytes received so far)' "${_e}"; }; then
      _h="$(_mig_drop_host "$@")"
      [ -n "${_b}" ] || _b="$(_mig_drop_budget "${_h}")"
      if [ "${_n}" -lt "${_b}" ]; then
        _n=$(( _n + 1 ))
        _mig_drop_note "${_n}" "${_h}" "${_e}" "" "${_b}"
        rm -f "${_e}"
        sleep "$(_mig_drop_secs "${_n}")"
        continue
      fi
      _mig_drop_spent "${_h}" "${_b}"
    elif [ "${_rc}" = "0" ]; then
      _mig_drop_through "$(_mig_drop_host "$@")"
    fi
    [ -s "${_e}" ] && cat "${_e}" >&2
    rm -f "${_e}"
    return "${_rc}"
  done
}

### A local copy (no root@host: argument) runs as it is.
rsync() {
  local _a
  for _a in "$@"; do
    case "${_a}" in
      root@?*:*) _mig_rsh_again rsync "$@"; return $? ;;
    esac
  done
  command rsync "$@"
}

scp() {
  _mig_rsh_again scp "$@"
}

### 0 when something accepts a connection on the host's ssh port.
_mig_port_answers() {
  timeout 5 bash -c 'exec 3<> "/dev/tcp/${1}/22"' _ "${1}" 2> /dev/null
}

### $1 the host, its keys appended to root's known_hosts. A scan whose
### connections sshd closed or reset before the banner learned nothing and
### runs again, whether ssh-keyscan named the close or, as it often does, said
### nothing: a port that accepts a plain connection tells that from a refused
### one, which says nothing too. A refused or silent port gets the one scan.
### The keys go to a file first, so a known_hosts that cannot be written is
### one failure, never a scan that seemed to say nothing.
### Returns 0 once a key for the host is known. With a file as $2 the keys
### go there in place of known_hosts, for a caller that checks a key before
### it trusts one, and 0 means the file holds what the host served.
_mig_keyscan() {
  local _e _o _h _k _n=0 _b="" _f="${2:-/root/.ssh/known_hosts}"
  _h="$(printf '%s' "${1}" | tr -cd 'A-Za-z0-9._:-')"
  while :; do
    _e="$(mktemp /tmp/mig-scan.XXXXXX 2> /dev/null)" \
      && _o="$(mktemp /tmp/mig-keys.XXXXXX 2> /dev/null)" || {
      rm -f "${_e}"
      ssh-keyscan -H -T 10 "${1}" >> "${_f}" 2> /dev/null
      if [ -n "${2:-}" ]; then [ -s "${2}" ]; else ssh-keygen -F "${1}" > /dev/null 2>&1; fi
      return $?
    }
    ssh-keyscan -H -T 10 "${1}" > "${_o}" 2> "${_e}"
    if [ -s "${_o}" ] && ! cat "${_o}" 2> /dev/null >> "${_f}"; then
      echo "${_h}: cannot write ${_f}" >&2
      rm -f "${_e}" "${_o}"
      return 1
    fi
    rm -f "${_o}"
    if { [ -n "${2:-}" ] && [ -s "${2}" ]; } \
      || { [ -z "${2:-}" ] && ssh-keygen -F "${1}" > /dev/null 2>&1; }; then
      _mig_drop_through "${_h}"
      rm -f "${_e}"
      return 0
    fi
    if grep -qE "${_MIG_SCAN_RE}" "${_e}" 2> /dev/null \
      || { [ ! -s "${_e}" ] && _mig_port_answers "${1}"; }; then
      [ -n "${_b}" ] || _b="$(_mig_drop_budget "${_h}")"
      if [ "${_n}" -lt "${_b}" ]; then
        _n=$(( _n + 1 ))
        _k="${_MIG_SCAN_RE}"
        if [ ! -s "${_e}" ]; then
          echo "${_h}: the scan said nothing, port 22 answers" > "${_e}"
          _k='.'
        fi
        _mig_drop_note "${_n}" "${_h}" "${_e}" "${_k}" "${_b}"
        rm -f "${_e}"
        sleep "$(_mig_drop_secs "${_n}")"
        continue
      fi
      _mig_drop_spent "${_h}" "${_b}"
    fi
    rm -f "${_e}"
    return 1
  done
}

### $1 the host, $2 the client's own words from a call to it that failed,
### $3 "inuse" when this box reached the host with the held key before.
### When the client says the key the host serves is not the one this box
### holds for it, prints the key served, the entries held in the file the
### client names, the check to make and the command that forgets them, puts
### both fingerprints in _MIG_HOSTKEY_SAYS for the caller's own refusal and
### returns 0. Any other failure returns 1 with nothing printed.
### The words count only when they are the client's changed-key warning and
### nothing else, from its first line to its last, and every value is read
### from its own line of that warning. The other end can put text of its
### choosing into the client's output before any key is checked (a disconnect
### message, the algorithm list of a failed negotiation, each printed with its
### line breaks), but only inside a line the client starts itself, so such
### output never begins with the warning. A build that words the warning
### another way is not understood, and the caller's own refusal stands.
### Nothing is forgotten here: an address handed on to a new server reads the
### same as another server answering in its place, and only the operator can
### tell which it is.
_MIG_HOSTKEY_SAYS=""
_mig_hostkey_changed() {
  local _h _w _t _fp _f _l _n="" _x _ht _hfp _same="" _first="" _pub _skip=NO
  _MIG_HOSTKEY_SAYS=""
  case "${2}" in
    *"REMOTE HOST IDENTIFICATION HAS CHANGED"*) : ;;
    *) return 1 ;;
  esac
  _w="$(printf '%s\n' "${2}" | tr -d '\r' | grep -v '^[[:space:]]*$')"
  printf '%s\n' "${_w}" | awk '
    function no() { ok = 0; exit }
    BEGIN { ok = 1; n = 0; end = 0 }
    { n++ }
    n == 1 || n == 3 { if ($0 !~ /^@+$/) no(); next }
    n == 2 { if ($0 !~ /^@ +WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED! +@$/) no(); next }
    n == 4 { if ($0 != "IT IS POSSIBLE THAT SOMEONE IS DOING SOMETHING NASTY!") no(); next }
    n == 5 { if ($0 != "Someone could be eavesdropping on you right now (man-in-the-middle attack)!") no(); next }
    n == 6 { if ($0 != "It is also possible that a host key has just been changed.") no(); next }
    n == 7 { if ($0 !~ /^The fingerprint for the [A-Za-z0-9-]+ key sent by the remote host is$/) no(); next }
    n == 8 { if ($0 !~ /^SHA256:[A-Za-z0-9+\/]+\.$/ || length($0) != 51) no(); next }
    n == 9 { if ($0 != "Please contact your system administrator.") no(); next }
    n == 10 { if ($0 !~ /^Add correct host key in \/.+ to get rid of this message\.$/) no(); next }
    n == 11 { if ($0 !~ /^Offending [A-Za-z0-9-]+ key in \/.+:[0-9]+$/) no(); next }
    end == 0 && /^  / { next }
    end == 0 { if ($0 !~ /^Host key for .+ has changed and you have requested strict checking\.$/) no(); end = 1; next }
    end == 1 { if ($0 != "Host key verification failed.") no(); end = 2; next }
    { no() }
    END { exit (ok == 1 && end == 2) ? 0 : 1 }' || return 1
  _h="$(printf '%s' "${1}" | tr -cd 'A-Za-z0-9._:-' | tr '[:upper:]' '[:lower:]')"
  _t="$(printf '%s\n' "${_w}" \
    | sed -n '7s/^The fingerprint for the \([A-Za-z0-9-]*\) key sent by the remote host is$/\1/p')"
  _fp="$(printf '%s\n' "${_w}" | sed -n '8s/\.$//p')"
  _f="$(printf '%s\n' "${_w}" | sed -n '11s/^Offending [^ ]* key in \(\/.*\):[0-9][0-9]*$/\1/p')"
  [ -f "${_f}" ] || _f=/root/.ssh/known_hosts
  echo "ALRT: ${_h} serves an SSH host key that is not the one this box holds for it:"
  echo "ALRT:   served now: ${_t} ${_fp}"
  while IFS= read -r _l; do
    case "${_l}" in
      "# Host "*" found: line "*)
        _n="${_l##*found: line }"
        # a certificate authority or a revoked key is no held host key, and
        # the command below leaves both in place
        case "${_n}" in
          *CA*|*REVOKED*) _skip=YES ;;
          *) _skip=NO ;;
        esac
        _n="${_n%%[!0-9]*}"
        ;;
      *)
        [ "${_skip}" = "NO" ] || continue
        read -r _x _ht _hfp _x <<< "${_l}"
        [ -n "${_hfp}" ] || continue
        echo "ALRT:   held here:  ${_ht} ${_hfp} (${_f} line ${_n:-?})"
        [ -n "${_first}" ] || _first="${_ht} ${_hfp}"
        [ -n "${_same}" ] || [ "${_ht}" != "${_t}" ] || _same="${_ht} ${_hfp}"
        _n=""
        ;;
    esac
  done < <(ssh-keygen -l -E sha256 -F "${_h}" -f "${_f}" 2> /dev/null)
  # the file of that key type, as the server names its key files: lower
  # case, a dash written as an underscore
  _pub="$(printf '%s' "${_t}" | tr '[:upper:]-' '[:lower:]_' | tr -cd 'a-z0-9_')"
  [ -n "${_pub}" ] || _pub="ed25519"
  if [ "${3:-}" = "inuse" ]; then
    echo "ALRT: This box reached ${_h} with the key it holds before. Host keys made anew there read like this, and so does another server answering in its place: find out which before anything is removed."
  else
    echo "ALRT: An address handed on to a new server reads like this, and so does another server answering in its place."
  fi
  echo "ALRT: Check on ${_h} itself, reached some other way than from this box (its console, its host):"
  echo "ALRT:   ssh-keygen -l -f /etc/ssh/ssh_host_${_pub}_key.pub"
  echo "ALRT: Only when that prints the fingerprint served now, forget the old entries here and run this command again:"
  printf 'ALRT:   ssh-keygen -R %s -f %q\n' "${_h}" "${_f}"
  _MIG_HOSTKEY_SAYS="served ${_t} ${_fp}, held ${_same:-${_first:-none listed}}"
  return 0
}


### This box's SSH host key fingerprints, from the files its SSH server is
### set to serve (the default names when its settings cannot be read), for a
### source that is served a key it does not hold for this address. The first
### of ED25519, ECDSA and RSA among them goes to _MIG_HOSTKEY_MAIN.
_MIG_HOSTKEY_MAIN=""
_mig_tell_host_keys() {
  local _k _l _t _all=""
  _MIG_HOSTKEY_MAIN=""
  echo "INFO: This box's SSH host key fingerprints, to compare when a source is served a key it does not hold for this address:"
  while IFS= read -r _k; do
    [ -f "${_k}.pub" ] || continue
    _l="$(ssh-keygen -l -E sha256 -f "${_k}.pub" 2> /dev/null \
      | awk '{ t = $NF; gsub(/[()]/, "", t); print t, $2; exit }')"
    [ -n "${_l}" ] || continue
    echo "INFO:   ${_l}"
    _all="${_all}${_l}"$'\n'
  done < <(
    sshd -T 2> /dev/null | awk 'tolower($1) == "hostkey" { print $2 }' | grep . \
      || ls /etc/ssh/ssh_host_*_key 2> /dev/null
  )
  if [ -z "${_all}" ]; then
    echo "ALRT: could not read this box's SSH host key files; 'ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub' prints the main one"
    return 0
  fi
  for _t in ED25519 ECDSA RSA; do
    _MIG_HOSTKEY_MAIN="$(printf '%s' "${_all}" | grep -m 1 "^${_t} SHA256:")"
    [ -z "${_MIG_HOSTKEY_MAIN}" ] || break
  done
  return 0
}

###
### Avoid too many questions
###
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
if [ -z "${TERM+x}" ]; then
  export TERM=vt100
fi

###-------------SYSTEM-----------------###

_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

_web_group_state() {
  # The account's own web group, wg-<account>, derived on the box and never
  # taken from argv or a cnf: the group its pools, backend user and shell
  # users share for its web paths once the account is converted to it.
  # Prints "<state> <gid> <group>", "none - -" when there is no such group
  # (the record is root's: run as another user, converted reads as held):
  #   none       no group of that name
  #   foreign    the group exists, but an identity outside the account holds
  #              it too: never joined nor written to unless root's record
  #              names its gid at phase A or B (_web_group, _web_group_conv);
  #              claim passes still leave its paths alone (taking them would
  #              cut the pools off)
  #   held       the group exists and only this account's identities hold it:
  #              claim passes leave its paths alone, new identities join it
  #   converted  and root's record names that gid: writers use the group
  #   phaseb     and the record says the identities have left www-data
  # The record is /root/.<account>.web-group.txt, "wg-<account> gid=<n>
  # phase=<A|B> ...", root's own file outside the account tree, so neither
  # the account nor a copy or restore of its tree can make or move it.
  # $1 = account name, one of its identities (oN.ftp, oN.<sub>, oN.web,
  # oN.NN.web), or a path under /data/disk/<oN>, /home/<oN>.*, the account's
  # gems or npm tree, or its store on attached storage
  # (/mnt/<m>/files/<oN>/static/files).
  local _a="${1}" _e _gid _u _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  # a path is read as written (an alias the account wrote can carry "..",
  # "." or "//"): normalised by text alone, never through a link, first
  case "${_a}" in
    */*) _a=$(realpath -m -s -- "${_a}" 2> /dev/null) || { echo "none - -"; return 0; } ;;
  esac
  case "${_a}" in
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    /home/*) _a="${_a#/home/}"; _a="${_a%%/*}" ;;
    /opt/user/gems/*|/opt/user/npm/*) _a="${_a#/opt/user/*/}"; _a="${_a%%/*}" ;;
    /mnt/*/files/*/static/files|/mnt/*/files/*/static/files/*)
      _a="${_a#/mnt/}"; _a="${_a#*/files/}"; _a="${_a%%/*}" ;;
    */*) echo "none - -"; return 0 ;;
  esac
  _a="${_a%%.*}"
  case "${_a}" in
    ""|all|aegir|root|www-data|wg-*|*[!a-z0-9-]*) echo "none - -"; return 0 ;;
  esac
  _e=$(getent group "wg-${_a}" 2> /dev/null) || { echo "none - -"; return 0; }
  _gid=$(printf '%s' "${_e}" | cut -d: -f3)
  case "${_gid}" in
    ""|*[!0-9]*) echo "none - -"; return 0 ;;
  esac
  # every holder of the gid: members of each group entry carrying it (a
  # second entry can share the number) and every user with it as primary
  for _u in $(getent group | awk -F: -v g="${_gid}" '$3 == g { print $4 }' | tr ',' ' ') \
    $(getent passwd | awk -F: -v g="${_gid}" '$4 == g { print $1 }'); do
    [[ "${_u}" =~ ^${_a}(\.[a-z0-9]+(-dev)?|\.[0-9]+\.web)?$ ]] \
      || { echo "foreign ${_gid} wg-${_a}"; return 0; }
  done
  _r="/root/.${_a}.web-group.txt"
  if [ -f "${_r}" ] && [ ! -L "${_r}" ] \
    && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
    read -r _rg _rgid _rph _ < "${_r}" || :
  fi
  if [ "${_rg}" != "wg-${_a}" ] || [ "${_rgid}" != "gid=${_gid}" ]; then
    echo "held ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=B" ]; then
    echo "phaseb ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=A" ]; then
    echo "converted ${_gid} wg-${_a}"
  else
    echo "held ${_gid} wg-${_a}"
  fi
}

_web_group() {
  # The group a root writer gives an account's web paths (files/, private/,
  # settings.php and the like): wg-<account> once the account is converted,
  # www-data otherwise, as always. Until the record says converted every
  # identity of the account still holds www-data (a conversion grants the web
  # group first and a revert gives www-data back before it moves any path),
  # so www-data is the old state, never an outage. Callers write
  # "${_owner}${_wg:+:${_wg}}": a missing helper, an empty answer, changes no
  # group and never hands a path to a login group. Run as any user but root,
  # which cannot read root's record, a held group answers empty: the group
  # each path has is kept. A converted account's group that an identity
  # outside the account has come to hold too (foreign) still answers
  # wg-<account> to root while root's record names that gid at phase A or
  # B: the account's pools read its paths through that group, at phase B
  # through it alone, so www-data there would take them away. $1 as
  # _web_group_state.
  local _s _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  _s=$(_web_group_state "${1}")
  case "${_s%% *}" in
    converted|phaseb) echo "${_s##* }" ;;
    held) [ "$(id -u)" = "0" ] && echo "www-data" || echo "" ;;
    foreign)
      _r="/root/.${_s##* wg-}.web-group.txt"
      if [ "$(id -u)" = "0" ] && [ -f "${_r}" ] && [ ! -L "${_r}" ] \
        && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
        read -r _rg _rgid _rph _ < "${_r}" || :
      fi
      if [ "${_rg}" = "${_s##* }" ] && [ "${_rgid}" = "gid=$(printf '%s' "${_s}" | cut -d' ' -f2)" ] \
        && { [ "${_rph}" = "phase=A" ] || [ "${_rph}" = "phase=B" ]; }; then
        echo "${_rg}"
      else
        echo "www-data"
      fi
      ;;
    *) echo "www-data" ;;
  esac
}

_web_group_conv() {
  # The account's web group and its phase, "wg-<account> A" or "wg-<account>
  # B", once the account is converted onto that group; nothing otherwise:
  # converted and phaseb as _web_group_state reads them, and a group an
  # identity outside the account has come to hold too (foreign) while
  # root's record names its current gid at phase A or B, read as root (the
  # rule _web_group follows). The listings in the group and the pool line
  # follow it, so an identity made while the name is held joins the group
  # its paths are in. $1 as _web_group_state; $2, when given, the line that
  # read printed for $1 (no second read).
  local _s="${2:-}" _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  [ -n "${_s}" ] || _s=$(_web_group_state "${1}")
  case "${_s%% *}" in
    converted) echo "${_s##* } A" ;;
    phaseb) echo "${_s##* } B" ;;
    foreign)
      _r="/root/.${_s##* wg-}.web-group.txt"
      if [ "$(id -u)" = "0" ] && [ -f "${_r}" ] && [ ! -L "${_r}" ] \
        && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
        read -r _rg _rgid _rph _ < "${_r}" || :
      fi
      if [ "${_rg}" = "${_s##* }" ] && [ "${_rgid}" = "gid=$(printf '%s' "${_s}" | cut -d' ' -f2)" ]; then
        case "${_rph}" in
          phase=A) echo "${_rg} A" ;;
          phase=B) echo "${_rg} B" ;;
        esac
      fi
      ;;
  esac
  return 0
}

# The group the target's own writers give an account's web paths there:
# wg-<account> once the account is converted there, www-data otherwise,
# derived on the target by the helper above, sent along with the question.
# Prints nothing and returns 1 when the target cannot be asked. Verbatim in
# xoct, xcopy and xmass.
# $1 = account on the target, $2 = target host.
_web_group_on_target() {
  local _a="${1}" _h="${2}" _o
  case "${_a}" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ -n "${_h}" ] || return 1
  _o=$( { declare -f _web_group_state _web_group
    printf '%s\n' "echo \"XMWG:\$(_web_group '${_a}')\""; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_h}" "bash -s" 2> /dev/null \
    | grep -m1 -x -E 'XMWG:[a-z0-9-]+')
  _o="${_o#XMWG:}"
  case "${_o}" in
    www-data|"wg-${_a}") echo "${_o}" ;;
    *) return 1 ;;
  esac
}

_web_group_policy() {
  # The account's web-group policy as bash reads its cnf, the file $1
  # (/root/.<account>.octopus.cnf): the last _WEB_GROUP assignment, with
  # export, quotes or a trailing comment. NO (opted out of the conversion)
  # or A (pinned at phase A) is printed; any other value, or none, prints
  # nothing. Verbatim in instgrp, xoct, xcopy and xmass: the gates, the
  # notes and the carry read the line the same way. The cnf is read as text:
  # a NUL byte (a crash can zero-fill its tail) hides none of its lines.
  local _l
  _l=$(grep -aE "^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=" "${1}" 2> /dev/null | tail -n 1 \
    | sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=(NO|\"NO\"|'NO'|A|\"A\"|'A')([[:space:]]+#.*)?[[:space:]]*\$/\\2/p" \
    | tr -d "\"'")
  case "${_l}" in
    NO|A) printf '%s\n' "${_l}" ;;
  esac
  return 0
}

_web_group_phase_b() {
  # YES when /root/.barracuda.cnf turns phase B on as bash reads it: the last
  # _WEB_GROUP_PHASE_B assignment, with export, quotes or a trailing comment,
  # is YES. Prints nothing otherwise. Verbatim in instgrp, xoct, xcopy and
  # xmass: the arm, the notes and the pair comparison read the line the same
  # way.
  local _l
  _l=$(grep -E "^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP_PHASE_B=" /root/.barracuda.cnf 2> /dev/null | tail -n 1 \
    | sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP_PHASE_B=(YES|\"YES\"|'YES')([[:space:]]+#.*)?[[:space:]]*\$/\\2/p" \
    | tr -d "\"'")
  [ "${_l}" = "YES" ] && printf '%s\n' YES
  return 0
}

# The web-group facts of the account $1 on this box, one line for the
# helper below: "XMWF:<state>:<phase B>:<policy>:<armed>:<standby>", the
# state as _web_group_state prints it; YES when /root/.barracuda.cnf sets
# _WEB_GROUP_PHASE_B=YES (NO otherwise); the account's _WEB_GROUP policy
# (NO, A, or - for none); YES when the box carries the arm stamp a
# barracuda pass writes while _WEB_GROUP_ARM=YES (NO otherwise: nothing
# ever converts there); YES on a standby or a box being prepared as one
# (nothing converts there until its promotion). Sent to the target, never
# run here.
# shellcheck disable=SC2329
_web_group_facts_here() {
  local _s _b=NO _p _r=NO _sb=NO
  _s=$(_web_group_state "${1}")
  [ "$(_web_group_phase_b)" = "YES" ] && _b=YES
  _p=$(_web_group_policy "/root/.${1}.octopus.cnf")
  [ -s /etc/boa/control/instgrp-web-arm.ready.txt ] && _r=YES
  { [ -e /root/.standby.cnf ] || [ -e /root/.standby.prep.cnf ]; } && _sb=YES
  echo "XMWF:${_s%% *}:${_b}:${_p:--}:${_r}:${_sb}"
}

# The facts above for the account $1 on the target $2, asked of the target
# itself: "<state>:<phase B>:<policy>:<armed>:<standby>". Prints nothing and
# returns 1 when the target cannot be asked. Verbatim in xoct, xcopy and
# xmass.
_web_group_facts_on_target() {
  local _a="${1}" _h="${2}" _o
  case "${_a}" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ -n "${_h}" ] || return 1
  _o=$( { declare -f _web_group_state _web_group_policy _web_group_phase_b _web_group_facts_here
    printf '%s\n' "_web_group_facts_here '${_a}'"; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_h}" "bash -s" 2> /dev/null \
    | grep -m1 -x -E 'XMWF:(none|foreign|held|converted|phaseb):(YES|NO):(NO|A|-):(YES|NO):(YES|NO)')
  [ -n "${_o}" ] || return 1
  echo "${_o#XMWF:}"
}

# What a migration does not carry of the account's web-group state, told
# when the move takes effect: a NOTE each, never a refusal. $1 the account
# here, $2 the account on the target $3; $4 "cnf" for a tool with no cnf
# merge (xcopy), whose policy (_WEB_GROUP=NO or A) is named whenever the
# target's cnf lacks it; xoct's and xmass's merges carry it. Read here: the
# account's web-group state, its intent (a --phase-a pin, a revert in
# progress) and its policy; asked of the target: the facts above. A target
# that is not armed never converts; a standby converts only after its
# promotion. Verbatim in xoct, xcopy and xmass.
_wg_migration_notes() {
  local _a="${1}" _d="${2}" _h="${3}" _how="${4:-state}" _s _i="" _p _f _t _ts _tb _tp _ta _tsb
  local _when="" _ipin=NO
  _s=$(_web_group_state "${_a}" | cut -d' ' -f1)
  _f="/var/log/boa/instgrp-web.${_a}.txt"
  if [ -f "${_f}" ] && [ ! -L "${_f}" ] && [ "$(stat -c %u -- "${_f}" 2> /dev/null)" = "0" ]; then
    _i=$(timeout 10 dd if="${_f}" iflag=nofollow,nonblock bs=4096 count=1 status=none 2> /dev/null | head -n 1)
  fi
  case "${_i}" in
    target=*) ;;
    *) _i="" ;;
  esac
  _p=$(_web_group_policy "/root/.${_a}.octopus.cnf")
  [ "${_s}" = "none" ] && [ -z "${_i}" ] && [ -z "${_p}" ] && return 0
  if ! _t=$(_web_group_facts_on_target "${_d}" "${_h}"); then
    echo "NOTE: the web-group state of ${_d} on ${_h} could not be read; run 'instgrp webstatus ${_d}' there"
    return 0
  fi
  IFS=: read -r _ts _tb _tp _ta _tsb <<< "${_t}"
  [ "${_tsb}" = "YES" ] && _when=" after its promotion"
  case "${_s}:${_ts}" in
    converted:none|converted:held|converted:foreign|phaseb:none|phaseb:held|phaseb:foreign)
      if [ "${_ta}" != "YES" ]; then
        echo "NOTE: ${_a} uses its own web group here and ${_d} on ${_h} does not, and ${_h} is not armed for the web group (no _WEB_GROUP_ARM=YES stamp): it never converts there, its web paths stay in www-data until that box is armed"
      else
        echo "NOTE: ${_a} uses its own web group here and ${_d} on ${_h} does not: its web paths are in www-data there until that box converts it${_when}, by its own policy"
      fi
      ;;
  esac
  case " ${_i} " in
    *" pin=phase-a "*) _ipin=YES ;;
  esac
  if [ "${_ipin}" = "YES" ] && [ "${_p}" != "A" ]; then
    echo "NOTE: ${_a} is pinned at phase A here without _WEB_GROUP=A in /root/.${_a}.octopus.cnf, so the pin does not travel: run 'instgrp webconvert ${_a} --phase-a' here, which writes it"
  elif [ "${_p}" = "A" ] && [ "${_how}" = "cnf" ] && [ "${_tp}" != "A" ]; then
    echo "NOTE: ${_a} is pinned at phase A here (_WEB_GROUP=A) and /root/.${_d}.octopus.cnf on ${_h} does not say so: run 'instgrp webconvert ${_d} --phase-a' on ${_h}${_when}"
  fi
  if [ "${_p}" = "A" ] && [ "${_ts}" = "phaseb" ]; then
    echo "NOTE: ${_a} is pinned at phase A here and ${_d} on ${_h} is at phase B: run 'instgrp webconvert ${_d} --phase-a' on ${_h}${_when}"
  fi
  case "${_i}" in
    "target=none "*)
      echo "NOTE: a web-group revert of ${_a} is in progress here and does not travel: ${_d} converts on ${_h}${_when} by that box's policy unless its opt-out went with it; run 'instgrp webrevert ${_d}' on ${_h}${_when} to revert it there"
      ;;
  esac
  if [ "${_s}" = "phaseb" ] && [ "${_ta}" = "YES" ] && [ "${_tb}" != "YES" ] && [ "${_ts}" != "phaseb" ] \
    && [ "${_p}" != "A" ]; then
    echo "NOTE: ${_a} is at phase B here and ${_h} has _WEB_GROUP_PHASE_B off: ${_d} converts there to phase A only; run 'instgrp webconvert ${_d} --phase-b' on ${_h}${_when}"
  fi
  if [ "${_p}" = "NO" ]; then
    if [ "${_how}" = "cnf" ]; then
      [ "${_tp}" = "NO" ] \
        || echo "NOTE: ${_a} is opted out here (_WEB_GROUP=NO) and /root/.${_d}.octopus.cnf on ${_h} does not say so: run 'instgrp webrevert ${_d}' on ${_h}, which writes the opt-out there"
    elif [ "${_ts}" != "none" ]; then
      echo "NOTE: ${_a} is opted out here (_WEB_GROUP=NO), and ${_d} on ${_h} took its web group before the opt-out reached it: run 'instgrp webrevert ${_d}' on ${_h}"
    fi
  fi
  return 0
}

# A free of account $1's web group name that a kill cut short (instgrp's
# E1 route) is unfinished: its journal,
# /etc/boa/control/instgrp-web.<account>.free.txt, is there and does not
# read done (an empty or unreadable one included: never read as no free).
# Until the account's next web verb finishes it, or drops a journal it
# cannot finish from, paths of the account may still sit in the old
# number, which every leg would carry by that number alone, so no
# migration of the account starts meanwhile. Verbatim in xoct, xcopy and
# xmass.
_wg_free_unfinished() {
  local _j="/etc/boa/control/instgrp-web.${1}.free.txt" _s=""
  [ -f "${_j}" ] && [ ! -L "${_j}" ] || return 1
  { read -r _s _ < "${_j}"; } 2> /dev/null || :
  [ "${_s}" != "step=done" ]
}

# The held gid of a done free of account $1's web group name while the
# group it renamed still has that gid here, under its name or an earlier
# version's (<gid>-wgheld): the paths its walk left in that number (an
# immutable file, a hard link) are mapped by it onto the account's web
# group there, as wg-<account> carried them before the free. The number is
# the map's key: rsync reads a name that starts with a digit as a number
# and stops. Nothing otherwise. Verbatim in xoct, xcopy and xmass.
_wg_free_left() {
  local _j="/etc/boa/control/instgrp-web.${1}.free.txt" _s="" _h="" _n
  [ -f "${_j}" ] && [ ! -L "${_j}" ] || return 0
  { read -r _s _h _ < "${_j}"; } 2> /dev/null || :
  _h="${_h#held=}"
  [ "${_s}" = "step=done" ] && [[ "${_h}" =~ ^[0-9]+$ ]] || return 0
  for _n in "${_h}-wgheld-${1}" "${_h}-wgheld"; do
    [ "$(getent group "${_n:0:32}" 2> /dev/null | cut -d: -f3)" = "${_h}" ] || continue
    printf '%s\n' "${_h}"
    return 0
  done
  return 0
}

#
# Re-group an account's tree ON A REMOTE BOX after a copy landed there
# (transfer, sync, cutover): the copy carries this box's numeric gids, and
# on the destination those are no group at all or -- every box allocates
# account gids from the same system range -- ANOTHER account's group, whose
# identities could then read the copied credential files. instgrp reclaim
# does the whole pass where it is installed (every root incl. the sub-user
# homes and a relocated store, the marker rule, the DRIFT verdict); a
# destination without the tool gets the inline form over the same roots.
# The destination is converted when its account group exists and the
# backend or the shell identity carries it as primary (one identity that
# fell back to 'users' must not turn this into a flatten). Returns the
# pass's rc (0 clean, 2 drift left, 3 identities disagree, 4 deferred: a
# BOA run stayed live there for the whole bounded wait, so the inline form
# ran instead of the tool). Verbatim in xoct, xcopy and xmass.
# $1 = account on the destination, $2 = destination host.
_acct_regroup_remote() {
  local _X_A="$1" _X_H="$2" _X_RC
  [ -n "${_X_A}" ] && [ -n "${_X_H}" ] || return 0
  ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_X_H}" "bash -s" <<REMOTE
_A='${_X_A}'
_DEFERRED=0
if [ -x /opt/local/bin/instgrp ]; then
  # A live run on the destination (its own octopus finisher, a tool
  # refresh) makes reclaim defer with rc 4 for a short window; wait it out,
  # bounded. When it never clears, the inline form below runs instead: a
  # destination carrying log/proxied.pid is never visited by the nightly
  # (owl.sh skips it), so the pass must complete here or not at all.
  _T=0
  while :; do
    # --force: the destination's own log/proxied.pid is its demotion artefact
    # from an earlier cutover (a failback), not "served from elsewhere"; the
    # tree this run just wrote is exactly what needs the file half, and the
    # tool's freeze gate would otherwise refuse it for good
    bash /opt/local/bin/instgrp reclaim "\${_A}" --force
    _R=\$?
    [ "\${_R}" = "4" ] || exit "\${_R}"
    [ "\${_T}" -lt 12 ] || { _DEFERRED=1; break; }
    _T=\$((_T + 1))
    sleep 15
  done
fi
_G=users
if getent group "\${_A}" > /dev/null 2>&1; then
  [ "\$(id -gn "\${_A}" 2>/dev/null)" = "\${_A}" ] && _G="\${_A}"
  [ "\$(id -gn "\${_A}.ftp" 2>/dev/null)" = "\${_A}" ] && _G="\${_A}"
fi
_MP=""; _N=0
for _M in /mnt/*; do
  [ -d "\${_M}" ] && mountpoint -q "\${_M}" 2>/dev/null && { _MP="\${_M}"; _N=\$((_N + 1)); }
done
[ "\${_N}" = "1" ] || _MP=""
_GI="\$(getent group "\${_G}" 2>/dev/null | cut -d: -f3)"
_WG="\$(getent group www-data 2>/dev/null | cut -d: -f3)"
case "\${_GI}" in ''|*[!0-9]*) _GI="" ;; esac
case "\${_WG}" in ''|*[!0-9]*) _WG=-1 ;; esac
# the account's own web group there, when it exists: its paths are the
# pools' and are never claimed (by number: find refuses an unknown name)
_XW="\$(getent group "wg-\${_A}" 2>/dev/null | cut -d: -f3)"
_WGX=()
case "\${_XW}" in ''|*[!0-9]*) _XW=-1 ;; *) _WGX=( ! -gid "\${_XW}" ) ;; esac
for _R in "/data/disk/\${_A}" "/home/\${_A}.ftp" /home/"\${_A}".* "/opt/user/gems/\${_A}" /opt/user/gems/"\${_A}".* "/opt/user/npm/\${_A}" /opt/user/npm/"\${_A}".* "\${_MP:+\${_MP}/files/\${_A}/static/files}"; do
  [ -n "\${_R}" ] && [ -d "\${_R}" ] && [ ! -L "\${_R}" ] || continue
  # the FPM pool users' homes (oN.web, oN.NN.web) are www-data's, never the
  # account's: the same root set the tool walks
  case "\${_R}" in /home/*.web) continue ;; esac
  # regrouped through a no-follow handle on each name inside the directory
  # find holds, never by name: only a directory, or a regular file with one
  # link, whose handle is still in none of those groups, so a hard link to
  # another file renamed in (or put there) is never regrouped; a link's own
  # group grants nothing and is left
  [ -n "\${_GI}" ] || continue
  find -P "\${_R}" ! -group "\${_G}" ! -group www-data ! -group root "\${_WGX[@]}" \( -type f -o -type d \) \
    -execdir perl -e 'use Fcntl; my (\$g, \$w, \$x) = splice(@ARGV, 0, 3); for my \$n (@ARGV) { sysopen(my \$h, \$n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or next; my @s = stat(\$h); chown(-1, \$g, \$h) if @s && \$s[5] != \$g && \$s[5] != \$w && \$s[5] != \$x && \$s[5] != 0 && (-d _ || (-f _ && \$s[3] == 1)); close(\$h); } exit 0' -- "\${_GI}" "\${_WG}" "\${_XW}" {} + 2>/dev/null
done
# log/ is the account's own: the record is read and removed only inside the
# real directory, never through a link or into a FIFO put there
_W="\$(cd -P /data/disk 2>/dev/null && /bin/pwd -P)/\${_A}/log"
( cd -P -- "/data/disk/\${_A}/log" 2>/dev/null && [ "\$(/bin/pwd -P)" = "\${_W}" ] \
    && [ -f ./instance-group.txt ] || exit 0
  _GID=\$(getent group "\${_A}" 2>/dev/null | cut -d: -f3)
  { [ "\${_G}" = "\${_A}" ] \
    && timeout 10 dd if=./instance-group.txt iflag=nofollow,nonblock,fullblock \
      bs=1048576 count=1 status=none 2>/dev/null | grep -q " gid=\${_GID}\$"; } \
    || rm -f -- ./instance-group.txt )
if [ "\${_DEFERRED}" = "1" ]; then
  echo "INFO: target group pass for \${_A}: the tool deferred 13 times (a BOA run live there); the inline form ran instead, group \${_G}"
  exit 4
fi
echo "INFO: target group pass for \${_A}: group \${_G} (inline form, instgrp not installed there)"
exit 0
REMOTE
  _X_RC=$?
  [ "${_X_RC}" = "0" ] || echo "ALERT: target group pass for ${_X_A} on ${_X_H} returned ${_X_RC} (2 drift left, 3 identities disagree, 4 deferred (the inline form ran), 255 ssh); run 'instgrp status ${_X_A}' there"
  return "${_X_RC}"
}

# The account's identities here map onto the target's: each onto its own
# name there (xcopy copies under the same name only, _xcopy_refuse_rename;
# on a rename, kept as a second line of defence, onto the destination's of
# the same suffix: <src> onto <dst>, <src>.ftp onto <dst>.ftp, a client's
# <src>.<name> onto <dst>.<name>). By name alone a name the target does not
# have lands on this box's number, which can be another account's identity
# there, and on a rename the copy would be owned by the target's own
# identity of the source's name (another tenant's), for good: xcopy has
# no owner pass after the copy.
# An identity whose name the target does not have (yet: a client's login
# comes with the limited-shell worker; a PHP-FPM user oN.<ver>.web exists
# only for a version that box runs) maps onto <dst> itself, so the
# target's identities are asked; a list that cannot be read is refused,
# never guessed (a DENY, the dry run is not clean, a live run stops). The
# map names every identity: no wildcard, which an older rsync would hand
# to the receiving shell. Sets _XCOPY_UMAP.
_xcopy_acct_umap() {   # 1 account here 2 account on the target 3 target
  local _n _t _have="" _m=""
  _XCOPY_UMAP=""
  if [[ "${1}" =~ ^[a-zA-Z0-9_-]+$ ]] && [[ "${2}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    _have=$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${3}" \
      "getent passwd | cut -d: -f1 | grep -E '^${2}(\.[a-zA-Z0-9._-]+)?\$' | sed 's/^/XMID:/'" \
      2>/dev/null | grep -x -E 'XMID:[a-zA-Z0-9._-]+' | cut -d: -f2)
  fi
  if ! grep -qxF -- "${2}" <<< "${_have}"; then
    echo "DENY: could not read the identities of ${2} on ${3}, or ${2} is not installed there yet; the copy of ${1} is never owned by a guessed name"
    _XCOPY_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && exit 1
    return 1
  fi
  for _n in $(getent passwd | cut -d: -f1 | grep -E "^${1}(\.[a-zA-Z0-9._-]+)?$"); do
    _t="${2}${_n#"${1}"}"
    grep -qxF -- "${_t}" <<< "${_have}" || _t="${2}"
    _m="${_m:+${_m},}${_n}:${_t}"
  done
  _XCOPY_UMAP="${_m}"
  return 0
}

# The account's own group here (its per-account group, while it holds
# one) maps onto the group the target account holds there: its own once
# converted there, 'users' until then. By name alone the copy lands in a
# group of that name there (another account's, or one held for a later
# one) or, where the name is absent, in this box's number, and a run that
# stops before its destination pass, or has none, leaves it so. Sets
# _XCOPY_AMAP; empty when no group of the account's name exists here (a group
# that outlives its move back to 'users' is mapped too: its paths land
# where the destination pass would put them). An answer that cannot be
# read is refused, never guessed: a DENY, the dry run is not clean, a live
# run stops.
_xcopy_acct_gmap() {   # 1 account here 2 account on the target 3 target
  local _g=""
  _XCOPY_AMAP=""
  getent group "${1}" > /dev/null 2>&1 || return 0
  case "${2}" in
    ''|*[!a-z0-9-]*)
      echo "DENY: ${2} is not an account name; the paths of ${1}'s group never land in a guessed group"
      _XCOPY_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && exit 1
      return 1
      ;;
    *)
      _g=$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${3}" \
        "getent group '${2}' > /dev/null 2>&1 && { [ \"\$(id -gn '${2}' 2>/dev/null)\" = '${2}' ] || [ \"\$(id -gn '${2}.ftp' 2>/dev/null)\" = '${2}' ]; } && echo 'XMAG:${2}' || echo 'XMAG:users'" \
        2>/dev/null | grep -m1 -x -E 'XMAG:[a-z0-9-]+' | cut -d: -f2)
      ;;
  esac
  case "${_g}" in
    "${2}"|users) _XCOPY_AMAP="${1}:${_g}" ;;
    *)
      echo "DENY: could not read the group of ${2} on ${3}; the paths of ${1}'s group never land in a guessed group"
      _XCOPY_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && exit 1
      return 1
      ;;
  esac
  return 0
}

# An account converted to its own web group here (its web paths in
# wg-<account>, private/ 02770/0660) must not land on a target whose tools
# predate the web group: their claim passes and nightly would hand those
# paths back. The target's instgrp, which the destination pass runs, is
# asked; an answer that cannot be read counts as no. While the account
# holds a web group here, its legs map it onto the one the target's
# writers give the target account (_XCOPY_GMAP): by name alone its paths
# would land in a number that is no group there, or another account's;
# an answer that cannot be read is refused, never guessed. After a done
# free, the paths it left in the held gid are mapped by that number onto
# the same group (_wg_free_left).
# A refusal is a DENY: the dry run is not clean, a live run stops.
_xcopy_webgroup_gate() {   # 1 account here 2 account on the target 3 target
  local _st _ans _wg _left
  _XCOPY_GMAP=""
  _st=$(_web_group_state "${1}" | cut -d' ' -f1)
  [ "${_st}" = "none" ] && return 0
  case "${_st}" in
    converted|phaseb)
      _ans=$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${3}" \
        "grep -q '^_web_group_state() {' /opt/local/bin/instgrp 2>/dev/null && echo XMWG-READY || echo XMWG-OLD" \
        2>/dev/null | grep -m1 -x -E 'XMWG-(READY|OLD)')
      if [ "${_ans}" != "XMWG-READY" ]; then
        echo "DENY: ${1} uses its own web group here, and the tools on ${3} predate it (or could not be asked); bring ${3} to this BOA release (barracuda AND octopus) first"
        _XCOPY_NOT_CLEAN=YES
        [ "${_MODE}" = "LIVE" ] && exit 1
        return 1
      fi
      ;;
  esac
  _wg=$(_web_group_on_target "${2}" "${3}") || _wg=""
  if [ -z "${_wg}" ]; then
    echo "DENY: could not read the web group of ${2} on ${3}; the web paths of ${1} never land in a guessed group"
    _XCOPY_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && exit 1
    return 1
  fi
  _XCOPY_GMAP="wg-${1}:${_wg}"
  _left=$(_wg_free_left "${1}")
  [ -n "${_left}" ] && _XCOPY_GMAP="${_XCOPY_GMAP},${_left}:${_wg}"
  return 0
}

# The immutable flag set ($1 +) or cleared ($1 -) on the names $2 ... of the
# current (pinned) directory, each through one handle opened
# O_NOFOLLOW|O_NONBLOCK (FS_IOC_GETFLAGS/FS_IOC_SETFLAGS, the amd64/arm64
# numbers): only a directory, or a regular file with one link, is changed, so
# a link the account put at a name is never followed (chattr with a trailing
# slash follows one) and a hard link to another file is never locked or
# unlocked. Status 1 when any name was refused.
_XCOPY_CHATTR_PL='use Fcntl; my ($op, @f) = @ARGV; my $rc = 0; for my $f (@f) { sysopen(my $h, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or do { $rc = 1; next }; my @s = stat($h); if (@s && (-d _ || (-f _ && $s[3] == 1))) { my $b = pack("L", 0); if (ioctl($h, 0x80086601, $b)) { my $fl = unpack("L", $b); $fl = $op eq "+" ? ($fl | 0x10) : ($fl & ~0x10); ioctl($h, 0x40086602, pack("L", $fl)) or $rc = 1; } else { $rc = 1 } } else { $rc = 1 } close($h); } exit $rc'
_xcopy_chattr_here() {
  local _op="${1}"
  shift
  perl -e "${_XCOPY_CHATTR_PL}" -- "${_op}" "$@" 2> /dev/null
}
# The same on the current (pinned) directory and every entry in it.
_xcopy_chattr_all_here() {
  perl -e "${_XCOPY_CHATTR_PL}" -- "${1}" . ./* 2> /dev/null
}

_enable_chattr() {
  _isTest="$1"
  _isTest=${_isTest//[^a-z0-9]/}
  if [ ! -z "${_isTest}" ] && [ -d "/home/$1/" ]; then
    # each directory entered as the real one (every name below /home a real
    # directory), the flag changed on "." there
    if [ "$1" != "${_THIS_HM_USER}.ftp" ]; then
      _xcopy_in_real_dir "/home/$1" _xcopy_chattr_here + .
    else
      _xcopy_in_real_dir "/home/$1/platforms" _xcopy_chattr_all_here +
    fi
    _xcopy_in_real_dir "/home/$1/.drush" _xcopy_chattr_here + .
    _xcopy_in_real_dir "/home/$1/.drush/usr" _xcopy_chattr_here + .
    _xcopy_in_real_dir "/home/$1/.bazaar" _xcopy_chattr_here + .
  fi
}

# The .ftp home is locked again when the run that unlocked it ends, on every
# exit the shell can trap: a refused or failed verb must not leave it
# unlocked until the next worker pass, which stays parked during a move.
_XCOPY_CHATTR_OFF=""
_xcopy_chattr_back() {
  [ "${_XCOPY_CHATTR_OFF}" = "YES" ] || return 0
  _XCOPY_CHATTR_OFF=""
  _enable_chattr "${_THIS_HM_USER}.ftp" &> /dev/null
  return 0
}

_disable_chattr() {
  _isTest="$1"
  _isTest=${_isTest//[^a-z0-9]/}
  if [ ! -z "${_isTest}" ] && [ -d "/home/$1/" ]; then
    # each directory entered as the real one (every name below /home a real
    # directory), the flag changed on "." there
    if [ "$1" != "${_THIS_HM_USER}.ftp" ]; then
      _xcopy_in_real_dir "/home/$1" _xcopy_chattr_here - .
    else
      _xcopy_in_real_dir "/home/$1/platforms" _xcopy_chattr_all_here -
    fi
    _xcopy_in_real_dir "/home/$1/.drush" _xcopy_chattr_here - .
    _xcopy_in_real_dir "/home/$1/.drush/usr" _xcopy_chattr_here - .
    # a CLI php.ini an earlier release left, for the ltd worker to remove
    _xcopy_in_real_dir "/home/$1/.drush" _xcopy_chattr_here - ./php.ini
    _xcopy_in_real_dir "/home/$1/.bazaar" _xcopy_chattr_here - .
  fi
}

### A copy keeps the names its source serves, and public DNS keeps them on
### the source: an order this box made for one could only fail, under the
### account's Let's Encrypt registration that travelled with tools/le, whose
### failed validations count against the source's own orders too. Each copied
### site gets the stop marker under its own name before its verify, so the
### verify keeps the certificate that travelled and the nightly renews none
### here. A marker already there is left as it is; one put here is owned by
### the account and added to log/xcopy_le_kept.txt at once, so a run stopped
### halfway lists every marker it put. A name under this box's own one (the
### rename gave it to this box) gets none. An account with no tools/le/.ctrl
### has never had a site with SSL on, so there is nothing to keep. hosting_le
### honours the marker on a verify only beside the site's certificate, so a
### site with SSL on and none is named. A copy that is ever to serve the
### names gets its listed markers removed, then each site verified.
_XCOPY_LE_KEPT=""
_xcopy_le_mark_here() {
  local _t="./.${1}.put.$$.${RANDOM}"
  { [ -e "./${1}" ] || [ -L "./${1}" ]; } && return 2
  rm -f -- "${_t}"
  if perl -e "${_XCOPY_PUT_PL}" "${_t}" "${2}" "${3}" 644 < /dev/null \
    && mv -f -T -- "${_t}" "./${1}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
### The name $1 added to log/xcopy_le_kept.txt (one name a line, sorted).
_xcopy_le_list_add() {
  { _xcopy_read_in "${_USR}/log" xcopy_le_kept.txt
    echo
    printf '%s\n' "${1}"; } | grep -E '^[A-Za-z0-9][A-Za-z0-9.-]*$' | sort -u \
    | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here xcopy_le_kept.txt
}
_xcopy_le_keep() {
  local _u _g _rc
  [[ "${1}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || return 1
  case " ${_XCOPY_LE_KEPT} " in
    *" ${1} "*) return 0 ;;
  esac
  if [ -n "${_hName}" ]; then
    case "${1}" in
      "${_hName}"|*".${_hName}") return 0 ;;
    esac
  fi
  _xcopy_in_real_dir "${_USR}/tools/le/.ctrl" true || return 0
  _u=$(id -u -- "${_THIS_HM_USER}" 2> /dev/null)
  _g=$(id -g -- "${_THIS_HM_USER}" 2> /dev/null)
  [[ "${_u}" =~ ^[0-9]+$ ]] && [[ "${_g}" =~ ^[0-9]+$ ]] || return 1
  _xcopy_in_real_dir "${_USR}/tools/le/.ctrl" \
    _xcopy_le_mark_here "dont-overwrite-${1}.pid" "${_u}" "${_g}"
  _rc=$?
  if [ "${_rc}" -eq 0 ]; then
    _XCOPY_LE_KEPT="${_XCOPY_LE_KEPT} ${1}"
    _xcopy_le_list_add "${1}" \
      || echo "ALRT: site ${1} on ${_oct}: its stop marker is put but could not be listed in ${_USR}/log/xcopy_le_kept.txt"
  elif [ "${_rc}" -ne 2 ]; then
    echo "ALRT: site ${1} on ${_oct}: its Let's Encrypt stop marker could not be put; its verify can order a certificate for the source's name"
  fi
  _xcopy_le_order_named "${1}" || return 0
  if ! _xcopy_in_real_dir "${_USR}/tools/le/certs/${1}" true \
    && _xcopy_read_in "${_USR}/.drush" "${1}.alias.drushrc.php" \
      | grep -qE "'ssl_enabled' => '?[12]'?"; then
    echo "WARN: site ${1} on ${_oct}: no certificate travelled for it, so its verify here can still order one for the source's name, which fails while DNS points at the source"
  fi
  return 0
}
### Whether hosting_le's verify orders for the site $1 at all: it names the
### site's redirect target when there is one, and leaves out the service
### domains and the .nodns. names, and the .temp., .tmp., .test., .dev. kind
### unless the account's ssl-yes-dev flag names it.
_xcopy_le_order_named() {
  local _m="${1}" _r
  _r=$(_xcopy_read_in "${_USR}/.drush" "${1}.alias.drushrc.php" \
    | sed -n "s/^.*'redirection' => '\([A-Za-z0-9][A-Za-z0-9.-]*\)'.*$/\1/p" | head -1)
  [ -n "${_r}" ] && _m="${_r}"
  case "${_m}" in
    *.host8.biz|*.host8.io|*.host8.cc|*.boa.biz|*.boa.io|*.boa.cc) return 1 ;;
    *.aegir.biz|*.aegir.io|*.aegir.cc|*.o8.biz|*.o8.io|*.o8.cc|*.nodns.*) return 1 ;;
  esac
  [ -e "${_USR}/static/control/ssl-yes-dev-${_m}.info" ] && return 0
  case "${_m}" in
    *.temp.*|*.tmp.*|*.temporary.*|*.test.*|*.testing.*|*.dev.*|*.devel.*) return 1 ;;
  esac
  return 0
}
### What this import put, said once at its end.
_xcopy_le_kept_put() {
  local _n
  [ -n "${_XCOPY_LE_KEPT}" ] || return 0
  _n=$(printf '%s\n' ${_XCOPY_LE_KEPT} | wc -l | tr -d ' ')
  echo "INFO: ${_n} copied site(s) of ${_oct} keep the certificate that travelled and order none here:"
  echo "INFO: a stop marker each in ${_USR}/tools/le/.ctrl, listed in ${_USR}/log/xcopy_le_kept.txt;"
  echo "INFO: remove those markers, then verify each site, before this copy serves any of the names"
}
### The verify task of each site this import scheduled one for, kept in
### log/import_verifies.txt for post-mig on this box to report: the verifies
### run once post-mig starts cron here. The site's newest verify is read
### before the scheduling and after it, and taken only when the call made it,
### when it is the one already queued that the panel hands back (the rename
### queues one), or when it changed during the call; otherwise the site is
### kept with none: a call that made no task leaves only the source's own
### verifies, which never ran here.
_XCOPY_VERIFY_SITES=""
_XCOPY_VERIFY_DB=""
_XCOPY_VERIFY_PRE=""
_XCOPY_VERIFY_AT=""
### The newest verify task of the site $1 as "<nid> <status> <changed>".
_xcopy_verify_last() {
  [ -n "${_XCOPY_VERIFY_DB}" ] || return 0
  mysql --silent -u root -N -B "${_XCOPY_VERIFY_DB}" -e "SELECT t.nid, t.task_status, tn.changed FROM hosting_task t JOIN node tn ON tn.nid = t.nid AND tn.vid = t.vid JOIN node s ON s.nid = t.rid JOIN hosting_site hs ON hs.vid = s.vid WHERE s.type = 'site' AND s.title = '${1}' AND hs.status <> -2 AND t.task_type = 'verify' ORDER BY t.nid DESC LIMIT 1" 2> /dev/null \
    | head -1 | tr '\t' ' ' | tr -cd '0-9 -'
}
_xcopy_verify_before() {
  _XCOPY_VERIFY_PRE=""
  _XCOPY_VERIFY_AT=$(date +%s)
  [[ "${1}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || return 0
  [ -n "${_XCOPY_VERIFY_DB}" ] \
    || _XCOPY_VERIFY_DB=$(_xcopy_read_in "${_USR}/log" panel_db.txt | tr -cd 'A-Za-z0-9_')
  _XCOPY_VERIFY_PRE=$(_xcopy_verify_last "${1}")
}
_xcopy_verify_note() {
  local _nid=0 _n _s _c _pn _ps _pc
  [[ "${1}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || return 0
  read -r _n _s _c <<< "$(_xcopy_verify_last "${1}")"
  read -r _pn _ps _pc <<< "${_XCOPY_VERIFY_PRE}"
  if [[ "${_n}" =~ ^[0-9]+$ ]]; then
    if [[ ! "${_pn}" =~ ^[0-9]+$ ]] || [ "${_n}" -gt "${_pn}" ]; then
      _nid="${_n}"
    elif [ "${_n}" = "${_pn}" ] && { [ "${_ps}" = "0" ] || [ "${_ps}" = "-1" ]; }; then
      _nid="${_n}"
    elif [[ "${_c}" =~ ^[0-9]+$ ]] && [ "${_c}" -ge "${_XCOPY_VERIFY_AT}" ]; then
      _nid="${_n}"
    fi
  fi
  _XCOPY_VERIFY_SITES="${_XCOPY_VERIFY_SITES} ${1}:${_nid}"
  [ "${_nid}" = "0" ] \
    && echo "ALRT: site ${1} on ${_oct}: the panel holds no verify of it from this import; post-mig reports it as not found"
  return 0
}
### A list an earlier import left (or one that travelled in log/) is
### replaced, or removed when this import scheduled no verify.
_xcopy_verify_list_put() {
  if [ -z "${_XCOPY_VERIFY_SITES}" ] || [ -z "${_XCOPY_VERIFY_DB}" ]; then
    _xcopy_in_real_dir "${_USR}/log" rm -f -- ./import_verifies.txt
    return 0
  fi
  { echo "db=${_XCOPY_VERIFY_DB}"
    printf '%s\n' ${_XCOPY_VERIFY_SITES} | sed 's/^\(.*\):\([0-9]*\)$/site=\1 \2/'; } \
    | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here import_verifies.txt
}
### Run by post-mig on the target: each copied site's verify that an import
### scheduled, waited for up to 30 minutes once cron runs again (not at all
### when cron is down: the verifies cannot run), and its result printed and
### kept in log/import_verifies.report.txt. Only a list root wrote after the
### account's imported.pid is read (the account owns log/ and could put one
### of its own there); it is removed once reported, so a later post-mig says
### nothing again. A panel database that is gone ends the wait at once and
### the list is kept as import_verifies.unread.txt; a server that cannot be
### reached for two minutes ends it too, and the list stays for a later
### post-mig.
_xcopy_verify_report() {
  local _l _a _u _txt _db _pairs _ids _rows _p _s _id _st _pend _end _rep
  local _ok _warn _fail _left _n _next _cron=YES _gone _qf _sch _src
  pgrep -x cron > /dev/null 2>&1 || _cron=NO
  for _l in /data/disk/*/log/import_verifies.txt; do
    [ -f "${_l}" ] || continue
    _u="${_l%/log/import_verifies.txt}"
    _a="${_u##*/}"
    [[ "${_a}" =~ ^[a-z0-9]+$ ]] || continue
    [ -f "${_u}/log/imported.pid" ] || continue
    [ "${_u}/log/imported.pid" -nt "${_l}" ] && continue
    if ! _txt=$(_xcopy_in_real_dir "${_u}/log" _xcopy_read_root_here import_verifies.txt); then
      echo "ALRT: ${_a}: ${_l} is not a list this tool wrote; not read"
      continue
    fi
    _db=$(printf '%s\n' "${_txt}" | sed -n 's/^db=\([A-Za-z0-9_]\{1,64\}\)$/\1/p' | head -1)
    _pairs=$(printf '%s\n' "${_txt}" \
      | sed -n 's/^site=\([A-Za-z0-9][A-Za-z0-9.-]*\) \([0-9]\{1,12\}\)$/\1:\2/p' | sort -u)
    if [ -z "${_db}" ] || [ -z "${_pairs}" ]; then
      echo "ALRT: ${_a}: ${_l} cannot be read; its copied sites' verifies are not reported"
      _xcopy_in_real_dir "${_u}/log" mv -f -T -- ./import_verifies.txt ./import_verifies.unread.txt
      continue
    fi
    _ids=$(printf '%s\n' ${_pairs} | sed 's/^.*://' | grep -v '^0$' | sort -u | tr '\n' ',')
    _ids="${_ids%,}"
    _n=$(printf '%s\n' ${_pairs} | wc -l | tr -d ' ')
    if [ "${_cron}" = "YES" ]; then
      echo "INFO: ${_a}: waiting up to 30 minutes for the verifies of ${_n} copied site(s)"
      _end=$(( $(date +%s) + 1800 ))
    else
      echo "ALRT: ${_a}: cron is not running, so the verifies of its ${_n} copied site(s) cannot run; their state now:"
      _end=0
    fi
    _next=$(( $(date +%s) + 120 ))
    _rows=""
    _gone=""
    _qf=""
    while [ -n "${_ids}" ]; do
      if ! _rows=$(mysql --silent -u root -N -B "${_db}" -e "SELECT t.nid, t.task_status FROM hosting_task t JOIN node tn ON tn.nid = t.nid AND tn.vid = t.vid WHERE t.nid IN (${_ids})" 2> /dev/null); then
        _rows=""
        [ -n "${_qf}" ] || _qf=$(date +%s)
        _sch=$(mysql --silent -u root -N -B -e "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '${_db}'" 2> /dev/null)
        _src=$?
        if [ "${_src}" -eq 0 ] && [ -z "${_sch}" ]; then
          _gone=GONE
          break
        fi
        if [ $(( $(date +%s) - _qf )) -ge 120 ] || [ "$(date +%s)" -ge "${_end}" ]; then
          _gone=UNREAD
          break
        fi
        sleep 20
        continue
      fi
      _qf=""
      _pend=$(printf '%s\n' "${_rows}" | awk -F'\t' '$2 == 0 || $2 == -1' | wc -l | tr -d ' ')
      [ "${_pend}" -eq 0 ] && break
      [ "$(date +%s)" -ge "${_end}" ] && break
      if [ "$(date +%s)" -ge "${_next}" ]; then
        echo "INFO: ${_a}: ${_pend} of ${_n} verifies still queued or running"
        _next=$(( $(date +%s) + 120 ))
      fi
      sleep 20
    done
    if [ "${_gone}" = "GONE" ]; then
      echo "ALRT: ${_a}: its panel database ${_db} is gone; its copied sites' verifies are not reported"
      _xcopy_in_real_dir "${_u}/log" mv -f -T -- ./import_verifies.txt ./import_verifies.unread.txt
      continue
    elif [ "${_gone}" = "UNREAD" ]; then
      echo "ALRT: ${_a}: its panel database ${_db} could not be read; the list stays for the next post-mig"
      continue
    fi
    _ok=0; _warn=0; _fail=0; _left=0; _rep=""
    for _p in ${_pairs}; do
      _s="${_p%:*}"
      _id="${_p##*:}"
      _st=""
      [ "${_id}" != "0" ] \
        && _st=$(printf '%s\n' "${_rows}" | awk -F'\t' -v i="${_id}" '$1 == i { print $2 }' | head -1)
      case "${_st}" in
        1) _ok=$(( _ok + 1 ))
           _rep="${_rep}INFO: ${_a}: site ${_s} verify OK"$'\n' ;;
        3) _warn=$(( _warn + 1 ))
           _rep="${_rep}WARN: ${_a}: site ${_s} verify ended with warnings (task ${_id})"$'\n' ;;
        2) _fail=$(( _fail + 1 ))
           _rep="${_rep}ALRT: ${_a}: site ${_s} verify FAILED (task ${_id}): read its log in the panel"$'\n' ;;
        0|-1) _left=$(( _left + 1 ))
           _rep="${_rep}ALRT: ${_a}: site ${_s} verify still queued or running (task ${_id})"$'\n' ;;
        *) _fail=$(( _fail + 1 ))
           _rep="${_rep}ALRT: ${_a}: site ${_s}: its verify task from the import could not be found in the panel"$'\n' ;;
      esac
    done
    _rep="${_rep}INFO: ${_a}: ${_n} copied site(s) verified: ${_ok} OK, ${_warn} with warnings, ${_fail} failed, ${_left} unfinished"$'\n'
    printf '%s' "${_rep}"
    printf '%s' "${_rep}" | _xcopy_in_real_dir "${_u}/log" _xcopy_write_here import_verifies.report.txt
    _xcopy_in_real_dir "${_u}/log" rm -f -- ./import_verifies.txt
  done
  return 0
}

### The --runner-wait option of a forced verify in an import's verify stage:
### what is left of one budget for the whole stage, set where the panel's
### hosting knows the option; nothing once 30 s or less is left, or without
### the option (hosting's own 30 s default applies then).
_xcopy_runner_wait_opt() {
  local _w
  [ -n "${_XCOPY_RUNNER_UNTIL}" ] || return 0
  _w=$(( _XCOPY_RUNNER_UNTIL - $(date +%s) ))
  [ "${_w}" -gt 30 ] || return 0
  printf ' --runner-wait=%s' "${_w}"
}

_run_drush8_hmr_cmd() {
  su -s /bin/bash - ${_THIS_HM_USER} -c "drush8 @hostmaster $1"
  wait
}

_run_drush8_nosilent_cmd() {
  su -s /bin/bash - ${_THIS_HM_USER} -c "drush8 @${_Dom} $1"
  wait
}

_xcopy_flush_caches_target() {
  # A copied-in site can carry the source box's stale D8+ service container /
  # opcode caches. Rather than fragile per-site drush rebuilds (which fatal on
  # the D8+ Symfony/Drush patch state outside provision's context), flush HARD
  # at the infrastructure level -- the only treatment trusted against cache/
  # container poisoning: cold-restart Valkey to drop the object cache, and
  # restart every PHP-FPM master to drop opcache/APCu. Correct per-site PHP
  # version is preserved separately (multi-fpm.info).
  echo "INFO: cold cache flush on target (Valkey drop + PHP-FPM restart)"
  if [ -x "/etc/init.d/valkey-server" ]; then
    killall -9 valkey-server &> /dev/null
    rm -f /var/lib/valkey/* &> /dev/null
    service valkey-server start &> /dev/null
  fi
  local _f
  for _f in /etc/init.d/php*-fpm; do
    [ -x "${_f}" ] && service "$(basename "${_f}")" restart &> /dev/null
  done
}

_migrate_sites() {
  # Account tree group, derived once for this run's account.
  _octGrp=$(_acct_group "${_oct}")
  # The account's own control panel is never a site of this loop, in any
  # verb (as in xoct): a <fqdn>.alias the ltd-users pass once planted for it
  # made the panel look like a site. Identify the panel by what it is (the
  # hostmaster alias site_path), not by which alias files happen to exist.
  # .drush is oN's: the alias is read inside the real directory, never
  # through a link or into a FIFO put there.
  _HM_PANEL_FQDN=$(_xcopy_read_in "${_USR}/.drush" hostmaster.alias.drushrc.php \
    | grep "site_path'" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g")
  _HM_PANEL_FQDN=$(basename "${_HM_PANEL_FQDN}" 2>/dev/null)
  _HM_PANEL_FQDN=${_HM_PANEL_FQDN//[^a-zA-Z0-9.\-]/}
  for _Site in `find ${_USR}/config/server_master/nginx/vhost.d -maxdepth 1 -mindepth 1 -type f | sort`
  do
    _Dom=`echo ${_Site} | cut -d'/' -f9 | awk '{ print $1}'`
    _Vht="${_USR}/config/server_master/nginx/vhost.d/${_Dom}"
    _Vhd="${_USR}/config/server_master/nginx/vhost.d/.${_Dom}"
    _Vhs="${_USR}/config/server_master/nginx/vhost.d/https.${_Dom}"
    if [ -n "${_HM_PANEL_FQDN}" ] && [ "${_Dom}" = "${_HM_PANEL_FQDN}" ]; then
      continue
    fi
    # vhost.d is under config/, which belongs to oN: the owner and mode are
    # re-asserted inside the real directory, through a no-follow handle on a
    # regular file with one link that is already the account's -- a link, a
    # hard link to another file, or a file of another owner (a root-only one
    # included) the account put at either name is skipped, never handed to
    # the account.
    if [ ! -z "${_oct}" ]; then
      _xcopy_vhd_reassert "${_Vht%/*}" "${_oct}:${_octGrp}" "${_Dom}"
      _xcopy_vhd_reassert "${_Vht%/*}" "${_oct}:${_octGrp}" ".${_Dom}"
    fi
    if [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ]; then
      echo Dom is ${_Dom}
      ### Every copied site keeps the certificate that travelled (see
      ### _xcopy_le_keep), whether or not its verify runs now.
      if [ "${_cmd}" = "import" ] && [ "${_XCOPY_SITES_STAGE}" != "load" ]; then
        _xcopy_le_keep "${_Dom}"
      fi
      # .drush is oN's: the alias read inside the real directory, never
      # through a link or into a FIFO put at the name
      _Dir=$(_xcopy_read_in "${_USR}/.drush" "${_Dom}.alias.drushrc.php" | grep "site_path'" | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,']//g")
      _Plr=$(_xcopy_read_in "${_USR}/.drush" "${_Dom}.alias.drushrc.php" | grep "root'" | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,']//g")
      # site_path comes from the account's own alias and points into its own
      # tree: it is confined to the account and drushrc.php is read inside its
      # real directory, so root reads and writes a site only there. _DIR_OK
      # gates every db and drushrc step below; a refused site is counted as
      # failed on import and export. The per-site values start empty on every
      # pass, so no refusal ever names another site's.
      _DBN="" _DBU="" _DBP="" _DBP_LIT="" _DRC=""
      _DIR_OK=NO
      case "${_Dir}/" in
        "${_USR}"/*) _xcopy_in_real_dir "${_Dir}" true && _DIR_OK=YES ;;
      esac
      [ "${_DIR_OK}" = "YES" ] \
        || echo "ALRT: site ${_Dom} on ${_oct}: site_path ${_Dir} is outside the account or not a real directory -- its db/drushrc steps are skipped"
      _OWN_DB=NO
      if { [ "${_cmd}" = "import" ] || [ "${_cmd}" = "export" ]; } \
        && [ "${_DIR_OK}" = "YES" ]; then
        _xcopy_sql_maint_hold
        # drushrc.php is written with var_export(): each value is a single-quoted
        # literal in which only the quote and the backslash are escaped. Read the
        # whole file once inside its real directory, then parse the fields.
        _DRC=$(_xcopy_read_in "${_Dir}" drushrc.php)
        _DBN=$(printf '%s\n' "${_DRC}" | grep "options\['db_name'\] = " | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,';]//g")
        _DBN=${_DBN//[^a-zA-Z0-9_]/}
        _DBU=$(printf '%s\n' "${_DRC}" | sed -n "s/^\$options\['db_user'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" | head -1)
        _DBP_LIT=$(printf '%s\n' "${_DRC}" | sed -n 's/^[[:space:]]*\$options\[\x27db_passwd\x27\][[:space:]]*=[[:space:]]*\x27\(.*\)\x27;[[:space:]]*$/\1/p' \
          | head -1 | sed -e 's/\\\x27/\x27/g' -e 's/\\\\/\\/g')
        _DBP=${_DBP_LIT//[^a-zA-Z0-9_]/}
        echo "site ${_Dom} clean _DBN is ${_DBN}"
        # A database is dumped, or loaded over, only when the site's own
        # db_user equals db_name and its credentials open it.
        if [ -n "${_DBN}" ] && [ "${_DBU}" = "${_DBN}" ] \
          && _xcopy_cred_ok "${_DBN}" "${_DBP_LIT}"; then
          _OWN_DB=YES
        fi
      fi
      ### An import loads the sites before the rename (stage load) and
      ### verifies them after it (stage verify). A site is known across the
      ### rename by the device and inode of its directory, which the rename
      ### moves without copying: one the load stage saw only gets its verify
      ### here, when its load was clean; one it never saw is loaded and
      ### verified here as a single-stage import does. A site_path the load
      ### stage cannot enter is judged here, after the rename, which may
      ### reinstate it.
      _SIDN=""
      _SITE_SEEN=NO
      if [ "${_cmd}" = "import" ] && [ -n "${_XCOPY_SITES_STAGE}" ] \
        && [ "${_DIR_OK}" = "YES" ]; then
        _SIDN=$(_xcopy_in_real_dir "${_Dir}" stat -c %d:%i . 2> /dev/null)
        _SIDN=${_SIDN//[^0-9:]/}
        if [ "${_XCOPY_SITES_STAGE}" = "verify" ] && [ -n "${_SIDN}" ]; then
          case " ${_XCOPY_SEEN_DIRS} " in
            *" ${_SIDN} "*) _SITE_SEEN=YES ;;
          esac
        fi
      fi
      if [ "${_SITE_SEEN}" = "YES" ]; then
        _XCOPY_MET_DIRS="${_XCOPY_MET_DIRS} ${_SIDN}"
        case " ${_XCOPY_LOADED_DIRS} " in
          *" ${_SIDN} "*)
            _xcopy_verify_before "${_Dom}"
            _run_drush8_hmr_cmd "hosting-task @${_Dom} verify --force$(_xcopy_runner_wait_opt)"
            _xcopy_verify_note "${_Dom}"
            echo "INFO: site ${_Dom} verify on ${_oct} scheduled"
          ;;
          *)
            echo "ALRT: site ${_Dom} verify NOT scheduled on ${_oct}: db import did not complete"
          ;;
        esac
      elif [ "${_cmd}" = "import" ] && [ "${_DIR_OK}" != "YES" ] \
        && [ "${_XCOPY_SITES_STAGE}" = "load" ]; then
        _XCOPY_DEFERRED_N=$(( _XCOPY_DEFERRED_N + 1 ))
        echo "INFO: site ${_Dom} on ${_oct}: site_path not entered before the rename; judged after it"
      elif [ "${_cmd}" = "import" ] && [ "${_DIR_OK}" != "YES" ]; then
        [ "${_XCOPY_SITES_STAGE}" = "verify" ] && _XCOPY_DEFER_MET=$(( _XCOPY_DEFER_MET + 1 ))
        _XCOPY_SITE_IMPORT_OK=NO
        _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
        _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_Dom}:site-path-refused"
        echo "ALRT: site ${_Dom} on ${_oct}: NOT imported (site_path refused)"
      elif [ "${_cmd}" = "import" ]; then
        [ "${_XCOPY_SITES_STAGE}" = "load" ] && [ -n "${_SIDN}" ] \
          && _XCOPY_SEEN_DIRS="${_XCOPY_SEEN_DIRS} ${_SIDN}"
        [ "${_XCOPY_SITES_STAGE}" = "verify" ] && _XCOPY_DEFER_MET=$(( _XCOPY_DEFER_MET + 1 ))
        if [ "${_DBP}" != "${_DBP_LIT}" ]; then
          echo "ALRT: site ${_Dom} db_passwd carries characters outside the generated-password charset; not re-created here, fix its credentials by hand"
          _DBP=""
        fi
        # vhost.d is oN's: the saved dot-file is renamed over the live name
        # inside the real directory, so a link at either name is never followed.
        _xcopy_in_real_dir "${_Vht%/*}" mv -f -T -- "./.${_Dom}" "./${_Dom}" 2> /dev/null
        if [ ! -z "${_dst}" ]; then
          _TGT_HM_USER="${_dst}"
        else
          _TGT_HM_USER="${_oct}"
        fi
        # Derived here, inside the loop, so it can never carry over a site.
        _TGT_HM_GRP=$(_acct_group "${_TGT_HM_USER}")
        _xcopy_vhd_reassert "${_Vht%/*}" "${_TGT_HM_USER}:${_TGT_HM_GRP}" "${_Dom}"
        # db_host rewritten to localhost inside the real directories, each as a
        # fresh file renamed over the name (owner and mode kept), never through
        # a link or FIFO the account put at drushrc.php or the vhost.
        _xcopy_in_real_dir "${_Dir}" _xcopy_sed_here drushrc.php \
          "s/\$options\['db_host'\] = '.*/\$options[\'db_host\'] = \'localhost\';/g"
        _xcopy_in_real_dir "${_Vht%/*}" _xcopy_sed_here "${_Dom}" \
          "s/.*fastcgi_param.*db_host.*;/  fastcgi_param db_host   localhost;/g"
        echo "INFO: site ${_Dom} db_host on ${_TGT_HM_USER} fixed"
        if [ ! -z "${_DBN}" ] && [ ! -z "${_DBP}" ]; then
          _DB_FRESH=NO
          if [ ! -d "/var/lib/mysql/${_DBN}" ]; then
            _DB_FRESH=YES
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
              mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges
            else
              mysqladmin -u root flush-privileges
            fi
            [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL3 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -uroot"
            if [ -e "/root/.my.proxysql_adm_pwd.txt" ]; then
              _PROXYSQL_PASSWORD=$(cat /root/.my.proxysql_adm_pwd.txt 2>/dev/null | tr -d '\n')
              mysql -uadmin -p${_PROXYSQL_PASSWORD} -h127.0.0.1 -P6032 --protocol=tcp<<PROXYSQL
DELETE FROM mysql_users WHERE username='${_DBN}';
DELETE FROM mysql_query_rules WHERE username='${_DBN}';
INSERT INTO mysql_users (username,password,default_hostgroup) VALUES ('${_DBN}','${_DBP}','10');
LOAD MYSQL USERS TO RUNTIME;
SAVE MYSQL USERS FROM RUNTIME;
SAVE MYSQL USERS TO DISK;
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_DBN}',10,1);
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_DBN}',11,1);
LOAD MYSQL QUERY RULES TO RUNTIME;
SAVE MYSQL QUERY RULES TO DISK;
PROXYSQL
            fi
            _DBN_ESC=$(_xcopy_db_grant_name "${_DBN}")
            mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -u root mysql<<EOFMYSQL
CREATE DATABASE ${_DBN} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${_DBN}'@'localhost';
CREATE USER IF NOT EXISTS '${_DBN}'@'%';
GRANT ALL ON \`${_DBN_ESC}\`.* TO '${_DBN}'@'localhost';
GRANT ALL ON \`${_DBN_ESC}\`.* TO '${_DBN}'@'%';
ALTER USER '${_DBN}'@'localhost' IDENTIFIED BY '${_DBP}';
ALTER USER '${_DBN}'@'%' IDENTIFIED BY '${_DBP}';
EOFMYSQL
            _xcopy_db_revoke_wildcard "${_DBN}" localhost
            _xcopy_db_revoke_wildcard "${_DBN}" %
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
              mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges
            else
              mysqladmin -u root flush-privileges
            fi
            echo "INFO: site ${_Dom} db setup on ${_oct} complete"
          else
            echo "ALRT: site ${_Dom} db ${_DBN} already exists!"
          fi
          # The database this run made, or the site's own one it loads over,
          # is the account's in the database broker's registry once the
          # account is switched (_xcopy_dbreg); a site whose database cannot
          # be entered there is not imported.
          _DB_REG=""
          if [ "${_DB_FRESH}" = "YES" ] || [ "${_OWN_DB}" = "YES" ]; then
            _xcopy_dbreg "${_USR##*/}" "${_DBN}" || _DB_REG=FAIL
          fi
          # A dump is loaded over a database this run did NOT just create only
          # when the site proved it its own (_OWN_DB). A site with no dump
          # (target-native) writes nothing, so it is left to the branch below
          # unchanged.
          if [ -e "${_USR}/src/${_DBN}" ] \
            && [ "${_DB_FRESH}" != "YES" ] && [ "${_OWN_DB}" != "YES" ]; then
            _XCOPY_SITE_IMPORT_OK=NO
            _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
            _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}:not-owned"
            echo "ALRT: site ${_Dom} db ${_DBN} exists but the account cannot prove it owns it -- NOT loaded"
          elif [ -e "${_USR}/src/${_DBN}" ]; then
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
            fi
            [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL4 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
            if [ -x "/usr/local/bin/mydumper" ]; then
              _MYQUICK_ITD=$(mydumper -V 2>&1 \
                | tr -d "\n" \
                | tr -d "," \
                | tr -d "v" \
                | cut -d" " -f2 \
                | awk '{ print $1}' 2>&1)
              _DB_V=$(mysql -V 2>&1 \
                | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
                | head -1 \
                | cut -d"." -f1,2)
              _MD_V=$(mydumper --version 2>&1 \
                | tr -d "\n" \
                | cut -d" " -f6 \
                | awk '{ print $1}' \
                | cut -d"-" -f1 \
                | awk '{ print $1}' \
                | sed "s/[\,']//g" 2>&1)
              if [ "${_DEBUG_MODE}" = "YES" ]; then
                echo "INFO: Installed MyQuick ${_MYQUICK_ITD} for ${_MD_V} (${_DB_V})"
              fi
            fi
            _XCOPY_SITE_IMPORT_OK=NO
            ### src/ is oN's on the target: the dump directory is entered as a
            ### real directory of the account (never through a link swapped for
            ### its name), and myloader reads it as ./ from inside, so --directory
            ### can only name the proven directory.
            ### mydumper writes metadata into the outputdir as its LAST act;
            ### a transferred dir without it is a partial/hollow dump and
            ### loading it would silently restore an incomplete database.
            ### The load is binlogged, so a replica of this box gets it too.
            ### A 5.7 dump's utf8mb4 tables keep utf8mb4_general_ci on 8.x.
            _myloader_binlog_opts
            _myloader_utf8mb4_opts
            if ! _xcopy_in_real_dir "${_USR}/src/${_DBN}" test -e ./metadata; then
              _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
              _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db import SKIPPED on ${_oct}: no restorable dump (metadata missing in src/${_DBN})"
            elif _xcopy_in_real_dir "${_USR}/src/${_DBN}" myloader \
              --database=${_DBN} \
              --host=localhost \
              --defaults-file=/root/.my.cnf \
              --port=3306 \
              --directory=. \
              --threads=4 \
              --drop-table=DROP \
              "${_MYLOADER_BINLOG[@]}" \
              "${_MYLOADER_UTF8MB4[@]}" \
              --verbose=2; then
              _XCOPY_SITE_IMPORT_OK=YES
              echo "INFO: site ${_Dom} db import on ${_oct} complete"
              _measure_loaded_tables "${_DBN}" --defaults-file=/root/.my.cnf \
                --host=localhost --port=3306
            else
              _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
              _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db import FAILED on ${_oct}"
            fi
          else
            ### No transferred dump. A target-native site legitimately has
            ### none — only a site with NEITHER a dump NOR a populated local
            ### database is a real import failure (mirrors the xoct fix from
            ### the first suite leg's false positive).
            _XCOPY_LOCAL_TBLS=$(mysql --silent -u root -N -B -e \
              "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='${_DBN}'" 2>/dev/null | tr -d ' \n')
            if [[ "${_XCOPY_LOCAL_TBLS}" =~ ^[0-9]+$ ]] && [ "${_XCOPY_LOCAL_TBLS}" -gt "0" ]; then
              _XCOPY_SITE_IMPORT_OK=YES
              echo "INFO: site ${_Dom} has no transferred dump; local db ${_DBN} already populated (${_XCOPY_LOCAL_TBLS} tables) -- target-native site, left as-is"
            else
              _XCOPY_SITE_IMPORT_OK=NO
              _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
              _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db failure: no dump in ${_USR}/src/${_DBN} AND local db ${_DBN} is empty/absent"
            fi
          fi
          if [ "${_DB_REG}" = "FAIL" ] && [ "${_XCOPY_SITE_IMPORT_OK}" = "YES" ]; then
            _XCOPY_SITE_IMPORT_OK=NO
            _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
            _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_DBN}:not-registered"
          fi
          ### A verify over a failed import regenerates settings/vhost around
          ### a database that is not there -- schedule it only for clean loads.
          ### Before the rename (stage load) a clean load is only recorded:
          ### its verify runs after the rename, under the site's name there.
          if [ "${_XCOPY_SITE_IMPORT_OK}" != "YES" ]; then
            [ "${_XCOPY_SITES_STAGE}" = "load" ] \
              || echo "ALRT: site ${_Dom} verify NOT scheduled on ${_oct}: db import did not complete"
          elif [ "${_XCOPY_SITES_STAGE}" = "load" ]; then
            if [ -n "${_SIDN}" ]; then
              _XCOPY_LOADED_DIRS="${_XCOPY_LOADED_DIRS} ${_SIDN}"
              _XCOPY_LOADED_NAMES="${_XCOPY_LOADED_NAMES} ${_SIDN}=${_Dom}"
            fi
          elif [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ]; then
            _xcopy_verify_before "${_Dom}"
            _run_drush8_hmr_cmd "hosting-task @${_Dom} verify --force$(_xcopy_runner_wait_opt)"
            _xcopy_verify_note "${_Dom}"
            echo "INFO: site ${_Dom} verify on ${_oct} scheduled"
          else
            echo "ALRT: site ${_Dom} verify failure due to missing ${_USR}/.drush/${_Dom}.alias.drushrc.php"
          fi
        else
          ### Counted: a site whose credentials cannot be parsed was NOT
          ### imported -- the run must not end 0 with imported.pid over it.
          _XCOPY_SITE_IMPORT_OK=NO
          _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
          _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_Dom}:empty-db-credentials"
          echo "ALRT: site ${_Dom} db failure due to an empty database name (${_DBN:-empty}) or password ($([ -n "${_DBP}" ] && echo set || echo empty))"
        fi
      elif [ "${_cmd}" = "export" ]; then
        if [ -x "/usr/local/bin/mydumper" ]; then
          _MYQUICK_ITD=$(mydumper -V 2>&1 \
            | tr -d "\n" \
            | tr -d "," \
            | tr -d "v" \
            | cut -d" " -f2 \
            | awk '{ print $1}' 2>&1)
          _DB_V=$(mysql -V 2>&1 \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
            | head -1 \
            | cut -d"." -f1,2)
          _MD_V=$(mydumper --version 2>&1 \
            | tr -d "\n" \
            | cut -d" " -f6 \
            | awk '{ print $1}' \
            | cut -d"-" -f1 \
            | awk '{ print $1}' \
            | sed "s/[\,']//g" 2>&1)
          if [ "${_DEBUG_MODE}" = "YES" ]; then
            echo "INFO: Installed MyQuick ${_MYQUICK_ITD} for ${_MD_V} (${_DB_V})"
          fi
        fi
        ### Only a database the site proved its own is dumped (see _OWN_DB).
        if [ "${_DIR_OK}" != "YES" ]; then
          _XCOPY_EXPORT_FAIL=$(( ${_XCOPY_EXPORT_FAIL:-0} + 1 ))
          _XCOPY_EXPORT_FAILED_DBS="${_XCOPY_EXPORT_FAILED_DBS} ${_Dom}:site-path-refused"
          echo "ALRT: site ${_Dom} on ${_oct}: site_path refused -- NOT dumped"
        elif [ "${_OWN_DB}" != "YES" ]; then
          _XCOPY_EXPORT_FAIL=$(( ${_XCOPY_EXPORT_FAIL:-0} + 1 ))
          _XCOPY_EXPORT_FAILED_DBS="${_XCOPY_EXPORT_FAILED_DBS} ${_DBN:-${_Dom}}:not-owned"
          echo "ALRT: site ${_Dom} on ${_oct}: cannot prove ${_DBN:-its database} is the account's own -- NOT dumped"
        else
        ### src/ is oN's: the per-db directory is made a real directory here (a
        ### link the account put at its name is removed) and mydumper writes it
        ### as ./ from inside, so --clear can only act on the proven directory.
        _xcopy_in_real_dir "${_USR}/src" _xcopy_realdir_here "${_DBN}"
        ### Percona 5.7: FTWRL without the backup lock (see
        ### _mydumper_backup_locks_opts); any other server as before.
        _MYDUMPER_BACKUP_LOCKS=()
        if [[ "${_DB_V}" == "5.7" ]]; then
          _mydumper_backup_locks_opts
        fi
        ### Any non-transactional table makes mydumper abort the whole
        ### database unless --trx-tables=0 is passed; mirrors mysql_backup.sh.
        _NON_TRX_COUNT=$(mysql -u root -s -N -e "SELECT COUNT(*) FROM \
information_schema.TABLES WHERE TABLE_SCHEMA='${_DBN}' AND \
TABLE_TYPE='BASE TABLE' AND ENGINE IS NOT NULL AND \
ENGINE NOT IN ('InnoDB')" 2> /dev/null)
        _MYDUMPER_TRX_OPT=""
        if [[ "${_NON_TRX_COUNT}" =~ ^[0-9]+$ ]] && [[ "${_NON_TRX_COUNT}" -gt "0" ]]; then
          _MYDUMPER_TRX_OPT="--trx-tables=0"
        fi
        ### mydumper 1.x fixed the adaptive chunker (0.21.x truncated a chunk's
        ### file to 0 bytes when a split landed past the last existing key,
        ### exiting clean), so on 1.x tables are chunked and dumped in parallel
        ### again; older builds keep chunking off (--rows=-1). A fixed --rows=N
        ### walks a sparse key span to inode exhaustion; mirrors mysql_backup.sh.
        ### Probed per call and anchored on the banner line, as in the
        ### nightly: a stray line ahead of it cannot pass as a version.
        _MYDUMPER_ROWS_OPT="--rows=-1"
        _MYDUMPER_MAJOR=$(mydumper -V 2>&1 | grep -m1 "^mydumper v" | cut -d" " -f2 | tr -d "v" | cut -d"." -f1)
        case "${_MYDUMPER_MAJOR}" in
          [1-9]*) _MYDUMPER_ROWS_OPT="" ;;
        esac
        ### The site's triggers, routines and events go with its tables.
        _mydumper_objects_opts
        _mydumper_lockwait_opts
        ### The tool's output goes to a root-only file, read to judge the run
        ### (_mydumper_run_ok: a run whose only counted error is its own
        ### retried table flush exits 1 with a whole dump; one stopped by
        ### SIGTERM says so only at --verbose=3) and printed after it without
        ### its Message lines but those, as at --verbose=2.
        mkdir -p /var/log/boa
        _MYDUMPER_LOG=$(mktemp /var/log/boa/xcopy.mydumper.XXXXXXXX 2> /dev/null)
        if [ -z "${_MYDUMPER_LOG}" ]; then
          echo "ALRT: site ${_Dom} on ${_oct}: no file for mydumper's output under /var/log/boa, so its dump cannot be judged"
        fi
        ### _MYDUMPER_TRX_OPT and _MYDUMPER_ROWS_OPT unquoted by design: empty must expand to no argument.
        _mydumper_session "${_USR}/src/${_DBN}" "$(_xcopy_real_want "${_USR}/src/${_DBN}")" \
          mydumper ${_MYDUMPER_TRX_OPT} \
          --database=${_DBN} \
          --host=localhost \
          --defaults-file=/root/.my.cnf \
          "${_MYDUMPER_LOCKWAIT[@]}" \
          --port=3306 \
          --outputdir=. \
          ${_MYDUMPER_ROWS_OPT} \
          "${_MYDUMPER_OBJECTS[@]}" \
          "${_MYDUMPER_BACKUP_LOCKS[@]}" \
          --build-empty-files \
          --threads=4 \
          --long-query-guard=900 \
          --clear \
          --verbose=3 > "${_MYDUMPER_LOG:-/dev/null}" 2>&1
        _MYDUMPER_RC=$?
        _MYDUMPER_WHOLE="NO"
        if [ -n "${_MYDUMPER_LOG}" ]; then
          awk '!/^\*\* Message: / || /^\*\* Message: ([0-9:.]+: )?(Shutting down gracefully|Thread [0-9]+: Process has been can?celled)$/' "${_MYDUMPER_LOG}"
        fi
        if _mydumper_run_ok "${_MYDUMPER_RC}" "${_MYDUMPER_LOG}" \
          && _xcopy_in_real_dir "${_USR}/src/${_DBN}" test -e ./metadata; then
          _MYDUMPER_WHOLE="YES"
        fi
        if [ -n "${_MYDUMPER_LOG}" ]; then
          rm -f -- "${_MYDUMPER_LOG}"
        fi
        if [ "${_MYDUMPER_WHOLE}" = "YES" ]; then
          if [ "${_MYDUMPER_RC}" != "0" ]; then
            echo "INFO: site ${_Dom} db export on ${_oct}: mydumper retried its table flush behind a long query and exited ${_MYDUMPER_RC}; the dump is whole"
          fi
          echo "INFO: site ${_Dom} db export on ${_oct} complete"
          ### Each stored object keeps the sql_mode it was made under.
          if ! _xcopy_in_real_dir "${_USR}/src/${_DBN}" _mydumper_object_modes "${_DBN}" . \
            mysql --defaults-file=/root/.my.cnf; then
            echo "WARN: site ${_Dom} db export on ${_oct}: its stored objects kept the dump's own sql_mode, so a load of one made under another mode can fail or work otherwise"
          fi
        else
          ### Counted, not just echoed: the run verdict must never stamp
          ### exported.pid over a failed or hollow site dump.
          _XCOPY_EXPORT_FAIL=$(( ${_XCOPY_EXPORT_FAIL:-0} + 1 ))
          _XCOPY_EXPORT_FAILED_DBS="${_XCOPY_EXPORT_FAILED_DBS} ${_DBN}"
          echo "ALRT: site ${_Dom} db export FAILED on ${_oct}"
        fi
        fi
      elif [ "${_cmd}" = "fooproxy" ]; then
        if [ -e "${_USR}/log/exported.pid" ] && [ ! -z "${_tgt}" ]; then
          if [ -e "${_Vht}" ]; then
            # vhost.d is oN's: the names are read inside the real directory,
            # and only host-name words reach the server_name line built below.
            _NMS=`_xcopy_read_in "${_Vht%/*}" "${_Vht##*/}" | grep "server_name" | sed "s/server_name//g; s/;//g" | sort | uniq | tr -d "\n" | sed "s/  / /g; s/  / /g; s/  / /g" | sort | uniq`
            _NMS="$(_xcopy_host_words "${_NMS}")"
            # vhost.d is oN's: every write runs inside the real directory on
            # ./names -- the template is rendered into a fresh file owned by
            # the account from the start (not cp -a onto the name then sed -i),
            # the save is a pinned mv -f -T, and the owner/mode are re-asserted
            # through a no-follow handle (_xcopy_reassert_here), never by name.
            if [ -e "${_USR}/config/server_master/ssl.d/${_Dom}/openssl.key" ] \
              && [ -e "/var/xdrago/conf/https_proxy_le.conf" ]; then
              _xcopy_in_real_dir "${_Vhs%/*}" _xcopy_tpl_to_here \
                /var/xdrago/conf/https_proxy_le.conf "https.${_Dom}" \
                "${_oct}:${_octGrp}" \
                -e "s/.*server_name.*;/  server_name  ${_NMS};/g" \
                -e "s/_target_ip/${_tgt}/g" \
                -e "s/_oct_uid/${_oct}/g" \
                -e "s/_domain_name/${_Dom}/g"
              _xcopy_vhd_reassert "${_Vhs%/*}" "${_oct}:${_octGrp}" "https.${_Dom}"
            fi
            _xcopy_in_real_dir "${_Vht%/*}" mv -f -T -- "./${_Dom}" "./.${_Dom}"
            _xcopy_in_real_dir "${_Vht%/*}" _xcopy_tpl_to_here \
              /var/xdrago/conf/proxy.conf "${_Dom}" "${_oct}:${_octGrp}" \
              -e "s/.*server_name.*;/  server_name  ${_NMS};/g" \
              -e "s/_target_ip/${_tgt}/g"
            _xcopy_vhd_reassert "${_Vht%/*}" "${_oct}:${_octGrp}" "${_Dom}"
            echo "INFO: site ${_Dom} proxy conversion on ${_oct} complete"
          else
            echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed due to missing ${_Vht}"
          fi
        else
          echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed due to empty tgt/${_tgt}"
        fi
      fi
    fi
  done
}

# A copied account arrives carrying the SOURCE box's per-release FPM markers
# under static/control. Both boxes run the same release, so the target's
# manage_ltd_users reads .multi-fpm.<tree>.<xSrl>.pid as "pool set already
# built for this release" and never creates pools for the versions that
# exist only HERE. .multi-nginx-fpm.pid gates the per-site $user_socket
# includes the same way. The result is a pinned site silently served by the
# account's DEFAULT pool, for good: nothing re-triggers until the release
# serial moves or the pin file's CONTENT changes. Clearing the markers hands
# the work back to the normal sweep. Two passes by design -- the include
# generator refuses to emit a site include until that pool's socket exists,
# so the pools must be built first. (.prev-multi-fpm.info is deliberately NOT
# touched: the sweep recreates it from the live file before diffing, so
# removing it proves nothing and only hides the real lever.)
# The carried FPM markers, removed in the current (pinned) control
# directory: the globs expand here, never in the caller's directory.
_xcopy_rm_fpm_markers_here() {
  rm -f -- ./.multi-fpm.*.pid ./.single-fpm.*.pid ./.multi-nginx-fpm.pid
}
_xcopy_heal_fpm_pins() {
  local _acct="$1"
  local _root="/data/disk/${_acct}"
  local _ctl="${_root}/static/control"
  local _pin _dom _ver _missing="" _ltd=/var/xdrago/manage_ltd_users.sh
  # the account's own directory, entered for real: never a link, and the
  # pin file read without following one or opening a FIFO
  _xcopy_in_real_dir "${_ctl}" true || return 0
  [ -e "${_ctl}/multi-fpm.info" ] || return 0
  # Deletes only; nothing is created here, and the sweep re-chowns the
  # .info files it touches -- so no root-owned residue is left behind in
  # the account's control dir.
  _xcopy_in_real_dir "${_ctl}" _xcopy_rm_fpm_markers_here
  echo "INFO: cleared carried FPM pool markers for ${_acct}; rebuilding pinned pools"
  # pre-mig parks the worker as .manage_ltd_users.sh.off until post-mig;
  # import runs with cron stopped, so the parked copy is run here.
  [ -e "${_ltd}" ] || _ltd=/var/xdrago/.manage_ltd_users.sh.off
  if [ -e "${_ltd}" ]; then
    bash "${_ltd}" &> /dev/null
    # The sockets exist now; re-arm the include generator for pass two.
    _xcopy_in_real_dir "${_ctl}" rm -f -- ./.multi-nginx-fpm.pid
    bash "${_ltd}" &> /dev/null
  else
    _ltd=/var/xdrago/manage_ltd_users.sh
  fi
  # Verify every pinned version really has a live pool socket, and name the
  # ones that do not -- a silent wrong-interpreter site is the whole failure
  # this heal exists to prevent.
  while read -r _dom _ver; do
    case "${_dom}" in ''|place.holder*|\#*) continue ;; esac
    [ -z "${_ver}" ] && continue
    _ver="${_ver//[^0-9]/}"
    [ -z "${_ver}" ] && continue
    if [ ! -S "/run/${_acct}.${_ver}.fpm.socket" ]; then
      _missing="${_missing} ${_dom}:${_ver}"
    fi
  done <<< "$(_xcopy_read_in "${_ctl}" multi-fpm.info)"
  if [ ! -z "${_missing}" ]; then
    echo "ALRT: account ${_acct}: pinned PHP pool(s) NOT live after heal:${_missing}"
    echo "ALRT: those sites are being served by the account default pool --"
    echo "ALRT: check /opt/php<NN>/bin/php exists here and re-run:"
    echo "ALRT:   bash ${_ltd}"
  else
    echo "INFO: account ${_acct}: every pinned PHP pool is live"
  fi
}

# Under admail= the account's upgrade notice is switched off where it is
# installed (_SEND_UPGRADE_EMAIL=NO, the operator's off-switch, in its cnf):
# the copy brings the account's setup mail along, and the first Octopus pass
# there after it mails the notice to the account's own address. It stays off
# until set back by hand. $1 = the account there, $2 = the target (none: this
# box). Status 1 when the cnf is missing or cannot be rewritten. As in xoct.
_xcopy_admail_upgrade_mail_off() {
  local _a="$1" _h="$2" _sh _rc
  _sh="_c=/root/.${_a}.octopus.cnf; [ -f \"\${_c}\" ] || exit 1; [ ! -L \"\${_c}\" ] && [ \"\$(tr -d '\\000' < \"\${_c}\" | wc -c)\" != \"\$(wc -c < \"\${_c}\")\" ] && { rm -f -- \"\${_c}.nulheal\"; { perl -0777 -pe 's/(?<=[^\\n\\0])\\0+/\\n/g; tr/\\0//d' < \"\${_c}\" > \"\${_c}.nulheal\" && chmod --reference=\"\${_c}\" \"\${_c}.nulheal\" && mv -f \"\${_c}.nulheal\" \"\${_c}\"; } || rm -f -- \"\${_c}.nulheal\"; }; rm -f -- \"\${_c}.admail\"; ( grep -av '^_SEND_UPGRADE_EMAIL=' \"\${_c}\"; [ \$? -le 1 ] || exit 2; echo _SEND_UPGRADE_EMAIL=NO ) > \"\${_c}.admail\" && chmod 644 \"\${_c}.admail\" && mv -f \"\${_c}.admail\" \"\${_c}\" || { rm -f -- \"\${_c}.admail\"; exit 1; }"
  if [ -n "${_h}" ]; then
    ssh root@"${_h}" "${_sh}" 2> /dev/null
    _rc=$?
  else
    bash -c "${_sh}" 2> /dev/null
    _rc=$?
  fi
  if [ "${_rc}" -ne 0 ]; then
    echo "ALRT: admail=: the upgrade notice of ${_a}${_h:+ on ${_h}} could not be switched off; its next Octopus pass there may mail the account's own address"
    return 1
  fi
  echo "INFO: admail=: the upgrade notice of ${_a}${_h:+ on ${_h}} is off (_SEND_UPGRADE_EMAIL=NO in /root/.${_a}.octopus.cnf); set it back once the account serves for real"
  return 0
}

# The first Octopus pass after a copy that would mail the account's upgrade
# notice sends none: the copy carries the setup mail along, and the client
# has everything that notice says from the move itself. The account's
# one-pass marker, /data/conf/<account>_skip_upgrade_email.txt, root's, is
# put where the account is installed (create) and again where it is
# imported, when absent; that pass takes it away, and every later pass mails
# as the account's switch says. An account whose switch there is NO gets
# none, unless a test copy (admail=) put that NO: no pass of it would take
# the marker, which would then swallow the first notice after the switch is
# turned on. As in xoct. $1 = the account there, $2 = the target (none: this
# box), $3 = the step.
_xcopy_upgrade_skip_put() {
  local _a="$1" _h="$2" _f _sh _out
  _f="/data/conf/${_a}_skip_upgrade_email.txt"
  _sh="[ -e '${_f}' ] && { echo SKIP-HAD; exit 0; }; if [ -z '${_XCOPY_ADMAIL}' ] && [ \"\$(grep -a '^_SEND_UPGRADE_EMAIL=' /root/.${_a}.octopus.cnf 2> /dev/null | tail -n 1 | cut -d= -f2- | tr -d '\"')\" = NO ]; then echo SKIP-OFF; exit 0; fi; mkdir -p /data/conf && ( umask 022; printf '%s\n' 'xcopy ${3} $(date -u '+%F %T') UTC' > '${_f}.tmp' ) && mv -f '${_f}.tmp' '${_f}' && echo SKIP-PUT"
  if [ -n "${_h}" ]; then
    _out="$(ssh root@"${_h}" "${_sh}" 2> /dev/null)"
  else
    _out="$(bash -c "${_sh}" 2> /dev/null)"
  fi
  case "${_out}" in
    SKIP-PUT|SKIP-HAD)
      echo "INFO: ${_a}'s first Octopus pass${_h:+ on ${_h}} that would mail its upgrade notice sends none (${_f})"
      return 0
    ;;
    SKIP-OFF)
      echo "INFO: ${_a}'s upgrade notice is off${_h:+ on ${_h}} (_SEND_UPGRADE_EMAIL=NO): no one-pass marker is put"
      return 0
    ;;
  esac
  echo "ALRT: ${_f}${_h:+ on ${_h}} could not be put: the first Octopus pass there may mail ${_a}'s upgrade notice"
  return 1
}

# A box that holds its clients' mail for a test run: root's
# /data/conf/client_mail_hold.txt, holding one plain address, which xoct and
# xmass put under admail= and remove when the test run ends. Without
# admail=, refuses (status 1, naming it) while the hold is on the target $1
# of a copy: the copied client's mail there would stay held. A target that
# cannot be read passes: the verb's own contact reports it. The probe never
# prompts and gives up on a target that does not answer within 15 s, so a
# mistyped or unreachable one no longer holds the verb for the whole TCP
# connect, silently. A connection dropped before login, a stall in the banner
# among them, is tried again as every call in the tool is, each try told on
# the terminal. As xoct's _xoct_hold_gate. xcopy puts no hold of its
# own: it keeps no test-run record, so nothing could tell when a hold it put
# may go.
_XCOPY_HOLD_FILE=/data/conf/client_mail_hold.txt
_xcopy_hold_gate() {
  local _h="$1" _v
  [ -n "${_XCOPY_ADMAIL}" ] && return 0
  [[ "${_h}" =~ ^[A-Za-z0-9.:-]+$ ]] || return 0
  _v="$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_h}" "if [ -e ${_XCOPY_HOLD_FILE} ]; then head -n 1 ${_XCOPY_HOLD_FILE} | tr -cd '[:print:]' | cut -c1-200; echo; echo HOLD-HAD; else echo HOLD-NONE; fi" 2> /dev/null)"
  case "${_v}" in
    *HOLD-HAD*) _v="$(printf '%s\n' "${_v}" | head -n 1)" ;;
    *) return 0 ;;
  esac
  echo "ERROR: ${_h} holds its clients' mail for ${_v} (${_XCOPY_HOLD_FILE}, put by a test run):"
  echo "ERROR: a real copy (no admail=) would leave the copied client's mail held there. End that"
  echo "ERROR: test run first ('xoct go-live' after a canary, 'xmass go-live' after a whole-box"
  echo "ERROR: test), or remove the file by hand once no test run needs it"
  return 1
}

# One plain address, the test xoct's create applies: create splices the
# value into a remote root command, so nothing outside this alphabet, and no
# second address, may pass.
_xcopy_email_ok() {
  local _re='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
  [[ "${1}" =~ ${_re} ]]
}

# One address or several separated by single spaces, the form the nightly
# and usage.sh mail and xoct's notices take (xoct's _xoct_email_ok): what
# an account's address may be, where create needs exactly one.
_xcopy_email_list_ok() {
  local _w _re _q="'"
  _w="[A-Za-z0-9_][A-Za-z0-9._%+=${_q}-]*@[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?"
  _re="^${_w}( ${_w})*$"
  [[ "${1}" =~ ${_re} ]]
}

# The account's client address as its own Octopus pass takes it, as xoct
# reads it: the words of log/email.txt when they are plain addresses,
# otherwise the _CLIENT_EMAIL of root's cnf, which the pass keeps when the
# file holds none and the nightly rewrites only from a file that does. Sets
# _XCOPY_EMAIL (empty when neither holds one), _XCOPY_EMAIL_TXT (the file's
# text, one space between words) and _XCOPY_EMAIL_SRC (log, cnf or none).
# $1 = the account's root, $2 = its name on this box.
_xcopy_client_address() {
  local _root="$1" _acct="$2" _c=""
  _XCOPY_EMAIL=""
  _XCOPY_EMAIL_TXT=""
  _XCOPY_EMAIL_SRC=none
  if [ -e "${_root}/log/email.txt" ]; then
    _XCOPY_EMAIL_TXT="$(_xcopy_read_in "${_root}/log" email.txt | tr -s '[:space:]' ' ')"
    _XCOPY_EMAIL_TXT="${_XCOPY_EMAIL_TXT# }"
    _XCOPY_EMAIL_TXT="${_XCOPY_EMAIL_TXT% }"
    _XCOPY_EMAIL_TXT=${_XCOPY_EMAIL_TXT//\\\@/\@}
  fi
  if _xcopy_email_list_ok "${_XCOPY_EMAIL_TXT}"; then
    _XCOPY_EMAIL="${_XCOPY_EMAIL_TXT}"
    _XCOPY_EMAIL_SRC=log
    return 0
  fi
  if [[ "${_acct}" =~ ^[a-zA-Z0-9._-]+$ ]] && [ -f "/root/.${_acct}.octopus.cnf" ]; then
    _c="$(grep -a '^_CLIENT_EMAIL=' "/root/.${_acct}.octopus.cnf" 2> /dev/null \
      | tail -n 1 | cut -c1-1024)"
    _c="${_c#_CLIENT_EMAIL=}"
    _c="${_c#\"}"
    _c="${_c%\"}"
    _c="$(printf '%s' "${_c}" | tr -s '[:space:]' ' ')"
    _c="${_c# }"
    _c="${_c% }"
    _c=${_c//\\\@/\@}
  fi
  if _xcopy_email_list_ok "${_c}"; then
    _XCOPY_EMAIL="${_c}"
    _XCOPY_EMAIL_SRC=cnf
  fi
  return 0
}

# Root's reader of an account's plan file in log/, a copy of usage.sh's: ./$1
# through one handle, only while it is root's regular file with one link that
# no one else can write, at most 64 KiB. On Linux the handle carries the
# root-only stamp trusted.boa.plan with the file's own name: a file stamped
# with another name (a file of root's the account renamed, or one copied with
# cp -a) is refused with status 6, an unstamped one is stamped. $2 "read"
# prints its mtime on a line, then its bytes; "stamp" only stamps. Status 3:
# no such name; 4: anything else there; 5: a read error.
# shellcheck disable=SC2016
_PLAN_HREAD_PL='use Fcntl; use Errno qw(ENOENT ENODATA EOPNOTSUPP); my ($n, $m) = @ARGV; exit 4 unless defined $m && ($m eq "read" || $m eq "stamp"); (my $b = $n) =~ s{^\./}{}; exit 4 unless $b =~ /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$/; sysopen(my $h, $n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit($! == ENOENT ? 3 : 4); my @t = stat($h); exit 4 unless @t && -f _ && $t[3] == 1 && $t[4] == 0 && $t[7] <= 65536 && ($t[2] & 022) == 0; if ($^O eq "linux" && eval { require "syscall.ph"; 1 }) { my ($k, $v) = ("trusted.boa.plan", "\0" x 256); my $g = syscall(&SYS_fgetxattr, fileno($h), $k, $v, 256); if ($g >= 0) { exit 6 unless substr($v, 0, $g) eq $b; } elsif ($! == ENODATA) { syscall(&SYS_fsetxattr, fileno($h), $k, $b, length($b), 0); } elsif ($! != EOPNOTSUPP) { exit 4; } } exit 0 if $m eq "stamp"; my ($d, $r) = (""); while ($r = sysread($h, my $c, 65536)) { $d .= $c; exit 4 if length($d) > 65536; } exit 5 unless defined $r; close($h); binmode(STDOUT); print "$t[9]\n", $d or exit 5; exit 0'
# The plan names the pool sizing knows; a plan value is one of these.
_XCOPY_PLAN_RE='^(AERO|AGAIN|BUS|CLASSIC|CLUSTER|EDGE|HEADSPACE|MICRO|MINI|MONSTER|PHANTOM|POWER|QUIET|SSD|ULTRA)$'
# One plan value of the account the target is installed with, as its own
# Octopus pass takes it: log/$3 only as root wrote it under that name
# (_PLAN_HREAD_PL), otherwise the $4 of root's cnf; either only when the whole of it
# (blanks around it dropped) matches the extended regular expression $5.
# log/ is the account's: a file it made there would install the target with
# a plan it never had. Sets the variable $4 (left as it is when neither
# holds a value). $1 = the account's root, $2 = its name here.
_xcopy_plan_value() {
  local _root="$1" _acct="$2" _f="$3" _var="$4" _re="$5" _v _s
  _v="$(_xcopy_in_real_dir "${_root}/log" perl -e "${_PLAN_HREAD_PL}" \
    -- "./${_f}" read && printf x)"
  _s=$?
  if [ "${_s}" -eq 0 ]; then
    _v="${_v%x}"
    _v="${_v#*$'\n'}"
    _v="${_v#"${_v%%[![:space:]]*}"}"
    _v="${_v%"${_v##*[![:space:]]}"}"
    if [[ "${_v}" =~ ${_re} ]]; then
      printf -v "${_var}" '%s' "${_v}"
      return 0
    fi
  elif [ -e "${_root}/log/${_f}" ] || [ -L "${_root}/log/${_f}" ]; then
    echo "INFO: log/${_f} is not as root wrote it: ${_var} comes from /root/.${_acct}.octopus.cnf"
  fi
  [[ "${_acct}" =~ ^[a-zA-Z0-9._-]+$ ]] && [ -f "/root/.${_acct}.octopus.cnf" ] || return 0
  _v="$(grep -a "^${_var}=" "/root/.${_acct}.octopus.cnf" 2> /dev/null \
    | tail -n 1 | cut -c1-256)"
  _v="${_v#"${_var}"=}"
  _v="${_v//\"/}"
  _v="${_v#"${_v%%[![:space:]]*}"}"
  _v="${_v%"${_v##*[![:space:]]}"}"
  [[ "${_v}" =~ ${_re} ]] && printf -v "${_var}" '%s' "${_v}"
  return 0
}

# $1 as a log line shows it: at most 120 bytes, non-printables as '?'.
_xcopy_shown() {
  printf '%s' "${1:0:120}" | tr -c '[:print:]' '?'
}

# Bounded wait until the TARGET is quiet: no BOA run and no armed upgrade
# there, on two consecutive polls (chained passes leave lock-free gaps of a
# few seconds). An ARMED pid counts as busy: the runner consumes it on its
# next tick, and a run it starts takes the mail-suppression marker off. The
# caller fails when the box never goes quiet. Kept in step with xoct's
# _xoct_wait_target_quiet -- mirror any fix there.
_xcopy_wait_target_quiet() {
  local _t="$1" _w=0 _busy _ok=0 _said="" _t0
  local _max="${_XCOPY_TARGET_QUIET_MAX_WAIT:-1800}"
  case "${_max}" in ''|*[!0-9]*) _max=1800 ;; esac
  # _w is wall time since the wait began: a poll through the retry of a
  # dropped connection can take minutes, more than the sleeps between polls.
  # A quiet answer at the ceiling still gets its confirming poll.
  _t0=$(date +%s)
  while [ "${_w}" -lt "${_max}" ] || [ "${_ok}" = "1" ]; do
    # An armed run-upgrade.pid whose dispatcher is parked (a demoted
    # target keeps every /var/xdrago/run-<acct> under /var/backups/off-run)
    # is inert and not busy, as xmass's silence probe already reads it,
    # and so is one of an account whose dispatcher aegir2boa holds for an
    # unfinished import (/var/backups/a2b/<account>/held-run-<account>);
    # counting it burnt the whole bound and refused the create. The same
    # holds for every armed pid while the box's runner itself is parked
    # (pre-mig's .runner.sh.off, held by the park marker until post-mig):
    # nothing consumes them before post-mig, so a second account's create
    # would wait out the bound on the first one's armed upgrade. Without
    # the marker the next tools refresh brings the runner back, so the
    # pid still counts. One with no platforms.info beside it never does:
    # the runner takes no trigger without it.
    _busy=$(ssh root@"${_t}" "ls /run/boa_run.pid /run/boa_wait.pid /run/octopus_install_run.pid 2>/dev/null | tr '\n' ' '; { [ -e /run/boa_migration_park.pid ] && [ ! -e /var/xdrago/runner.sh ] && [ -e /var/xdrago/.runner.sh.off ]; } || for _f in /data/disk/*/static/control/run-upgrade.pid; do [ -e \"\${_f}\" ] || continue; [ -e \"\${_f%/*}/platforms.info\" ] || continue; _n=\${_f#/data/disk/}; _n=\${_n%%/*}; [ ! -e \"/var/xdrago/run-\${_n}\" ] && { [ -e \"/var/backups/off-run/run-\${_n}\" ] || [ -e \"/var/backups/a2b/\${_n}/held-run-\${_n}\" ]; } && continue; printf '%s:armed ' \"\${_n}\"; done; echo QUIET-READ" 2>/dev/null)
    # a poll that never answered is not a quiet box
    case "${_busy}" in
      *QUIET-READ) _busy="${_busy%QUIET-READ}" ;;
      *) _busy="no answer " ;;
    esac
    if [ -z "${_busy// /}" ]; then
      _ok=$(( _ok + 1 ))
      if [ "${_ok}" -ge 2 ]; then
        [ "${_w}" -gt 0 ] && echo "INFO: target ${_t} quiet after ${_w}s (two consecutive polls)"
        return 0
      fi
      sleep 15
      _w=$(( $(date +%s) - _t0 ))
      continue
    fi
    _ok=0
    [ -n "${_said}" ] || echo "INFO: a BOA run holds or is armed on ${_t} (${_busy}); waiting up to ${_max}s before the install"
    _said=1
    sleep 30
    _w=$(( $(date +%s) - _t0 ))
  done
  echo "ALRT: target ${_t} still busy after ${_max}s (${_busy}); not launching the install into a refusal"
  return 1
}

# Bounded wait until BOA's own heavyweight jobs are quiet on THIS box;
# replaces the runbook's "wait ~5 minutes" guess before an import.
_xcopy_wait_boa_quiet() {
  local _w=0
  local _max="${_XCOPY_QUIET_MAX_WAIT:-600}"
  case "${_max}" in ''|*[!0-9]*) _max=600 ;; esac
  while [ "${_w}" -lt "${_max}" ]; do
    if ! pgrep -f "[b]arracuda up|[o]ctopus up|[A]egirSetup" &> /dev/null; then
      return 0
    fi
    echo "INFO: waiting for a running barracuda/octopus/AegirSetup job to finish (${_w}s)"
    sleep 15
    _w=$(( _w + 15 ))
  done
  echo "ALRT: BOA jobs still running after ${_max}s; proceeding -- watch for task collisions"
  return 0
}

# A database this tool makes, or a site's own one it loads over, for an
# account switched to the database broker (root's
# /data/conf/<account>_db_broker.txt) is entered in the broker's registry
# as that account's, and the account's own grant on it given, as the
# broker's own create does: otherwise every later task of the site is
# refused as not the account's. An account not switched, or one whose
# control file the broker finds not valid (its tasks take the direct
# path), is left as it was. Same text in xoct and xcopy.
_xcopy_dbreg() {   # 1 account here 2 database
  local _f="/data/conf/${1}_db_broker.txt" _out _rc
  [ -e "${_f}" ] || [ -L "${_f}" ] || return 0
  if [ ! -x /usr/local/bin/boa-dbctl ]; then
    echo "ALRT: ${1} is switched to the database broker, which is not installed here:"
    echo "ALRT: database ${2} is not entered as ${1}'s in its registry"
    return 1
  fi
  _out=$(/usr/local/bin/boa-dbctl register "${2}" --account "${1}" --via xcopy 2>&1)
  _rc=$?
  if [ "${_rc}" = "8" ]; then
    echo "ALRT: ${_f} is not valid: database ${2} is left out of the broker's registry,"
    echo "ALRT: and ${1}'s tasks take the direct path"
    return 0
  fi
  if [ "${_rc}" = "0" ]; then
    if _out=$(/usr/local/bin/boa-dbctl regrant --account "${1}" 2>&1); then
      echo "INFO: database ${2} entered as ${1}'s in the database broker's registry"
      return 0
    fi
    echo "ALRT: database ${2} is ${1}'s in the database broker's registry, but its grant failed: ${_out##*$'\n'}"
    echo "ALRT: run: boa-dbctl regrant --account ${1}"
    return 1
  fi
  echo "ALRT: database ${2} is not entered as ${1}'s in the database broker's registry: ${_out##*$'\n'}"
  echo "ALRT: its site's tasks are refused until: boa-dbctl register ${2} --account ${1} --via xcopy; boa-dbctl regrant --account ${1}"
  return 1
}

# The poured panel carries the source's login for its database server row;
# this box's instance user keeps its own password, so every server verify
# (the rename's queue first) failed until the next Octopus pass re-synced it.
# The row takes the account's own name and the password this box set for it
# (.<account>.pass.txt in the account root, read no-follow). After a rename
# the row named the source account, here no user or another account's, and
# neither the rename nor the Octopus pass (which finds the row by the
# account's name) mapped it, so every server verify failed for good: the
# name is mapped even when the password cannot be read, which the caller
# reports (non-zero) and the next Octopus pass then fixes. Same text in
# xoct and xcopy.
_xcopy_sync_panel_db_pass() {   # 1 account root 2 account here 3 source account 4 panel db
  local _p _set
  _p=$(_xcopy_read_in "${1}" ".${2}.pass.txt" | head -1 | tr -d '\n')
  case "${_p}" in
    *[!A-Za-z0-9+/=%@._-]*) _p="" ;;
  esac
  [ "${#_p}" -ge 9 ] || _p=""
  _set="db_user='${2}'"
  [ -n "${_p}" ] && _set="${_set}, db_passwd='${_p}'"
  mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp "${4}" \
    -e "UPDATE hosting_db_server SET ${_set} WHERE db_user IN ('${2}','${3}')" 2> /dev/null \
    && [ -n "${_p}" ]
}

_xcopy_reconcile_panel_platform() {
  # Mirror of xoct's panel platform drift handling (itself xmass step
  # 12.5's; kept separate by design -- mirror fixes, don't DRY). The
  # imported hostmaster DB names the SOURCE's panel platform path; an aged
  # source usually sits on a different distro/NNN than the freshly installed
  # dest account (the panel platform is rebuilt whenever the PHP pin
  # changes). Left alone, the rename queue's hostmaster verify regenerates
  # aliases FROM the DB and the copied panel 404s from a hollow platform
  # path. Retired platform trees keep their code forever, so code presence
  # at the imported number proves nothing -- the LIVE panel is found by
  # scanning for the unique site dir that carries drushrc.php + settings.php
  # on a code-bearing platform, and the DB row is repointed only when that
  # platform differs. Runs on the TARGET between the DB import and
  # renameaegirhost; xcopy never renames the account, so the source account
  # and this root are the same name and only the platform number is
  # corrected here. Non-zero return means the panel cannot be resolved and
  # the import must not ride out as a success.
  local _dest_root="$1"
  local _src_acct="$2"
  local _hdb="$3"
  local _db_plat _dest_plat _tree _cand _found _n _new_plat _new_src_form
  local _fqdn _chk _nup _stored_db _pw _f _lit _vhf _vhd_dir
  _fqdn=$(hostname -f 2>/dev/null | tr -d '\n')
  _fqdn=${_fqdn//[^a-zA-Z0-9.-]/}
  if [ -z "${_fqdn}" ]; then
    echo "ALRT: no system FQDN; cannot resolve the live panel platform"
    return 1
  fi
  _db_plat=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp -N -B ${_hdb} -e "SELECT p.publish_path FROM \
    hosting_platform p JOIN hosting_site s ON s.platform=p.nid \
    JOIN hosting_context c ON c.nid=s.nid WHERE c.name='hostmaster' \
    LIMIT 1" 2>/dev/null)
  _db_plat=${_db_plat//[^a-zA-Z0-9\/._-]/}
  if [ -z "${_db_plat}" ]; then
    echo "ALRT: cannot read the hostmaster platform path from ${_hdb}; cannot reconcile the panel"
    return 1
  fi
  _dest_plat="${_db_plat/#\/data\/disk\/${_src_acct}\//${_dest_root}\/}"
  _tree="${_dest_root}/aegir/distro"
  _found=""
  _n=0
  for _cand in "${_tree}"/*/sites/*"${_fqdn}"*; do
    [ -f "${_cand}/drushrc.php" ] || continue
    [ -f "${_cand}/settings.php" ] || continue
    [ -e "$(dirname "$(dirname "${_cand}")")/index.php" ] || continue
    _found="${_cand}"
    _n=$(( _n + 1 ))
  done
  if [ "${_n}" != "1" ]; then
    echo "ALRT: ${_n} candidate live panels under ${_tree} match ${_fqdn} -- refusing to guess"
    return 1
  fi
  _new_plat=$(dirname "$(dirname "${_found}")")
  _chk=${_new_plat//[^a-zA-Z0-9\/._-]/}
  if [ "${_chk}" != "${_new_plat}" ]; then
    echo "ALRT: live panel platform path carries unexpected characters: ${_new_plat}"
    return 1
  fi
  # The live panel's stored credentials must name the DB the dump actually
  # landed in: a panel rebuild between create and import replaces the panel
  # DB, leaving drushrc/settings naming the dropped one -- renameaegirhost
  # then cannot locate the live DB. Same credential rewire xoct and xmass
  # 12.5 do, applied only on a mismatch.
  # The site dir under aegir/distro is oN's: read and rewrite every credential
  # file inside its real directory, never through a link or into a FIFO the
  # account put at settings.php, drushrc.php or a vhost name. Each file is put
  # back as a fresh file with its own owner and mode (a root-owned settings.php
  # is silently skipped by drush/PHP), never chowned or chmodded by name.
  _stored_db=$(_xcopy_read_in "${_found}" drushrc.php \
    | grep "options\['db_name'\]" \
    | head -1 | sed "s/.*=//; s/[' ,;]//g")
  _stored_db=${_stored_db//[^a-zA-Z0-9_]/}
  if [ -n "${_stored_db}" ] && [ "${_stored_db}" != "${_hdb}" ]; then
    _pw=$(od -An -N8 -tx8 /dev/urandom | tr -d " \n" | cut -c1-14)
    if [ -z "${_pw}" ]; then
      echo "ALRT: could not generate a password for the panel credential heal"
      return 1
    fi
    mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp \
      -e "CREATE USER IF NOT EXISTS '${_hdb}'@'localhost' IDENTIFIED BY '${_pw}'; \
          ALTER USER '${_hdb}'@'localhost' IDENTIFIED BY '${_pw}'; \
          GRANT ALL ON \`$(_xcopy_db_grant_name "${_hdb}")\`.* TO '${_hdb}'@'localhost'; \
          CREATE USER IF NOT EXISTS '${_hdb}'@'%' IDENTIFIED BY '${_pw}'; \
          ALTER USER '${_hdb}'@'%' IDENTIFIED BY '${_pw}'; \
          GRANT ALL ON \`$(_xcopy_db_grant_name "${_hdb}")\`.* TO '${_hdb}'@'%'; \
          FLUSH PRIVILEGES;" 2>/dev/null
    _xcopy_db_revoke_wildcard "${_hdb}" localhost
    _xcopy_db_revoke_wildcard "${_hdb}" %
    for _f in settings.php drushrc.php; do
      _xcopy_in_real_dir "${_found}" test -f "./${_f}" || continue
      # A cloaked settings.php carries no literal credential lines -- it reads
      # them from the vhost or the sibling drushrc.php -- so the rewrite below
      # legitimately matches nothing there and must not be asserted.
      _lit=YES
      if ! _xcopy_read_in "${_found}" "${_f}" | grep -q "^ *'database' => [\"'][^\"']*[\"']," \
        && ! _xcopy_read_in "${_found}" "${_f}" | grep -q "^\$options\['db_name'\] = '"; then
        _lit=NO
      fi
      _xcopy_in_real_dir "${_found}" _xcopy_sed_here "${_f}" \
        -e "s#^\( *'database' => \)[\"'][^\"']*[\"'],#\1\"${_hdb}\",#" \
        -e "s#^\( *'username' => \)[\"'][^\"']*[\"'],#\1\"${_hdb}\",#" \
        -e "s#^\( *'password' => \)[\"'][^\"']*[\"'],#\1\"${_pw}\",#" \
        -e "s#^\(\$options\['db_name'\] = \)'[^']*';#\1'${_hdb}';#" \
        -e "s#^\(\$options\['db_user'\] = \)'[^']*';#\1'${_hdb}';#" \
        -e "s#^\(\$options\['db_passwd'\] = \)'[^']*';#\1'${_pw}';#"
      if [ "${_lit}" = "YES" ] && ! _xcopy_read_in "${_found}" "${_f}" | grep -q "${_hdb}"; then
        echo "ALRT: panel credential heal did not land in ${_found}/${_f}"
        return 1
      fi
    done
    # A cloaked panel reads its web credentials from the vhost, not from
    # settings.php, so the rewire has to land there too or the panel keeps
    # authenticating as the dropped DB until the next render.
    _vhd_dir="${_dest_root}/config/server_master/nginx/vhost.d"
    for _vhf in "$(basename "${_found}")" "https.$(basename "${_found}")"; do
      _xcopy_in_real_dir "${_vhd_dir}" test -f "./${_vhf}" || continue
      _xcopy_in_real_dir "${_vhd_dir}" _xcopy_sed_here "${_vhf}" \
        -e "s#^\( *fastcgi_param  *db_name  *\)[^;]*;#\1${_hdb};#" \
        -e "s#^\( *fastcgi_param  *db_user  *\)[^;]*;#\1${_hdb};#" \
        -e "s#^\( *fastcgi_param  *db_passwd  *\)[^;]*;#\1${_pw};#"
    done
    echo "PANEL-NOTE: live panel credentials healed ${_stored_db} -> ${_hdb} in ${_found}"
  fi
  if [ "${_new_plat}" = "${_dest_plat}" ]; then
    return 0
  fi
  _new_src_form="${_new_plat/#${_dest_root}\//\/data\/disk\/${_src_acct}\/}"
  echo "PANEL-NOTE: imported panel platform ${_db_plat} is not the live panel on this box; adopting ${_new_plat} (distro number diverged source vs target)"
  _nup=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp -N -B ${_hdb} -e "UPDATE hosting_platform SET \
    publish_path='${_new_src_form}' WHERE publish_path='${_db_plat}'; \
    SELECT ROW_COUNT();" 2>/dev/null | tail -1)
  if [ "${_nup}" = "1" ]; then
    echo "PANEL-NOTE: hostmaster platform row repointed ${_db_plat} -> ${_new_src_form} in ${_hdb} (rows=1)"
    _xcopy_panel_context_name "${_hdb}" "$(_xcopy_panel_platform_name "${_dest_root}" "${_new_plat}")"
    return 0
  fi
  echo "ALRT: panel platform repoint matched ${_nup:-no} row(s) in ${_hdb} -- the panel would 404 after the rename"
  return 1
}

### The name this account's next upgrade registers on its panel platform:
### the platform its own hostmaster alias here references (platform_hostmaster
### until the panel's first upgrade, platform_<NNN> after it), when that
### platform's alias names the live panel dir $2; else platform_<NNN> of $2.
### $1 is the account root. Its hostmaster alias is the target's own (xcopy
### keeps it); a platform alias there can be the source's copy, so its root
### must name $2.
_xcopy_panel_platform_name() {
  local _ref _root
  _ref=$(_xcopy_read_in "${1}/.drush" hostmaster.alias.drushrc.php \
    | sed -n "s/.*'platform' => '@\([^']*\)'.*/\1/p" | head -1)
  case "${_ref}" in
    platform_*) ;;
    *) _ref="" ;;
  esac
  case "${_ref}" in *[!A-Za-z0-9_]*) _ref="" ;; esac
  if [ -n "${_ref}" ]; then
    _root=$(_xcopy_read_in "${1}/.drush" "${_ref}.alias.drushrc.php" \
      | sed -n "s/.*'root' => '\([^']*\)'.*/\1/p" | head -1)
    if [ "${_root%/}" = "${2}" ]; then
      echo "${_ref}"
      return 0
    fi
  fi
  echo "platform_$(basename "${2}")"
}

### The repointed panel platform takes the context name this account's
### hostmaster alias here references for its panel platform (platform_<NNN>,
### or platform_hostmaster while the panel is still on its install platform:
### _xcopy_panel_platform_name), the one the panel's next upgrade registers on
### it in its resume. An aged source panel can hold that name on a platform
### it deleted long ago: a deleted node keeps its context row. The panel's
### register releases such a holder itself when another node needs the name
### (a gone node, a deleted site, server or platform no live site runs on),
### and the resume moves the panel's site record whatever happens to the
### name; a holder that is live keeps the name, the new platform keeps the
### one the panel gave it, and the resume reports the naming error. The row
### is still dropped here, so the first upgrade on this box starts clean.
### Mirror of xmass's panel repoint (kept separate by design): a deleted
### holder's leftover context is dropped and the live platform takes the
### name; a holder that is not a deleted platform keeps it, the live
### platform keeps its own, and an ALRT says what the next upgrade does, as
### one does for a write that fails.
_xcopy_panel_context_name() {
  local _hdb="$1" _name="$2" _pn _holder _hst
  case "${_name}" in
    platform_*) ;;
    *) return 0 ;;
  esac
  case "${_name}" in *[!A-Za-z0-9_]*) return 0 ;; esac
  _pn=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp -N -B ${_hdb} -e "SELECT s.platform FROM hosting_context c \
    JOIN hosting_site s ON s.nid=c.nid JOIN node n ON n.nid=s.nid AND n.vid=s.vid \
    WHERE c.name='hostmaster' LIMIT 1" 2>/dev/null)
  case "${_pn}" in
    ''|*[!0-9]*)
      echo "ALRT: cannot read the hostmaster site's platform in ${_hdb}: its context name left as it is"
      return 0
      ;;
  esac
  _holder=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp -N -B ${_hdb} -e "SELECT nid FROM hosting_context \
    WHERE name='${_name}' AND nid<>${_pn} LIMIT 1" 2>/dev/null)
  case "${_holder}" in *[!0-9]*) _holder="" ;; esac
  if [ -n "${_holder}" ]; then
    _hst=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
      --protocol=tcp -N -B ${_hdb} -e "SELECT p.status FROM hosting_platform p \
      JOIN node n ON n.nid=p.nid AND n.vid=p.vid WHERE p.nid=${_holder} LIMIT 1" 2>/dev/null)
    if [ "${_hst}" = "-2" ]; then
      if mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
        --protocol=tcp ${_hdb} -e "DELETE FROM hosting_context \
        WHERE nid=${_holder} AND name='${_name}'" 2>/dev/null; then
        echo "PANEL-NOTE: dropped leftover context ${_name} of deleted platform ${_holder}"
        _holder=""
      else
        echo "ALRT: the leftover context ${_name} of deleted platform ${_holder} could not be dropped in ${_hdb}: the account's next Octopus upgrade releases it itself, if its panel carries the current hosting"
        return 0
      fi
    fi
  fi
  if [ -n "${_holder}" ]; then
    echo "ALRT: context name ${_name} is held by platform ${_holder}, which is not a deleted platform: platform ${_pn} keeps its own name, and the account's next Octopus upgrade keeps the panel on the name it gives the new platform and reports the clash"
    return 0
  fi
  if mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp ${_hdb} -e "UPDATE hosting_context SET name='${_name}' \
    WHERE nid=${_pn}" 2>/dev/null; then
    echo "PANEL-NOTE: platform ${_pn} context renamed to ${_name}"
  else
    echo "ALRT: platform ${_pn} could not take the context name ${_name} in ${_hdb}: if a live platform holds that name, the account's next Octopus upgrade keeps the panel on the name it gives the new platform and reports the clash"
  fi
  return 0
}

# The db_name line of the panel site $1's drushrc.php, as found: read inside
# the real site directory, so a link or a FIFO at the name, or a link in the
# account's part of the path, gives nothing. The callers keep only
# [a-zA-Z0-9_] of it.
_xcopy_panel_db_line() {
  _xcopy_read_in "${1}" drushrc.php \
    | grep "options\['db_name'\] = " \
    | cut -d: -f2 \
    | awk '{ print $3}' \
    | sed "s/[\,';]//g"
}

# What import needs before it touches anything: the account installed here,
# the transferred panel dump, the source hostname export recorded (the
# rename pins OLD from it; this box's own server_master alias names this
# box), and a hostmaster alias naming a panel site this box really has,
# whose drushrc.php names the panel database. Each gap used to skip the
# whole panel import silently and still exit 0. Refused here instead,
# before cron, chattr or any file of the account is changed.
_xcopy_import_precheck() {
  local _why="" _hdb=""
  if [ ! -e "${_USR}/config/includes/nginx_vhost_common.conf" ]; then
    _why="${_THIS_HM_USER} is not installed on this box; run 'xcopy create ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}' on the source first"
  elif [ ! -e "${_USR}/src/prev_hostmaster.sql" ]; then
    _why="${_USR}/src/prev_hostmaster.sql is missing; export and transfer have not completed"
  elif [ -z "$(_xcopy_read_in "${_USR}/log" sourcefqdn.txt | tr -cd 'a-zA-Z0-9.-')" ]; then
    _why="${_USR}/log/sourcefqdn.txt is missing or empty; on the source remove src/prev_hostmaster.sql, log/exported.pid and log/transferred.pid of ${_oct}, then export and transfer again"
  elif [ -z "${_THIS_HM_SITE}" ] || [ ! -e "${_THIS_HM_SITE}/drushrc.php" ]; then
    _why="the hostmaster alias names ${_THIS_HM_SITE:-no site_path}, which has no drushrc.php on this box"
  else
    _hdb="$(_xcopy_panel_db_line "${_THIS_HM_SITE}")"
    _hdb="${_hdb//[^a-zA-Z0-9_]/}"
    if [ -z "${_hdb}" ]; then
      _why="${_THIS_HM_SITE}/drushrc.php names no panel database (no db_name line, or not a regular file inside a real directory)"
    fi
  fi
  [ -z "${_why}" ] && return 0
  echo "ERROR: import for ${_oct}: ${_why}"
  echo "ERROR: nothing was imported and nothing on this box was changed; fix the cause and re-run"
  return 1
}

# The source's web-group policy, seeded into the new account's cnf on the
# target before its install, so the arm that install runs (INIT) leaves the
# account alone there (_WEB_GROUP=NO, the opt-out) or takes it to phase A
# only (_WEB_GROUP=A, the --phase-a pin): the source's value as a plain
# line (the file made, root 0600, when absent), a _WEB_GROUP line in any
# form removed when the source has neither. Only while the name is free
# there: otherwise the install refuses it, and the line would land in
# another account's cnf. What was written is taken back when the install
# does not happen, unless the account is there by then (the install made
# it before it failed) or the connection was lost during the install, which
# may go on and make it. A line already there as the seed would write it
# (found) was put before this run, by hand or by a create whose connection
# was lost: no note tells the two apart, so it stays, and a failed install
# names it. The cnf there is read and rewritten as text: a NUL byte costs
# none of its lines, and its NUL bytes are dropped first, as the Octopus pass
# drops them (_satellite_cnf_nul_heal).
# 1 = account here 2 = account on the target 3 = target
_XCOPY_WG_SEED=""
_XCOPY_WG_SEEDV=""
_xcopy_wg_seed() {
  local _v
  _XCOPY_WG_SEED=""
  _v=$(_web_group_policy "/root/.${1}.octopus.cnf")
  case "${_v}" in
    NO|A) ;;
    *) _v=- ;;
  esac
  _XCOPY_WG_SEEDV="${_v}"
  # the names expand here on purpose: the remote side gets them as text
  # shellcheck disable=SC2029
  _XCOPY_WG_SEED=$(ssh root@"${3}" "getent passwd ${2} > /dev/null 2>&1 && exit 0
    _c=/root/.${2}.octopus.cnf
    [ -f \${_c} ] && [ ! -L \${_c} ] && [ \"\$(tr -d '\\000' < \${_c} | wc -c)\" != \"\$(wc -c < \${_c})\" ] \
      && { rm -f -- \${_c}.nulheal; { perl -0777 -pe 's/(?<=[^\\n\\0])\\0+/\\n/g; tr/\\0//d' < \${_c} > \${_c}.nulheal && chmod --reference=\${_c} \${_c}.nulheal && mv -f \${_c}.nulheal \${_c}; } || rm -f -- \${_c}.nulheal; }
    _re='^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP='
    if [ ${_v} != - ]; then
      if [ ! -e \${_c} ]; then
        ( umask 077; printf '_WEB_GROUP=${_v}\\n' > \${_c} ) && echo made
      elif [ \"\$(grep -aE \"\${_re}\" \${_c} | tail -n 1)\" != '_WEB_GROUP=${_v}' ]; then
        rm -f -- \${_c}.wgseed
        ( grep -avE \"\${_re}\" \${_c}; [ \$? -le 1 ] || exit 2; printf '_WEB_GROUP=${_v}\\n' ) > \${_c}.wgseed \
          && mv -f \${_c}.wgseed \${_c} && echo line || rm -f -- \${_c}.wgseed
      else
        echo found
      fi
    elif [ -e \${_c} ] && grep -aqE \"\${_re}\" \${_c}; then
      rm -f -- \${_c}.wgseed
      ( grep -avE \"\${_re}\" \${_c}; [ \$? -le 1 ] || exit 2 ) > \${_c}.wgseed \
        && mv -f \${_c}.wgseed \${_c} || rm -f -- \${_c}.wgseed
    fi" 2> /dev/null)
  case "${_XCOPY_WG_SEED}" in
    made|line) echo "INFO: the source's _WEB_GROUP=${_v} put into /root/.${2}.octopus.cnf on ${3} before its install" ;;
  esac
  return 0
}
# 1 = account on the target 2 = target
_xcopy_wg_unseed() {
  case "${_XCOPY_WG_SEED}:${_XCOPY_WG_SEEDV}" in
    made:*)
      # shellcheck disable=SC2029
      ssh root@"${2}" "getent passwd ${1} > /dev/null 2>&1 && exit 0
        rm -f /root/.${1}.octopus.cnf" 2> /dev/null
      ;;
    line:NO|line:A)
      # the seed left its own line as the only _WEB_GROUP one
      # shellcheck disable=SC2029
      ssh root@"${2}" "getent passwd ${1} > /dev/null 2>&1 && exit 0
        _c=/root/.${1}.octopus.cnf; rm -f -- \${_c}.wgseed; ( grep -avE '^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=' \${_c}; [ \$? -le 1 ] || exit 2 ) > \${_c}.wgseed && mv -f \${_c}.wgseed \${_c} || rm -f -- \${_c}.wgseed" 2> /dev/null
      ;;
  esac
  _XCOPY_WG_SEED=""
  return 0
}

# The value the last assignment of setting $2 in cnf $1 gives it, read as
# bash reads the file: export is tolerated, a quoted value ends at its
# closing quote, any other at the first blank or semicolon. Nothing when the
# file assigns it nowhere or cannot be read. A NUL byte in the file (a crash
# can zero-fill its tail) hides no line: grep reads it as text. The passes
# read an account's broker settings with this same text.
_xcopy_dbctl_cnf_last() {
  local _v
  _v=$(grep -aE "^[[:space:]]*(export[[:space:]]+)?${2}=" "${1}" 2> /dev/null | tail -n 1)
  _v="${_v#*=}"
  case "${_v}" in
    \"*) _v="${_v#\"}"; _v="${_v%%\"*}" ;;
    \'*) _v="${_v#\'}"; _v="${_v%%\'*}" ;;
    *) _v="${_v%%[[:space:];]*}" ;;
  esac
  printf '%s' "${_v}"
}

# Whether account $1, its cnf here $2, is kept out of the database broker as
# this box's passes read it: its _DB_BROKER_ARM=NO, or a _DB_BROKER_BORN=NO
# that is its operator's: the account holds no create marker here
# (/root/.<oN>.migration-create.txt, a regular file of root's), so that no
# migration tool put the line, or the seed's note here
# (/root/.<oN>.dbctl-seed.txt, a regular file of root's) says operator, so
# that the line was there before the create, which never takes it back.
# Such an account travels kept out. So does one whose create's line no
# merge has taken back yet (the note says pending or kept, or made or line,
# the release before's words): its source's state is not known here.
_xcopy_dbctl_kept_here() {
  [ "$(_xcopy_dbctl_cnf_last "${2}" _DB_BROKER_ARM)" = "NO" ] && return 0
  [ "$(_xcopy_dbctl_cnf_last "${2}" _DB_BROKER_BORN)" = "NO" ] || return 1
  [ -z "$(find "/root/.${1}.migration-create.txt" -maxdepth 0 -type f -user root 2> /dev/null)" ] && return 0
  [ -n "$(find "/root/.${1}.dbctl-seed.txt" -maxdepth 0 -type f -user root 2> /dev/null)" ] || return 1
  case "$(head -c 64 "/root/.${1}.dbctl-seed.txt" 2> /dev/null)" in
    operator|pending|kept|made|line) return 0 ;;
  esac
  return 1
}

# The source's opt-out of the database broker, seeded into the new account's
# cnf on the target before its install, so an armed target never switches a
# copy of an account its source keeps out (the install's own pass and the
# upgrade pass it chains both run before anything else of the source
# arrives): _DB_BROKER_ARM=NO as a plain line where the source is kept out
# as its passes read it (_xcopy_dbctl_kept_here: its _DB_BROKER_ARM=NO, or
# its operator's _DB_BROKER_BORN=NO; the file made, root 0600, when absent), a
# _DB_BROKER_ARM line in any form removed where it does not. Only while the
# name is free there, as the web group's seed above. What was written is
# taken back when the install does not happen, unless the launcher made the
# account before it failed (that copy keeps the source's NO, as xoct's seed
# stays in an account that was made) or the connection was lost during the
# install, which may go on and make it; a line of the key the seed replaced
# or removed of the target's own cnf comes back with it: the seed's answer
# names those lines (made, line or removed, then the lines), and the unseed
# hands them back. A _DB_BROKER_ARM=NO already there as the seed would
# write it (found) stays, as the web group's found line does. A copy
# carries no switch: one not kept out is switched by an armed target as any
# new account is. The cnf there is read as text: a NUL byte costs no line
# of it, and its NUL bytes are dropped first, as the Octopus pass drops them
# (_satellite_cnf_nul_heal).
# 1 = account here 2 = account on the target 3 = target
_XCOPY_DBA_SEED=""
_XCOPY_DBA_WAS=""
_xcopy_dbarm_seed() {
  local _v=- _out
  _XCOPY_DBA_SEED=""
  _XCOPY_DBA_WAS=""
  _xcopy_dbctl_kept_here "${1}" "/root/.${1}.octopus.cnf" && _v=NO
  # the names expand here on purpose: the remote side gets them as text
  # shellcheck disable=SC2029
  _out=$(ssh root@"${3}" "getent passwd ${2} > /dev/null 2>&1 && exit 0
    _c=/root/.${2}.octopus.cnf
    [ -f \${_c} ] && [ ! -L \${_c} ] && [ \"\$(tr -d '\\000' < \${_c} | wc -c)\" != \"\$(wc -c < \${_c})\" ] \
      && { rm -f -- \${_c}.nulheal; { perl -0777 -pe 's/(?<=[^\\n\\0])\\0+/\\n/g; tr/\\0//d' < \${_c} > \${_c}.nulheal && chmod --reference=\${_c} \${_c}.nulheal && mv -f \${_c}.nulheal \${_c}; } || rm -f -- \${_c}.nulheal; }
    _re='^[[:space:]]*(export[[:space:]]+)?_DB_BROKER_ARM='
    if [ ${_v} = NO ]; then
      if [ ! -e \${_c} ]; then
        ( umask 077; printf '_DB_BROKER_ARM=NO\\n' > \${_c} ) && echo made
        exit 0
      fi
      [ \"\$(grep -aE \"\${_re}\" \${_c} | tail -n 1)\" != '_DB_BROKER_ARM=NO' ] || { echo found; exit 0; }
      _w=line
    else
      [ -e \${_c} ] && grep -aqE \"\${_re}\" \${_c} || exit 0
      _w=removed
    fi
    _was=\$(grep -aE \"\${_re}\" \${_c})
    rm -f -- \${_c}.dbaseed
    ( grep -avE \"\${_re}\" \${_c}; [ \$? -le 1 ] || exit 2
      [ \${_w} = removed ] || printf '_DB_BROKER_ARM=NO\\n' ) > \${_c}.dbaseed \
      && mv -f \${_c}.dbaseed \${_c} && printf '%s\\n' \${_w} \"\${_was}\"
    rm -f \${_c}.dbaseed" 2> /dev/null)
  _XCOPY_DBA_SEED="${_out%%$'\n'*}"
  [[ "${_out}" == *$'\n'* ]] && _XCOPY_DBA_WAS="${_out#*$'\n'}"
  case "${_XCOPY_DBA_SEED}" in
    made|line) echo "INFO: the source's opt-out of the database broker put into /root/.${2}.octopus.cnf on ${3} before its install (_DB_BROKER_ARM=NO)" ;;
  esac
  return 0
}
# 1 = account on the target 2 = target
_xcopy_dbarm_unseed() {
  case "${_XCOPY_DBA_SEED}" in
    made)
      # shellcheck disable=SC2029
      ssh root@"${2}" "getent passwd ${1} > /dev/null 2>&1 && exit 0
        _c=/root/.${1}.octopus.cnf
        [ \"\$(cat \${_c} 2> /dev/null)\" = '_DB_BROKER_ARM=NO' ] && rm -f \${_c}" 2> /dev/null
      ;;
    line|removed)
      # the seed left its own line as the only _DB_BROKER_ARM one, or none;
      # what it replaced or removed goes back, from this side's input
      # shellcheck disable=SC2029
      { [ -z "${_XCOPY_DBA_WAS}" ] || printf '%s\n' "${_XCOPY_DBA_WAS}"; } \
        | ssh root@"${2}" "getent passwd ${1} > /dev/null 2>&1 && exit 0
        _c=/root/.${1}.octopus.cnf
        [ -e \${_c} ] || exit 0
        rm -f -- \${_c}.dbaseed
        ( grep -avE '^[[:space:]]*(export[[:space:]]+)?_DB_BROKER_ARM=' \${_c}; [ \$? -le 1 ] || exit 2
          cat ) > \${_c}.dbaseed && mv -f \${_c}.dbaseed \${_c}
        rm -f \${_c}.dbaseed" 2> /dev/null
      ;;
  esac
  _XCOPY_DBA_SEED=""
  _XCOPY_DBA_WAS=""
  return 0
}
# What the create's seeds leave in the target's cnf of an account its
# install did not make, named line by line: after a lost connection (rc
# 255) every line they put, for a re-run of the create, whose install uses
# them, and the target's own lines the broker's seed replaced or removed; a
# line a seed found there, whatever the rc.
# 1 = account on the target 2 = target 3 = the launcher's rc
_xcopy_seeds_left() {
  local _c="/root/.${1}.octopus.cnf" _l _any=""
  if [ "${3}" = "255" ]; then
    echo "ALRT: the connection to ${2} was lost during the install, which may go on and make ${1} there"
    case "${_XCOPY_WG_SEED}" in
      made|line) echo "ALRT: the web group's seed stays for a re-run of this create: _WEB_GROUP=${_XCOPY_WG_SEEDV} in ${_c}"; _any=1 ;;
    esac
    case "${_XCOPY_DBA_SEED}" in
      made|line) echo "ALRT: the database broker's seed stays for a re-run of this create: _DB_BROKER_ARM=NO in ${_c}"; _any=1 ;;
    esac
    [ -z "${_any}" ] || echo "ALRT: with no re-run and no account ${1} there, remove what stays (a cnf left empty too); a re-run that fails leaves it as well"
    case "${_XCOPY_DBA_SEED}" in
      line|removed)
        if [ -n "${_XCOPY_DBA_WAS}" ]; then
          echo "ALRT: the broker's seed took these lines of the cnf there out; with no re-run, put them back:"
          while IFS= read -r _l; do
            echo "ALRT:   ${_l}"
          done <<< "${_XCOPY_DBA_WAS}"
        fi
        ;;
    esac
  fi
  if [ "${_XCOPY_WG_SEED}" = "found" ]; then
    echo "ALRT: ${_c} on ${2} held _WEB_GROUP=${_XCOPY_WG_SEEDV} before this run (by hand, or from a create whose connection was lost): it stays;"
    echo "ALRT: with no account ${1} there, remove it unless it is yours"
  fi
  if [ "${_XCOPY_DBA_SEED}" = "found" ]; then
    echo "ALRT: ${_c} on ${2} held _DB_BROKER_ARM=NO before this run (by hand, or from a create whose connection was lost): it stays;"
    echo "ALRT: with no account ${1} there, remove it unless it is yours"
  fi
  return 0
}

# A create marks the account it installed on the target: a root-only file
# naming this box and the source account, put only after the install
# succeeded. A later create goes on into an account the target already
# holds (no install) only under that marker, so an unrelated account that
# carries the name never has its LE config and control pids removed. The
# marker also records the account's uid there and the inode and birth time
# of /data/disk/<account>, read on the target when it is put: an account
# made again under the name usually gets its old uid back (adduser hands
# out the lowest free one) but a directory born later, so a marker left from
# the first is not trusted for it; no device number, which can change at a
# reboot. Same text in xoct and xcopy: a marker either tool put is read by
# both.
_xcopy_create_marker() {   # 1 = account on the target
  printf '/root/.%s.migration-create.txt' "${1}"
}
# This box as the marker names it: hostname -f, nothing when that is not
# a hostname.
_xcopy_create_src_host() {
  local _h
  _h="$(hostname -f 2> /dev/null | tr -d '\n')"
  case "${_h}" in
    ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*) return 1 ;;
  esac
  printf '%s' "${_h}"
}
# The one line that tells an operator how to adopt $2 on $3 as the
# account this box created for $1, when it really is.
_xcopy_create_adopt_hint() {   # 1 = account here 2 = account on the target 3 = target 4 = this box
  echo "INFO: to adopt ${2} on ${3} as this migration's, run there: (umask 077; printf '_MIG_CREATE_SRC_HOST=%s\n_MIG_CREATE_SRC_OCT=%s\n_MIG_CREATE_TGT_UID=%s\n_MIG_CREATE_TGT_INODE=%s\n' ${4} ${1} \"\$(id -u ${2})\" \"\$(stat -c %i:%W /data/disk/${2})\" > $(_xcopy_create_marker "${2}"))"
}
# Returns when the target $3 holds no account $2 (no passwd entry: what
# the install itself refuses on), or holds it under a marker naming this
# box and the source account $1, and the uid and /data/disk/$2 the account
# has there now; _XCOPY_CREATE_HELD is YES in that case.
# Anything else refuses the create before it changes anything there: an
# account held without that marker, a marker that cannot be read, a
# probe that answers neither way. Read-only on the target.
_xcopy_create_owner_gate() {   # 1 = account here 2 = account on the target 3 = target
  local _h _f _held _mark _mh _mo _mu _mi _nu _ni _e _said=""
  _XCOPY_CREATE_HELD=""
  if [[ ! "${1}" =~ ^[a-zA-Z0-9._-]+$ ]] || [[ ! "${2}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "ALRT: refusing create: invalid account name '${1}'/'${2}'"
    exit 1
  fi
  if ! _h="$(_xcopy_create_src_host)"; then
    echo "ALRT: refusing create: this box's hostname -f is not a hostname the create marker can name"
    exit 1
  fi
  _f="$(_xcopy_create_marker "${2}")"
  # The create's first contact: a target that does not answer is given up
  # after 15 s, not after the system's TCP connect timeout.
  # Its own words are kept: a target whose key is not the one held here for
  # its address is named as that.
  _e="$(mktemp /tmp/mig-said.XXXXXX 2> /dev/null)" || _e=""
  _held=$(ssh -o ConnectTimeout=15 root@"${3}" "if getent passwd ${2} > /dev/null 2>&1; then echo HELD; else echo FREE; fi" 2> "${_e:-/dev/null}")
  if [ -n "${_e}" ]; then
    _said="$(cat "${_e}" 2> /dev/null)"
    rm -f "${_e}"
  fi
  case "${_held}" in
    FREE) return 0 ;;
    HELD) : ;;
    *)
      if _mig_hostkey_changed "${3}" "${_said}"; then
        echo "ALRT: refusing create: ${3} serves a host key that is not the one this box holds for that address"
        echo "ALRT: (${_MIG_HOSTKEY_SAYS}); make the check named above, forget the old entries here, then run this command again"
        exit 1
      fi
      echo "ALRT: refusing create: could not read whether ${3} holds an account named ${2}"
      exit 1
      ;;
  esac
  # The account's uid and /data/disk/$2 as they are now are printed before
  # the marker, so a first match can only take these real values.
  _mark=$(ssh root@"${3}" "printf '_MIG_CREATE_NOW_UID=%s\n_MIG_CREATE_NOW_INODE=%s\n' \"\$(id -u ${2} 2> /dev/null)\" \"\$(stat -c %i:%W /data/disk/${2} 2> /dev/null)\"; [ -f ${_f} ] && [ ! -L ${_f} ] && [ \"\$(stat -c %u ${_f})\" = 0 ] && timeout 10 dd if=${_f} iflag=nofollow,nonblock,fullblock bs=65536 count=1 status=none" 2> /dev/null)
  _nu=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_NOW_UID=' | cut -d= -f2-)
  _ni=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_NOW_INODE=' | cut -d= -f2-)
  _mh=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_SRC_HOST=' | cut -d= -f2-)
  _mo=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_SRC_OCT=' | cut -d= -f2-)
  _mu=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_TGT_UID=' | cut -d= -f2-)
  _mi=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_TGT_INODE=' | cut -d= -f2-)
  if [ "${_mh}" = "${_h}" ] && [ "${_mo}" = "${1}" ] \
    && [[ "${_nu}" =~ ^[0-9]+$ ]] && [ "${_mu}" = "${_nu}" ] \
    && [[ "${_ni}" =~ ^[0-9]+:[0-9]+$ ]] && [ "${_mi}" = "${_ni}" ]; then
    _XCOPY_CREATE_HELD=YES
    return 0
  fi
  echo "DENY: ${3} already holds an account named ${2} that this migration did not create; nothing was changed there"
  if [ "${_mh}" = "${_h}" ] && [ "${_mo}" = "${1}" ] && [ -n "${_mu}${_mi}" ]; then
    echo "INFO: the create marker there was put for an earlier ${2}: the uid or /data/disk/${2} it records is not the account's now"
  fi
  _xcopy_create_adopt_hint "${1}" "${2}" "${3}" "${_h}"
  exit 1
}
# The marker put on the target $3 for its account $2, installed for the
# source account $1: a fresh root 0600 file written through one no-follow
# handle (_XCOPY_PUT_PL), then renamed over the name. The account's uid and
# the inode and birth time of /data/disk/$2 are read there in the same
# command; no
# marker is put when either cannot be read.
_xcopy_create_mark() {   # 1 = account here 2 = account on the target 3 = target
  local _h _f _ts
  _h="$(_xcopy_create_src_host)" || return 1
  _f="$(_xcopy_create_marker "${2}")"
  _ts="$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2> /dev/null)"
  ssh root@"${3}" "_u=\$(id -u ${2} 2> /dev/null); _i=\$(stat -c %i:%W /data/disk/${2} 2> /dev/null); case \"\${_u}/\${_i}\" in *[!0-9:/]*) exit 1 ;; [0-9]*/[0-9]*:[0-9]*) : ;; *) exit 1 ;; esac; _t=/root/.${2}.migration-create.put.\$\$; rm -f -- \"\${_t}\"; printf '%s\n' '# Put by create: the account this migration installed here.' '_MIG_CREATE_SRC_HOST=${_h}' '_MIG_CREATE_SRC_OCT=${1}' \"_MIG_CREATE_TGT_UID=\${_u}\" \"_MIG_CREATE_TGT_INODE=\${_i}\" '_MIG_CREATE_STAMPED=${_ts}' | perl -e '${_XCOPY_PUT_PL}' \"\${_t}\" 0 0 600 && mv -f -T -- \"\${_t}\" ${_f} && exit 0; rm -f -- \"\${_t}\"; exit 1"
}

###-------------TARGET PHP COVERAGE----###
###
### A copy is served on the target from the account's own control files,
### which the transfer carries: a PHP version in force here that the target
### lacks would silently serve those sites on another PHP there. create
### refuses such a target before anything is installed, every live transfer
### and pretransfer checks again, and a dry one names a choice the target
### would start to honour. The same text as in xoct, prefixes aside.

### Normalise a PHP version token to the dotted form BOA control files use;
### prints nothing for a token that is not a known BOA PHP version.
_mig_php_norm() {
  local _t="${1//[^0-9.]/}"
  case "${_t}" in
    8.6|86) echo 8.6 ;;
    8.5|85) echo 8.5 ;;
    8.4|84) echo 8.4 ;;
    8.3|83) echo 8.3 ;;
    8.2|82) echo 8.2 ;;
    8.1|81) echo 8.1 ;;
    8.0|80) echo 8.0 ;;
    7.4|74) echo 7.4 ;;
    7.3|73) echo 7.3 ;;
    7.2|72) echo 7.2 ;;
    7.1|71) echo 7.1 ;;
    7.0|70) echo 7.0 ;;
    5.6|56) echo 5.6 ;;
  esac
}

### Union of the PHP versions in force for this account, each counted only when
### its PHP is installed here: root's record of the PHP its pool and command
### line run on (_PHP_FPM_VERSION and _PHP_CLI_VERSION in its octopus.cnf,
### which every Octopus pass writes into fpm.info and cli.info where they
### are missing, and the transfer carries those), the account-level
### static/control/{fpm,cli}.info defaults, the per-site column of
### static/control/multi-fpm.info (dotted and shorthand forms both count),
### every line of static/control/cli-per-platform.info and
### fpm-per-platform.info, and the phpNN.info marker that steers the command
### line. The last three are read as websh reads them: the file's first 64 KiB
### and 200 lines, '#' opening a comment, a line counting only as "<folder>
### <version>", the version's digits only; the marker is the highest one whose
### PHP is installed here. A choice naming a PHP this server lacks does nothing
### here and is never required of the target: the account writes these files,
### and one line of its own must not hold the copy back or have a PHP built on
### the target; _mig_php_inert_choices names it before the copy.
_mig_php_here() {
  [ -n "${1}" ] && [ -x "/opt/php${1//./}/bin/php" ]
}
_mig_php_versions_needed() {
  local _u="$1" _f _v _dom _rest _line _k _e _mk="" _txt _n _out=""
  for _k in _PHP_FPM_VERSION _PHP_CLI_VERSION; do
    _v="$(grep -a "^${_k}=" "/root/.${_u##*/}.octopus.cnf" 2> /dev/null | tail -n 1)"
    _v="$(_mig_php_norm "${_v#*=}")"
    _mig_php_here "${_v}" && _out="${_out} ${_v}"
  done
  ### read inside the account's real static/control, never through a link
  ### or into a FIFO put there
  for _f in fpm.info cli.info; do
    _v="$(_mig_php_norm "$(_xcopy_read_in "${_u}/static/control" "${_f}" | tr -d ' \t\r\n')")"
    _mig_php_here "${_v}" && _out="${_out} ${_v}"
  done
  if [ -e "${_u}/static/control/multi-fpm.info" ]; then
    while read -r _dom _v _rest; do
      ### place.holder.dont.remove is manage_ltd_users' filler line, not a
      ### site pin -- counting it would refuse migrations over a version no
      ### site actually uses.
      case "${_dom}" in \#*|""|place.holder.dont.remove) continue ;; esac
      _v="$(_mig_php_norm "${_v}")"
      _mig_php_here "${_v}" && _out="${_out} ${_v}"
    done <<< "$(_xcopy_read_in "${_u}/static/control" multi-fpm.info)"
  fi
  for _f in cli-per-platform.info fpm-per-platform.info; do
    [ -e "${_u}/static/control/${_f}" ] || continue
    _txt=""; _n=0
    _txt="$(_xcopy_read_in "${_u}/static/control" "${_f}" | head -c 65536)"
    while IFS= read -r _line; do
      _n=$(( _n + 1 ))
      [ "${_n}" -gt 200 ] && break
      _line="${_line%%#*}"
      read -r _k _v _rest <<< "${_line}"
      [ -n "${_k}" ] && [ -n "${_v}" ] && [ -z "${_rest}" ] || continue
      _v="$(_mig_php_norm "${_v//[!0-9]/}")"
      _mig_php_here "${_v}" && _out="${_out} ${_v}"
    done <<< "${_txt}"
  done
  if _xcopy_in_real_dir "${_u}/static/control" true; then
    for _e in 56 70 71 72 73 74 80 81 82 83 84 85 86; do
      [ -e "${_u}/static/control/php${_e}.info" ] && [ -x "/opt/php${_e}/bin/php" ] && _mk="${_e}"
    done
  fi
  [ -n "${_mk}" ] && _out="${_out} $(_mig_php_norm "${_mk}")"
  echo "${_out}" | tr ' ' '\n' | sort -u | tr '\n' ' '
}

### Choices that do nothing on this server because it lacks their PHP, and that a
### target with that PHP would start to honour at the cutover: the account-wide fpm.info
### or cli.info, a line of multi-fpm.info, cli-per-platform.info or fpm-per-platform.info,
### and a phpNN.info marker above the highest one in force here (a lower one stays out of
### force wherever it runs).
### One "<x.y> <what>" a row; every name is the account's, so only a plain alphabet
### reaches the operator's console. $1 = the account's directory.
_mig_php_inert_choices() {
  local _u="$1" _f _v _nn _dom _rest _line _k _e _mk=0 _txt _n
  for _f in fpm.info cli.info; do
    _v="$(_mig_php_norm "$(_xcopy_read_in "${_u}/static/control" "${_f}" | tr -d ' \t\r\n')")"
    [ -n "${_v}" ] && [ ! -x "/opt/php${_v//./}/bin/php" ] || continue
    echo "${_v} its ${_f}"
  done
  if [ -e "${_u}/static/control/multi-fpm.info" ]; then
    while read -r _dom _v _rest; do
      case "${_dom}" in \#*|""|place.holder.dont.remove) continue ;; esac
      _v="$(_mig_php_norm "${_v}")"
      [ -n "${_v}" ] && [ ! -x "/opt/php${_v//./}/bin/php" ] || continue
      _dom="${_dom//[^A-Za-z0-9._~\/-]/?}"
      echo "${_v} the multi-fpm.info line for ${_dom:0:120}"
    done <<< "$(_xcopy_read_in "${_u}/static/control" multi-fpm.info)"
  fi
  for _f in cli-per-platform.info fpm-per-platform.info; do
    [ -e "${_u}/static/control/${_f}" ] || continue
    _n=0
    _txt="$(_xcopy_read_in "${_u}/static/control" "${_f}" | head -c 65536)"
    while IFS= read -r _line; do
      _n=$(( _n + 1 ))
      [ "${_n}" -gt 200 ] && break
      _line="${_line%%#*}"
      _k=""; _v=""; _rest=""
      read -r _k _v _rest <<< "${_line}"
      [ -n "${_k}" ] && [ -n "${_v}" ] && [ -z "${_rest}" ] || continue
      _v="$(_mig_php_norm "${_v//[!0-9]/}")"
      [ -n "${_v}" ] && [ ! -x "/opt/php${_v//./}/bin/php" ] || continue
      _k="${_k//[^A-Za-z0-9._~\/-]/?}"
      echo "${_v} line ${_n} of ${_f} (${_k:0:120})"
    done <<< "${_txt}"
  done
  _xcopy_in_real_dir "${_u}/static/control" true || return 0
  for _e in 56 70 71 72 73 74 80 81 82 83 84 85 86; do
    [ -e "${_u}/static/control/php${_e}.info" ] || continue
    if [ -x "/opt/php${_e}/bin/php" ]; then
      _mk="${_e}"
    fi
  done
  for _e in 56 70 71 72 73 74 80 81 82 83 84 85 86; do
    [ -e "${_u}/static/control/php${_e}.info" ] && [ ! -x "/opt/php${_e}/bin/php" ] && [ "${_e}" -gt "${_mk}" ] || continue
    _nn="$(_mig_php_norm "${_e}")"
    echo "${_nn} the php${_e}.info marker"
  done
}

### Where an account-wide fpm.info ($1 = fpm) or cli.info ($1 = cli) naming the
### PHP $2 lands on a server whose installed versions are $3 (" 8.3 8.4 "): $2
### itself when installed, else the first installed one of its fallback chain.
### The chain is the ltd worker's (manage_ltd_users.sh: fpm_fallback and
### fallback), after the Octopus pass's own ladder (satellite.sh.inc), which runs
### first on a moved account and writes what it finds back into the file: for
### fpm.info 8.0 and 7.4 that ladder takes 8.1 before the worker's 8.3. With
### nothing of the chain installed, the web side keeps the version the account
### runs ($4) where it is installed, else 8.4 (the worker's default pool); the
### command line runs the server's own default PHP ($5, /usr/bin/php). On a
### target the Octopus pass writes an unresolved version into the cnf itself,
### so there the web side lands on 8.4 ($4 empty).
_mig_php_lands() {
  local _k="$1" _v="$2" _have="$3" _cur="$4" _def="$5" _chain="" _c
  case "${_v}" in
    8.6) _chain="8.5 8.4 8.3 8.2 8.1" ;;
    8.5) _chain="8.4 8.3 8.2 8.1" ;;
    8.4) _chain="8.3 8.2 8.1" ;;
    8.3) _chain="8.2 8.1" ;;
    8.2) _chain="8.1 8.3" ;;
    8.1) _chain="8.2 8.3" ;;
    8.0|7.4) if [ "${_k}" = "fpm" ]; then _chain="8.1 8.3"; else _chain="8.1"; fi ;;
    7.3|7.2|7.1|7.0|5.6) _chain="7.4" ;;
  esac
  case "${_have}" in *" ${_v} "*) echo "${_v}"; return 0 ;; esac
  for _c in ${_chain}; do
    case "${_have}" in *" ${_c} "*) echo "${_c}"; return 0 ;; esac
  done
  if [ "${_k}" = "fpm" ]; then
    case "${_have}" in *" ${_cur:-none} "*) echo "${_cur}"; return 0 ;; esac
    echo 8.4
  else
    echo "${_def}"
  fi
}

### An account-wide fpm.info or cli.info naming a PHP that neither server has
### lands on its fallback on each (_mig_php_lands): named when the two differ,
### since the account then moves to another PHP at the cutover with nothing
### said. $1 = the account, $2 = the target, $3 = alrt or deny, $4 = the
### version, $5 = what names it, $6 = the versions the target has or a fix
### installs there, $7 = the account's directory. A phpNN.info marker in force
### outranks cli.info (websh), and the marker rows name its own moves.
_xcopy_php_lands_report() {
  local _acct="$1" _t="$2" _how="$3" _v="$4" _w="$5" _there="$6" _u="$7" _k _cur="" _here=" " _e _a _b _dh="" _dt=""
  case "${_w}" in
    "its fpm.info") _k=fpm ;;
    "its cli.info") _k=cli ;;
    *) return 0 ;;
  esac
  ### no answer from the target: never a guess
  [ -n "${_there// /}" ] || return 0
  for _e in 5.6 7.0 7.1 7.2 7.3 7.4 8.0 8.1 8.2 8.3 8.4 8.5 8.6; do
    [ -x "/opt/php${_e//./}/bin/php" ] && _here="${_here}${_e} "
  done
  if [ "${_k}" = "fpm" ]; then
    _cur="$(grep -a "^_PHP_FPM_VERSION=" "/root/.${_acct}.octopus.cnf" 2> /dev/null | tail -n 1)"
    _cur="$(_mig_php_norm "${_cur#*=}")"
  else
    ### a marker in force here or there: cli.info does nothing on that side
    if _xcopy_in_real_dir "${_u}/static/control" true; then
      for _e in 5.6 7.0 7.1 7.2 7.3 7.4 8.0 8.1 8.2 8.3 8.4 8.5 8.6; do
        [ -e "${_u}/static/control/php${_e//./}.info" ] || continue
        case "${_here} ${_there} " in *" ${_e} "*) return 0 ;; esac
      done
    fi
    ### the server's own default PHP, /usr/bin/php, on each side
    _dh="$(readlink -f /usr/bin/php 2> /dev/null)"
    _dh="${_dh#*/php}"
    _dh="$(_mig_php_norm "${_dh%%/*}")"
    _dt="$(ssh root@"${_t}" 'readlink -f /usr/bin/php' 2> /dev/null)"
    _dt="${_dt#*/php}"
    _dt="$(_mig_php_norm "${_dt%%/*}")"
    [ -n "${_dt}" ] || return 0
  fi
  _a="$(_mig_php_lands "${_k}" "${_v}" "${_here}" "${_cur}" "${_dh}")"
  _b="$(_mig_php_lands "${_k}" "${_v}" " ${_there} " "" "${_dt}")"
  [ "${_a}" != "${_b}" ] || return 0
  _a="${_a:+PHP ${_a}}"
  _b="${_b:+PHP ${_b}}"
  if [ "${_how}" = "deny" ]; then
    echo "DENY: ${_acct}: ${_w} names PHP ${_v}, which neither server has, so it runs on ${_a:-the PHP it runs now} here and would run on ${_b:-the PHP it runs now} on ${_t} from the cutover. Write the PHP it should run on in it."
    _XCOPY_NOT_CLEAN=YES
  else
    echo "ALRT: ${_acct}: ${_w} names PHP ${_v}, which neither server has, so it runs on ${_a:-the PHP it runs now} here and would run on ${_b:-the PHP it runs now} on ${_t} from the cutover."
  fi
}

### The tree the TARGET runs, for target-side barracuda/octopus verbs; the
### local _tRee belongs to THIS box and a cross-tree migration must not push
### the source's tree through the target's licence gate.
_mig_target_tree() {
  local _t="$1" _tt
  _tt=$(ssh root@"${_t}" "boa info 2>/dev/null" 2>/dev/null \
    | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
    | tail -1 \
    | grep -oE '(dev|lts|pro)$')
  if [ -z "${_tt}" ]; then
    echo "ALRT: could not detect the BOA tree on ${_t}; falling back to local '${_tRee}'" >&2
    _tt="${_tRee}"
  fi
  echo "${_tt}"
}

### What the target would start to honour (_mig_php_inert_choices), named before the
### copy: on a dry run it holds the --live back, on a live one it is an alert, since the
### account may mean it. $1 = the account's directory, $2 = the target, $3 = alrt or deny,
### $4 = versions a --fix-php run installs there.
_xcopy_php_inert_report() {
  local _u="$1" _t="$2" _how="$3" _fix=" ${4:-} " _acct _rows _row _v _w _have
  _acct="$(basename "${_u}")"
  _rows="$(_mig_php_inert_choices "${_u}")"
  [ -n "${_rows}" ] || return 0
  _have=" $(ssh root@"${_t}" 'for _e in 5.6 7.0 7.1 7.2 7.3 7.4 8.0 8.1 8.2 8.3 8.4 8.5 8.6; do [ -x "/opt/php${_e//./}/bin/php" ] && echo "${_e}"; done' 2>/dev/null | tr '\n' ' ') "
  while IFS= read -r _row; do
    _v="${_row%% *}"
    _w="${_row#* }"
    case "${_have}${_fix}" in
      *" ${_v} "*) ;;
      *)
        _xcopy_php_lands_report "${_acct}" "${_t}" "${_how}" "${_v}" "${_w}" "${_have}${_fix}" "${_u}"
        continue ;;
    esac
    if [ "${_how}" = "deny" ]; then
      echo "DENY: ${_acct}: ${_w} names PHP ${_v}, which this server lacks, so it does nothing here; on ${_t} it applies from the cutover. Delete it, or install PHP ${_v} here."
      _XCOPY_NOT_CLEAN=YES
    else
      echo "ALRT: ${_acct}: ${_w} names PHP ${_v}, which this server lacks, so it does nothing here; on ${_t} it applies from the cutover."
    fi
  done <<< "${_rows}"
}

### Verify every needed PHP version is installed on the target -- the same
### /opt/phpNN/bin/php probe BOA's own fallback ladders use. A missing version
### is fatal by default, because served-on-the-wrong-PHP is the silent failure
### this whole step exists to prevent. With --fix-php the missing versions are
### appended to the target's _PHP_MULTI_INSTALL and one barracuda system run
### is driven remotely to build them (a full system pass: a few minutes).
### --fix-php is a create option, so only create offers it.
_xcopy_php_coverage_gate() {
  local _u="$1" _t="$2" _need _v _sv _miss=""
  _need="$(_mig_php_versions_needed "${_u}")"
  if [ -z "${_need// /}" ]; then
    _xcopy_php_inert_report "${_u}" "${_t}" alrt
    return 0
  fi
  echo "INFO: PHP versions required by $(basename "${_u}"): ${_need}"
  for _v in ${_need}; do
    _sv=${_v//[^0-9]/}
    if ! ssh root@"${_t}" "[ -x /opt/php${_sv}/bin/php ]" 2>/dev/null; then
      _miss="${_miss} ${_v}"
    fi
  done
  _miss="${_miss## }"
  if [ "${_XCOPY_FIX_PHP}" = "YES" ]; then
    _xcopy_php_inert_report "${_u}" "${_t}" alrt "${_miss}"
  else
    _xcopy_php_inert_report "${_u}" "${_t}" alrt
  fi
  [ -z "${_miss}" ] && return 0
  echo "ALRT: target ${_t} lacks PHP version(s) required by $(basename "${_u}"): ${_miss}"
  if [ "${_XCOPY_FIX_PHP}" = "YES" ]; then
    _mig_fix_target_php "${_t}" "${_miss}" || return 1
    for _v in ${_miss}; do
      _sv=${_v//[^0-9]/}
      if ! ssh root@"${_t}" "[ -x /opt/php${_sv}/bin/php ]" 2>/dev/null; then
        echo "ERROR: PHP ${_v} still missing on ${_t} after the fix run"
        return 1
      fi
    done
    return 0
  fi
  echo "ERROR: a pinned PHP version missing on the target means every affected site"
  echo "ERROR: silently falls back to a different PHP after migration."
  echo "ERROR: Fix on the target: add '${_miss}' to _PHP_MULTI_INSTALL in /root/.barracuda.cnf"
  echo "ERROR: and run: barracuda up-<tree> system noscreen"
  [ "${_cmd:-}" = "create" ] \
    && echo "ERROR: Or re-run this command with --fix-php to do both automatically."
  return 1
}

### Extend the target's _PHP_MULTI_INSTALL with the missing versions and run
### one barracuda system pass there to build them. Idempotent: versions
### already listed are not repeated, and barracuda itself is safe to re-run.
_mig_fix_target_php() {
  local _t="$1" _add="$2" _cur _new _v _nv _tree _rc
  # Normalise the fetched value token by token: the raw line may carry an
  # inline comment or quotes, and anything not a known PHP version must
  # never reach the remote root shell that rewrites the cnf.
  _cur=$(ssh root@"${_t}" "grep '^_PHP_MULTI_INSTALL=' /root/.barracuda.cnf 2>/dev/null" 2>/dev/null \
    | tail -1 | sed -E 's/^[^=]*=//; s/#.*$//; s/"//g' | tr -d '\n')
  _new=""
  for _v in ${_cur} ${_add}; do
    _nv="$(_mig_php_norm "${_v}")"
    [ -n "${_nv}" ] || continue
    case " ${_new} " in
      *" ${_nv} "*) : ;;
      *) _new="${_new} ${_nv}" ;;
    esac
  done
  _new="${_new## }"
  if [ -z "${_new}" ]; then
    echo "ALRT: computed empty _PHP_MULTI_INSTALL for ${_t}; refusing"
    return 1
  fi
  ### Belt-and-braces before the value reaches a remote sed: it is built only
  ### from _mig_php_norm output, so it can hold nothing but digits, dots and
  ### spaces -- assert that rather than trust it.
  case "${_new}" in
    *[!0-9.\ ]*) echo "ALRT: refusing to write a non-version _PHP_MULTI_INSTALL value"; return 1 ;;
  esac
  echo "INFO: setting _PHP_MULTI_INSTALL=\"${_new}\" on ${_t}"
  ### Rewrite in place (keeps the line with the comment that documents it);
  ### append only when the key is absent. The temp+size guard means a failed
  ### write can never blank the box's barracuda.cnf.
  ssh root@"${_t}" "_m=\$(stat -c %a /root/.barracuda.cnf 2>/dev/null); \
    if grep -q '^_PHP_MULTI_INSTALL=' /root/.barracuda.cnf; then \
      sed 's|^_PHP_MULTI_INSTALL=.*|_PHP_MULTI_INSTALL=\\\"${_new}\\\"|' \
        /root/.barracuda.cnf > /root/.barracuda.cnf.phpnew; \
    else \
      cp -af /root/.barracuda.cnf /root/.barracuda.cnf.phpnew \
      && echo '_PHP_MULTI_INSTALL=\"${_new}\"' >> /root/.barracuda.cnf.phpnew; \
    fi; \
    [ -s /root/.barracuda.cnf.phpnew ] \
    && chmod \${_m:-600} /root/.barracuda.cnf.phpnew \
    && mv -f /root/.barracuda.cnf.phpnew /root/.barracuda.cnf" \
    || { echo "ERROR: could not update _PHP_MULTI_INSTALL on ${_t}"; return 1; }
  _tree="$(_mig_target_tree "${_t}")"
  case "${_tree}" in
    dev|lts|pro) : ;;
    *) echo "ALRT: invalid tree token '${_tree}' -- refusing the remote barracuda run"; return 1 ;;
  esac
  echo "INFO: driving 'barracuda up-${_tree} system noscreen' on ${_t} to build the missing PHP set;"
  echo "INFO: this is a full system pass and typically takes a few minutes"
  ssh root@"${_t}" "barracuda up-${_tree} system noscreen"
  _rc=$?
  # 3: the pass ran to its end WITH ERRORS (its log on the target says
  # why); what this step needs is checked by the caller right after
  if [ "${_rc}" = "3" ]; then
    echo "WARN: barracuda system run on ${_t} completed WITH ERRORS; checking the PHP versions it was run for"
  elif [ "${_rc}" != "0" ]; then
    echo "ERROR: barracuda system run on ${_t} returned ${_rc}"
    return 1
  fi
  return 0
}

###-------------SHELL CREDENTIALS----###
###
### Mirrored from xoct (bodies identical with the prefixes swapped).
###
### Shell text the target expands to the uid the login $1.ftp of this box
### lands on there when a copy maps owners by name: the target's uid for the
### name, else this box's uid. Only the login's: the files re-asserted with
### it (the PHP pins, the password store) are the login's own. Empty when it
### has no uid here.
_xcopy_landed_uids_sh() {
  local _n="${1}.ftp" _i
  [[ "${1}" =~ ^[A-Za-z0-9._-]+$ ]] || return 0
  _i="$(id -u -- "${_n}" 2> /dev/null)"
  [[ "${_i}" =~ ^[0-9]+$ ]] || return 0
  printf '%s' "\$(id -u -- ${_n} 2> /dev/null || echo ${_i})"
}
### The regular file ./$1 of the current (pinned) directory copied, forced
### (no -u), to the same name in the real directory $3 on the target $2, $4
### the caller's rsync error option. A link is never carried and neither end
### resolves a name on its path through a link the account put there. Nothing
### travels when ./$1 is not a regular file.
_xcopy_put_file_remote_here() {
  [ -f "./${1}" ] && [ ! -L "./${1}" ] || return 0
  _xcopy_rsync -aEAX --no-links ${4} \
    --rsync-path="$(_xcopy_rsync_path_in "${3}")" -e ssh \
    "./${1}" "root@${2}:./${1}"
}
### The regular files of the current (pinned) sub-account password store of
### the account $1, each put under the name it takes for the account $2
### into the real store directory on the target $3: a link is never sent,
### and the receiver never writes through one. The new name is read by a
### shell on the target (rsync before 3.2.4 sends it unescaped), so a name
### that is not shell-safe is refused.
_xcopy_users_put_here() {
  local _e _n
  for _e in ./*; do
    [ -f "${_e}" ] && [ ! -L "${_e}" ] || continue
    _n="${_e#./}"
    case "${_n}" in
      ''|-*|*[!A-Za-z0-9._@+,=-]*)
        echo "ALRT: sub-account password store entry $(printf '%q' "${_n}") is not a shell-safe name -- not carried"
        continue
        ;;
    esac
    _n="${_n#"${1}".}"
    # shellcheck disable=SC2086
    _xcopy_rsync -aEAX --no-links ${_ieni} \
      --rsync-path="$(_xcopy_rsync_path_mk_in "/home/${2}.ftp/users")" -e ssh \
      "${_e}" "root@${3}:./${2}.${_n}"
  done
}
### Whether the sub-user $1 has a .ssh to carry: a real directory, or none
### (quietly); one that is not a real directory is reported and left.
_xcopy_subuser_ssh_ok() {
  [ -e "/home/${1}/.ssh" ] || [ -L "/home/${1}/.ssh" ] || return 1
  _xcopy_in_real_dir "/home/${1}/.ssh" true && return 0
  echo "ALRT: /home/${1}/.ssh is not a real directory -- not followed; its keys not carried"
  return 1
}
### Carry the client shell identity, so the copy keeps the client's own
### logins: the main <acct>.ftp shadow hash and log/pass.txt (kept consistent
### as a pair), the sub-account password store /home/<acct>.ftp/users (whose
### carried entries manage_ltd_users honours at sub-user creation), and each
### existing sub-user's shadow hash and .ssh where the target user already
### exists (later passes converge the rest). LIVE operations only -- never
### call this from a DRY path.
_xcopy_sync_shell_credentials() {
  local _src="$1" _dst="$2" _t="$3"
  local _sUsr="/data/disk/${_src}" _dUsr="/data/disk/${_dst}"
  local _hash _d _n _e _set=NO
  _hash=$(getent shadow "${_src}.ftp" 2>/dev/null | cut -d: -f2)
  if [ -n "${_hash}" ] && [ "${_hash}" != "*" ] && [ "${_hash}" != "!" ]; then
    if ssh root@"${_t}" "getent passwd ${_dst}.ftp" &> /dev/null; then
      if printf '%s.ftp:%s\n' "${_dst}" "${_hash}" | ssh root@"${_t}" "chpasswd -e"; then
        _set=YES
        echo "INFO: carried ${_src}.ftp shell/SFTP password to ${_dst}.ftp on ${_t}"
      else
        echo "ALRT: could not set the carried password for ${_dst}.ftp on ${_t}"
      fi
    else
      echo "ALRT: user ${_dst}.ftp missing on ${_t}; password not carried yet (re-run converges)"
    fi
  fi
  ### pass.txt travels ONLY when the paired hash actually landed: it is what
  ### the client is shown, and shipping it after a failed chpasswd would
  ### advertise a password that does not work. A re-run converges both.
  ### log/ is oN's on both boxes: a regular file only, from the real
  ### directory into the real directory.
  if [ "${_set}" = "YES" ] && [ -e "${_sUsr}/log/pass.txt" ]; then
    _xcopy_in_real_dir "${_sUsr}/log" _xcopy_put_file_remote_here \
      pass.txt "${_t}" "${_dUsr}/log" "${_ieni}"
  elif [ -e "${_sUsr}/log/pass.txt" ]; then
    echo "ALRT: NOT carrying log/pass.txt for ${_dst} -- the shadow hash was not set on ${_t}"
  fi
  ### The store is keyed by FULL sub-user name, so a rename must rewrite the
  ### entry filenames -- an rsync of the directory would land <src>-named
  ### files that manage_ltd_users never looks for on the target. The store
  ### is the account's on both boxes: its regular files are sent from inside
  ### the real directory into the real one, and the owner and modes are set
  ### there without following a link put at any name.
  if [ -e "/home/${_src}.ftp/users" ] || [ -L "/home/${_src}.ftp/users" ]; then
    if _xcopy_in_real_dir "/home/${_src}.ftp/users" true; then
      ssh root@"${_t}" "mkdir -p /home/${_dst}.ftp/users" &> /dev/null
      _xcopy_in_real_dir "/home/${_src}.ftp/users" \
        _xcopy_users_put_here "${_src}" "${_dst}" "${_t}"
      ### The group is the account's group ON THE TARGET (its own once
      ### converted there, the box-wide one until then), asked of the target
      ### itself: the two boxes are in different states for the length of a
      ### rollout. The directory is the one this shell holds ("."); each
      ### entry is re-asserted through a no-follow handle, only when it is a
      ### regular file with one link that is already the login's, or the
      ### owner the copy of the source's store lands on there, so a hard link
      ### to another file, or a root-only file (log/pass.txt) renamed into the
      ### store, is never handed over or chmodded.
      _xcopy_remote_in "${_t}" "/home/${_dst}.ftp/users" \
        "_g=\$(id -gn ${_dst} 2>/dev/null); [ \"\$_g\" = ${_dst} ] || _g=users; chown -- ${_dst}.ftp:\$_g . 2>/dev/null; chmod 700 .; _ro ${_dst}.ftp:\$_g 600 \"$(_xcopy_landed_uids_sh "${_src}")\" ./*; true" &> /dev/null
    else
      echo "ALRT: /home/${_src}.ftp/users is not a real directory -- not followed; its password store not carried"
    fi
  fi
  for _d in "${_sUsr}"/clients/*/; do
    [ -d "${_d}" ] || continue
    _n=$(basename "${_d}")
    # the name is read by a shell on the target
    case "${_n}" in
      ''|-*|*[!A-Za-z0-9._@+,=-]*) continue ;;
    esac
    getent passwd "${_src}.${_n}" &> /dev/null || continue
    _hash=$(getent shadow "${_src}.${_n}" 2>/dev/null | cut -d: -f2)
    [ -n "${_hash}" ] && [ "${_hash}" != "*" ] && [ "${_hash}" != "!" ] || continue
    if ssh root@"${_t}" "getent passwd ${_dst}.${_n}" &> /dev/null; then
      if printf '%s.%s:%s\n' "${_dst}" "${_n}" "${_hash}" | ssh root@"${_t}" "chpasswd -e"; then
        echo "INFO: carried sub-account password for ${_dst}.${_n} on ${_t}"
      else
        echo "ALRT: could not carry the sub-account password for ${_dst}.${_n} on ${_t}"
      fi
      ### The sub-user's keys: from the real directory into the real one.
      if _xcopy_subuser_ssh_ok "${_src}.${_n}"; then
        _xcopy_in_real_dir "/home/${_src}.${_n}/.ssh" _xcopy_copy_mk_here "${_t}" \
          "/home/${_dst}.${_n}/.ssh" '' -aEAXqu ${_ieni}
      fi
    else
      ### The sub-user does not exist there yet: manage_ltd_users creates it
      ### from clients/ on its next pass (after post-mig while the target's
      ### runners are parked) and honours the carried store entry above, so
      ### the password converges. Its .ssh cannot be placed before the home
      ### exists -- stage it for the post-creation pass instead.
      if _xcopy_subuser_ssh_ok "${_src}.${_n}"; then
        ssh root@"${_t}" "mkdir -p /var/backups/migrate-subuser-ssh/${_dst}.${_n}" &> /dev/null
        _xcopy_in_real_dir "/home/${_src}.${_n}/.ssh" _xcopy_rsync -aEAXqu ${_ieni} -e ssh \
          ./ "root@${_t}:/var/backups/migrate-subuser-ssh/${_dst}.${_n}/.ssh/"
        echo "INFO: sub-account ${_dst}.${_n} not created on ${_t} yet; password converges via the"
        echo "INFO: carried store, and its keys are staged at /var/backups/migrate-subuser-ssh/${_dst}.${_n}/.ssh"
      else
        echo "INFO: sub-account ${_dst}.${_n} not created on ${_t} yet; its carried password"
        echo "INFO: store entry makes it converge when manage_ltd_users creates it there"
      fi
    fi
  done
  return 0
}

_migrate_prepare() {
  # The watchdog stands down for the database verbs (_xcopy_sql_maint_hold);
  # released at the end of this function, or by the EXIT trap.
  case "${_cmd}" in
    import|export) _xcopy_sql_maint_hold ;;
  esac
  _THIS_HM_USER=${_oct}
  _USR=/data/disk/${_oct}
  # .drush and log/ are oN's: read inside the real directories, never
  # through a link or into a FIFO put at a name there
  _THIS_HM_SITE=$(_xcopy_read_in "${_USR}/.drush" hostmaster.alias.drushrc.php \
    | grep "site_path'" \
    | cut -d: -f2 \
    | awk '{ print $3}' \
    | sed "s/[\,']//g")
  echo _THIS_HM_USER ${_THIS_HM_USER}
  echo _USR ${_USR}
  echo _THIS_HM_SITE ${_THIS_HM_SITE}
  _xcopy_plan_value "${_USR}" "${_THIS_HM_USER}" option.txt _CLIENT_OPTION "${_XCOPY_PLAN_RE}"
  _xcopy_plan_value "${_USR}" "${_THIS_HM_USER}" cores.txt _CLIENT_CORES '^[1-9][0-9]{0,8}$'
  _xcopy_plan_value "${_USR}" "${_THIS_HM_USER}" subscr.txt _CLIENT_SUBSCR '^[A-Za-z0-9_]+$'
  ### log/ is oN's: read inside the real directory, never through a link or
  ### into a FIFO put at the name, as xoct reads it, with root's cnf as the
  ### account's Octopus pass takes it when the file holds no plain address
  ### (_xcopy_client_address). The install takes one address: a list is
  ### installed with its first, and the transfer carries the account's own
  ### log/email.txt over the install's copy, so the target keeps the list as
  ### it is (as xoct does). What holds no plain address is dropped here, so
  ### it is never echoed, and create refuses on it: no stand-in address
  ### takes its place.
  _XCOPY_EMAIL_BAD=NO
  _CLIENT_EMAIL=""
  _xcopy_client_address "${_USR}" "${_THIS_HM_USER}"
  if [ "${_XCOPY_EMAIL_SRC}" = "cnf" ]; then
    echo "INFO: log/email.txt holds '$(_xcopy_shown "${_XCOPY_EMAIL_TXT}")', not a plain address: the client address is _CLIENT_EMAIL of /root/.${_THIS_HM_USER}.octopus.cnf, as the account's Octopus pass takes it"
  fi
  if _xcopy_email_ok "${_XCOPY_EMAIL%% *}"; then
    _CLIENT_EMAIL="${_XCOPY_EMAIL%% *}"
    if [ "${_CLIENT_EMAIL}" != "${_XCOPY_EMAIL}" ]; then
      echo "INFO: the account's address is a list: create installs with its first address, the transfer carries the list in log/email.txt as it is"
    fi
  else
    _XCOPY_EMAIL_BAD=YES
    echo "ALRT: the account's client address holds no plain address; create refuses on it (the install takes one)"
  fi

  [ -z "${_THIS_DB_PORT}" ] && _THIS_DB_PORT=3306
  [ -z "${_CLIENT_OPTION}" ] && _CLIENT_OPTION=EDGE
  [ -z "${_CLIENT_SUBSCR}" ] && _CLIENT_SUBSCR=M
  [ -z "${_CLIENT_CORES}" ]  && _CLIENT_CORES=1

  echo "_CLIENT_EMAIL is ${_CLIENT_EMAIL}"
  [ -n "${_XCOPY_ADMAIL}" ] \
    && echo "INFO: admail=${_XCOPY_ADMAIL}: a create installs only with its welcome mail held back; the account keeps its own address"
  echo "_THIS_HM_USER is ${_THIS_HM_USER}"
  echo "_CLIENT_OPTION is ${_CLIENT_OPTION}"
  echo "_CLIENT_SUBSCR is ${_CLIENT_SUBSCR}"
  echo "_CLIENT_CORES is ${_CLIENT_CORES}"

  if [ "${_cmd}" = "import" ] && [ ! -e "${_USR}/log/imported.pid" ]; then
    _xcopy_import_precheck || exit 1
  fi
  # The panel site is the account's: drushrc.php is read inside its real
  # directory, never through a link or into a FIFO. Read before anything
  # below changes the box, so the refusal that follows leaves it as it was.
  if [ -e "${_THIS_HM_SITE}/drushrc.php" ]; then
    _HDB=$(_xcopy_panel_db_line "${_THIS_HM_SITE}")
    echo "raw _HDB is ${_HDB}"
    _HDB=${_HDB//[^a-zA-Z0-9_]/}
    echo "clean _HDB is ${_HDB}"
  else
    echo "no ${_THIS_HM_SITE}/drushrc.php found"
  fi
  # The precheck read the same name; a drushrc.php swapped since then must
  # not skip the panel import below and still exit 0. Refused before chattr,
  # the task queue or any file of the account is touched.
  if [ "${_cmd}" = "import" ] && [ ! -e "${_USR}/log/imported.pid" ] \
    && [ -z "${_HDB}" ]; then
    echo "ERROR: import for ${_oct}: ${_THIS_HM_SITE}/drushrc.php names no panel database"
    echo "ERROR: nothing was imported and nothing on this box was changed; fix the cause and re-run"
    exit 1
  fi
  # The create switched the upgrade notice off already under admail=; asked
  # again here, on the box the copy now lives on, after the refusal above
  # (which leaves the box as it was): the account's first pass follows.
  if [ "${_cmd}" = "import" ] && [ -n "${_XCOPY_ADMAIL}" ]; then
    _xcopy_admail_upgrade_mail_off "${_THIS_HM_USER}"
  fi
  if [ "${_cmd}" = "import" ]; then
    _xcopy_upgrade_skip_put "${_THIS_HM_USER}" "" import
    if [ -z "${_XCOPY_ADMAIL}" ] && [ -e "${_XCOPY_HOLD_FILE}" ]; then
      echo "ALRT: this box holds its clients' mail for $(head -n 1 "${_XCOPY_HOLD_FILE}" 2> /dev/null | tr -cd '[:print:]' | cut -c1-200) (${_XCOPY_HOLD_FILE}, put"
      echo "ALRT: by a test run): ${_THIS_HM_USER}'s client is not mailed from here while it is there"
    fi
  fi

  su -s /bin/bash ${_THIS_HM_USER} -c "drush8 cc drush"
  wait
  _XCOPY_CHATTR_OFF=YES
  _disable_chattr ${_THIS_HM_USER}.ftp
  rm -rf /home/${_THIS_HM_USER}.ftp/drush-backups
  # clients/ belongs to oN: enter only real client subdirectories and remove
  # only their own backups, then prune dangling links from inside the real
  # clients/ -- never rm -rf or symlinks -dr through a link at clients or a
  # client name.
  _xcopy_clean_clients "${_USR}/clients"
  # The .ftp home is the account's: the dangling-link prune runs inside the
  # real home.
  if [ -d "/home/${_THIS_HM_USER}.ftp" ]; then
    _xcopy_in_real_dir "/home/${_THIS_HM_USER}.ftp" symlinks -dr .
    rm -f /home/${_THIS_HM_USER}.ftp/{.profile,.bash_logout,.bash_profile,.bashrc}
  fi
  # src/ belongs to oN: make it a real directory (a link the account put at the
  # name is removed) so the dump below cannot be steered elsewhere.
  _xcopy_in_real_dir "${_USR}" _xcopy_realdir_here src
  if [ "${_cmd}" = "export" ] \
    && [ ! -z "${_HDB}" ] \
    && [ ! -e "${_USR}/src/prev_hostmaster.sql" ] \
    && [ ! -e "${_USR}/log/exported.pid" ]; then
      # Full hostmaster DB dump. renameaegirhost rewrites the source host/IP
      # across the entire DB on import and its task queue regenerates db-host
      # and alias entries, so a per-table allowlist (which silently dropped any
      # unlisted or newly added schema table) is no longer needed.
      # Written into the real src/ as a fresh file renamed over the name, so a
      # link the account put at prev_hostmaster.sql (even a dangling one, past
      # the -e guard above) is replaced, never followed to create its target.
      _mysqldump_gtid_opts
      [ "${#_MYSQLDUMP_GTID[@]}" -eq 0 ] \
        && echo "INFO: this mysqldump takes no --set-gtid-purged: its dump carries no GTID state"
      if _xcopy_in_real_dir "${_USR}/src" _xcopy_dump_hm_here \
        mysqldump -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp \
        "${_MYSQLDUMP_GTID[@]}" \
        --single-transaction \
        --quick \
        --no-autocommit \
        --skip-add-locks \
        --no-tablespaces \
        --hex-blob ${_HDB}; then
        _XCOPY_HM_DUMP_OK=YES
      else
        _XCOPY_HM_DUMP_OK=NO
      fi
    ### The redirect pre-creates the file, so the old existence test read a
    ### failed mysqldump as success and stamped exported.pid over a zero-byte
    ### or truncated panel dump. Demand rc=0 AND a non-empty file; the stamp
    ### itself moves to the run verdict AFTER _migrate_sites.
    if [ "${_XCOPY_HM_DUMP_OK}" = "YES" ] \
      && [ -s "${_USR}/src/prev_hostmaster.sql" ]; then
      echo "INFO: hostmaster ${_oct} db export complete"
      # Record the source FQDN for the import-side rename. The target keeps
      # its own server_master alias (the transfer never sends this one), so
      # renameaegirhost's auto-detection there would read OLD==NEW and
      # silently no-op while the imported DB still holds this FQDN.
      # Recording it here pins OLD deterministically (and keeps an aborted
      # rename re-runnable after §3 already rewrote the aliases); import
      # refuses without it. Travels with the log/ transfer sync.
      # The alias is read and the record put inside the real .drush and
      # log/ (both oN's), never through a link put at either name.
      _SRC_FQDN=$(_xcopy_read_in "${_USR}/.drush" server_master.alias.drushrc.php \
        | grep "remote_host" \
        | head -1 \
        | sed "s/.*remote_host.*=>//; s/[' ,;]//g")
      _SRC_FQDN=${_SRC_FQDN//[^a-zA-Z0-9.\-]/}
      [ -z "${_SRC_FQDN}" ] && _SRC_FQDN=$(hostname -f 2>/dev/null | tr -d '\n')
      printf '%s' "${_SRC_FQDN}" \
        | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here sourcefqdn.txt
    else
      ### Remove the debris so a re-run redumps from scratch instead of
      ### skipping the hostmaster block on the pre-created file.
      _xcopy_in_real_dir "${_USR}/src" rm -f -- ./prev_hostmaster.sql
      echo "ALRT: hostmaster ${_oct} db export FAILED (mysqldump error or empty dump)"
      exit 1
    fi
  fi
  _XCOPY_SITES_STAGE=""
  _XCOPY_SEEN_DIRS=""
  _XCOPY_LOADED_DIRS=""
  _XCOPY_LOADED_NAMES=""
  _XCOPY_MET_DIRS=""
  _XCOPY_RUNNER_UNTIL=""
  _XCOPY_DEFERRED_N=0
  _XCOPY_DEFER_MET=0
  if [ "${_cmd}" = "import" ] \
    && [ -e "${_USR}/config/includes/nginx_vhost_common.conf" ] \
    && [ ! -z "${_HDB}" ] \
    && [ -e "${_USR}/src/prev_hostmaster.sql" ] \
    && [ ! -e "${_USR}/log/imported.pid" ]; then
    ### Target-side quiesce, previously a hand-typed runbook step: BOA's own
    ### background jobs must not fight the hostmaster import and the rename
    ### queue. Cron comes back via post-mig. Devuan trap: 'service cron stop'
    ### does not always stop it -- use the init script plus pkill, verified.
    /etc/init.d/cron stop &> /dev/null || service cron stop &> /dev/null
    pkill -x cron &> /dev/null
    if pgrep -x cron &> /dev/null; then
      echo "ALRT: cron still running after stop attempt; check manually"
    fi
    [ -e "/data/all/cpuinfo" ] && _xcopy_in_real_dir \
      "$(_s="$(perl -e "${_ROOT_REAL_PATH_PL}" -- /data/all 2> /dev/null)" \
        && perl -e "${_SAT_STORE_TARGET_PL}" -- "${_s}" > /dev/null 2>&1 \
        && echo "${_s}" || echo /data/all)" \
      _xcopy_fchmod_here 644 ./cpuinfo
    _xcopy_wait_boa_quiet
    # The job just waited out may be what held the marker (a Percona upgrade).
    _xcopy_sql_maint_hold
    # The alias-derived _HDB can name a DB an enforced upgrade has already
    # replaced: a dest panel rebuilt between create and import (new panel DB
    # created, old one dropped) leaves the on-disk alias stale, and the dump
    # would then pour into a nonexistent DB. The pre-mig runner park holds
    # create's armed upgrade until post-mig, so this is the shape of a park
    # that lapsed (24 h ceiling, reboot) or was never taken on this box, no
    # longer the norm. Resolution order: the recorded decision from a
    # previous (possibly partial) import run, then the alias-derived name,
    # then a dest-form panel scan (the xmass 12.5 way), then the
    # already-poured shape (a partial run leaves the live DB holding
    # SOURCE-form rows, invisible to the dest-form scan -- its hostmaster
    # front names the recorded source FQDN, which nothing else on the box
    # can carry). The winner is recorded so the printed recovery path stays
    # deterministic. log/ is oN's: its records are read and put inside the
    # real directory, never through a link or into a FIFO put at the name.
    if [ -s "${_USR}/log/panel_db.txt" ]; then
      _HDB_REC=$(_xcopy_read_in "${_USR}/log" panel_db.txt | tr -d "\n")
      _HDB_REC=${_HDB_REC//[^a-zA-Z0-9_]/}
      if [ -n "${_HDB_REC}" ] && [ -n "$(mysql --silent -u root -h${_SQL_CONNECT} \
          -P${_THIS_DB_PORT} --protocol=tcp -N -B \
          -e "SHOW DATABASES LIKE '${_HDB_REC}'" 2>/dev/null)" ]; then
        [ "${_HDB_REC}" != "${_HDB}" ] \
          && echo "PANEL-NOTE: using the recorded panel DB ${_HDB_REC} (alias-derived ${_HDB} superseded)"
        _HDB="${_HDB_REC}"
      fi
    fi
    if [ -z "$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
        --protocol=tcp -N -B -e "SHOW DATABASES LIKE '${_HDB}'" 2>/dev/null)" ]; then
      _SRC_FRONT=""
      if [ -s "${_USR}/log/sourcefqdn.txt" ]; then
        _SRC_FRONT="${_oct}.$(_xcopy_read_in "${_USR}/log" sourcefqdn.txt | tr -d "\n")"
        _SRC_FRONT=${_SRC_FRONT//[^a-zA-Z0-9.-]/}
      fi
      _HDB_LIVE=""
      _HDB_POURED=""
      for _HC in $(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
          --protocol=tcp -N -B -e "SHOW DATABASES" 2>/dev/null \
        | grep -vE "^(information_schema|performance_schema|mysql|sys)$"); do
        case "${_HC}" in *[!A-Za-z0-9_]*) continue ;; esac
        if [ -n "$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
            --protocol=tcp -N -B "${_HC}" -e "SELECT name FROM hosting_context \
            WHERE name='server_master' LIMIT 1" 2>/dev/null)" ]; then
          if [ -n "$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
              --protocol=tcp -N -B "${_HC}" -e "SELECT publish_path FROM \
              hosting_platform WHERE publish_path LIKE '${_USR}/%' LIMIT 1" 2>/dev/null)" ]; then
            if [ -n "${_HDB_LIVE}" ]; then
              echo "ERROR: multiple live panel DBs match ${_USR} (${_HDB_LIVE}, ${_HC}) -- refusing to guess"
              exit 1
            fi
            _HDB_LIVE="${_HC}"
          elif [ -n "${_SRC_FRONT}" ] && [ -n "$(mysql --silent -u root \
              -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -N -B "${_HC}" \
              -e "SELECT n.title FROM node n JOIN hosting_context c ON c.nid=n.nid \
              WHERE c.name='hostmaster' AND n.title='${_SRC_FRONT}' LIMIT 1" 2>/dev/null)" ]; then
            if [ -n "${_HDB_POURED}" ]; then
              echo "ERROR: multiple DBs carry the source panel front ${_SRC_FRONT} (${_HDB_POURED}, ${_HC}) -- refusing to guess"
              exit 1
            fi
            _HDB_POURED="${_HC}"
          fi
        fi
      done
      if [ -n "${_HDB_LIVE}" ]; then
        echo "PANEL-NOTE: alias-derived panel DB ${_HDB} is gone (panel rebuilt since create); importing into live panel DB ${_HDB_LIVE}"
        _HDB="${_HDB_LIVE}"
      elif [ -n "${_HDB_POURED}" ]; then
        echo "PANEL-NOTE: alias-derived panel DB ${_HDB} is gone; resuming into ${_HDB_POURED} (already carries the source panel front from a previous run)"
        _HDB="${_HDB_POURED}"
      else
        echo "ERROR: alias-derived panel DB ${_HDB} does not exist and no live panel DB"
        echo "ERROR: matches ${_USR} -- the dest account has no importable panel; re-run"
        echo "ERROR: 'xcopy create ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}' first"
        exit 1
      fi
    fi
    printf '%s' "${_HDB}" \
      | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here panel_db.txt
    ### A 5.7 panel dump's utf8mb4 tables keep utf8mb4_general_ci on 8.x
    ### (_mig_utf8mb4_client_opt, asked of the server the dump goes to); a
    ### pour through ProxySQL is left as it was.
    _XCOPY_POUR_UTF8MB4=()
    if [ "${_THIS_DB_PORT}" = "3306" ]; then
      _mig_utf8mb4_client_opt -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp
      _XCOPY_POUR_UTF8MB4=("${_MYSQL_UTF8MB4[@]}")
    fi
    if [ ! -z "${_dst}" ]; then
      if [ "${_oct}" = "${_dst}" ]; then
        [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL5 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
        ### Never stamp the account imported over a failed panel restore --
        ### the marker is what blocks a re-import, so a swallowed failure
        ### here strands the account permanently. xoct already checks this.
        ### src/ is oN's on the target: the dump is streamed from inside the
        ### real directory (never through a link) and fed with --binary-mode,
        ### so the client runs no \! or system command from the dump; pipefail
        ### keeps a streaming failure from passing.
        if ! ( set -o pipefail
          _xcopy_in_real_dir "${_USR}/src" _xcopy_cat_here prev_hostmaster.sql \
            | mysql --binary-mode --silent -u root -h${_SQL_CONNECT} \
              "${_XCOPY_POUR_UTF8MB4[@]}" -P${_THIS_DB_PORT} --protocol=tcp ${_HDB} ); then
          echo "ERROR: hostmaster dump import into ${_HDB} FAILED -- this import is INCOMPLETE"
          echo "ERROR: nothing was stamped; fix the cause, then re-run the FULL import"
          exit 1
        fi
        ### The panel keeps the front page its dump carries, node included.
        ### Clear the travelled source-role latches with the stamp -- they
        ### block this box from ever being a source itself (see xoct).
        ### log/ is oN's: removed and stamped inside the real directory.
        _xcopy_in_real_dir "${_USR}/log" rm -f -- ./exported.pid ./transferred.pid \
          ./export_failed.pid ./proxy-failed.pid
        _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here imported.pid
      fi
    else
      [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL6 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
      ### src/ is oN's on the target: streamed from inside the real directory
      ### and fed with --binary-mode (see the rename-mode branch above).
      if ! ( set -o pipefail
        _xcopy_in_real_dir "${_USR}/src" _xcopy_cat_here prev_hostmaster.sql \
          | mysql --binary-mode --silent -u root -h${_SQL_CONNECT} \
            "${_XCOPY_POUR_UTF8MB4[@]}" -P${_THIS_DB_PORT} --protocol=tcp ${_HDB} ); then
        echo "ERROR: hostmaster dump import into ${_HDB} FAILED -- this import is INCOMPLETE"
        echo "ERROR: nothing was stamped; fix the cause, then re-run the FULL import"
        exit 1
      fi
      ### The panel keeps the front page its dump carries, node included.
      ### Clear the travelled source-role latches with the stamp -- they
      ### block this box from ever being a source itself (see xoct).
      ### log/ is oN's: removed and stamped inside the real directory.
      _xcopy_in_real_dir "${_USR}/log" rm -f -- ./exported.pid ./transferred.pid \
        ./export_failed.pid ./proxy-failed.pid
      _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here imported.pid
    fi
    ### Both branches above pour the same-name dump (xcopy refuses any other
    ### name before it gets here), so both reach the steps below.
    _measure_loaded_tables "${_HDB}" -u root "-h${_SQL_CONNECT}" "-P${_THIS_DB_PORT}" \
      --protocol=tcp
    ### The panel database the dump went into is the account's in the
    ### database broker's registry once the account is switched: its next
    ### upgrade dumps it through the broker.
    _xcopy_dbreg "${_THIS_HM_USER}" "${_HDB}"
    if ! _xcopy_reconcile_panel_platform "${_USR}" "${_oct}" "${_HDB}"; then
      echo "ERROR: panel platform reconciliation failed for ${_USR} -- this import is INCOMPLETE"
      echo "ERROR: the imported DB names a hostmaster platform this box cannot serve; continuing"
      echo "ERROR: would leave the copied control panel dead after the rename queue runs"
      echo "ERROR: recovery -- fix the cause the ALRT above names, then re-run the FULL import:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xcopy import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}"
      exit 1
    fi
    if ! _xcopy_sync_panel_db_pass "${_USR}" "${_THIS_HM_USER}" "${_oct}" "${_HDB}"; then
      echo "ALRT: the panel's database server password was not synced for ${_THIS_HM_USER}: its server"
      echo "ALRT: verify fails until the next Octopus pass (check ${_USR}/.${_THIS_HM_USER}.pass.txt)"
    fi

    if [ "${_fix}" = "fix" ]; then
      _DOMAIN=$(_xcopy_read_in "${_USR}/log" domain.txt)
      _DOMAIN=`echo -n ${_DOMAIN} | tr -d "\n"`

      _vSet="variable-set --always-set"
      _run_drush8_hmr_cmd "${_vSet} hosting_client_send_welcome 0" &> /dev/null
    fi

    ### The sites' databases and their users and the account's PHP pools come
    ### before the rename: its queue verifies every renamed site and its
    ### serving gate then probes each one, and a site whose database user
    ### does not exist yet fails that verify, as a site without a live pool
    ### fails the probe for its whole wait. The verify of each clean load is
    ### scheduled after the rename, under the site's name there (the second
    ### _migrate_sites below).
    _XCOPY_SITES_STAGE=load
    _migrate_sites
    _xcopy_heal_fpm_pins "${_THIS_HM_USER}"

    ###
    ### Rename all source-hostname references in this Aegir instance to the
    ### FQDN of the current (target) server. renameaegirhost:
    ###   §1  old hostname: pinned via --force-old from log/sourcefqdn.txt
    ###       (recorded at export; this box keeps its own server_master
    ###       alias, so auto-detection and a partial-rename re-run would
    ###       both no-op at OLD==NEW)
    ###   §2  detects new hostname from system FQDN (hostname -f)
    ###   §3  rewrites .drush/*.alias.drushrc.php files
    ###   §4  rewrites + renames nginx vhost files in config/server_master/
    ###   §5  renames the source FQDN inside the Aegir DB with serialize-safe
    ###       targeted statements (identity rows by hosting_context nid,
    ###       varchar REPLACE sweeps, unserialize/replace/re-serialize pass
    ###       over the variable table); keeps a plain backup dump
    ###   §6  reloads nginx
    ###   §7  runs the Aegir task queue 5 times (cc drush + server verify +
    ###       hosting-dispatch + hosting-tasks) to regenerate all on-disk
    ###       aliases, vhosts, and db-host entries from the updated DB
    ### Must run AFTER the panel platform reconciliation above because §7
    ### regenerates everything from the DB state it shaped, and with cron
    ### stopped (the tool assumes it). xcopy never renames the account, so
    ### no --old-account/--new-account axis rides along.
    ###
    _RAH_OLD=""
    if [ -s "${_USR}/log/sourcefqdn.txt" ]; then
      _RAH_OLD=$(_xcopy_read_in "${_USR}/log" sourcefqdn.txt | tr -d "\n")
      _RAH_OLD=${_RAH_OLD//[^a-zA-Z0-9.\-]/}
    fi
    if [ ! -z "${_RAH_OLD}" ]; then
      _xcopy_sql_maint_hold
      renameaegirhost --aegir-root "${_USR}" --force-old "${_RAH_OLD}"
      _RAH_RC=$?
    else
      # Unreachable past _xcopy_import_precheck. Auto-detection would read
      # this box's own server_master alias (OLD==NEW) and rename nothing.
      echo "ERROR: log/sourcefqdn.txt names no source hostname; not renaming"
      _RAH_RC=1
    fi
    if [ "${_RAH_RC}" -ne 0 ]; then
      echo "ERROR: renameaegirhost failed (rc=${_RAH_RC}) for ${_USR} -- this import is INCOMPLETE"
      echo "ERROR: every import step after the rename was skipped: the site verifies, the cache"
      echo "ERROR: flush and the pinned PHP pool rebuild for the renamed sites"
      echo "ERROR: recovery -- fix the cause, then re-run the FULL import:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xcopy import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}"
      echo "ERROR: (safe: re-imports the same already-transferred dump, redoes rename + tail)"
      echo "ERROR: to iterate on the rename failure alone first (convergent, safe to re-run):"
      echo "ERROR:   renameaegirhost --aegir-root ${_USR} --force-old ${_RAH_OLD:-<source-fqdn>}"
      echo "ERROR: the full import re-run above is still required to finish the skipped tail"
      exit 1
    fi

  fi
  if [ "${_cmd}" = "create" ]; then
    if [ ! -z "${_dst}" ]; then
      _TGT_HM_USER="${_dst}"
    else
      _TGT_HM_USER="${_oct}"
    fi
    ### The plan stamps come from the account's log/ and are spliced into a
    ### remote root command: stripped to their legal alphabets, and the
    ### install is refused when nothing is left.
    _CLIENT_OPTION=${_CLIENT_OPTION//[^a-zA-Z0-9]/}
    _CLIENT_SUBSCR=${_CLIENT_SUBSCR//[^a-zA-Z0-9]/}
    _CLIENT_CORES=${_CLIENT_CORES//[^0-9]/}
    if [ -z "${_CLIENT_OPTION}" ] || [ -z "${_CLIENT_SUBSCR}" ] || [ -z "${_CLIENT_CORES}" ]; then
      echo "ALRT: refusing create: plan stamps failed validation (option/subscr/cores)"
      exit 1
    fi
    ### The address goes into the same remote root command: one plain
    ### address or nothing reaches the target (as xoct refuses it).
    if [ "${_XCOPY_EMAIL_BAD}" != "NO" ] || ! _xcopy_email_ok "${_CLIENT_EMAIL}"; then
      echo "ALRT: refusing create: client email failed validation (the install takes one plain address, from ${_USR}/log/email.txt or _CLIENT_EMAIL of /root/.${_oct}.octopus.cnf)"
      exit 1
    fi
    if [ ! -z "${_CLIENT_EMAIL}" ] \
      && [ ! -z "${_TGT_HM_USER}" ] \
      && [ ! -z "${_CLIENT_OPTION}" ] \
      && [ ! -z "${_CLIENT_SUBSCR}" ] \
      && [ ! -z "${_CLIENT_CORES}" ]; then
      ### An account the target already holds is this migration's only
      ### under its create marker: asked before --fix-php or anything else
      ### changes the target.
      _xcopy_create_owner_gate "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      ### The PHP set in force here must exist on the target BEFORE anything
      ### is installed there; a missing version means silent fallback to a
      ### different PHP on the copied sites (as in xoct).
      _xcopy_php_coverage_gate "${_USR}" "${_tgt}" || exit 1
      ### Install from the TARGET's own tree: a cross-tree copy must not push
      ### this box's tree through the target's licence gate (as in xoct).
      _TGT_TREE="$(_mig_target_tree "${_tgt}")"
      case "${_TGT_TREE}" in
        dev|lts|pro) : ;;
        *)
          echo "ALRT: invalid tree token '${_TGT_TREE}' from the target probe; refusing create"
          exit 1
        ;;
      esac
      if [ "${_TGT_TREE}" != "${_tRee}" ]; then
        echo "ALRT: source tree is ${_tRee} but target ${_tgt} runs ${_TGT_TREE}; installing for ${_TGT_TREE}"
      fi
      ### A ProxySQL account here is born ProxySQL-wired on the target, not
      ### retro-fitted: in-oct is in-octopus plus that wiring.
      _IN_VERB=in-octopus
      if [ -e "/data/conf/${_oct}_use_proxysql.txt" ]; then
        _IN_VERB=in-oct
        echo "INFO: source account uses ProxySQL; installing with 'boa in-oct'"
      fi
      ### Asked again: the PHP pass above is a full system pass, and the
      ### target may have taken the name meanwhile.
      _xcopy_create_owner_gate "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      ### Skipped only when the marked account is also really installed, on
      ### what only an install produces (xoct asks the same): one whose cnf or
      ### vhost include is gone goes to the install, which refuses the name.
      _TGT_PRESENT=""
      if [ "${_XCOPY_CREATE_HELD}" = "YES" ]; then
        _TGT_PRESENT=$(ssh root@${_tgt} "getent passwd ${_TGT_HM_USER} >/dev/null 2>&1 \
          && [ -e /root/.${_TGT_HM_USER}.octopus.cnf ] \
          && [ -e /data/disk/${_TGT_HM_USER}/config/includes/nginx_vhost_common.conf ] \
          && echo PRESENT" 2>/dev/null)
      fi
      if [ "${_XCOPY_CREATE_HELD}" = "YES" ] && [ "${_TGT_PRESENT}" = "PRESENT" ]; then
        echo "INFO: account ${_TGT_HM_USER} already installed on ${_tgt} by this migration; skipping install"
      else
        ### The install's own welcome mail would hand the client a new
        ### password for an account whose own one the move carries: the
        ### install runs under the target's mail-suppression marker, as xoct
        ### runs every install, put for it alone and taken off after it (by
        ### the EXIT trap on any exit), an operator-set one kept. Under
        ### admail=, with no marker held there, nothing is installed.
        _SILENT_MARKER=NO
        ### The runner takes the marker off when it starts a queued upgrade
        ### (an earlier create arms one): the marker goes on a quiet target.
        _xcopy_wait_target_quiet "${_tgt}" || exit 1
        _SILENT_PROBE=$(ssh root@"${_tgt}" "[ -e /root/.silent.update.cnf ] && echo YES || echo NO" 2>/dev/null)
        if [ "${_SILENT_PROBE}" = "NO" ] && ssh root@"${_tgt}" "touch /root/.silent.update.cnf"; then
          _SILENT_MARKER=YES
          trap '_xcopy_chattr_back; ssh root@'"${_tgt}"' "rm -f /root/.silent.update.cnf" &> /dev/null; rm -f "${_XCOPY_LOCK_FILE}"' EXIT
          trap 'exit 130' INT TERM HUP
        elif [ "${_SILENT_PROBE}" != "YES" ]; then
          if [ -n "${_XCOPY_ADMAIL}" ]; then
            echo "ALRT: refusing create under admail=: the mail-suppression marker could not be put on ${_tgt},"
            echo "ALRT: so the install would mail its welcome to the account's own address; nothing was installed"
            exit 1
          fi
          echo "ALRT: the mail-suppression marker could not be put on ${_tgt}: the install may mail"
          echo "ALRT: its welcome, with a password the carried credentials replace, to the account's own address"
        fi
        ### The launcher exits 1 without installing when the name is taken
        ### or a run lock is held: nothing below may run on the target then.
        ### The install window's EXIT handler takes the marker off (when this
        ### run put it) and takes back both seeds of an account the install
        ### did not make, until the remote install is started: an exit here
        ### does not stop that one, which may make the account after it, so
        ### from then on the seeds stay. Its signal handler exits, which runs
        ### the EXIT handler.
        _XCOPY_INSTALL_ON=NO
        trap '_xcopy_chattr_back; [ "${_XCOPY_INSTALL_ON}" = "YES" ] || { _xcopy_dbarm_unseed "${_TGT_HM_USER}" '"${_tgt}"'; _xcopy_wg_unseed "${_TGT_HM_USER}" '"${_tgt}"'; } > /dev/null 2>&1; [ "${_SILENT_MARKER}" = "YES" ] && ssh root@'"${_tgt}"' "rm -f /root/.silent.update.cnf" &> /dev/null; rm -f "${_XCOPY_LOCK_FILE}"' EXIT
        trap 'exit 130' INT TERM HUP
        _xcopy_wg_seed "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
        _xcopy_dbarm_seed "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
        _XCOPY_INSTALL_ON=YES
        ssh root@${_tgt} "/opt/local/bin/boa ${_IN_VERB} ${_CLIENT_EMAIL} ${_TGT_HM_USER} ${_TGT_TREE} ${_CLIENT_OPTION} ${_CLIENT_SUBSCR} ${_CLIENT_CORES} noscreen"
        _INSTALL_RC=$?
        ### The launcher's status alone is not the account (the install can
        ### die for its own reasons): it is proven to exist before anything
        ### else is done there, as xoct proves it.
        _TGT_BORN=$(ssh root@${_tgt} "getent passwd ${_TGT_HM_USER} >/dev/null 2>&1 \
          && [ -e /root/.${_TGT_HM_USER}.octopus.cnf ] \
          && [ -s /data/disk/${_TGT_HM_USER}/log/octopus_log.txt ] \
          && echo BORN" 2>/dev/null)
        if [ "${_INSTALL_RC}" != "0" ] || [ "${_TGT_BORN}" != "BORN" ]; then
          ### 255 is the connection lost, not the launcher's answer: the
          ### remote install may go on and make the account after this, so
          ### both seeds stay there for a re-run whose install uses them; any
          ### other failure takes back what this run put. What stays is named.
          _xcopy_seeds_left "${_TGT_HM_USER}" "${_tgt}" "${_INSTALL_RC}"
          if [ "${_INSTALL_RC}" != "255" ]; then
            _xcopy_dbarm_unseed "${_TGT_HM_USER}" "${_tgt}"
            _xcopy_wg_unseed "${_TGT_HM_USER}" "${_tgt}"
          fi
          echo "ALRT: install of ${_TGT_HM_USER} on ${_tgt} did not happen (launcher rc=${_INSTALL_RC}, see its output above); nothing further was changed there"
          echo "ALRT: re-run this create once ${_tgt} is quiet"
          exit 1
        fi
        if [ "${_SILENT_MARKER}" = "YES" ]; then
          _SILENT_AFTER=$(ssh root@"${_tgt}" "[ -e /root/.silent.update.cnf ] && echo YES || echo NO" 2>/dev/null)
          if [ "${_SILENT_AFTER}" = "NO" ]; then
            echo "ALRT: the mail-suppression marker was gone from ${_tgt} when the install ended (a queued"
            echo "ALRT: upgrade run takes it off): the install's welcome may have reached the account's own address"
          fi
          ssh root@"${_tgt}" "rm -f /root/.silent.update.cnf"
          _SILENT_MARKER=NO
        fi
        trap '_xcopy_chattr_back; rm -f "${_XCOPY_LOCK_FILE}"' EXIT
        trap 'rm -f "${_XCOPY_LOCK_FILE}"; exit 130' INT TERM HUP
        if ! _xcopy_create_mark "${_oct}" "${_TGT_HM_USER}" "${_tgt}"; then
          echo "ALRT: the create marker for ${_TGT_HM_USER} could not be put on ${_tgt}; a re-run of this create will refuse the account"
          _xcopy_create_adopt_hint "${_oct}" "${_TGT_HM_USER}" "${_tgt}" "$(_xcopy_create_src_host)"
        fi
      fi
      if [ -e "/data/conf/${_oct}_use_proxysql.txt" ]; then
        ssh root@${_tgt} "mkdir -p /data/conf && echo ProxySQL > /data/conf/${_TGT_HM_USER}_use_proxysql.txt"
      fi
      ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/.ctrl/ssl-demo-mode.pid"
      ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/config"
      ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/config.sh"
      ### Under admail= a target that keeps the account's upgrade notice on
      ### refuses the create, before the transfer can bring the setup mail it
      ### would send.
      if [ -n "${_XCOPY_ADMAIL}" ]; then
        _xcopy_admail_upgrade_mail_off "${_TGT_HM_USER}" "${_tgt}" || exit 1
      fi
      ### Every copy, test or real: the account's first pass there that would
      ### mail its upgrade notice sends none (_xcopy_upgrade_skip_put).
      _xcopy_upgrade_skip_put "${_TGT_HM_USER}" "${_tgt}" create
      echo "Waiting 8 minutes before attempting to run enforced post-install upgrade..."
      sleep 500
      ### Arm the enforced post-install upgrade only when the install's own
      ### in-flow upgrade has not run yet (octopus_log carries a single line).
      ### The old guard keyed on log/upgrademail.txt, which a silent install
      ### never writes, so it armed a full pass on every re-run; and the pid
      ### cleanup ran AFTER the arm, deleting the trigger it had just created.
      _xcopy_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" 'rm -f -- ./*.pid'
      ### log/ is oN's there too: octopus_log.txt is counted as read inside
      ### the real directory, never through a link or from a FIFO. Both
      ### control files are put fresh, owned by the main login from the start
      ### as the queue's own writer leaves them (the group asked of the
      ### target), so no name is chowned after the rename.
      if _xcopy_remote_in "${_tgt}" "/data/disk/${_TGT_HM_USER}/log" \
        '[ "$(_rr octopus_log.txt | wc -l)" -lt 2 ]'; then
        _xcopy_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" \
          "_g=\$(id -gn ${_TGT_HM_USER} 2> /dev/null); [ \"\${_g}\" = ${_TGT_HM_USER} ] || _g=users; _rp platforms.info \"\$(_rr platforms.info; echo UP)\" ${_TGT_HM_USER}.ftp:\${_g}; _rp run-upgrade.pid '' ${_TGT_HM_USER}.ftp:\${_g}"
      fi
      echo "INFO: new octopus ${_TGT_HM_USER} setup on ${_tgt} complete"
    else
      echo "ALRT: new octopus ${_TGT_HM_USER} setup on ${_tgt} failed because of missing arguments"
      exit 1
    fi
  fi
  ### An import whose sites were loaded before the rename schedules their
  ### verifies here; any other import loads and verifies here, as before.
  if [ "${_cmd}" = "import" ] && [ "${_XCOPY_SITES_STAGE}" = "load" ]; then
    _XCOPY_SITES_STAGE=verify
    ### The rename's own queue can still hold the instance's task runner
    ### when the verifies start; a forced verify waits for it up to this
    ### long, where the panel's hosting knows the option (30 s by default,
    ### then the task is left for the next dispatch, after post-mig).
    _XCOPY_HOST_INC="${_THIS_HM_SITE%/sites/*}/profiles/hostmaster/modules/aegir/hosting"
    if _xcopy_read_in "${_XCOPY_HOST_INC}" hosting.drush.inc | grep -q "'runner-wait' => array"; then
      _XCOPY_RUNNER_UNTIL=$(( $(date +%s) + 600 ))
    fi
  fi
  if [ "${_cmd}" = "import" ] \
    || [ "${_cmd}" = "export" ] \
    || [ "${_cmd}" = "fooproxy" ]; then
    _migrate_sites
  fi
  if [ "${_cmd}" = "export" ]; then
    if [ "${_XCOPY_EXPORT_FAIL:-0}" != "0" ]; then
      ### Parsed never sourced. Travels with the log/ transfer sync, so the
      ### import side refuses on it even when the operator skips the source
      ### side gate. log/ is oN's: the markers are put and removed inside the
      ### real directory, never through a link put at the name.
      {
        echo "failed=${_XCOPY_EXPORT_FAIL}"
        echo "dbs=${_XCOPY_EXPORT_FAILED_DBS# }"
        echo "time=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
      } | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here export_failed.pid
      echo "ALRT: export for ${_oct}: ${_XCOPY_EXPORT_FAIL} site database export(s) FAILED:${_XCOPY_EXPORT_FAILED_DBS}"
      echo "ERROR: NOT stamping exported.pid; transfer and import will refuse this account"
      echo "ERROR: fix the cause, then re-run 'xcopy export ${_oct} ${_tgt}${_dst:+ ${_dst}}'"
      echo "ERROR: (site dumps are redone in place; the hostmaster dump is kept)"
      _XCOPY_RUN_FAIL=YES
    elif [ -s "${_USR}/src/prev_hostmaster.sql" ]; then
      _xcopy_in_real_dir "${_USR}/log" rm -f -- ./export_failed.pid
      _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here exported.pid
      echo "INFO: export for ${_oct}: every site database dump completed; exported.pid stamped"
    fi
  fi
  if [ "${_cmd}" = "import" ]; then
    ### Every site loaded before the rename must have been met after it,
    ### under its name there: one the rename left unreachable (its alias or
    ### vhost not moved) got no verify, and the import is not complete.
    for _SIDN in ${_XCOPY_LOADED_DIRS}; do
      case " ${_XCOPY_MET_DIRS} " in
        *" ${_SIDN} "*) continue ;;
      esac
      _Dom=$(printf '%s\n' ${_XCOPY_LOADED_NAMES} | grep -m1 "^${_SIDN}=" | cut -d= -f2-)
      _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + 1 ))
      _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} ${_Dom:-${_SIDN}}:not-found-after-rename"
      echo "ALRT: site ${_Dom:-${_SIDN}} on ${_oct}: loaded before the rename but not found after it; no verify"
    done
    ### and every site whose site_path the load stage could not enter must
    ### have been judged after it
    if [ "${_XCOPY_DEFERRED_N}" -gt "${_XCOPY_DEFER_MET}" ]; then
      _XCOPY_IMPORT_FAIL=$(( ${_XCOPY_IMPORT_FAIL:-0} + _XCOPY_DEFERRED_N - _XCOPY_DEFER_MET ))
      _XCOPY_IMPORT_FAILED_DBS="${_XCOPY_IMPORT_FAILED_DBS} deferred-not-found-after-rename"
      echo "ALRT: $(( _XCOPY_DEFERRED_N - _XCOPY_DEFER_MET )) site(s) whose site_path could not be entered before the rename were not found after it"
    fi
    # Harsh cache flush so any copied D8+ site drops the source box's stale
    # container and bootstraps clean on this box.
    _xcopy_flush_caches_target
    # Carried FPM markers would leave every pinned site on the default pool.
    _xcopy_heal_fpm_pins "${_THIS_HM_USER}"
    _xcopy_le_kept_put
    _xcopy_verify_list_put
    if [ "${_XCOPY_IMPORT_FAIL:-0}" != "0" ]; then
      {
        echo "failed=${_XCOPY_IMPORT_FAIL}"
        echo "dbs=${_XCOPY_IMPORT_FAILED_DBS# }"
        echo "time=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
      } | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here import_failed.pid
      echo "ALRT: import for ${_oct}: ${_XCOPY_IMPORT_FAIL} site database import(s) FAILED or SKIPPED:${_XCOPY_IMPORT_FAILED_DBS}"
      echo "ERROR: their verifies were NOT scheduled; sites with clean loads were imported normally"
      echo "ERROR: recovery -- fix the cause (re-export/re-transfer the failed dumps if hollow), then:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xcopy import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}"
      echo "ERROR: (safe: the full import re-run re-imports from the same transferred dumps)"
      _XCOPY_RUN_FAIL=YES
    else
      _xcopy_in_real_dir "${_USR}/log" rm -f -- ./import_failed.pid
    fi
  fi
  _xcopy_sql_maint_release
  echo Done ${_cmd} for ${_USR}
  _xcopy_chattr_back
}

# --- storage-aware store relocation (attached /mnt vs root, source vs target) ------
#
# A store directory (static/files, arch, or a legacy /mnt-anchored symlink) is
# transferred to the target honouring BOTH sides' disk reality:
#   source on a mount (symlink -> /mnt/...) + target HAS a mount -> MIRROR onto the
#       target mount and re-point the link there (even if root has room)
#   source on a mount + target has NO mount                      -> DE-REFERENCE to a
#       real dir on the target root
#   source a real dir on root                                    -> keep a real dir on
#       root; use the target mount only as a fallback if root cannot fit it
# DENY (non-zero) only when: a source symlink is dangling (attached disk not mounted),
# the target has MULTIPLE /mnt mounts, or the store fits nowhere.

# Print the target's single attached mountpoint under /mnt, "MULTI" if more than one,
# or nothing if none. Same detection migratefs + the lshell FTP-jail use.
# Prints "MULTI" (more than one), the single mountpoint path, or "NONE" (zero mounts).
# Empty output therefore means ONLY that the ssh query itself failed -> caller aborts,
# so a transient ssh hiccup never silently downgrades a mirror to a root de-reference.
# It is the first contact of pretransfer and transfer: a target that does not answer
# is given up after 15 s, not after the system's TCP connect timeout (about two minutes).
_xcopy_detect_target_mnt() {
  ssh -o ConnectTimeout=15 root@"$1" 'p=$(stat -c "%d" /mnt 2>/dev/null); n=0; h=""; for m in /mnt/*; do [ -d "$m" ] || continue; if mountpoint -q "$m" 2>/dev/null || { [ -n "$p" ] && [ "$(stat -c "%d" "$m" 2>/dev/null)" != "$p" ]; }; then h="$m"; n=$((n+1)); fi; done; if [ "$n" -gt 1 ]; then echo MULTI; elif [ "$n" -eq 1 ]; then printf "%s" "$h"; else echo NONE; fi'
}

# Resolve the target's attached mount into _TGT_MNT ("" = none), aborting the run on a
# failed query, an empty target host, or more than one mount. $1 = target host.
_xcopy_resolve_target_mnt() {
  local _raw _e _said=""
  if [ -z "$1" ]; then
    echo "ERROR: empty target host — refusing"
    exit 1
  fi
  # the client's own words are kept and shown as before; a target whose key
  # is not the one held here for its address is named as that
  if _e="$(mktemp /tmp/mig-said.XXXXXX 2> /dev/null)"; then
    _raw="$(_xcopy_detect_target_mnt "$1" 2> "${_e}")"
    _said="$(cat "${_e}" 2> /dev/null)"
    rm -f "${_e}"
    [ -z "${_said}" ] || printf '%s\n' "${_said}" >&2
  else
    _raw="$(_xcopy_detect_target_mnt "$1")"
  fi
  case "${_raw}" in
    MULTI)
      echo "ERROR: target $1 has multiple /mnt mounts; BOA supports a single attached mount — refusing"
      exit 1
      ;;
    NONE) _TGT_MNT="" ;;
    "")
      if _mig_hostkey_changed "$1" "${_said}"; then
        echo "ERROR: target $1 serves a host key that is not the one this box holds for that address"
        echo "ERROR: (${_MIG_HOSTKEY_SAYS}) — refusing. Make the check named above,"
        echo "ERROR: forget the old entries here, then run this command again"
        exit 1
      fi
      echo "ERROR: could not query /mnt on target $1 (ssh failed?) — refusing"
      exit 1
      ;;
    *) _TGT_MNT="${_raw}" ;;
  esac
}

# 0 if the target filesystem that would host <dest> (nearest existing ancestor) has
# room for <needKB>. Unknown size or unknown avail -> assume ok (do not block).
# --- DRY/live gate (autosymlink --batch model, keyed per account+target) -----------
# Default is a read-only DRY run that records CLEAN/NOT_CLEAN; --live proceeds only if
# the last run for THIS account+target was a CLEAN DRY, then invalidates it so one dry
# can never arm two lives.
_xcopy_state_file() {
  local _key
  _key="$(printf '%s_%s' "$1" "$2" | tr -c 'A-Za-z0-9._-' '_')"
  printf '/var/log/boa/xcopy.migrate.%s.state' "${_key}"
}
_xcopy_write_state() {   # 1 oct 2 tgt 3 status 4 mode
  local _sf; _sf="$(_xcopy_state_file "$1" "$2")"
  mkdir -p /var/log/boa 2>/dev/null
  { echo "_LAST_MODE=$4"; echo "_LAST_STATUS=$3"; echo "_LAST_TS=$(date '+%Y-%m-%d %H:%M:%S')"; } > "${_sf}"
}
_xcopy_require_clean_dry() {   # 1 oct 2 tgt -- exit unless last run was a CLEAN DRY
  local _sf _m _s; _sf="$(_xcopy_state_file "$1" "$2")"
  if [ ! -f "${_sf}" ]; then
    echo "ERROR: --live requires a prior CLEAN dry run for ${1} -> ${2}; run without --live first"
    exit 1
  fi
  _m=$(grep '^_LAST_MODE=' "${_sf}" | head -n1 | cut -d= -f2-)
  _s=$(grep '^_LAST_STATUS=' "${_sf}" | head -n1 | cut -d= -f2-)
  if [ "${_m}" != "DRY" ] || [ "${_s}" != "CLEAN" ]; then
    echo "ERROR: --live needs the last run for ${1} -> ${2} to be a CLEAN dry run (got mode=${_m:-none} status=${_s:-none}); re-run the dry run and clear any DENY first"
    exit 1
  fi
  _xcopy_write_state "$1" "$2" "LIVE" "LIVE"   # consume the clean-dry token
}
_xcopy_finalize_dry() {   # 1 oct 2 tgt
  if [ "${_XCOPY_NOT_CLEAN}" = "NO" ]; then
    echo "[DRY] CLEAN: no blocking issues. Re-run the same command with --live to perform the migration."
    _xcopy_write_state "$1" "$2" "CLEAN" "DRY"
  else
    echo "[DRY] NOT CLEAN: see DENY line(s) above. --live is refused until resolved."
    _xcopy_write_state "$1" "$2" "NOT_CLEAN" "DRY"
  fi
}
# An account's static/control is its main login's, and oN owns the rest of
# /data/disk/oN (log/, .drush): either can put a link or a FIFO at any name
# there, or at the directory itself. Root reads and writes those names only
# through these. Run "$@" inside the real directory $1: below /data/disk and
# /home every name on the path must be a real directory; once entered,
# ./name stays there whatever is swapped.
_xcopy_in_real_dir() {
  local _d="${1}" _want
  shift
  _want="$(_xcopy_real_want "${_d}")"
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_want}" ] && "$@" )
}
# ./$1 in the current (pinned) directory: never through a link, never
# blocked on a FIFO, at most 1 MiB; empty for anything else.
_xcopy_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2> /dev/null
}
# ./$1 in the current (pinned) directory, printed only when it is a regular
# file owned by root with one link, checked on the one handle that reads it
# (at most 1 MiB): an account can put a file of its own at a name in a
# directory it owns.
_xcopy_read_root_here() {
  perl -e 'use Fcntl; sysopen(my $h, $ARGV[0], O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit 1; my @s = stat($h) or exit 1; exit 1 unless -f _ && $s[4] == 0 && $s[3] == 1; my $d = ""; defined(read($h, $d, 1048576)) or exit 1; print $d; exit 0' -- "./${1}"
}
# The words of $1 that are host names (letters, digits, dots, dashes, a
# leading wildcard), space-separated; anything else is dropped. The words
# are split without file name expansion, so a wildcard name stays as is.
_xcopy_host_words() {
  local _w _o=""
  local -a _ws
  IFS=$' \t\n' read -r -d '' -a _ws <<< "${1}"
  for _w in "${_ws[@]}"; do
    [[ "${_w}" =~ ^[A-Za-z0-9*][A-Za-z0-9.*-]*$ ]] || continue
    [ "${#_w}" -le 253 ] || continue
    _o="${_o} ${_w}"
  done
  printf '%s' "${_o# }"
}
# $2 in the real directory $1, read as _xcopy_read_here reads it.
_xcopy_read_in() {
  _xcopy_in_real_dir "${1}" _xcopy_read_here "${2}"
}
# ./$1 in the current (pinned) directory with exactly the bytes read from
# stdin (0644): a fresh file created exclusively, then renamed over the name,
# so a link or FIFO put there is replaced, never followed or opened.
_xcopy_write_here() {
  local _t="./.${1}.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  ( umask 022
    dd of="${_t}" conv=excl status=none 2> /dev/null ) \
    && mv -f -T -- "${_t}" "./${1}" && return 0
  rm -f -- "${_t}"
  return 1
}
# ./$1 in the current (pinned) directory as an empty marker, put the same way.
_xcopy_touch_here() {
  _xcopy_write_here "${1}" < /dev/null
}

# The file ./$1 (never there before) created with the bytes read from stdin,
# the owner $2:$3 (numeric; -1 keeps root's) and the read/write bits of the
# mode $4, all through the one handle that created it, opened
# O_EXCL|O_NOFOLLOW: nothing is ever chowned or chmodded by name in a
# directory the account can write (a hard link renamed over the name before a
# chown by name would hand another file to that owner).
_XCOPY_PUT_PL='use Fcntl; my ($n, $u, $g, $m) = @ARGV; local $/; my $d = <STDIN>; sysopen(my $h, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; (print {$h} $d) or exit 1; chown($u, $g, $h) or exit 1; chmod(oct($m) & 0666, $h) or exit 1; close($h) or exit 1; exit 0'
# The same rule on the target box: the commands $3 run on the target $1
# inside the real directory $2 (below /data/disk or /home every name on the
# path a real directory), where _rr reads a name without following a link or
# blocking on a FIFO and _rp puts one as a fresh file through _XCOPY_PUT_PL,
# renamed over the name (empty when no content is given; $3 the owner:group
# it is created with, root's when empty or when it does not resolve). The
# target account is the tenant's once its identity has travelled. The perl
# text is spliced in unquoted here, so it lands on the target inside single
# quotes.
_XCOPY_REMOTE_CTRL_FN='_rr() { timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2> /dev/null; }
_rp() { local _t="./.${1}.put.$$.${RANDOM}" _u=-1 _g=-1; if [ -n "${3}" ]; then _u="$(id -u -- "${3%%:*}" 2> /dev/null)"; _g="$(getent group "${3#*:}" 2> /dev/null | cut -d: -f3)"; case "${_u}:${_g}" in :*|*:|*[!0-9:]*) _u=-1; _g=-1 ;; esac; fi; rm -f -- "${_t}"; if { [ -n "${2}" ] && printf "%s\n" "${2}"; true; } | perl -e '"'${_XCOPY_PUT_PL}'"' "${_t}" "${_u}" "${_g}" 644 && mv -f -T -- "${_t}" "./${1}"; then return 0; fi; rm -f -- "${_t}"; return 1; }'
_xcopy_remote_in() {
  local _a=/data/disk
  case "${2}" in /home/?*) _a=/home ;; esac
  ssh root@"${1}" "${_XCOPY_REMOTE_CTRL_FN}
_w=\"\$(cd -P ${_a} 2> /dev/null && /bin/pwd -P)${2#"${_a}"}\"
cd -P -- \"${2}\" 2> /dev/null && [ \"\$(/bin/pwd -P)\" = \"\${_w}\" ] && { ${3}; }"
}
# The commands $3 inside the real static/control of the account $2 there.
_xcopy_remote_ctrl() {
  _xcopy_remote_in "${1}" "/data/disk/${2}/static/control" "${3}"
}
# An --rsync-path that starts the receiving rsync on the target inside the
# real directory $1, so the destination is given as ./ and never resolves
# through a link the account put there; the copy fails when $1 is not that
# directory.
_xcopy_rsync_path_in() {
  local _a=/data/disk
  case "${1}" in
    /home/?*) _a=/home ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  printf '%s' "cd -P -- '${1}' && [ \"\$(/bin/pwd -P)\" = \"\$(cd -P ${_a} && /bin/pwd -P)${1#"${_a}"}\" ] && rsync"
}
# The entries of the current (pinned) directory the glob $3 names (empty:
# the directory's contents), expanded here, copied with the rsync options
# that follow into the real directory $2 on the target $1: neither end
# resolves a name on its path through a link the account put there.
_xcopy_copy_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xcopy_rsync "$@" --rsync-path="$(_xcopy_rsync_path_in "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
# As _xcopy_rsync_path_in, but the last name of $1 is made a real directory
# first (a link the account put there is removed, a missing directory made):
# for a leg whose target directory the install does not create.
_xcopy_rsync_path_mk_in() {
  local _d="${1}" _a=/data/disk _p _n
  case "${_d}" in
    /home/?*) _a=/home ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  _p="${_d%/*}"
  _n="${_d##*/}"
  printf '%s' "_a=\"\$(cd -P ${_a} && /bin/pwd -P)\"; cd -P -- '${_p}' && [ \"\$(/bin/pwd -P)\" = \"\${_a}${_p#"${_a}"}\" ] && { [ -L './${_n}' ] && rm -f './${_n}'; [ -d './${_n}' ] || mkdir './${_n}'; } && cd -P -- './${_n}' && [ \"\$(/bin/pwd -P)\" = \"\${_a}${_d#"${_a}"}\" ] && rsync"
}
# The entries of the current (pinned) directory the glob $3 names copied into
# the real directory $2 on the target $1, the target directory created when
# missing (a link there removed first).
_xcopy_copy_mk_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xcopy_rsync "$@" --rsync-path="$(_xcopy_rsync_path_mk_in "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
### Where the directory $1 resolves when every name on its path below
### /data/disk, /home or /opt/user (the client toolchain trees) is a real
### directory; elsewhere, its last name inside its resolved parent.
_xcopy_real_want() {
  local _d="${1}" _a=""
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  if [ -n "${_a}" ]; then
    printf '%s' "$(cd -P -- "${_a}" 2> /dev/null && /bin/pwd -P)${_d#"${_a}"}"
  else
    printf '%s' "$(cd -P -- "${_d%/*}" 2> /dev/null && /bin/pwd -P)/${_d##*/}"
  fi
}
### "$@" run inside the canonical directory $1, only once pwd -P lands
### exactly there.
_xcopy_in_canon_dir() {
  local _d="${1}"
  shift
  case "${_d}" in
    /?*) ;;
    *) return 1 ;;
  esac
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_d}" ] && "$@" )
}
### The --rsync-path that starts the receiver inside the canonical directory
### $1 on the target, and only once pwd -P says it is there.
_xcopy_canon_rpath() {
  local _q
  _q="$(_shq "${1}")"
  printf '%s' "cd -P -- '${_q}' && [ \"\$(/bin/pwd -P)\" = '${_q}' ] && rsync"
}
### Whether the canonical path $2 belongs to the account $1: its own tree,
### or its own part of an attached store, <mount>/files/<oN>/, the layout
### migratefs moves static/files to. Another account's tree or store, and
### anything else a link can name, never passes. On a box whose /mnt is a
### link, a path under the place it names is read as the same path under
### /mnt (root's link, never one into / or /data).
_xcopy_own_path() {
  local _a="${1}" _p="${2}" _t _r _m
  case "${_a}" in
    ''|.|..|*/*) return 1 ;;
  esac
  case "${_p}" in
    /?*) ;;
    *) return 1 ;;
  esac
  case "${_p}/" in
    *//*|*/./*|*/../*) return 1 ;;
  esac
  _t="$(_xcopy_real_want "/data/disk/${_a}")"
  if [ "${_t}" != "/${_a}" ]; then
    case "${_p}/" in
      "${_t}"/*) return 0 ;;
    esac
  fi
  if [ -L /mnt ]; then
    _m="$(cd -P -- /mnt 2> /dev/null && /bin/pwd -P)"
    case "${_m}" in
      ''|/|/mnt|/data|/data/*) ;;
      *)
        case "${_p}/" in
          "${_m}"/?*) _p="/mnt${_p#"${_m}"}" ;;
        esac
        ;;
    esac
  fi
  case "${_p}" in
    /mnt/?*/files/?*)
      _r="${_p#/mnt/}"
      _r="${_r#*/}"
      case "${_r}/" in
        "files/${_a}"/*) return 0 ;;
      esac
      ;;
  esac
  return 1
}
### The canonical path $2 is the account $1's own ($3 = tree: its tree or
### store; uid: also anything owned by one of its identities, <oN>,
### <oN>.ftp or a sub-user <oN>.<name>).
_xcopy_store_is_own() {
  local _o
  _xcopy_own_path "${1}" "${2}" && return 0
  [ "${3}" = "uid" ] || return 1
  _o="$(stat -c '%U' -- "${2}" 2> /dev/null)" || return 1
  case "${_o}" in
    "${1}"|"${1}".?*) return 0 ;;
  esac
  return 1
}
### Run on the target with the account's name in $1: enter the real parent
### of $2, made as mkdir -p makes it, once the nearest existing name on the
### way and then the parent itself resolve into the account's own tree or
### store. Run in the shell that then acts on ./<last name>.
_xcopy_own_parent_cd() {
  local _a="${1}" _p="${2%/*}" _e
  [ -n "${_p}" ] || return 1
  _e="${_p}"
  while [ -n "${_e}" ] && [ ! -e "${_e}" ]; do
    _e="${_e%/*}"
  done
  _xcopy_own_path "${_a}" "$(cd -P -- "${_e:-/}" 2> /dev/null && /bin/pwd -P)" \
    || return 1
  mkdir -p -- "${_p}" 2> /dev/null
  cd -P -- "${_p}" 2> /dev/null || return 1
  _xcopy_own_path "${_a}" "$(/bin/pwd -P)"
}
### Run there as above: make the directory $3 of the account $2 ready for a
### copy and print XCREAL with its canonical path. A link at the last name
### stays when it resolves into the account's own tree or store and $1 is
### keep (the backups mover's link); otherwise it gives way to a directory.
_xcopy_own_dir_ready() {
  local _m="${1}" _a="${2}" _n="${3##*/}" _r
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xcopy_own_parent_cd "${_a}" "${3}" || return 1
  if [ -L "./${_n}" ]; then
    _r="$(cd -P -- "./${_n}" 2> /dev/null && /bin/pwd -P)"
    if [ "${_m}" != "keep" ] || ! _xcopy_own_path "${_a}" "${_r}"; then
      rm -f -- "./${_n}" || return 1
    fi
  elif [ -e "./${_n}" ] && [ ! -d "./${_n}" ]; then
    rm -f -- "./${_n}" || return 1
  fi
  [ -d "./${_n}" ] || mkdir -- "./${_n}" || return 1
  cd -P -- "./${_n}" 2> /dev/null || return 1
  _r="$(/bin/pwd -P)"
  _xcopy_own_path "${_a}" "${_r}" || return 1
  printf 'XCREAL %s\n' "${_r}"
}
### Run there as above: put the link $2 -> $3 of the account $1 in place of
### whatever holds the name, inside its real parent.
_xcopy_own_link_ready() {
  local _n="${2##*/}"
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xcopy_own_parent_cd "${1}" "${2}" || return 1
  if [ -L "./${_n}" ]; then
    rm -f -- "./${_n}"
  elif [ -d "./${_n}" ]; then
    rm -rf -- "./${_n}"
  elif [ -e "./${_n}" ]; then
    rm -f -- "./${_n}"
  fi
  ln -sfn -- "${3}" "./${_n}" || return 1
  printf 'XCREAL %s/%s\n' "$(/bin/pwd -P)" "${_n}"
}
### Run there as above: link the account $1's name $2 to its store entry $3
### only once $3 is a directory in the account's own tree or store, so a
### directory at $2 never gives way to a link that leads nowhere.
_xcopy_own_store_link_ready() {
  _xcopy_own_path "${1}" "$(cd -P -- "${3}" 2> /dev/null && /bin/pwd -P)" || return 1
  _xcopy_own_link_ready "${1}" "${2}" "${3}"
}
### Run there: make each of the account $1's own control panel stores, the
### names in $4 (space-separated), in the store's new canonical directory $3
### an exact copy of the one at its old place $2, then print XCREAL with $3.
### A store moved between the root and the attached mount is built from the
### source alone, and the copy never sends a panel's store. Nothing at the
### old place is nothing to carry; a link there that leads nowhere (the
### volume not mounted) or out of the account's own tree or store is a
### refusal. Each copy is made in .<name>.carry beside the name, read from
### inside the real old directory and written inside the real new one, and
### only then put in the name's place: a copy cut short leaves the name as it
### was, and the next run starts it again. tar's own status 1 (a file changed
### or vanished as it was read: the panel is live there) is no failure.
_xcopy_own_panel_carry() {
  local _a="${1}" _o _n _p _t _m
  local -a _ps _st
  _n="$(cd -P -- "${3}" 2> /dev/null && /bin/pwd -P)" || return 1
  [ "${_n}" = "${3}" ] || return 1
  if [ ! -e "${2}" ] && [ ! -L "${2}" ]; then
    printf 'XCREAL %s\n' "${_n}"
    return 0
  fi
  _o="$(cd -P -- "${2}" 2> /dev/null && /bin/pwd -P)" || return 1
  if ! _xcopy_own_path "${_a}" "${_o}"; then
    # the account's part of the attached store through a /mnt that is a link
    _m="$(cd -P -- /mnt 2> /dev/null && /bin/pwd -P)"
    case "${_o}/" in
      "${_m}"/?*) _xcopy_own_path "${_a}" "/mnt${_o#"${_m}"}" || return 1 ;;
      *) return 1 ;;
    esac
  fi
  if [ "${_o}" != "${_n}" ]; then
    read -r -a _ps <<< "${4}" && [ "${#_ps[@]}" -gt 0 ] || return 1
    for _p in "${_ps[@]}"; do
      case "${_p}" in ''|.|..|*/*) continue ;; esac
      [ -d "${_o}/${_p}" ] && [ ! -L "${_o}/${_p}" ] || continue
      _t=".${_p}.carry"
      ( cd -P -- "${_n}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_n}" ] \
        && rm -rf -- "./${_t}" && mkdir -- "./${_t}" ) || return 1
      ( cd -P -- "${_o}/${_p}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_o}/${_p}" ] || exit 9
        tar -cf - --numeric-owner --acls --xattrs --one-file-system . ) \
        | ( cd -P -- "${_n}/${_t}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_n}/${_t}" ] || exit 9
          tar -xpf - --numeric-owner --acls --xattrs )
      _st=("${PIPESTATUS[@]}")
      if [ "${_st[0]:-9}" -gt 1 ] || [ "${_st[1]:-9}" -ne 0 ] \
        || ! ( cd -P -- "${_n}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_n}" ] \
          && rm -rf -- "./${_p}" && mv -T -- "./${_t}" "./${_p}" ); then
        ( cd -P -- "${_n}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_n}" ] && rm -rf -- "./${_t}" )
        return 1
      fi
    done
  fi
  printf 'XCREAL %s\n' "${_n}"
}
### Run there as _xcopy_own_dir_ready does (mode dir) for the store $2 of the
### account $1, carrying its own control panel stores (the names in $3) when
### a link holds the name: the store moves off the attached mount onto a real
### directory, which is made as .<name>.carry beside the name, given the
### panel stores from the link's own place (_xcopy_own_panel_carry) and only
### then put in the link's place. A link that leads nowhere or out of the
### account's own is refused, and a carry or a swap that fails leaves the
### link as it was.
_xcopy_own_dir_carry() {
  local _a="${1}" _n="${2##*/}" _lt _l _r _w _t
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xcopy_own_parent_cd "${_a}" "${2}" || return 1
  [ -L "./${_n}" ] || { _xcopy_own_dir_ready dir "${_a}" "${2}"; return $?; }
  [ -d "./${_n}" ] || return 1
  _lt="$(readlink -- "./${_n}")" || return 1
  _w="$(/bin/pwd -P)"
  _l="${_lt}"
  case "${_l}" in
    /*) ;;
    *) _l="${_w}/${_l}" ;;
  esac
  _t=".${_n}.carry"
  rm -rf -- "./${_t}" && mkdir -- "./${_t}" || return 1
  if ! _xcopy_own_panel_carry "${_a}" "${_l}" "${_w}/${_t}" "${3}" > /dev/null \
    || ! rm -f -- "./${_n}"; then
    rm -rf -- "./${_t}"
    return 1
  fi
  if ! mv -T -- "./${_t}" "./${_n}"; then
    ln -s -- "${_lt}" "./${_n}" 2> /dev/null
    rm -rf -- "./${_t}"
    return 1
  fi
  cd -P -- "./${_n}" 2> /dev/null || return 1
  _r="$(/bin/pwd -P)"
  _xcopy_own_path "${_a}" "${_r}" || return 1
  printf 'XCREAL %s\n' "${_r}"
}
### Run there: make the store copy's directory $1 under the attached mount
### and print XCREAL with its canonical path, only when no name below /mnt
### on the way is a link (checked before anything is made, and again after).
_xcopy_real_mnt_dir() {
  local _d="${1}" _c _e
  case "${_d}/" in
    /mnt/?*/?*) ;;
    *) return 1 ;;
  esac
  case "${_d}/" in
    *//*|*/./*|*/../*) return 1 ;;
  esac
  _c="$(cd -P -- /mnt 2> /dev/null && /bin/pwd -P)" || return 1
  [ -n "${_c}" ] || return 1
  _e="${_d}"
  while [ -n "${_e}" ] && [ ! -e "${_e}" ]; do
    _e="${_e%/*}"
  done
  [ "$(cd -P -- "${_e:-/}" 2> /dev/null && /bin/pwd -P)" = "${_c}${_e#/mnt}" ] || return 1
  mkdir -p -- "${_d}" 2> /dev/null
  _c="${_c}${_d#/mnt}"
  cd -P -- "${_d}" 2> /dev/null || return 1
  [ "$(/bin/pwd -P)" = "${_c}" ] || return 1
  printf 'XCREAL %s\n' "${_c}"
}
### Run one of the placement helpers above as root on the box $1, with the
### helper's name and arguments after it; prints the canonical path its
### XCREAL line names and fails when there is none.
_xcopy_tgt_place() {
  local _h="${1}" _out _x _args=""
  shift
  for _x in "$@"; do
    _args="${_args} '$(_shq "${_x}")'"
  done
  _out="$( { declare -f _xcopy_real_want _xcopy_own_path _xcopy_own_parent_cd \
      _xcopy_own_dir_ready _xcopy_own_link_ready _xcopy_own_store_link_ready \
      _xcopy_own_panel_carry _xcopy_own_dir_carry _xcopy_real_mnt_dir
    printf '%s\n' '"$@"'; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=30 root@"${_h}" \
      "bash -s --${_args}" 2> /dev/null)"
  _out="$(printf '%s\n' "${_out}" | grep -m1 '^XCREAL /')"
  [ -n "${_out}" ] || return 1
  printf '%s' "${_out#XCREAL }"
}
### A transfer leg's source directory $1: true when it is a real directory
### to copy from. A missing one is skipped quietly; one that is not a real
### directory (a link on its path) is refused: nothing is followed, the dry
### run is not clean and a live transfer is not complete.
_xcopy_leg_ok() {
  [ -e "${1}" ] || [ -L "${1}" ] || return 1
  _xcopy_in_real_dir "${1}" true && return 0
  echo "DENY: ${1} is not a real directory (a link on its path) -- not followed, not copied"
  _XCOPY_NOT_CLEAN=YES
  [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=1
  return 1
}
### backups/ or backup-exports/ ($5) of the account tree $1 carried to the
### account tree $2 on the target $3 ($4 the rsync error option). On a box
### whose files store sits on its own device the nightly moves both into
### static/files/.<name> and leaves a link: the store leg carries that
### content, so the link is reproduced on the target once the store copy is
### there, and only when it names one plain entry straight under
### static/files. Any other backups/ is copied from inside the real
### directory it resolves to when that is the account's own tree or store,
### into the target's backups/, whose mover link is kept when it resolves
### into the account's own tree or store there; anything else is refused.
### A backups/ link naming a path under /mnt is left to the /mnt link pass,
### which carries it once, fit-checked. backup-exports/ travels only as the
### mover link, as it always did.
_xcopy_backups_leg() {
  local _u="${1}" _d="${2}" _h="${3}" _ie="${4}" _n="${5}" _l _b _r _to _rc
  _l="$(readlink "${_u}/${_n}" 2> /dev/null)"
  _b="${_l#"${_u}/static/files/"}"
  if [ -L "${_u}/${_n}" ] && [ "${_b}" != "${_l}" ] \
    && [[ "${_b}" =~ ^[A-Za-z0-9._-]+$ ]] \
    && [ "${_b}" != "." ] && [ "${_b}" != ".." ]; then
    if [ "${_MODE}" = "LIVE" ]; then
      if ! _xcopy_tgt_place "${_h}" _xcopy_own_store_link_ready "${_d##*/}" "${_d}/${_n}" \
        "${_d}/static/files/${_b}" > /dev/null; then
        echo "DENY: ${_d}/${_n} on ${_h} not linked to static/files/${_b} (no store copy of it there in the account's own tree or store)"
        _XCOPY_NOT_CLEAN=YES
        _XCOPY_STORE_RC=1
        return 1
      fi
    else
      echo "[DRY-PLAN] would link ${_d}/${_n} -> ${_d}/static/files/${_b} on ${_h}"
    fi
    return 0
  fi
  [ "${_n}" = "backups" ] || return 0
  [ -e "${_u}/${_n}" ] || [ -L "${_u}/${_n}" ] || return 0
  if [ -L "${_u}/${_n}" ]; then
    case "${_l}" in
      /mnt/*) return 0 ;;
    esac
  fi
  _r="$(cd -P -- "${_u}/${_n}" 2> /dev/null && /bin/pwd -P)"
  if [ -z "${_r}" ] || ! _xcopy_own_path "${_u##*/}" "${_r}"; then
    echo "DENY: ${_u}/${_n} resolves to ${_r:-nothing}, outside the account's own tree and store -- not followed, not copied"
    _XCOPY_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=1
    return 1
  fi
  _to=""
  if [ "${_MODE}" = "LIVE" ]; then
    _to="$(_xcopy_tgt_place "${_h}" _xcopy_own_dir_ready keep "${_d##*/}" "${_d}/${_n}")"
    if [ -z "${_to}" ]; then
      echo "DENY: ${_d}/${_n} on ${_h} does not resolve into the account's own tree or store -- not copied"
      _XCOPY_NOT_CLEAN=YES
      _XCOPY_STORE_RC=1
      return 1
    fi
  fi
  ### an empty backups/ has nothing for the glob to name
  [ -n "$(_xcopy_in_canon_dir "${_r}" find . -mindepth 1 -maxdepth 1 \
    -name '[!.]*' -print -quit 2> /dev/null)" ] || return 0
  # shellcheck disable=SC2086
  _xcopy_in_canon_dir "${_r}" _xcopy_copy_canon_here "${_h}" "${_to:-${_d}/${_n}}" '*' \
    -aEAXqu ${_ie}
  _rc=$?
  ### 24: files that vanished while the copy ran (a rotated backup)
  if [ "${_rc}" != "0" ] && [ "${_rc}" != "24" ] && [ "${_MODE}" = "LIVE" ]; then
    echo "DENY: ${_u}/${_n} copy to ${_h} failed (rc ${_rc})"
    _XCOPY_NOT_CLEAN=YES
    _XCOPY_STORE_RC=1
    return 1
  fi
  return 0
}
### As _xcopy_copy_here, but the receiver starts in the canonical directory $2
### the target reported (see _xcopy_tgt_place).
_xcopy_copy_canon_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xcopy_rsync "$@" --rsync-path="$(_xcopy_canon_rpath "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
# ./$1 in the current (pinned) directory put at ./$2 through sed "${@:3}".
# The source is read through one handle opened O_NOFOLLOW|O_NONBLOCK that
# must be a regular file with one link under 1 MiB; the owner, group and mode
# are taken from that same handle (the first line the reader prints), never
# from a stat by name, so a name swapped between the look and the read never
# lends its bytes another file's owner. The result is a fresh file with that
# numeric owner and the read/write bits of that mode, put through
# _XCOPY_PUT_PL (one handle creates, writes, owns and modes it), renamed over
# ./$2: nothing is chowned or chmodded by name. The reader text stays in the
# function, as in the copies that are shipped to the other box. For a plain
# file this is what sed -i (and cp -a, empty program) wrote, without their
# reach through a link put at the name.
_xcopy_sed_to() {
  local _s="${1}" _n="${2}" _t _u _g _m _h
  local _rd='use Fcntl; my ($n) = @ARGV; sysopen(my $h, $n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit 1; my @s = stat($h); exit 1 unless @s && -f _ && $s[3] == 1 && $s[7] < 1048576; my ($d, $r) = (""); while ($r = sysread($h, my $c, 65536)) { $d .= $c; exit 1 if length($d) >= 1048576; } exit 1 unless defined $r; close($h); binmode(STDOUT); printf("%d %d %o\n", $s[4], $s[5], $s[2] & 07777) or exit 1; (print $d) or exit 1; exit 0'
  shift 2
  _t="./.${_n}.sed.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    perl -e "${_rd}" "./${_s}" 2> /dev/null | {
      _h=""
      IFS=' ' read -r _u _g _m _h || exit 1
      [[ "${_u}" =~ ^[0-9]+$ ]] && [[ "${_g}" =~ ^[0-9]+$ ]] \
        && [[ "${_m}" =~ ^[0-7]+$ ]] && [ -z "${_h}" ] || exit 1
      sed "$@" | perl -e "${_XCOPY_PUT_PL}" "${_t}" "${_u}" "${_g}" "${_m}"
    } ) && mv -f -T -- "${_t}" "./${_n}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# ./$1 rewritten in place by sed "${@:2}", as _xcopy_sed_to does it.
_xcopy_sed_here() {
  local _n="${1}"
  shift
  _xcopy_sed_to "${_n}" "${_n}" "$@"
}
# ./$2 built from the template file $1 (absolute, root-owned) piped through
# sed "${@:4}" into a fresh file put through _XCOPY_PUT_PL, 0600 and owned by
# $3 (owner:group; root's when it does not resolve) from the start, renamed
# over the name: a link put at the destination is replaced, never written
# through, and nothing is chowned by name afterwards.
_xcopy_tpl_to_here() {
  local _tpl="${1}" _n="${2}" _ids _t
  _ids="$(_xcopy_owner_ids "${3}")" || _ids="-1 -1"
  shift 3
  _t="./.${_n}.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    sed "$@" -- "${_tpl}" \
      | perl -e "${_XCOPY_PUT_PL}" "${_t}" "${_ids% *}" "${_ids#* }" 600 ); then
    mv -f -T -- "${_t}" "./${_n}" && return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# $1 as the directory root works in: itself when it is a real directory;
# when it is a link, the real directory it leads to, only when every link
# on the way is root's and every directory on the way, the last one
# included, is root's and writable by no one else, so no one but root can
# change where it leads or what is in it; nothing otherwise (exit 1). The
# shared store /data/all may be such a link. With a second argument "last"
# the last directory may be anyone's and open to others (the Octopus store
# check takes /data/disk/all back); none is given here.
_ROOT_REAL_PATH_PL='my ($p, $k) = @ARGV; if (!-l $p) { print $p if -d _; exit(-d _ ? 0 : 1); } my ($c, $n, @s) = ("", 0, stat("/")); exit 1 unless $p =~ m{^/} && @s && $s[4] == 0 && !($s[2] & 022); my @w = grep { length && $_ ne "." } split(m{/}, $p); while (@w) { my $e = shift(@w); if ($e eq "..") { $c =~ s{/[^/]*$}{}; next; } my @l = lstat("$c/$e") or exit 1; if (-l _) { exit 1 if $l[4] != 0 || ++$n > 40; my $t = readlink("$c/$e"); exit 1 unless defined $t; $c = "" if $t =~ m{^/}; unshift(@w, grep { length && $_ ne "." } split(m{/}, $t)); next; } exit 1 unless -d _ && (($l[4] == 0 && !($l[2] & 022)) || (defined $k && $k eq "last" && !@w)); $c .= "/$e"; } print($c eq "" ? "/" : $c); exit 0'
# $1, the real directory a link of root's at /data/all leads to
# (_ROOT_REAL_PATH_PL's answer), is the one the store may be kept in
# behind that link (exit 0) only when it is /data/disk/all, the directory
# named all directly in the real /data/disk, compared by device and inode
# with that name not followed, so a link put at it does not count; any
# other directory, or none, exit 1. Besides a real /data/all it is the
# one layout of the store BOA knows, and the one other store directory
# every PHP-FPM pool's open_basedir names. One text wherever it is defined
# (satellite.sh.inc, BOA.sh.txt, xoct, xcopy, manage_solr_config.sh,
# night.inc.sh).
_SAT_STORE_TARGET_PL='my @t = lstat(defined $ARGV[0] ? $ARGV[0] : ""); my @a = lstat("/data/disk/all"); exit((@t && @a && -d _ && $t[0] == $a[0] && $t[1] == $a[1]) ? 0 : 1)'
# chmod $1 on the regular files ./$2 ... of the current (pinned) directory
# WITHOUT following a link, and only on a file with one link, so a hard link
# to another file put at a name is skipped too.
_XCOPY_FCHMOD_PL='use Fcntl;
my $m = shift @ARGV;
for my $f (@ARGV) {
  sysopen(my $h, $f, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
  my @s = stat($h);
  chmod(oct($m), $h) if @s && -f _ && $s[3] == 1;
  close($h);
}'
_xcopy_fchmod_here() {
  local _m="${1}"
  shift
  [ "$#" -gt 0 ] || return 0
  perl -e "${_XCOPY_FCHMOD_PL}" "${_m}" "$@" 2> /dev/null
}
# The numeric uid and gid of owner:group $1 as "uid gid"; status 1, and
# nothing, when either does not resolve.
_xcopy_owner_ids() {
  local _u _g
  _u="$(id -u -- "${1%%:*}" 2> /dev/null)"
  _g="$(getent group "${1#*:}" 2> /dev/null | cut -d: -f3)"
  [[ "${_u}" =~ ^[0-9]+$ ]] && [[ "${_g}" =~ ^[0-9]+$ ]] || return 1
  printf '%s %s\n' "${_u}" "${_g}"
}
# The owner $1:$2 (numeric; -1 leaves it) and the mode $3 (none when empty)
# re-asserted on each existing name ./$5 ... through one handle opened
# O_NOFOLLOW|O_NONBLOCK, and only when that handle is a regular file with one
# link whose owner is already $1 or one of the uids in the comma-separated
# $4: a link, a FIFO, a hard link to another file, or a file of some other
# identity (root's included: a root-only file renamed onto the name is never
# handed over) is left as it is, never handed to the account or chmodded.
# What root puts for the account is created with its final owner instead.
_XCOPY_REASSERT_PL='use Fcntl; my ($u, $g, $m, $x, @f) = @ARGV; my %ok = map { $_ => 1 } ($u, split(/,/, $x)); for my $f (@f) { sysopen(my $h, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or next; my @s = stat($h); if (@s && -f _ && $s[3] == 1 && $ok{$s[4]}) { chown($u, $g, $h) if $u >= 0; chmod(oct($m), $h) if length $m; } close($h); } exit 0'
# Re-assert owner:group $1 and mode $2 on the regular file ./$3 of the current
# (pinned) directory through _XCOPY_REASSERT_PL: only a regular file with one
# link, owned already by $1, is changed, through the handle that checked it,
# so a link, a hard link to another file or another identity's file (root's
# too) the account put at the name is never handed to the account or
# chmodded. An owner that does not resolve changes nothing.
_xcopy_reassert_here() {
  local _own="${1}" _m="${2}" _n="${3}" _ids
  _ids="$(_xcopy_owner_ids "${_own}")" || _ids="-1 -1"
  perl -e "${_XCOPY_REASSERT_PL}" -- "${_ids% *}" "${_ids#* }" "${_m}" "" \
    "./${_n}" 2> /dev/null
  return 0
}
# The same, run inside the real vhost.d directory $1. $2 owner:group, $3 the
# vhost name, $4 the mode (default 600).
_xcopy_vhd_reassert() {
  _xcopy_in_real_dir "${1}" _xcopy_reassert_here "${2}" "${4:-600}" "${3}"
}
# The account proves it owns a database by logging in as its own user and
# using it (BOA sets db_user == db_name). $1 = db (== user), $2 = password.
_xcopy_cred_ok() {
  [ -n "$1" ] && [ -n "$2" ] \
    && mysql -u"$1" -p"$2" -h"${_SQL_CONNECT:-localhost}" \
      -P"${_THIS_DB_PORT:-3306}" --protocol=tcp -N -B \
      -e "USE \`$1\`" > /dev/null 2>&1
}
# A grant ON a database reads _ and % in its name as wildcards: `a_b`.* also
# covers aXb, with ALL there. A site user is granted its own name escaped,
# as provisioning grants it (grant_privileges); names reach here as
# [a-zA-Z0-9_] only, so _ is all there is to escape.
_xcopy_db_grant_name() {
  printf '%s' "${1//_/\\_}"
}
# Once the exact grant is in place, a wildcard grant an earlier run left on
# the same name ($1, also the user) at the host $2 goes, as provisioning
# converges it (revoke_wildcard_db_grant): only when SHOW GRANTS lists it,
# and revoked as it is stored, its grant option too (a db-level REVOKE takes
# ALL and GRANT OPTION only as two statements; the second fails harmlessly
# where there was none).
_xcopy_db_revoke_wildcard() {
  local _g
  [[ "${1}" == *_* ]] || return 0
  _g=$(mysql --silent -u root -h"${_SQL_CONNECT}" -P"${_THIS_DB_PORT}" --protocol=tcp \
    -N -B -e "SHOW GRANTS FOR '${1}'@'${2}'" 2> /dev/null)
  printf '%s\n' "${_g}" | grep -qF "ON \`${1}\`.* TO " || return 0
  mysql --silent -u root -h"${_SQL_CONNECT}" -P"${_THIS_DB_PORT}" --protocol=tcp \
    -e "REVOKE ALL PRIVILEGES ON \`${1}\`.* FROM '${1}'@'${2}'; \
        REVOKE GRANT OPTION ON \`${1}\`.* FROM '${1}'@'${2}';" &> /dev/null
}
# The real (non-link) subdirectory names of the current (pinned) directory.
_xcopy_real_subdirs_here() {
  local _e
  for _e in ./*; do
    [ -d "${_e}" ] && [ ! -L "${_e}" ] && printf '%s\n' "${_e#./}"
  done
}
# clients/ ($1) is oN's: enter only real client subdirectories, remove only
# their own ./backups, then prune dangling links from inside the real dir --
# never rm -rf or symlinks -dr through a link at clients or a client name.
_xcopy_clean_clients() {
  local _cd="${1}" _c
  _xcopy_in_real_dir "${_cd}" true || return 0
  _xcopy_in_real_dir "${_cd}" _xcopy_real_subdirs_here | while IFS= read -r _c; do
    [ -n "${_c}" ] || continue
    _xcopy_in_real_dir "${_cd}/${_c}" rm -rf -- ./backups
  done
  _xcopy_in_real_dir "${_cd}" symlinks -dr .
}
# ./$1 made a real directory in the current (pinned) parent: a link the account
# put at the name is removed, a missing directory created.
_xcopy_realdir_here() {
  [ -L "./${1}" ] && rm -f -- "./${1}"
  [ -d "./${1}" ] || mkdir -p -- "./${1}"
}
# The whole regular file ./$1 of the current (pinned) directory streamed to
# stdout without following a link (unbounded, for a DB dump): a link put at the
# name yields nothing, a FIFO never blocks past the read.
_xcopy_cat_here() {
  dd if="./${1}" iflag=nofollow,nonblock status=none 2> /dev/null
}
# The hostmaster dump the command "$@" writes on stdout, captured into the
# current (pinned) src/ directory as a fresh exclusive file renamed over
# ./prev_hostmaster.sql: the command's exit code survives the pipe, a link the
# account put at the name is replaced, and a zero-byte result is refused.
_xcopy_dump_hm_here() {
  local _t="./.prev_hostmaster.sql.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    umask 077
    "$@" | dd of="${_t}" conv=excl status=none 2> /dev/null ) \
    && [ -s "${_t}" ]; then
    mv -f -T -- "${_t}" ./prev_hostmaster.sql && return 0
  fi
  rm -f -- "${_t}"
  return 1
}
# The hostmaster dump never carries the dumping server's GTID state. By
# default (--set-gtid-purged=AUTO) a dump taken while GTID is on (every
# box an xmass run touched: BOA's my.cnf leaves it off, xmass_gtid.cnf
# turns it on) opens with SET @@SESSION.SQL_LOG_BIN=0 and sets
# @@GLOBAL.GTID_PURGED. Its import then fails on a box that shares that
# history (a move back, a failback, a chained move: ERROR 3546 on 8.x),
# and where it passes it stays out of that box's binary log, so a replica
# of the box never gets the panel. OFF writes neither. Sets _MYSQLDUMP_GTID
# to the option when the local mysqldump takes it: one that does not
# (MariaDB's) would refuse it and writes neither anyway, so it is asked,
# never assumed.
_mysqldump_gtid_opts() {
  _MYSQLDUMP_GTID=()
  if mysqldump --help 2> /dev/null | grep -q -- '--set-gtid-purged'; then
    _MYSQLDUMP_GTID=(--set-gtid-purged=OFF)
  fi
  return 0
}
### A site's database load is written to the binary log. myloader opens
### every session with SET SQL_LOG_BIN=0 unless told otherwise, so on a box
### running with the binary log on (every box an xmass run touched: BOA's
### my.cnf leaves it off, xmass_gtid.cnf turns it on) the load never
### reached a replica of the box, whose applier then stopped at the first
### replicated write to the tables it never got. --ignore-set=SQL_LOG_BIN
### drops that one session variable wherever it comes from (myloader's own
### default, or the packaged /etc/mydumper.cnf for a call without an option
### file); --enable-binlog is no substitute: that file sets it again, and
### the 0.19.3 line refuses the option. With the binary log off it changes
### nothing. Sets _MYLOADER_BINLOG to the option when the local myloader
### lists it, so a build without it gets its arguments as before.
_myloader_binlog_opts() {
  _MYLOADER_BINLOG=()
  if myloader --help 2>&1 | grep -qE -- '^[[:space:]]+--ignore-set([[:space:]]|=)'; then
    _MYLOADER_BINLOG=(--ignore-set=SQL_LOG_BIN)
  fi
  return 0
}
### A Percona 5.7 dump names a utf8mb4 table's character set and no
### collation (utf8mb4_general_ci was that set's default there). Loaded on
### 8.0 or later, such a table and every column of it took that server's
### default, utf8mb4_0900_ai_ci: the copy no longer matched its source, nor
### what an in-place upgrade of the source keeps, and a join on columns of
### two collations fails (error 1267). A dump made on 8.0 or later names the
### collation of every utf8mb4 table, so the old default changes nothing for
### it. On a server that has the setting, _MYLOADER_UTF8MB4 is the option
### file that adds the old default to myloader's own session settings (it
### replaces none of them; written when missing or different); on 5.7 it
### stays empty. Worked out once per run, and a myloader that cannot be given
### the file is named once. A client load asks its own server
### (_mig_utf8mb4_client_opt).
_MIG_UTF8MB4_DONE=""
_MYLOADER_UTF8MB4=()
_myloader_utf8mb4_opts() {
  local _f=/etc/boa/myloader-utf8mb4.cnf _want _tmp
  [ -n "${_MIG_UTF8MB4_DONE}" ] && return 0
  _MIG_UTF8MB4_DONE=YES
  _MYLOADER_UTF8MB4=()
  [ -n "$(mysql --silent -u root -N -B -e 'SELECT @@SESSION.default_collation_for_utf8mb4' 2> /dev/null)" ] \
    || return 0
  _want=$'[myloader_session_variables]\ndefault_collation_for_utf8mb4 = utf8mb4_general_ci'
  if myloader --help 2>&1 | grep -qE -- '^[[:space:]]+--defaults-extra-file([[:space:]]|=|$)' \
    && [[ ! -d "${_f}" ]]; then
    if [[ ! -f "${_f}" || -L "${_f}" || "$(cat "${_f}" 2> /dev/null)" != "${_want}" ]]; then
      mkdir -p "${_f%/*}" 2> /dev/null
      _tmp=$(mktemp "${_f}.XXXXXX" 2> /dev/null)
      if [ -n "${_tmp}" ] \
        && printf '%s\n' "${_want}" > "${_tmp}" && chmod 644 "${_tmp}" && mv -f "${_tmp}" "${_f}"; then
        _MYLOADER_UTF8MB4=(--defaults-extra-file="${_f}")
      else
        rm -f "${_tmp}"
      fi
    else
      _MYLOADER_UTF8MB4=(--defaults-extra-file="${_f}")
    fi
  fi
  if [ "${#_MYLOADER_UTF8MB4[@]}" -eq 0 ]; then
    echo "WARN: myloader here cannot be given ${_f}: a utf8mb4 table a Percona 5.7 dump names no collation for loads as utf8mb4_0900_ai_ci"
  fi
  return 0
}
### The same for a client load into the server named by the client options
### "$@": sets _MYSQL_UTF8MB4 to the --init-command that gives the session the
### old default when that server has the setting, to nothing otherwise, so
### the option never reaches a server that would refuse the connection.
_MYSQL_UTF8MB4=()
_mig_utf8mb4_client_opt() {
  _MYSQL_UTF8MB4=()
  [ -n "$(mysql --silent "$@" -N -B -e 'SELECT @@SESSION.default_collation_for_utf8mb4' 2> /dev/null)" ] \
    || return 0
  _MYSQL_UTF8MB4=(--init-command="SET SESSION default_collation_for_utf8mb4 = utf8mb4_general_ci")
  return 0
}
### A table a load has just written can read as empty to the query optimiser
### until InnoDB measures it in the background, and once nothing new wakes
### that queue it takes about one table every ten seconds: a large site
### loaded among a run of others went live with its pages planned as full
### table scans, and the database server ran out of CPU before the queue
### reached its tables. ANALYZE TABLE measures every InnoDB table of the
### database right after its load, 100 at a time, waiting at most 30 seconds
### for a table another session holds, as provision does after its own
### imports. It goes to the binary log as the load does, so a replica of this
### box measures the same tables; a standby takes its tables from replication
### and is never measured here. A table left unmeasured only warns: the data
### is in place, and InnoDB or the per-minute SQL check measures it later.
### $1 is the database, the rest the client options the load connected with
### (a --defaults-file first, as the client requires).
_measure_loaded_tables() {
  local _db="$1" _t0="${SECONDS}" _bq='`' _names _tb _list _out _i _ok=0 _skip=0 _err=""
  local -a _tbls=()
  shift
  [ -e "/root/.standby.cnf" ] && return 0
  if [[ ! "${_db}" =~ ^[A-Za-z0-9_]+$ ]]; then
    echo "ALRT: the optimizer statistics of ${_db} were not measured: not a plain database name"
    return 1
  fi
  if ! _names=$(mysql "$@" --silent -N -B -e "SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA='${_db}' AND TABLE_TYPE='BASE TABLE' AND ENGINE='InnoDB'" 2>/dev/null); then
    echo "ALRT: the optimizer statistics of ${_db} were not measured: its tables could not be listed"
    return 1
  fi
  while IFS= read -r _tb; do
    [ -n "${_tb}" ] || continue
    ### -B prints a backslash, tab or newline in a name as an escape: a name
    ### with one, or with a backtick, is never spliced into a statement.
    case "${_tb}" in
      *\\*|*"${_bq}"*) _skip=$(( _skip + 1 )); continue ;;
    esac
    _tbls+=("${_bq}${_db}${_bq}.${_bq}${_tb}${_bq}")
  done <<< "${_names}"
  for (( _i = 0; _i < ${#_tbls[@]}; _i += 100 )); do
    _list=$(IFS=,; printf '%s' "${_tbls[*]:_i:100}")
    _out=$(timeout 300 mysql "$@" --silent -N -B -e "SET SESSION lock_wait_timeout = 30; ANALYZE TABLE ${_list}" 2>&1)
    ### The outcome, not the exit code: each table answers with its own OK.
    _ok=$(( _ok + $(grep -c $'\tanalyze\tstatus\tOK$' <<< "${_out}") ))
    [ -n "${_err}" ] || _err=$(grep -i -m 1 -E 'error|timeout|denied' <<< "${_out}" | tr '\t' ' ')
  done
  if [ "${_ok}" -eq "${#_tbls[@]}" ] && [ "${_skip}" -eq 0 ]; then
    [ "${_ok}" -gt 0 ] && echo "INFO: measured the optimizer statistics of ${_ok} tables in ${_db} in $(( SECONDS - _t0 )) s"
    return 0
  fi
  echo "ALRT: measured the optimizer statistics of ${_ok} of $(( ${#_tbls[@]} + _skip )) tables in ${_db}${_err:+ (${_err:0:200})}; InnoDB measures the rest later on its own"
  return 1
}
### mydumper 1.x counts every failed query it logs into its exit status,
### its own retried table flush included. Before the global read lock it
### sends FLUSH NO_WRITE_TO_BINLOG TABLES, which waits behind any long
### query on the server; after --ftwrl-max-wait-time (60 s) it kills that
### flush, logs "Flush tables failed, we are continuing anyways - ERROR
### 1317" and sends it again, then takes the read lock and dumps as usual,
### so the run exits 1 with a whole dump (0.x exits 0). Waiting longer is
### no fix: a pending flush stalls every new query on the tables it waits
### for. A run stopped by SIGTERM skips what is left yet still writes its
### metadata and exits 0 (1 after such a retry); it says so only at Message
### level, so callers run mydumper at --verbose=3. Returns 0 when exit
### status $1, with the run's output in file $2 (no file, no pass), is a
### whole run: nothing says it was cancelled (0.19.3 spells it "cacelled"),
### and the status is 0, or 1 with at least one such retry, every counted
### error a retry (a failed query is logged as a WARNING with " - ERROR
### <n>: ", any other error as CRITICAL) and nothing CRITICAL or ERROR. The
### caller still requires metadata.
_mydumper_run_ok() {
  local _rc="${1}" _log="${2}"
  [[ -n "${_log}" && -f "${_log}" && ! -L "${_log}" ]] || return 1
  grep -q -E '^\*\* Message: ([0-9:.]+: )?(Shutting down gracefully|Thread [0-9]+: Process has been can?celled)$' \
    "${_log}" && return 1
  [[ "${_rc}" == "0" ]] && return 0
  [[ "${_rc}" == "1" ]] || return 1
  awk '
    /\): (CRITICAL|ERROR) [*][*]/ { _bad = 1 }
    /\): WARNING [*][*]: .* - ERROR [0-9]+: / {
      if ($0 ~ /\): WARNING [*][*]: ([0-9:.]+: )?Flush tables failed, we are continuing anyways - ERROR 1317: /) _ok = 1
      else _bad = 1
    }
    END { exit (_bad || !_ok) }
  ' "${_log}"
}
### Runs a mydumper command line ($3 on) in a session of its own and waits
### for it. mydumper 1.x takes SIGINT as a question: it pauses every worker
### and asks on its output whether to cancel, which nobody sees with that
### output in a log, and a pause that comes as it takes the global read
### lock keeps every write on the server waiting until someone answers. In
### its own session a Ctrl-C at the terminal never reaches it; this
### script's own INT, TERM or HUP ends it at once by SIGKILL (a SIGTERM can
### hang it the same way) and the script exits 130. It runs in directory
### $1, which must resolve to exactly $2 unless $2 is "-"; stdin is
### /dev/null, its output goes where the caller sends this function's.
### A signal that lands between the fork and the pid's assignment finds
### $! moved past its value before the fork and ends that child.
### Returns mydumper's status, or 1 when the directory check fails.
_mydumper_session() {
  local _d="${1}" _want="${2}" _old _rc
  shift 2
  _old="$(trap -p INT TERM HUP)"
  _MYDUMPER_PID=""
  _MYDUMPER_PREV="$!"
  trap '_p="${_MYDUMPER_PID}"; [ -z "${_p}" ] && [ "$!" != "${_MYDUMPER_PREV}" ] && _p="$!"; [ -n "${_p}" ] && kill -9 "${_p}" 2> /dev/null; exit 130' INT TERM HUP
  ( cd -P -- "${_d}" 2> /dev/null \
    && { [ "${_want}" = "-" ] || [ "$(/bin/pwd -P)" = "${_want}" ]; } \
    && exec setsid -w "$@" ) < /dev/null &
  _MYDUMPER_PID=$!
  wait "${_MYDUMPER_PID}"
  _rc=$?
  _MYDUMPER_PID=""
  trap - INT TERM HUP
  [ -n "${_old}" ] && eval "${_old}"
  return "${_rc}"
}
### On Percona 5.7 mydumper's default lock mode syncs its threads with FLUSH
### TABLES WITH READ LOCK (FTWRL) and also takes Percona's backup lock (LOCK
### TABLES FOR BACKUP), keeping it until the dump ends, past the FTWRL
### release. A write to a MyISAM table waits for that lock with its table
### open, and the event scheduler writes one at every event run (mysql.event
### is MyISAM on 5.7): the flush ahead of FTWRL then waits for that table, or
### FTWRL for the writer, and neither side gives way. The server sees no
### deadlock, so the export stalls there and every write on the box queues
### behind it. FTWRL alone still gives the dump its consistent point. Sets
### _MYDUMPER_BACKUP_LOCKS to --no-backup-locks when the local mydumper
### lists it, so a build without it gets its arguments as before.
_mydumper_backup_locks_opts() {
  local _h
  _MYDUMPER_BACKUP_LOCKS=()
  _h=$(mydumper --help 2>&1)
  if printf '%s\n' "${_h}" | grep -qE -- "^[[:space:]]+(-[[:alpha:]],[[:space:]]+)?--no-backup-locks([[:space:]]|=|$)"; then
    _MYDUMPER_BACKUP_LOCKS=(--no-backup-locks)
  fi
  return 0
}
### A site's triggers, stored routines and events travel with its tables.
### mydumper writes none of them unless asked, so a site that kept them (a
### logging trigger, a function its queries call, a scheduled event) lost
### them on every copy. Each keeps its DEFINER, the site's own database
### user: the import loads as root, and the target has that user under the
### same name before the load, so they run there with the site's rights, as
### here. Sets _MYDUMPER_OBJECTS to those of the three options the local
### mydumper lists, so a build without one gets its arguments as before.
_mydumper_objects_opts() {
  local _h _o
  _MYDUMPER_OBJECTS=()
  _h=$(mydumper --help 2>&1)
  for _o in --triggers --routines --events; do
    if printf '%s\n' "${_h}" | grep -qE -- "^[[:space:]]+(-[[:alpha:]],[[:space:]]+)?${_o}([[:space:]]|=|$)"; then
      _MYDUMPER_OBJECTS+=("${_o}")
    fi
  done
  return 0
}
### mydumper's own sessions give up a lock wait after 90 s, through an option
### file merged into its options with --defaults-extra-file (the connection
### keeps the credentials --defaults-file gave it). A FLUSH TABLES WITH READ
### LOCK whose mydumper is killed while it waits behind a long query stays on
### the server and holds the global read lock, every write on the server
### waiting, until that query ends; bounded, it ends 90 s after it began. A
### live run never meets the bound at its flushes: its own monitor ends a
### flush that waits 60 s (--ftwrl-max-wait-time), so the option goes only to
### a mydumper that has that monitor. A table read that waits 90 s for a lock
### fails the dump instead of holding it, and every query queued behind it,
### open. Writes the file when it is missing or differs; sets
### _MYDUMPER_LOCKWAIT to the option, or to nothing.
_mydumper_lockwait_opts() {
  local _f=/etc/boa/mydumper-extra.cnf _want _tmp _h _o
  _MYDUMPER_LOCKWAIT=()
  _h=$(mydumper --help 2>&1)
  for _o in --defaults-extra-file --ftwrl-max-wait-time; do
    printf '%s\n' "${_h}" | grep -qE -- "^[[:space:]]+${_o}([[:space:]]|=|$)" || return 0
  done
  [[ -d "${_f}" ]] && return 0
  _want=$'[mydumper_session_variables]\nLOCK_WAIT_TIMEOUT = 90'
  if [[ ! -f "${_f}" || -L "${_f}" || "$(cat "${_f}" 2> /dev/null)" != "${_want}" ]]; then
    mkdir -p "${_f%/*}" 2> /dev/null
    _tmp=$(mktemp "${_f}.XXXXXX" 2> /dev/null) || return 0
    if ! { printf '%s\n' "${_want}" > "${_tmp}" && chmod 644 "${_tmp}" && mv -f "${_tmp}" "${_f}"; }; then
      rm -f "${_tmp}"
      return 0
    fi
  fi
  _MYDUMPER_LOCKWAIT=(--defaults-extra-file="${_f}")
  return 0
}
### mydumper writes every trigger, routine and event of a database under one
### file-wide sql_mode, so an object made under another one (Drupal's own
### connections use ANSI_QUOTES and PIPES_AS_CONCAT) fails its load, or
### loads and then behaves otherwise. This gives each object back the mode
### the server stored for it: a plain SET before its CREATE and the file's
### mode after it (myloader stops on a versioned-comment SET in the middle
### of a file). Mode words 8.x refuses are left out, so a 5.7 dump loads
### there. It reads the file whole, never through a link, and replaces it
### through a new one in the same directory. Exits 1, the file as it was,
### when a line cannot be placed; 2 when an object had no mode to give.
_MYDUMPER_MODES_PL='use strict; use Fcntl;
my ($f) = @ARGV; my (%m, @o, $p, $miss);
my $gone = qr/^(?:NO_AUTO_CREATE_USER|NO_FIELD_OPTIONS|NO_KEY_OPTIONS|NO_TABLE_OPTIONS|DB2|MAXDB|MSSQL|MYSQL323|MYSQL40|ORACLE|POSTGRESQL)$/;
for (split /\n/, (defined $ENV{_MYDUMPER_MODES} ? $ENV{_MYDUMPER_MODES} : "")) {
  my ($t, $h, $s) = split /\t/, $_, 3;
  next unless defined $s && $t =~ /^(?:TRIGGER|FUNCTION|PROCEDURE|EVENT)$/
    && $h =~ /^[0-9A-Fa-f]+$/ && $s =~ /^[A-Z0-9_,]*$/;
  $m{$t . " " . lc($h)} = join(",", grep { $_ !~ $gone } split(/,/, $s));
}
sysopen(my $in, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit 1;
my @st = stat($in); exit 1 unless @st && -f _;
my @l = <$in>; close($in);
my $fm;
for my $x (@l[0 .. ($#l < 9 ? $#l : 9)]) {
  $fm = $1 if !defined $fm && $x =~ /^\/\*!40101 SET SQL_MODE=\x27([A-Z0-9_,]*)\x27\*\/;$/;
}
exit 1 unless defined $fm;
for my $i (0 .. $#l) {
  my $x = $l[$i];
  if ($p && $x =~ /^SET character_set_client = \@PREV_CHARACTER_SET_CLIENT;$/) {
    push @o, "SET SQL_MODE=\x27$fm\x27;\n"; $p = 0;
  }
  push @o, $x;
  next unless $x =~ /^DROP (TRIGGER|FUNCTION|PROCEDURE|EVENT) IF EXISTS `((?:[^`]|``)+)`;$/;
  my ($t, $n) = ($1, $2); $n =~ s/``/`/g;
  exit 0 if $i < $#l && $l[$i + 1] =~ /^SET SQL_MODE=/;
  my $s = $m{$t . " " . unpack("H*", $n)};
  if (defined $s) { push @o, "SET SQL_MODE=\x27$s\x27;\n"; $p = 1; } else { $miss = 1; }
}
exit 1 if $p;
my $w = $f . ".modes";
sysopen(my $out, $w, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1;
if (!(print {$out} @o) || !close($out) || !chmod($st[2] & 07777, $w)
  || ($> == 0 && !chown($st[4], $st[5], $w)) || !rename($w, $f)) { unlink($w); exit 1; }
exit($miss ? 2 : 0);'

### Gives every stored object of database $1, dumped by mydumper into the
### directory $2, its own sql_mode back (see _MYDUMPER_MODES_PL), read with
### the client command that follows. Returns 0 when done or when there is
### nothing to do, 1 when the modes could not be read (the files as
### mydumper wrote them), 2 when an object or a file kept the dump's mode.
### It never fails a dump: the caller says what was left.
_mydumper_object_modes() {
  local _db="${1}" _dir="${2}" _q _modes _f _rc=0
  shift 2
  [[ "${_db}" =~ ^[A-Za-z0-9_]+$ ]] || return 2
  _q="SELECT 'TRIGGER', HEX(TRIGGER_NAME), SQL_MODE FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA = '${_db}'"
  _q="${_q} UNION ALL SELECT ROUTINE_TYPE, HEX(ROUTINE_NAME), SQL_MODE FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA = '${_db}'"
  _q="${_q} UNION ALL SELECT 'EVENT', HEX(EVENT_NAME), SQL_MODE FROM information_schema.EVENTS WHERE EVENT_SCHEMA = '${_db}'"
  _modes=$("$@" -N -B -e "${_q}" 2> /dev/null) || return 1
  [[ -n "${_modes}" ]] || return 0
  for _f in "${_dir}"/*-schema-post.sql "${_dir}"/*-schema-triggers.sql; do
    if [[ -L "${_f}" ]]; then
      _rc=2
      continue
    fi
    [[ -f "${_f}" ]] || continue
    _MYDUMPER_MODES="${_modes}" perl -e "${_MYDUMPER_MODES_PL}" -- "${_f}" || _rc=2
  done
  return "${_rc}"
}

# Mode-aware rsync: performs the transfer in LIVE, only reports it in DRY.
_xcopy_rsync() {
  if [ "${_MODE}" = "LIVE" ]; then
    # Trailing (after "$@") is deliberate: callers pass -a/-aEAX which implies
    # -D; rsync honours the LAST matching option, so these must follow -a to
    # actually drop device/fifo/socket nodes. Never transfer specials.
    # _XCOPY_GMAP maps the account's own group and its web group (see
    # _xcopy_acct_gmap, _xcopy_webgroup_gate); _XCOPY_UMAP its identities
    # (see _xcopy_acct_umap).
    rsync "$@" ${_XCOPY_GMAP:+"--groupmap=${_XCOPY_GMAP}"} ${_XCOPY_UMAP:+"--usermap=${_XCOPY_UMAP}"} --no-devices --no-specials
  else
    echo "[DRY-PLAN] would rsync: $*"
  fi
}

# Solr indices can be large; fold them into the disk-space gate. Checks that <src>
# fits at its target destination dir (which follows the target's /var/solrN symlink
# onto a mount, or lands on root). Returns 0 if it fits (or src absent), 1 + DENY +
# NOT_CLEAN otherwise. Placement is unchanged (data-only rsync) — this only gates.
_xcopy_solr_check() {   # 1 src  2 target-dest-dir  3 label  4 the copy's own destination
  local _sz
  [ -e "$1" ] || return 0
  # -L: a symlink operand (e.g. a backups dir relocated into the store)
  # measures 0 with plain du, which waves the fit gate through unmeasured.
  _sz="$(du -skL "$1" 2>/dev/null | awk '{print $1}')"
  _xcopy_target_fits "${_tgt}" "$2" "${_sz}" "" "$1" "${4:-$2/${1##*/}}" && return 0
  echo "DENY: $3: ${_sz:-?}K does not fit at target $2${_XCOPY_FIT_WHY:+ (${_XCOPY_FIT_WHY})} — free space and retry"
  _XCOPY_NOT_CLEAN=YES
  return 1
}

### Whether a copy fits at <probe> ($2) on the target box ($1): its bytes
### ($3, in KB) and, given the names it makes ($4) or the source tree to
### count them in ($5), its inodes too, both read in one remote call. Every
### file takes an inode, and a filesystem out of them fails every write
### with "No space left on device" while df -h still shows room: a copy
### must leave 2% of the target's inodes, at least 50,000, free, the
### headroom BOA's other copy checks keep. rsync -a makes one name per name
### the source holds, which du -l counts; the source tree is walked only
### when its own filesystem's inodes in use (no subtree has more) do not
### already fit. A copy that falls short is credited with what its own
### destination ($6) already holds, counted there only, as a repeated pass
### adds only what changed: its bytes with du -sk, its names with du -l
### (stale names and a nested store made inside it count too). A
### destination that cannot be measured, or not within 15 minutes, keeps
### the refusal.
### A figure no command gave (an unreadable df, btrfs's '-' for inodes, a
### count past 15 minutes) leaves that side unjudged, with a warning on the
### plan. The remote reads take no stdin (-n), so a caller reading a list
### from stdin keeps it, and are found by a token, so login noise cannot
### garble them. Why a copy did not fit is left in _XCOPY_FIT_WHY for the
### caller's DENY.
_xcopy_target_fits() {
  local _q _qo _av _it _if _e _ih _n="${4:-}" _ub _dex _dn
  _XCOPY_FIT_WHY=""
  _q="$(_shq "$2")"
  _qo="$(_shq "${6:-}")"
  read -r _av _it _if _e <<< "$(ssh -n root@"$1" "p='${_q}'; o='${_qo}'; while [ -n \"\$p\" ] && [ \"\$p\" != / ] && [ ! -d \"\$p\" ]; do p=\$(dirname \"\$p\"); done; a=\$(df -Pk \"\$p\" 2>/dev/null | awk 'NR==2{print \$4}'); i=\$(LC_ALL=C df -P -i \"\$p\" 2>/dev/null | awk 'NR==2{print \$2, \$4}'); e=N; [ -n \"\$o\" ] && [ -d \"\$o\" ] && e=D; echo \"XCFIT \${a:--} \${i:-- -} \$e\"" 2>/dev/null \
    | grep -m1 '^XCFIT ' | awk '{print $2, $3, $4, $5}')"
  if ! [[ "$3" =~ ^[0-9]+$ && "${_av}" =~ ^[0-9]+$ ]]; then
    _xcopy_fit_warn space "$2" "the copy's size or the free space there could not be read (${3:-?}K, ${_av:-?}K free); copying without the space check"
  elif [ "${_av}" -lt "$3" ]; then
    # Short of bytes: credit what the copy's own destination holds,
    # measured only here, where it changes the answer.
    _dex=""
    if [ "${_e}" = "D" ]; then
      _dex="$(ssh -n root@"$1" "echo \"XCDEX \$(timeout 900 du -skH '${_qo}' 2>/dev/null | awk '{print \$1}')\"" 2>/dev/null \
        | grep -m1 '^XCDEX ' | awk '{print $2}')"
    fi
    if ! [[ "${_dex}" =~ ^[0-9]+$ ]] || [ $(( _av + _dex )) -lt "$3" ]; then
      _XCOPY_FIT_WHY="${3}K needed, ${_av}K free"
      return 1
    fi
  fi
  [ -n "${_n}${5:-}" ] || return 0
  if ! [[ "${_it}" =~ ^[0-9]+$ && "${_if}" =~ ^[0-9]+$ ]] || [ "${_it}" -eq 0 ]; then
    _xcopy_fit_warn inodes "$2" "its free inodes could not be read (df -i); copying without the inode check"
    return 0
  fi
  _ih=$(( _it / 50 ))
  [ "${_ih}" -ge 50000 ] || _ih=50000
  if [ -z "${_n}" ]; then
    _ub="$(LC_ALL=C df -P -i -- "$5" 2>/dev/null | awk 'NR==2 {print $3}')"
    if [[ "${_ub}" =~ ^[0-9]+$ ]] && [ "${_ub}" -gt 0 ] && [ $(( _ub + _ih )) -le "${_if}" ]; then
      return 0
    fi
    _xcopy_names_of "$5"
    _n="${_XCOPY_NAMES}"
  fi
  if ! [[ "${_n}" =~ ^[0-9]+$ ]]; then
    _xcopy_fit_warn count "$2" "the copy's files could not be counted within 15 minutes; copying without the inode check"
    return 0
  fi
  [ $(( _n + _ih )) -le "${_if}" ] && return 0
  # Short of inodes: credit the names the copy's own destination holds.
  if [ "${_e}" = "D" ]; then
    _dn="$(ssh -n root@"$1" "n=\$(timeout 900 du -s -l -H --inodes '${_qo}' 2>/dev/null | awk '{print \$1}'); echo \"XCDEN \${n:--}\"" 2>/dev/null \
      | grep -m1 '^XCDEN ' | awk '{print $2}')"
    if [[ "${_dn}" =~ ^[0-9]+$ ]] && [ $(( _n + _ih )) -le $(( _if + _dn )) ]; then
      return 0
    fi
  fi
  _XCOPY_FIT_WHY="${_n} files and ${_ih} inodes kept free, ${_if} inodes free (df -i)"
  return 1
}

### The names a copy of the tree $1 makes (one per name, du -l), into
### _XCOPY_NAMES (empty when the count failed or took over 15 minutes). The
### last tree's count is kept, so a store tried at the mount and then at
### the root is walked once. It sets globals: never call it inside $(...).
_xcopy_names_of() {
  [ "${_XCOPY_NAMES_OF:-}" = "$1" ] && return 0
  _XCOPY_NAMES_OF="$1"
  _XCOPY_NAMES="$(timeout 900 du -s -l -H --inodes -- "$1" 2>/dev/null | awk 'NR==1 {print $1}')"
}

### A figure the fit check could not read: the copy goes on without that
### side of the check, as the plan shows.
_xcopy_fit_warn() {   # 1 = side (space|inodes|count)  2 = dest  3 = message
  echo "WARN: $2 on the target: $3"
}

### Where a store sits on the target now, read at its destination there
### ($2): M when it is the link a mirror placed onto the mount copy ($3), L
### another link (a dangling one too), D a real directory, N nothing (one
### remote read, no stdin; empty when the target could not be asked).
_xcopy_tgt_kind() {
  local _qd _qm
  _qd="$(_shq "$2")"
  _qm="$(_shq "${3:-}")"
  ssh -n root@"$1" "d='${_qd}'; m='${_qm}'; k=N; if [ -L \"\$d\" ]; then k=L; r=\$(cd -P \"\$d\" 2>/dev/null && /bin/pwd -P); [ -n \"\$m\" ] && [ -n \"\$r\" ] && [ \"\$r\" = \"\$(cd -P \"\$m\" 2>/dev/null && /bin/pwd -P)\" ] && k=M; elif [ -d \"\$d\" ]; then k=D; fi; echo \"XCKIND \$k\"" 2>/dev/null \
    | grep -m1 '^XCKIND ' | awk '{print $2}'
}

# Single-quote-escape a value for safe embedding in a remote 'single-quoted' ssh arg
# (covers a legacy path that might contain a quote).
_shq() { printf "%s" "$1" | sed "s/'/'\\\\''/g"; }

# De-reference: real dir at <dstRoot> on the target root; rsync the contents in.
# Returns non-zero if the copy fails (caller denies). The copy leaves from
# inside the resolved source directory ($2, canonical). With an account ($5)
# the target directory is made inside a real parent in that account's own
# tree or store, and the receiver starts only in the directory it reported.
_xcopy_put_on_root() {
  local _th="$1" _real="$2" _dstRoot="$3" _ie="$4" _acct="$5" _q _dreal
  if [ -n "${_acct}" ]; then
    # a store held on the attached mount there gives way to a real directory:
    # the target's own panel stores (_XCOPY_PANEL_OWN) come across first
    if [ -n "${_XCOPY_PANEL_OWN}" ]; then
      _dreal="$(_xcopy_tgt_place "${_th}" _xcopy_own_dir_carry "${_acct}" "${_dstRoot}" "${_XCOPY_PANEL_OWN}")"
    else
      _dreal="$(_xcopy_tgt_place "${_th}" _xcopy_own_dir_ready dir "${_acct}" "${_dstRoot}")"
    fi
    if [ -z "${_dreal}" ]; then
      echo "DENY: ${_dstRoot} on the target does not resolve into ${_acct}'s own tree or store${_XCOPY_PANEL_OWN:+, or the target panel stores could not be carried there} -- nothing copied"
      return 3
    fi
    # the store is files/ and private/: the web group map rides it too
    if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
      ${_XCOPY_GMAP:+"--groupmap=${_XCOPY_GMAP}"} ${_XCOPY_UMAP:+"--usermap=${_XCOPY_UMAP}"} \
      --rsync-path="$(_xcopy_canon_rpath "${_dreal}")" -e ssh ./ root@"${_th}":./; then
      echo "DENY: rsync to ${_dstRoot} on target root failed"
      return 3
    fi
    return 0
  fi
  _q="$(_shq "${_dstRoot}")"
  ssh root@"${_th}" "if [ -L '${_q}' ]; then rm -f '${_q}'; elif [ -e '${_q}' ] && [ ! -d '${_q}' ]; then rm -f '${_q}'; fi; mkdir -p '${_q}'"
  if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
    ${_XCOPY_GMAP:+"--groupmap=${_XCOPY_GMAP}"} ${_XCOPY_UMAP:+"--usermap=${_XCOPY_UMAP}"} -e ssh ./ root@"${_th}":"${_dstRoot}/"; then
    echo "DENY: rsync to ${_dstRoot} on target root failed"
    return 3
  fi
}

# Mirror: rsync contents to <mntDest> on the target mount, then make <dstRoot> a symlink
# to it. The store ends up on the mount AND stays on the source, so a stale prior copy
# at <dstRoot> (e.g. an earlier de-reference to root now being moved onto a freshly
# attached disk) is safe to replace once the mount copy is confirmed. Returns non-zero
# on any failure (caller denies); the remote replace is fenced to /data/disk.
# The copy leaves from inside the resolved source directory ($2, canonical).
# With an account ($7) the mount copy lands only in a directory no link on
# the way leads to, and the link is placed inside the real parent of
# <dstRoot>, which must lie in that account's own tree or store.
_xcopy_put_on_mount() {
  local _th="$1" _real="$2" _mntDest="$3" _dstRoot="$4" _ie="$5" _lbl="$6" _acct="$7"
  local _qm _qd _mreal
  _qm="$(_shq "${_mntDest}")"; _qd="$(_shq "${_dstRoot}")"
  if [ -n "${_acct}" ]; then
    _mreal="$(_xcopy_tgt_place "${_th}" _xcopy_real_mnt_dir "${_mntDest}")"
    if [ -z "${_mreal}" ]; then
      echo "DENY: ${_lbl}: ${_mntDest} on the target is not a real directory under its mount -- nothing copied"
      return 3
    fi
    if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
      ${_XCOPY_GMAP:+"--groupmap=${_XCOPY_GMAP}"} ${_XCOPY_UMAP:+"--usermap=${_XCOPY_UMAP}"} \
      --rsync-path="$(_xcopy_canon_rpath "${_mreal}")" -e ssh ./ root@"${_th}":./; then
      echo "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed; target link left untouched"
      return 3
    fi
    # the link below replaces whatever holds <dstRoot>: the target's own
    # panel stores there (_XCOPY_PANEL_OWN), which the copy above left alone,
    # come across into the mount copy right before it
    if [ -n "${_XCOPY_PANEL_OWN}" ] \
      && [ -z "$(_xcopy_tgt_place "${_th}" _xcopy_own_panel_carry "${_acct}" "${_dstRoot}" "${_mreal}" "${_XCOPY_PANEL_OWN}")" ]; then
      echo "DENY: ${_lbl}: the target panel stores in ${_dstRoot} could not be carried into ${_mntDest}; target link left untouched"
      return 3
    fi
    if [ -z "$(_xcopy_tgt_place "${_th}" _xcopy_own_link_ready "${_acct}" "${_dstRoot}" "${_mntDest}")" ]; then
      echo "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target (its parent is not ${_acct}'s own there)"
      return 3
    fi
    return 0
  fi
  ssh root@"${_th}" "mkdir -p '${_qm}'"
  if ! _xcopy_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
    ${_XCOPY_GMAP:+"--groupmap=${_XCOPY_GMAP}"} ${_XCOPY_UMAP:+"--usermap=${_XCOPY_UMAP}"} -e ssh ./ root@"${_th}":"${_mntDest}/"; then
    echo "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed; target link left untouched"
    return 3
  fi
  if ! ssh root@"${_th}" "d='${_qd}'; case \"\$d\" in /data/disk/*) : ;; *) echo 'refuse: dstRoot outside /data/disk'; exit 9 ;; esac; if [ -L \"\$d\" ]; then rm -f \"\$d\"; elif [ -d \"\$d\" ]; then rm -rf \"\$d\"; elif [ -e \"\$d\" ]; then rm -f \"\$d\"; fi; mkdir -p \"\$(dirname \"\$d\")\"; ln -sfn '${_qm}' \"\$d\""; then
    echo "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target"
    return 3
  fi
}

# Storage-aware transfer of one store. Args:
#   1 source path  2 dest path on target root  3 mount-relative dest ("" => derive)
#   4 target host  5 target mount ("path"|""|"MULTI")  6 ieni  7 label
#   8 the account whose store this is ("" for a box tree such as arch)
#   9 what the account's store may resolve to: tree (its own tree or its
#     store under <mount>/files/<oN>/, the default) or uid (also anything
#     its identities own)
# The source is resolved once and copied from inside that real directory;
# an account's store that resolves anywhere else is refused, never followed.
_xcopy_handle_store() {
  local _src="$1" _dstRoot="$2" _mntRel="$3" _th="$4" _tm="$5" _ie="$6" _lbl="$7"
  local _acct="$8" _rule="${9:-tree}" _dacct=""
  local _real _link _sz _onMnt=NO _mntDest="" _act="" _reason="" _rc=0 _why
  local _kind _rp _rown="" _mown=""

  if [ ! -e "${_src}" ] && [ ! -L "${_src}" ]; then
    return 0
  fi
  if [ -n "${_acct}" ]; then
    _dacct="${_dstRoot#/data/disk/}"
    _dacct="${_dacct%%/*}"
  fi

  # --- classify + resolve the source ---
  if [ "${_tm}" = "MULTI" ]; then
    _act=DENY; _reason="target has multiple /mnt mounts; cannot choose one"
  elif [ -n "${_acct}" ] && { [ "${_dstRoot}" = "/data/disk/${_dacct}" ] \
    || [ "${_dstRoot#/data/disk/}" = "${_dstRoot}" ]; }; then
    _act=DENY; _reason="${_dstRoot} is not a path inside an account on the target"
  elif [ -L "${_src}" ]; then
    _link="$(readlink "${_src}" 2>/dev/null)"
    _real="$(readlink -f "${_src}" 2>/dev/null)"
    if [ -z "${_real}" ] || [ ! -d "${_real}" ]; then
      _act=DENY; _reason="${_src} is a dangling symlink (attached disk not mounted?)"
    elif [ -n "${_acct}" ] && ! _xcopy_store_is_own "${_acct}" "${_real}" "${_rule}"; then
      _act=DENY; _reason="${_src} resolves to ${_real}, outside ${_acct}'s own tree and store -- not followed"
    else
      case "${_link}" in /mnt/*) _onMnt=YES ;; esac
    fi
  elif [ -d "${_src}" ]; then
    _real="$(cd -P -- "${_src}" 2>/dev/null && /bin/pwd -P)"
    if [ -z "${_real}" ]; then
      _act=DENY; _reason="${_src} cannot be entered"
    elif [ -n "${_acct}" ] && ! _xcopy_store_is_own "${_acct}" "${_real}" "${_rule}"; then
      _act=DENY; _reason="${_src} resolves to ${_real}, outside ${_acct}'s own tree and store -- not followed"
    fi
  else
    return 0
  fi

  # --- decide (mirror / root / deny), source-shape preferred, space-checked ---
  if [ -z "${_act}" ]; then
    _sz="$(du -sk "${_real}" 2>/dev/null | awk '{print $1}')"
    if [ -z "${_mntRel}" ] && [ "${_onMnt}" = "YES" ]; then
      _mntRel="${_real#/mnt/*/}"
      # On a rename the account's own part of the store takes the new name.
      # A path under another name's part (an old-named path left by an
      # earlier rename) lands under files/<oN>/legacy/<name>/ in the
      # account's own part, never in a store an account of that name may
      # hold on the target.
      if [ -n "${_acct}" ] && [ -n "${_dacct}" ]; then
        case "${_mntRel}/" in
          "files/${_acct}/"*) _mntRel="files/${_dacct}${_mntRel#"files/${_acct}"}" ;;
          "files/${_dacct}/"*) ;;
          files/?*/*) _mntRel="files/${_dacct}/legacy/${_mntRel#files/}" ;;
        esac
      fi
    fi
    [ -n "${_tm}" ] && [ -n "${_mntRel}" ] && _mntDest="${_tm}/${_mntRel}"
    # The preferred placement first, then the other: a store goes where it
    # fits, in bytes and inodes, and is refused when it fits on neither.
    # What the store's destination holds on the target is credited at
    # that placement only. The root's figures are read at the
    # destination's parent unless the destination is a real directory: df
    # through a link (or one the read could not name) would read the mount.
    _kind="$(_xcopy_tgt_kind "${_th}" "${_dstRoot}" "${_mntDest}")"
    _rp="${_dstRoot%/*}"
    case "${_kind}" in
      M) _mown="${_mntDest}" ;;
      D) _rown="${_dstRoot}"; _rp="${_dstRoot}" ;;
    esac
    if [ "${_onMnt}" = "YES" ] && [ -n "${_mntDest}" ]; then
      if _xcopy_target_fits "${_th}" "${_mntDest}" "${_sz}" "" "${_real}" "${_mown}"; then _act=MIRROR
      else
        _why="${_XCOPY_FIT_WHY}"
        if _xcopy_target_fits "${_th}" "${_rp}" "${_sz}" "" "${_real}" "${_rown}"; then _act=ROOT
        else _act=DENY; _reason="does not fit on target mount (${_mntDest}${_why:+: ${_why}}) nor root (${_dstRoot}${_XCOPY_FIT_WHY:+: ${_XCOPY_FIT_WHY}})"; fi
      fi
    else
      if _xcopy_target_fits "${_th}" "${_rp}" "${_sz}" "" "${_real}" "${_rown}"; then _act=ROOT
      else
        _why="${_XCOPY_FIT_WHY}"
        if [ -z "${_mntDest}" ]; then
          _act=DENY; _reason="does not fit on target root (${_dstRoot}${_why:+: ${_why}}) and no usable target mount"
        elif _xcopy_target_fits "${_th}" "${_mntDest}" "${_sz}" "" "${_real}" "${_mown}"; then _act=MIRROR
        else _act=DENY; _reason="does not fit on target root (${_dstRoot}${_why:+: ${_why}}) nor mount (${_mntDest}${_XCOPY_FIT_WHY:+: ${_XCOPY_FIT_WHY}})"; fi
      fi
    fi
  fi

  # --- execute per mode: DRY reports the plan + flags NOT CLEAN on any deny; LIVE acts ---
  case "${_act}" in
    DENY)
      echo "DENY: ${_lbl}: ${_reason} — free space / fix and retry"
      _XCOPY_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && return 3
      return 0
      ;;
    MIRROR)
      if [ "${_MODE}" = "LIVE" ]; then
        _xcopy_put_on_mount "${_th}" "${_real}" "${_mntDest}" "${_dstRoot}" "${_ie}" "${_lbl}" "${_dacct}" \
          || { _rc=$?; _XCOPY_NOT_CLEAN=YES; return "${_rc}"; }
        echo "INFO: ${_lbl}: mirrored to target mount ${_mntDest}, symlinked ${_dstRoot}"
      else
        echo "[DRY-PLAN] ${_lbl}: would mirror onto target mount ${_mntDest} and symlink ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
    ROOT)
      if [ "${_MODE}" = "LIVE" ]; then
        _xcopy_put_on_root "${_th}" "${_real}" "${_dstRoot}" "${_ie}" "${_dacct}" \
          || { _rc=$?; _XCOPY_NOT_CLEAN=YES; return "${_rc}"; }
        echo "INFO: ${_lbl}: real dir on target root ${_dstRoot}"
      else
        echo "[DRY-PLAN] ${_lbl}: would place real dir on target root ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
  esac
  return 0
}

# Status 0 when the account-relative path $1 is a control panel's store
# or lies in one: static/files/<name> for a name the static/files copy
# read (_XCOPY_PANEL_NAMES), each box's own.
_xcopy_panel_store_path() {
  local _p
  local -a _ps
  # names the copy could not read: nothing in the store is carried
  if [ "${_XCOPY_PANEL_UNREAD}" = "YES" ]; then
    case "${1}" in static/files/*) return 0 ;; esac
  fi
  read -r -a _ps <<< "${_XCOPY_PANEL_NAMES}"
  for _p in "${_ps[@]}"; do
    case "${1}" in
      "static/files/${_p}"|"static/files/${_p}"/*) return 0 ;;
    esac
  done
  return 1
}

# Catch-all: any symlink (besides static/files, handled explicitly) whose OWN target
# is /mnt/... gets the same storage-aware treatment, so non-standard legacy links are
# never left dangling on the target. Sets _XCOPY_STORE_RC on any DENY. On a rename a
# link into the account's own part of the store (<mount>/files/<oN>/...) lands under
# the new name there; one into another name's part lands under
# <mount>/files/<oN>/legacy/<name>/. A link is carried only when it resolves into
# the account's own tree or store, or to content one of its identities owns (an
# old-named path left by an earlier rename); anything else is a DENY.
_xcopy_catchall_mnt_symlinks() {
  local _root="$1" _dstRoot="$2" _th="$3" _tm="$4" _ie="$5"
  local _l _lt _rel _dl
  while IFS= read -r _l; do
    [ -n "${_l}" ] || continue
    [ "${_l}" = "${_root}/static/files" ] && continue
    _xcopy_panel_store_path "${_l#"${_root}"/}" && continue
    _lt="$(readlink "${_l}" 2>/dev/null)"
    case "${_lt}" in /mnt/*) : ;; *) continue ;; esac
    _rel="${_l#"${_root}"/}"
    _dl="${_dstRoot}/${_rel}"
    _xcopy_handle_store "${_l}" "${_dl}" "" "${_th}" "${_tm}" "${_ie}" "legacy symlink ${_rel}" \
      "${_root##*/}" uid || _XCOPY_STORE_RC=$?
  done <<EOF
$(find "${_root}" -type l 2>/dev/null)
EOF
}

# The control panel of the account on each box, for its static/files copy:
# _XCOPY_PANEL_NAMES holds the names, _XCOPY_PANEL_EXCL one anchored
# --exclude per name and _XCOPY_PANEL_OWN the target's own names, the stores
# a placement that moves the store there carries across (_xcopy_put_on_root,
# _xcopy_put_on_mount); the account's mount link sweep skips every name. A
# panel is the box's own: named for its box, never copied as a tree (its
# site dir under aegir/ is on no leg), and the import keeps the target's
# own. autosymlink keeps a panel's files and private in the account's
# store as static/files/<panel name>/, as it does a site's, so the copy
# used to carry the source panel's store, which the import's
# rename then put under the target panel's name when the target panel had
# none of its own there. An excluded name is neither sent nor touched on
# the target. The source's name is its hostmaster alias's site_path; the
# target's are the site dirs under the account's aegir/distro/*/sites/
# there. Status 1 when the target's answer cannot be read or a name is not
# a plain host name: the store is then not copied.
_xcopy_panel_store_names() {
  local _n _q _ans _k _all=" "
  _XCOPY_PANEL_NAMES=""
  _XCOPY_PANEL_EXCL=""
  _XCOPY_PANEL_OWN=""
  _n=$(_xcopy_read_in "${1}/.drush" hostmaster.alias.drushrc.php 2> /dev/null \
    | sed -n "s/.*'site_path' => '\([^']*\)'.*/\1/p" | head -1)
  _n="${_n##*/}"
  _q="$(_shq "${3}")"
  _ans=$(ssh -n -o ConnectTimeout=10 -o BatchMode=yes root@"${2}" \
    "for _d in '${_q}'/aegir/distro/*/sites/*; do [ -d \"\${_d}\" ] && [ ! -L \"\${_d}\" ] || continue; _b=\"\${_d##*/}\"; case \"\${_b}\" in all|default) continue ;; esac; [ -f \"\${_d}/settings.php\" ] || [ -f \"\${_d}/drushrc.php\" ] || continue; echo \"XCPANEL N|\${_b}\"; done; echo 'XCPANEL E|'" 2> /dev/null \
    | grep -a '^XCPANEL [NE]|')
  printf '%s\n' "${_ans}" | grep -q -x 'XCPANEL E|' || return 1
  while IFS='|' read -r _k _n; do
    [ -n "${_n}" ] || continue
    [[ "${_n}" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || return 1
    [ "${_k}" = "XCPANEL N" ] && [[ " ${_XCOPY_PANEL_OWN} " != *" ${_n} "* ]] \
      && _XCOPY_PANEL_OWN="${_XCOPY_PANEL_OWN:+${_XCOPY_PANEL_OWN} }${_n}"
    [[ "${_all}" = *" ${_n} "* ]] && continue
    _all="${_all}${_n} "
    _XCOPY_PANEL_NAMES="${_XCOPY_PANEL_NAMES:+${_XCOPY_PANEL_NAMES} }${_n}"
    _XCOPY_PANEL_EXCL="${_XCOPY_PANEL_EXCL:+${_XCOPY_PANEL_EXCL} }--exclude=/${_n}"
  done < <(printf 'S|%s\n' "${_n}"; printf '%s\n' "${_ans}" | grep -a '^XCPANEL N|')
  return 0
}

_xcopy_transfer_static_symlink_safe() {
  _X_SRC_USR="$1"
  _X_TGT_HOST="$2"
  _X_DST_USR="$3"
  _X_IENI="$4"
  _X_TGT_MNT="$5"

  _X_SRC_STATIC="${_X_SRC_USR}/static"
  _X_DST_STATIC="${_X_DST_USR}/static"
  _X_DST_STATIC_FILES="${_X_DST_USR}/static/files"
  _X_DST_ACCT="$(basename "${_X_DST_USR}")"

  if [ ! -d "${_X_SRC_STATIC}" ]; then
    return 0
  fi

  echo "INFO: Static sync pass 1/2 (preserve symlinks, exclude static/files)"
  mkdir -p "${_X_SRC_USR}/static"
  ### Anchored to the transfer root: the unanchored form dropped EVERY path
  ### component named "files" anywhere beneath static/ (silent data loss on
  ### codebases that ship nested files/ dirs). Mirrors the xoct call site.
  ### static/ is the account's on both boxes: the copy runs from inside the
  ### real directory with a relative source, and the receiving rsync starts
  ### inside the real static/ on the target, so neither end resolves static/
  ### through a link put in its place. A static/ that is not a real
  ### directory here is never followed, and the transfer is not complete.
  ### control/web-group-notes.txt, the account's copy of its web-group
  ### notes, names the source box's web-group state: it never travels, nor
  ### does a temp copy of it a killed note left (.web-group-notes.txt.put.*).
  if ! _xcopy_in_real_dir "${_X_SRC_STATIC}" true; then
    echo "DENY: ${_X_SRC_STATIC} is not a real directory -- not followed; static/ not copied"
    _XCOPY_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=1
    return 1
  fi
  _xcopy_in_real_dir "${_X_SRC_STATIC}" _xcopy_copy_here "${_X_TGT_HOST}" \
    "${_X_DST_STATIC}" '' -aEAXqu ${_X_IENI} --exclude=/files \
    --exclude=/control/web-group-notes.txt '--exclude=/control/.web-group-notes.txt.put.*'

  echo "INFO: Static sync pass 2/2 (materialize/mirror static/files per target disk reality)"
  # Each box's control panel store stays its own (_xcopy_panel_store_names).
  _XCOPY_PANEL_NAMES=""
  _XCOPY_PANEL_EXCL=""
  _XCOPY_PANEL_OWN=""
  _XCOPY_PANEL_UNREAD=""
  if [ -e "${_X_SRC_USR}/static/files" ] || [ -L "${_X_SRC_USR}/static/files" ]; then
    if ! _xcopy_panel_store_names "${_X_SRC_USR}" "${_X_TGT_HOST}" "${_X_DST_USR}"; then
      echo "DENY: static/files (${_X_DST_ACCT}): the control panel names of ${_X_DST_ACCT} on the target could not be read -- the store is not copied"
      _XCOPY_PANEL_OWN=""
      _XCOPY_PANEL_UNREAD=YES
      _XCOPY_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && _XCOPY_STORE_RC=3
      return 0
    fi
    [ -n "${_XCOPY_PANEL_NAMES}" ] \
      && echo "INFO: static/files (${_X_DST_ACCT}): the control panels' own stores stay on each box (${_XCOPY_PANEL_NAMES// /, })"
  fi
  # Canonical mount layout uses the DEST account name, so a rename lands correctly.
  _xcopy_handle_store \
    "${_X_SRC_USR}/static/files" \
    "${_X_DST_STATIC_FILES}" \
    "files/${_X_DST_ACCT}/static/files" \
    "${_X_TGT_HOST}" "${_X_TGT_MNT}" "${_X_IENI}${_XCOPY_PANEL_EXCL:+ ${_XCOPY_PANEL_EXCL}}" \
    "static/files (${_X_DST_ACCT})" "${_X_SRC_USR##*/}" || _XCOPY_STORE_RC=$?
  # no other store of the account carries a panel's
  _XCOPY_PANEL_OWN=""
}

### Learn the host key of a target this box has never met before the first
### ssh or rsync to it: their non-interactive calls would otherwise fail host
### key verification. xoct's _xoct_learn_peer_host_key twin (the tools stay
### separate, not DRY-ed), except that it takes a host name too: the hold gate
### reads one, and an unknown key there would let a held target pass. A name
### outside that alphabet or a key already known is left alone. The name is
### looked up lowercased, as ssh-keyscan records it and ssh looks it up.
_xcopy_learn_peer_host_key() {
  local _p
  _p="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  [[ "${_p}" =~ ^[a-z0-9][a-z0-9.:-]*$ ]] || return 0
  ssh-keygen -F "${_p}" > /dev/null 2>&1 && return 0
  mkdir -p /root/.ssh
  chmod 700 /root/.ssh
  if _mig_keyscan "${_p}"; then
    echo "INFO: learned the host key for target ${_p}"
  else
    echo "ALRT: could not learn the host key for ${_p} -- unreachable on 22?"
  fi
  return 0
}

# xcopy copies an account under its own name only. A fourth argument naming
# another account is a rename, which is xoct's: xcopy rewrites no old account
# name in the copied vhosts, aliases or panel database (its import renames
# only the source hostname), so a renamed copy would keep
# pointing into the old account's tree (on the target, another tenant's).
# Refused before the account is read, the target is asked or anything of
# the account is changed on either box: a DENY, the dry run is not clean,
# every verb stops.
_xcopy_refuse_rename() {   # 1 account here 2 fourth argument 3 target
  if [ -z "${2}" ] || [ "${2}" = "${1}" ]; then
    return 0
  fi
  echo "DENY: xcopy does not rename: ${1} is copied as ${1} only, never as ${2}; to move it under a new name use xoct"
  _XCOPY_NOT_CLEAN=YES
  [ "${_MODE}" = "DRY" ] && _xcopy_finalize_dry "${1}" "${3}"
  exit 1
}

_migrate_init() {
  _xcopy_refuse_rename "${_oct}" "${_dst}" "${_tgt}"
  _USR=/data/disk/${_oct}
  if [ "${_oct}" = "arch" ] \
    || [ "${_oct}" = "all" ] \
    || [ "${_oct}" = "lost+found" ] \
    || [ "${_oct}" = "lostfound" ] \
    || [ "${_oct}" = "backups" ] \
    || [ "${_oct}" = "codebases-cleanup" ]; then
    echo "_USR ${_oct} is not eligible for migration: system dir"
    exit 1
  fi
  ### The release check is an account's. The shared and xusage legs name
  ### none, and there is no /data/disk/xusage to read.
  if [ ! -e "${_USR}/tools/le/dehydrated" ] && [ "${_oct}" != "shared" ] \
    && [ "${_oct}" != "xusage" ]; then
    echo
    echo "ERROR: This version of xcopy migration tool supports only BOA-3.2.2 or newer"
    echo "ERROR: Please upgrade ${_oct} instance to current BOA head before trying again"
    echo "Bye."
    echo
    exit 1
  fi
  if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
    _SQL_CONNECT=127.0.0.1
    _THIS_DB_PORT=6033
  fi
  ### With no target the usage records leg would address this box itself.
  if [ "${_oct}" = "xusage" ] && [ -z "${_tgt}" ]; then
    echo "ERROR: ${_cmd} xusage needs a target: xcopy ${_cmd} xusage <target>"
    exit 1
  fi
  ### The verbs that reach the target learn its host key before their first
  ### contact (the hold read before them would pass an unknown key by
  ### silently). An account's export, import and noproxy reach no peer; the
  ### shared and xusage legs reach the target whatever the verb.
  case "${_cmd}:${_oct}" in
    create:*|pretransfer:*|transfer:*|*:shared|*:xusage)
      _xcopy_learn_peer_host_key "${_tgt}"
      ;;
  esac
  if [ "${_oct}" = "xusage" ]; then
    ### The box's usage records alone, which the shared leg also carries:
    ### for a second pass close to the move. The same dry run first.
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} start"
    ### One login that runs nothing comes first: a key that is not the one
    ### held here is named, and a target that takes no login is refused,
    ### before a dry run calls the copy clean or anything travels.
    local _xu_said
    _xu_said="$(ssh -o ConnectTimeout=10 -o BatchMode=yes root@"${_tgt}" true 2>&1 < /dev/null)" || {
      if _mig_hostkey_changed "${_tgt}" "${_xu_said}"; then
        echo "ERROR: ${_tgt} serves a host key that is not the one this box holds for it"
        echo "ERROR: (${_MIG_HOSTKEY_SAYS}); nothing travelled. Make the check named above,"
        echo "ERROR: forget the old entries here, then run this command again"
      else
        _xu_said="${_xu_said//$'\r'/}"
        _xu_said="${_xu_said##*$'\n'}"
        _xu_said="${_xu_said//[^[:print:]]/?}"
        echo "ERROR: ${_cmd} for ${_oct}: no login to ${_tgt} (${_xu_said:0:200}); nothing travelled"
      fi
      _XCOPY_NOT_CLEAN=YES
      if [ "${_MODE}" = "DRY" ]; then
        echo "DENY: ${_cmd} for ${_oct}: no usable login to ${_tgt}, as the ERROR above says"
        _xcopy_finalize_dry "${_oct}" "${_tgt}"
      fi
      exit 1
    }
    [ "${_MODE}" = "LIVE" ] && _xcopy_require_clean_dry "${_oct}" "${_tgt}"
    if compgen -G "/var/log/boa/usage/*" > /dev/null; then
      if ! _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/log/boa/usage/* root@${_tgt}:/var/log/boa/usage/; then
        echo "ERROR: ${_cmd} for ${_oct}: the copy of /var/log/boa/usage to ${_tgt} failed"
        exit 1
      fi
      echo "INFO: ${_cmd} for ${_oct} /var/log/boa/usage complete"
    else
      echo "INFO: ${_cmd} for ${_oct}: this box holds no usage records, nothing to copy"
    fi
    if [ "${_MODE}" = "LIVE" ]; then
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} complete"
    else
      _xcopy_finalize_dry "${_oct}" "${_tgt}"
    fi
  elif [ "${_oct}" = "shared" ]; then
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} start"
    # Refuse an empty target: an empty ssh host resolves to localhost, so the arch
    # step's remote mkdir/rm would run against THIS (source) box and could delete the
    # live arch symlink. Never proceed with the shared sync without a real target.
    # Resolve the target's attached mount (aborts on empty/unreachable/multi-mount).
    _xcopy_resolve_target_mnt "${_tgt}"
    # --live requires a prior CLEAN dry run for this shared+target.
    [ "${_MODE}" = "LIVE" ] && _xcopy_require_clean_dry "${_oct}" "${_tgt}"
    _XCOPY_STORE_RC=0
    if [ -d "/data/all" ] && [ ! -L "/data/all" ]; then
      _xcopy_rsync -aEAXqu ${_ieni} -e ssh /data/all  root@${_tgt}:/data/
      echo "INFO: ${_cmd} for ${_oct} /data/all complete"
    fi
    if [ -d "/data/disk/all" ]; then
      _xcopy_rsync -aEAXqu ${_ieni} -e ssh /data/disk/all  root@${_tgt}:/data/
      echo "INFO: ${_cmd} for ${_oct} /data/disk/all complete"
    fi
    # arch: storage-aware -- mirror onto the target mount, or de-reference to root,
    # per the target's disk reality (canonical layout <mount>/files/system/arch).
    _xcopy_handle_store "/data/disk/arch" "/data/disk/arch" "files/system/arch" \
      "${_tgt}" "${_TGT_MNT}" "${_ieni}" "arch" || _XCOPY_STORE_RC=$?
    if [ "${_XCOPY_STORE_RC:-0}" != "0" ]; then
      echo "ERROR: ${_cmd} for ${_oct}: arch could not be placed on the target (see DENY above); refusing"
      exit 1
    fi
    ### Hard stop, matching xmass and the old tool: a Solr leg that does not
    ### fit means this account arrives WITHOUT its search indices, and
    ### nothing in the LIVE path reads _XCOPY_NOT_CLEAN, so skipping it
    ### finishes "clean" while quietly losing the data.
    if [ -e "/opt/solr4" ]; then
      if ! _xcopy_solr_check "/opt/solr4" "/opt" "solr4"; then
        echo "ERROR: solr4 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to copy ${_oct} without its search indices"
        exit 1
      fi
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /opt/solr4 root@${_tgt}:/opt/
      echo "INFO: ${_cmd} for ${_oct} /opt/solr4 complete"
    fi
    if [ -e "/var/solr7/data" ]; then
      if ! _xcopy_solr_check "/var/solr7/data" "/var/solr7" "solr7"; then
        echo "ERROR: solr7 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to copy ${_oct} without its search indices"
        exit 1
      fi
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/solr7/data root@${_tgt}:/var/solr7/
      echo "INFO: ${_cmd} for ${_oct} /var/solr7/data complete"
    fi
    if [ -e "/var/solr9/data" ]; then
      if ! _xcopy_solr_check "/var/solr9/data" "/var/solr9" "solr9"; then
        echo "ERROR: solr9 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to copy ${_oct} without its search indices"
        exit 1
      fi
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/solr9/data root@${_tgt}:/var/solr9/
      echo "INFO: ${_cmd} for ${_oct} /var/solr9/data complete"
    fi
    if [ -e "/var/www/static" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/www/static root@${_tgt}:/var/www/
      echo "INFO: ${_cmd} for ${_oct} /var/www/static complete"
    fi
    if [ -e "/etc/bind" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /etc/bind root@${_tgt}:/etc/
      echo "INFO: ${_cmd} for ${_oct} /etc/bind complete"
    fi
    if [ -e "/var/log/boa/usage" ]; then
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /var/log/boa/usage root@${_tgt}:/var/log/boa/
      echo "INFO: ${_cmd} for ${_oct} /var/log/boa/usage complete"
    fi
    if [ -e "/data/disk/legacy" ]; then
      echo "INFO: ${_cmd} for ${_oct} /data/disk/legacy start"
      _xcopy_rsync -aEAXq ${_ieni} -e ssh /data/disk/legacy root@${_tgt}:/data/disk/
      echo "INFO: ${_cmd} for ${_oct} /data/disk/legacy complete"
    fi
    if [ "${_MODE}" = "LIVE" ]; then
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} complete"
    else
      _xcopy_finalize_dry "${_oct}" "${_tgt}"
    fi
  else
    _USR=/data/disk/${_oct}
    ### Who the account belongs to, read before the target is contacted, as
    ### xoct reads it (_xcopy_client_address: one space between words, an
    ### escaped @ plain, never through the shell's word or glob expansion):
    ### one of the hosted service's own addresses marks an internal account,
    ### refused on every verb; an account with no plain address in
    ### log/email.txt or its cnf is refused at the start of a copy (create,
    ### export, pretransfer), as in xoct.
    _xcopy_client_address "${_USR}" "${_oct}"
    _RESULT_EMAIL=OK
    for _xe in "${_XCOPY_EMAIL_TXT}" "${_XCOPY_EMAIL}"; do
      if [ "${_xe}" = "inbox@boa.io" ] \
        || [[ "${_xe}" == *"emaylx@"* ]] \
        || [[ "${_xe}" == *"mixomax@"* ]] \
        || [[ "${_xe}" == *"@omega8.cc"* ]]; then
        _RESULT_EMAIL=OUR
      fi
    done
    if [ "${_RESULT_EMAIL}" = "OK" ] && [ -z "${_XCOPY_EMAIL}" ]; then
      _RESULT_EMAIL=BAD
    fi
    _XCOPY_START_VERB=NO
    case "${_cmd}" in
      create|export|pretransfer) _XCOPY_START_VERB=YES ;;
    esac
    ### A target that holds its clients' mail for a test run takes no real
    ### copy (_xcopy_hold_gate), before anything is written there.
    case "${_cmd}" in
      create|pretransfer|transfer)
        _xcopy_hold_gate "${_tgt}" || exit 1
      ;;
    esac
    if [ "${_oct}" = "arch" ] \
      || [ "${_oct}" = "all" ] \
      || [ "${_oct}" = "lost+found" ] \
      || [ "${_oct}" = "lostfound" ] \
      || [ "${_oct}" = "backups" ] \
      || [ "${_oct}" = "codebases-cleanup" ]; then
      echo "_USR ${_oct} is not eligible for migration: system dir"
      exit 1
    elif [ ! -e "${_USR}/log/cores.txt" ] \
      || [ ! -e "${_USR}/log/option.txt" ] \
      || [ ! -e "${_USR}/log/email.txt" ]; then
      echo "_USR ${_oct} is not eligible for migration: broken"
      exit 1
    elif [ -e "${_USR}/log/CANCELLED" ]; then
      echo "_USR ${_oct} is not eligible for migration: cancelled"
      exit 1
    elif _wg_free_unfinished "${_oct}"; then
      echo "_USR ${_oct} is not eligible for migration: a free of its web group name is unfinished (/etc/boa/control/instgrp-web.${_oct}.free.txt)"
      echo "INFO: the account's next Octopus pass here finishes it, or 'instgrp webconvert ${_oct}' (which also converts the account and lifts a _WEB_GROUP=NO opt-out), once no xmass, xoct or xcopy run is live, and never while the account is frozen (log/proxied.pid); re-run then"
      exit 1
    elif [ -e "${_USR}/log/proxied.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already migrated"
      exit 1
    elif [ "${_cmd}" = "create" ] && [ -e "${_USR}/log/exported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already created"
      exit 1
    elif [ "${_cmd}" = "export" ] && [ -e "${_USR}/log/exported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already exported"
      exit 1
    elif [ "${_cmd}" = "transfer" ] && [ -e "${_USR}/log/transferred.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already transferred"
      exit 1
    elif [ "${_cmd}" = "transfer" ] && [ -e "${_USR}/log/export_failed.pid" ] \
      && [ "${_XCOPY_FORCE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: export incomplete"
      echo "ALRT: log/export_failed.pid is present -- the last export left FAILED site dumps:"
      _xcopy_read_in "${_USR}/log" export_failed.pid | sed "s/^/ALRT:   /"
      echo "INFO: re-run 'xcopy export' after fixing the cause, or pass --force to transfer anyway"
      exit 1
    elif [ "${_cmd}" = "import" ] && [ -e "${_USR}/log/export_failed.pid" ] \
      && [ "${_XCOPY_FORCE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: export incomplete"
      echo "ALRT: log/export_failed.pid travelled with this account -- the source export left FAILED site dumps:"
      _xcopy_read_in "${_USR}/log" export_failed.pid | sed "s/^/ALRT:   /"
      echo "INFO: fix and re-run export + transfer on the source, or pass --force to import anyway"
      exit 1
    elif [ "${_cmd}" = "import" ] && [ -e "${_USR}/log/imported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already imported"
      exit 1
    elif [ "${_cmd}" = "fooproxy" ] && [ -e "${_USR}/log/proxied.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already proxied"
      exit 1
    elif [ "${_RESULT_EMAIL}" = "OUR" ]; then
      echo "_USR ${_oct} is not eligible for migration: internal only"
      exit 1
    elif [ "${_XCOPY_START_VERB}" = "YES" ] && [ "${_RESULT_EMAIL}" = "BAD" ]; then
      echo "_USR ${_oct} is not eligible for migration: no plain address in log/email.txt ('$(_xcopy_shown "${_XCOPY_EMAIL_TXT}")') or in _CLIENT_EMAIL of /root/.${_oct}.octopus.cnf"
      echo "INFO: set the client's address as _CLIENT_EMAIL in /root/.${_oct}.octopus.cnf and re-run"
      exit 1
    else
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} start"
      if [ "${_XCOPY_FORCE}" = "YES" ] && [ -e "${_USR}/log/export_failed.pid" ]; then
        if [ "${_cmd}" = "transfer" ] || [ "${_cmd}" = "import" ]; then
          echo "ALRT: --force: proceeding although log/export_failed.pid marks FAILED site dumps"
        fi
      fi
      if [ "${_cmd}" = "transfer" ] || [ "${_cmd}" = "pretransfer" ]; then
        if [ ! -z "${_dst}" ]; then
          _DST=/data/disk/${_dst}
        else
          _DST=/data/disk/${_oct}
        fi
        # Resolve the target's attached mount (aborts on empty/unreachable/multi-mount).
        _xcopy_resolve_target_mnt "${_tgt}"
        # The account's web group: refused on a target whose tools predate
        # it, mapped onto the target account's otherwise (before the token
        # below is consumed, so a refusal never costs another dry run).
        _xcopy_webgroup_gate "${_oct}" "${_DST##*/}" "${_tgt}"
        # and its own group, on every leg ahead of the web group's
        _xcopy_acct_gmap "${_oct}" "${_DST##*/}" "${_tgt}"
        _xcopy_acct_umap "${_oct}" "${_DST##*/}" "${_tgt}"
        _XCOPY_GMAP="${_XCOPY_AMAP}${_XCOPY_AMAP:+${_XCOPY_GMAP:+,}}${_XCOPY_GMAP}"
        # --live requires a prior CLEAN dry run for this account+target.
        [ "${_MODE}" = "LIVE" ] && _xcopy_require_clean_dry "${_oct}" "${_tgt}"
        _XCOPY_STORE_RC=0
        if [ -e "${_USR}" ]; then
          # distro/ and src/ belong to oN on both boxes: each leg expands its
          # glob inside the real source directory and the receiver writes inside
          # the real target directory (created when missing), so a link the
          # account put at either name is never followed or written through.
          # A leg whose source is not a real directory is refused (DENY) by
          # _xcopy_leg_ok, never skipped quietly.
          _xcopy_leg_ok "${_USR}/distro" \
            && _xcopy_in_real_dir "${_USR}/distro" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/distro" '*' -aEAXqu ${_ieni}
          _xcopy_leg_ok "${_USR}/src" \
            && _xcopy_in_real_dir "${_USR}/src" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/src" '*' -aEAXqu ${_ieni}
          _xcopy_transfer_static_symlink_safe "${_USR}" "${_tgt}" "${_DST}" "${_ieni}" "${_TGT_MNT}"
          #
          # The sub-account password store must land BEFORE clients/ does:
          # manage_ltd_users creates sub-users from clients/ on its first
          # pass that sees them and honours a pre-existing store entry (the
          # carried password) only if it is already there. Forced (no -u): the
          # target's fresh install must never shadow the carried credentials.
          # The store is the account's: sent from inside the real directory
          # into the real directory on the target (made when missing). Its
          # entries are keyed by the full sub-user name, so it travels whole
          # under the account's own name only (as in xoct).
          if [ "${_DST##*/}" = "${_oct}" ]; then
            _xcopy_leg_ok "/home/${_oct}.ftp/users" \
              && _xcopy_in_real_dir "/home/${_oct}.ftp/users" _xcopy_copy_mk_here \
                "${_tgt}" "/home/${_DST##*/}.ftp/users" '' -aEAX ${_ieni}
          fi
          # clients/ is oN's on both boxes: pinned both ends, target made real.
          _xcopy_leg_ok "${_USR}/clients" \
            && _xcopy_in_real_dir "${_USR}/clients" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/clients" '*' -aEAXqu ${_ieni}
          # instance-group.txt records the SOURCE box's conversion (its gid);
          # it must never travel, the destination pass writes its own, and
          # web-group-notes.txt (a temp copy of it too) names the source
          # box's web-group state.
          # log/ is oN's on both boxes: copied from inside the real directory
          # into the real directory, the glob expanded there. The account's
          # own log/email.txt then goes over the install's copy (one address,
          # newer, so the -u leg keeps it), forced and never as a link: the
          # target keeps the client's address, or list, exactly as it is.
          if _xcopy_leg_ok "${_USR}/log"; then
            _xcopy_in_real_dir "${_USR}/log" _xcopy_copy_here "${_tgt}" "${_DST}/log" '*' \
              -aEAXqu ${_ieni} --exclude=instance-group.txt '--exclude=.instance-group.txt.put.*' --exclude=proxy-failed.pid \
              --exclude=web-group-notes.txt '--exclude=.web-group-notes.txt.put.*'
            _xcopy_in_real_dir "${_USR}/log" _xcopy_copy_here "${_tgt}" "${_DST}/log" 'email.txt' \
              -aEAXq --no-links ${_ieni}
          fi
          # static/control is the tenant's on both boxes: a control that is a
          # link is never followed (the glob this replaces expanded through
          # it); a real one travels by its top-level entries, from inside it
          # into the real control directory on the target. Its subdirectories
          # came with the static pass above and are never entered here by name.
          # Its web-group-notes.txt never travels, nor a temp copy of it: it
          # names the source box's web-group state.
          if [ -L "${_USR}/static/control" ]; then
            echo "ALRT: ${_USR}/static/control is a symlink -- not followed; no control file travels"
          elif [ -d "${_USR}/static/control" ]; then
            _xcopy_in_real_dir "${_USR}/static/control" _xcopy_copy_here "${_tgt}" \
              "${_DST}/static/control" '' -aEAXqu ${_ieni} --exclude='*/' \
              --exclude=/web-group-notes.txt '--exclude=/.web-group-notes.txt.put.*'
          fi
          #
          # backups/ and backup-exports/ follow the nightly's store layout
          # (see _xcopy_backups_leg). undo/ is oN's on both boxes: pinned both
          # ends, the target directory made real (the installer does not).
          _xcopy_backups_leg "${_USR}" "${_DST}" "${_tgt}" "${_ieni}" backups
          _xcopy_backups_leg "${_USR}" "${_DST}" "${_tgt}" "${_ieni}" backup-exports
          _xcopy_leg_ok "${_USR}/undo" \
            && _xcopy_in_real_dir "${_USR}/undo" _xcopy_copy_mk_here "${_tgt}" \
              "${_DST}/undo" '*' -aEAXqu ${_ieni}
          # The account's SSH keys: from the real directory into the real one.
          _xcopy_leg_ok "/home/${_oct}.ftp/.ssh" \
            && _xcopy_in_real_dir "/home/${_oct}.ftp/.ssh" _xcopy_copy_mk_here \
              "${_tgt}" "/home/${_DST##*/}.ftp/.ssh" '' -aEAXqu ${_ieni}

          # Client-installed toolchains live outside /data/disk in the lshell
          # jail's writable trees: copied AS-IS (as in xoct). The parents are
          # sticky and world-writable, so each leaf is its owner's to replace:
          # pinned as the account legs are.
          _xcopy_leg_ok "/opt/user/gems/${_oct}.ftp" \
            && _xcopy_in_real_dir "/opt/user/gems/${_oct}.ftp" _xcopy_copy_mk_here \
              "${_tgt}" "/opt/user/gems/${_DST##*/}.ftp" '' -aEAXqu ${_ieni}
          _xcopy_leg_ok "/opt/user/npm/${_oct}.ftp" \
            && _xcopy_in_real_dir "/opt/user/npm/${_oct}.ftp" _xcopy_copy_mk_here \
              "${_tgt}" "/opt/user/npm/${_DST##*/}.ftp" '' -aEAXqu ${_ieni}

          # The PHP coverage gate re-runs on every LIVE transfer: the control
          # files the pass above carried, changed here since create, must
          # never name a version in force here that the target lacks. A dry
          # run names a choice the target would start to honour (as in xoct).
          # The client's shell credentials converge on every LIVE transfer
          # too, never in a dry run: they change the target.
          if [ "${_MODE}" = "LIVE" ]; then
            if ! _xcopy_php_coverage_gate "${_USR}" "${_tgt}"; then
              echo "ERROR: ${_cmd} for ${_oct}: target PHP coverage failed AFTER the file sync;"
              echo "ERROR: NOT marking the transfer complete -- fix the target PHP set and re-run"
              exit 1
            fi
            _xcopy_sync_shell_credentials "${_oct}" "${_DST##*/}" "${_tgt}"
          else
            _xcopy_php_inert_report "${_USR}" "${_tgt}" deny
          fi

          ### The target keeps its own panel aliases (hostmaster, hm and
          ### server_master). Import reads the hostmaster alias to find the
          ### panel it pours into, and drives drush @hostmaster: a source
          ### copy that won the -u mtime race named a site_path the target
          ### does not have, so the whole panel import was skipped, and its
          ### server_master sent drush to the source host. The source
          ### platform_* and per-site aliases still travel. Exact names: an
          ### rsync pattern with no slash is matched against the FINAL path
          ### component and, with no wildcard, must match it whole (the old
          ### --exclude=server_ and --exclude=hostmaster never matched
          ### anything). .drush is oN's on both boxes: copied from inside the
          ### real directory into the real directory, the glob expanded there.
          _xcopy_leg_ok "${_USR}/.drush" \
            && _xcopy_in_real_dir "${_USR}/.drush" _xcopy_copy_here "${_tgt}" \
              "${_DST}/.drush" '*.alias.drushrc.php' -aEAXqu ${_ieni} \
              --exclude=hostmaster.alias.drushrc.php \
              --exclude=hm.alias.drushrc.php \
              --exclude=server_master.alias.drushrc.php

          # config/ and tools/ belong to oN on both boxes: every leg below
          # expands its glob inside the real source directory and the receiver
          # writes inside the real target directory (created when missing), so a
          # link the account put at a directory name is never followed or written
          # through. Subdirectories below the top level are still walked by rsync
          # as it finds them.
          _xcopy_leg_ok "${_USR}/config/server_master/nginx/vhost.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/vhost.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/vhost.d" '*' \
              -aEAXqu ${_ieni} --exclude=host8.biz --exclude=boa.io --exclude=aegir.cc

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/pre.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/pre.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/pre.d" '*' \
              -aEAXqu ${_ieni}

          # the control panel's own pool include stays behind: the target's
          # worker writes its own once the pool is up there, and a carried
          # one would name a socket the target does not have yet
          _xcopy_leg_ok "${_USR}/config/server_master/nginx/post.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/post.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/post.d" '*' \
              -aEAXqu ${_ieni} --exclude=fpm_include_panel.inc

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/subdir.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/subdir.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/subdir.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/server_master/nginx/platform.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/nginx/platform.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/platform.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/ssl.d" \
            && _xcopy_in_real_dir "${_USR}/config/ssl.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/ssl.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/config/server_master/ssl.d" \
            && _xcopy_in_real_dir "${_USR}/config/server_master/ssl.d" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/config/server_master/ssl.d" '*' \
              -aEAXqu ${_ieni}

          _xcopy_leg_ok "${_USR}/tools" \
            && _xcopy_in_real_dir "${_USR}/tools" \
              _xcopy_copy_mk_here "${_tgt}" "${_DST}/tools" 'le' \
              -aEAXqu ${_ieni}

          # Catch-all: fix any OTHER /mnt-anchored symlink in the account tree that the
          # rsync -a passes above transferred as a bare (dangling-on-target) link.
          _xcopy_catchall_mnt_symlinks "${_USR}" "${_DST}" "${_tgt}" "${_TGT_MNT}" "${_ieni}"

          if [ "${_XCOPY_STORE_RC:-0}" != "0" ]; then
            echo "ERROR: ${_cmd} for ${_oct}: a store/symlink could not be placed on the target (see DENY above); NOT marking transfer complete"
            exit 1
          fi

          # What the copy does not carry of the web-group state (a pin, a
          # revert in progress, phase B onto a box with it off, an opt-out
          # the target's cnf lacks: xcopy carries it only at create), named
          # once the copy is there, never a refusal.
          [ "${_cmd}" = "transfer" ] && _wg_migration_notes "${_oct}" "${_DST##*/}" "${_tgt}" cnf

          if [ "${_MODE}" = "LIVE" ]; then
            # The copy landed with this box's numeric gids; hand the tree
            # to the account's group on the target (mirrors xoct).
            _acct_regroup_remote "${_dst:-${_oct}}" "${_tgt}"
            echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} complete"
            # Only the real transfer marks the account migrated -- pretransfer
            # shares this completion path (warm-up rsync while the account is
            # still live) and marking it here made the documented
            # pretransfer -> export -> transfer sequence self-blocking at the
            # transferred.pid eligibility gate. Mirrors the xoct fix.
            if [ "${_cmd}" = "transfer" ]; then
              ### A transfer that passed the export gate means the source's
              ### export is clean now -- a stale export_failed.pid that
              ### travelled with an earlier --force transfer must not wedge
              ### the import on the target forever.
              ### log/ is oN's on both boxes: removed and stamped inside the
              ### real directory, never through a link put there.
              if [ ! -e "${_USR}/log/export_failed.pid" ]; then
                _xcopy_remote_in "${_tgt}" "${_DST}/log" 'rm -f -- ./export_failed.pid' &> /dev/null
              fi
              _xcopy_in_real_dir "${_USR}/log" _xcopy_touch_here transferred.pid
            fi
          else
            _xcopy_finalize_dry "${_oct}" "${_tgt}"
          fi
        fi
      else
        # shellcheck disable=SC1091
        [ -e "/root/.${_oct}.octopus.cnf" ] && source /root/.${_oct}.octopus.cnf
        ### We are using max verbose mode by default
        _migrate_prepare
          ### _NOW=$(date +%y%m%d-%H%M)
          ### mkdir -p /var/log/boa/migrate
          ### _migrate_prepare >/var/log/boa/migrate/migrate-${_oct}-${_cmd}-${_NOW}.log 2>&1
        if [ "${_cmd}" = "fooproxy" ]; then
          service nginx reload
          # log/ is oN's: stamped inside the real directory, never through a link
          echo COMPLETE | _xcopy_in_real_dir "${_USR}/log" _xcopy_write_here proxied.pid
        fi
      fi
      if [ "${_XCOPY_RUN_FAIL}" = "YES" ]; then
        ### Truthful run verdict: per-site ALRT lines above already name the
        ### failures; harness callers key on the rc.
        echo "ALRT: ${_cmd} for ${_oct} to ${_tgt} ${_dst} INCOMPLETE -- see ALRT/ERROR lines above"
        exit 1
      fi
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} complete"
      exit 0
    fi
  fi
}

# pre-mig key exchange. The source publishes its root public key on its
# undefined vhost and the target fetches it over plain HTTP, so the target
# trusts it only when its fingerprint equals the one the source printed,
# carried across by the operator as --key-fp. Anything else answering on
# that name, or a stale key another box still serves there, would otherwise
# be granted root on the target.
_XCOPY_KEY_LINE_RE='^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp[0-9]+|sk-ssh-ed25519@openssh\.com) [A-Za-z0-9+/]+=*( |$)'

# The form 'ssh-keygen -l -E sha256' prints: SHA256: and 43 base64
# characters. A pasted '=' pad is accepted and dropped before comparing.
_xcopy_valid_key_fp() {
  [[ "$1" =~ ^SHA256:[A-Za-z0-9+/]{43}=?$ ]]
}

_xcopy_print_key_fp() {
  local _fp
  _fp=$(ssh-keygen -l -E sha256 -f /root/.ssh/id_ed25519.pub 2>/dev/null \
    | awk '{print $2; exit}')
  if _xcopy_valid_key_fp "${_fp}"; then
    echo "INFO: published key fingerprint: ${_fp}"
    echo "INFO: on the target run: xcopy pre-mig ${_hName} --key-fp=${_fp}"
  else
    echo "ALRT: could not read the fingerprint of /root/.ssh/id_ed25519.pub;"
    echo "ALRT: the target's pre-mig needs it: ssh-keygen -l -E sha256 -f /root/.ssh/id_ed25519.pub"
  fi
}

# Target side, run before anything is parked: sets _XCOPY_SRC_KEY to the one
# fetched key line whose fingerprint is --key-fp, or refuses with nothing
# added to authorized_keys.
_xcopy_fetch_source_key() {
  local _kf="/root/.ssh/auth_undefined_keys.txt" _kc _krc _kl _fp _seen=""
  _XCOPY_SRC_KEY=""
  case "${_hst}" in
    ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*)
      echo "ERROR: pre-mig on the target needs the source's hostname, got '${_hst}'"
      return 1
      ;;
  esac
  if [ -z "${_XCOPY_KEY_FP}" ]; then
    echo "ERROR: pre-mig on the target needs --key-fp=SHA256:..., the fingerprint"
    echo "ERROR: 'xcopy pre-mig ${_hst}' printed on ${_hst}; nothing was changed here"
    return 1
  fi
  if ! _xcopy_valid_key_fp "${_XCOPY_KEY_FP}"; then
    echo "ERROR: --key-fp '${_XCOPY_KEY_FP}' is not a SHA256 key fingerprint"
    echo "ERROR: (SHA256: and 43 base64 characters); nothing was changed here"
    return 1
  fi
  _XCOPY_KEY_FP="${_XCOPY_KEY_FP%=}"
  mkdir -p /root/.ssh
  chmod 700 /root/.ssh
  rm -f /root/.ssh/auth_undefined_keys.txt*
  # ...and this box's own published copy: a box that was ever a source goes
  # on serving its root key, and a later migration could fetch it.
  rm -f /var/www/nginx-default/auth_undefined_keys.txt*
  # curl exits 0 on a 404 (no -f): a source that never published, or a
  # proxied one relaying its undefined vhost onward, hands back an HTML
  # page. Both the status and a real key line are required. Bounded: a name
  # that answers and then stalls, or a body no key file comes near, is the
  # same refusal rather than a hang; a failed transfer counts even when the
  # status line said 200.
  _kc=$(curl -s -A iCab --connect-timeout 15 --max-time 60 \
    --max-filesize 65536 -w '%{http_code}' \
    "http://undefined.${_hst}/auth_undefined_keys.txt" \
    -o "${_kf}" 2>/dev/null)
  _krc=$?
  if [ "${_krc}" != "0" ] || [ "${_kc}" != "200" ] \
    || ! grep -qE "${_XCOPY_KEY_LINE_RE}" "${_kf}" 2>/dev/null; then
    rm -f "${_kf}"
    echo "ERROR: no public key at http://undefined.${_hst}/auth_undefined_keys.txt (HTTP ${_kc:-000}, curl exit ${_krc})"
    echo "ERROR: publish it first: run 'xcopy pre-mig ${_hst}' ON ${_hst}, then re-run this here"
    return 1
  fi
  # Each key line is fingerprinted on its own: only the named key is kept.
  while IFS= read -r _kl; do
    printf '%s\n' "${_kl}" > "${_kf}.one"
    _fp=$(ssh-keygen -l -E sha256 -f "${_kf}.one" 2>/dev/null \
      | awk '{print $2; exit}')
    [ -n "${_fp}" ] || continue
    _seen="${_seen:+${_seen} }${_fp}"
    if [ "${_fp}" = "${_XCOPY_KEY_FP}" ]; then
      _XCOPY_SRC_KEY="${_kl}"
      break
    fi
  done < <(grep -E "${_XCOPY_KEY_LINE_RE}" "${_kf}")
  rm -f "${_kf}.one"
  if [ -z "${_XCOPY_SRC_KEY}" ]; then
    rm -f "${_kf}"
    echo "ERROR: the key ${_hst} serves does not match --key-fp:"
    echo "ERROR:   expected ${_XCOPY_KEY_FP}"
    echo "ERROR:   served   ${_seen:-none}"
    echo "ERROR: nothing was added to authorized_keys and nothing was parked here"
    return 1
  fi
  echo "INFO: the key ${_hst} serves matches --key-fp ${_XCOPY_KEY_FP}"
  return 0
}

# Whether authorized_keys $1 holds the key $2 ('<type> <blob>') under the
# tag $3: a live line (no comment, no options before the key type) that
# starts with the key and ends with exactly that tag. xoct and xmass keep
# the same test.
_xcopy_key_tagged_in() {
  local _l
  [ -f "${1}" ] || return 1
  while IFS= read -r _l || [ -n "${_l}" ]; do
    _l="${_l%"${_l##*[![:space:]]}"}"
    case "${_l}" in
      "${2}${3}"|"${2}"[[:space:]]*"${3}") return 0 ;;
    esac
  done < "${1}"
  return 1
}

# authorized_keys $1 trusts the key line $2 under the tag $3. Present only as
# _xcopy_key_tagged_in reads it: a substring test counted the key tagged for
# another peer, or bound by an operator's options, as present, so the new
# source got no line of its own and was held by the old options. Otherwise
# an exact untagged copy of $2 is tagged in place (exact-line rewrite: a key
# comment may carry regex metacharacters, and a last line without a newline
# is kept), else the tagged line is appended; a second line for one key is
# harmless to sshd and gives this peer its own witness line. A commented-out
# copy is never present: it would leave the key untrusted. The rewrite
# replaces the file only when it is whole: a write that failed (a full disk)
# or a line count that differs from the file's leaves authorized_keys as it
# was and returns 1, where a cut-short copy would drop every key past the
# break.
_xcopy_key_trust_line() {
  local _ak="${1}" _kb="${2}" _tag="${3}" _kt _kx _ktmp _hit=NO _wok=YES _n=0
  _kx="${_kb#* }"
  _kt="${_kb%% *} ${_kx%% *}"
  _xcopy_key_tagged_in "${_ak}" "${_kt}" "${_tag}" && return 0
  if [ -f "${_ak}" ]; then
    _ktmp="${_ak}.xcopy.$$"
    while IFS= read -r _kx || [ -n "${_kx}" ]; do
      _n=$((_n + 1))
      if [ "${_kx%"${_kx##*[![:space:]]}"}" = "${_kb}" ]; then
        _kx="${_kb}${_tag}"
        _hit=YES
      fi
      printf '%s\n' "${_kx}" || _wok=NO
    done < "${_ak}" > "${_ktmp}" || _wok=NO
    [ "${_n}" = "$(grep -ac '' "${_ak}" 2>/dev/null)" ] || _wok=NO
    if [ "${_wok}" != "YES" ]; then
      rm -f "${_ktmp}"
      echo "ERROR: could not rewrite ${_ak} in full; it was left as it was"
      return 1
    fi
    if [ "${_hit}" = "YES" ] && ! cat "${_ktmp}" > "${_ak}"; then
      echo "ERROR: writing ${_ak} failed; its full rewrite is kept at ${_ktmp}"
      return 1
    fi
    rm -f "${_ktmp}"
  fi
  if [ "${_hit}" = "NO" ]; then
    echo >> "${_ak}"
    printf '%s\n' "${_kb}${_tag}" >> "${_ak}"
  fi
  chmod 600 "${_ak}"
  _xcopy_key_tagged_in "${_ak}" "${_kt}" "${_tag}"
}

# The day root gave the peer $1 its reach. A relay that ended before that day
# cannot take it back: this is a new move's key, or a carry for a live front.
_mig_reach_stamp() {
  local _f="/root/.migration.peer.reach" _t
  [[ "${1}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 0
  _t="$(grep -v "^${1//./\\.} " "${_f}" 2> /dev/null)"
  { [ -z "${_t}" ] || printf '%s\n' "${_t}"; printf '%s %s\n' "${1}" "$(date -u '+%Y-%m-%d')"; } > "${_f}.$$" \
    && chmod 600 "${_f}.$$" && mv -f -- "${_f}.$$" "${_f}"
}

# A move from $1 into this box is under way until this box's post-mig: the
# trust tool keeps the peer's reach while its line is in the pending file.
_mig_pending_open() {
  local _f="/root/.migration.peer.pending" _t
  [[ "${1}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 0
  _t="$(grep -v "^${1//./\\.} " "${_f}" 2> /dev/null)"
  if ! { { [ -z "${_t}" ] || printf '%s\n' "${_t}"; printf '%s %s\n' "${1}" "$(date -u '+%Y-%m-%d')"; } > "${_f}.$$" \
    && chmod 600 "${_f}.$$" && mv -f -- "${_f}.$$" "${_f}"; }; then
    rm -f -- "${_f}.$$"
    echo "ALRT: could not write ${_f}: the daily trust prune may take the key of ${1} before post-mig"
    return 1
  fi
}

# Only the verified line travels, TAGGED with the source's address the way
# xmass tags its own, so a later promotion can attribute it to a peer.
_xcopy_trust_source_key() {
  local _ak="/root/.ssh/authorized_keys" _src_ip _kb
  _src_ip=$(getent ahostsv4 "${_hst}" 2>/dev/null | awk '{print $1; exit}')
  _kb="${_XCOPY_SRC_KEY%"${_XCOPY_SRC_KEY##*[![:space:]]}"}"
  if ! _xcopy_key_trust_line "${_ak}" "${_kb}" \
    " # xcopy migration source ${_src_ip:-${_hst}}"; then
    echo "ERROR: could not add the key from ${_hst} to ${_ak}"
    return 1
  fi
  echo "INFO: key ${_XCOPY_KEY_FP} from ${_hst} is in ${_ak}"
  _mig_reach_stamp "${_src_ip}"
  _mig_pending_open "${_src_ip}"
  return 0
}

_post_mig() {
  local _rn
  if [ -e "/vservers" ]; then
    echo You can not run _post_mig on the parent system
    echo Exit now
    exit 1
  else
    echo Running _post_mig inside vms ${_hName}
    if [ -x "/etc/init.d/solr9" ] && [ -e "/etc/default/solr9.in.sh" ]; then
      pkill -9 -f '^[^ ]*java[0-9]* .*solr9'
      service solr9 start
    fi
    if [ -x "/etc/init.d/solr7" ] && [ -e "/etc/default/solr7.in.sh" ]; then
      pkill -9 -f '^[^ ]*java[0-9]* .*solr7'
      service solr7 start
    fi
    pkill -9 -f '^[^ ]*java[0-9]* .*jetty9'
    rm -rf /tmp/{drush*,pear,jetty*}
    rm -f /var/log/jetty9/*
    if [ -e "/etc/default/jetty9" ] && [ -e "/etc/init.d/jetty9" ]; then
      service jetty9 start
    fi
    service nginx reload
    [ -e "/run/boa_wait.pid" ] && rm -f /run/boa_wait.pid
    # A refetch or a system pass that restored a live copy first left the
    # parked one behind: stale bytes that read as a park again whenever the
    # live name goes missing. Removed once the live copy is there.
    for _rn in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
      if [ ! -e "/var/xdrago/${_rn}" ] && [ -e "/var/xdrago/.${_rn}.off" ]; then
        mv -f "/var/xdrago/.${_rn}.off" "/var/xdrago/${_rn}"
      elif [ -e "/var/xdrago/${_rn}" ] && [ -e "/var/xdrago/.${_rn}.off" ]; then
        rm -f "/var/xdrago/.${_rn}.off"
      fi
    done
    # The park ends here: the runners are back, and the next tools refresh
    # re-checks them (their ctrl stamps were cleared while they were parked).
    rm -f /run/boa_migration_park.pid
    # Every move into this box is over: the trust tool judges its sources'
    # reach by their relays again.
    rm -f /root/.migration.peer.pending
    # The move is over: a source stops serving its root key.
    rm -f /var/www/nginx-default/auth_undefined_keys.txt*
    # Cron must come back on WHICHEVER box runs post-mig: the import step
    # stops it on the target (renameaegirhost's queue assumes it is not
    # running), and a box left without it runs no BOA job at all.
    /etc/init.d/cron start &> /dev/null || service cron start &> /dev/null
    if ! pgrep -x cron &> /dev/null; then
      echo "ALRT: cron did not start; the BOA runners and every scheduled job are DOWN"
      echo "ALRT: start it manually: /etc/init.d/cron start"
    fi
    # On the target: how each copied site's verify ended.
    _xcopy_verify_report
    exit 0
  fi
}

_pre_mig() {
  if [ -e "/vservers" ]; then
    echo You can not run _pre_mig on the parent system
    echo Exit now
    exit 1
  else
    echo Running _pre_mig inside vms ${_hName}
    # Target mode checks --key-fp and the key it names before anything is
    # parked, so a refusal leaves this box as it was.
    if [ "${_hName}" != "${_hst}" ]; then
      _xcopy_fetch_source_key || exit 1
    fi
    # The park holds until post-mig: while this marker lives, BOA's tools
    # refresh leaves a runner parked as .<name>.off alone. Without it the
    # next clear.sh tick fetched every parked runner back. The refresh tests
    # the park before it fetches a runner and again right before it writes
    # one; both tests need this marker and the live copy gone, so the marker
    # is written before the runners move. A refresh already running then
    # drops a runner it fetched while the park landed; only a write that
    # passed its last test in the instant before a move can still land.
    # clear.sh drops the marker after 24 hours and /run does not survive a
    # reboot, so an abandoned copy gets its runners back. A re-run re-arms
    # it.
    if ! printf '%s\n' "xcopy pre-mig ${_hst:-none} $(date -u '+%F %T') UTC" \
      > /run/boa_migration_park.pid; then
      echo "ALRT: could not write /run/boa_migration_park.pid; the next clear.sh tick fetches the parked runners back"
    fi
    if [ -e "/var/xdrago/runner.sh" ]; then
      mv -f /var/xdrago/runner.sh /var/xdrago/.runner.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/runner\.sh( |$)'
    fi
    if [ -e "/var/xdrago/owl.sh" ]; then
      mv -f /var/xdrago/owl.sh /var/xdrago/.owl.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/owl\.sh( |$)'
    fi
    if [ -e "/var/xdrago/usage.sh" ]; then
      mv -f /var/xdrago/usage.sh /var/xdrago/.usage.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/usage\.sh( |$)'
    fi
    if [ -e "/var/xdrago/graceful.sh" ]; then
      mv -f /var/xdrago/graceful.sh /var/xdrago/.graceful.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/graceful\.sh( |$)'
    fi
    if [ -e "/var/xdrago/manage_ltd_users.sh" ]; then
      mv -f /var/xdrago/manage_ltd_users.sh /var/xdrago/.manage_ltd_users.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/manage_ltd_users\.sh( |$)'
    fi
    if [ "${_hName}" = "${_hst}" ]; then
      echo Preparing source ${_hName} for outgoing migration...
      if [ ! -e "/root/.ssh/id_ed25519.pub" ]; then
        echo "Generating SSH (ed25519) keys for root..."
        ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519
      fi
      if [ -e "/root/.ssh/id_ed25519.pub" ]; then
        mkdir -p /var/www/nginx-default
        cp -af /root/.ssh/id_ed25519.pub /var/www/nginx-default/auth_undefined_keys.txt
        _xcopy_print_key_fp
      else
        echo Ops.. /root/.ssh/id_ed25519.pub does not exist in ${_hName}
      fi
    else
      echo Preparing target ${_hName} for incoming migration...
      echo Add remote id_ed25519.pub to authorized_keys here...
      _xcopy_trust_source_key || exit 1
      ### A source that holds another key for this box's address is refused
      ### at its first login here; these are the lines it compares.
      _mig_tell_host_keys
    fi
  fi
  echo All done!
}

_sub_ssl_gen() {
  IFS=$'\12'
  for p in `cat /root/.ssl.proxy.cnf`;do
    _hmFrontExtra=""
    _domain_name=`echo $p | cut -d' ' -f1 | awk '{ print $1}'`
    _target_ip=`echo $p | cut -d' ' -f2 | awk '{ print $1}'`
    _oct_uid=`echo $p | cut -d' ' -f3 | awk '{ print $1}'`
    _oct_mail=`echo $p | cut -d' ' -f4 | awk '{ print $1}'`
    _dedicated_ip=`echo $p | cut -d' ' -f5 | awk '{ print $1}'`
    echo _domain_name.${_domain_name} _target_ip.${_target_ip} _oct_uid.${_oct_uid} _oct_mail.${_oct_mail} _dedicated_ip.${_dedicated_ip}
    if [ ! -z "${_domain_name}" ] \
      && [ ! -z "${_target_ip}" ] \
      && [ ! -z "${_oct_uid}" ] \
      && [ ! -z "${_oct_mail}" ] \
      && [ ! -z "${_dedicated_ip}" ]; then
      _oct_mail=`echo ${_oct_mail} | sed "s/\@/\\\@/g"`;
      if [ "${_target_ip}" = "${_dedicated_ip}" ]; then
        _dedicated_ip="*"
        ### extra_domain.txt holds the control panel's extra names: only the
        ### panel's own record claims them, or nginx keeps whichever proxy
        ### sorts first and a site's proxy answers for the panel. log/ is
        ### oN's: both read inside the real directory, never through a link
        ### or into a FIFO, and only host names reach the server_name line.
        _hmFront=$(_xcopy_read_in "/data/disk/${_oct_uid}/log" domain.txt | tr -d '\n')
        if [ -n "${_hmFront}" ] && [ "${_domain_name}" = "${_hmFront}" ] \
          && [ -e "/data/disk/${_oct_uid}/log/extra_domain.txt" ]; then
          _hmFrontExtra=$(_xcopy_read_in "/data/disk/${_oct_uid}/log" extra_domain.txt \
            | tr -s ' \t\r' '\n' \
            | grep -E '^[a-zA-Z0-9*][a-zA-Z0-9.*-]*$' \
            | awk 'length($0) <= 253' \
            | tr '\n' ' ')
          _hmFrontExtra="${_hmFrontExtra% }"
        fi
        if [ ! -z "${_hmFrontExtra}" ]; then
          _dedicated_sn="${_domain_name} ${_hmFrontExtra} www.${_domain_name}"
        else
          _dedicated_sn="${_domain_name} www.${_domain_name}"
        fi
        _single=YES
      else
        _dedicated_sn="_"
        _single=NO
      fi
      ###
      ### Check the directory actually written into, not an unrelated install
      ### marker. The old guard tested the real write target; the rewrite tests
      ### /var/aegir/.drush/hm.alias.drushrc.php instead and nothing here
      ### creates pre.d -- so on a master where it is missing every cp fails,
      ### each sed then edits a file that does not exist, and the loop still
      ### announces "OK created". The result is a proxy with no proxy config.
      _PreD="/var/aegir/config/server_master/nginx/pre.d"
      if [ ! -d "${_PreD}" ]; then
        mkdir -p "${_PreD}" 2>/dev/null
        [ -d "/var/aegir/config/server_master/nginx" ] \
          && chown --reference=/var/aegir/config/server_master/nginx \
             "${_PreD}" 2>/dev/null
      fi
      if [ ! -d "${_PreD}" ]; then
        echo "ERROR: ${_PreD} is missing and cannot be created"
        echo "ERROR: NO proxy config written for ${_domain_name}"
        continue
      fi
      _Pln="${_PreD}/z_${_domain_name}_pln_proxy.conf"
      _Ssl="${_PreD}/z_${_domain_name}_ssl_proxy.conf"
      ###
      if [ "${_single}" = "YES" ]; then
        rm -f ${_Pln}
      else
        cp -af /var/xdrago/conf/pln_proxy.conf      ${_Pln}
        sed -i "s/_domain_name/${_domain_name}/g"   ${_Pln}
        wait
        sed -i "s/_target_ip/${_target_ip}/g"       ${_Pln}
        wait
        sed -i "s/_oct_uid/${_oct_uid}/g"           ${_Pln}
        wait
        sed -i "s/_oct_mail/${_oct_mail}/g"         ${_Pln}
        wait
        sed -i "s/_dedicated_ip/${_dedicated_ip}/g" ${_Pln}
        wait
        sed -i "s/_dedicated_sn/${_dedicated_sn}/g" ${_Pln}
        wait
        ### Say "created" only when it is there. The unconditional echo was
        ### the reason a failed write read as a success.
        if [ -s "${_Pln}" ]; then
          echo OK created ${_Pln}
        else
          echo "ERROR: failed to write ${_Pln}"
        fi
      fi
      ###
      cp -af /var/xdrago/conf/ssl_proxy.conf        ${_Ssl}
      sed -i "s/_domain_name/${_domain_name}/g"     ${_Ssl}
      wait
      sed -i "s/_target_ip/${_target_ip}/g"         ${_Ssl}
      wait
      sed -i "s/_oct_uid/${_oct_uid}/g"             ${_Ssl}
      wait
      sed -i "s/_oct_mail/${_oct_mail}/g"           ${_Ssl}
      wait
      sed -i "s/_dedicated_ip/${_dedicated_ip}/g"   ${_Ssl}
      wait
      sed -i "s/_dedicated_sn/${_dedicated_sn}/g"   ${_Ssl}
      wait
      [ -e "/etc/nginx/no_ktls.conf" ] \
        && sed -i "/ssl_conf_command Options.*KTLS/d" ${_Ssl}
      wait
      ### The local control panel front does not offer HTTP/3. A reload
      ### hands the shared UDP sockets to the new workers, so a QUIC
      ### transfer in flight is cut within seconds of every reload, while a
      ### TCP one drains on the old worker; with reloads every few minutes
      ### a large backup download never completed. Alt-Svc clear makes a
      ### browser drop the alternative it cached from earlier visits. The
      ### proxy for a moved instance (_single=NO) keeps HTTP/3, and drops the
      ### template's IP list includes: those judge one domain, while this
      ### proxy answers every name on its address and the new host judges them.
      if [ "${_single}" = "YES" ]; then
        sed -i "/^[[:space:]]*listen .*:443 quic;/d; /^[[:space:]]*http3\(_hq\)\?[[:space:]].*on;/d" ${_Ssl}
        wait
        if ! grep -q "Alt-Svc" ${_Ssl}; then
          sed -i "s/^\([[:space:]]*\)proxy_buffering[[:space:]].*off;/&\n\1proxy_hide_header          Alt-Svc;\n\1add_header                 Alt-Svc clear always;/" ${_Ssl}
          wait
        fi
      else
        sed -i "/^[[:space:]]*include \/data\/disk\/.*\/includes\/\(ip_access\|user_admin_access\|user_admin_access_map\)\//d" ${_Ssl}
        wait
      fi
      ### The satellite pass rewrites the template's fastcgi target to the
      ### fpm socket after calling this generator; a standalone run left
      ### 127.0.0.1:9000 behind -- nothing listens there, so /sqladmin
      ### answers 502 until the next satellite pass. Do the same rewrite
      ### here: resolve the master pool from the cnf without sourcing it
      ### and rewrite only when that pool socket really listens (fail-safe:
      ### the satellite pass still converges the vhost otherwise).
      _fpmVer=$(sed -n 's/^_PHP_FPM_VERSION=//p' /root/.barracuda.cnf 2>/dev/null \
        | tail -n 1 | sed 's/[[:space:]]*#.*$//' | tr -d '" ')
      _fpmCn="www${_fpmVer//[^0-9]/}"
      if [ -n "${_fpmVer}" ] && [ -S "/var/run/${_fpmCn}.fpm.socket" ]; then
        sed -i "s/127.0.0.1:9000;/unix:\/var\/run\/${_fpmCn}.fpm.socket;/g" ${_Ssl}
        wait
      fi
      ###
      if [ -e "${_Ssl}" ]; then
        _sslFile="/etc/ssl/private/${_domain_name}.dhp"
        if [ ! -e "${_sslFile}" ]; then
          echo "We will generate .dhp file now, please wait..."
          openssl dhparam -out ${_sslFile} 2048 &> /dev/null
        else
          _PFS_TEST=$(grep "DH PARAMETERS" ${_sslFile} 2>&1)
          if [[ ! "${_PFS_TEST}" =~ "DH PARAMETERS" ]]; then
            echo "We will generate .dhp file now, please wait..."
            openssl dhparam -out ${_sslFile} 2048 &> /dev/null
          fi
        fi
      fi
      ###
      ### Say "created" only when it is there -- the same guard as the plain
      ### half above. The reload stays unconditional: reloading with one
      ### config missing is harmless, and the plain half may have landed.
      if [ -s "${_Ssl}" ]; then
        echo OK created ${_Ssl}
      else
        echo "ERROR: failed to write ${_Ssl}"
      fi
      service nginx reload
    else
      echo some variables missing in the record: $p
    fi
  done
}

_ssl_gen() {
  if [ ! -e "/root/.ssl.proxy.cnf" ]; then
    echo "please create /root/.ssl.proxy.cnf first"
    exit 1
  elif [ ! -e "/var/xdrago/conf/pln_proxy.conf" ]; then
    echo "file /var/xdrago/conf/pln_proxy.conf does not exist"
    exit 1
  elif [ ! -e "/var/xdrago/conf/ssl_proxy.conf" ]; then
    echo "file /var/xdrago/conf/ssl_proxy.conf does not exist"
    exit 1
  elif [ ! -e "/var/aegir/.drush/hm.alias.drushrc.php" ]; then
    echo "vms ${_vms} aegir master not ready"
    exit 1
  else
    [ -e "/root/.ssl.proxy.cnf" ] && _sub_ssl_gen
  fi
}

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    ionice -c2 -n7 -p $$
    chmod a+w /dev/null
    if [ ! -e "/dev/fd" ]; then
      if [ -e "/proc/self/fd" ]; then
        rm -rf /dev/fd
        ln -sfn /proc/self/fd /dev/fd
      fi
    fi
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    _ADM_EMAIL=${_MY_EMAIL//\\\@/\@}
    _BCC_EMAIL=${_MY_EMAIL//\\\@/\@}
    if [ "${_THIS_DB_HOST}" = "localhost" ] \
      || [ "${_THIS_DB_HOST}" = "FQDN" ]; then
      _SQL_CONNECT=localhost
    elif [ "${_THIS_DB_HOST}" = "127.0.0.1" ] \
      || [ "${_THIS_DB_HOST}" = "PROXYSQL" ]; then
      _SQL_CONNECT=127.0.0.1
    else
      _SQL_CONNECT="${_THIS_DB_HOST}"
    fi
    if [ "${_THIS_DB_HOST}" = "${_MY_OWNIP}" ]; then
      _SQL_CONNECT=localhost
    fi
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
  _DI_TEST="$(LC_ALL=C command df -P -i -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="IUse%") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DI_TEST}" =~ ^[0-9]+$ ]] || _DI_TEST=""
  if [ ! -z "${_DI_TEST}" ] && [ "${_DI_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk is almost out of inodes !!! ${_DI_TEST}/100"
    echo "ERROR: We can not proceed until inode use is below 90/100"
    echo "ERROR: Every file takes an inode, free space alone is not enough: df -i /"
    exit 1
  fi
  # A test, not ||: tr exits 0 on an empty /etc/hostname
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n')"
  [ -n "${_hName}" ] || _hName="$(hostname -f 2>/dev/null)"
}

### The run log. Every verb keeps its whole output, both streams, in
### /var/backups/reports/<tool>/<YYMMDD>/<tool>-<verb>-<YYMMDD-HHMMSS>-<pid>.log,
### readable by root alone, as barracuda and octopus keep theirs under
### reports/up; not the polled ones (xmass status, xmass autosync --run, whose
### monitor keeps each pass, and --status) nor a call with no verb. As the
### barracuda wrapper runs its worker, this process becomes a wrapper: it runs
### the same tool with the same arguments as its child, both streams into the
### file, shows the file on the console with a tail, and returns the child's
### status only once the tail has handed on the last line, so a caller that
### reads its own copy at once finds it whole. The child keeps the signal
### dispositions and the input the wrapper was started with, and the third
### header line names its pid. A daemon a verb starts inherits the file, never
### the console. A tool another migration tool runs on this box keeps no log
### and leaves its streams as they were, so its output goes where its caller
### sends it, into the caller's log when there is one (_MIG_RUNLOG, exported,
### reads "none" when the caller keeps no log); the caller's terminal is
### handed down in _MIG_RUNLOG_TTY for the notices that go straight to it. No
### log is kept, silently, for a user other than root or a tool whose own path
### cannot be read; nor, with one line saying so, with under 1 GiB free or free
### space that cannot be read, in a folder that cannot be written, with a tail
### lacking --pid or when the placeholder for the console cannot be opened.
### _MIG_RUNLOG_DIR and _MIG_RUNLOG_MIN_KB are for tests.
_mig_runlog_start() {
  local _tool="${1}" _a _verb _now _dir _file _base _free _self _term="" _lead=NO _hw="" _h _t _c _rc _tp _td=" " _s
  shift
  if [ -n "${_MIG_RUNLOG:-}" ]; then
    if [ "${_MIG_RUNLOG_WRAPPER:-}" = "${PPID}" ]; then
      echo "== run pid $$"
      unset _MIG_RUNLOG_WRAPPER
    fi
    return 0
  fi
  export _MIG_RUNLOG=none
  unset _MIG_RUNLOG_TTY _MIG_RUNLOG_WRAPPER
  _verb=""
  for _a in "$@"; do
    case "${_a}" in
      -*|*=*) continue ;;
    esac
    _verb="${_a}"
    break
  done
  [ -n "${_verb}" ] || return 0
  case "${_tool}:${_verb}" in
    xmass:status) return 0 ;;
    xmass:autosync)
      case " $* " in
        *" --run "*|*" --status "*) return 0 ;;
      esac
      ;;
  esac
  [ -n "${_MIG_RUNLOG_DIR:-}" ] || [ "$(id -u)" = "0" ] || return 0
  _self="$(readlink -f -- "$0" 2> /dev/null)"
  [ -n "${_self}" ] && [ -f "${_self}" ] || return 0
  _verb="$(printf '%s' "${_verb}" | tr -cd 'a-z0-9-' | cut -c1-32)"
  _now="$(date +%y%m%d-%H%M%S)"
  _base="${_MIG_RUNLOG_DIR:-/var/backups/reports/${_tool}}"
  _dir="${_base}/${_now%%-*}"
  _file="${_dir}/${_tool}-${_verb:-none}-${_now}-$$.log"
  if ! tail --pid=1 -n 0 /dev/null > /dev/null 2>&1; then
    echo "ALRT: ${_tool}: no run log kept, this tail has no --pid" >&2
    return 0
  fi
  while [ ! -d "${_base}" ]; do
    case "${_base}" in
      */*) _base="${_base%/*}" ;;
      *) _base=. ;;
    esac
    [ -n "${_base}" ] || _base=/
  done
  _free="$(df -Pk "${_base}" 2> /dev/null | awk 'NR == 2 { print $4 }')"
  case "${_free}" in
    ''|*[!0-9]*)
      echo "ALRT: ${_tool}: no run log kept, the free space for ${_file} cannot be read" >&2
      return 0
      ;;
  esac
  if [ "${_free}" -lt "${_MIG_RUNLOG_MIN_KB:-1048576}" ]; then
    echo "ALRT: ${_tool}: no run log kept, ${_free} KiB free for ${_file}" >&2
    return 0
  fi
  if ! ( umask 077; mkdir -p "${_dir}" && : >> "${_file}" ) 2> /dev/null \
    || [ -L "${_file}" ] || [ ! -f "${_file}" ]; then
    echo "ALRT: ${_tool}: no run log kept, ${_file} cannot be written" >&2
    return 0
  fi
  {
    echo "== ${_tool} $* | $(date '+%F %T %Z') | $(hostname -f 2> /dev/null) | wrapper pid $$"
    echo "== run log: ${_file}"
  } >> "${_file}"
  [ -t 2 ] && _term="$(tty <&2 2> /dev/null)"
  export _MIG_RUNLOG="${_file}"
  export _MIG_RUNLOG_WRAPPER="$$"
  case "${_term}" in
    /dev/*) export _MIG_RUNLOG_TTY="${_term}" ;;
  esac
  ### The dispositions found on entry: _tp sets back those trapped or ignored,
  ### _td names the signals at their default.
  _tp="$(trap -p HUP INT QUIT TERM)"
  for _s in HUP INT QUIT TERM; do
    [ -n "$(trap -p "${_s}")" ] || _td="${_td}${_s} "
  done
  ### A wrapper that leads its session on a terminal (session id its own pid,
  ### a terminal number set) is read before anything is started.
  case "$(awk '{ sub(/.*\) /, ""); print $4 " " $5 }' "/proc/$$/stat" 2> /dev/null)" in
    "$$ 0"|"") : ;;
    "$$ "*) _lead=YES ;;
  esac
  ### The placeholder reads a pipe only the wrapper writes to: it ends when the
  ### wrapper closes it, or when the wrapper is gone, even as a zombie its
  ### caller has not reaped yet. It takes its ignores from the wrapper, as a
  ### process substitution may not keep its own for INT and QUIT. The tail
  ### follows the placeholder, and both ignore every signal the run may get.
  ### Until the run is forked, a signal then only runs a no-op, so the wrapper
  ### is not lost in that moment, and the run gets the dispositions the wrapper
  ### was started with.
  trap '' HUP INT QUIT TERM
  exec {_hw}> >(exec cat > /dev/null)
  _h=$!
  trap : HUP INT QUIT TERM
  if [ -z "${_hw}" ] || [ -z "${_h}" ] || ! kill -0 "${_h}" 2> /dev/null; then
    [ -z "${_hw}" ] || exec {_hw}>&-
    ### Back to the dispositions found on entry. Only a signal then at its
    ### default is reset: a reset makes an INT ignored when bash started (a
    ### job started with &) fatal again, and no trap ignores it after that.
    for _s in HUP INT QUIT TERM; do
      case "${_td}" in *" ${_s} "*) trap - "${_s}" ;; esac
    done
    eval "${_tp}"
    echo "ALRT: ${_tool}: no run log kept, the placeholder for the console could not be opened" >&2
    ### The day folder stays: another run may be making its file there.
    rm -f "${_file}"
    export _MIG_RUNLOG=none
    unset _MIG_RUNLOG_WRAPPER _MIG_RUNLOG_TTY
    return 0
  fi
  ( trap '' HUP INT QUIT TERM PIPE
    exec tail -n +1 -s 0.2 --pid="${_h}" -f - ) {_hw}>&- 2> /dev/null < "${_file}" &
  _t=$!
  ### The run keeps the wrapper's input: 0<&0 counts as its own input, which a
  ### job started with & would otherwise lose to /dev/null. INT and QUIT, which
  ### bash ignores in a job started with &, are put back.
  if { true <&0; } 2> /dev/null; then
    ( trap - INT QUIT
      exec "${BASH:-/bin/bash}" "${_self}" "$@" ) {_hw}>&- 0<&0 >> "${_file}" 2>&1 &
  else
    ( trap - INT QUIT
      exec "${BASH:-/bin/bash}" "${_self}" "$@" ) {_hw}>&- < /dev/null >> "${_file}" 2>&1 &
  fi
  _c=$!
  ### A signal for the run reaches it in its group (Ctrl-C, timeout, a closed
  ### session) or at its own pid, the third header line, and the wrapper
  ### ignores it, so one wait gives the run's exact status. A wrapper that leads
  ### its session (a remote terminal or a screen window with the tool as its
  ### whole command) keeps HUP: the hangup the terminal sends it alone ends it,
  ### and the terminal then hangs up the run's group, as it did the bare tool.
  trap '' INT QUIT TERM
  if [ "${_lead}" = YES ]; then
    trap - HUP
  else
    trap '' HUP
  fi
  wait "${_c}"
  _rc=$?
  exec {_hw}>&-
  wait "${_t}" 2> /dev/null
  ### A run that ended with 129, 130 or 143, the status of a run ended by HUP,
  ### INT or TERM (the tools' own traps exit 130 on all three), ends the wrapper
  ### on that signal, so a calling script stops at Ctrl-C (lock.inc re-raises
  ### its signal for the same reason).
  case "${_rc}" in
    129|130|143)
      trap - HUP INT TERM
      kill -s "$(kill -l "${_rc}")" "$$"
      ;;
  esac
  exit "${_rc}"
}
_mig_runlog_start xcopy "$@"

# The DRY/live gate applies ONLY to the migration transfer commands. Utility commands
# — notably `ssl-gen` (renders proxy SSL vhosts from /root/.ssl.proxy.cnf), plus pre-mig,
# post-mig, export, import, create and proxy — run unaffected (LIVE) and their arguments
# are never touched. For transfer/pretransfer the default is a read-only DRY run and an
# explicit --live is required (accepted only after a CLEAN dry run for the same
# account+target — the autosymlink --batch model). Only --prefixed mode flags are
# recognised (and stripped), so no positional argument is ever mistaken for one.
# A shared or xusage run given any other verb is a live run: it needs, and uses up,
# a clean dry run of the same word and target.
_MODE=LIVE
_XCOPY_NOT_CLEAN=NO
_XCOPY_GMAP=""
_XCOPY_AMAP=""
_XCOPY_UMAP=""
_XCOPY_FORCE=""
### Set by create's --fix-php alone (_xcopy_php_coverage_gate).
_XCOPY_FIX_PHP=""
### admail=<address>, any verb, any position, as xoct takes it: a test or
### canary run that must never mail a client. xcopy sends no notices of its
### own; under admail= its create installs only with the install's welcome
### mail held back, create and import switch the account's upgrade notice
### off on the target, and the account keeps its own address. The token 'boa
### in-octopus' takes, handled the same way: taken out before the
### positionals are read, and refused unless it holds one plain address in
### the form the reader of a box's mail hold takes too (as in xoct).
_XCOPY_ADMAIL=""
_XCOPY_ADMAIL_SET=NO
_margs=()
for _a in "$@"; do
  case "${_a}" in
    admail=*) _XCOPY_ADMAIL="${_a#admail=}"; _XCOPY_ADMAIL_SET=YES ;;
    *) _margs+=("${_a}") ;;
  esac
done
set -- "${_margs[@]}"
if [ "${_XCOPY_ADMAIL_SET}" = "YES" ]; then
  if ! [[ "${_XCOPY_ADMAIL}" =~ ^[A-Za-z0-9_][A-Za-z0-9._%+-]*@[A-Za-z0-9][A-Za-z0-9.-]*\.[A-Za-z]{2,}$ ]] \
    || [[ "${_XCOPY_ADMAIL}" == -* ]]; then
    echo "ERROR: admail= must carry one plain address, got: '${_XCOPY_ADMAIL//[^[:print:]]/?}'"
    exit 1
  fi
fi
case "$1" in
  transfer|pretransfer)
    _MODE=DRY
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --live)        _MODE=LIVE ;;
        --dry|--test)  _MODE=DRY ;;
        --force)       _XCOPY_FORCE=YES ;;
        --*)
          ### An unknown --flag must never fall through to the positionals:
          ### the next free slot is the fourth argument (a destination name,
          ### which xcopy refuses unless it is the account's own).
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  create)
    ### --fix-php lets create extend the target's _PHP_MULTI_INSTALL and
    ### drive one barracuda system pass there when a PHP version in force
    ### here is missing; without it the PHP coverage gate refuses with the
    ### recipe. An unknown --flag must never fall through to the
    ### positionals: the next free slot is the fourth argument.
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --fix-php) _XCOPY_FIX_PHP=YES ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  import)
    ### --force bypasses the export_failed.pid refusal only; every other
    ### import gate (imported.pid and friends) is unaffected.
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --force) _XCOPY_FORCE=YES ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  pre-mig)
    ### --key-fp is what the target checks the fetched source key against;
    ### a mistyped flag must never fall through as the source hostname.
    _XCOPY_KEY_FP=""
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --key-fp=*) _XCOPY_KEY_FP="${_a#*=}" ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
esac

###-------------SINGLE-FLIGHT LOCK-------###

# A plain owner-PID file: live owner refuses, dead owner is taken over.
#
# This was flock at first, and flock was WRONG here for a reason worth keeping
# written down. The lock lives on an open descriptor, and xcopy restarts MySQL --
# so the new mysqld inherited that descriptor and, running forever, held the
# lock forever. Every later verb was refused by a run that had finished
# minutes earlier. Any long-lived daemon a migration starts would do the same.
#
# A PID file has nothing to inherit. A stale file cannot wedge anything either,
# because liveness is what is checked, not the file's existence -- so a holder
# killed outright costs nothing. The cmdline check matters: PIDs get recycled,
# and without it a recycled number belonging to some daemon would block the
# tool indefinitely, which is the same bug in a different coat.
#
# The refusal is loud and NON-ZERO on purpose: a quiet exit 0 would let a
# harness read "another run holds it" as success.

_XCOPY_LOCK_FILE="/run/xcopy.verb.pid"

# Acquisition is atomic (noclobber): the old check-then-write let two verbs
# started in the same instant both proceed. A dead or foreign owner's file is
# removed and the create retried; the loser of any race re-examines a LIVE
# owner and refuses.
#
# The owner match is anchored to an xcopy INVOCATION ("/xcopy" or a bare "xcopy"
# word followed by arguments), never the bare substring: the old *xcopy* glob
# matched any process whose cmdline merely mentions the name -- an operator's
# tail -F of a migration log was enough -- so a recycled PID could block every
# verb forever, the exact recycled-PID bug the liveness check exists to
# prevent.
#
# The signal traps EXIT: a bash signal trap otherwise returns to the next
# statement, so a TERM would remove the lock and then keep running the
# remaining legs, unlocked.
#
# Kept in step with xmass's _take_verb_lock -- mirror any fix there.
_take_verb_lock() {
  local _owner _cmdline _tries=0
  [ "$(id -u)" = "0" ] || return 0
  while :; do
    if ( set -C; echo "$$" > "${_XCOPY_LOCK_FILE}" ) 2>/dev/null; then
      trap '_xcopy_chattr_back; rm -f "${_XCOPY_LOCK_FILE}"' EXIT
      trap 'rm -f "${_XCOPY_LOCK_FILE}"; exit 130' INT TERM HUP
      return 0
    fi
    ### Bound the retry loop: a lock file that can be neither created nor
    ### removed (an unwritable /run) must end in the loud refusal this tool
    ### promises, never in a silent spin.
    _tries=$((_tries + 1))
    if [ "${_tries}" -gt 30 ]; then
      echo "ERROR: cannot claim ${_XCOPY_LOCK_FILE} -- refusing to run unlocked"
      exit 1
    fi
    _owner=$(tr -dc '0-9' 2>/dev/null < "${_XCOPY_LOCK_FILE}" | head -c 12)
    if [ -z "${_owner}" ] \
      && [ -n "$(find "${_XCOPY_LOCK_FILE}" -newermt '-5 seconds' 2>/dev/null)" ]; then
      ### A just-created lock can be read in the instant between its O_EXCL
      ### open and the PID write -- never reap a fresh empty file as dead.
      sleep 1
      continue
    fi
    if [ -n "${_owner}" ] && [ -d "/proc/${_owner}" ]; then
      _cmdline=$(tr '\0' ' ' 2>/dev/null < "/proc/${_owner}/cmdline")
      case "${_cmdline}" in
        */xcopy\ *|*/xcopy|*\ xcopy\ *)
          echo "ERROR: another xcopy run is in flight (pid ${_owner}) -- refusing to start '$1'. Wait for it to finish, or clear ${_XCOPY_LOCK_FILE} if that pid is not an xcopy run."
          exit 1
        ;;
      esac
    fi
    ### Dead or foreign owner: take the file over and retry the atomic create.
    rm -f "${_XCOPY_LOCK_FILE}" 2>/dev/null \
      || { echo "ERROR: cannot remove stale ${_XCOPY_LOCK_FILE} -- refusing to run unlocked"; exit 1; }
  done
}

###-------------SQL WATCHDOG PAUSE-------###

# export dumps and import loads databases: mysqldump/mysql for the panel,
# mydumper/myloader for every site. While /run/boa_sql_maintenance.pid exists
# the mysql.sh watchdog stands down entirely, so it cannot restart MySQL or
# kill mydumper in the middle of a dump or a load.
#
# The marker carries this run's PID, so the launchers read a killed run's
# marker as released. The EXIT trap removes it on every exit the shell can
# trap, and only while it still carries this PID; a kill -9 leaves it to the
# watchdog's 240-minute staleness limit. A marker another operation holds --
# a live PID that is not ours, or a fresh empty one -- is left to its owner.
# Re-asserted after the wait for a running BOA job, before each site and before
# the rename, so a marker its owner released mid-run is taken over at the next
# of those; a background beat refreshes ours every 20
# minutes, so one dump or load longer than the staleness limit stays paused.
# The traps are armed before the marker is written and the flag is cleared
# after it is removed, so no signal can land between the two.
#
# Kept in step with xoct's _xoct_sql_maint_hold -- mirror any fix there.
_XCOPY_SQL_MAINT=""
_XCOPY_SQL_MAINT_BEAT=""
_xcopy_sql_maint_hold() {
  local _mf=/run/boa_sql_maintenance.pid _mPid _pp=$$ _pst
  # Start time of this run: a recycled PID must not keep a dead run's marker fresh.
  _pst=$(cut -d' ' -f22 /proc/$$/stat 2>/dev/null)
  if [ -e "${_mf}" ] && [ -z "$(find "${_mf}" -mmin +240 2>/dev/null)" ]; then
    _mPid=$(tr -dc '0-9' 2>/dev/null < "${_mf}")
    if [ -z "${_mPid}" ] \
      || { [ "${_mPid}" != "$$" ] && kill -0 "${_mPid}" 2>/dev/null; }; then
      [ "${_XCOPY_SQL_MAINT}" = "OTHER" ] \
        || echo "INFO: ${_mf} is held by another operation (pid ${_mPid:-none}); left to its owner"
      _XCOPY_SQL_MAINT=OTHER
      return 0
    fi
  fi
  if [ "${_XCOPY_SQL_MAINT}" != "YES" ]; then
    _XCOPY_SQL_MAINT=YES
    # Signals masked first: one landing in here would run the exit below inside
    # this trap and skip the release, pausing the watchdog for hours. The release
    # goes before the chattr step, the one part that can block on a sick disk.
    trap 'trap "" INT TERM HUP; _xcopy_sql_maint_release; _xcopy_chattr_back; rm -f "${_XCOPY_LOCK_FILE}"' EXIT
    trap 'exit 130' INT TERM HUP
    if [ -z "${_XCOPY_SQL_MAINT_BEAT}" ] || ! kill -0 "${_XCOPY_SQL_MAINT_BEAT}" 2>/dev/null; then
      # Detached, not a child of this shell: the bare `wait` calls in this
      # tool must never wait on it. Ends on its own when this run is gone
      # (kill -9, OOM): an orphaned beat would keep the watchdog paused.
      _XCOPY_SQL_MAINT_BEAT=$(
        (
          # The sleep goes with the beat, so a stopped beat leaves no process;
          # jobs -p also covers a TERM landing before $! is read, and the second
          # kill a sleep the first reached between its fork and its exec.
          trap 'kill $(jobs -p) 2>/dev/null; sleep 0.2; kill $(jobs -p) 2>/dev/null; exit 0' TERM
          while :; do
            sleep 1200 & _bs=$!
            wait "${_bs}"
            [ -z "${_pst}" ] || [ "$(cut -d' ' -f22 "/proc/${_pp}/stat" 2>/dev/null)" = "${_pst}" ] || exit 0
            kill -0 "${_pp}" 2>/dev/null || exit 0
            [ "$(tr -dc '0-9' 2>/dev/null < "${_mf}")" = "${_pp}" ] && touch -c "${_mf}"
          done
        ) > /dev/null 2>&1 < /dev/null &
        echo "$!"
      )
    fi
    echo "INFO: SQL watchdog paused for the ${_cmd} database work (${_mf})"
  fi
  echo "$$" > "${_mf}"
}
_xcopy_sql_maint_release() {
  if [ -n "${_XCOPY_SQL_MAINT_BEAT}" ]; then
    kill "${_XCOPY_SQL_MAINT_BEAT}" 2>/dev/null
    _XCOPY_SQL_MAINT_BEAT=""
  fi
  [ "${_XCOPY_SQL_MAINT}" = "YES" ] || return 0
  if [ "$(tr -dc '0-9' 2>/dev/null < /run/boa_sql_maintenance.pid)" = "$$" ]; then
    rm -f /run/boa_sql_maintenance.pid
  fi
  _XCOPY_SQL_MAINT=""
  return 0
}

case "$1" in
  export|create|import|pretransfer|transfer|noproxy|pre-mig|post-mig|ssl-gen)
    _take_verb_lock "$1"
  ;;
esac

case "$1" in
  export)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  create)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  import)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _fix="fix"
            _check_root
            _migrate_init
  ;;
  pretransfer) _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  transfer) _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  noproxy)  _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  pre-mig)  _cmd="$1"
            _hst="$2"
            _check_root
            _pre_mig
  ;;
  post-mig) _cmd="$1"
            _hst="$2"
            _check_root
            _post_mig
  ;;
  ssl-gen)  _cmd="$1"
            _vms="$2"
            _check_root
            _ssl_gen
  ;;
  *)        echo
            echo "Usage: xcopy {pre-mig} {source-fqdn} (source vms: publishes its key and prints its fingerprint)"
            echo "Usage: xcopy {pre-mig} {source-fqdn} --key-fp=SHA256:... (target vms: the fingerprint the source printed)"
            echo "Usage: xcopy {export|create|pretransfer|transfer|noproxy} {o1|shared} {target-ip}"
            echo "Usage: xcopy {pretransfer|transfer} {xusage} {target-ip} (the usage records alone: a dry run, then --live)"
            echo "       (the account keeps its name: xoct moves an account under a new one)"
            echo "Usage: xcopy {create} {o1} {target-ip} [--fix-php] (installs the PHP versions in force here that the target lacks)"
            echo "Usage: xcopy {import} {o1} {target-ip} (target vms)"
            echo "Usage: xcopy {post-mig} {fqdn} (source+target vms)"
            echo
            echo "Usage: xcopy {ssl-gen}"
            echo
            echo "Any verb takes admail=<address> (test and canary runs): create installs"
            echo "only with the install's own welcome mail held back, and create and import"
            echo "switch the account's upgrade notice off on the target. Accounts keep their"
            echo "own addresses."
            echo
            exit 1
  ;;
esac

exit 0
