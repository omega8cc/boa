#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as root."
    exit 1
  fi
}
_check_root

# -----------------------------------------------------------------------------
# 1) Identify which user references which DB by scanning vhosts
# -----------------------------------------------------------------------------
_VHOSTS_DIRS=("/data/disk/*/config/server_master/nginx/vhost.d")

# We'll store:  db_name -> "vhost1 vhost2 ..."
declare -A _vhost_db_map

for _dir_pattern in "${_VHOSTS_DIRS[@]}"; do
  for _dir in ${_dir_pattern}; do
    [ -d "${_dir}" ] || continue
    for _vhost_file in "${_dir}"/*; do
      [ -f "${_vhost_file}" ] || continue

      # We'll read the file first to see if we should skip it entirely:
      skip_this_vhost=0
      while IFS= read -r _line; do
        # If line references /data/disk/whatever/aegir/distro/ in the docroot, we skip
        if echo "${_line}" | grep -qE "root\s+/data/disk/.*/aegir/distro/"; then
          skip_this_vhost=1
          break
        fi
      done < "${_vhost_file}"

      # If skip_this_vhost=1, do not parse DB references; move on to next file
      if [ "${skip_this_vhost}" -eq 1 ]; then
        # Optionally log this skip:
        echo "Skipping vhost due to aegir/distro pattern: ${_vhost_file}"
        continue
      fi

      # Otherwise, we parse the file again for DB references (or rewind w/ file descriptor)
      while IFS= read -r _line; do
        if echo "${_line}" | grep -q "fastcgi_param db_name"; then
          _db_name=$(echo "${_line}" | awk '{print $NF}' | tr -d ';')
          # Append vhost file to the db_name’s list if not already included
          if ! [[ " ${_vhost_db_map["${_db_name}"]} " =~ " ${_vhost_file} " ]]; then
            _vhost_db_map["${_db_name}"]+="${_vhost_file} "
          fi
        fi
      done < "${_vhost_file}"
    done
  done
done

# -----------------------------------------------------------------------------
# 2) Build a "db -> user(s)" map from the vhost paths
# -----------------------------------------------------------------------------
_get_username_from_path() {
  # Typical pattern: /data/disk/USER/config/server_master/nginx/vhost.d/example.conf
  # Splitting by '/' => [0:'',1:'data',2:'disk',3:'USERNAME',4:'config',...]
  local _vfile="$1"
  echo "${_vfile}" | cut -d'/' -f4
}

declare -A _db_users_map  # db_name -> "user1 user2 ..."
for _db_name in "${!_vhost_db_map[@]}"; do
  for _vhost_file in ${_vhost_db_map["${_db_name}"]}; do
    _this_user=$(_get_username_from_path "${_vhost_file}")
    if [ -n "${_this_user}" ]; then
      # Avoid duplicates
      if ! [[ " ${_db_users_map["${_db_name}"]} " =~ " ${_this_user} " ]]; then
        _db_users_map["${_db_name}"]+="${_this_user} "
      fi
    fi
  done
done

# -----------------------------------------------------------------------------
# 3) Copy relevant DB backups to each user’s space
# -----------------------------------------------------------------------------
_ARCH_SQL_BASE="/data/disk/arch/sql"
echo "Copying relevant DB backups into user spaces..."

for _backup_dir in "${_ARCH_SQL_BASE}"/*; do
  [ -d "${_backup_dir}" ] || continue
  _dir_name=$(basename "${_backup_dir}")
  _datetime="${_dir_name#*-}"  # e.g. host-DATESTAMP => just the DATETIME part

  # We'll track users who received new files in this directory,
  # then do a single chown -R for each user at the end.
  declare -A _touched_users=()

  for _backup_file in "${_backup_dir}"/*; do
    [ -f "${_backup_file}" ] || continue

    _base_file=$(basename "${_backup_file}")

    # Remove up to two extensions => e.g. dbName.sql.bz2 => dbName
    filename_no_ext="${_base_file}"
    filename_no_ext="${filename_no_ext%.*}"  # 1st ext
    filename_no_ext="${filename_no_ext%.*}"  # 2nd ext

    # If base ends with -DATETIME, remove that suffix => dbName
    if [[ "${filename_no_ext}" == *"-${_datetime}" ]]; then
      filename_no_ext="${filename_no_ext%-${_datetime}}"
    fi

    _possible_dbname="${filename_no_ext}"

    if [[ "${_possible_dbname}" == "mysql" || "${_possible_dbname}" == "sys" ]]; then
      # Debug log (optional)
      echo "Skipping system DB backup: ${_base_file} (DB: ${_possible_dbname})"
      continue
    else
      echo "_possible_dbname is ${_possible_dbname}"
    fi

    # If this DB is used by any users, copy the file for them
    if [ -n "${_db_users_map["${_possible_dbname}"]}" ]; then
      for _user in ${_db_users_map["${_possible_dbname}"]}; do
        _target_dir="/data/disk/${_user}/static/files/dbackup/${_datetime}"
        [ ! -d "${_target_dir}" ] && mkdir -p "${_target_dir}"

        _target_file="${_target_dir}/${_base_file}"

        if [ -e "${_target_file}" ]; then
          echo "File already exists, skipping: ${_target_file}"
        else
          echo "Copying ${_backup_file} => ${_target_file}"
          cp -a "${_backup_file}" "${_target_file}"
          # Mark that we touched this user's folder in this directory
          _touched_users["${_user}"]=1
        fi
      done
    fi
  done

  # Now batch-fix ownership for each user who got new files
  for _user in "${!_touched_users[@]}"; do
    _target_dir="/data/disk/${_user}/static/files/dbackup/${_datetime}"
    echo "Setting ownership for ${_target_dir} => ${_user}.ftp:users"
    chown -R "${_user}.ftp:users" "${_target_dir}"
  done
done

echo "Backup copying completed."

# -----------------------------------------------------------------------------
# 4) Cleanup old backups based on /data/disk/USER/static/control/dBackupCycle.info
# -----------------------------------------------------------------------------
#
# If the file exists and contains a number of days (e.g. 7, 14, 21, 60),
# remove archives older than that many days. Then remove empty subdirs.
# By default use 14 days if the file is missing or zero-length.

# Gather all users from _db_users_map to do cleanup
declare -A _all_involved_users=()
for _db_name in "${!_db_users_map[@]}"; do
  for _usr in ${_db_users_map["${_db_name}"]}; do
    _all_involved_users["${_usr}"]=1
  done
done

echo "Performing cleanup of old backups based on dBackupCycle.info..."

for _user in "${!_all_involved_users[@]}"; do
  _days_to_keep=
  _cycle_file="/data/disk/${_user}/static/control/dBackupCycle.info"

  # If empty or missing, default to 14 days
  if [ ! -s "${_cycle_file}" ]; then
    _days_to_keep=14
  fi

  # If user has a file OR we have a default
  if [ -s "${_cycle_file}" ] || [ -n "${_days_to_keep}" ]; then
    # If the file is non-empty, parse it
    if [ -s "${_cycle_file}" ]; then
      _days_to_keep=$(tr -d '[:space:]' < "${_cycle_file}")
      # Keep only digits
      _days_to_keep="${_days_to_keep//[^0-9]/}"
    fi

    if [[ "${_days_to_keep}" =~ ^[0-9]+$ ]]; then
      _dbk="/data/disk/${_user}/static/files/dbackup"
      # static/ is tenant-writable, so a symlinked dbackup/ may be a
      # tenant-planted name -- and it is also a legitimate operator shape:
      # a files store relocated onto attached storage (migratefs,
      # FILES-SYMLINK.md) links dbackup/ onto the mount. A trailing slash
      # would make root's find walk and purge whatever the link names, so
      # resolve BOTH sides first and accept only BOA's own store layouts,
      # strictly below them: the account's static/files store as it resolves
      # (itself a link on a relocated account), or the attached mount's copy
      # of that store. "dbackup -> ../" (the store root), /etc and another
      # account are refused alike. The single-mount detector is the one
      # manage_ltd_users.sh uses: empty on none OR more than one mount, so
      # an ambiguous box refuses rather than guesses. The walk then starts
      # one level below the resolved dir so the start dir itself is never
      # removed.
      if [ -L "${_dbk}" ]; then
        _dbk_real=$(readlink -f "${_dbk}" 2>/dev/null)
        _sto_real=$(readlink -f "/data/disk/${_user}/static/files" 2>/dev/null)
        _mntPoint=$(_pd=$(stat -c '%d' /mnt 2>/dev/null); _n=0; _hit=; for _m in /mnt/*; do
          [ -d "${_m}" ] || continue
          if mountpoint -q "${_m}" 2>/dev/null \
            || { [ -n "${_pd}" ] && [ "$(stat -c '%d' "${_m}" 2>/dev/null)" != "${_pd}" ]; }; then
            _hit="${_m}"; _n=$((_n + 1))
          fi
        done; [ "${_n}" -eq 1 ] && printf '%s' "${_hit}"; :)
        _dbk_ok=NO
        if [ -n "${_dbk_real}" ] && [ -n "${_sto_real}" ]; then
          case "${_dbk_real}" in
            "${_sto_real}"/?*) _dbk_ok=YES ;;
          esac
        fi
        if [ "${_dbk_ok}" != "YES" ] && [ -n "${_dbk_real}" ] && [ -n "${_mntPoint}" ]; then
          case "${_dbk_real}" in
            "${_mntPoint}/files/${_user}/static/files"/?*) _dbk_ok=YES ;;
          esac
        fi
        if [ "${_dbk_ok}" != "YES" ]; then
          echo "Warning: ${_dbk} resolves outside the account's files store (${_dbk_real:-unresolvable}). Skipping cleanup for ${_user}."
          continue
        fi
        _dbk="${_dbk_real}"
      fi
      [ -d "${_dbk}" ] || continue
      echo "User: ${_user}; removing backups older than ${_days_to_keep} days..."
      find "${_dbk}" -mindepth 1 \
        -type f -mtime +${_days_to_keep} -exec rm -f {} \;
      # Optionally remove empty directories, too:
      find "${_dbk}" -mindepth 1 -depth \
        -type d -empty -delete
    else
      echo "Warning: ${_cycle_file} does not contain a valid integer. Skipping cleanup for ${_user}."
    fi
  fi
done

echo "Cleanup completed."
exit 0
