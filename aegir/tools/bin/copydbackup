#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as root."
    exit 1
  fi
}
_check_root

# Switched off for good on this box: no copies of the nightly dumps into the
# accounts' trees, while the file stays updated like every other tool (no
# immutable attribute needed; one found on the file is turned into this
# switch by autoupboa).
if grep -qiE "^[[:space:]]*(export[[:space:]]+)?_DISABLE_COPYDBACKUP=[\"' ]*YES" /root/.barracuda.cnf 2>/dev/null; then
  echo "copydbackup is switched off by _DISABLE_COPYDBACKUP=YES in /root/.barracuda.cnf"
  exit 0
fi

# Log file shared with the remote_backups config validators -- the nightly
# caller discards both stdout and stderr, so refusals must land somewhere
# durable. Callers pass an already bounded, printable message: this log is
# fed from tenant-owned files and is not rotated.
_VALIDATION_LOG_FILE="/var/log/backup_validation_issues.log"

_log_issue() {
  local _type="$1"
  local _file="$2"
  local _message="$3"
  echo "[$(date)] Validation issue: [${_type}] in file: [${_file}] with error: ${_message}" >> "${_VALIDATION_LOG_FILE}"
}

# migratefs relocating the account $1's files store holds it: the hold
# names a live root process that runs migratefs, matched as executed, never
# as a word anywhere on a command line (a pid reused after a kill -9, by
# another user's process or another command, never holds). Root is read as
# the real uid in /proc/<pid>/status: /proc/<pid> itself shows root as the
# owner of any process that is not dumpable. A copy or a deletion in the
# store then undoes the move or leaves its old copy behind.
_dbk_mfs_held() {
  local _p
  _p=$( { tr -dc '0-9' < "/run/migratefs-account-${1}.pid"; } 2> /dev/null )
  [ -n "${_p}" ] && kill -0 "${_p}" 2> /dev/null \
    && [ "$(awk '/^Uid:/ { print $2; exit }' "/proc/${_p}/status" 2> /dev/null)" = "0" ] \
    && { tr '\0' ' ' < "/proc/${_p}/cmdline"; } 2> /dev/null \
    | grep -qE '^([^ ]*/)?bash (-[^ ]+ )*([^ ]*/)?migratefs( |$)'
}

# Status 0 when the account $1 is held, judged once per account per run:
# migratefs defers every relocation while this tool runs from its
# installed path, on its own or as the SQL backup run's leg, so no hold
# appears mid-run. A held account is skipped whole, in the copy and in the
# cleanup, with one line in the log for the run: the hold is a passing
# state, not a validation issue, and a later run copies and cleans up what
# this one left.
declare -A _dbk_held=()
_dbk_skip_held() {
  local _u="${1}"
  if [ -z "${_dbk_held["${_u}"]:-}" ]; then
    _dbk_held["${_u}"]=NO
    if _dbk_mfs_held "${_u}"; then
      _dbk_held["${_u}"]=YES
      echo "Skipping ${_u}: migratefs is relocating the account's files store."
      echo "[$(date)] Skipped: [${_u}] migratefs is relocating the account's files store; its dumps are copied and cleaned up by a later run" >> "${_VALIDATION_LOG_FILE}"
    fi
  fi
  [ "${_dbk_held["${_u}"]}" = "YES" ]
}

# The account's dbackup/ directory, resolved, in _DBK_DIR (status 0), or the
# reason it must not be touched in _DBK_WHY (status 1). static/ is
# tenant-writable, so a symlinked files/ may be a tenant-planted name -- and
# it is also a legitimate operator shape: migratefs relocates a files store
# to /mnt/<mount>/files/<oN>/static/files and links static/files onto it
# (FILES-SYMLINK.md). So resolve both and accept only BOA's own layouts:
# files/ is the account's own directory or its store in that layout, and
# dbackup/ resolves strictly below that resolved store. A missing dbackup/
# is created in the real store. $1 = account.
_dbk_store_dir() {
  local _u="${1}" _own _sto _real _ok=NO
  _DBK_DIR=""
  _DBK_WHY=""
  _own="$(cd -P /data/disk 2>/dev/null && pwd -P)/${_u}/static/files"
  _sto=$(readlink -f "/data/disk/${_u}/static/files" 2>/dev/null)
  # The account's own static/files, or its store in migratefs' layout on
  # attached storage (/mnt/<mount>/files/<oN>/static/files), as the nightly
  # decides it.
  case "${_sto}" in
    *[!A-Za-z0-9._/-]*) ;;
    "${_own}") _ok=YES ;;
    /mnt/?*/files/"${_u}"/static/files)
      case "${_sto%/files/"${_u}"/static/files}" in
        */files/*|*/static/*) ;;
        *) _ok=YES ;;
      esac
      ;;
  esac
  if [ "${_ok}" != "YES" ]; then
    # a link target the account wrote: shown bounded and printable only,
    # as the issue log requires
    _sto="${_sto//[^[:print:]]/?}"
    _DBK_WHY="the files store resolves outside the account: ${_sto:0:256}"
    [ -n "${_sto}" ] || _DBK_WHY="${_DBK_WHY}unresolvable"
    return 1
  fi
  if [ ! -e "/data/disk/${_u}/static/files/dbackup" ] \
    && [ ! -L "/data/disk/${_u}/static/files/dbackup" ]; then
    ( cd -P -- "${_sto}" 2>/dev/null && [ "$(pwd -P)" = "${_sto}" ] \
      && mkdir -p ./dbackup )
  fi
  _real=$(readlink -f "/data/disk/${_u}/static/files/dbackup" 2>/dev/null)
  case "${_real}" in
    "${_sto}"/?*) ;;
    *)
      _real="${_real//[^[:print:]]/?}"
      _DBK_WHY="dbackup resolves outside the account's files store: ${_real:0:256}"
      [ -n "${_real}" ] || _DBK_WHY="${_DBK_WHY}unresolvable"
      return 1
      ;;
  esac
  [ -d "${_real}" ] || { _DBK_WHY="dbackup is not a directory"; return 1; }
  _DBK_DIR="${_real}"
  return 0
}

# The uid of the user $1 and the gid of the group $2 as numbers ("uid gid"),
# or "-1 -1" when either does not resolve.
_dbk_ids() {
  local _uid _gid
  _uid=$(id -u -- "${1}" 2>/dev/null)
  _gid=$(getent group "${2}" 2>/dev/null | cut -d: -f3)
  if [[ "${_uid}" =~ ^[0-9]+$ && "${_gid}" =~ ^[0-9]+$ ]]; then
    echo "${_uid} ${_gid}"
  else
    echo "-1 -1"
  fi
}

# The uids of the account $1's identities, comma-separated, named as the
# web-group checks name them: the account oN and oN.<name>, that is its
# .ftp login, its client sub-accounts oN.<client> and oN.<client>-dev and
# its PHP-FPM users oN.web and oN.<ver>.web. An account name holds no dot,
# so the match is exact: o1 never takes o10's. Never uid 0.
_dbk_own_uids() {
  local _a="${1}" _n _p _u _r _x=""
  case "${_a}" in
    ""|*[!a-z0-9-]*) return 0 ;;
  esac
  while IFS=: read -r _n _p _u _r; do
    [[ "${_n}" =~ ^${_a}(\.[a-z0-9]+(-dev)?|\.[0-9]+\.web)?$ ]] || continue
    [[ "${_u}" =~ ^[1-9][0-9]*$ ]] && _x="${_x:+${_x},}${_u}"
  done < <(getent passwd 2>/dev/null)
  echo "${_x}"
}

# Status 0 when the current (pinned) directory is this tool's own -- root's
# own mkdir, which this tool makes 0755, writable by root only -- or already
# owned by one of the uids $1 (comma-separated, _dbk_own_uids). A directory
# root owns but that group or other can write is NOT this tool's own: the
# account can put a root-owned directory at the pinned name only by renaming
# one from its own tree, which the kernel allows only when the account can
# write that directory (its '..' is rewritten), so any root-owned directory
# an account could move here carries group or other write and is refused;
# only a directory this tool created this run is root-owned and unwritable
# by anyone but root. Only root changes the owner of the directory held, so
# the answer holds for what follows in it.
_dbk_here_ours() {
  local _o _m
  _o=$(stat -c '%u' . 2>/dev/null) || return 1
  if [ "${_o}" = "$(id -u)" ]; then
    _m=$(stat -c '%a' . 2>/dev/null) || return 1
    [ $(( 8#${_m} & 022 )) -eq 0 ] && return 0
    return 1
  fi
  case ",${1}," in
    *",${_o},"*) return 0 ;;
  esac
  return 1
}

# Copy the dump $2 as $3 into the dated directory $1 of the current, pinned
# dbackup directory, handed to the uid $4 and the gid $5 (numbers, -1 keeps
# root's): the dated directory is entered for real (never through a link put
# at its name), and the copy is made as a fresh temporary file renamed over
# the name with mv -f -T, so nothing put at either name is ever opened or
# written through. A dated directory that exists is used only while it is
# this tool's own or the account's ($6, _dbk_here_ours): the account can
# put another account's directory at that name. The temp is created
# exclusively, written, handed over, moded and dated through the one handle
# that made it (_DBK_COPY_PL: the dump's read/write bits and times, as cp -a
# kept them), never by name: the account owns a dated directory after its
# first copy, so it can rename any file of its own or one it moved in from
# elsewhere over the temp or the name, and an owner change by name would
# hand that file over. Status 0 when copied, 2 when the name was already
# taken, 1 on refusal, 3 when the copy failed.
_DBK_COPY_PL='use Fcntl; my ($s, $n, $u, $g) = @ARGV; sysopen(my $i, $s, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit 1; my @t = stat($i); exit 1 unless @t && -f _; sysopen(my $o, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; my ($r, $w, $p); while ($r = sysread($i, my $b, 1048576)) { for ($p = 0; $p < $r; $p += $w) { $w = syswrite($o, $b, $r - $p, $p) or exit 1; } } defined $r or exit 1; chown($u, $g, $o) or exit 1; chmod($t[2] & 0666, $o) or exit 1; utime($t[8], $t[9], $o) or exit 1; close($o) or exit 1; exit 0'
_dbk_copy_here() {
  local _here _t
  _here="$(pwd -P)"
  if [ ! -d "./${1}" ] || [ -L "./${1}" ]; then
    rm -f -- "./${1}" 2>/dev/null
    # explicit mode, not the run's umask: the dated directory must be
    # root-owned and unwritable by group and other so _dbk_here_ours can
    # tell this tool's own mkdir from a directory an account moved here
    mkdir -m 0755 "./${1}" 2>/dev/null || return 1
  fi
  cd -P -- "./${1}" 2>/dev/null && [ "$(pwd -P)" = "${_here}/${1}" ] || return 1
  _dbk_here_ours "${6}" || return 1
  if [ -e "./${3}" ] || [ -L "./${3}" ]; then
    return 2
  fi
  _t="./.${3}.part.$$.${RANDOM}"
  rm -f -- "${_t}" 2>/dev/null
  if perl -e "${_DBK_COPY_PL}" -- "${2}" "${_t}" "${4}" "${5}" 2>/dev/null \
    && mv -f -T -- "${_t}" "./${3}" 2>/dev/null; then
    return 0
  fi
  rm -f -- "${_t}" 2>/dev/null
  return 3
}

# The current (pinned) dated directory itself handed to the user $1 and the
# group $2 through a handle opened without following a link
# (_ACCT_REOWN_PL), so the account can remove the dumps in it, and only
# while it is this tool's own or already the account's ($3, _dbk_here_ours):
# a directory of another account's put at the dated name keeps its owner
# (status 2). Nothing below it is walked: every dump this tool copies there
# was handed over by the handle that made it (_dbk_copy_here), and any
# other name there, one the account moved in from its own tree or from
# another account's it can write through a shared group, keeps its owner.
# Owner names are resolved to numbers first; nothing changes when one does
# not resolve.
_ACCT_REOWN_PL='use Fcntl; my ($u, $g, @f) = @ARGV; for my $f (@f) { sysopen(my $h, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or next; my @s = stat($h); chown($u, $g, $h) if @s && (-d _ || (-f _ && $s[3] == 1)); close($h); } exit 0'
_dbk_reown_here() {
  local _uid _gid
  read -r _uid _gid <<< "$(_dbk_ids "${1}" "${2}")"
  [ "${_uid}" != "-1" ] || return 1
  _dbk_here_ours "${3}" || return 2
  perl -e "${_ACCT_REOWN_PL}" "${_uid}" "${_gid}" .
}

# Run "$@" inside the real directory $1 below /data/disk: every name on the
# way must be a real directory (the account owns everything below its
# /data/disk/<oN> and can swap static/, static/control or config/ for a
# link), and ./name then stays in that directory whatever is swapped.
_dbk_in_real_dir() {
  local _d="${1}" _want
  shift
  case "${_d}" in
    /data/disk/?*) ;;
    *) return 1 ;;
  esac
  _want="$(cd -P -- /data/disk 2>/dev/null && pwd -P)${_d#/data/disk}"
  ( cd -P -- "${_d}" 2>/dev/null && [ "$(pwd -P)" = "${_want}" ] && "$@" )
}

# ./$1 of the current (pinned) directory: never through a link, never
# blocked on a FIFO, at most $2 bytes (default 1 MiB).
_dbk_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs="${2:-1048576}" count=1 status=none 2>/dev/null
}

# What ./$1 of the current (pinned) directory is: "odd" for a link or
# anything but a regular file, "set" for a non-empty regular file, "empty"
# for an empty one, "none" when absent.
_dbk_cycle_state_here() {
  if [ -L "./${1}" ] || { [ -e "./${1}" ] && [ ! -f "./${1}" ]; }; then
    echo odd
  elif [ -s "./${1}" ]; then
    echo set
  elif [ -e "./${1}" ]; then
    echo empty
  else
    echo none
  fi
}

# The database names the vhosts in the current (pinned) vhost.d directory
# $1 use, one "<database> <vhost name>" line each: only regular files are
# read, each as _dbk_read_here reads it, and a vhost serving the account's
# own Aegir front-end (aegir/distro docroot) is skipped.
_dbk_vhost_dbs_here() {
  local _f _txt
  for _f in ./*; do
    [ -f "${_f}" ] && [ ! -L "${_f}" ] || continue
    _txt=$(_dbk_read_here "${_f#./}")
    if grep -qE "root\s+/data/disk/.*/aegir/distro/" <<< "${_txt}"; then
      echo "Skipping vhost due to aegir/distro pattern: ${1}/${_f#./}" >&2
      continue
    fi
    grep "fastcgi_param db_name" <<< "${_txt}" \
      | awk '{print $NF}' | tr -d ';' \
      | while IFS= read -r _db; do
        [ -n "${_db}" ] && printf '%s %s\n' "${_db}" "${_f#./}"
      done
  done
}

# -----------------------------------------------------------------------------
# 1) Identify which user references which DB by scanning vhosts
# -----------------------------------------------------------------------------
# vhost.d is oN's (config/ 0711, vhost.d 0700, both oN's), so each account's
# vhosts are listed and read only inside its real vhost.d, bounded and never
# through a link or a FIFO: a vhost name or directory swapped for a link can
# neither make root read another file nor stall the run. What a vhost claims
# is trusted as before: only oN can write there, and the database user its
# Aegir backend runs with already holds ALL on every database of this
# server, so a claim cannot reach a dump oN could not read directly.

# We'll store:  db_name -> "vhost1 vhost2 ..."
declare -A _vhost_db_map

for _acct_dir in /data/disk/*; do
  _dir="${_acct_dir}/config/server_master/nginx/vhost.d"
  [ -d "${_dir}" ] || continue
  while IFS=' ' read -r _db_name _vhost_name; do
    [ -n "${_db_name}" ] && [ -n "${_vhost_name}" ] || continue
    _vhost_file="${_dir}/${_vhost_name}"
    # Append vhost file to the db_name’s list if not already included
    if ! [[ " ${_vhost_db_map["${_db_name}"]} " =~ " ${_vhost_file} " ]]; then
      _vhost_db_map["${_db_name}"]+="${_vhost_file} "
    fi
  done < <(_dbk_in_real_dir "${_dir}" _dbk_vhost_dbs_here "${_dir}")
done

# -----------------------------------------------------------------------------
# 2) Build a "db -> user(s)" map from the vhost paths
# -----------------------------------------------------------------------------
_get_username_from_path() {
  # Typical pattern: /data/disk/USER/config/server_master/nginx/vhost.d/example.conf
  # Splitting by '/' => [0:'',1:'data',2:'disk',3:'USERNAME',4:'config',...]
  local _vfile="$1"
  echo "${_vfile}" | cut -d'/' -f4
}

declare -A _db_users_map  # db_name -> "user1 user2 ..."
for _db_name in "${!_vhost_db_map[@]}"; do
  for _vhost_file in ${_vhost_db_map["${_db_name}"]}; do
    _this_user=$(_get_username_from_path "${_vhost_file}")
    if [ -n "${_this_user}" ]; then
      # Avoid duplicates
      if ! [[ " ${_db_users_map["${_db_name}"]} " =~ " ${_this_user} " ]]; then
        _db_users_map["${_db_name}"]+="${_this_user} "
      fi
    fi
  done
done

# -----------------------------------------------------------------------------
# 3) Copy relevant DB backups to each user’s space
# -----------------------------------------------------------------------------
_ARCH_SQL_BASE="/data/disk/arch/sql"
echo "Copying relevant DB backups into user spaces..."

for _backup_dir in "${_ARCH_SQL_BASE}"/*; do
  [ -d "${_backup_dir}" ] || continue
  _dir_name=$(basename "${_backup_dir}")
  # The nightly names it <hostname>-<YYMMDD-HHMMSS> (date +%y%m%d-%H%M%S),
  # and a hostname may hold dashes, so the stamp is taken from the end; a
  # name in any other shape keeps the first-dash split
  _datetime="${_dir_name#*-}"
  if [[ "${_dir_name}" =~ -([0-9]{6}-[0-9]{6})$ ]]; then
    _datetime="${BASH_REMATCH[1]}"
  fi

  # We'll track users who received new files in this directory,
  # then hand the dated directory itself to each user at the end.
  declare -A _touched_users=()

  for _backup_file in "${_backup_dir}"/*; do
    [ -f "${_backup_file}" ] || continue

    _base_file=$(basename "${_backup_file}")

    # Remove up to two extensions => e.g. dbName.sql.bz2 => dbName
    filename_no_ext="${_base_file}"
    filename_no_ext="${filename_no_ext%.*}"  # 1st ext
    filename_no_ext="${filename_no_ext%.*}"  # 2nd ext

    # If base ends with -DATETIME, remove that suffix => dbName
    if [[ "${filename_no_ext}" == *"-${_datetime}" ]]; then
      filename_no_ext="${filename_no_ext%-${_datetime}}"
    fi

    _possible_dbname="${filename_no_ext}"

    if [[ "${_possible_dbname}" == "mysql" || "${_possible_dbname}" == "sys" ]]; then
      # Debug log (optional)
      echo "Skipping system DB backup: ${_base_file} (DB: ${_possible_dbname})"
      continue
    else
      echo "_possible_dbname is ${_possible_dbname}"
    fi

    # If this DB is used by any users, copy the file for them
    if [ -n "${_db_users_map["${_possible_dbname}"]}" ]; then
      for _user in ${_db_users_map["${_possible_dbname}"]}; do
        _dbk_skip_held "${_user}" && continue
        # Only into the account's own store, entered for real: a dbackup/,
        # files/ or dated directory name the tenant turned into a link is
        # never written through
        if ! _dbk_store_dir "${_user}"; then
          echo "Warning: ${_DBK_WHY}. Skipping ${_user}."
          _log_issue "${_user}" "/data/disk/${_user}/static/files/dbackup" "${_DBK_WHY}"
          continue
        fi
        _target_file="${_DBK_DIR}/${_datetime}/${_base_file}"
        # The copy goes to the account's .ftp login and group, as the dated
        # directory does below, handed over by the handle that makes it
        read -r _cp_uid _cp_gid <<< "$(_dbk_ids "${_user}.ftp" "$(_acct_group "${_user}")")"
        ( cd -P -- "${_DBK_DIR}" 2>/dev/null && [ "$(pwd -P)" = "${_DBK_DIR}" ] \
          && _dbk_copy_here "${_datetime}" "${_backup_file}" "${_base_file}" \
            "${_cp_uid}" "${_cp_gid}" "$(_dbk_own_uids "${_user}")" )
        case $? in
          0)
            echo "Copied ${_backup_file} => ${_target_file}"
            # Mark that we touched this user's folder in this directory
            _touched_users["${_user}"]=1
            ;;
          2) echo "File already exists, skipping: ${_target_file}" ;;
          3)
            echo "Warning: could not copy ${_backup_file} into ${_DBK_DIR}/${_datetime}. Skipping ${_user}."
            _log_issue "${_user}" "${_target_file}" "Copy failed"
            ;;
          *)
            echo "Warning: could not copy into ${_DBK_DIR}/${_datetime}. Skipping ${_user}."
            _log_issue "${_user}" "${_DBK_DIR}/${_datetime}" "Dated directory is not a real directory, or is another user's"
            ;;
        esac
      done
    fi
  done

  # Now hand the dated directory to each user who got new files there
  for _user in "${!_touched_users[@]}"; do
    # Per iteration: the store is inside this account's own tree, so the
    # group is derived from the account, not the box-wide literal
    _grp=$(_acct_group "${_user}")
    _dbk_store_dir "${_user}" || continue
    _target_dir="${_DBK_DIR}/${_datetime}"
    echo "Setting ownership for ${_target_dir} => ${_user}.ftp:${_grp}"
    # inside the real dated directory, never through a name the account put
    # there (_dbk_reown_here)
    ( cd -P -- "${_target_dir}" 2>/dev/null && [ "$(pwd -P)" = "${_target_dir}" ] \
      && _dbk_reown_here "${_user}.ftp" "${_grp}" "$(_dbk_own_uids "${_user}")" )
    if [ "$?" = "2" ]; then
      echo "Warning: ${_target_dir} is another user's. Not handed to ${_user}.ftp."
      _log_issue "${_user}" "${_target_dir}" "Dated directory is another user's"
    fi
  done
done

echo "Backup copying completed."

# -----------------------------------------------------------------------------
# 4) Cleanup old backups based on /data/disk/USER/static/control/dBackupCycle.info
# -----------------------------------------------------------------------------
#
# If the file exists and contains a number of days (e.g. 7, 14, 21, 60),
# remove archives older than that many days. Then remove empty subdirs.
# By default use 14 days if the file is missing or zero-length.

# Gather all users from _db_users_map to do cleanup
declare -A _all_involved_users=()
for _db_name in "${!_db_users_map[@]}"; do
  for _usr in ${_db_users_map["${_db_name}"]}; do
    _all_involved_users["${_usr}"]=1
  done
done

echo "Performing cleanup of old backups based on dBackupCycle.info..."

for _user in "${!_all_involved_users[@]}"; do
  _dbk_skip_held "${_user}" && continue
  _cycle_value=
  _days_to_keep=14
  _cycle_file="/data/disk/${_user}/static/control/dBackupCycle.info"

  # The override is tenant-authored and its number drives a root-run delete,
  # so the WHOLE file must be one plain number of days: edge whitespace (CR
  # included) trimmed, digits only, at most four of them, not zero -- find
  # -mtime +0 would purge everything older than a day. A value not written
  # as one is IGNORED in favour of the default window, never obeyed and
  # never a reason to stop: the cleanup always runs, or an unreadable
  # override would let the store grow against the account's own quota.
  # Only a regular file in the real static/control is read; a link or
  # device planted at that path, or a control directory that is itself a
  # link, is ignored the same way.
  _cycle_state=$(_dbk_in_real_dir "/data/disk/${_user}/static/control" \
    _dbk_cycle_state_here dBackupCycle.info)
  if [ "${_cycle_state}" = "odd" ] \
    || { [ -z "${_cycle_state}" ] \
      && { [ -e "${_cycle_file}" ] || [ -L "${_cycle_file}" ]; }; }; then
    echo "Warning: ${_cycle_file} is not a plain file. Using the default ${_days_to_keep} days for ${_user}."
    _log_issue "${_user}" "${_cycle_file}" "Cycle file is not a plain file"
  elif [ "${_cycle_state}" = "set" ]; then
    # Bounded read: no valid value is long, and what is read is echoed to
    # the log, so never pull an arbitrary tenant file into root's memory
    _cycle_value=$(_dbk_in_real_dir "/data/disk/${_user}/static/control" \
      _dbk_read_here dBackupCycle.info 64)
    _cycle_value="${_cycle_value#"${_cycle_value%%[![:space:]]*}"}"
    _cycle_value="${_cycle_value%"${_cycle_value##*[![:space:]]}"}"
    if [[ "${_cycle_value}" =~ ^[0-9]{1,4}$ ]] && [ "$((10#${_cycle_value}))" -gt 0 ]; then
      _days_to_keep="$((10#${_cycle_value}))"
    elif [ -n "${_cycle_value}" ]; then
      # Report only what was really written: a file cleared in place still
      # holds its newline, and that is the documented empty case
      _shown="${_cycle_value//[^[:print:]]/?}"
      echo "Warning: ${_cycle_file} does not hold a plain non-zero number of days. Using the default ${_days_to_keep} days for ${_user}."
      _log_issue "${_user}" "${_cycle_file}" "Invalid cycle value: ${_shown:0:32}"
    fi
  fi

  # dbackup/ as _dbk_store_dir resolves it: only BOA's own store layouts,
  # the walk starting one level below it so the start dir itself is never
  # removed
  if ! _dbk_store_dir "${_user}"; then
    echo "Warning: ${_DBK_WHY}. Skipping cleanup for ${_user}."
    _log_issue "${_user}" "/data/disk/${_user}/static/files/dbackup" "${_DBK_WHY}"
    continue
  fi
  _dbk="${_DBK_DIR}"
  echo "User: ${_user}; removing backups older than ${_days_to_keep} days..."
  # -delete, not -exec rm: the tree is tenant-owned, and find unlinks
  # relative to the directory it already walked instead of handing an
  # absolute path to a fresh process that resolves every component again;
  # walked from inside the real directory, so a name on the way swapped for
  # a link after the check is never followed either
  ( cd -P -- "${_dbk}" 2>/dev/null && [ "$(pwd -P)" = "${_dbk}" ] \
    && { find . -mindepth 1 -type f -mtime "+${_days_to_keep}" -delete
      find . -mindepth 1 -depth -type d -empty -delete; } )
done

echo "Cleanup completed."
exit 0
