#!/bin/bash

#
# Remove SYNPROXY/QUIC add-ons & rules without touching CSF
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

set -euo pipefail
trap '_rc=$?; echo "[ROLLBACK] line ${LINENO}: exit ${_rc}" >&2; exit ${_rc}' ERR

# --- utils ---
_LOG="/var/log/synproxy-rollback.log"
_msg(){ echo "[ROLLBACK] $*" | tee -a "${_LOG}"; }
_need(){ command -v "$1" >/dev/null 2>&1 || { echo "[ROLLBACK] Missing: $1" >&2; exit 1; }; }

_need iptables
_need sed
_need grep
_need date

# iptables wrapper (-w if supported)
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }

# Files we created
_INC_DIR="/etc/csf/csfpost.d"
_SYN_ADDON="${_INC_DIR}/synproxy.sh"
_MONITOR="/usr/local/sbin/mon_synproxy"
_WATCHER="/usr/local/sbin/watch_synproxy"
_ASSERT_BIN="/usr/local/sbin/synproxy_assert"
_CRON="/etc/cron.d/synproxy-assert"
_INITD="/etc/init.d/synproxy-assert"
_OLD_ROLLBACK="/usr/local/sbin/synproxy_rollback"
_SYSCTL_FILE="/etc/sysctl.d/60-synproxy.conf"
_ETC_MODULES="/etc/modules"

: > "${_LOG}"
_msg "Starting rollback at $(date -u +'%F %T UTC')"

# 1) Remove jumps to early chain (so we can delete the chain)
_msg "1) Remove any jumps to SYNPROXY_EARLY from INPUT/LOCALINPUT"
while _ipt -C INPUT -j SYNPROXY_EARLY 2>/dev/null; do _ipt -D INPUT -j SYNPROXY_EARLY 2>/dev/null || break; done
if _ipt -L LOCALINPUT -n >/dev/null 2>&1; then
  while _ipt -C LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null; do _ipt -D LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null || break; done
fi

# 2) Flush & delete SYNPROXY_EARLY (if exists)
_msg "2) Flush and delete SYNPROXY_EARLY (if exists)"
_ipt -F SYNPROXY_EARLY 2>/dev/null || true
_ipt -X SYNPROXY_EARLY 2>/dev/null || true

# Helper: delete rules by exact spec from `iptables -S` output
# Usage: _delete_by_spec <table> <chain> <grep pattern>
_delete_by_spec(){
  local _tbl="$1" _ch="$2" _pat="$3" _line _spec
  # Read current specs (don’t fail if empty)
  while true; do
    _line="$({ iptables ${_tbl:+-t "${_tbl}"} -S "${_ch}" 2>/dev/null || true; } | grep -F -- "${_pat}" | head -n1 || true)"
    [ -n "${_line}" ] || break
    # Example: "-A INPUT -p tcp --syn --dport 443 -m conntrack ... -j SYNPROXY ..."
    # Strip prefix "-A <CHAIN> " and delete with -D
    _spec="${_line#-A ${_ch} }"
    # shellcheck disable=SC2086
    _ipt ${_tbl:+-t "${_tbl}"} -D "${_ch}" ${_spec} 2>/dev/null || break
  done
}

# 3) Remove legacy direct rules in INPUT/LOCALINPUT
_msg "3) Remove legacy direct SYNPROXY & NEW->DROP rules from INPUT/LOCALINPUT (if any)"
for _C in INPUT LOCALINPUT; do
  _ipt -L "${_C}" -n >/dev/null 2>&1 || continue
  _delete_by_spec "" "${_C}" "SYNPROXY"         # any SYNPROXY rule we added
  _delete_by_spec "" "${_C}" "-m state --state NEW -j DROP"  # our NEW->DROP per-port
done

# 4) Remove raw PREROUTING NOTRACK/CT --notrack on SYNs (delete by spec, no port parsing)
_msg "4) Remove CT --notrack / NOTRACK rules from raw PREROUTING (SYN to ports)"
# First CT --notrack variants
_delete_by_spec "raw" "PREROUTING" "--syn"
# Above line is broad; ensure we only wipe NOTRACK/CT-notrack lines:
# Re-run but narrowed to NOTRACK/CT --notrack if any remain
_delete_by_spec "raw" "PREROUTING" "CT --notrack"
_delete_by_spec "raw" "PREROUTING" " -j NOTRACK"

# 5) Remove QUIC limiter rules from INPUT (hashlimit name “quic<port>_*” and UDP/port INVALID)
_msg "5) Remove QUIC limiter rules from INPUT"
# Remove hashlimit-based rules first (any port named like quic####_*)
/bin/true
while :; do
  _r="$({ iptables -S INPUT 2>/dev/null || true; } | grep -E 'hashlimit-name quic[0-9]+_(ip|24)' | head -n1 || true)"
  [ -n "${_r}" ] || break
  _spec="${_r#-A INPUT }"
  # shellcheck disable=SC2086
  _ipt -D INPUT ${_spec} 2>/dev/null || break
done
# Remove our UDP/port INVALID drop (safe: it matches only lines with "-p udp --dport ... INVALID -j DROP")
while :; do
  _r="$({ iptables -S INPUT 2>/dev/null || true; } | grep -E -- '-p udp .*--dport [0-9]+ .* -m conntrack --ctstate INVALID .* -j DROP' | head -n1 || true)"
  [ -n "${_r}" ] || break
  _spec="${_r#-A INPUT }"
  _ipt -D INPUT ${_spec} 2>/dev/null || break
done

# 6) Remove generated files (leave CSF core files untouched)
_msg "6) Remove generated scripts (add-ons/monitors/assert/cron/init.d)"
rm -f "${_SYN_ADDON}" 2>/dev/null || true
if [ -d "${_INC_DIR}" ]; then
  find "${_INC_DIR}" -maxdepth 1 -type f -name 'quic_udp*_limit.sh' -exec rm -f {} + 2>/dev/null || true
fi
rm -f "${_MONITOR}" "${_WATCHER}" "${_ASSERT_BIN}" "${_OLD_ROLLBACK}" 2>/dev/null || true
rm -f "${_CRON}" 2>/dev/null || true
if [ -x "${_INITD}" ]; then
  "${_INITD}" stop >/dev/null 2>&1 || true
  command -v update-rc.d >/dev/null 2>&1 && update-rc.d synproxy-assert remove >/dev/null 2>&1 || true
  rm -f "${_INITD}" 2>/dev/null || true
fi

# 7) Clean persistence knobs we added (non-CSF)
_msg "7) Remove nf_synproxy_core from /etc/modules; remove our sysctl file (live values unchanged)"
[ -f "${_ETC_MODULES}" ] && sed -i '/^nf_synproxy_core$/d' "${_ETC_MODULES}" 2>/dev/null || true
[ -f "${_SYSCTL_FILE}" ] && rm -f "${_SYSCTL_FILE}" 2>/dev/null || true

echo
_msg "Rollback complete. CSF was not modified or reloaded."

echo
echo "Verify (should show no SYNPROXY_EARLY, no quic* hashlimits, and no CT --notrack on web ports):"
echo "  iptables -L INPUT -n -v --line-numbers | sed -n '1,60p'"
echo "  iptables -L LOCALINPUT -n -v --line-numbers 2>/dev/null | sed -n '1,60p'"
echo "  iptables -t raw -L PREROUTING -n -v --line-numbers | sed -n '1,40p'"
echo
echo "Removed files (if present):"
echo "  ${_SYN_ADDON}"
echo "  ${_INC_DIR}/quic_udp*_limit.sh"
echo "  ${_MONITOR} , ${_WATCHER} , ${_ASSERT_BIN}"
echo "  ${_CRON} , ${_INITD} , ${_OLD_ROLLBACK}"
echo "  ${_SYSCTL_FILE}  (live sysctls not reverted)"
echo "Persistence cleaned: 'nf_synproxy_core' line removed from ${_ETC_MODULES}"
