#!/bin/bash
#
# staticbuild - build the newer Drupal core + distribution codebases, package
# them, and publish the tarballs to the static mirror. They are the catalogue
# every Octopus instance installs, declared for demonstration and compatibility
# testing only, not for production (tenants run production on their own builds
# in ~/static, and security updates for the catalogue are best effort), and the
# codebases BOA's own install/upgrade tests run on.
#
# Runs on the mirror SOURCE VM only. Builds happen as the Octopus build user
# (o8 unless -u USER says otherwise) under /data/disk/<user>/static/<MM-DD>/;
# packaging + publishing to /var/www/static/{distro,core,dev/{dev,lts,pro}} and the
# per-build /usr/bin/php switch need root, so run this as root.
#
# Versions are NOT hardcoded. Each distribution is built from its Composer spec (or,
# for farmOS, the latest GitHub release) and each vanilla core from its minor's latest
# patch; the set of core minors is auto-discovered (>= _CORE_FLOOR) so the newest is
# always built. The distro + core versions Composer resolves are detected from the build
# and used in the tarball names. If a distribution fails to build on the newest core (e.g.
# a stale core patch), it is retried on progressively older core minors and the newest that
# works is kept. Only the Composer specs and the core floor/exclude in the configuration
# block below are settings to review.
#
# Composer's advisory blocking stays off for the distro builds, so one upstream advisory
# cannot halt a catalogue build. Instead each finished distribution gets a fix step: every
# advisory-affected package moves to the newest release its constraints allow (never
# drupal/core, whose newer release is a new platform name, and never a package the build
# holds). Every distro and vanilla core is then audited (composer audit --locked, never
# fatal); the result, with what the fix step moved and what it could not, is recorded
# beside the tarball as <platform>.advisories and counted in the run summary.
# distribute replaces a published distro or vanilla core tarball with a same-name one
# whose lock differs, unless the new lock adds advisories the published one lacks or
# either side cannot be audited or compared (both sides audited at that moment): those
# are refused unless -O names them. A box fetches a platform only while its directory
# is absent, so the boxes that already hold the old bytes keep them either way.
#
# Output: build, package, distribute, all and the family actions print one row per
# platform (build result, advisories left and fixed, what happened on the mirror, a
# note) plus a footer for anything that needs action; everything else goes to a log
# under /var/backups/reports/staticbuild/<user>/<MM-DD>/. --debug streams it all
# instead, as before, and makes "advisories" list every advisory id.
#
# Usage:
#   staticbuild backdrop            build+package+publish ONLY the Backdrop family
#                                   (backdrop core + bee + backdrop-drush-extension
#                                   + redis_backdrop + webform_backdrop), all at
#                                   latest - lightweight, no Composer
#   staticbuild grav                build+package+publish ONLY the Grav family
#                                   (official admin bundle at latest; no Composer)
#   staticbuild txp                 build+package+publish ONLY Textpattern (official
#                                   release tarball at latest; never the .zip, which
#                                   omits the /sites multisite scaffold)
#   staticbuild all                 build everything, package, publish
#   staticbuild build [name ...]    build all (or only named) targets
#   staticbuild package             clean + tar (cores keep core/profiles, distros strip)
#   staticbuild distribute          copy tarballs to /var/www/static/{distro,core,dev/{dev,lts,pro}};
#                                   a same-name distro or vanilla core tarball whose
#                                   lock changed replaces the published one unless it
#                                   adds advisories or either side cannot be audited or
#                                   compared; then it is refused (exit 3 at the end)
#   staticbuild -O distribute <platform> ...
#                                   the same, overwriting the named platforms'
#                                   published tarballs even when they are refused
#   staticbuild check               report the latest upstream versions a build would pull
#   staticbuild catalogue [tree ...] audit the PUBLISHED catalogue of each tree
#                                   (default dev lts pro) against the distro mirror;
#                                   fails if any entry's tarball is not published
#   staticbuild advisories [tree ...] read-only: audit the composer.lock of every
#                                   PUBLISHED catalogue platform of each tree (default
#                                   dev lts pro) -- the distributions and the Drupal
#                                   9-11 cores; the Drupal 6/7 forks are outside
#                                   Composer -- against today's advisories, and list
#                                   BOA's own non-Composer contrib no audit can see;
#                                   fails only when something could not be audited
# Options:
#   -d MM-DD   build-day directory (default: today, date +%m-%d)
#   -u USER    Octopus build user (default: o8)
#   -f         force rebuild: remove an existing built platform before building
#   -C         skip "composer clearcache" at the start of a build
#   -O         with distribute and the platform names after it only: overwrite
#              those published tarballs even when their changed lock is refused
#              (logs both lock hashes; boxes that already fetched them keep the
#              old bytes)
#   --debug    stream everything (Composer, git, tar, every advisory id) as it
#              happens instead of writing it to the run log; the one-row-per-
#              platform summary still closes the run
# Build target names: farm cms culturas commerce localgov openfed opigno social thunder
#   varbase ezcontent commerce_base (the two pinned catalogue platforms, rebuilt from
#   their published tarballs) backdrop (core, versioned like the Drupal cores) bee
#   backdrop-drush-extension redis_backdrop webform_backdrop grav txp cores
#
# The Backdrop family (backdrop core, bee, backdrop-drush-extension,
# redis_backdrop, webform_backdrop) is always fetched at its newest upstream version, so BOA
# never falls behind: run "staticbuild all" (or just the named targets) on the
# mirror source VM, e.g. from cron alongside get-boa-dev. Backdrop core is
# published versioned (backdrop-<ver>.tar.gz, retained per version like the
# Drupal cores) with a backdrop.txt newest-version stamp plus a version-less
# backdrop.tar.gz compat tarball of the newest (extracts to backdrop/, the
# pre-versioning contract); bee + the drush extension stay version-less;
# redis_backdrop is published versioned to the per-tree contrib shelf
# (dev/{dev,lts,pro}/contrib/) and consumed by the version pinned in
# OCTOPUS.sh.txt / BOA.sh.txt, so a newer publish here is inert until the
# pins are bumped.

# ---------------------------------------------------------------------------
# Configuration - review the specs/minors each cycle ("staticbuild check").
# ---------------------------------------------------------------------------

_O8_USER="o8"                                   # Octopus build user; -u overrides
_DAY="$(date +%m-%d)"                           # -d overrides (MM-DD)

_STATIC_ROOT="/data/disk"                       # o8 home base; static lives under here
_DISTRO_OUT="/var/www/static/distro"            # non-core (distribution) tarballs
_CORE_OUT="/var/www/static/core"                # raw core tarballs
_DEVEXT_BASE="/var/www/static/dev"              # dev extensions (bee, drush ext) BOA _get_dev_ext pulls
_LOG_DIR="/var/backups/reports/staticbuild"     # per-run logs: <user>/<MM-DD>/<action>-<HHMMSS>.log

# Catalogue audit (staticbuild catalogue). The published BOA tree is the source of
# truth for WHICH tarballs must exist -- read it per tree rather than duplicating
# the list here, so a catalogue edit can never drift from this check.
_BOA_VERSIONS_URL="https://files.boa.io/versions" # published per-tree BOA trees
_BOA_DISTRO_URL="https://files.aegir.biz/distro"  # public distro tarball mirror
_BOA_UA="iCab"                                    # BOA mirrors reject other agents
_CATALOGUE_TREES="dev lts pro"
# drupal.org contrib advisories reach composer audit only through this repository:
# a lock audited against Packagist alone reports none of them (measured).
_DRUPAL_REPO_URL="https://packages.drupal.org/8"
_BOA_CORE_URL="https://files.aegir.biz/core"      # public core tarball mirror
# A catalogue tarball name as the audit accepts it: it reaches file names and paths.
_TARBALL_RE='^[A-Za-z0-9][A-Za-z0-9._+-]*\.tar\.gz$'
_DEV_TREES="dev lts pro"                        # per-tree dirs under it: every box pulls its own _tRee

_SYS_PHP="/usr/bin/php"                          # per-build switch target
_PHP_85="/opt/php85/bin/php"
_PHP_84="/opt/php84/bin/php"
_PHP_83="/opt/php83/bin/php"
_PHP_DISTRO="${_PHP_85}"                         # farm/cms/culturas/commerce/localgov/thunder
_PHP_VARBASE="${_PHP_84}"                        # varbase pins php84
_PHP_SOCIAL="${_PHP_83}"                         # Open Social 13 requires php ^8.3 and SOC is
                                                 # capped at 8.3 in AegirSetupC's per-distro
                                                 # table - build on the version it will run on
_PHP_OPIGNO="${_PHP_83}"                         # Opigno 3.2.7 is a 2024 D10 codebase; 8.3 is
                                                 # its catalogue cap - build on the version it
                                                 # will run on
_PHP_OPENFED="${_PHP_83}"                        # OpenFed 13.6 rides the D10.6 line; 8.3 is
                                                 # its catalogue cap - build on the version it
                                                 # will run on
_PHP_CORE="${_PHP_84}"                           # vanilla cores build under php84

# farmOS: the latest GitHub release is resolved automatically; set _FARM_TAG to pin one.
_FARM_REPO="farmOS/farmOS"
_FARM_TAG=""

# Backdrop CMS core: the latest GitHub release is resolved automatically; set
# _BACKDROP_TAG to pin one. Ships as a single backdrop.zip release asset (no
# Composer), repackaged versioned as backdrop-<ver>.tar.gz (extracts to
# backdrop-<ver>/) and classified as a core, managed on the mirror exactly like
# the Drupal cores: every published version is retained, backdrop.txt stamps
# the newest, and a version-less backdrop.tar.gz compat tarball of the newest
# (extracting to backdrop/, the pre-versioning contract) is refreshed for
# already-deployed BOA releases.
_BACKDROP_REPO="backdrop/backdrop"
_BACKDROP_TAG=""

# Grav 2 core: the latest GitHub release is resolved automatically; set
# _GRAV_TAG to pin one. The published artefact is the official ADMIN BUNDLE
# (grav-admin-v<ver>.zip -- admin/login/form/email + api +
# admin2 preinstalled), repackaged versioned as grav-<ver>.tar.gz (extracts
# to grav-<ver>/) for the platform build, PLUS the raw official zip kept
# verbatim on the /core/ shelf as grav-admin-v<ver>.zip for the per-site
# upgrade channel (provision-grav-upgrade feeds it to gpm direct-install as
# a LOCAL file, so official_gpm_only stays enforced and no box ever talks
# to getgrav.org). grav.txt stamps the newest.
_GRAV_REPO="getgrav/grav"
_GRAV_TAG=""

# Textpattern: official GitHub release TARBALL (never the .zip -- the zip ships
# no /sites scaffold, which the always-multisite layout requires).
# Stable releases are tags on main; the release publishes a
# .SHA256SUM alongside each asset, which the build verifies before packaging.
_TXP_REPO="textpattern/textpattern"
_TXP_TAG=""

# bee (native Backdrop CLI) and the Backdrop Drush extension. Built from the
# latest git tag of each backdrop-contrib repo (they publish plain tags, not
# GitHub Releases) and packaged version-less as the exact tarballs BOA's
# _get_dev_ext pulls: bee.tar.gz (bee.php at the root) and
# backdrop-drush-extension.tar.gz (wraps a backdrop-drush-extension/ dir,
# shipped PRISTINE - BOA applies its 5.6 de-hint + the __DIR__ include fix on
# deploy). Set a _*_TAG to pin one.
_BEE_REPO="backdrop-contrib/bee"
_BEE_TAG=""
_BDEXT_REPO="backdrop-contrib/backdrop-drush-extension"
_BDEXT_TAG=""
# Backdrop redis contrib module (its Redis_Cache implements
# BackdropCacheInterface -- the Drupal redis_* modules are NOT compatible).
# Published VERSIONED to the per-tree contrib shelf as
# redis_backdrop-<tag>.tar.gz: the shared /data/all/000/modules store BOA
# symlinks into every Backdrop platform through the o_contrib_backdrop bundle,
# replacing the retired per-platform modules/redis bake. The settings side is
# /data/conf/global/global-bd-valkey.inc (the Backdrop wiring partial the
# global-bd.inc chain head includes), which prefers the shared bundle and still
# falls back to a baked modules/redis copy on platforms built from older
# tarballs. NB: BOA fetches this by its pinned version -- after publishing a
# new tag here, bump the pin in OCTOPUS.sh.txt and BOA.sh.txt together.
_REDIS_REPO="backdrop-contrib/redis"
_REDIS_TAG=""

# Backdrop webform contrib module -- the first curated o_contrib_backdrop
# bundle member beyond the cache module (2026-09): the heaviest recurring
# Drupal 7 port gap, with a maintained Backdrop port. Published VERSIONED to
# the per-tree contrib shelf as webform-<tag>.tar.gz. Unlike redis_backdrop it
# is a plain bundle member (extracted into o_contrib_backdrop directly, no
# shared-store symlink, no cnf pin): the satellite side fetches it by a
# version literal, so after publishing a new tag here bump that literal in
# lib/functions/satellite.sh.inc (_satellite_download_o_contrib_backdrop).
_WEBFORM_B_REPO="backdrop-contrib/webform"
_WEBFORM_B_TAG=""

# Distribution Composer specs (the create-project template) + the distribution PROFILE
# package. The tarball version is the profile package's version (the authoritative number
# drupal.org shows), read from the lock - NOT the create-project template's version, which
# is mostly irrelevant and sometimes a -dev alias.
_CMS_SPEC="drupal/cms"
_CMS_DISTPKG=""                                  # cms: template == distribution version
_CULTURAS_SPEC="drupal/openculturas_project"
_CULTURAS_DISTPKG="openculturas/openculturas-distribution"
_CULTURAS_PROJECT="openculturas"                 # drupal.org project (for the release-number pin)
_COMMERCE_SPEC="centarro/commerce-kickstart-project"
_COMMERCE_DISTPKG="centarro/commerce_kickstart"  # not on drupal.org; profile version is authoritative
_LOCALGOV_SPEC="drupal/localgov_project:^4"
_LOCALGOV_DISTPKG="drupal/localgov"
_THUNDER_SPEC="thunder/thunder-project"
_THUNDER_DISTPKG="thunder/thunder-distribution"
# PINNED to the 11.0.7 template (2026-09-17): the 11.0.8 template keeps the same
# vardot/varbase 11.0.0 distribution but its lock moves drupal/canvas 1.10.1 ->
# 1.11.0, and a fresh install on that lock leaves canvas_page_template_component
# (enabled by the varbase_starter recipe) out of core.extension while its
# page-template config stays -- every page of the new site then dies on a
# PluginNotFoundException, and a clone's updatedb fails the same way. The 11.0.7
# lock (canvas 1.10.1) installed and cloned cleanly on 2026-09-10 and again on
# 2026-09-17. Move the pin only after a rig proves a newer template installs
# AND clones; the distribution version in the platform name does not change.
_VARBASE_SPEC="Vardot/varbase-project:11.0.7"
# The 11 line's committed lock pins drupal/ai_provider_amazeeio 1.4.2 (via
# drupal/drupal_cms_ai), which declares ext-pdo_pgsql; BOA's PHP builds carry no
# PostgreSQL driver, so a lock-faithful install must ignore that one platform
# requirement. The installer does not enable the module; the extension matters
# only to its own PostgreSQL-backed features. Empty this to enforce the lock.
_VARBASE_IGNORE_EXT="--ignore-platform-req=ext-pdo_pgsql"
_VARBASE_DISTPKG="vardot/varbase"
# The advisory fix step moves an affected package to its fixed release. The same one
# platform requirement is ignored there, for the same reason: the fixed amazee.io
# provider releases declare ext-pdo_pgsql too, so without it Drupal CMS stays on the
# affected 1.3.x line it resolves to today.
_FIX_IGNORE_EXT="--ignore-platform-req=ext-pdo_pgsql"
# Open Social ships NO create-project template for its current major: goalgorilla/social_template
# has not been touched since 2024-05-21 and its committed lock pins open_social 12.4.2 on core
# 10.2.6, i.e. an unsupported branch. So we take that template as the chassis - it owns the
# html/ docroot, the scaffold locations and the installer-paths upstream itself defined - and
# move only the distribution package to the current major.
_SOCIAL_SPEC="goalgorilla/social_template:dev-master"
_SOCIAL_DISTPKG="goalgorilla/open_social"
_SOCIAL_CONSTRAINT="^13"
# Opigno's documented create-project is broken as shipped: the template replaces the H5P
# PHP libraries without providing them (their open install Critical) and the profile
# hard-requires an advisory-affected dompdf line, so build_opigno carries corrections.
# The published platform ships dompdf 2.0.x with open advisories - a known, accepted
# trade recorded in docs/BUILDTESTS.md; the fixed dompdf line (3.x) is outside the
# profile's own constraint.
_OPIGNO_SPEC="opigno/opigno-composer"
_OPIGNO_DISTPKG="opigno/opigno_lms"
# OpenFed's template requires only its three composer helpers; the distribution
# itself (openfed/openfed) is merged in by wikimedia/composer-merge-plugin from the
# template's composer.openfed.json, so build_openfed bootstraps vendor before the
# real resolve (a plugin can only act once installed).
_OPENFED_SPEC="openfed/openfed-project:^13"
_OPENFED_DISTPKG="openfed/openfed"
_CORE_SPEC="drupal/recommended-project"
# Pinned catalogue platforms: nothing upstream rebuilds them any more, so their build
# starts from the published tarball itself (the local shelf, else the distro mirror)
# and only the advisory fix step changes it. Distribution and core stay, and so does
# the name, so distribute replaces the published copy unless the rebuilt lock adds
# advisories or cannot be checked for them. The core minors are past their security
# support: core advisories stay.
_EZC_PINNED="ezcontent-2.2.15-10.3.6"
_EZC_DISTPKG="srijanone/ezcontent"
_CK2_PINNED="commerce_base-2.40-10.1.8"
_CK2_DISTPKG="drupalcommerce/commerce_base"
_PHP_PINNED="${_PHP_83}"

# Vanilla core minors to build. Empty (default) = auto-discover every released minor
# >= _CORE_FLOOR, minus _CORE_EXCLUDE, so the newest minor is always built without
# editing this file. Set an explicit space-separated list to pin a fixed matrix.
_CORE_MINORS=""
_CORE_FLOOR="10.2"                               # oldest minor to build when auto-discovering
_CORE_EXCLUDE="11.0"                             # minors to skip (short-lived/EOL), space-separated

# Shared Composer flags. Distros stage the codebase without installing; vanilla cores
# install immediately (they carry no post-create fix-ups).
_CP_FLAGS="--no-dev --no-interaction --no-install --no-scripts"
_CORE_CP_FLAGS="--no-dev --no-interaction"

# varbase was DISABLED 2026-07-08 (upstream template drift made every build uninstallable)
# and RE-ENABLED 2026-08-11: upstream fixed the template in July 2026 -- it now pins core
# explicitly and ships a committed lock, and the current stable line builds AND installs.
# Since 2026-09-10 the build target is the 11 line (stable upstream since 2026-09-08,
# web/ layout, the catalogue VBX web_dir moved with it); the 10 line's last build stays on
# the mirror for the platforms that already run it. One standing caveat: the upstream
# patch set is fetched from mutable branch refs with no hashes, so REBUILDS are not
# reproducible -- each published tarball is the frozen artefact, same as every other
# distro here.
_ALL_DISTROS="farm cms culturas commerce localgov openfed opigno social thunder varbase ezcontent commerce_base"

_LOCK="/run/staticbuild.lock"
_UA="staticbuild version-check"

# Runtime state.
_DAY_DIR=""
_PHP_ORIG=""
_PHP_LINK_CREATED=0
_FORCE=0
_SKIP_CLEARCACHE=0
_OVERWRITE=0
_OVERWRITE_NAMES=""
_REFUSED=0
_ADV_TMP=""
_LOCK_HELD=0
_DEBUG_MODE="${_DEBUG_MODE:-NO}"                 # --debug: stream everything, no run log
_LOG=""                                          # this run's log; empty = output streams
_FALLBACK_NOTE=""                                # set by _with_core_fallback for the row note
_FIX_BEFORE=""                                   # advisory count before the fix step
_FIX_LINES=()                                    # the fix step's record for the .advisories file
_FIX_NOTE=""                                     # the fix step's word for the row
_PENDING_NOTE=""                                 # a build warning waiting for its platform's row
_FIX_MOVED=""                                    # what a rejected fix resolve would have moved
_TAIL_FROM=0                                     # run log size when the current target started
_ACTION=""

# The run record: one summary row per key -- a platform (its tarball name without
# .tar.gz), or a build target that failed before it had a name -- in the order the
# run first touched it.
_P_KEYS=()
declare -gA _P_SEEN=() _P_NAME=() _P_BUILD=() _P_ADV=() _P_PUB=() _P_NOTE=() _P_TAIL=()

# ---------------------------------------------------------------------------
# Output helpers.
# ---------------------------------------------------------------------------

# While a run log is open (_start_log), stdout and stderr both go to it and the
# console is kept on fds 3 and 4: _msg/_info/_alrt then write detail to the log only,
# and _say is the one way onto the console (a copy lands in the log too). Colour only
# on a terminal, so logs and cron mail carry no escape codes.
_msg()  { printf '%s\n' "$*"; }
_info() { if [[ -t 1 ]]; then printf '\033[0;32m%s\033[0m\n' "$*"; else printf '%s\n' "$*"; fi; }
_alrt() { if [[ -t 2 ]]; then printf '\033[0;33m%s\033[0m\n' "$*" >&2; else printf '%s\n' "$*" >&2; fi; }
_say()  {
  if [[ -n "${_LOG}" ]]; then
    printf '%s\n' "$*" >&3
    printf '%s\n' "$*"
  else
    printf '%s\n' "$*"
  fi
}
_progress() {
  # One self-overwriting status line, only when a person watches the console.
  [[ -n "${_LOG}" && -t 3 ]] || return 0
  printf '\r\033[K%s' "$*" >&3
}
_progress_end() {
  [[ -n "${_LOG}" && -t 3 ]] || return 0
  printf '\r\033[K' >&3
}
_die() {
  if [[ -n "${_LOG}" ]]; then
    printf 'FATAL ERROR: %s\n' "$*"
    _progress_end
    printf 'FATAL ERROR: %s (log: %s)\n' "$*" "${_LOG}" >&4
  elif [[ -t 2 ]]; then
    printf '\033[0;31mFATAL ERROR: %s\033[0m\n' "$*" >&2
  else
    printf 'FATAL ERROR: %s\n' "$*" >&2
  fi
  # What the run did before it stopped still gets its rows (not from a subshell,
  # whose output would land in a capture).
  [[ "${BASH_SUBSHELL}" == "0" ]] && print_summary
  _cleanup
  exit 1
}

_start_log() {
  # $1 = action. Send the whole run to a log and keep only the summary on the console;
  # --debug keeps today's streaming. Never fatal: without a log, output streams.
  [[ "${_DEBUG_MODE}" == "YES" ]] && return 0
  local _dir="${_LOG_DIR}/${_O8_USER}/${_DAY}"
  if ! mkdir -p "${_dir}" 2>/dev/null || ! chmod 700 "${_LOG_DIR}" 2>/dev/null; then
    _alrt "cannot create ${_dir}; output streams instead of going to a log"
    return 0
  fi
  _LOG="${_dir}/${1}-$(date -u +%H%M%S).log"
  if ! { : > "${_LOG}" && chmod 600 "${_LOG}"; } 2>/dev/null; then
    _alrt "cannot write ${_LOG}; output streams instead of going to a log"
    _LOG=""
    return 0
  fi
  exec 3>&1 4>&2
  exec >>"${_LOG}" 2>&1
  _msg "# staticbuild ${1}, $(date -u '+%F %T') UTC, day dir ${_DAY_DIR}"
}

_tail_mark() {
  # Where the current build starts in the run log, so a failure shows only its own lines.
  if [[ -n "${_LOG}" ]]; then
    _TAIL_FROM="$(stat -c %s "${_LOG}" 2>/dev/null || echo 0)"
  fi
}

_log_tail() {
  # The last lines of the run log, for a failed row's footer: what the failing step
  # printed just before it gave up. Empty without a log (--debug already showed it).
  [[ -n "${_LOG}" && -r "${_LOG}" ]] || return 0
  tail -c +"$((_TAIL_FROM + 1))" "${_LOG}" | grep -v '^[[:space:]]*$' | tail -n 8 | cut -c1-200
}

# ---------------------------------------------------------------------------
# The run record (see _P_KEYS) and the summary built from it.
# ---------------------------------------------------------------------------

_rec() {
  # $1 key, $2 field (NAME BUILD ADV PUB), $3 value. The first touch fixes the row order.
  local _k="$1"
  [[ -n "${_P_SEEN[${_k}]:-}" ]] || { _P_SEEN[${_k}]=1; _P_KEYS+=("${_k}"); }
  case "$2" in
    NAME)  _P_NAME[${_k}]="$3" ;;
    BUILD) _P_BUILD[${_k}]="$3" ;;
    ADV)   _P_ADV[${_k}]="$3" ;;
    PUB)   _P_PUB[${_k}]="$3" ;;
  esac
}

_rec_note() {
  # $1 key, $2 text; notes accumulate, joined by "; ", each once: the same failure in
  # three trees, or an audit that failed at build and again at distribute, is one note.
  local _k="$1"
  [[ -n "${_P_SEEN[${_k}]:-}" ]] || { _P_SEEN[${_k}]=1; _P_KEYS+=("${_k}"); }
  case "; ${_P_NOTE[${_k}]:-}; " in
    *"; $2; "*) return 0 ;;
  esac
  _P_NOTE[${_k}]="${_P_NOTE[${_k}]:+${_P_NOTE[${_k}]}; }$2"
}

_rec_pub() {
  # $1 key, $2 publish outcome. Several copies can feed one row (three dev trees, a
  # compat tarball, a stamp): the row keeps the outcome that matters most.
  local _k="$1" _new="$2" _old _r _i=0 _ro=-1 _rn=-1
  _old="${_P_PUB[${_k}]:-}"
  for _r in same new updated replaced OVERWRITTEN REFUSED FAILED; do
    [[ "${_r}" == "${_old}" ]] && _ro="${_i}"
    [[ "${_r}" == "${_new}" ]] && _rn="${_i}"
    _i=$((_i + 1))
  done
  [[ "${_rn}" -ge "${_ro}" ]] && _rec "${_k}" PUB "${_new}"
  return 0
}

_cleanup() {
  # Restore the original /usr/bin/php symlink and release the lock. Safe to call
  # more than once (trap on EXIT plus _die).
  if [[ -n "${_PHP_ORIG}" ]]; then
    ln -sf "${_PHP_ORIG}" "${_SYS_PHP}" 2>/dev/null
    _PHP_ORIG=""
  elif [[ "${_PHP_LINK_CREATED}" == "1" ]]; then
    rm -f "${_SYS_PHP}" 2>/dev/null
    _PHP_LINK_CREATED=0
  fi
  if [[ "${_LOCK_HELD}" == "1" ]]; then
    rmdir "${_LOCK}" 2>/dev/null
    _LOCK_HELD=0
  fi
  if [[ -n "${_ADV_TMP}" ]]; then
    rm -rf "${_ADV_TMP}" 2>/dev/null
    _ADV_TMP=""
  fi
}

# ---------------------------------------------------------------------------
# Privilege + environment helpers.
# ---------------------------------------------------------------------------

_run_as_o8() {
  # Run a single shell command as the Octopus build user. Returns its exit code.
  # COMPOSER_NO_INTERACTION: no composer call may ever stop to ask - e.g. requiring
  # drush when the distro template already dev-requires it (drupal/cms 2.1.3+) prompts
  # "Do you want to move this requirement?" and hangs the build; non-interactive
  # composer skips the prompt and performs the move.
  su -s /bin/bash - "${_O8_USER}" -c "export COMPOSER_NO_INTERACTION=1; $1"
}

use_php() {
  # Point /usr/bin/php at the requested interpreter for the next build. Non-fatal:
  # a missing interpreter fails one target (the caller records it), not the batch.
  local _bin="$1"
  if [[ ! -x "${_bin}" ]]; then
    _alrt "php interpreter not found: ${_bin}"
    return 1
  fi
  if ! ln -sf "${_bin}" "${_SYS_PHP}"; then
    _alrt "cannot set ${_SYS_PHP} -> ${_bin}"
    return 1
  fi
  _msg "php: ${_SYS_PHP} -> ${_bin}"
}

_acquire_lock() {
  if ! mkdir "${_LOCK}" 2>/dev/null; then
    _die "another staticbuild run holds ${_LOCK} (remove it if stale)"
  fi
  _LOCK_HELD=1
}

_require_root() {
  [[ "$(id -u)" == "0" ]] || _die "must run as root (needs ${_SYS_PHP} switch + ${_DISTRO_OUT%/*} writes)"
}

_require_o8() {
  # Never guess the account: the build user is o8 unless -u says otherwise, and
  # it must be a real Octopus instance (system user + /data/disk home). Scanning
  # /data/disk/o* here would run builds as an arbitrary customer account.
  [[ -n "${_O8_USER}" ]] || _die "empty build user; pass -u USER"
  id -u "${_O8_USER}" >/dev/null 2>&1 || _die "build user '${_O8_USER}' does not exist (pass -u USER)"
  [[ -d "${_STATIC_ROOT}/${_O8_USER}" ]] || _die "build user '${_O8_USER}' has no ${_STATIC_ROOT}/${_O8_USER} (pass -u USER)"
  command -v wget >/dev/null 2>&1 || _die "wget not found (needed for release downloads)"
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed to resolve latest versions)"
}

_require_composer() {
  # Only the Composer distro/core builds need composer; the Backdrop family does not.
  _run_as_o8 "command -v composer >/dev/null 2>&1" || _die "composer not available for ${_O8_USER}"
}

# ---------------------------------------------------------------------------
# Build primitives.
# ---------------------------------------------------------------------------

_begin_build() {
  # 0 = proceed, 1 = skip/handled. $1 = glob prefix of the final platform name
  # (e.g. "localgov-" or "drupal-10.2."), $2 = result label. Skips if a matching
  # platform already exists; with -f, removes it first and rebuilds.
  local _gp="$1" _label="$2"
  if _run_as_o8 "ls -d ${_DAY_DIR}/${_gp}*/ ${_DAY_DIR}/${_gp}*.tar.gz 2>/dev/null | grep -q ."; then
    if [[ "${_FORCE}" == "1" ]]; then
      _msg "REBUILD: removing existing ${_gp}*"
      _run_as_o8 "rm -rf ${_DAY_DIR}/${_gp}*/ ${_DAY_DIR}/${_gp}*.tar.gz ${_DAY_DIR}/${_gp}*.advisories" \
        || { _record_fail "${_label}"; return 1; }
    else
      _msg "SKIP: ${_gp}* already built (use -f to rebuild)"
      # Key the row by the platform already in the day dir, so its publish outcome
      # lands on the same row.
      local _have
      _have="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d ${_gp}*/ 2>/dev/null" | head -n 1)"
      _have="${_have%/}"
      if [[ -z "${_have}" ]]; then
        _have="$(_run_as_o8 "cd '${_DAY_DIR}' && ls ${_gp}*.tar.gz 2>/dev/null" | head -n 1)"
        _have="${_have%.tar.gz}"
      fi
      _rec "${_have:-${_label}}" BUILD skip
      _rec_note "${_have:-${_label}}" "already built (-f rebuilds)"
      return 1
    fi
  fi
  return 0
}

_create_project() {
  # Create a distribution project into a hidden working dir and echo the version
  # Composer resolved for it. $1 workdir (abs, hidden), $2 spec (pkg[:constraint]),
  # $3 package name for the version parse, $4 extra create-project options (may be empty).
  # Returns non-zero on create-project failure.
  local _wd="$1" _spec="$2" _pkg="$3" _extra="$4" _out _rc _ver
  _run_as_o8 "rm -rf '${_wd}'" >/dev/null 2>&1
  _out="$(_run_as_o8 "cd '${_DAY_DIR}' && composer create-project ${_extra} ${_spec} '${_wd##*/}' ${_CP_FLAGS} 2>&1")"
  _rc=$?
  if [[ "${_rc}" != "0" ]]; then
    printf '%s\n' "${_out}" | tail -n 20 >&2
    return 1
  fi
  # "Installing <pkg> (<version> [<ref>])" - keep only the first whitespace-free token of
  # the parenthetical (a dev-branch line is "<branch> <commit>"; drop the commit), strip v.
  _ver="$(printf '%s\n' "${_out}" | grep -oiE "${_pkg} \([^)]+\)" | head -n 1 | sed -E 's/.*\(([^) ]+).*/\1/; s/^v//')"
  printf '%s\n' "${_ver}"
  return 0
}

_composer_prepare() {
  # Trust all Composer plugins the distro's own tree declares. Distros pull varying
  # plugin sets (composer/installers, cweagans/composer-patches, installers-extender,
  # ...); enumerating them per-distro is fragile and composer 2.2+ blocks any unlisted
  # plugin, failing the install.
  local _dir="$1"
  _run_as_o8 "cd '${_dir}' && composer config --no-plugins allow-plugins true" || return 1
  # A single stale core patch shouldn't fail the whole build (upstream usually fixes it in
  # a newer release) - make patch failures non-fatal. --json stores a real boolean; plain
  # `config ... false` would store the string "false", which the plugin reads as truthy.
  _run_as_o8 "cd '${_dir}' && composer config --no-plugins --json extra.composer-exit-on-patch-failure false" || return 1
  # Composer's security-advisory blocking (on by default in current Composer, and
  # commerce_kickstart enables it itself) refuses every advisory-affected core or
  # dependency, which also defeats the older-core fallback (older cores carry
  # advisories). Blocking stays off on purpose: one upstream advisory must not halt a
  # catalogue build. _finalize_distro then applies the fixed releases the constraints
  # allow and audits what ships, and "staticbuild advisories" re-checks the published
  # set against newer advisories.
  _run_as_o8 "cd '${_dir}' && composer config --no-plugins --json policy.advisories.block false" || return 1
}

_composer_build() {
  # Resolve then install without dev dependencies.
  local _dir="$1"
  _run_as_o8 "cd '${_dir}' && composer update --no-install --no-scripts" || return 1
  _run_as_o8 "cd '${_dir}' && composer install --no-dev" || return 1
}

_commerce_build() {
  # Commerce Kickstart's two-phase install: install, add the certified-projects layer,
  # then re-resolve and install.
  local _dir="$1"
  _run_as_o8 "cd '${_dir}' && composer install --no-dev" || return 1
  _run_as_o8 "cd '${_dir}' && composer require centarro/certified-projects" || return 1
  _run_as_o8 "cd '${_dir}' && composer update --no-install --no-scripts" || return 1
  _run_as_o8 "cd '${_dir}' && composer install --no-dev" || return 1
}

_pin_core() {
  # Force the Drupal core minor. Pin BOTH drupal/core and drupal/core-recommended: a
  # distro may require drupal/core directly (e.g. openculturas "^11.3.12"), and pinning
  # only core-recommended would then CONFLICT with it instead of overriding it.
  local _dir="$1" _minor="$2"
  _run_as_o8 "cd '${_dir}' && composer require --no-update --no-scripts drupal/core-recommended:'${_minor}.*' drupal/core:'${_minor}.*'"
}

_with_core_fallback() {
  # Build via callback $3; if the latest core fails (e.g. a distro's core patch is stale
  # on the newest release), retry pinned to progressively older core minors until one
  # builds, and keep it. $1 workdir, $2 label, $3 build function name.
  local _dir="$1" _label="$2" _fn="$3" _m _failed _fmin
  if "${_fn}" "${_dir}"; then return 0; fi
  _alrt "${_label}: build on the latest core failed; retrying with older cores"
  # Start below whatever core the failed attempt resolved (from its lock, if any).
  _failed="$(_lock_version "${_dir}" "drupal/core")"
  _fmin="${_failed%.*}"
  for _m in $(_discover_core_minors | tr ' ' '\n' | sort -rV); do
    [[ -n "${_fmin}" ]] && _minor_ge "${_m}" "${_fmin}" && continue
    _msg "${_label}: retry on core ${_m}.*"
    _run_as_o8 "cd '${_dir}' && rm -rf composer.lock vendor patches.lock.json" >/dev/null 2>&1
    _pin_core "${_dir}" "${_m}" || continue
    if "${_fn}" "${_dir}"; then
      _info "${_label}: built on core ${_m}.*"
      _FALLBACK_NOTE="older core ${_m}"
      return 0
    fi
  done
  return 1
}

_detect_core_version() {
  # Echo the resolved Drupal core version from a built platform, probing the three
  # known docroot layouts. Empty output + non-zero on failure.
  local _dir="$1" _rel
  for _rel in web/core/lib/Drupal.php docroot/core/lib/Drupal.php html/core/lib/Drupal.php \
              core/lib/Drupal.php; do
    if _run_as_o8 "test -f '${_dir}/${_rel}'" >/dev/null 2>&1; then
      _run_as_o8 "awk -F\"'\" '/const VERSION =/{print \$2; exit}' '${_dir}/${_rel}'" 2>/dev/null \
        | grep -m1 -oE '[0-9]+\.[0-9]+\.[0-9A-Za-z.-]+'
      return 0
    fi
  done
  return 1
}

_record_fail() {
  # $1 = "<target>" or "<target> (<reason>)". A failed build has no platform name
  # yet, so its row is keyed by the target; the log's last lines go to the footer.
  local _k="${1%% *}" _why=""
  if [[ "$1" == *" ("*")" ]]; then
    _why="${1#* (}"
    _why="${_why%)}"
  fi
  _rec "${_k}" BUILD FAIL
  _rec_note "${_k}" "${_why:-build failed}"
  _P_TAIL[${_k}]="$(_log_tail)"
  _alrt "$1: build failed"
}

_lock_version() {
  # Echo an installed package's version from composer.lock (empty if absent). Used
  # where the create-project root template versions independently of the distribution.
  local _dir="$1" _pkg="$2"
  _run_as_o8 "grep -A3 '\"name\": \"${_pkg}\"' '${_dir}/composer.lock' 2>/dev/null | grep -m1 '\"version\"'" 2>/dev/null \
    | sed -E 's/.*: *"([^"]+)".*/\1/; s/^v//'
}

# ---------------------------------------------------------------------------
# Advisory audit. Blocking stays off (see _composer_prepare), so the audit is the
# record: it runs on a disposable copy of a platform's composer.lock, never inside
# the platform, and a failure is reported, never fatal.
# ---------------------------------------------------------------------------

_run_self() {
  # _run_as_o8's counterpart for the read-only actions: run as the invoking user.
  bash -c "export COMPOSER_NO_INTERACTION=1 COMPOSER_ALLOW_SUPERUSER=1; $1"
}

_audit_prep_php() {
  # Writes the audit copy's composer.json: a name and the drupal.org repository,
  # nothing of the platform's. Composer runs a composer.json's init and
  # pre-command-run scripts even for audit, and a platform's config and
  # repositories can hide advisories (ignore lists, packagist.org false) or pick
  # where files get written (cache-dir). Prints --no-dev when the platform's
  # installed.json says require-dev was not installed, so only what the platform
  # carries is audited. PHP 5.6-safe.
  cat <<'EOF'
<?php
$dir = $argv[1];
$j = array(
  'name' => 'boa/advisory-audit',
  'repositories' => array(array('type' => 'composer', 'url' => $argv[2])),
);
if (file_put_contents($dir . '/composer.json', json_encode($j, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n") === false) {
  exit(1);
}
$i = json_decode((string) @file_get_contents($dir . '/installed.json'), true);
if (is_array($i) && array_key_exists('dev', $i) && $i['dev'] === false) {
  echo "--no-dev\n";
}
exit(0);
EOF
}

_audit_report_php() {
  # Reads a `composer audit --format=json` document plus the lock it audited and
  # prints "advisories: N", then one tab-separated line per finding: id, package,
  # locked version, CVE, link. Composer's filter-list hits (the malware list) and
  # anything it reports as ignored count as findings too, their id prefixed with
  # the list name. Exits 1 unless the document is a finished audit that reached
  # every advisory source. Fields are stripped to printable non-space ASCII: they
  # come from remote feeds. PHP 5.6-safe.
  cat <<'EOF'
<?php
function _f($s) {
  $s = preg_replace('/[^\x21-\x7e]/', '', (string) $s);
  return $s === '' ? '-' : $s;
}
function _rows($list, $ver, $prefix, &$rows) {
  if (!is_array($list)) {
    return;
  }
  foreach ($list as $pkg => $items) {
    if (!is_array($items)) {
      continue;
    }
    foreach ($items as $x) {
      if (is_array($x)) {
        $name = isset($x['packageName']) ? $x['packageName'] : $pkg;
        $id = isset($x['advisoryId']) ? $x['advisoryId'] : (isset($x['id']) ? $x['id'] : '');
        $link = isset($x['link']) ? $x['link'] : (isset($x['url']) ? $x['url'] : '');
        $cve = isset($x['cve']) ? $x['cve'] : '';
        $tag = $prefix;
        if ($tag === '' && isset($x['listName'])) {
          $tag = $x['listName'] . ':';
        }
      }
      else {
        $name = $pkg;
        $id = $x;
        $link = '';
        $cve = '';
        $tag = $prefix;
      }
      $rows[] = implode("\t", array(
        _f($tag . $id),
        _f($name),
        _f(isset($ver[$name]) ? $ver[$name] : ''),
        _f($cve),
        _f($link)
      ));
    }
  }
}
$a = json_decode((string) @file_get_contents($argv[1]), true);
if (!is_array($a) || !array_key_exists('advisories', $a) || !is_array($a['advisories'])) {
  exit(1);
}
if (!empty($a['unreachable-repositories'])) {
  exit(1);
}
$ver = array();
$lock = json_decode((string) @file_get_contents($argv[2]), true);
foreach (array('packages', 'packages-dev') as $s) {
  if (is_array($lock) && isset($lock[$s]) && is_array($lock[$s])) {
    foreach ($lock[$s] as $p) {
      if (isset($p['name'], $p['version'])) {
        $ver[$p['name']] = $p['version'];
      }
    }
  }
}
$rows = array();
_rows($a['advisories'], $ver, '', $rows);
_rows(isset($a['filter']) ? $a['filter'] : array(), $ver, '', $rows);
_rows(isset($a['ignored-advisories']) ? $a['ignored-advisories'] : array(), $ver, 'ignored:', $rows);
sort($rows);
echo 'advisories: ', count($rows), "\n";
foreach ($rows as $r) {
  echo $r, "\n";
}
EOF
}

_audit_dir() {
  # Audit the lock in $1 -- a dir this script made, holding a copy of a platform's
  # composer.lock and, when it has one, its vendor/composer/installed.json (the path
  # goes into shell strings, so never pass one built from a name read off the
  # network) -- running every step through $2 (_run_as_o8 or _run_self). Prints the
  # report (see _audit_report_php) plus a closing "# require-dev ..." line, or one
  # line "advisories: unknown (<why>)" and returns 1.
  local _dir="$1" _run="$2" _rep _err _why _dev
  if ! { _audit_prep_php | "${_run}" "cat > '${_dir}/.audit-prep.php'" \
         && _audit_report_php | "${_run}" "cat > '${_dir}/.audit-report.php'"; }; then
    printf '%s\n' "advisories: unknown (cannot write the audit helpers)"
    return 1
  fi
  if ! _dev="$("${_run}" "php '${_dir}/.audit-prep.php' '${_dir}' '${_DRUPAL_REPO_URL}'" 2>/dev/null)" \
    || [[ -n "${_dev}" && "${_dev}" != "--no-dev" ]]; then
    printf '%s\n' "advisories: unknown (cannot write the audit copy)"
    return 1
  fi
  # A home of its own, so no global Composer config (ignore lists, ignore-unreachable)
  # reaches the audit. The exit code is not the verdict: composer audit exits
  # non-zero for findings and for abandoned packages alike, so only a finished JSON
  # document counts.
  "${_run}" "cd '${_dir}' && export COMPOSER_HOME='${_dir}/.home' COMPOSER_CACHE_DIR='${_dir}/.cache' && composer audit --locked --format=json --no-plugins --no-scripts ${_dev} > .audit.json 2> .audit.err" >/dev/null 2>&1
  if _rep="$("${_run}" "php '${_dir}/.audit-report.php' '${_dir}/.audit.json' '${_dir}/composer.lock'" 2>/dev/null)" \
    && [[ "${_rep}" == "advisories: "* ]]; then
    printf '%s\n' "${_rep}"
    if [[ -n "${_dev}" ]]; then
      printf '%s\n' "# require-dev: not installed in the platform, not audited"
    else
      printf '%s\n' "# require-dev: audited (installed, or no installed.json to tell)"
    fi
    return 0
  fi
  # Composer prints its error under an "In <File>.php line <N>:" header as a block
  # cut at a fixed width (mid-word too), each chunk framed by two spaces a side, and
  # ends with the command's usage line: strip the frames and rejoin the chunks.
  _err="$("${_run}" "cat '${_dir}/.audit.err'" 2>/dev/null)"
  _why="$(printf '%s\n' "${_err}" | awk '
    /^In .* line [0-9]+:/ { _t = 1; next }
    _t && NF { _s = _s substr($0, 3, length($0) - 4); next }
    _t && _s != "" { exit }
    END { if (_s != "") print _s }')"
  [[ -n "${_why}" ]] || _why="$(printf '%s\n' "${_err}" | grep -m1 -v '^[[:space:]]*$')"
  _why="$(printf '%s' "${_why}" | tr -cd '[:print:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | cut -c1-200)"
  printf '%s\n' "advisories: unknown (composer audit did not finish: ${_why:-an advisory source was unreachable})"
  return 1
}

_audit_tree() {
  # $1 = a platform dir this script made (a finished platform in the day dir, or a
  # distro workdir before its rename). Audits a copy of its composer.lock (and
  # vendor/composer/installed.json) in a scratch dir, never inside the platform, and
  # prints the _audit_dir report. Its output is captured: nothing else on stdout here.
  local _dir="$1" _scr="${_DAY_DIR}/.audit.work" _rep
  if _run_as_o8 "rm -rf '${_scr}' && mkdir -p '${_scr}' && cp '${_dir}/composer.lock' '${_scr}/' && { [ ! -f '${_dir}/vendor/composer/installed.json' ] || cp '${_dir}/vendor/composer/installed.json' '${_scr}/'; }" >/dev/null 2>&1; then
    _rep="$(_audit_dir "${_scr}" _run_as_o8)"
  else
    _rep="advisories: unknown (no composer.lock at the platform root)"
  fi
  _run_as_o8 "rm -rf '${_scr}'" >/dev/null 2>&1
  printf '%s\n' "${_rep}"
}

_audit_platform() {
  # Non-fatal advisory audit of a finished platform ($1 = its name in the day dir).
  # The report goes beside the tarball-to-be as <name>.advisories, followed by what
  # the fix step did (_FIX_LINES); the summary row gets the count left and how many
  # the fix step cleared. An audit that could not run gets a row note and never fails
  # the build.
  local _name="$1" _rep _n _ids _cell _left
  _rep="$(_audit_tree "${_DAY_DIR}/${_name}")"
  if ! { printf '%s\n' "# composer audit --locked, $(date -u '+%F %T') UTC" "# ${_name}" "${_rep}" \
           "${_FIX_LINES[@]}" | _run_as_o8 "cat > '${_DAY_DIR}/${_name}.advisories'"; }; then
    _alrt "${_name}: could not write ${_name}.advisories"
    _rec_note "${_name}" "no .advisories file"
  fi
  _n="$(printf '%s\n' "${_rep}" | sed -n '1s/^advisories: //p')"
  case "${_n}" in
    [0-9]*)
      _cell="${_n}"
      if [[ "${_FIX_BEFORE}" =~ ^[0-9]+$ ]] && [[ "${_FIX_BEFORE}" -gt "${_n}" ]]; then
        _cell="${_n} ($((_FIX_BEFORE - _n)) fixed)"
      fi
      if [[ "${_n}" -gt 0 ]]; then
        _ids="$(printf '%s\n' "${_rep}" \
          | awk -F'\t' 'NR > 1 && !/^#/ { printf "%s%s (%s)", (_c++ ? ", " : ""), $1, $2 }')"
        _msg "${_name}: its lock carries ${_n} known advisories: ${_ids}"
        # What stays and why is in the .advisories file; the row names only a limit
        # the operator can lift.
        if printf '%s\n' "${_FIX_LINES[@]}" | grep -q '^# not fixed: .*(GitHub refused'; then
          _rec_note "${_name}" "GitHub rate limit"
        fi
      fi
      ;;
    *)
      _cell="unknown"
      _rec_note "${_name}" "audit failed"
      _alrt "${_name}: advisory audit did not run: ${_n:-unknown}"
      ;;
  esac
  _rec "${_name}" ADV "${_cell}"
  return 0
}

_fix_why() {
  # $1 = the output of a resolve that failed: the reason for the row and .advisories.
  case "$1" in
    *"Could not authenticate against github.com"*|*"API rate limit"*|*"github.com: Permission denied"*)
      printf '%s' "GitHub refused an anonymous request: rerun later, or give the build user a GitHub token" ;;
    *"Your requirements could not be resolved"*)
      printf '%s' "no update resolves within the constraints" ;;
    *)
      printf '%s' "no update resolves, see the run log" ;;
  esac
}

_fix_kept() {
  # $1 = the workdir. 0 when drupal/core and every held package are still at the
  # version the caller recorded in its _held map (bash's dynamic scope); otherwise 1,
  # with what moved in _FIX_MOVED.
  local _p
  _FIX_MOVED=""
  for _p in "${!_held[@]}"; do
    if [[ "$(_lock_version "$1" "${_p}")" != "${_held[${_p}]}" ]]; then
      case "${_p}" in
        drupal/core) _FIX_MOVED="a newer core" ;;
        *)           _FIX_MOVED="${_p} to move, which this build holds" ;;
      esac
      return 1
    fi
  done
  return 0
}

_fix_advisories() {
  # Apply the fixed releases of every advisory-affected package a distro build locked
  # (see _fix_step for where it runs). $1 = the distro workdir, $2 = label, $3 = the
  # packages this build holds: the ones whose versions name the platform. Every
  # affected package moves to the newest release its constraints allow, with its
  # non-root dependencies (-w: root requirements such as the core pins never move; -m
  # keeps the other moves minimal). One resolve for all of them comes first: each
  # resolve re-reads every repository, and a distribution that declares a GitHub VCS
  # repository pays an anonymous GitHub request for it. When that resolve fails, or
  # moves drupal/core or a held package, the packages go one at a time instead, and a
  # move of either is put back: a newer core or distribution is a new platform name,
  # which the catalogue takes with a BOA release. The result installs once. Sets
  # _FIX_BEFORE (the count before), _FIX_LINES (the record for .advisories) and
  # _FIX_NOTE (a word for the row). Returns 1 when the fixed lock does not install.
  local _wd="$1" _label="$2" _hold=" ${3:-} " _rep _pkgs _p _v0 _v1 _moved=0
  local _todo="" _out _rc _keep _nodev=""
  local -A _was=() _held=() _why=()
  local _env="COMPOSER_NO_SECURITY_BLOCKING=1"
  local _up="${_env} composer update --no-install --no-scripts --with-dependencies --minimal-changes ${_FIX_IGNORE_EXT}"
  _FIX_BEFORE=""
  _FIX_NOTE=""
  _FIX_LINES=()
  _rep="$(_audit_tree "${_wd}")"
  _FIX_BEFORE="$(sed -n '1s/^advisories: //p' <<< "${_rep}")"
  if [[ ! "${_FIX_BEFORE}" =~ ^[0-9]+$ ]]; then
    _FIX_LINES+=("# fix step skipped: the audit before it did not run")
    _alrt "${_label}: advisory fix step skipped: the audit before it did not run"
    _FIX_NOTE="fix step skipped"
    _FIX_BEFORE=""
    return 0
  fi
  [[ "${_FIX_BEFORE}" -gt 0 ]] || return 0
  # Package names only as Composer writes them: they reach shell strings below.
  _pkgs="$(awk -F'\t' 'NR > 1 && !/^#/ && $2 ~ /^[a-z0-9_.-]+\/[a-z0-9_.-]+$/ { print $2 }' <<< "${_rep}" | sort -u)"
  _msg "${_label}: fix step for ${_FIX_BEFORE} advisories in: $(tr '\n' ' ' <<< "${_pkgs}")"
  for _p in ${_pkgs}; do
    _v0="$(_lock_version "${_wd}" "${_p}")"
    case "${_p}" in
      drupal/core|drupal/core-*)
        _FIX_LINES+=("# not fixed: ${_p} ${_v0} (fixed only by a newer core, a new platform name)")
        continue
        ;;
    esac
    if [[ "${_hold}" == *" ${_p} "* ]]; then
      _FIX_LINES+=("# not fixed: ${_p} ${_v0} (held by this build: its version names the platform)")
      continue
    fi
    _was[${_p}]="${_v0}"
    _todo+=" '${_p}'"
  done
  [[ -n "${_todo}" ]] || return 0
  if ! _run_as_o8 "cp -f '${_wd}/composer.lock' '${_wd}/.lock.built'"; then
    _FIX_LINES+=("# fix step skipped: could not keep a copy of composer.lock")
    _alrt "${_label}: advisory fix step skipped: could not keep a copy of composer.lock"
    _FIX_NOTE="fix step skipped"
    return 0
  fi
  # The install keeps the tree's own require-dev scope: a tree installed with --no-dev
  # stays so, and one that carries its dev packages (a pinned platform can) keeps them.
  if _run_as_o8 "php -r '\$i = json_decode((string) @file_get_contents(\$argv[1]), true); exit(is_array(\$i) && array_key_exists(\"dev\", \$i) && \$i[\"dev\"] === false ? 0 : 1);' '${_wd}/vendor/composer/installed.json'"; then
    _nodev="--no-dev"
  fi
  # The versions the step must leave where they are: drupal/core and the held packages.
  _keep="drupal/core ${_hold}"
  for _p in ${_keep}; do
    _held[${_p}]="$(_lock_version "${_wd}" "${_p}")"
  done
  _out="$(_run_as_o8 "cd '${_wd}' && ${_up}${_todo} 2>&1")"
  _rc=$?
  printf '%s\n' "${_out}"
  if [[ "${_rc}" != "0" ]] || ! _fix_kept "${_wd}"; then
    _msg "${_label}: one resolve for all of them did not hold; one package at a time"
    _run_as_o8 "cp -f '${_wd}/.lock.built' '${_wd}/composer.lock'"
    for _p in ${_pkgs}; do
      [[ -n "${_was[${_p}]+x}" ]] || continue
      _run_as_o8 "cp -f '${_wd}/composer.lock' '${_wd}/.lock.step'"
      _out="$(_run_as_o8 "cd '${_wd}' && ${_up} '${_p}' 2>&1")"
      _rc=$?
      printf '%s\n' "${_out}"
      if [[ "${_rc}" != "0" ]]; then
        _run_as_o8 "cp -f '${_wd}/.lock.step' '${_wd}/composer.lock'"
        _why[${_p}]="$(_fix_why "${_out}")"
      elif ! _fix_kept "${_wd}"; then
        _run_as_o8 "cp -f '${_wd}/.lock.step' '${_wd}/composer.lock'"
        _why[${_p}]="its fix needs ${_FIX_MOVED}"
      fi
    done
  fi
  # One line per package, read from the final lock: a package another fix moved as its
  # dependency counts as moved, whatever its own resolve did.
  for _p in ${_pkgs}; do
    [[ -n "${_was[${_p}]+x}" ]] || continue
    _v1="$(_lock_version "${_wd}" "${_p}")"
    if [[ "${_v1}" != "${_was[${_p}]}" ]]; then
      _FIX_LINES+=("# updated: ${_p} ${_was[${_p}]} -> ${_v1}")
      _moved=1
    else
      _FIX_LINES+=("# not fixed: ${_p} ${_v1} (${_why[${_p}]:-no fixed release within the constraints})")
    fi
  done
  if [[ "${_moved}" != "1" ]]; then
    # Nothing moved, but a resolve may still have rewritten the lock (its content-hash
    # follows composer.json): keep the lock exactly as built.
    _run_as_o8 "cp -f '${_wd}/.lock.built' '${_wd}/composer.lock'"
  else
    # Never reinstall the lock as built in this tree after a failed install: a pinned
    # composer-patches can record an aborted patch set as applied, so a second install
    # in the same tree may exit 0 with patches missing. The build fails instead, and
    # the published copy stays.
    _out="$(_run_as_o8 "cd '${_wd}' && ${_env} composer install ${_nodev} ${_FIX_IGNORE_EXT} 2>&1")"
    _rc=$?
    printf '%s\n' "${_out}"
    if [[ "${_rc}" != "0" ]]; then
      _alrt "${_label}: the fixed lock did not install"
      _run_as_o8 "rm -f '${_wd}/.lock.built' '${_wd}/.lock.step'"
      return 1
    fi
    # A patch that no longer applies to a fixed release is skipped, as in any build
    # here (composer-exit-on-patch-failure false), but never quietly.
    if grep -qiE 'could not apply patch|cannot apply patch' <<< "${_out}"; then
      _FIX_NOTE="patch skipped"
      _FIX_LINES+=("# warning: a patch did not apply to a fixed release, see the run log")
    fi
  fi
  _run_as_o8 "rm -f '${_wd}/.lock.built' '${_wd}/.lock.step'"
  return 0
}

_fix_step() {
  # The advisory fix step as a build runs it: straight after its Composer work and
  # before any hand work (patches, moved directories, seds), so the hand work always
  # applies to the final tree and fails closed if it no longer fits. $1 workdir,
  # $2 label, $3 packages the step must not move (the one whose version names the
  # platform). A fixed lock that does not install fails the build.
  if ! _fix_advisories "$1" "$2" "${3:-}"; then
    _record_fail "$2 (fixed lock did not install)"
    return 1
  fi
  return 0
}

_finalize_distro() {
  # Rename the working dir to <nameprefix>-<distroVer>-<coreVer> using the detected
  # versions, record the row, then audit the finished platform (never fatal); the
  # row carries what the build's _fix_step did. $1 name prefix, $2 workdir, $3 distro
  # version, $4 result label.
  local _np="$1" _wd="$2" _dver="$3" _label="$4" _core _final
  _core="$(_detect_core_version "${_wd}" 2>/dev/null)"
  # Never allow whitespace into a platform name (a dev-branch alias could carry it).
  _dver="${_dver//[[:space:]]/}"
  _core="${_core//[[:space:]]/}"
  if [[ -z "${_dver}" ]]; then _dver="unknown"; _alrt "${_label}: could not detect distro version"; fi
  if [[ -z "${_core}" ]]; then _core="unknown"; _alrt "${_label}: could not detect core version"; fi
  _final="${_np}-${_dver}-${_core}"
  if _run_as_o8 "mv '${_wd}' '${_DAY_DIR}/${_final}'"; then
    _rec "${_final}" BUILD ok
    [[ -n "${_FALLBACK_NOTE}" ]] && _rec_note "${_final}" "${_FALLBACK_NOTE}"
    [[ -n "${_FIX_NOTE}" ]] && _rec_note "${_final}" "${_FIX_NOTE}"
    [[ -n "${_PENDING_NOTE}" ]] && _rec_note "${_final}" "${_PENDING_NOTE}"
    _info "${_label}: built ${_final}"
    _audit_platform "${_final}"
  else
    _alrt "${_label}: rename to ${_final} failed"
    _record_fail "${_label} (rename failed)"
    _FALLBACK_NOTE=""
    _FIX_NOTE=""
    _FIX_BEFORE=""
    _FIX_LINES=()
    return 1
  fi
  _FALLBACK_NOTE=""
  _FIX_NOTE=""
  _FIX_BEFORE=""
  _FIX_LINES=()
  _PENDING_NOTE=""
}

_pending() {
  # $1 = label, $2 = a short warning about the platform being built, before it has a
  # name, $3 = its detail for the log (default $2): the log gets it now, the platform's
  # row gets $2 when _finalize_distro names it.
  _alrt "$1: ${3:-$2}"
  _PENDING_NOTE="${_PENDING_NOTE:+${_PENDING_NOTE}; }$2"
}

_ensure_example_sites() {
  # openculturas ships without a stock example.sites.php; source it from the
  # platform's own core scaffold asset (present regardless of build order), then
  # fall back to any sibling platform already built in the day dir.
  local _sitesdir="$1" _dir="$2" _src="" _rel
  if _run_as_o8 "test -f '${_sitesdir}/example.sites.php'"; then
    return 0
  fi
  for _rel in web/core/assets/scaffold/files/example.sites.php \
              docroot/core/assets/scaffold/files/example.sites.php; do
    if _run_as_o8 "test -f '${_dir}/${_rel}'"; then
      _src="${_dir}/${_rel}"
      break
    fi
  done
  if [[ -z "${_src}" ]]; then
    _src="$(_run_as_o8 "ls ${_DAY_DIR}/*/web/sites/example.sites.php ${_DAY_DIR}/*/docroot/sites/example.sites.php 2>/dev/null | head -1")"
  fi
  if [[ -n "${_src}" ]]; then
    _run_as_o8 "cp -a '${_src}' '${_sitesdir}/'" || _pending culturas "example.sites.php not copied" "could not copy example.sites.php"
  else
    _pending culturas "no example.sites.php" "no example.sites.php source found; skipped"
  fi
}

_resolve_farm_tag() {
  # Highest farmOS version tag, or the pinned _FARM_TAG. NOT releases/latest:
  # GitHub's "latest" follows publish DATE, so an LTS-line hotfix published
  # after a newer major steals the slot (2026-08-27: 3.5.5 landed 17h after
  # 4.0.5 and regressed the farm build a whole major). farmOS tags are plain
  # semver, which _latest_git_tag's version sort handles.
  if [[ -n "${_FARM_TAG}" ]]; then
    printf '%s\n' "${_FARM_TAG}"
    return 0
  fi
  _latest_git_tag "${_FARM_REPO}"
}

_resolve_backdrop_tag() {
  # Latest Backdrop CMS release tag, or the pinned _BACKDROP_TAG.
  if [[ -n "${_BACKDROP_TAG}" ]]; then
    printf '%s\n' "${_BACKDROP_TAG}"
    return 0
  fi
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_BACKDROP_REPO}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -n 1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_resolve_grav_tag() {
  # Latest Grav release tag, or the pinned _GRAV_TAG.
  if [[ -n "${_GRAV_TAG}" ]]; then
    printf '%s\n' "${_GRAV_TAG}"
    return 0
  fi
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_GRAV_REPO}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -n 1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_resolve_txp_tag() {
  # Latest Textpattern release tag, or the pinned _TXP_TAG.
  if [[ -n "${_TXP_TAG}" ]]; then
    printf '%s\n' "${_TXP_TAG}"
    return 0
  fi
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_TXP_REPO}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -n 1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_gh_quota_note() {
  # After a GitHub API lookup failed: when GitHub's anonymous quota is spent, prints
  # ", GitHub quota spent until HH:MM UTC" for the row, else nothing. The
  # rate_limit endpoint itself does not count against the quota. PHP 5.6-safe.
  curl -fsS --max-time 20 -A "${_UA}" "https://api.github.com/rate_limit" 2>/dev/null \
    | php -r '$j = json_decode(stream_get_contents(STDIN), true);
      if (is_array($j) && isset($j["resources"]["core"]["remaining"], $j["resources"]["core"]["reset"])
        && (int) $j["resources"]["core"]["remaining"] === 0) {
        echo ", GitHub quota spent until ", gmdate("H:i", (int) $j["resources"]["core"]["reset"]), " UTC";
      }' 2>/dev/null
}

_latest_git_tag() {
  # Highest version-sorted git tag of a repo (works for backdrop-contrib repos
  # that publish tags but not GitHub Releases). Drops peeled ^{} refs and keeps
  # only real backdrop-contrib version tags -- 'N.N.N' (extension) or 'N.x-N.N.N'
  # (bee) -- so pre-history junk like 'v0.0.1', which version-sorts above the
  # real tags, is excluded.
  local _repo="$1"
  git ls-remote --tags "https://github.com/${_repo}.git" 2>/dev/null \
    | sed -E 's#.*refs/tags/##; /\^\{\}$/d' \
    | grep -E '^([0-9]+\.x-)?[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -V | tail -n 1
}

_drupal_release() {
  # Echo a drupal.org project's latest STABLE release number (the authoritative version,
  # not the Composer template alias). Skips dev/alpha/beta/rc. Empty if unavailable.
  curl -fsSL -A "${_UA}" "https://updates.drupal.org/release-history/$1/current" 2>/dev/null \
    | grep -oE '<version>[^<]+</version>' | sed -E 's/<[^>]+>//g' \
    | grep -viE 'dev|alpha|beta|rc|unstable' | head -n 1
}

_minor_ge() {
  # 0 if $1 >= $2, comparing major.minor numerically.
  local _a1="${1%.*}" _a2="${1#*.}" _b1="${2%.*}" _b2="${2#*.}"
  if (( _a1 > _b1 )); then return 0; fi
  if (( _a1 < _b1 )); then return 1; fi
  (( _a2 >= _b2 ))
}

_discover_core_minors() {
  # Echo the drupal core minors to build: every released major.minor >= _CORE_FLOOR,
  # minus _CORE_EXCLUDE, ascending. Empty output if the metadata cannot be fetched.
  local _raw _m _out=""
  _raw="$(curl -fsSL -A "${_UA}" "https://repo.packagist.org/p2/drupal/core.json" 2>/dev/null \
    | grep -oE '"version":"[0-9]+\.[0-9]+\.[0-9]+"' \
    | sed -E 's/.*"([0-9]+)\.([0-9]+)\..*/\1.\2/' \
    | sort -u -t. -k1,1n -k2,2n)"
  while read -r _m; do
    [[ -n "${_m}" ]] || continue
    _minor_ge "${_m}" "${_CORE_FLOOR}" || continue
    case " ${_CORE_EXCLUDE} " in *" ${_m} "*) continue ;; esac
    _out+="${_m} "
  done <<< "${_raw}"
  printf '%s\n' "${_out% }"
}

# ---------------------------------------------------------------------------
# Per-distribution builds. Each records its own OK/FAIL/SKIP result.
# ---------------------------------------------------------------------------

build_farm() {
  _begin_build "farm-" "farm" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "farm"; return 1; }
  local _tag
  _tag="$(_resolve_farm_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "farm (no release tag)"; return 1; }
  local _wd="${_DAY_DIR}/.build.farm"
  local _tgz=".farmOS-${_tag}.tar.gz"
  local _url="https://github.com/${_FARM_REPO}/releases/download/${_tag}/farmOS-${_tag}.tar.gz"
  # Extract straight into the hidden working dir (--strip-components drops the release's
  # top-level farmOS/), with a hidden download name, so an interrupted farm build never
  # leaves a visible farmOS/ or farmOS-*.tar.gz that package/distribute would ship.
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_wd}' farmOS .farmOS-*.tar.gz && mkdir -p '${_wd}' && wget -q -O '${_tgz}' '${_url}' && tar -xzf '${_tgz}' --strip-components=1 -C '${_wd}' && rm -f '${_tgz}'"; then
    _record_fail "farm"
    return 1
  fi
  if ! { _composer_prepare "${_wd}" && _with_core_fallback "${_wd}" "farm" _composer_build; }; then
    _record_fail "farm"
    return 1
  fi
  _fix_step "${_wd}" "farm" "" || return 1
  _finalize_distro "farm" "${_wd}" "${_tag}" "farm"
}

build_cms() {
  _begin_build "drupal_cms_installer-" "cms" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "cms"; return 1; }
  local _wd="${_DAY_DIR}/.build.cms" _dver
  _dver="$(_create_project "${_wd}" "${_CMS_SPEC}" "drupal/cms" "")" || { _record_fail "cms"; return 1; }
  # Migration pipeline contribs ride along with drush: upstream drupal/cms ships
  # none of them (core's migrate/migrate_drupal/migrate_drupal_ui need no action),
  # and a migration source platform must not require per-site composer surgery.
  # Inert until a site enables them. --update-no-dev: a plain require installs the
  # lock's require-dev packages too, and the platform must ship without them, as the
  # builds ending in install --no-dev do.
  if ! { _composer_prepare "${_wd}" \
         && _with_core_fallback "${_wd}" "cms" _composer_build \
         && _run_as_o8 "cd '${_wd}' && composer require drush/drush drupal/migrate_plus drupal/migrate_tools drupal/migrate_upgrade --no-scripts --update-no-dev"; }; then
    _record_fail "cms"
    return 1
  fi
  # Drupal 11 prefers a plugin's PHP attribute over its legacy annotation, and
  # pathauto's attribute lost source_module in the conversion (the core attribute
  # class cannot even express it), so migrate_drupal validation refuses every
  # Drupal 7 crossing with "The pathauto_pattern plugin must define the
  # source_module property". Upstream sets it in the migration definition
  # instead (pathauto #3588684); apply that one-liner until a tagged release
  # carries it - the grep guard makes this a no-op once it does. Every touch
  # runs as the build user like the rest of the tree: root must never read or
  # write a path the o8 account - or a composer plugin executing as it during
  # this very build - can turn into a symlink first.
  _fix_step "${_wd}" "cms" "" || return 1
  local _pa_yml="${_wd}/web/modules/contrib/pathauto/migrations/d7_pathauto_patterns.yml"
  if _run_as_o8 "test -f '${_pa_yml}'" \
     && ! _run_as_o8 "grep -q 'source_module: pathauto' '${_pa_yml}'"; then
    _run_as_o8 "sed -i 's|^  plugin: pathauto_pattern$|  plugin: pathauto_pattern\n  source_module: pathauto|' '${_pa_yml}'"
    if ! _run_as_o8 "grep -q 'source_module: pathauto' '${_pa_yml}'"; then
      _alrt "cms: pathauto source_module correction did not apply"
      _record_fail "cms"
      return 1
    fi
  fi
  _finalize_distro "drupal_cms_installer" "${_wd}" "${_dver}" "cms"
}

build_culturas() {
  _begin_build "openculturas-" "culturas" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "culturas"; return 1; }
  local _wd="${_DAY_DIR}/.build.culturas" _dver
  _dver="$(_create_project "${_wd}" "${_CULTURAS_SPEC}" "drupal/openculturas_project" "--remove-vcs")" \
    || { _record_fail "culturas"; return 1; }
  # Pin the distribution to its exact drupal.org release (the template otherwise pulls a
  # -dev branch), and build with the dependency patches DROPPED - several are stale
  # against the core the distribution itself requires, and composer-patches 2.x cannot
  # apply patches to dist-installed packages at all here (its GitPatcher skips any
  # package dir without .git, its FreeformPatcher needs per-patch config), so it is
  # not a usable channel even for the patches that do apply.
  local _ocrel
  _ocrel="$(_drupal_release "${_CULTURAS_PROJECT}")"
  if ! { _composer_prepare "${_wd}" \
         && _run_as_o8 "cd '${_wd}' && composer config --json extra.composer-patches.ignore-dependency-patches '[\"${_CULTURAS_DISTPKG}\"]'" \
         && { [[ -z "${_ocrel}" ]] || _run_as_o8 "cd '${_wd}' && composer require --no-update --no-scripts ${_CULTURAS_DISTPKG}:'${_ocrel}'"; } \
         && _with_core_fallback "${_wd}" "culturas" _composer_build; }; then
    _record_fail "culturas"
    return 1
  fi
  # One dependency patch is load-bearing and is applied with GNU patch instead:
  # the views OpenCulturas ships reference entity_reference_revisions relationship
  # handlers that only exist with the ERR issue-2799479 patch - unpatched, every
  # front page request throws ViewsData->get() InvalidArgumentException (empty
  # table key from the broken relationship handler) and the site serves 500s.
  # Fail closed: a culturas platform without it is broken by default.
  _fix_step "${_wd}" "culturas" "${_CULTURAS_DISTPKG}" || return 1
  local _err_patch_url="https://www.drupal.org/files/issues/2023-06-29/entity_reference_revisions-2799479-fix-only.patch"
  local _err_mod="${_wd}/web/modules/contrib/entity_reference_revisions"
  if ! { _run_as_o8 "curl -fsS --retry 3 -o '${_wd}/.err-2799479.patch' '${_err_patch_url}'" \
         && _run_as_o8 "cd '${_err_mod}' && patch -p1 --no-backup-if-mismatch < '${_wd}/.err-2799479.patch'" \
         && _run_as_o8 "rm -f '${_wd}/.err-2799479.patch'"; }; then
    _alrt "culturas: entity_reference_revisions issue-2799479 views patch did not apply"
    _record_fail "culturas (patch failed)"
    return 1
  fi
  _info "culturas: applied entity_reference_revisions issue-2799479 views patch"
  # Flatten the openculturas-distribution wrapper: its inner profile/ becomes the
  # openculturas install profile, and its remaining contents move up into contrib/.
  local _contrib="${_wd}/web/profiles/contrib"
  local _wrap="${_contrib}/openculturas-distribution"
  if _run_as_o8 "test -d '${_wrap}'"; then
    # All required moves must succeed before the wrapper is removed; dotglob so
    # hidden files move too, and rmdir (not rm -rf) so a layout drift can never
    # delete unmoved contents.
    if _run_as_o8 "cd '${_wrap}' && mv profile openculturas && mv openculturas '${_contrib}/' && shopt -s dotglob nullglob && for _f in *; do mv -- \"\${_f}\" '${_contrib}/' || exit 1; done"; then
      _run_as_o8 "rmdir '${_wrap}'" || _pending culturas "wrapper left after flatten" "wrapper not empty after flatten; left for inspection"
    else
      _pending culturas "flatten failed" "flatten failed (layout may have changed); wrapper left intact"
    fi
  else
    _pending culturas "wrapper not found" "expected wrapper ${_wrap##*/} not found; layout may have changed"
  fi
  _ensure_example_sites "${_wd}/web/sites" "${_wd}"
  # Name by the openculturas distribution package (the pinned drupal.org release, e.g. 3.0.3).
  local _dist
  _dist="$(_lock_version "${_wd}" "${_CULTURAS_DISTPKG}")"
  [[ -n "${_dist}" ]] && _dver="${_dist}"
  _finalize_distro "openculturas" "${_wd}" "${_dver}" "culturas"
}

build_commerce() {
  _begin_build "commerce_kickstart-" "commerce" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "commerce"; return 1; }
  local _wd="${_DAY_DIR}/.build.commerce" _dver
  # Built via the -s dev project template, but named by the install profile package
  # (centarro/commerce_kickstart, e.g. 5.1.0) - the template alias (5.x-dev) is irrelevant.
  _dver="$(_create_project "${_wd}" "${_COMMERCE_SPEC}" "centarro/commerce-kickstart-project" "-s dev")" \
    || { _record_fail "commerce"; return 1; }
  if ! { _composer_prepare "${_wd}" \
         && _with_core_fallback "${_wd}" "commerce" _commerce_build; }; then
    _record_fail "commerce"
    return 1
  fi
  local _dist
  _fix_step "${_wd}" "commerce" "${_COMMERCE_DISTPKG}" || return 1
  _dist="$(_lock_version "${_wd}" "${_COMMERCE_DISTPKG}")"
  [[ -n "${_dist}" ]] && _dver="${_dist}"
  _finalize_distro "commerce_kickstart" "${_wd}" "${_dver}" "commerce"
}

build_localgov() {
  _begin_build "localgov-" "localgov" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "localgov"; return 1; }
  local _wd="${_DAY_DIR}/.build.localgov" _dver
  _dver="$(_create_project "${_wd}" "${_LOCALGOV_SPEC}" "drupal/localgov_project" "")" \
    || { _record_fail "localgov"; return 1; }
  if ! { _composer_prepare "${_wd}" && _with_core_fallback "${_wd}" "localgov" _composer_build; }; then
    _record_fail "localgov"
    return 1
  fi
  # Name by the localgov distribution package (drupal.org's number), not the project template.
  local _dist
  _fix_step "${_wd}" "localgov" "${_LOCALGOV_DISTPKG}" || return 1
  _dist="$(_lock_version "${_wd}" "${_LOCALGOV_DISTPKG}")"
  [[ -n "${_dist}" ]] && _dver="${_dist}"
  _finalize_distro "localgov" "${_wd}" "${_dver}" "localgov"
}

build_openfed() {
  _begin_build "openfed-" "openfed" || return 0
  use_php "${_PHP_OPENFED}" || { _record_fail "openfed"; return 1; }
  local _wd="${_DAY_DIR}/.build.openfed" _dver _dist
  _dver="$(_create_project "${_wd}" "${_OPENFED_SPEC}" "openfed/openfed-project" "")" \
    || { _record_fail "openfed"; return 1; }
  # The template's own require is just three composer helpers; the whole
  # distribution (openfed/openfed 13.6.*) arrives through composer-merge-plugin's
  # require of composer.openfed.json, and that file's include list points INSIDE
  # packages the resolve itself installs (webform's + ckeditor_codemirror's
  # composer.libraries.json). Neither layer is visible to a single resolve: the
  # plugin is not on disk after a --no-install create, and the include files are
  # not on disk until the first install lands their packages. The plugin closes
  # that gap itself: the bootstrap install triggers its in-process nested
  # updates, which converge the whole tree - and then upstream's recursive
  # post-update-cmd (`composer install`, their own include-file self-heal) fires
  # against the still-mid-convergence lock and exits 4, so the bootstrap's rc is
  # deliberately tolerated. --no-scripts CANNOT avoid that (measured): plugin
  # event subscribers still run under --no-scripts, and the nested update the
  # plugin dispatches re-enables scripts on its own. The rc-gated resolve+install
  # pair after the bootstrap is the real gate - with everything on disk it
  # writes the complete lock (openfed + the include-file libraries), installs it
  # with no recursion left to trigger, and runs upstream's scaffold scripts.
  # NO _with_core_fallback here, for two reasons: the profile pins its own core
  # minor (core-recommended ~10.6), so there is no older core to fall back to -
  # and the fallback's lock+vendor wipe would remove the merge plugin, making the
  # retry "succeed" into a distribution-less tree. Fail closed instead.
  if ! { _composer_prepare "${_wd}" \
         && { _run_as_o8 "cd '${_wd}' && composer install --no-dev" || true; } \
         && _composer_build "${_wd}"; }; then
    _record_fail "openfed"
    return 1
  fi
  # Fail closed on the tolerated bootstrap: if it died before the merge plugin
  # reached disk, the resolve above quietly locked three helpers and no openfed.
  _fix_step "${_wd}" "openfed" "${_OPENFED_DISTPKG}" || return 1
  _dist="$(_lock_version "${_wd}" "${_OPENFED_DISTPKG}")"
  if [[ -z "${_dist}" ]]; then
    _alrt "openfed: openfed/openfed missing from the lock"
    _record_fail "openfed (no openfed in lock)"
    return 1
  fi
  _finalize_distro "openfed" "${_wd}" "${_dist}" "openfed"
}

build_opigno() {
  _begin_build "opigno_lms-" "opigno" || return 0
  use_php "${_PHP_OPIGNO}" || { _record_fail "opigno"; return 1; }
  local _wd="${_DAY_DIR}/.build.opigno" _dver
  _dver="$(_create_project "${_wd}" "${_OPIGNO_SPEC}" "opigno/opigno-composer" "")" \
    || { _record_fail "opigno"; return 1; }
  # Upstream's template replaces h5p/h5p-core + h5p/h5p-editor without providing either
  # library, so \H5PFrameworkInterface never reaches disk and every install fatals in
  # h5p_install() (opigno_lms #3574405, root cause confirmed in h5p #3549506). Drop the
  # replace block and require the H5P core library explicitly - pinned 1.27.* because
  # 1.28.0 added an interface method drupal/h5p 2.0.0-beta1 does not implement (h5p
  # #3578071; the pin is the community-endorsed workaround and sits inside the module's
  # own ^1.27 constraint).
  # Land drush/drush in require here, on the build box, under the PHP the
  # platform runs on. Upstream keeps it in require-dev, so the --no-dev tarball
  # carried no site-local Drush and provision's lock step ran the same
  # composer require on every box at platform verify -- under the instance's
  # PHP CLI, which may be newer than the lock allows: on an 8.5 CLI the resolve
  # failed and composer-patches had already deleted calendar and h5p, so every
  # site install died on "Required modules not found" (2026-09-17). --update-no-dev
  # keeps require-dev out of the platform (see build_cms).
  if ! { _composer_prepare "${_wd}" \
         && _run_as_o8 "cd '${_wd}' && composer config --unset replace" \
         && _run_as_o8 "cd '${_wd}' && composer require --no-update --no-scripts h5p/h5p-core:'1.27.*'" \
         && _with_core_fallback "${_wd}" "opigno" _composer_build \
         && _run_as_o8 "cd '${_wd}' && composer require drush/drush --no-scripts --update-no-dev"; }; then
    _record_fail "opigno"
    return 1
  fi
  # Twig 3.22+ requires getOperators() to return two arrays; opigno_learning_path
  # returns none, so the first front-page render 500s on a Twig SyntaxError
  # (opigno_learning_path #3561556, RTBC with no release to carry it). Fail closed:
  # an opigno platform without the fix is broken by default.
  _fix_step "${_wd}" "opigno" "${_OPIGNO_DISTPKG}" || return 1
  local _twig_patch_url="https://www.drupal.org/files/issues/2026-02-12/3561556-opigno_learning_path--twig3-getoperators-fix.patch"
  if ! { _run_as_o8 "curl -fsS --retry 3 -o '${_wd}/.twig-3561556.patch' '${_twig_patch_url}'" \
         && _run_as_o8 "cd '${_wd}/web' && patch -p1 --no-backup-if-mismatch < '${_wd}/.twig-3561556.patch'" \
         && _run_as_o8 "rm -f '${_wd}/.twig-3561556.patch'"; }; then
    _alrt "opigno: learning_path issue-3561556 Twig operators patch did not apply"
    _record_fail "opigno (patch failed)"
    return 1
  fi
  _info "opigno: applied opigno_learning_path issue-3561556 Twig operators patch"
  # Name by the distribution profile package from the lock (drupal.org's number).
  local _dist
  _dist="$(_lock_version "${_wd}" "${_OPIGNO_DISTPKG}")"
  [[ -n "${_dist}" ]] && _dver="${_dist}"
  _finalize_distro "opigno_lms" "${_wd}" "${_dver}" "opigno"
}

build_social() {
  _begin_build "social-" "social" || return 0
  # Open Social 13 declares php ^8.3 and AegirSetupC caps SOC at 8.3, so floor and cap are
  # the same number: build on 8.3 rather than the shared _PHP_DISTRO (8.5).
  use_php "${_PHP_SOCIAL}" || { _record_fail "social"; return 1; }
  local _wd="${_DAY_DIR}/.build.social" _dver
  _dver="$(_create_project "${_wd}" "${_SOCIAL_SPEC}" "goalgorilla/social_template" "")" \
    || { _record_fail "social"; return 1; }
  # The chassis template is frozen on the 12.4 line, so move the distribution itself to the
  # current major before resolving; everything else (html/ docroot, scaffold, installer-paths)
  # is upstream's own layout and is left alone.
  # Land drush/drush in require here, on the build box, under the PHP the
  # platform runs on: the chassis template ships none, so the tarball carried no
  # site-local Drush and provision's lock step ran composer require on every
  # box at platform verify -- on an 8.5 PHP CLI the resolve failed
  # (eluceo/ical caps PHP at 8.4) after composer-patches had deleted
  # simple_oauth from the platform (2026-09-17). --update-no-dev keeps require-dev
  # out of the platform (see build_cms).
  if ! { _composer_prepare "${_wd}" \
         && _run_as_o8 "cd '${_wd}' && composer require --no-update --no-scripts ${_SOCIAL_DISTPKG}:'${_SOCIAL_CONSTRAINT}'" \
         && _with_core_fallback "${_wd}" "social" _composer_build \
         && _run_as_o8 "cd '${_wd}' && composer require drush/drush --no-scripts --update-no-dev"; }; then
    _record_fail "social"
    return 1
  fi
  # Name by the distribution package read from the lock, NOT social.info.yml: upstream's
  # 13.0.2 tag still declares version '13.0.1' in that file.
  local _dist
  _fix_step "${_wd}" "social" "${_SOCIAL_DISTPKG}" || return 1
  _dist="$(_lock_version "${_wd}" "${_SOCIAL_DISTPKG}")"
  [[ -n "${_dist}" ]] && _dver="${_dist}"
  _finalize_distro "social" "${_wd}" "${_dver}" "social"
}

