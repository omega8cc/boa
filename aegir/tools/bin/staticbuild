build_varbase() {
  _begin_build "varbase-" "varbase" || return 0
  use_php "${_PHP_VARBASE}" || { _record_fail "varbase"; return 1; }
  local _wd="${_DAY_DIR}/.build.varbase" _dver
  _dver="$(_create_project "${_wd}" "${_VARBASE_SPEC}" "vardot/varbase-project" "")" \
    || { _record_fail "varbase"; return 1; }
  # varbase installs FROM THE SHIPPED LOCK, uniquely among the distros here. The July
  # 2026 template fix IS the committed lock: upstream's tested resolve, including the
  # composer-patches generation their ~76-patch set is written for. A re-resolve
  # (_composer_build's composer update) discards exactly that -- measured 2026-08-11:
  # the fresh resolve pulls a newer patches stack that aborts on their own core patch,
  # and every older-core fallback pin just contradicts the profile's own core
  # requirement. Config stays PRISTINE except allow-plugins (a config-section key):
  # that is the shape upstream tests.
  #
  # The retry loop exists because their patch set is fetched from ~76 URLs at install
  # time and a single flaked download aborts the whole install. CRITICAL: their pinned
  # composer-patches records the ABORTED set as applied, so a retried install in the
  # SAME tree exits 0 with patches silently missing (measured: a core patch absent
  # from an exit-0 tree). Every attempt therefore starts from a fresh create-project
  # (_create_project rm -rf's the workdir) -- on a fresh tree, exit 0 can only mean
  # every patch applied in that one pass, because a patch failure is fatal. The shared
  # composer cache still warms across attempts, which is what lets a later attempt
  # complete. Never "optimise" this to resume a failed tree.
  local _try _vok=""
  for _try in 1 2 3; do
    if [[ "${_try}" != "1" ]]; then
      _alrt "varbase: install attempt failed; rebuilding fresh (attempt ${_try})"
      _dver="$(_create_project "${_wd}" "${_VARBASE_SPEC}" "vardot/varbase-project" "")" \
        || { _record_fail "varbase"; return 1; }
    fi
    if _run_as_o8 "cd '${_wd}' && composer config --no-plugins allow-plugins true" \
      && _run_as_o8 "cd '${_wd}' && composer install --no-dev"; then
      _vok="YES"
      break
    fi
  done
  if [[ "${_vok}" != "YES" ]]; then
    _record_fail "varbase"
    return 1
  fi
  # varbase uses a docroot/ layout and expects a content dir under each recipes/.
  local _cmd="cd \"${_wd}/docroot\" && find . -type d -name recipes -exec mkdir -p {}/default/content \;"
  _run_as_o8 "${_cmd}" || _alrt "varbase: recipes content dir creation failed"
  # Name by the varbase distribution package (drupal.org's number), not the project template.
  local _dist
  _dist="$(_lock_version "${_wd}" "${_VARBASE_DISTPKG}")"
  [[ -n "${_dist}" ]] && _dver="${_dist}"
  _finalize_distro "varbase" "${_wd}" "${_dver}" "varbase"
}

build_cores() {
  # Vanilla core platforms: one per minor, resolved to its latest patch, full install,
  # add drush, run an audit for the record. Named from the detected core version.
  local _minors="${_CORE_MINORS}"
  [[ -n "${_minors}" ]] || _minors="$(_discover_core_minors)"
  if [[ -z "${_minors}" ]]; then
    _record_fail "cores (could not resolve core minors)"
    return 1
  fi
  _msg "core minors: ${_minors}"
  use_php "${_PHP_CORE}" || { _record_fail "cores (php ${_PHP_CORE} missing)"; return 1; }
  local _m _wd="${_DAY_DIR}/.build.core" _core
  for _m in ${_minors}; do
    _begin_build "drupal-${_m}." "drupal-${_m}" || continue
    if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_wd}' && composer create-project ${_CORE_SPEC}:'${_m}.*' '.build.core' ${_CORE_CP_FLAGS}"; then
      _record_fail "drupal-${_m}"
      continue
    fi
    _run_as_o8 "cd '${_wd}' && composer require drush/drush" || _alrt "drupal-${_m}: drush require failed"
    _run_as_o8 "cd '${_wd}' && composer audit" || _alrt "drupal-${_m}: composer audit reported advisories"
    _core="$(_detect_core_version "${_wd}" 2>/dev/null)"
    if [[ -z "${_core}" ]]; then
      _record_fail "drupal-${_m} (could not detect core version)"
      _run_as_o8 "rm -rf '${_wd}'"
      continue
    fi
    if _run_as_o8 "mv '${_wd}' '${_DAY_DIR}/drupal-${_core}'"; then
      _RESULTS+=("OK    drupal-${_core}")
      _info "drupal-${_m}: built drupal-${_core}"
    else
      _record_fail "drupal-${_m} (rename failed)"
    fi
  done
}

build_backdrop() {
  # Backdrop CMS core: a single GitHub release zip (no Composer, no profiles to
  # strip). Packaged VERSIONED like the Drupal cores: backdrop-<ver>/ ->
  # backdrop-<ver>.tar.gz, preserving the top-level core/ layouts/ modules/
  # themes/ sites/ and core/scripts/install.sh, so every published release stays
  # available on the mirror instead of being overwritten by the next one. The
  # resolved version is stamped to backdrop.txt (the newest-version pointer BOA
  # resolves _BACKDROP_V from). Always rebuilt (a fast zip download) - no
  # _begin_build skip. The backdrop-[0-9]* globs never match the
  # backdrop-drush-extension dir.
  if ! command -v unzip >/dev/null 2>&1; then
    _record_fail "backdrop (unzip not found)"
    return 1
  fi
  local _tag _zip _url
  _tag="$(_resolve_backdrop_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "backdrop (could not resolve release tag)"; return 1; }
  # The tag comes from the GitHub API and lands in a root shell command and in
  # file names - accept plain dotted versions only, fail closed on anything else.
  if [[ ! "${_tag}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    _record_fail "backdrop (unexpected release tag format: ${_tag})"
    return 1
  fi
  _zip=".backdrop.zip"
  _url="https://github.com/${_BACKDROP_REPO}/releases/download/${_tag}/backdrop.zip"
  # The zip's top-level dir is backdrop/; rename it to the versioned
  # backdrop-<ver>/ so the tarball extracts like a Drupal core one does.
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf backdrop backdrop-[0-9]* backdrop.tar.gz backdrop.txt '${_zip}' \
    && wget -q -O '${_zip}' '${_url}' && unzip -q '${_zip}' \
    && rm -f '${_zip}' && mv backdrop 'backdrop-${_tag}' \
    && printf '%s\n' '${_tag}' > backdrop.txt"; then
    _record_fail "backdrop"
    return 1
  fi
  # No contrib is baked into the core tree: Valkey/Redis support reaches every
  # platform through the shared o_contrib_backdrop bundle instead (see
  # build_redis_backdrop), the same model the Drupal cores use. The only
  # remaining bake is the version-less compat tarball's, injected at tar time
  # for pre-bundle releases (see package_backdrop_compat).
  _RESULTS+=("OK    backdrop-${_tag}")
  _info "backdrop: built backdrop-${_tag}/"
}

build_grav() {
  # Grav 2: the official ADMIN BUNDLE release zip (no Composer). The zip's
  # top-level dir is grav-admin/; renamed to the versioned grav-<ver>/ so the
  # tarball extracts like the other cores. The RAW zip is kept verbatim
  # alongside for the upgrade channel. grav.txt stamps the newest. Always
  # rebuilt (a fast zip download) - no _begin_build skip.
  if ! command -v unzip >/dev/null 2>&1; then
    _record_fail "grav (unzip not found)"
    return 1
  fi
  local _tag _zip _url
  _tag="$(_resolve_grav_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "grav (could not resolve release tag)"; return 1; }
  # The tag lands in root shell commands and file names - accept plain dotted
  # versions only, fail closed on anything else.
  if [[ ! "${_tag}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    _record_fail "grav (unexpected release tag format: ${_tag})"
    return 1
  fi
  _zip="grav-admin-v${_tag}.zip"
  _url="https://github.com/${_GRAV_REPO}/releases/download/${_tag}/grav-admin-v${_tag}.zip"
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf grav grav-admin grav-[0-9]* grav.tar.gz grav.txt grav-admin-v*.zip \
    && wget -q -O '${_zip}' '${_url}' && unzip -q '${_zip}' \
    && mv grav-admin 'grav-${_tag}' \
    && printf '%s\n' '${_tag}' > grav.txt"; then
    _record_fail "grav"
    return 1
  fi
  _RESULTS+=("OK    grav-${_tag}")
  _info "grav: built grav-${_tag}/ (+ kept ${_zip} for the upgrade shelf)"
}

build_txp() {
  # Textpattern core: the official release .tar.gz (the .zip is deliberately
  # NOT used -- it omits the /sites multisite scaffold). The tarball already
  # extracts to textpattern-<ver>/, so no rename is needed. The published
  # .SHA256SUM is verified before packaging. textpattern.txt stamps the newest.
  local _tag _tgz _url _sum
  _tag="$(_resolve_txp_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "textpattern (could not resolve release tag)"; return 1; }
  # The tag lands in root shell commands and file names - accept plain dotted
  # versions only, fail closed on anything else.
  if [[ ! "${_tag}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    _record_fail "textpattern (unexpected release tag format: ${_tag})"
    return 1
  fi
  _tgz="textpattern-${_tag}.tar.gz"
  _url="https://github.com/${_TXP_REPO}/releases/download/${_tag}"
  _sum="${_tgz}.SHA256SUM"
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf textpattern textpattern-[0-9]* textpattern.tar.gz textpattern.txt \
    && wget -q -O '${_tgz}' '${_url}/${_tgz}' \
    && wget -q -O '${_sum}' '${_url}/${_sum}' \
    && sha256sum -c '${_sum}' \
    && tar -xzf '${_tgz}' \
    && test -d 'textpattern-${_tag}/sites' \
    && rm -f '${_tgz}' '${_sum}' \
    && printf '%s\n' '${_tag}' > textpattern.txt"; then
    _record_fail "textpattern"
    return 1
  fi
  _RESULTS+=("OK    textpattern-${_tag}")
  _info "textpattern: built textpattern-${_tag}/ (checksum verified, /sites present)"
}

build_bee() {
  # Native Backdrop CLI. Packaged version-less as bee.tar.gz with bee.php at the
  # root (what BOA's _get_bee extracts into /opt/tools/bee). Always rebuilt.
  local _tag
  _tag="${_BEE_TAG:-$(_latest_git_tag "${_BEE_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "bee (could not resolve tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .build.bee bee.tar.gz \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_BEE_REPO}.git' .build.bee \
    && rm -rf .build.bee/.git \
    && tar -czf bee.tar.gz -C .build.bee . \
    && rm -rf .build.bee"; then
    _record_fail "bee"
    return 1
  fi
  _RESULTS+=("OK    bee (${_tag})")
  _info "bee: packaged bee.tar.gz (${_tag})"
}

build_bdext() {
  # Backdrop Drush extension. Packaged version-less as
  # backdrop-drush-extension.tar.gz wrapping a backdrop-drush-extension/ dir,
  # PRISTINE - BOA applies the drush_chalk de-hint + the __DIR__ include fix on
  # deploy. Always rebuilt.
  local _tag _d="backdrop-drush-extension"
  _tag="${_BDEXT_TAG:-$(_latest_git_tag "${_BDEXT_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "${_d} (could not resolve tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_d}' '${_d}.tar.gz' \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_BDEXT_REPO}.git' '${_d}' \
    && rm -rf '${_d}/.git' \
    && tar -czf '${_d}.tar.gz' '${_d}' \
    && rm -rf '${_d}'"; then
    _record_fail "${_d}"
    return 1
  fi
  _RESULTS+=("OK    ${_d} (${_tag})")
  _info "${_d}: packaged ${_d}.tar.gz (${_tag})"
}

build_redis_backdrop() {
  # Backdrop redis contrib module for the shared o_contrib_backdrop bundle.
  # Packaged VERSIONED as redis_backdrop-<tag>.tar.gz wrapping a redis_backdrop/
  # dir: the tarball's top-level name IS the deployed directory name under
  # /data/all/000/modules (the _get_dev_contrib contract, like redis_edge and
  # friends). Always rebuilt. The clone stays in a dot-prefixed working dir
  # (like .build.bee) so an interrupted run leaves nothing package_batch's
  # 'ls -d */' can sweep onto the distro shelf. _latest_git_tag only returns
  # N.N.N / N.x-N.N.N shapes, so the tag is safe in file names and the root
  # shell command.
  local _tag
  _tag="${_REDIS_TAG:-$(_latest_git_tag "${_REDIS_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "redis_backdrop (could not resolve tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .build.redis_backdrop redis_backdrop-*.tar.gz \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_REDIS_REPO}.git' .build.redis_backdrop \
    && rm -rf .build.redis_backdrop/.git \
    && tar -czf 'redis_backdrop-${_tag}.tar.gz' --transform 's,^\.build\.redis_backdrop,redis_backdrop,' .build.redis_backdrop \
    && rm -rf .build.redis_backdrop"; then
    _record_fail "redis_backdrop"
    return 1
  fi
  _RESULTS+=("OK    redis_backdrop (${_tag})")
  _info "redis_backdrop: packaged redis_backdrop-${_tag}.tar.gz (${_tag})"
}

build_webform_backdrop() {
  # Plain o_contrib_backdrop bundle member: packaged VERSIONED as
  # webform-<tag>.tar.gz wrapping a webform/ dir (the _get_dev_contrib
  # contract). Same dot-prefixed working-dir discipline as redis_backdrop.
  local _tag
  _tag="${_WEBFORM_B_TAG:-$(_latest_git_tag "${_WEBFORM_B_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "webform_backdrop (could not resolve tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .build.webform_backdrop webform-*.tar.gz \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_WEBFORM_B_REPO}.git' .build.webform_backdrop \
    && rm -rf .build.webform_backdrop/.git \
    && tar -czf 'webform-${_tag}.tar.gz' --transform 's,^\.build\.webform_backdrop,webform,' .build.webform_backdrop \
    && rm -rf .build.webform_backdrop"; then
    _record_fail "webform_backdrop"
    return 1
  fi
  _RESULTS+=("OK    webform_backdrop (${_tag})")
  _info "webform_backdrop: packaged webform-${_tag}.tar.gz (${_tag})"
}

run_build() {
  local _name="$1"
  case "${_name}" in
    farm)     build_farm ;;
    backdrop) build_backdrop ;;
    grav)     build_grav ;;
    txp)      build_txp ;;
    bee)      build_bee ;;
    backdrop-drush-extension) build_bdext ;;
    redis_backdrop) build_redis_backdrop ;;
    webform_backdrop) build_webform_backdrop ;;
    cms)      build_cms ;;
    culturas) build_culturas ;;
    commerce) build_commerce ;;
    localgov) build_localgov ;;
    openfed)  build_openfed ;;
    opigno)   build_opigno ;;
    social)   build_social ;;
    thunder)  build_thunder ;;
    varbase)  build_varbase ;;
    cores)    build_cores ;;
    *)        _alrt "unknown build target: ${_name}"; return 1 ;;
  esac
  return 0
}

do_build() {
  # $@ = target names, or empty for all distros + cores.
  local _targets="$*"
  [[ -n "${_targets}" ]] || _targets="${_ALL_DISTROS} backdrop bee backdrop-drush-extension redis_backdrop webform_backdrop cores"
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  if [[ "${_SKIP_CLEARCACHE}" != "1" ]]; then
    _msg "composer clearcache (${_O8_USER})"
    _run_as_o8 "composer clearcache" || _alrt "composer clearcache failed (continuing)"
  fi
  local _t
  for _t in ${_targets}; do
    _msg ""
    _msg "=== build: ${_t} ==="
    run_build "${_t}"
  done
}

# ---------------------------------------------------------------------------
# Packaging + publishing.
# ---------------------------------------------------------------------------

clean_platforms() {
  # Strip artefacts that must not ship inside any platform tarball. -f/-rf keep
  # non-matching globs harmless; trailing true keeps the compound green.
  _run_as_o8 "cd '${_DAY_DIR}' && \
    rm -f  */*/modules/o_contrib* ; \
    rm -rf */*/sites/all/drush ; \
    rm -f  */*/sites/all/modules/* ; \
    rm -f  */*/sites/sites.php ; \
    rm -f  */*/local_drush_unlocked.pid ; \
    rm -f  */*/sites/all/libraries/*.pid ; \
    true"
}

strip_core_profiles() {
  # Distros bring their own install profile; drop the stock core profiles to slim
  # ONLY the distribution tarballs. Never touch the drupal-* core dirs, so
  # re-running package stays idempotent (cores always keep their profiles).
  local _name _list
  _list="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d */ 2>/dev/null")"
  for _name in ${_list}; do
    _name="${_name%/}"
    case "${_name}" in drupal-*|backdrop-[0-9]*) continue ;; esac
    _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_name}'/*/core/profiles/* ; true"
  done
}

package_batch() {
  # $1 = core | distro. Core = drupal-* dirs (with core/profiles); distro = the rest.
  local _kind="$1" _name _list
  _list="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d */ 2>/dev/null")"
  for _name in ${_list}; do
    _name="${_name%/}"
    case "${_name}" in
      # backdrop-[0-9]* keeps backdrop-drush-extension (a dev extension, never a
      # day-dir build residue unless its build failed mid-way) out of the core arm.
      drupal-*|backdrop-[0-9]*) [[ "${_kind}" == "core" ]]   || continue ;;
      *)                        [[ "${_kind}" == "distro" ]] || continue ;;
    esac
    _msg "tar: ${_name}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf '${_name}.tar.gz' '${_name}'" || _alrt "tar failed: ${_name}"
  done
}

do_package() {
  [[ -n "${_DAY_DIR}" ]] || _die "no build-day directory set"
  _run_as_o8 "test -d '${_DAY_DIR}'" || _die "build-day directory not found: ${_DAY_DIR}"
  _msg "cleaning platform artefacts"
  clean_platforms
  _msg "packaging core platforms (with core/profiles)"
  package_batch core
  package_backdrop_compat
  _msg "stripping stock core profiles from distributions"
  strip_core_profiles
  _msg "packaging distribution platforms (without core/profiles)"
  package_batch distro
}

_ensure_devext_dirs() {
  local _tree
  for _tree in ${_DEV_TREES}; do
    mkdir -p "${_DEVEXT_BASE}/${_tree}" || _die "cannot create ${_DEVEXT_BASE}/${_tree}"
  done
}

_publish_devext() {
  # $1 = tarball path. Every box pulls dev extensions from its own tree dir
  # (_get_dev_ext -> ${_urlDev}/${_tRee}/<file>), so the tarball must exist
  # under dev, lts AND pro - a dev-only publish 404s every lts/pro box.
  local _src="$1" _base _tree _ok=1
  _base="${_src##*/}"
  for _tree in ${_DEV_TREES}; do
    if cp -a "${_src}" "${_DEVEXT_BASE}/${_tree}/"; then
      _msg "devext <- ${_base} (${_tree})"
    else
      _alrt "copy failed: ${_base} (${_tree})"
      _ok=0
    fi
  done
  [[ "${_ok}" == "1" ]]
}

_publish_contrib() {
  # $1 = tarball path. Shared-contrib tarballs are pulled per tree by BOA's
  # _get_dev_contrib (${_urlDev}/${_tRee}/contrib/<file>), so like the dev
  # extensions the tarball must exist under dev, lts AND pro.
  local _src="$1" _base _tree _ok=1
  _base="${_src##*/}"
  for _tree in ${_DEV_TREES}; do
    if ! mkdir -p "${_DEVEXT_BASE}/${_tree}/contrib"; then
      _alrt "cannot create ${_DEVEXT_BASE}/${_tree}/contrib"
      _ok=0
      continue
    fi
    if cp -a "${_src}" "${_DEVEXT_BASE}/${_tree}/contrib/"; then
      _msg "contrib <- ${_base} (${_tree})"
    else
      _alrt "copy failed: ${_base} (${_tree})"
      _ok=0
    fi
  done
  [[ "${_ok}" == "1" ]]
}

_backdrop_day_version() {
  # Version stamped by the current build (empty if none).
  [[ -e "${_DAY_DIR}/backdrop.txt" ]] || return 0
  tr -cd '0-9.' < "${_DAY_DIR}/backdrop.txt"
}

_grav_day_version() {
  # Version stamped by the current Grav build (empty if none).
  [[ -e "${_DAY_DIR}/grav.txt" ]] || return 0
  tr -cd '0-9.' < "${_DAY_DIR}/grav.txt"
}

_txp_day_version() {
  # Version stamped by the current Textpattern build (empty if none).
  [[ -e "${_DAY_DIR}/textpattern.txt" ]] || return 0
  tr -cd '0-9.' < "${_DAY_DIR}/textpattern.txt"
}

package_backdrop_compat() {
  # Version-less backdrop.tar.gz for already-deployed BOA releases, which still
  # fetch that name AND expect it to extract to backdrop/ (the pre-versioning
  # contract). So it is re-tarred from the current backdrop-<ver>/ tree with the
  # top-level dir renamed - NOT a byte copy of the versioned tarball, which
  # extracts to backdrop-<ver>/ and would break their mv of backdrop/.
  #
  # The compat tarball ALONE still carries the baked modules/redis: the /core/
  # shelf is shared by every release, and the pre-bundle releases consuming
  # this name have no o_contrib_backdrop machinery - their global-bd.inc probes
  # only modules/redis, so shipping it clean would build Valkey-less platforms
  # on every not-yet-upgraded box. The module is injected from a dot-dir clone
  # at tar time (never placed in the tree), so the versioned tarballs the
  # bundle-aware releases fetch stay contrib-free.
  local _ver _redis_tag
  _ver="$(_backdrop_day_version)"
  [[ -n "${_ver}" ]] || return 0
  _run_as_o8 "test -d '${_DAY_DIR}/backdrop-${_ver}'" || return 0
  _redis_tag="${_REDIS_TAG:-$(_latest_git_tag "${_REDIS_REPO}")}"
  if [[ -n "${_redis_tag}" ]] && _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .compat.redis \
    && git clone -q --depth 1 --branch '${_redis_tag}' 'https://github.com/${_REDIS_REPO}.git' .compat.redis \
    && rm -rf .compat.redis/.git"; then
    _msg "tar: backdrop.tar.gz (compat, extracts to backdrop/, baked modules/redis ${_redis_tag})"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf backdrop.tar.gz \
      --transform 's,^backdrop-${_ver},backdrop,' \
      --transform 's,^\.compat\.redis,backdrop/modules/redis,' \
      'backdrop-${_ver}' .compat.redis \
      && rm -rf .compat.redis" \
      || _alrt "tar failed: backdrop.tar.gz (compat)"
  else
    _alrt "compat redis clone failed (${_redis_tag:-no tag}); backdrop.tar.gz ships without baked modules/redis this run"
    _msg "tar: backdrop.tar.gz (compat, extracts to backdrop/)"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf backdrop.tar.gz --transform 's,^backdrop-${_ver},backdrop,' 'backdrop-${_ver}'" \
      || _alrt "tar failed: backdrop.tar.gz (compat)"
  fi
}

do_backdrop_family() {
  # Lightweight: build + package + publish ONLY the Backdrop family (backdrop
  # core + bee + backdrop-drush-extension + redis_backdrop + webform_backdrop), all at their
  # newest upstream. No Composer, no distros/cores, no /usr/bin/php switch -
  # just git/wget/unzip. Scoped to the family so it never touches unrelated
  # day-dir content.
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  local _t
  for _t in backdrop bee backdrop-drush-extension redis_backdrop webform_backdrop; do
    _msg ""
    _msg "=== build: ${_t} ==="
    run_build "${_t}"
  done
  # Package the versioned core dir (bee + extension are already tarballs from
  # their build), plus the version-less compat tarball.
  local _ver
  _ver="$(_backdrop_day_version)"
  if [[ -n "${_ver}" ]] && _run_as_o8 "test -d '${_DAY_DIR}/backdrop-${_ver}'"; then
    _msg "tar: backdrop-${_ver}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf 'backdrop-${_ver}.tar.gz' 'backdrop-${_ver}'" \
      || _alrt "tar failed: backdrop-${_ver}"
    package_backdrop_compat
  fi
  # Publish only the family artifacts. Tarballs first, the backdrop.txt stamp
  # last: a consumer must never resolve a version whose tarball is not there yet.
  mkdir -p "${_CORE_OUT}" || _die "cannot create ${_CORE_OUT}"
  _ensure_devext_dirs
  local _f
  if [[ -n "${_ver}" && -e "${_DAY_DIR}/backdrop-${_ver}.tar.gz" ]]; then
    for _f in "backdrop-${_ver}.tar.gz" backdrop.tar.gz backdrop.txt; do
      [[ -e "${_DAY_DIR}/${_f}" ]] || continue
      cp -a "${_DAY_DIR}/${_f}" "${_CORE_OUT}/" && _msg "core   <- ${_f}" || _alrt "copy failed: ${_f}"
    done
  fi
  for _f in bee.tar.gz backdrop-drush-extension.tar.gz; do
    [[ -e "${_DAY_DIR}/${_f}" ]] && _publish_devext "${_DAY_DIR}/${_f}"
  done
  for _f in "${_DAY_DIR}"/redis_backdrop-*.tar.gz "${_DAY_DIR}"/webform-*.tar.gz; do
    [[ -e "${_f}" ]] && _publish_contrib "${_f}"
  done
}

do_grav_family() {
  # Lightweight: build + package + publish ONLY the Grav artefacts (the
  # official admin-bundle release, at its newest upstream). No Composer, no
  # /usr/bin/php switch - just wget/unzip. Publishes the versioned platform
  # tarball, the RAW official zip (upgrade shelf) and the grav.txt stamp
  # LAST: a consumer must never resolve a version whose artefacts are not
  # there yet.
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  _msg ""
  _msg "=== build: grav ==="
  run_build "grav"
  local _ver
  _ver="$(_grav_day_version)"
  if [[ -n "${_ver}" ]] && _run_as_o8 "test -d '${_DAY_DIR}/grav-${_ver}'"; then
    _msg "tar: grav-${_ver}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf 'grav-${_ver}.tar.gz' 'grav-${_ver}'" \
      || _alrt "tar failed: grav-${_ver}"
    _msg "tar: grav.tar.gz (version-less compat)"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf grav.tar.gz --transform 's,^grav-${_ver},grav,' 'grav-${_ver}'" \
      || _alrt "tar failed: grav compat"
  fi
  mkdir -p "${_CORE_OUT}" || _die "cannot create ${_CORE_OUT}"
  local _f
  if [[ -n "${_ver}" && -e "${_DAY_DIR}/grav-${_ver}.tar.gz" ]]; then
    for _f in "grav-${_ver}.tar.gz" grav.tar.gz "grav-admin-v${_ver}.zip" grav.txt; do
      [[ -e "${_DAY_DIR}/${_f}" ]] || continue
      cp -a "${_DAY_DIR}/${_f}" "${_CORE_OUT}/" && _msg "core   <- ${_f}" || _alrt "copy failed: ${_f}"
    done
  fi
}

do_txp_family() {
  # Lightweight: build + package + publish ONLY the Textpattern artefacts, at
  # their newest upstream release. No Composer. Publishes the versioned
  # platform tarball, the version-less compat tarball and the textpattern.txt
  # stamp LAST: a consumer must never resolve a version whose artefacts are
  # not on the mirror yet.
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  _msg ""
  _msg "=== build: textpattern ==="
  run_build "txp"
  local _ver
  _ver="$(_txp_day_version)"
  if [[ -n "${_ver}" ]] && _run_as_o8 "test -d '${_DAY_DIR}/textpattern-${_ver}'"; then
    _msg "tar: textpattern-${_ver}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf 'textpattern-${_ver}.tar.gz' 'textpattern-${_ver}'" \
      || _alrt "tar failed: textpattern-${_ver}"
    # Separate tar invocation with --transform, never a copy: the compat
    # archive must EXTRACT to the unversioned directory name.
    _msg "tar: textpattern.tar.gz (version-less compat)"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf textpattern.tar.gz --transform 's,^textpattern-${_ver},textpattern,' 'textpattern-${_ver}'" \
      || _alrt "tar failed: textpattern compat"
  fi
  mkdir -p "${_CORE_OUT}" || _die "cannot create ${_CORE_OUT}"
  local _f
  if [[ -n "${_ver}" && -e "${_DAY_DIR}/textpattern-${_ver}.tar.gz" ]]; then
    # textpattern.txt LAST in this list on purpose (see the header).
    for _f in "textpattern-${_ver}.tar.gz" textpattern.tar.gz textpattern.txt; do
      [[ -e "${_DAY_DIR}/${_f}" ]] || continue
      cp -a "${_DAY_DIR}/${_f}" "${_CORE_OUT}/" && _msg "core   <- ${_f}" || _alrt "copy failed: ${_f}"
    done
  fi
}

do_distribute() {
  mkdir -p "${_DISTRO_OUT}" "${_CORE_OUT}" \
    || _die "cannot create ${_DISTRO_OUT} / ${_CORE_OUT}"
  _ensure_devext_dirs
  local _t _base _n=0
  for _t in "${_DAY_DIR}"/*.tar.gz; do
    [[ -e "${_t}" ]] || continue
    _base="${_t##*/}"
    # Dev extensions first: backdrop-drush-extension.tar.gz must NOT fall into the
    # backdrop-* core arm. The version-less backdrop.tar.gz is the compat tarball
    # built by package_backdrop_compat (extracts to backdrop/).
    case "${_base}" in
      bee.tar.gz|backdrop-drush-extension.tar.gz)
        _publish_devext "${_t}" && _n=$((_n + 1)) ;;
      redis_backdrop-*.tar.gz|webform-*.tar.gz)
        _publish_contrib "${_t}" && _n=$((_n + 1)) ;;
      drupal-*.tar.gz|backdrop-[0-9]*.tar.gz|backdrop.tar.gz)
        cp -a "${_t}" "${_CORE_OUT}/"   && { _msg "core   <- ${_base}"; _n=$((_n + 1)); } || _alrt "copy failed: ${_base}" ;;
      *)
        cp -a "${_t}" "${_DISTRO_OUT}/" && { _msg "distro <- ${_base}"; _n=$((_n + 1)); } || _alrt "copy failed: ${_base}" ;;
    esac
  done
  # Publish the Backdrop newest-version stamp AFTER the tarballs, and only when
  # the tarball it points to is really on the mirror: BOA resolves _BACKDROP_V
  # from the stamp and fetches the matching backdrop-<ver>.tar.gz, so the stamp
  # must never advance ahead of its tarball.
  local _bdrv
  _bdrv="$(_backdrop_day_version)"
  if [[ -n "${_bdrv}" && -e "${_CORE_OUT}/backdrop-${_bdrv}.tar.gz" ]]; then
    cp -a "${_DAY_DIR}/backdrop.txt" "${_CORE_OUT}/" && _msg "core   <- backdrop.txt" || _alrt "copy failed: backdrop.txt"
  fi
  [[ "${_n}" -gt 0 ]] || _alrt "no tarballs found in ${_DAY_DIR} (run 'package' first)"
}

# ---------------------------------------------------------------------------
# Version check (best-effort; read-only; no root needed).
# ---------------------------------------------------------------------------

_latest_packagist() {
  # Latest stable version from Packagist p2 metadata (array is newest-first).
  local _pkg="$1"
  curl -fsSL -A "${_UA}" "https://repo.packagist.org/p2/${_pkg}.json" 2>/dev/null \
    | grep -oE '"version":"[^"]+"' | head -1 | cut -d'"' -f4
}

_latest_github() {
  local _repo="$1"
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_repo}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_check_row() {
  printf '  %-10s %s\n' "$1" "${2:-n/a}"
}

do_check() {
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed for version check)"
  _info "Latest release per distro from the authoritative source - drupal.org release feed"
  _info "(GitHub for farmOS; commerce_kickstart has no drupal.org stable, so its profile pkg):"
  _check_row "farm"     "$(_latest_github "${_FARM_REPO}")"
  _check_row "backdrop" "$(_latest_github "${_BACKDROP_REPO}")"
  _check_row "bee"      "$(_latest_git_tag "${_BEE_REPO}")"
  _check_row "bd-drush" "$(_latest_git_tag "${_BDEXT_REPO}")"
  # The only pinned Backdrop artifact: a newer tag here means the
  # _REDIS_B_VERSION pins in OCTOPUS.sh.txt + BOA.sh.txt are due a bump.
  _check_row "bd-redis" "$(_latest_git_tag "${_REDIS_REPO}")"
  _check_row "cms"      "$(_drupal_release cms)"
  _check_row "culturas" "$(_drupal_release "${_CULTURAS_PROJECT}")"
  _check_row "commerce" "$(_latest_packagist "${_COMMERCE_DISTPKG}")"
  _check_row "localgov" "$(_drupal_release localgov)"
  _check_row "openfed"  "$(_drupal_release openfed)"
  _check_row "opigno"   "$(_drupal_release opigno_lms)"
  _check_row "social"   "$(_drupal_release social)"
  _check_row "thunder"  "$(_drupal_release thunder)"
  _check_row "varbase"  "$(_drupal_release varbase)"
  _msg ""
  local _minors="${_CORE_MINORS}"
  [[ -n "${_minors}" ]] || _minors="$(_discover_core_minors)"
  _msg "Core minors to build (latest patch of each): ${_minors:-<discovery failed>}"
  _msg "Full supported-core matrix: https://www.drupal.org/project/drupal/releases"
}

# ---------------------------------------------------------------------------
# Catalogue audit.
#
# A catalogue entry whose tarball is not published is not a build failure -- it is
# a silent customer-facing one: the octopus run retries the fetch ten times, nine
# seconds apart, then carries on, so a de-published tarball costs every box a
# minute and a half per codebase generation and shows up only as an OOPS line in
# one customer's console. This is the guard: for every entry the PUBLISHED tree
# still ships, prove the tarball exists.
# ---------------------------------------------------------------------------

_catalogue_producers() {
  # Tarball prefixes an ENABLED target actually emits: walk run_build's live case
  # arms, then read each named function's _finalize_distro prefix. A commented-out
  # arm is deliberately not counted -- a frozen target's tarball stays on the mirror
  # with nothing rebuilding it, and that is exactly the state this audit exists to
  # surface (as it did through the 2026-07/08 varbase freeze).
  local _fn
  for _fn in $(awk '/^run_build\(\)/,/^}/' "$0" \
    | sed -nE 's/^[[:space:]]*[a-z0-9_-]+\)[[:space:]]+(build_[a-z_]+).*/\1/p'); do
    awk -v _f="^${_fn}\\(\\)" '$0 ~ _f,/^}/' "$0" \
      | sed -nE 's/.*_finalize_distro[[:space:]]+"?([a-z_]+)"?.*/\1/p'
  done | sort -u
}

_catalogue_rows() {
  # $1 = tree. Emits "KEY<TAB>prefix<TAB>tarball" for every catalogue entry that is
  # fetched from the distro mirror. The excluded key shapes mirror _d_dist_loop's
  # dispatch in AegirSetupC.sh.txt (core-only D[LXE]N, Backdrop BD*, and the
  # custom CK1/UC* handlers) -- add a class there and it must be added here too.
  local _tree="$1" _tmp _rc=0
  _tmp="$(mktemp -d)" || return 1
  curl -fsSL -A "${_BOA_UA}" \
    "${_BOA_VERSIONS_URL}/${_tree}/boa/aegir/scripts/AegirSetupC.sh.txt" \
    -o "${_tmp}/catalogue" 2>/dev/null || _rc=1
  curl -fsSL -A "${_BOA_UA}" \
    "${_BOA_VERSIONS_URL}/${_tree}/boa/OCTOPUS.sh.txt" \
    -o "${_tmp}/settings" 2>/dev/null || _rc=1
  if [[ "${_rc}" != "0" ]] || [[ ! -s "${_tmp}/catalogue" ]] || [[ ! -s "${_tmp}/settings" ]]; then
    rm -rf "${_tmp}"
    return 1
  fi
  awk -v _octo="${_tmp}/settings" '
    function _resolve(_s,   _k) {
      # One-level ${_NAME} expansion against the published OCTOPUS.sh.txt exports.
      while (match(_s, /\$\{_[A-Za-z0-9_]+\}/)) {
        _k = substr(_s, RSTART + 2, RLENGTH - 3)
        _s = substr(_s, 1, RSTART - 1) (_k in _V ? _V[_k] : "UNRESOLVED") \
             substr(_s, RSTART + RLENGTH)
      }
      return _s
    }
    BEGIN {
      while ((getline _l < _octo) > 0) {
        if (_l ~ /^export _[A-Za-z0-9_]+=/) {
          _eq = index(_l, "=")
          _n = substr(_l, 8, _eq - 8)
          _v = substr(_l, _eq + 1)
          gsub(/^"|"$/, "", _v)
          _V[_n] = _v
        }
      }
    }
    /^declare -A _distros_profiles_names=\(/ { _sec = "prof"; next }
    /^declare -A _distros_versions=\(/       { _sec = "ver";  next }
    /^declare -A _distros_drupal_cores=\(/   { _sec = "core"; next }
    /^\)/                                    { _sec = "";     next }
    _sec != "" && match($0, /\["[A-Z0-9]+"\]="[^"]*"/) {
      split(substr($0, RSTART, RLENGTH), _a, "\"")
      if (_sec == "prof")     _P[_a[2]] = _a[4]
      else if (_sec == "ver") _R[_a[2]] = _a[4]
      else                    _C[_a[2]] = _a[4]
    }
    END {
      for (_k in _P) {
        if (_k ~ /^D[LXE][0-9]$/ || _k ~ /^BD/ || _k ~ /^UC/ || _k == "CK1" || _k == "GRV" || _k == "TXP") continue
        printf "%s\t%s\t%s-%s-%s.tar.gz\n", \
          _k, _P[_k], _P[_k], _resolve(_R[_k]), _resolve(_C[_k])
      }
    }
  ' "${_tmp}/catalogue" | sort
  rm -rf "${_tmp}"
}

do_catalogue() {
  # $@ = trees, or empty for all of _CATALOGUE_TREES.
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed for the catalogue audit)"
  local _trees="$*" _tree _key _pfx _tar _local _pub _prod _rows _seenprod
  local _missing=0 _unread=0
  [[ -n "${_trees}" ]] || _trees="${_CATALOGUE_TREES}"
  _seenprod="$(_catalogue_producers)"
  for _tree in ${_trees}; do
    _msg ""
    _info "=== catalogue audit: ${_tree} ==="
    _rows="$(_catalogue_rows "${_tree}")"
    if [[ -z "${_rows}" ]]; then
      # Distinct from a missing tarball: we learned nothing about this tree, and
      # reporting that as "0 missing" would be the wrong kind of green.
      _alrt "${_tree}: could not read the published catalogue -- audit INCONCLUSIVE"
      _unread=$((_unread + 1))
      continue
    fi
    printf '  %-5s %-46s %-8s %-8s %s\n' KEY TARBALL PUBLISHED MIRROR PRODUCER
    while IFS=$'\t' read -r _key _pfx _tar; do
      [[ -n "${_key}" ]] || continue
      if [[ -f "${_DISTRO_OUT}/${_tar}" ]]; then _local="yes"; else _local="NO"; fi
      # HEAD is enough and costs no transfer: unlike files.boa.io -- which answers
      # an unknown path with 200 and a placeholder page, so content must be checked
      # there -- the distro mirror returns a real 404, so curl's status is decisive.
      if curl -fsSL -A "${_BOA_UA}" --head -o /dev/null \
        "${_BOA_DISTRO_URL}/${_tar}" 2>/dev/null; then _pub="yes"; else _pub="NO"; fi
      if printf '%s\n' "${_seenprod}" | grep -qx "${_pfx}"; then _prod="yes"; else _prod="none"; fi
      printf '  %-5s %-46s %-8s %-8s %s\n' "${_key}" "${_tar}" "${_local}" "${_pub}" "${_prod}"
      # Only the public fetch is customer-facing: a box never reads _DISTRO_OUT.
      if [[ "${_pub}" != "yes" ]]; then
        _missing=$((_missing + 1))
        _alrt "${_tree}: ${_key} is in the catalogue but ${_tar} is NOT published"
      fi
    done <<< "${_rows}"
  done
  _msg ""
  if [[ "${_missing}" -gt 0 ]] && [[ "${_unread}" -gt 0 ]]; then
    _die "${_missing} catalogue entr(ies) have no published tarball, and ${_unread} tree(s) could not be read"
  elif [[ "${_missing}" -gt 0 ]]; then
    _die "${_missing} catalogue entr(ies) have no published tarball -- retire the key in a shipped release, or publish the build, before the tarball goes away"
  elif [[ "${_unread}" -gt 0 ]]; then
    _die "${_unread} tree(s) could not be read -- audit INCONCLUSIVE, nothing was proven"
  fi
  _info "every catalogue entry has a published tarball"
  _msg "PRODUCER=none means the tarball is hand-published: nothing here rebuilds it,"
  _msg "so it can only be kept current by hand. Retiring such a key must happen in a"
  _msg "shipped release BEFORE the tarball is removed from the mirror."
}

# ---------------------------------------------------------------------------
# Summary + dispatch.
# ---------------------------------------------------------------------------

print_summary() {
  [[ "${#_RESULTS[@]}" -gt 0 ]] || return 0
  _msg ""
  _info "=== build summary (${_DAY_DIR}) ==="
  local _r
  for _r in "${_RESULTS[@]}"; do
    _msg "  ${_r}"
  done
}

usage() {
  # Print the leading comment block (from line 3) up to the first non-comment line.
  awk 'NR<3{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
}

main() {
  local _opt
  while getopts ':d:u:fCh' _opt; do
    case "${_opt}" in
      d) _DAY="${OPTARG}" ;;
      u) _O8_USER="${OPTARG}" ;;
      f) _FORCE=1 ;;
      C) _SKIP_CLEARCACHE=1 ;;
      h) usage; exit 0 ;;
      :) _die "option -${OPTARG} requires an argument" ;;
      *) _die "unknown option -${OPTARG} (try -h)" ;;
    esac
  done
  shift "$((OPTIND - 1))"

  local _action="${1:-}"
  [[ -n "${_action}" ]] || { usage; exit 1; }
  shift || true

  # getopts stops at the first non-option word, so options placed after the action
  # are not parsed; reject them rather than misread one as a target name.
  local _a
  for _a in "$@"; do
    [[ "${_a}" == -* ]] && _die "options must precede the action (got '${_a}'); e.g. staticbuild -f ${_action} ..."
  done

  # Recompute derived paths after option parsing.
  _DAY_DIR="${_STATIC_ROOT}/${_O8_USER}/static/${_DAY}"

  case "${_action}" in
    check)
      do_check
      exit 0
      ;;
    catalogue)
      # Read-only audit: no root, no lock, no build user needed.
      do_catalogue "$@"
      exit 0
      ;;
    backdrop)
      # Lightweight Backdrop-family build+package+publish (no Composer, no php
      # switch). Needs root (mirror writes) + an Octopus user (_run_as_o8).
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      do_backdrop_family
      print_summary
      ;;
    grav)
      # Lightweight Grav build+package+publish (official admin bundle; no
      # Composer, no php switch). Needs root + an Octopus user.
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      do_grav_family
      print_summary
      ;;
    txp|textpattern)
      # Lightweight Textpattern build+package+publish (official release
      # tarball; no Composer, no php switch). Needs root + an Octopus user.
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      do_txp_family
      print_summary
      ;;
    build|package|distribute|all)
      _require_root
      _require_o8
      _require_composer
      trap '_cleanup' EXIT
      _acquire_lock
      # /usr/bin/php must be a symlink we can swap and restore. Refuse to clobber a
      # real binary; if it is absent, remember to remove the link we create.
      if [[ -e "${_SYS_PHP}" && ! -L "${_SYS_PHP}" ]]; then
        _die "${_SYS_PHP} exists but is not a symlink; refusing to clobber it"
      fi
      if [[ -L "${_SYS_PHP}" ]]; then
        _PHP_ORIG="$(readlink "${_SYS_PHP}" 2>/dev/null)"
        [[ -n "${_PHP_ORIG}" ]] || _die "cannot read current ${_SYS_PHP} symlink target"
      else
        _PHP_LINK_CREATED=1
      fi
      case "${_action}" in
        build)      do_build "$@" ;;
        package)    do_package ;;
        distribute) do_distribute ;;
        all)        do_build; do_package; do_distribute ;;
      esac
      print_summary
      ;;
    *)
      _die "unknown action '${_action}' (try -h)"
      ;;
  esac
}

main "$@"
