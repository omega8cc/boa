#!/bin/bash
#
# staticbuild - build the newer Drupal core + distribution codebases used for
# BOA testing, package them, and publish the tarballs to the static mirror.
#
# Runs on the mirror SOURCE VM only. Builds happen as the Octopus user (o8) under
# /data/disk/o8/static/<MM-DD>/; packaging + publishing to /var/www/static/{distro,core}
# and the per-build /usr/bin/php switch need root, so run this as root.
#
# Versions are NOT hardcoded. Each distribution is built from its Composer spec (or,
# for farmOS, the latest GitHub release) and each vanilla core from its minor's latest
# patch; the set of core minors is auto-discovered (>= _CORE_FLOOR) so the newest is
# always built. The distro + core versions Composer resolves are detected from the build
# and used in the tarball names. Only the Composer specs and the core floor/exclude in
# the configuration block below are settings to review.
#
# Usage:
#   staticbuild all                 build everything, package, publish
#   staticbuild build [name ...]    build all (or only named) targets
#   staticbuild package             clean + tar (cores keep core/profiles, distros strip)
#   staticbuild distribute          copy tarballs to /var/www/static/{distro,core}
#   staticbuild check               report the latest upstream versions a build would pull
# Options:
#   -d MM-DD   build-day directory (default: today, date +%m-%d)
#   -u USER    Octopus build user (default: o8)
#   -f         force rebuild: remove an existing built platform before building
#   -C         skip "composer clearcache" at the start of a build
# Build target names: farm cms culturas commerce localgov thunder varbase cores

# ---------------------------------------------------------------------------
# Configuration - review the specs/minors each cycle ("staticbuild check").
# ---------------------------------------------------------------------------

_O8_USER="o8"                                   # -u overrides
_DAY="$(date +%m-%d)"                           # -d overrides (MM-DD)

_STATIC_ROOT="/data/disk"                       # o8 home base; static lives under here
_DISTRO_OUT="/var/www/static/distro"            # non-core (distribution) tarballs
_CORE_OUT="/var/www/static/core"                # raw core tarballs

_SYS_PHP="/usr/bin/php"                          # per-build switch target
_PHP_85="/opt/php85/bin/php"
_PHP_84="/opt/php84/bin/php"
_PHP_DISTRO="${_PHP_85}"                         # farm/cms/culturas/commerce/localgov/thunder
_PHP_VARBASE="${_PHP_84}"                        # varbase pins php84
_PHP_CORE="${_PHP_84}"                           # vanilla cores build under php84

# farmOS: the latest GitHub release is resolved automatically; set _FARM_TAG to pin one.
_FARM_REPO="farmOS/farmOS"
_FARM_TAG=""

# Distribution Composer specs (package + optional constraint). The resolved version is
# detected from the build, never hardcoded.
_CMS_SPEC="drupal/cms"
_CULTURAS_SPEC="drupal/openculturas_project"
_COMMERCE_SPEC="centarro/commerce-kickstart-project"
_LOCALGOV_SPEC="drupal/localgov_project:^4"
_THUNDER_SPEC="thunder/thunder-project"
_VARBASE_SPEC="Vardot/varbase-project:~10"
_CORE_SPEC="drupal/recommended-project"

# Vanilla core minors to build. Empty (default) = auto-discover every released minor
# >= _CORE_FLOOR, minus _CORE_EXCLUDE, so the newest minor is always built without
# editing this file. Set an explicit space-separated list to pin a fixed matrix.
_CORE_MINORS=""
_CORE_FLOOR="10.2"                               # oldest minor to build when auto-discovering
_CORE_EXCLUDE="11.0"                             # minors to skip (short-lived/EOL), space-separated

# Shared Composer flags. Distros stage the codebase without installing; vanilla cores
# install immediately (they carry no post-create fix-ups).
_CP_FLAGS="--no-dev --no-interaction --no-install --no-scripts"
_CORE_CP_FLAGS="--no-dev --no-interaction"

_ALL_DISTROS="farm cms culturas commerce localgov thunder varbase"

_LOCK="/run/staticbuild.lock"
_UA="staticbuild version-check"

# Runtime state.
_DAY_DIR=""
_PHP_ORIG=""
_PHP_LINK_CREATED=0
_FORCE=0
_SKIP_CLEARCACHE=0
_LOCK_HELD=0
_RESULTS=()

# ---------------------------------------------------------------------------
# Output helpers.
# ---------------------------------------------------------------------------

_msg()  { printf '%s\n' "$*"; }
_info() { printf '\033[0;32m%s\033[0m\n' "$*"; }
_alrt() { printf '\033[0;33m%s\033[0m\n' "$*" >&2; }
_die()  { printf '\033[0;31mFATAL ERROR: %s\033[0m\n' "$*" >&2; _cleanup; exit 1; }

_cleanup() {
  # Restore the original /usr/bin/php symlink and release the lock. Safe to call
  # more than once (trap on EXIT plus _die).
  if [[ -n "${_PHP_ORIG}" ]]; then
    ln -sf "${_PHP_ORIG}" "${_SYS_PHP}" 2>/dev/null
    _PHP_ORIG=""
  elif [[ "${_PHP_LINK_CREATED}" == "1" ]]; then
    rm -f "${_SYS_PHP}" 2>/dev/null
    _PHP_LINK_CREATED=0
  fi
  if [[ "${_LOCK_HELD}" == "1" ]]; then
    rmdir "${_LOCK}" 2>/dev/null
    _LOCK_HELD=0
  fi
}

# ---------------------------------------------------------------------------
# Privilege + environment helpers.
# ---------------------------------------------------------------------------

_run_as_o8() {
  # Run a single shell command as the Octopus build user. Returns its exit code.
  su -s /bin/bash - "${_O8_USER}" -c "$1"
}

use_php() {
  # Point /usr/bin/php at the requested interpreter for the next build. Non-fatal:
  # a missing interpreter fails one target (the caller records it), not the batch.
  local _bin="$1"
  if [[ ! -x "${_bin}" ]]; then
    _alrt "php interpreter not found: ${_bin}"
    return 1
  fi
  if ! ln -sf "${_bin}" "${_SYS_PHP}"; then
    _alrt "cannot set ${_SYS_PHP} -> ${_bin}"
    return 1
  fi
  _msg "php: ${_SYS_PHP} -> ${_bin}"
}

_acquire_lock() {
  if ! mkdir "${_LOCK}" 2>/dev/null; then
    _die "another staticbuild run holds ${_LOCK} (remove it if stale)"
  fi
  _LOCK_HELD=1
}

_require_root() {
  [[ "$(id -u)" == "0" ]] || _die "must run as root (needs ${_SYS_PHP} switch + ${_DISTRO_OUT%/*} writes)"
}

_require_o8() {
  id -u "${_O8_USER}" >/dev/null 2>&1 || _die "build user '${_O8_USER}' does not exist"
  _run_as_o8 "command -v composer >/dev/null 2>&1" || _die "composer not available for ${_O8_USER}"
  command -v wget >/dev/null 2>&1 || _die "wget not found (needed for farmOS release download)"
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed to resolve latest versions)"
}

# ---------------------------------------------------------------------------
# Build primitives.
# ---------------------------------------------------------------------------

_begin_build() {
  # 0 = proceed, 1 = skip/handled. $1 = glob prefix of the final platform name
  # (e.g. "localgov-" or "drupal-10.2."), $2 = result label. Skips if a matching
  # platform already exists; with -f, removes it first and rebuilds.
  local _gp="$1" _label="$2"
  if _run_as_o8 "ls -d ${_DAY_DIR}/${_gp}*/ ${_DAY_DIR}/${_gp}*.tar.gz 2>/dev/null | grep -q ."; then
    if [[ "${_FORCE}" == "1" ]]; then
      _msg "REBUILD: removing existing ${_gp}*"
      _run_as_o8 "rm -rf ${_DAY_DIR}/${_gp}*/ ${_DAY_DIR}/${_gp}*.tar.gz" \
        || { _record_fail "${_label}"; return 1; }
    else
      _msg "SKIP: ${_gp}* already built (use -f to rebuild)"
      _RESULTS+=("SKIP  ${_label}")
      return 1
    fi
  fi
  return 0
}

_create_project() {
  # Create a distribution project into a hidden working dir and echo the version
  # Composer resolved for it. $1 workdir (abs, hidden), $2 spec (pkg[:constraint]),
  # $3 package name for the version parse, $4 extra create-project options (may be empty).
  # Returns non-zero on create-project failure.
  local _wd="$1" _spec="$2" _pkg="$3" _extra="$4" _out _rc _ver
  _run_as_o8 "rm -rf '${_wd}'" >/dev/null 2>&1
  _out="$(_run_as_o8 "cd '${_DAY_DIR}' && composer create-project ${_extra} ${_spec} '${_wd##*/}' ${_CP_FLAGS} 2>&1")"
  _rc=$?
  if [[ "${_rc}" != "0" ]]; then
    printf '%s\n' "${_out}" | tail -n 20 >&2
    return 1
  fi
  # "Installing <pkg> (<version> [<ref>])" - keep only the first whitespace-free token of
  # the parenthetical (a dev-branch line is "<branch> <commit>"; drop the commit), strip v.
  _ver="$(printf '%s\n' "${_out}" | grep -oiE "${_pkg} \([^)]+\)" | head -n 1 | sed -E 's/.*\(([^) ]+).*/\1/; s/^v//')"
  printf '%s\n' "${_ver}"
  return 0
}

_composer_prepare() {
  # Two allow-plugins lines shared by every create-project distro.
  local _dir="$1"
  _run_as_o8 "cd '${_dir}' && composer config --no-plugins allow-plugins.symfony/runtime true" || return 1
  _run_as_o8 "cd '${_dir}' && composer config --no-plugins allow-plugins.drupal/core-composer-scaffold true" || return 1
}

_composer_build() {
  # Resolve then install without dev dependencies.
  local _dir="$1"
  _run_as_o8 "cd '${_dir}' && composer update --no-install --no-scripts" || return 1
  _run_as_o8 "cd '${_dir}' && composer install --no-dev" || return 1
}

_detect_core_version() {
  # Echo the resolved Drupal core version from a built platform, probing the three
  # known docroot layouts. Empty output + non-zero on failure.
  local _dir="$1" _rel
  for _rel in web/core/lib/Drupal.php docroot/core/lib/Drupal.php core/lib/Drupal.php; do
    if _run_as_o8 "test -f '${_dir}/${_rel}'" >/dev/null 2>&1; then
      _run_as_o8 "awk -F\"'\" '/const VERSION =/{print \$2; exit}' '${_dir}/${_rel}'" 2>/dev/null \
        | grep -m1 -oE '[0-9]+\.[0-9]+\.[0-9A-Za-z.-]+'
      return 0
    fi
  done
  return 1
}

_record_fail() {
  _RESULTS+=("FAIL  $1")
  _alrt "$1: build failed"
}

_finalize_distro() {
  # Rename the working dir to <nameprefix>-<distroVer>-<coreVer> using the detected
  # versions, then record the result. $1 name prefix, $2 workdir, $3 distro version,
  # $4 result label.
  local _np="$1" _wd="$2" _dver="$3" _label="$4" _core _final
  _core="$(_detect_core_version "${_wd}" 2>/dev/null)"
  # Never allow whitespace into a platform name (a dev-branch alias could carry it).
  _dver="${_dver//[[:space:]]/}"
  _core="${_core//[[:space:]]/}"
  if [[ -z "${_dver}" ]]; then _dver="unknown"; _alrt "${_label}: could not detect distro version"; fi
  if [[ -z "${_core}" ]]; then _core="unknown"; _alrt "${_label}: could not detect core version"; fi
  _final="${_np}-${_dver}-${_core}"
  if _run_as_o8 "mv '${_wd}' '${_DAY_DIR}/${_final}'"; then
    _RESULTS+=("OK    ${_final}")
    _info "${_label}: built ${_final}"
  else
    _record_fail "${_label} (rename to ${_final} failed)"
    return 1
  fi
}

_ensure_example_sites() {
  # openculturas ships without a stock example.sites.php; source it from the
  # platform's own core scaffold asset (present regardless of build order), then
  # fall back to any sibling platform already built in the day dir.
  local _sitesdir="$1" _dir="$2" _src="" _rel
  if _run_as_o8 "test -f '${_sitesdir}/example.sites.php'"; then
    return 0
  fi
  for _rel in web/core/assets/scaffold/files/example.sites.php \
              docroot/core/assets/scaffold/files/example.sites.php; do
    if _run_as_o8 "test -f '${_dir}/${_rel}'"; then
      _src="${_dir}/${_rel}"
      break
    fi
  done
  if [[ -z "${_src}" ]]; then
    _src="$(_run_as_o8 "ls ${_DAY_DIR}/*/web/sites/example.sites.php ${_DAY_DIR}/*/docroot/sites/example.sites.php 2>/dev/null | head -1")"
  fi
  if [[ -n "${_src}" ]]; then
    _run_as_o8 "cp -a '${_src}' '${_sitesdir}/'" || _alrt "culturas: could not copy example.sites.php"
  else
    _alrt "culturas: no example.sites.php source found; skipping"
  fi
}

_resolve_farm_tag() {
  # Latest farmOS release tag, or the pinned _FARM_TAG.
  if [[ -n "${_FARM_TAG}" ]]; then
    printf '%s\n' "${_FARM_TAG}"
    return 0
  fi
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_FARM_REPO}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -n 1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_minor_ge() {
  # 0 if $1 >= $2, comparing major.minor numerically.
  local _a1="${1%.*}" _a2="${1#*.}" _b1="${2%.*}" _b2="${2#*.}"
  if (( _a1 > _b1 )); then return 0; fi
  if (( _a1 < _b1 )); then return 1; fi
  (( _a2 >= _b2 ))
}

_discover_core_minors() {
  # Echo the drupal core minors to build: every released major.minor >= _CORE_FLOOR,
  # minus _CORE_EXCLUDE, ascending. Empty output if the metadata cannot be fetched.
  local _raw _m _out=""
  _raw="$(curl -fsSL -A "${_UA}" "https://repo.packagist.org/p2/drupal/core.json" 2>/dev/null \
    | grep -oE '"version":"[0-9]+\.[0-9]+\.[0-9]+"' \
    | sed -E 's/.*"([0-9]+)\.([0-9]+)\..*/\1.\2/' \
    | sort -u -t. -k1,1n -k2,2n)"
  while read -r _m; do
    [[ -n "${_m}" ]] || continue
    _minor_ge "${_m}" "${_CORE_FLOOR}" || continue
    case " ${_CORE_EXCLUDE} " in *" ${_m} "*) continue ;; esac
    _out+="${_m} "
  done <<< "${_raw}"
  printf '%s\n' "${_out% }"
}

# ---------------------------------------------------------------------------
# Per-distribution builds. Each records its own OK/FAIL/SKIP result.
# ---------------------------------------------------------------------------

build_farm() {
  _begin_build "farm-" "farm" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "farm"; return 1; }
  local _tag
  _tag="$(_resolve_farm_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "farm (could not resolve release tag)"; return 1; }
  local _wd="${_DAY_DIR}/.build.farm"
  local _tgz=".farmOS-${_tag}.tar.gz"
  local _url="https://github.com/${_FARM_REPO}/releases/download/${_tag}/farmOS-${_tag}.tar.gz"
  # Extract straight into the hidden working dir (--strip-components drops the release's
  # top-level farmOS/), with a hidden download name, so an interrupted farm build never
  # leaves a visible farmOS/ or farmOS-*.tar.gz that package/distribute would ship.
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_wd}' farmOS .farmOS-*.tar.gz && mkdir -p '${_wd}' && wget -q -O '${_tgz}' '${_url}' && tar -xzf '${_tgz}' --strip-components=1 -C '${_wd}' && rm -f '${_tgz}'"; then
    _record_fail "farm"
    return 1
  fi
  if ! { _composer_prepare "${_wd}" && _composer_build "${_wd}"; }; then
    _record_fail "farm"
    return 1
  fi
  _finalize_distro "farm" "${_wd}" "${_tag}" "farm"
}

build_cms() {
  _begin_build "drupal_cms_installer-" "cms" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "cms"; return 1; }
  local _wd="${_DAY_DIR}/.build.cms" _dver
  _dver="$(_create_project "${_wd}" "${_CMS_SPEC}" "drupal/cms" "")" || { _record_fail "cms"; return 1; }
  if ! { _composer_prepare "${_wd}" \
         && _composer_build "${_wd}" \
         && _run_as_o8 "cd '${_wd}' && composer require drush/drush"; }; then
    _record_fail "cms"
    return 1
  fi
  _finalize_distro "drupal_cms_installer" "${_wd}" "${_dver}" "cms"
}

build_culturas() {
  _begin_build "openculturas-" "culturas" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "culturas"; return 1; }
  local _wd="${_DAY_DIR}/.build.culturas" _dver
  _dver="$(_create_project "${_wd}" "${_CULTURAS_SPEC}" "drupal/openculturas_project" "--remove-vcs")" \
    || { _record_fail "culturas"; return 1; }
  if ! { _composer_prepare "${_wd}" && _composer_build "${_wd}"; }; then
    _record_fail "culturas"
    return 1
  fi
  # Flatten the openculturas-distribution wrapper: its inner profile/ becomes the
  # openculturas install profile, and its remaining contents move up into contrib/.
  local _contrib="${_wd}/web/profiles/contrib"
  local _wrap="${_contrib}/openculturas-distribution"
  if _run_as_o8 "test -d '${_wrap}'"; then
    # All required moves must succeed before the wrapper is removed; dotglob so
    # hidden files move too, and rmdir (not rm -rf) so a layout drift can never
    # delete unmoved contents.
    if _run_as_o8 "cd '${_wrap}' && mv profile openculturas && mv openculturas '${_contrib}/' && shopt -s dotglob nullglob && for _f in *; do mv -- \"\${_f}\" '${_contrib}/' || exit 1; done"; then
      _run_as_o8 "rmdir '${_wrap}'" || _alrt "culturas: wrapper not empty after flatten; left for inspection"
    else
      _alrt "culturas: flatten failed (layout may have changed); wrapper left intact"
    fi
  else
    _alrt "culturas: expected wrapper ${_wrap##*/} not found; layout may have changed"
  fi
  _ensure_example_sites "${_wd}/web/sites" "${_wd}"
  _finalize_distro "openculturas" "${_wd}" "${_dver}" "culturas"
}

build_commerce() {
  _begin_build "commerce_kickstart-" "commerce" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "commerce"; return 1; }
  local _wd="${_DAY_DIR}/.build.commerce" _dver
  # Commerce Kickstart is built from its dev branch (-s dev), so the detected version is a
  # branch alias (e.g. 5.x-dev), not a release tag - reflected in the tarball name.
  _dver="$(_create_project "${_wd}" "${_COMMERCE_SPEC}" "centarro/commerce-kickstart-project" "-s dev")" \
    || { _record_fail "commerce"; return 1; }
  # Commerce Kickstart: install, then add the certified-projects layer and
  # re-resolve/install.
  if ! { _composer_prepare "${_wd}" \
         && _run_as_o8 "cd '${_wd}' && composer install --no-dev" \
         && _run_as_o8 "cd '${_wd}' && composer require centarro/certified-projects" \
         && _run_as_o8 "cd '${_wd}' && composer update --no-install --no-scripts" \
         && _run_as_o8 "cd '${_wd}' && composer install --no-dev"; }; then
    _record_fail "commerce"
    return 1
  fi
  _finalize_distro "commerce_kickstart" "${_wd}" "${_dver}" "commerce"
}

build_localgov() {
  _begin_build "localgov-" "localgov" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "localgov"; return 1; }
  local _wd="${_DAY_DIR}/.build.localgov" _dver
  _dver="$(_create_project "${_wd}" "${_LOCALGOV_SPEC}" "drupal/localgov_project" "")" \
    || { _record_fail "localgov"; return 1; }
  if ! { _composer_prepare "${_wd}" && _composer_build "${_wd}"; }; then
    _record_fail "localgov"
    return 1
  fi
  _finalize_distro "localgov" "${_wd}" "${_dver}" "localgov"
}

build_thunder() {
  _begin_build "thunder-" "thunder" || return 0
  use_php "${_PHP_DISTRO}" || { _record_fail "thunder"; return 1; }
  local _wd="${_DAY_DIR}/.build.thunder" _dver
  _dver="$(_create_project "${_wd}" "${_THUNDER_SPEC}" "thunder/thunder-project" "")" \
    || { _record_fail "thunder"; return 1; }
  if ! { _composer_prepare "${_wd}" && _composer_build "${_wd}"; }; then
    _record_fail "thunder"
    return 1
  fi
  _finalize_distro "thunder" "${_wd}" "${_dver}" "thunder"
}

build_varbase() {
  _begin_build "varbase-" "varbase" || return 0
  use_php "${_PHP_VARBASE}" || { _record_fail "varbase"; return 1; }
  local _wd="${_DAY_DIR}/.build.varbase" _dver
  _dver="$(_create_project "${_wd}" "${_VARBASE_SPEC}" "vardot/varbase-project" "")" \
    || { _record_fail "varbase"; return 1; }
  if ! { _composer_prepare "${_wd}" && _composer_build "${_wd}"; }; then
    _record_fail "varbase"
    return 1
  fi
  # varbase uses a docroot/ layout and expects a content dir under each recipes/.
  local _cmd="cd \"${_wd}/docroot\" && find . -type d -name recipes -exec mkdir -p {}/default/content \;"
  _run_as_o8 "${_cmd}" || _alrt "varbase: recipes content dir creation failed"
  _finalize_distro "varbase" "${_wd}" "${_dver}" "varbase"
}

build_cores() {
  # Vanilla core platforms: one per minor, resolved to its latest patch, full install,
  # add drush, run an audit for the record. Named from the detected core version.
  local _minors="${_CORE_MINORS}"
  [[ -n "${_minors}" ]] || _minors="$(_discover_core_minors)"
  if [[ -z "${_minors}" ]]; then
    _record_fail "cores (could not resolve core minors)"
    return 1
  fi
  _msg "core minors: ${_minors}"
  use_php "${_PHP_CORE}" || { _record_fail "cores (php ${_PHP_CORE} missing)"; return 1; }
  local _m _wd="${_DAY_DIR}/.build.core" _core
  for _m in ${_minors}; do
    _begin_build "drupal-${_m}." "drupal-${_m}" || continue
    if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_wd}' && composer create-project ${_CORE_SPEC}:'${_m}.*' '.build.core' ${_CORE_CP_FLAGS}"; then
      _record_fail "drupal-${_m}"
      continue
    fi
    _run_as_o8 "cd '${_wd}' && composer require drush/drush" || _alrt "drupal-${_m}: drush require failed"
    _run_as_o8 "cd '${_wd}' && composer audit" || _alrt "drupal-${_m}: composer audit reported advisories"
    _core="$(_detect_core_version "${_wd}" 2>/dev/null)"
    if [[ -z "${_core}" ]]; then
      _record_fail "drupal-${_m} (could not detect core version)"
      _run_as_o8 "rm -rf '${_wd}'"
      continue
    fi
    if _run_as_o8 "mv '${_wd}' '${_DAY_DIR}/drupal-${_core}'"; then
      _RESULTS+=("OK    drupal-${_core}")
      _info "drupal-${_m}: built drupal-${_core}"
    else
      _record_fail "drupal-${_m} (rename failed)"
    fi
  done
}

run_build() {
  local _name="$1"
  case "${_name}" in
    farm)     build_farm ;;
    cms)      build_cms ;;
    culturas) build_culturas ;;
    commerce) build_commerce ;;
    localgov) build_localgov ;;
    thunder)  build_thunder ;;
    varbase)  build_varbase ;;
    cores)    build_cores ;;
    *)        _alrt "unknown build target: ${_name}"; return 1 ;;
  esac
  return 0
}

do_build() {
  # $@ = target names, or empty for all distros + cores.
  local _targets="$*"
  [[ -n "${_targets}" ]] || _targets="${_ALL_DISTROS} cores"
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  if [[ "${_SKIP_CLEARCACHE}" != "1" ]]; then
    _msg "composer clearcache (${_O8_USER})"
    _run_as_o8 "composer clearcache" || _alrt "composer clearcache failed (continuing)"
  fi
  local _t
  for _t in ${_targets}; do
    _msg ""
    _msg "=== build: ${_t} ==="
    run_build "${_t}"
  done
}

# ---------------------------------------------------------------------------
# Packaging + publishing.
# ---------------------------------------------------------------------------

clean_platforms() {
  # Strip artefacts that must not ship inside any platform tarball. -f/-rf keep
  # non-matching globs harmless; trailing true keeps the compound green.
  _run_as_o8 "cd '${_DAY_DIR}' && \
    rm -f  */*/modules/o_contrib* ; \
    rm -rf */*/sites/all/drush ; \
    rm -f  */*/sites/all/modules/* ; \
    rm -f  */*/sites/sites.php ; \
    rm -f  */*/local_drush_unlocked.pid ; \
    rm -f  */*/sites/development.services.yml ; \
    rm -f  */*/sites/all/libraries/*.pid ; \
    true"
}

strip_core_profiles() {
  # Distros bring their own install profile; drop the stock core profiles to slim
  # ONLY the distribution tarballs. Never touch the drupal-* core dirs, so
  # re-running package stays idempotent (cores always keep their profiles).
  local _name _list
  _list="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d */ 2>/dev/null")"
  for _name in ${_list}; do
    _name="${_name%/}"
    case "${_name}" in drupal-*) continue ;; esac
    _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_name}'/*/core/profiles/* ; true"
  done
}

package_batch() {
  # $1 = core | distro. Core = drupal-* dirs (with core/profiles); distro = the rest.
  local _kind="$1" _name _list
  _list="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d */ 2>/dev/null")"
  for _name in ${_list}; do
    _name="${_name%/}"
    case "${_name}" in
      drupal-*) [[ "${_kind}" == "core" ]]   || continue ;;
      *)        [[ "${_kind}" == "distro" ]] || continue ;;
    esac
    _msg "tar: ${_name}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf '${_name}.tar.gz' '${_name}'" || _alrt "tar failed: ${_name}"
  done
}

do_package() {
  [[ -n "${_DAY_DIR}" ]] || _die "no build-day directory set"
  _run_as_o8 "test -d '${_DAY_DIR}'" || _die "build-day directory not found: ${_DAY_DIR}"
  _msg "cleaning platform artefacts"
  clean_platforms
  _msg "packaging core platforms (with core/profiles)"
  package_batch core
  _msg "stripping stock core profiles from distributions"
  strip_core_profiles
  _msg "packaging distribution platforms (without core/profiles)"
  package_batch distro
}

do_distribute() {
  mkdir -p "${_DISTRO_OUT}" "${_CORE_OUT}" || _die "cannot create ${_DISTRO_OUT} / ${_CORE_OUT}"
  local _t _base _n=0
  for _t in "${_DAY_DIR}"/*.tar.gz; do
    [[ -e "${_t}" ]] || continue
    _base="${_t##*/}"
    case "${_base}" in
      drupal-*.tar.gz)
        cp -a "${_t}" "${_CORE_OUT}/"   && { _msg "core   <- ${_base}"; _n=$((_n + 1)); } || _alrt "copy failed: ${_base}" ;;
      *)
        cp -a "${_t}" "${_DISTRO_OUT}/" && { _msg "distro <- ${_base}"; _n=$((_n + 1)); } || _alrt "copy failed: ${_base}" ;;
    esac
  done
  [[ "${_n}" -gt 0 ]] || _alrt "no tarballs found in ${_DAY_DIR} (run 'package' first)"
}

# ---------------------------------------------------------------------------
# Version check (best-effort; read-only; no root needed).
# ---------------------------------------------------------------------------

_latest_packagist() {
  # Latest stable version from Packagist p2 metadata (array is newest-first).
  local _pkg="$1"
  curl -fsSL -A "${_UA}" "https://repo.packagist.org/p2/${_pkg}.json" 2>/dev/null \
    | grep -oE '"version":"[^"]+"' | head -1 | cut -d'"' -f4
}

_latest_github() {
  local _repo="$1"
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_repo}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_check_row() {
  printf '  %-10s %s\n' "$1" "${2:-n/a}"
}

do_check() {
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed for version check)"
  _info "Latest upstream versions a build would resolve:"
  _check_row "farm"     "$(_latest_github "${_FARM_REPO}")"
  _check_row "cms"      "$(_latest_packagist drupal/cms)"
  _check_row "culturas" "$(_latest_packagist drupal/openculturas_project)"
  _check_row "commerce" "$(_latest_packagist centarro/commerce-kickstart-project)"
  _check_row "localgov" "$(_latest_packagist drupal/localgov_project)"
  _check_row "thunder"  "$(_latest_packagist thunder/thunder-project)"
  _check_row "varbase"  "$(_latest_packagist vardot/varbase-project)"
  _check_row "core"     "$(_latest_packagist drupal/recommended-project)"
  _msg ""
  local _minors="${_CORE_MINORS}"
  [[ -n "${_minors}" ]] || _minors="$(_discover_core_minors)"
  _msg "Core minors to build (latest patch of each): ${_minors:-<discovery failed>}"
  _msg "Full supported-core matrix: https://www.drupal.org/project/drupal/releases"
}

# ---------------------------------------------------------------------------
# Summary + dispatch.
# ---------------------------------------------------------------------------

print_summary() {
  [[ "${#_RESULTS[@]}" -gt 0 ]] || return 0
  _msg ""
  _info "=== build summary (${_DAY_DIR}) ==="
  local _r
  for _r in "${_RESULTS[@]}"; do
    _msg "  ${_r}"
  done
}

usage() {
  # Print the leading comment block (from line 3) up to the first non-comment line.
  awk 'NR<3{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
}

main() {
  local _opt
  while getopts ':d:u:fCh' _opt; do
    case "${_opt}" in
      d) _DAY="${OPTARG}" ;;
      u) _O8_USER="${OPTARG}" ;;
      f) _FORCE=1 ;;
      C) _SKIP_CLEARCACHE=1 ;;
      h) usage; exit 0 ;;
      :) _die "option -${OPTARG} requires an argument" ;;
      *) _die "unknown option -${OPTARG} (try -h)" ;;
    esac
  done
  shift "$((OPTIND - 1))"

  local _action="${1:-}"
  [[ -n "${_action}" ]] || { usage; exit 1; }
  shift || true

  # getopts stops at the first non-option word, so options placed after the action
  # are not parsed; reject them rather than misread one as a target name.
  local _a
  for _a in "$@"; do
    [[ "${_a}" == -* ]] && _die "options must precede the action (got '${_a}'); e.g. staticbuild -f ${_action} ..."
  done

  # Recompute derived paths after option parsing.
  _DAY_DIR="${_STATIC_ROOT}/${_O8_USER}/static/${_DAY}"

  case "${_action}" in
    check)
      do_check
      exit 0
      ;;
    build|package|distribute|all)
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      # /usr/bin/php must be a symlink we can swap and restore. Refuse to clobber a
      # real binary; if it is absent, remember to remove the link we create.
      if [[ -e "${_SYS_PHP}" && ! -L "${_SYS_PHP}" ]]; then
        _die "${_SYS_PHP} exists but is not a symlink; refusing to clobber it"
      fi
      if [[ -L "${_SYS_PHP}" ]]; then
        _PHP_ORIG="$(readlink "${_SYS_PHP}" 2>/dev/null)"
        [[ -n "${_PHP_ORIG}" ]] || _die "cannot read current ${_SYS_PHP} symlink target"
      else
        _PHP_LINK_CREATED=1
      fi
      case "${_action}" in
        build)      do_build "$@" ;;
        package)    do_package ;;
        distribute) do_distribute ;;
        all)        do_build; do_package; do_distribute ;;
      esac
      print_summary
      ;;
    *)
      _die "unknown action '${_action}' (try -h)"
      ;;
  esac
}

main "$@"
