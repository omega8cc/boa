build_cores() {
  # Vanilla core platforms: one per minor, resolved to its latest patch, full install,
  # add drush, audit for the record (never fatal). Named from the detected core version.
  local _minors="${_CORE_MINORS}"
  [[ -n "${_minors}" ]] || _minors="$(_discover_core_minors)"
  if [[ -z "${_minors}" ]]; then
    _record_fail "cores (no core minors)"
    return 1
  fi
  _msg "core minors: ${_minors}"
  use_php "${_PHP_CORE}" || { _record_fail "cores (php ${_PHP_CORE} missing)"; return 1; }
  local _m _wd="${_DAY_DIR}/.build.core" _core
  for _m in ${_minors}; do
    _tail_mark
    _begin_build "drupal-${_m}." "drupal-${_m}" || continue
    if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_wd}' && composer create-project ${_CORE_SPEC}:'${_m}.*' '.build.core' ${_CORE_CP_FLAGS}"; then
      _record_fail "drupal-${_m}"
      continue
    fi
    local _nodrush=""
    _run_as_o8 "cd '${_wd}' && composer require drush/drush" || { _alrt "drupal-${_m}: drush require failed"; _nodrush="YES"; }
    _core="$(_detect_core_version "${_wd}" 2>/dev/null)"
    if [[ -z "${_core}" ]]; then
      _record_fail "drupal-${_m} (no core version)"
      _run_as_o8 "rm -rf '${_wd}'"
      continue
    fi
    if _run_as_o8 "mv '${_wd}' '${_DAY_DIR}/drupal-${_core}'"; then
      _rec "drupal-${_core}" BUILD ok
      [[ -n "${_nodrush}" ]] && _rec_note "drupal-${_core}" "no drush"
      _info "drupal-${_m}: built drupal-${_core}"
      _audit_platform "drupal-${_core}"
    else
      _record_fail "drupal-${_m} (rename failed)"
    fi
  done
}

build_backdrop() {
  # Backdrop CMS core: a single GitHub release zip (no Composer, no profiles to
  # strip). Packaged VERSIONED like the Drupal cores: backdrop-<ver>/ ->
  # backdrop-<ver>.tar.gz, preserving the top-level core/ layouts/ modules/
  # themes/ sites/ and core/scripts/install.sh, so every published release stays
  # available on the mirror instead of being overwritten by the next one. The
  # resolved version is stamped to backdrop.txt (the newest-version pointer BOA
  # resolves _BACKDROP_V from). Always rebuilt (a fast zip download) - no
  # _begin_build skip. The backdrop-[0-9]* globs never match the
  # backdrop-drush-extension dir.
  if ! command -v unzip >/dev/null 2>&1; then
    _record_fail "backdrop (unzip not found)"
    return 1
  fi
  local _tag _zip _url
  _tag="$(_resolve_backdrop_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "backdrop (no release tag$(_gh_quota_note))"; return 1; }
  # The tag comes from the GitHub API and lands in a root shell command and in
  # file names - accept plain dotted versions only, fail closed on anything else.
  if [[ ! "${_tag}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    _alrt "backdrop: unexpected release tag format: ${_tag}"
    _record_fail "backdrop (bad release tag)"
    return 1
  fi
  _zip=".backdrop.zip"
  _url="https://github.com/${_BACKDROP_REPO}/releases/download/${_tag}/backdrop.zip"
  # The zip's top-level dir is backdrop/; rename it to the versioned
  # backdrop-<ver>/ so the tarball extracts like a Drupal core one does.
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf backdrop backdrop-[0-9]* backdrop.tar.gz backdrop.txt '${_zip}' \
    && wget -q -O '${_zip}' '${_url}' && unzip -q '${_zip}' \
    && rm -f '${_zip}' && mv backdrop 'backdrop-${_tag}' \
    && printf '%s\n' '${_tag}' > backdrop.txt"; then
    _record_fail "backdrop"
    return 1
  fi
  # No contrib is baked into the core tree: Valkey/Redis support reaches every
  # platform through the shared o_contrib_backdrop bundle instead (see
  # build_redis_backdrop), the same model the Drupal cores use. The only
  # remaining bake is the version-less compat tarball's, injected at tar time
  # for pre-bundle releases (see package_backdrop_compat).
  _rec "backdrop-${_tag}" BUILD ok
  _info "backdrop: built backdrop-${_tag}/"
}

build_grav() {
  # Grav 2: the official ADMIN BUNDLE release zip (no Composer). The zip's
  # top-level dir is grav-admin/; renamed to the versioned grav-<ver>/ so the
  # tarball extracts like the other cores. The RAW zip is kept verbatim
  # alongside for the upgrade channel. grav.txt stamps the newest. Always
  # rebuilt (a fast zip download) - no _begin_build skip.
  if ! command -v unzip >/dev/null 2>&1; then
    _record_fail "grav (unzip not found)"
    return 1
  fi
  local _tag _zip _url
  _tag="$(_resolve_grav_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "grav (no release tag$(_gh_quota_note))"; return 1; }
  # The tag lands in root shell commands and file names - accept plain dotted
  # versions only, fail closed on anything else.
  if [[ ! "${_tag}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    _alrt "grav: unexpected release tag format: ${_tag}"
    _record_fail "grav (bad release tag)"
    return 1
  fi
  _zip="grav-admin-v${_tag}.zip"
  _url="https://github.com/${_GRAV_REPO}/releases/download/${_tag}/grav-admin-v${_tag}.zip"
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf grav grav-admin grav-[0-9]* grav.tar.gz grav.txt grav-admin-v*.zip \
    && wget -q -O '${_zip}' '${_url}' && unzip -q '${_zip}' \
    && mv grav-admin 'grav-${_tag}' \
    && printf '%s\n' '${_tag}' > grav.txt"; then
    _record_fail "grav"
    return 1
  fi
  _rec "grav-${_tag}" BUILD ok
  _info "grav: built grav-${_tag}/ (+ kept ${_zip} for the upgrade shelf)"
}

build_txp() {
  # Textpattern core: the official release .tar.gz (the .zip is deliberately
  # NOT used -- it omits the /sites multisite scaffold). The tarball already
  # extracts to textpattern-<ver>/, so no rename is needed. The published
  # .SHA256SUM is verified before packaging. textpattern.txt stamps the newest.
  local _tag _tgz _url _sum
  _tag="$(_resolve_txp_tag)"
  [[ -n "${_tag}" ]] || { _record_fail "textpattern (no release tag$(_gh_quota_note))"; return 1; }
  # The tag lands in root shell commands and file names - accept plain dotted
  # versions only, fail closed on anything else.
  if [[ ! "${_tag}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    _alrt "textpattern: unexpected release tag format: ${_tag}"
    _record_fail "textpattern (bad release tag)"
    return 1
  fi
  _tgz="textpattern-${_tag}.tar.gz"
  _url="https://github.com/${_TXP_REPO}/releases/download/${_tag}"
  _sum="${_tgz}.SHA256SUM"
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf textpattern textpattern-[0-9]* textpattern.tar.gz textpattern.txt \
    && wget -q -O '${_tgz}' '${_url}/${_tgz}' \
    && wget -q -O '${_sum}' '${_url}/${_sum}' \
    && sha256sum -c '${_sum}' \
    && tar -xzf '${_tgz}' \
    && test -d 'textpattern-${_tag}/sites' \
    && rm -f '${_tgz}' '${_sum}' \
    && printf '%s\n' '${_tag}' > textpattern.txt"; then
    _record_fail "textpattern"
    return 1
  fi
  _rec "textpattern-${_tag}" BUILD ok
  _info "textpattern: built textpattern-${_tag}/ (checksum verified, /sites present)"
}

build_bee() {
  # Native Backdrop CLI. Packaged version-less as bee.tar.gz with bee.php at the
  # root (what BOA's _get_bee extracts into /opt/tools/bee). Always rebuilt.
  local _tag
  _tag="${_BEE_TAG:-$(_latest_git_tag "${_BEE_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "bee (no release tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .build.bee bee.tar.gz \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_BEE_REPO}.git' .build.bee \
    && rm -rf .build.bee/.git \
    && tar -czf bee.tar.gz -C .build.bee . \
    && rm -rf .build.bee"; then
    _record_fail "bee"
    return 1
  fi
  _rec bee BUILD ok
  _rec bee NAME "bee ${_tag}"
  _info "bee: packaged bee.tar.gz (${_tag})"
}

build_bdext() {
  # Backdrop Drush extension. Packaged version-less as
  # backdrop-drush-extension.tar.gz wrapping a backdrop-drush-extension/ dir,
  # PRISTINE - BOA applies the drush_chalk de-hint + the __DIR__ include fix on
  # deploy. Always rebuilt.
  local _tag _d="backdrop-drush-extension"
  _tag="${_BDEXT_TAG:-$(_latest_git_tag "${_BDEXT_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "${_d} (no release tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_d}' '${_d}.tar.gz' \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_BDEXT_REPO}.git' '${_d}' \
    && rm -rf '${_d}/.git' \
    && tar -czf '${_d}.tar.gz' '${_d}' \
    && rm -rf '${_d}'"; then
    _record_fail "${_d}"
    return 1
  fi
  _rec "${_d}" BUILD ok
  _rec "${_d}" NAME "${_d} ${_tag}"
  _info "${_d}: packaged ${_d}.tar.gz (${_tag})"
}

build_redis_backdrop() {
  # Backdrop redis contrib module for the shared o_contrib_backdrop bundle.
  # Packaged VERSIONED as redis_backdrop-<tag>.tar.gz wrapping a redis_backdrop/
  # dir: the tarball's top-level name IS the deployed directory name under
  # /data/all/000/modules (the _get_dev_contrib contract, like redis_edge and
  # friends). Always rebuilt. The clone stays in a dot-prefixed working dir
  # (like .build.bee) so an interrupted run leaves nothing package_batch's
  # 'ls -d */' can sweep onto the distro shelf. _latest_git_tag only returns
  # N.N.N / N.x-N.N.N shapes, so the tag is safe in file names and the root
  # shell command.
  local _tag
  _tag="${_REDIS_TAG:-$(_latest_git_tag "${_REDIS_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "redis_backdrop (no release tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .build.redis_backdrop redis_backdrop-*.tar.gz \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_REDIS_REPO}.git' .build.redis_backdrop \
    && rm -rf .build.redis_backdrop/.git \
    && tar -czf 'redis_backdrop-${_tag}.tar.gz' --transform 's,^\.build\.redis_backdrop,redis_backdrop,' .build.redis_backdrop \
    && rm -rf .build.redis_backdrop"; then
    _record_fail "redis_backdrop"
    return 1
  fi
  _rec "redis_backdrop-${_tag}" BUILD ok
  _info "redis_backdrop: packaged redis_backdrop-${_tag}.tar.gz (${_tag})"
}

build_webform_backdrop() {
  # Plain o_contrib_backdrop bundle member: packaged VERSIONED as
  # webform-<tag>.tar.gz wrapping a webform/ dir (the _get_dev_contrib
  # contract). Same dot-prefixed working-dir discipline as redis_backdrop.
  local _tag
  _tag="${_WEBFORM_B_TAG:-$(_latest_git_tag "${_WEBFORM_B_REPO}")}"
  [[ -n "${_tag}" ]] || { _record_fail "webform_backdrop (no release tag)"; return 1; }
  if ! _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .build.webform_backdrop webform-*.tar.gz \
    && git clone -q --depth 1 --branch '${_tag}' 'https://github.com/${_WEBFORM_B_REPO}.git' .build.webform_backdrop \
    && rm -rf .build.webform_backdrop/.git \
    && tar -czf 'webform-${_tag}.tar.gz' --transform 's,^\.build\.webform_backdrop,webform,' .build.webform_backdrop \
    && rm -rf .build.webform_backdrop"; then
    _record_fail "webform_backdrop"
    return 1
  fi
  _rec "webform-${_tag}" BUILD ok
  _rec "webform-${_tag}" NAME "webform_backdrop ${_tag}"
  _info "webform_backdrop: packaged webform-${_tag}.tar.gz (${_tag})"
}

run_build() {
  local _name="$1"
  # Per-target state starts clean: a note or fix record a failed target left behind
  # must never land on the next platform's row or in its .advisories.
  _FALLBACK_NOTE=""
  _FIX_NOTE=""
  _FIX_BEFORE=""
  _FIX_LINES=()
  _PENDING_NOTE=""
  _tail_mark
  case "${_name}" in
    farm)     build_farm ;;
    backdrop) build_backdrop ;;
    grav)     build_grav ;;
    txp)      build_txp ;;
    bee)      build_bee ;;
    backdrop-drush-extension) build_bdext ;;
    redis_backdrop) build_redis_backdrop ;;
    webform_backdrop) build_webform_backdrop ;;
    cms)      build_cms ;;
    culturas) build_culturas ;;
    commerce) build_commerce ;;
    localgov) build_localgov ;;
    openfed)  build_openfed ;;
    opigno)   build_opigno ;;
    social)   build_social ;;
    thunder)  build_thunder ;;
    varbase)  build_varbase ;;
    ezcontent) build_ezcontent ;;
    commerce_base) build_commerce_base ;;
    cores)    build_cores ;;
    *)        _record_fail "${_name} (unknown build target)"; return 1 ;;
  esac
  return 0
}

do_build() {
  # $@ = target names, or empty for all distros + cores.
  local _targets="$*"
  [[ -n "${_targets}" ]] || _targets="${_ALL_DISTROS} backdrop bee backdrop-drush-extension redis_backdrop webform_backdrop cores"
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  if [[ "${_SKIP_CLEARCACHE}" != "1" ]]; then
    _msg "composer clearcache (${_O8_USER})"
    _run_as_o8 "composer clearcache" || _alrt "composer clearcache failed (continuing)"
  fi
  local _t _i=0 _all
  _all="$(wc -w <<< "${_targets}")"
  for _t in ${_targets}; do
    _i=$((_i + 1))
    _progress "building ${_t} (${_i}/${_all// /})"
    _msg ""
    _msg "=== build: ${_t} ==="
    run_build "${_t}"
  done
  _progress_end
}

# ---------------------------------------------------------------------------
# Packaging + publishing.
# ---------------------------------------------------------------------------

clean_platforms() {
  # Strip artefacts that must not ship inside any platform tarball. -f/-rf keep
  # non-matching globs harmless; trailing true keeps the compound green.
  _run_as_o8 "cd '${_DAY_DIR}' && \
    rm -f  */*/modules/o_contrib* ; \
    rm -rf */*/sites/all/drush ; \
    rm -f  */*/sites/all/modules/* ; \
    rm -f  */*/sites/sites.php ; \
    rm -f  */*/local_drush_unlocked.pid ; \
    rm -f  */*/sites/all/libraries/*.pid ; \
    true"
}

strip_core_profiles() {
  # Distros bring their own install profile; drop the stock core profiles to slim
  # ONLY the distribution tarballs. Never touch the drupal-* core dirs, so
  # re-running package stays idempotent (cores always keep their profiles).
  local _name _list
  _list="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d */ 2>/dev/null")"
  for _name in ${_list}; do
    _name="${_name%/}"
    case "${_name}" in drupal-*|backdrop-[0-9]*) continue ;; esac
    _run_as_o8 "cd '${_DAY_DIR}' && rm -rf '${_name}'/*/core/profiles/* ; true"
  done
}

package_batch() {
  # $1 = core | distro. Core = drupal-* dirs (with core/profiles); distro = the rest.
  local _kind="$1" _name _list
  _list="$(_run_as_o8 "cd '${_DAY_DIR}' && ls -d */ 2>/dev/null")"
  for _name in ${_list}; do
    _name="${_name%/}"
    case "${_name}" in
      # backdrop-[0-9]* keeps backdrop-drush-extension (a dev extension, never a
      # day-dir build residue unless its build failed mid-way) out of the core arm.
      drupal-*|backdrop-[0-9]*) [[ "${_kind}" == "core" ]]   || continue ;;
      *)                        [[ "${_kind}" == "distro" ]] || continue ;;
    esac
    _msg "tar: ${_name}.tar.gz"
    # A failed tar leaves a partial archive distribute would publish: remove it.
    if ! _run_as_o8 "cd '${_DAY_DIR}' && tar -czf '${_name}.tar.gz' '${_name}'"; then
      _alrt "tar failed: ${_name}"
      _run_as_o8 "rm -f '${_DAY_DIR}/${_name}.tar.gz'"
      _rec_note "${_name}" "tar failed"
    elif [[ "${_ACTION}" == "package" ]]; then
      _rec_note "${_name}" "packaged"
    fi
  done
}

do_package() {
  [[ -n "${_DAY_DIR}" ]] || _die "no build-day directory set"
  _run_as_o8 "test -d '${_DAY_DIR}'" || _die "build-day directory not found: ${_DAY_DIR}"
  _msg "cleaning platform artefacts"
  clean_platforms
  _msg "packaging core platforms (with core/profiles)"
  package_batch core
  package_backdrop_compat
  _msg "stripping stock core profiles from distributions"
  strip_core_profiles
  _msg "packaging distribution platforms (without core/profiles)"
  package_batch distro
}

_ensure_devext_dirs() {
  local _tree
  for _tree in ${_DEV_TREES}; do
    mkdir -p "${_DEVEXT_BASE}/${_tree}" || _die "cannot create ${_DEVEXT_BASE}/${_tree}"
  done
}

_copy_to_shelf() {
  # $1 = file in the build-day dir, $2 = shelf dir. Root copies what the build user's
  # day dir holds: take only a plain file (never a symlink or a FIFO planted in its
  # place), and replace the destination instead of writing through a symlink that
  # may already sit there.
  local _src="$1" _out="$2"
  if [[ ! -f "${_src}" || -L "${_src}" ]]; then
    _alrt "not a regular file, not published: ${_src##*/}"
    return 1
  fi
  cp -a --remove-destination "${_src}" "${_out}/"
}

_publish_plain() {
  # $1 = file in the build-day dir, $2 = shelf dir, $3 = its summary row, $4 = "companion"
  # when the file only rides along with that row's own tarball (a compat tarball, a
  # version stamp): then only a failure changes the row. For shelves no lock guards.
  local _src="$1" _out="$2" _k="$3" _st="new" _what=""
  # A companion's failure names the file, so the row does not blame its own tarball.
  [[ "${4:-}" == "companion" ]] && _what="${_src##*/} "
  # Root reads the file before the copy (cmp), so the plain-file check comes first.
  if [[ ! -f "${_src}" || -L "${_src}" ]]; then
    _alrt "not a regular file, not published: ${_src##*/}"
    _rec_pub "${_k}" FAILED
    _rec_note "${_k}" "${_what}not a regular file"
    return 1
  fi
  if [[ -e "${_out}/${_src##*/}" ]]; then
    if cmp -s "${_src}" "${_out}/${_src##*/}"; then _st="same"; else _st="updated"; fi
  fi
  if _copy_to_shelf "${_src}" "${_out}"; then
    [[ "${4:-}" == "companion" ]] || _rec_pub "${_k}" "${_st}"
    return 0
  fi
  _rec_pub "${_k}" FAILED
  _rec_note "${_k}" "${_what}copy failed"
  return 1
}

_publish_devext() {
  # $1 = a dev extension tarball (bee, the drush extension): one copy per tree.
  local _src="$1" _base _tree _ok=1
  _base="${_src##*/}"
  for _tree in ${_DEV_TREES}; do
    if _publish_plain "${_src}" "${_DEVEXT_BASE}/${_tree}" "${_base%.tar.gz}"; then
      _msg "devext <- ${_base} (${_tree})"
    else
      _alrt "copy failed: ${_base} (${_tree})"
      _ok=0
    fi
  done
  [[ "${_ok}" == "1" ]]
}

_publish_contrib() {
  # $1 = a versioned contrib tarball (redis_backdrop, webform): one copy per tree's
  # contrib shelf, consumed by the version BOA pins.
  local _src="$1" _base _tree _ok=1
  _base="${_src##*/}"
  for _tree in ${_DEV_TREES}; do
    if ! mkdir -p "${_DEVEXT_BASE}/${_tree}/contrib"; then
      _alrt "cannot create ${_DEVEXT_BASE}/${_tree}/contrib"
      _rec_pub "${_base%.tar.gz}" FAILED
      _rec_note "${_base%.tar.gz}" "no ${_tree} contrib shelf"
      _ok=0
      continue
    fi
    if _publish_plain "${_src}" "${_DEVEXT_BASE}/${_tree}/contrib" "${_base%.tar.gz}"; then
      _msg "contrib <- ${_base} (${_tree})"
    else
      _alrt "copy failed: ${_base} (${_tree})"
      _ok=0
    fi
  done
  [[ "${_ok}" == "1" ]]
}

_family_row() {
  # $1 = a core-shelf file of the Backdrop, Grav or Textpattern family. Prints its
  # summary row and, for a compat tarball or a stamp, "companion": they belong to the
  # versioned tarball of the day.
  local _v
  case "$1" in
    backdrop.tar.gz|backdrop.txt)
      _v="$(_backdrop_day_version)"; printf '%s
' "backdrop-${_v:-unknown} companion" ;;
    grav.tar.gz|grav.txt|grav-admin-v*.zip)
      _v="$(_grav_day_version)"; printf '%s
' "grav-${_v:-unknown} companion" ;;
    textpattern.tar.gz|textpattern.txt)
      _v="$(_txp_day_version)"; printf '%s
' "textpattern-${_v:-unknown} companion" ;;
    *)
      printf '%s
' "${1%.tar.gz}" ;;
  esac
}

_publish_core_file() {
  # $1 = a family file in the day dir: copy it to the core shelf, record its row.
  local _f="$1" _key _kind
  read -r _key _kind <<< "$(_family_row "${_f##*/}")"
  if _publish_plain "${_f}" "${_CORE_OUT}" "${_key}" "${_kind}"; then
    _msg "core   <- ${_f##*/}"
    return 0
  fi
  _alrt "copy failed: ${_f##*/}"
  return 1
}

_backdrop_day_version() {
  # Version stamped by the current build (empty if none).
  [[ -f "${_DAY_DIR}/backdrop.txt" && ! -L "${_DAY_DIR}/backdrop.txt" ]] || return 0
  tr -cd '0-9.' < "${_DAY_DIR}/backdrop.txt"
}

_grav_day_version() {
  # Version stamped by the current Grav build (empty if none).
  [[ -f "${_DAY_DIR}/grav.txt" && ! -L "${_DAY_DIR}/grav.txt" ]] || return 0
  tr -cd '0-9.' < "${_DAY_DIR}/grav.txt"
}

_txp_day_version() {
  # Version stamped by the current Textpattern build (empty if none).
  [[ -f "${_DAY_DIR}/textpattern.txt" && ! -L "${_DAY_DIR}/textpattern.txt" ]] || return 0
  tr -cd '0-9.' < "${_DAY_DIR}/textpattern.txt"
}

package_backdrop_compat() {
  # Version-less backdrop.tar.gz for already-deployed BOA releases, which still
  # fetch that name AND expect it to extract to backdrop/ (the pre-versioning
  # contract). So it is re-tarred from the current backdrop-<ver>/ tree with the
  # top-level dir renamed - NOT a byte copy of the versioned tarball, which
  # extracts to backdrop-<ver>/ and would break their mv of backdrop/.
  #
  # The compat tarball ALONE still carries the baked modules/redis: the /core/
  # shelf is shared by every release, and the pre-bundle releases consuming
  # this name have no o_contrib_backdrop machinery - their global-bd.inc probes
  # only modules/redis, so shipping it clean would build Valkey-less platforms
  # on every not-yet-upgraded box. The module is injected from a dot-dir clone
  # at tar time (never placed in the tree), so the versioned tarballs the
  # bundle-aware releases fetch stay contrib-free.
  local _ver _redis_tag
  _ver="$(_backdrop_day_version)"
  [[ -n "${_ver}" ]] || return 0
  _run_as_o8 "test -d '${_DAY_DIR}/backdrop-${_ver}'" || return 0
  _redis_tag="${_REDIS_TAG:-$(_latest_git_tag "${_REDIS_REPO}")}"
  if [[ -n "${_redis_tag}" ]] && _run_as_o8 "cd '${_DAY_DIR}' && rm -rf .compat.redis \
    && git clone -q --depth 1 --branch '${_redis_tag}' 'https://github.com/${_REDIS_REPO}.git' .compat.redis \
    && rm -rf .compat.redis/.git"; then
    _msg "tar: backdrop.tar.gz (compat, extracts to backdrop/, baked modules/redis ${_redis_tag})"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf backdrop.tar.gz \
      --transform 's,^backdrop-${_ver},backdrop,' \
      --transform 's,^\.compat\.redis,backdrop/modules/redis,' \
      'backdrop-${_ver}' .compat.redis \
      && rm -rf .compat.redis" \
      || { _alrt "tar failed: backdrop.tar.gz (compat)"; _run_as_o8 "rm -f '${_DAY_DIR}/backdrop.tar.gz'"; _rec_note "backdrop-${_ver}" "compat tarball failed"; }
  else
    _alrt "compat redis clone failed (${_redis_tag:-no tag}); backdrop.tar.gz ships without baked modules/redis this run"
    _rec_note "backdrop-${_ver}" "compat without redis"
    _msg "tar: backdrop.tar.gz (compat, extracts to backdrop/)"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf backdrop.tar.gz --transform 's,^backdrop-${_ver},backdrop,' 'backdrop-${_ver}'" \
      || { _alrt "tar failed: backdrop.tar.gz (compat)"; _run_as_o8 "rm -f '${_DAY_DIR}/backdrop.tar.gz'"; _rec_note "backdrop-${_ver}" "compat tarball failed"; }
  fi
}

do_backdrop_family() {
  # Lightweight: build + package + publish ONLY the Backdrop family (backdrop
  # core + bee + backdrop-drush-extension + redis_backdrop + webform_backdrop), all at their
  # newest upstream. No Composer, no distros/cores, no /usr/bin/php switch -
  # just git/wget/unzip. Scoped to the family so it never touches unrelated
  # day-dir content.
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  local _t
  for _t in backdrop bee backdrop-drush-extension redis_backdrop webform_backdrop; do
    _msg ""
    _msg "=== build: ${_t} ==="
    run_build "${_t}"
  done
  # Package the versioned core dir (bee + extension are already tarballs from
  # their build), plus the version-less compat tarball.
  local _ver
  _ver="$(_backdrop_day_version)"
  if [[ -n "${_ver}" ]] && _run_as_o8 "test -d '${_DAY_DIR}/backdrop-${_ver}'"; then
    _msg "tar: backdrop-${_ver}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf 'backdrop-${_ver}.tar.gz' 'backdrop-${_ver}'" \
      || { _alrt "tar failed: backdrop-${_ver}"; _run_as_o8 "rm -f '${_DAY_DIR}/backdrop-${_ver}.tar.gz'"; _rec_note "backdrop-${_ver}" "tar failed"; }
    package_backdrop_compat
  fi
  # Publish only the family artifacts. Tarballs first, the backdrop.txt stamp
  # last: a consumer must never resolve a version whose tarball is not there yet.
  mkdir -p "${_CORE_OUT}" || _die "cannot create ${_CORE_OUT}"
  _ensure_devext_dirs
  local _f
  if [[ -n "${_ver}" && -e "${_DAY_DIR}/backdrop-${_ver}.tar.gz" ]]; then
    for _f in "backdrop-${_ver}.tar.gz" backdrop.tar.gz backdrop.txt; do
      [[ -e "${_DAY_DIR}/${_f}" ]] || continue
      # The stamp comes last and must never point at a tarball the shelf lacks.
      if ! _publish_core_file "${_DAY_DIR}/${_f}" \
        && [[ "${_f}" == *"-${_ver}.tar.gz" || "${_f}" == "grav-admin-v${_ver}.zip" ]]; then
        break
      fi
    done
  fi
  for _f in bee.tar.gz backdrop-drush-extension.tar.gz; do
    [[ -e "${_DAY_DIR}/${_f}" ]] && _publish_devext "${_DAY_DIR}/${_f}"
  done
  for _f in "${_DAY_DIR}"/redis_backdrop-*.tar.gz "${_DAY_DIR}"/webform-*.tar.gz; do
    [[ -e "${_f}" ]] && _publish_contrib "${_f}"
  done
}

do_grav_family() {
  # Lightweight: build + package + publish ONLY the Grav artefacts (the
  # official admin-bundle release, at its newest upstream). No Composer, no
  # /usr/bin/php switch - just wget/unzip. Publishes the versioned platform
  # tarball, the RAW official zip (upgrade shelf) and the grav.txt stamp
  # LAST: a consumer must never resolve a version whose artefacts are not
  # there yet.
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  _msg ""
  _msg "=== build: grav ==="
  run_build "grav"
  local _ver
  _ver="$(_grav_day_version)"
  if [[ -n "${_ver}" ]] && _run_as_o8 "test -d '${_DAY_DIR}/grav-${_ver}'"; then
    _msg "tar: grav-${_ver}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf 'grav-${_ver}.tar.gz' 'grav-${_ver}'" \
      || { _alrt "tar failed: grav-${_ver}"; _run_as_o8 "rm -f '${_DAY_DIR}/grav-${_ver}.tar.gz'"; _rec_note "grav-${_ver}" "tar failed"; }
    _msg "tar: grav.tar.gz (version-less compat)"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf grav.tar.gz --transform 's,^grav-${_ver},grav,' 'grav-${_ver}'" \
      || { _alrt "tar failed: grav compat"; _run_as_o8 "rm -f '${_DAY_DIR}/grav.tar.gz'"; _rec_note "grav-${_ver}" "compat tarball failed"; }
  fi
  mkdir -p "${_CORE_OUT}" || _die "cannot create ${_CORE_OUT}"
  local _f
  if [[ -n "${_ver}" && -e "${_DAY_DIR}/grav-${_ver}.tar.gz" ]]; then
    for _f in "grav-${_ver}.tar.gz" grav.tar.gz "grav-admin-v${_ver}.zip" grav.txt; do
      [[ -e "${_DAY_DIR}/${_f}" ]] || continue
      # The stamp comes last and must never point at a tarball the shelf lacks.
      if ! _publish_core_file "${_DAY_DIR}/${_f}" \
        && [[ "${_f}" == *"-${_ver}.tar.gz" || "${_f}" == "grav-admin-v${_ver}.zip" ]]; then
        break
      fi
    done
  fi
}

do_txp_family() {
  # Lightweight: build + package + publish ONLY the Textpattern artefacts, at
  # their newest upstream release. No Composer. Publishes the versioned
  # platform tarball, the version-less compat tarball and the textpattern.txt
  # stamp LAST: a consumer must never resolve a version whose artefacts are
  # not on the mirror yet.
  _run_as_o8 "mkdir -p '${_DAY_DIR}'" || _die "cannot create ${_DAY_DIR}"
  _msg ""
  _msg "=== build: textpattern ==="
  run_build "txp"
  local _ver
  _ver="$(_txp_day_version)"
  if [[ -n "${_ver}" ]] && _run_as_o8 "test -d '${_DAY_DIR}/textpattern-${_ver}'"; then
    _msg "tar: textpattern-${_ver}.tar.gz"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf 'textpattern-${_ver}.tar.gz' 'textpattern-${_ver}'" \
      || { _alrt "tar failed: textpattern-${_ver}"; _run_as_o8 "rm -f '${_DAY_DIR}/textpattern-${_ver}.tar.gz'"; _rec_note "textpattern-${_ver}" "tar failed"; }
    # Separate tar invocation with --transform, never a copy: the compat
    # archive must EXTRACT to the unversioned directory name.
    _msg "tar: textpattern.tar.gz (version-less compat)"
    _run_as_o8 "cd '${_DAY_DIR}' && tar -czf textpattern.tar.gz --transform 's,^textpattern-${_ver},textpattern,' 'textpattern-${_ver}'" \
      || { _alrt "tar failed: textpattern compat"; _run_as_o8 "rm -f '${_DAY_DIR}/textpattern.tar.gz'"; _rec_note "textpattern-${_ver}" "compat tarball failed"; }
  fi
  mkdir -p "${_CORE_OUT}" || _die "cannot create ${_CORE_OUT}"
  local _f
  if [[ -n "${_ver}" && -e "${_DAY_DIR}/textpattern-${_ver}.tar.gz" ]]; then
    # textpattern.txt LAST in this list on purpose (see the header).
    for _f in "textpattern-${_ver}.tar.gz" textpattern.tar.gz textpattern.txt; do
      [[ -e "${_DAY_DIR}/${_f}" ]] || continue
      # The stamp comes last and must never point at a tarball the shelf lacks.
      if ! _publish_core_file "${_DAY_DIR}/${_f}" \
        && [[ "${_f}" == *"-${_ver}.tar.gz" || "${_f}" == "grav-admin-v${_ver}.zip" ]]; then
        break
      fi
    done
  fi
}

_lock_digest() {
  # sha256 of the composer.lock at the top of platform tarball $1, joined with that
  # of a patches.lock.json beside it, so a respin whose patch list moved under an
  # unchanged lock still differs and is audited before it replaces the published one.
  # A patch whose content changed behind the same URL is not seen: varbase's
  # patches.lock.json records no patch hashes, so such a respin passes as the same
  # lock under new bytes. Empty when the tarball carries no composer.lock at its top
  # (sha256sum would still print the empty-input hash, so tar's status decides). tar
  # stops at the first match.
  local _l _p
  _l="$(set -o pipefail
    tar -xzOf "$1" --wildcards --no-wildcards-match-slash --occurrence=1 '*/composer.lock' 2>/dev/null \
      | sha256sum | cut -d' ' -f1)" || return 0
  _p="$(set -o pipefail
    tar -xzOf "$1" --wildcards --no-wildcards-match-slash --occurrence=1 '*/patches.lock.json' 2>/dev/null \
      | sha256sum | cut -d' ' -f1)" || _p=""
  printf '%s\n' "${_l}${_p:++${_p}}"
}

_overwrite_named() {
  # 0 when -O names tarball $1 (distribute takes the platforms to overwrite as
  # arguments, so an override never reaches a tarball nobody asked for).
  case " ${_OVERWRITE_NAMES} " in *" $1 "*) return 0 ;; esac
  return 1
}

_replaces_published() {
  # $1 = _fix_verdict's answer for a same-name tarball whose lock changed. 0 when the
  # new lock may replace the published one: it clears advisories, or carries the same
  # ones. A lock that adds advisories, or one whose audit did not finish or cannot be
  # compared, is refused.
  case "$1" in
    fix|"fixes nothing"*) return 0 ;;
  esac
  return 1
}

_publish_locked() {
  # $1 = Composer-built platform tarball in the day dir, $2 = shelf. A box fetches a
  # platform only while its directory is absent, so a same-name tarball with a changed
  # lock reaches new installs and never the boxes that already hold the platform. Both
  # locks are audited now, against today's advisories, and the new one replaces the
  # published one unless it adds advisories the published one lacks, or either audit
  # did not finish or cannot be compared: those are refused and the published copy
  # stays, unless -O names the platform.
  local _src="$1" _out="$2" _base _key _dst _old _new _st="new" _ra _rb _on _nn _vd
  _base="${_src##*/}"
  _key="${_base%.tar.gz}"
  _dst="${_out}/${_base}"
  # Root reads the file before the copy (cmp, tar), so the plain-file check comes
  # first here as well.
  if [[ ! -f "${_src}" || -L "${_src}" ]]; then
    _alrt "not a regular file, not published: ${_base}"
    _rec_pub "${_key}" FAILED
    _rec_note "${_key}" "not a regular file"
    return 1
  fi
  if [[ -e "${_dst}" ]]; then
    _st="same"
    if ! cmp -s "${_src}" "${_dst}"; then
      _st="updated"
      _old="$(_lock_digest "${_dst}")"
      _new="$(_lock_digest "${_src}")"
      if [[ -z "${_old}" || -z "${_new}" || "${_old}" != "${_new}" ]]; then
        if _overwrite_named "${_base}"; then
          _st="OVERWRITTEN"
        else
          _ra="$(_audit_tarball_file "${_dst}" 1)"
          _rb="$(_audit_tarball_file "${_src}" 2)"
          _on="$(sed -n '1s/^advisories: //p' <<< "${_ra}")"
          _nn="$(sed -n '1s/^advisories: //p' <<< "${_rb}")"
          _vd="$(_fix_verdict "${_ra}" "${_rb}")"
          if _replaces_published "${_vd}"; then
            _st="replaced"
          else
            _alrt "REFUSED: ${_base} is already published and its lock differs"
            _alrt "  published lock sha256: ${_old:-none (no composer.lock found)}"
            _alrt "  new lock sha256:       ${_new:-none (no composer.lock found)}"
            _alrt "  advisories: published ${_on:-unknown}, this build ${_nn:-unknown} (refused when it adds some or either side cannot be audited or compared)"
            _alrt "  boxes that already fetched ${_key} would keep the old bytes;"
            _alrt "  ship the change under a new platform name, or run: staticbuild -u ${_O8_USER} -d ${_DAY} -O distribute ${_key}"
            _rec_pub "${_key}" REFUSED
            case "${_vd}" in
              adds*)                _rec_note "${_key}" "adds advisories" ;;
              "the advisory audit"*) _rec_note "${_key}" "audit failed" ;;
              "the audit reports"*) _rec_note "${_key}" "audit not comparable" ;;
              *)                    _rec_note "${_key}" "not verified" ;;
            esac
            _REFUSED=$((_REFUSED + 1))
            return 1
          fi
        fi
      fi
    fi
  fi
  if ! _copy_to_shelf "${_src}" "${_out}"; then
    _alrt "copy failed: ${_base}"
    _rec_pub "${_key}" FAILED
    _rec_note "${_key}" "copy failed"
    return 1
  fi
  _msg "$(printf '%-6s' "${_out##*/}") <- ${_base}"
  _rec_pub "${_key}" "${_st}"
  case "${_st}" in
    replaced)
      if [[ "${_vd}" == "fix" ]]; then
        _msg "REPLACED (clears advisories): ${_base}"
      else
        _msg "REPLACED (lock changed, same advisories): ${_base}"
      fi
      _msg "  published lock sha256: ${_old:-none}"
      _msg "  new lock sha256:       ${_new:-none}"
      _msg "  advisories: published ${_on}, this build ${_nn}; boxes that already fetched ${_key} keep the old bytes"
      ;;
    OVERWRITTEN)
      _alrt "OVERWRITTEN (-O): ${_base}"
      _alrt "  published lock sha256: ${_old:-none (no composer.lock found)}"
      _alrt "  new lock sha256:       ${_new:-none (no composer.lock found)}"
      _alrt "  boxes that already fetched ${_key} keep the old bytes"
      _rec_note "${_key}" "-O"
      ;;
  esac
  return 0
}

do_distribute() {
  mkdir -p "${_DISTRO_OUT}" "${_CORE_OUT}" \
    || _die "cannot create ${_DISTRO_OUT} / ${_CORE_OUT}"
  # Work dir for auditing both sides of a same-name lock change (_publish_locked).
  if [[ -z "${_ADV_TMP}" ]]; then
    _ADV_TMP="$(mktemp -d)" || _die "cannot create a work dir"
  fi
  _ensure_devext_dirs
  local _t _base _n=0 _seen=0
  for _t in "${_DAY_DIR}"/*.tar.gz; do
    [[ -e "${_t}" ]] || continue
    _seen=$((_seen + 1))
    _base="${_t##*/}"
    # Dev extensions first: backdrop-drush-extension.tar.gz must NOT fall into the
    # backdrop-* core arm. The version-less backdrop.tar.gz is the compat tarball
    # built by package_backdrop_compat (extracts to backdrop/). Grav and
    # Textpattern are core-shelf families too: their own targets publish to
    # core/ (stamp last), so a same-day "all" run must re-copy any of their
    # tarballs left in the day dir to core/ as well, never to distro/, which
    # nothing reads for them (a satellite fetches grav-<ver>.tar.gz and
    # textpattern-<ver>.tar.gz through _get_core_ext).
    case "${_base}" in
      bee.tar.gz|backdrop-drush-extension.tar.gz)
        _publish_devext "${_t}" && _n=$((_n + 1)) ;;
      redis_backdrop-*.tar.gz|webform-*.tar.gz)
        _publish_contrib "${_t}" && _n=$((_n + 1)) ;;
      # The vanilla Drupal cores are Composer-built like the distros and get the
      # same guard; the Backdrop, Grav and Textpattern tarballs carry no lock, and
      # their version-less compat tarballs are rebuilt under the same name by design.
      drupal-*.tar.gz)
        _publish_locked "${_t}" "${_CORE_OUT}" && _n=$((_n + 1)) ;;
      backdrop-[0-9]*.tar.gz|backdrop.tar.gz|grav-[0-9]*.tar.gz|grav.tar.gz|textpattern-[0-9]*.tar.gz|textpattern.tar.gz)
        _publish_core_file "${_t}" && _n=$((_n + 1)) ;;
      *)
        _publish_locked "${_t}" "${_DISTRO_OUT}" && _n=$((_n + 1)) ;;
    esac
  done
  # Publish the Backdrop newest-version stamp AFTER the tarballs, and only when
  # the tarball it points to is really on the mirror: BOA resolves _BACKDROP_V
  # from the stamp and fetches the matching backdrop-<ver>.tar.gz, so the stamp
  # must never advance ahead of its tarball.
  local _bdrv
  _bdrv="$(_backdrop_day_version)"
  if [[ -n "${_bdrv}" && -e "${_CORE_OUT}/backdrop-${_bdrv}.tar.gz" ]]; then
    _publish_core_file "${_DAY_DIR}/backdrop.txt"
  fi
  [[ "${_seen}" -gt 0 ]] || _say "no tarballs found in ${_DAY_DIR} (run 'package' first)"
}

# ---------------------------------------------------------------------------
# Version check (best-effort; read-only; no root needed).
# ---------------------------------------------------------------------------

_latest_packagist() {
  # Latest stable version from Packagist p2 metadata (array is newest-first).
  local _pkg="$1"
  curl -fsSL -A "${_UA}" "https://repo.packagist.org/p2/${_pkg}.json" 2>/dev/null \
    | grep -oE '"version":"[^"]+"' | head -1 | cut -d'"' -f4
}

_latest_github() {
  local _repo="$1"
  curl -fsSL -A "${_UA}" "https://api.github.com/repos/${_repo}/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name":[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"([^"]+)"$/\1/'
}

_check_row() {
  printf '  %-10s %s\n' "$1" "${2:-n/a}"
}

do_check() {
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed for version check)"
  _info "Latest release per distro from the authoritative source - drupal.org release feed"
  _info "(GitHub for farmOS; commerce_kickstart has no drupal.org stable, so its profile pkg):"
  _check_row "farm"     "$(_resolve_farm_tag)"
  _check_row "backdrop" "$(_latest_github "${_BACKDROP_REPO}")"
  _check_row "bee"      "$(_latest_git_tag "${_BEE_REPO}")"
  _check_row "bd-drush" "$(_latest_git_tag "${_BDEXT_REPO}")"
  # The only pinned Backdrop artifact: a newer tag here means the
  # _REDIS_B_VERSION pins in OCTOPUS.sh.txt + BOA.sh.txt are due a bump.
  _check_row "bd-redis" "$(_latest_git_tag "${_REDIS_REPO}")"
  _check_row "bd-webform" "$(_latest_git_tag "${_WEBFORM_B_REPO}")"
  _check_row "cms"      "$(_drupal_release cms)"
  _check_row "culturas" "$(_drupal_release "${_CULTURAS_PROJECT}")"
  _check_row "commerce" "$(_latest_packagist "${_COMMERCE_DISTPKG}")"
  _check_row "localgov" "$(_drupal_release localgov)"
  _check_row "openfed"  "$(_drupal_release openfed)"
  _check_row "opigno"   "$(_drupal_release opigno_lms)"
  _check_row "social"   "$(_drupal_release social)"
  _check_row "thunder"  "$(_drupal_release thunder)"
  _check_row "varbase"  "$(_drupal_release varbase)"
  _msg ""
  local _minors="${_CORE_MINORS}"
  [[ -n "${_minors}" ]] || _minors="$(_discover_core_minors)"
  _msg "Core minors to build (latest patch of each): ${_minors:-<discovery failed>}"
  _msg "Full supported-core matrix: https://www.drupal.org/project/drupal/releases"
}

# ---------------------------------------------------------------------------
# Catalogue audit.
#
# A catalogue entry whose tarball is not published is not a build failure -- it is
# a silent customer-facing one: the octopus run retries the fetch ten times, nine
# seconds apart, then carries on, so a de-published tarball costs every box a
# minute and a half per codebase generation and shows up only as an OOPS line in
# one customer's console. This is the guard: for every entry the PUBLISHED tree
# still ships, prove the tarball exists.
# ---------------------------------------------------------------------------

_catalogue_producers() {
  # Tarball prefixes an ENABLED target actually emits: walk run_build's live case
  # arms, then read each named function's _finalize_distro prefix. A commented-out
  # arm is deliberately not counted -- a frozen target's tarball stays on the mirror
  # with nothing rebuilding it, and that is exactly the state this audit exists to
  # surface (as it did through the 2026-07/08 varbase freeze).
  local _fn
  for _fn in $(awk '/^run_build\(\)/,/^}/' "$0" \
    | sed -nE 's/^[[:space:]]*[a-z0-9_-]+\)[[:space:]]+(build_[a-z_]+).*/\1/p'); do
    awk -v _f="^${_fn}\\(\\)" '$0 ~ _f,/^}/' "$0" \
      | sed -nE 's/.*_finalize_distro[[:space:]]+"?([a-z_]+)"?.*/\1/p'
  done | sort -u
}

_catalogue_rows() {
  # $1 = tree. Emits "KEY<TAB>prefix<TAB>tarball" for every catalogue entry that is
  # fetched from the distro mirror. The excluded key shapes mirror _d_dist_loop's
  # dispatch in AegirSetupC.sh.txt (core-only D[LXE]N, Backdrop BD*, and the
  # custom CK1/UC* handlers) -- add a class there and it must be added here too.
  # With $2 = core it emits the Composer-built core-only entries instead (D9, D10
  # and D11: DL9, DX*, DE*), as "KEY<TAB>drupal<TAB>drupal-<ver>.tar.gz", the name
  # _create_drupal_basic_version fetches from the core mirror; the Drupal 6/7 cores
  # (DL6, DL7) are BOA's own forks, outside Composer.
  local _tree="$1" _mode="${2:-distro}" _tmp _rc=0
  _tmp="$(mktemp -d)" || return 1
  curl -fsSL -A "${_BOA_UA}" \
    "${_BOA_VERSIONS_URL}/${_tree}/boa/aegir/scripts/AegirSetupC.sh.txt" \
    -o "${_tmp}/catalogue" 2>/dev/null || _rc=1
  curl -fsSL -A "${_BOA_UA}" \
    "${_BOA_VERSIONS_URL}/${_tree}/boa/OCTOPUS.sh.txt" \
    -o "${_tmp}/settings" 2>/dev/null || _rc=1
  if [[ "${_rc}" != "0" ]] || [[ ! -s "${_tmp}/catalogue" ]] || [[ ! -s "${_tmp}/settings" ]]; then
    rm -rf "${_tmp}"
    return 1
  fi
  awk -v _octo="${_tmp}/settings" -v _mode="${_mode}" '
    function _resolve(_s,   _k) {
      # One-level ${_NAME} expansion against the published OCTOPUS.sh.txt exports.
      while (match(_s, /\$\{_[A-Za-z0-9_]+\}/)) {
        _k = substr(_s, RSTART + 2, RLENGTH - 3)
        _s = substr(_s, 1, RSTART - 1) (_k in _V ? _V[_k] : "UNRESOLVED") \
             substr(_s, RSTART + RLENGTH)
      }
      return _s
    }
    BEGIN {
      while ((getline _l < _octo) > 0) {
        if (_l ~ /^export _[A-Za-z0-9_]+=/) {
          _eq = index(_l, "=")
          _n = substr(_l, 8, _eq - 8)
          _v = substr(_l, _eq + 1)
          gsub(/^"|"$/, "", _v)
          _V[_n] = _v
        }
      }
    }
    /^declare -A _distros_profiles_names=\(/ { _sec = "prof"; next }
    /^declare -A _distros_versions=\(/       { _sec = "ver";  next }
    /^declare -A _distros_drupal_cores=\(/   { _sec = "core"; next }
    /^\)/                                    { _sec = "";     next }
    _sec != "" && match($0, /\["[A-Z0-9]+"\]="[^"]*"/) {
      split(substr($0, RSTART, RLENGTH), _a, "\"")
      if (_sec == "prof")     _P[_a[2]] = _a[4]
      else if (_sec == "ver") _R[_a[2]] = _a[4]
      else                    _C[_a[2]] = _a[4]
    }
    END {
      for (_k in _P) {
        if (_mode == "core") {
          if (_k ~ /^D[XE][0-9]$/ || _k == "DL9")
            printf "%s\tdrupal\tdrupal-%s.tar.gz\n", _k, _resolve(_R[_k])
          continue
        }
        if (_k ~ /^D[LXE][0-9]$/ || _k ~ /^BD/ || _k ~ /^UC/ || _k == "CK1" || _k == "GRV" || _k == "TXP") continue
        printf "%s\t%s\t%s-%s-%s.tar.gz\n", \
          _k, _P[_k], _P[_k], _resolve(_R[_k]), _resolve(_C[_k])
      }
    }
  ' "${_tmp}/catalogue" | sort
  rm -rf "${_tmp}"
}

do_catalogue() {
  # $@ = trees, or empty for all of _CATALOGUE_TREES.
  command -v curl >/dev/null 2>&1 || _die "curl not found (needed for the catalogue audit)"
  local _trees="$*" _tree _key _pfx _tar _local _pub _prod _rows _seenprod
  local _missing=0 _unread=0
  [[ -n "${_trees}" ]] || _trees="${_CATALOGUE_TREES}"
  _seenprod="$(_catalogue_producers)"
  for _tree in ${_trees}; do
    _msg ""
    _info "=== catalogue audit: ${_tree} ==="
    _rows="$(_catalogue_rows "${_tree}")"
    if [[ -z "${_rows}" ]]; then
      # Distinct from a missing tarball: we learned nothing about this tree, and
      # reporting that as "0 missing" would be the wrong kind of green.
      _alrt "${_tree}: could not read the published catalogue -- audit INCONCLUSIVE"
      _unread=$((_unread + 1))
      continue
    fi
    printf '  %-5s %-46s %-8s %-8s %s\n' KEY TARBALL PUBLISHED MIRROR PRODUCER
    while IFS=$'\t' read -r _key _pfx _tar; do
      [[ -n "${_key}" ]] || continue
      if [[ -f "${_DISTRO_OUT}/${_tar}" ]]; then _local="yes"; else _local="NO"; fi
      # HEAD is enough and costs no transfer: unlike files.boa.io -- which answers
      # an unknown path with 200 and a placeholder page, so content must be checked
      # there -- the distro mirror returns a real 404, so curl's status is decisive.
      if curl -fsSL -A "${_BOA_UA}" --head -o /dev/null \
        "${_BOA_DISTRO_URL}/${_tar}" 2>/dev/null; then _pub="yes"; else _pub="NO"; fi
      if printf '%s\n' "${_seenprod}" | grep -qx "${_pfx}"; then _prod="yes"; else _prod="none"; fi
      printf '  %-5s %-46s %-8s %-8s %s\n' "${_key}" "${_tar}" "${_local}" "${_pub}" "${_prod}"
      # Only the public fetch is customer-facing: a box never reads _DISTRO_OUT.
      if [[ "${_pub}" != "yes" ]]; then
        _missing=$((_missing + 1))
        _alrt "${_tree}: ${_key} is in the catalogue but ${_tar} is NOT published"
      fi
    done <<< "${_rows}"
  done
  _msg ""
  if [[ "${_missing}" -gt 0 ]] && [[ "${_unread}" -gt 0 ]]; then
    _die "${_missing} catalogue entr(ies) have no published tarball, and ${_unread} tree(s) could not be read"
  elif [[ "${_missing}" -gt 0 ]]; then
    _die "${_missing} catalogue entr(ies) have no published tarball -- retire the key in a shipped release, or publish the build, before the tarball goes away"
  elif [[ "${_unread}" -gt 0 ]]; then
    _die "${_unread} tree(s) could not be read -- audit INCONCLUSIVE, nothing was proven"
  fi
  _info "every catalogue entry has a published tarball"
  _msg "PRODUCER=none means the tarball is hand-published: nothing here rebuilds it,"
  _msg "so it can only be kept current by hand. Retiring such a key must happen in a"
  _msg "shipped release BEFORE the tarball is removed from the mirror."
}

# ---------------------------------------------------------------------------
# Published advisories (read-only). What a box installs is the published tarball,
# and advisories keep arriving after a build, so this audits the shipped locks as
# they are today -- the build-time <platform>.advisories records only what was known
# then. BOA's own o_contrib modules are linked into every D8+ platform outside
# Composer, so no Composer audit sees them: they are listed with their versions.
# ---------------------------------------------------------------------------

_audit_published() {
  # $1 = catalogue tarball name (checked against _TARBALL_RE by the caller), $2 = the
  # mirror it is fetched from, $3 = a sequence number naming this tarball's work
  # dirs: nothing read off the network ever names a path that reaches a shell
  # string. Pulls composer.lock and vendor/composer/installed.json out of the
  # published tarball's stream (tar stops once both are out) and audits them.
  # Output and status as _audit_dir.
  local _tar="$1" _url="$2" _x="${_ADV_TMP}/x$3" _w="${_ADV_TMP}/w$3" _st
  if ! mkdir -p "${_x}" "${_w}"; then
    printf '%s\n' "advisories: unknown (cannot create a work dir)"
    return 1
  fi
  curl -fsSL -A "${_BOA_UA}" "${_url}/${_tar}" 2>/dev/null \
    | tar -xzf - -C "${_x}" --no-same-owner --no-same-permissions \
        --wildcards --no-wildcards-match-slash --occurrence=1 \
        '*/composer.lock' '*/vendor/composer/installed.json' 2>/dev/null
  _st=("${PIPESTATUS[@]}")
  # curl exits 23 when tar stops reading early on purpose; anything else non-zero
  # with a failed tar means the download itself failed.
  if [[ "${_st[1]}" != "0" ]] && [[ "${_st[0]}" != "0" && "${_st[0]}" != "23" ]]; then
    printf '%s\n' "advisories: unknown (download failed, curl exit ${_st[0]})"
    return 1
  fi
  _audit_extracted "${_x}" "${_w}"
}

_audit_extracted() {
  # $1 = dir a platform tarball's composer.lock (and installed.json) was pulled into,
  # $2 = an empty work dir. Audits them there as the invoking user. Output and status
  # as _audit_dir.
  local _x="$1" _w="$2" _top
  # Regular files only: a symlinked member is never followed.
  _top="$(find "${_x}" -mindepth 1 -maxdepth 2 -type f -name composer.lock -printf '%h\n' | head -n 1)"
  if [[ -z "${_top}" ]] || ! cp -- "${_top}/composer.lock" "${_w}/composer.lock"; then
    printf '%s\n' "advisories: unknown (no composer.lock at the top of the tarball)"
    return 1
  fi
  if [[ -f "${_top}/vendor/composer/installed.json" && ! -L "${_top}/vendor/composer/installed.json" ]]; then
    cp -- "${_top}/vendor/composer/installed.json" "${_w}/installed.json" || true
  fi
  _audit_dir "${_w}" _run_self
}

_audit_tarball_file() {
  # $1 = a local platform tarball (in the day dir or on a shelf), $2 = a sequence
  # number naming its work dirs. Output and status as _audit_dir.
  # Its output is captured, so the work dir (_ADV_TMP) is made by the caller.
  local _x _w
  if [[ -z "${_ADV_TMP}" || ! -d "${_ADV_TMP}" ]]; then
    printf '%s\n' "advisories: unknown (no work dir)"
    return 1
  fi
  _x="${_ADV_TMP}/lx$2"
  _w="${_ADV_TMP}/lw$2"
  if ! rm -rf "${_x}" "${_w}" || ! mkdir -p "${_x}" "${_w}"; then
    printf '%s\n' "advisories: unknown (cannot create a work dir)"
    return 1
  fi
  tar -xzf "$1" -C "${_x}" --no-same-owner --no-same-permissions \
    --wildcards --no-wildcards-match-slash --occurrence=1 \
    '*/composer.lock' '*/vendor/composer/installed.json' 2>/dev/null
  _audit_extracted "${_x}" "${_w}"
}

_adv_pairs() {
  # An audit report on stdin: its "advisory<TAB>package" pairs, sorted, one per finding
  # (a repeated pair stays repeated, so comm compares them as multisets).
  awk -F'\t' 'NR > 1 && !/^#/ && NF { print $1 "\t" $2 }' | sort
}

_fix_verdict() {
  # $1 = the published copy's audit report, $2 = the new build's. Prints "fix" when the
  # new lock clears at least one advisory and adds none, else the reason it is not one.
  # A report that is not a finished audit, or whose findings do not all take part in
  # the comparison, proves nothing.
  local _on _nn
  _on="$(sed -n '1s/^advisories: //p' <<< "$1")"
  _nn="$(sed -n '1s/^advisories: //p' <<< "$2")"
  if [[ ! "${_on}" =~ ^[0-9]+$ || ! "${_nn}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "the advisory audit did not run, so nothing proves a fix"
  elif [[ "$(_adv_pairs <<< "$1" | grep -c .)" != "${_on}" || "$(_adv_pairs <<< "$2" | grep -c .)" != "${_nn}" ]]; then
    printf '%s\n' "the audit reports cannot be compared (advisories: mirror ${_on}, this build ${_nn})"
  elif [[ -n "$(comm -13 <(_adv_pairs <<< "$1") <(_adv_pairs <<< "$2"))" ]]; then
    printf '%s\n' "adds advisories the mirror copy lacks (mirror ${_on}, this build ${_nn})"
  elif [[ "${_nn}" -lt "${_on}" ]]; then
    printf '%s\n' "fix"
  else
    printf '%s\n' "fixes nothing (advisories: mirror ${_on}, this build ${_nn})"
  fi
}


_o_contrib_rows() {
  # $1 = tree. Emits "bundle<TAB>module<TAB>version" for every module the D8+
  # o_contrib bundles fetch in the PUBLISHED tree: the _get_dev_contrib literals of
  # satellite.sh.inc's _satellite_download_o_contrib_<n>, with ${_NAME} resolved
  # against the same tree's OCTOPUS.sh.txt exports. Non-zero when unreadable.
  local _tree="$1" _tmp _rc=0
  _tmp="$(mktemp -d)" || return 1
  curl -fsSL -A "${_BOA_UA}" \
    "${_BOA_VERSIONS_URL}/${_tree}/boa/lib/functions/satellite.sh.inc" \
    -o "${_tmp}/satellite" 2>/dev/null || _rc=1
  curl -fsSL -A "${_BOA_UA}" \
    "${_BOA_VERSIONS_URL}/${_tree}/boa/OCTOPUS.sh.txt" \
    -o "${_tmp}/settings" 2>/dev/null || _rc=1
  # files.boa.io answers an unknown path with 200 and a placeholder page, so the
  # content itself must prove the fetch.
  if [[ "${_rc}" != "0" ]] \
    || ! grep -q '^_satellite_download_o_contrib_eleven()' "${_tmp}/satellite" 2>/dev/null \
    || ! grep -q '^export _REDIS_E_VERSION=' "${_tmp}/settings" 2>/dev/null; then
    rm -rf "${_tmp}"
    return 1
  fi
  awk -v _octo="${_tmp}/settings" '
    BEGIN {
      while ((getline _l < _octo) > 0) {
        if (_l ~ /^export _[A-Za-z0-9_]+=/) {
          _eq = index(_l, "=")
          _v = substr(_l, _eq + 1)
          gsub(/^"|"$/, "", _v)
          _V[substr(_l, 8, _eq - 8)] = _v
        }
      }
    }
    /^_satellite_download_o_contrib_(eight|nine|ten|eleven)\(\)/ {
      _b = $1
      sub(/^_satellite_download_/, "", _b)
      sub(/\(\).*$/, "", _b)
      next
    }
    /^}/ { _b = ""; next }
    _b != "" && match($0, /_get_dev_contrib "[^"]+"/) {
      _f = substr($0, RSTART + 18, RLENGTH - 19)
      while (match(_f, /\$\{_[A-Za-z0-9_]+\}/)) {
        _k = substr(_f, RSTART + 2, RLENGTH - 3)
        _f = substr(_f, 1, RSTART - 1) (_k in _V ? _V[_k] : "UNRESOLVED") substr(_f, RSTART + RLENGTH)
      }
      sub(/\.tar\.gz$/, "", _f)
      _i = index(_f, "-")
      if (_i > 1) printf "%s\t%s\t%s\n", _b, substr(_f, 1, _i - 1), substr(_f, _i + 1)
    }
  ' "${_tmp}/satellite"
  rm -rf "${_tmp}"
}

_o_contrib_bundle() {
  # $1 = core version. The o_contrib bundle a platform on that core gets. The nightly
  # linker (night/20-sites.sh) picks it by core feature probe, and the eleven bundle
  # needs workspaces_ui, which core ships from 11.1 on, so 11.0 takes the ten bundle.
  case "$1" in
    8.*)        printf '%s\n' eight ;;
    9.*)        printf '%s\n' nine ;;
    10.*|11.0.*) printf '%s\n' ten ;;
    11.*)       printf '%s\n' eleven ;;
  esac
}

do_advisories() {
  # $@ = trees, or empty for all of _CATALOGUE_TREES. One row per published tarball
  # with the trees that list it and its advisory count; the advisory ids only with
  # --debug (every tarball's are in the audit it prints then). Exits non-zero only when
  # a tree, a tarball or the o_contrib set could not be audited: advisories themselves
  # are reported, never fatal.
  local _t
  for _t in curl tar composer php; do
    command -v "${_t}" >/dev/null 2>&1 || _die "${_t} not found (needed for the advisories audit)"
  done
  local _trees="$*" _tree _key _pfx _tar _url _rows _crows _all _res _n _f _id _cell _core _bundle _keys _mods
  local _unread=0 _failed=0 _hit=0 _clean=0 _seq=0 _ocsame=1 _octrees _inoc
  local -a _order=()
  local -A _intree=() _urlof=() _oc=()
  [[ -n "${_trees}" ]] || _trees="${_CATALOGUE_TREES}"
  _ADV_TMP="$(mktemp -d)" || _die "cannot create a work dir"
  for _tree in ${_trees}; do
    _rows="$(_catalogue_rows "${_tree}")"
    _crows="$(_catalogue_rows "${_tree}" core)"
    if [[ -z "${_rows}" ]] || [[ -z "${_crows}" ]]; then
      _alrt "${_tree}: could not read the published catalogue -- audit INCONCLUSIVE"
      _unread=$((_unread + 1))
      continue
    fi
    # One list, each row tagged with the mirror its tarball comes from.
    _all="$(awk -v _u="${_BOA_DISTRO_URL}" 'NF { print $0 "\t" _u }' <<< "${_rows}"
      awk -v _u="${_BOA_CORE_URL}" 'NF { print $0 "\t" _u }' <<< "${_crows}")"
    while IFS=$'\t' read -r _key _pfx _tar _url; do
      [[ -n "${_key}" ]] || continue
      _id="${_key}"$'\t'"${_tar}"
      [[ -n "${_intree[${_id}]:-}" ]] || _order+=("${_id}")
      _intree[${_id}]+="${_intree[${_id}]:+ }${_tree}"
      _urlof[${_id}]="${_url}"
    done <<< "${_all}"
    _oc[${_tree}]="$(_o_contrib_rows "${_tree}")"
    if [[ -z "${_oc[${_tree}]}" ]]; then
      _alrt "${_tree}: could not read the o_contrib versions of the published tree -- INCONCLUSIVE"
      _unread=$((_unread + 1))
    fi
  done
  _msg ""
  _info "=== published advisories: ${_trees} ==="
  printf '  %-5s %-46s %-12s %s\n' KEY TARBALL TREES ADVISORIES
  for _id in "${_order[@]}"; do
    _key="${_id%%$'\t'*}"
    _tar="${_id#*$'\t'}"
    if [[ ! "${_tar}" =~ ${_TARBALL_RE} ]]; then
      # The name came off the network: show it only as safe characters.
      printf '  %-5s %-46s %-12s %s\n' "${_key}" "${_tar//[^A-Za-z0-9._+-]/?}" "${_intree[${_id}]}" "NOT AUDITED (unexpected name)"
      _failed=$((_failed + 1))
      continue
    fi
    # Audit each tarball once: the trees mostly ship the same ones.
    _f="${_ADV_TMP}/${_tar}.res"
    if [[ ! -f "${_f}" ]]; then
      _seq=$((_seq + 1))
      _audit_published "${_tar}" "${_urlof[${_id}]}" "${_seq}" > "${_f}" < /dev/null
      case "$(sed -n '1s/^advisories: //p' "${_f}")" in
        0)      _clean=$((_clean + 1)) ;;
        [0-9]*) _hit=$((_hit + 1)) ;;
        *)      _failed=$((_failed + 1)) ;;
      esac
    fi
    _res="$(cat "${_f}")"
    _n="$(sed -n '1s/^advisories: //p' <<< "${_res}")"
    case "${_n}" in
      [0-9]*) _cell="${_n}" ;;
      *)      _cell="NOT AUDITED (${_n#unknown })" ;;
    esac
    printf '  %-5s %-46s %-12s %s\n' "${_key}" "${_tar}" "${_intree[${_id}]}" "${_cell}"
    if [[ "${_DEBUG_MODE}" == "YES" && ! -e "${_f}.shown" ]]; then
      sed '1d' <<< "${_res}" \
        | awk -F'\t' 'NF && !/^#/ { printf "        %-22s %-36s %-16s %s\n", $1, $2, $3, $4 }'
      : > "${_f}.shown"
    fi
  done
  _msg "  DL6 DL7: BOA's own Drupal 6/7 core forks, outside Composer; not audited here."
  # BOA's own contrib, per o_contrib bundle, printed once when every tree agrees.
  _octrees=""
  for _tree in ${_trees}; do
    [[ -n "${_oc[${_tree}]:-}" ]] || continue
    if [[ -n "${_octrees}" && "${_oc[${_tree}]}" != "${_oc[${_octrees%% *}]}" ]]; then
      _ocsame=0
    fi
    _octrees+="${_octrees:+ }${_tree}"
  done
  if [[ -n "${_octrees}" ]]; then
    _msg ""
    _msg "  Outside Composer: BOA's own contrib in every D8+ platform; check it against drupal.org's advisories:"
    for _tree in ${_octrees}; do
      for _bundle in eight nine ten eleven; do
        _keys=""
        for _id in "${_order[@]}"; do
          _inoc=""
          for _t in ${_octrees}; do
            [[ " ${_intree[${_id}]} " == *" ${_t} "* ]] && _inoc="YES"
          done
          [[ -n "${_inoc}" ]] || continue
          [[ "${_ocsame}" == "1" || " ${_intree[${_id}]} " == *" ${_tree} "* ]] || continue
          _tar="${_id#*$'\t'}"
          _core="${_tar%.tar.gz}"
          _core="${_core##*-}"
          [[ "$(_o_contrib_bundle "${_core}")" == "${_bundle}" ]] && _keys+="${_keys:+ }${_id%%$'\t'*}"
        done
        _mods="$(awk -F'\t' -v _b="o_contrib_${_bundle}" \
          '$1 == _b { printf "%s%s %s", (_c++ ? ", " : ""), $2, $3 }' <<< "${_oc[${_tree}]}")"
        [[ -n "${_keys}" && -n "${_mods}" ]] || continue
        if [[ "${_ocsame}" == "1" ]]; then
          _msg "    o_contrib_${_bundle} (${_keys}): ${_mods}"
        else
          _msg "    ${_tree}: o_contrib_${_bundle} (${_keys}): ${_mods}"
        fi
      done
      [[ "${_ocsame}" == "1" ]] && break
    done
  fi
  _msg ""
  _info "platform tarballs audited: $((_clean + _hit + _failed)); with advisories: ${_hit}; clean: ${_clean}; not audited: ${_failed}"
  [[ "${_DEBUG_MODE}" == "YES" ]] || _msg "advisory ids per tarball: staticbuild --debug advisories"
  if [[ "${_unread}" -gt 0 ]] || [[ "${_failed}" -gt 0 ]]; then
    _die "audit INCONCLUSIVE: ${_unread} tree part(s) unreadable, ${_failed} tarball(s) not audited"
  fi
}

# ---------------------------------------------------------------------------
# Summary + dispatch.
# ---------------------------------------------------------------------------

print_summary() {
  # One row per platform: what was built, how many advisories its lock still carries
  # (and how many the fix step cleared), what happened on the mirror, and a note only
  # when the row needs attention. The detail is in the run log and the .advisories
  # files; the footer holds only the command for refused tarballs and the end of a
  # failed build's log.
  _progress_end
  if [[ "${#_P_KEYS[@]}" -eq 0 ]]; then
    [[ -n "${_LOG}" ]] && _say "nothing was built or published (full log: ${_LOG})"
    return 0
  fi
  local _k _n _w=8 _refused="" _t
  for _k in "${_P_KEYS[@]}"; do
    _n="${_P_NAME[${_k}]:-${_k}}"
    [[ "${#_n}" -gt "${_w}" ]] && _w="${#_n}"
  done
  _say ""
  _say "$(printf '%-*s  %-5s  %-14s  %-11s  %s' "${_w}" PLATFORM BUILD ADVISORIES PUBLISH NOTE)"
  for _k in "${_P_KEYS[@]}"; do
    _say "$(printf '%-*s  %-5s  %-14s  %-11s  %s' "${_w}" "${_P_NAME[${_k}]:-${_k}}" \
      "${_P_BUILD[${_k}]:--}" "${_P_ADV[${_k}]:--}" "${_P_PUB[${_k}]:--}" "${_P_NOTE[${_k}]:-}" \
      | sed 's/[[:space:]]*$//')"
    [[ "${_P_PUB[${_k}]:-}" == "REFUSED" ]] && _refused+=" ${_k}"
  done
  if [[ -n "${_refused}" ]]; then
    _say ""
    _say "to publish the refused anyway: staticbuild -u ${_O8_USER} -d ${_DAY} -O distribute${_refused}"
  fi
  for _k in "${_P_KEYS[@]}"; do
    [[ "${_P_BUILD[${_k}]:-}" == "FAIL" && -n "${_P_TAIL[${_k}]:-}" ]] || continue
    _say ""
    _say "${_k} failed; the end of its log:"
    while IFS= read -r _t; do
      _say "  | ${_t}"
    done <<< "${_P_TAIL[${_k}]}"
  done
}

usage() {
  # Print the leading comment block (from line 3) up to the first non-comment line.
  awk 'NR<3{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
}

main() {
  local _opt
  # getopts has no long options; "-:" takes --debug as option "-" with OPTARG "debug".
  while getopts ':d:u:fCOh-:' _opt; do
    case "${_opt}" in
      -)
        case "${OPTARG}" in
          debug) _DEBUG_MODE=YES ;;
          *)     _die "unknown option --${OPTARG} (try -h)" ;;
        esac
        ;;
      d) _DAY="${OPTARG}" ;;
      u) _O8_USER="${OPTARG}" ;;
      f) _FORCE=1 ;;
      C) _SKIP_CLEARCACHE=1 ;;
      O) _OVERWRITE=1 ;;
      h) usage; exit 0 ;;
      :) _die "option -${OPTARG} requires an argument" ;;
      *) _die "unknown option -${OPTARG} (try -h)" ;;
    esac
  done
  shift "$((OPTIND - 1))"

  local _action="${1:-}"
  [[ -n "${_action}" ]] || { usage; exit 1; }
  _ACTION="${_action}"
  shift || true

  # getopts stops at the first non-option word, so options placed after the action
  # are not parsed; reject them rather than misread one as a target name.
  local _a
  for _a in "$@"; do
    [[ "${_a}" == -* ]] && _die "options must precede the action (got '${_a}'); e.g. staticbuild -f ${_action} ..."
  done

  # Recompute derived paths after option parsing.
  _DAY_DIR="${_STATIC_ROOT}/${_O8_USER}/static/${_DAY}"

  # -O names what it may overwrite: only distribute takes it, with the platforms
  # listed after the action, so a routine run never inherits it.
  if [[ "${_OVERWRITE}" == "1" && "${_action}" != "distribute" ]]; then
    _die "-O works only as: staticbuild -O distribute <platform> ..."
  fi

  case "${_action}" in
    check)
      do_check
      exit 0
      ;;
    catalogue)
      # Read-only audit: no root, no lock, no build user needed.
      do_catalogue "$@"
      exit 0
      ;;
    advisories)
      # Read-only audit: no root, no lock, no build user needed; the trap only
      # removes its work dir.
      trap '_cleanup' EXIT
      do_advisories "$@"
      exit 0
      ;;
    backdrop)
      # Lightweight Backdrop-family build+package+publish (no Composer, no php
      # switch). Needs root (mirror writes) + an Octopus user (_run_as_o8).
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      _start_log backdrop
      _say "staticbuild backdrop: ${_DAY_DIR}${_LOG:+ (log: ${_LOG})}"
      do_backdrop_family
      print_summary
      ;;
    grav)
      # Lightweight Grav build+package+publish (official admin bundle; no
      # Composer, no php switch). Needs root + an Octopus user.
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      _start_log grav
      _say "staticbuild grav: ${_DAY_DIR}${_LOG:+ (log: ${_LOG})}"
      do_grav_family
      print_summary
      ;;
    txp|textpattern)
      # Lightweight Textpattern build+package+publish (official release
      # tarball; no Composer, no php switch). Needs root + an Octopus user.
      _require_root
      _require_o8
      trap '_cleanup' EXIT
      _acquire_lock
      _start_log txp
      _say "staticbuild txp: ${_DAY_DIR}${_LOG:+ (log: ${_LOG})}"
      do_txp_family
      print_summary
      ;;
    build|package|distribute|all)
      if [[ "${_action}" == "distribute" ]]; then
        if [[ "${_OVERWRITE}" == "1" ]]; then
          [[ "$#" -gt 0 ]] || _die "-O needs the platform(s) to overwrite: staticbuild -O distribute <platform> ..."
          local _p
          for _p in "$@"; do
            _p="${_p%.tar.gz}.tar.gz"
            [[ "${_p}" =~ ${_TARBALL_RE} ]] || _die "not a platform tarball name: ${_p}"
            [[ -f "${_DAY_DIR}/${_p}" ]] || _die "${_p} is not in ${_DAY_DIR}"
            _OVERWRITE_NAMES+="${_p} "
          done
          set --
        elif [[ "$#" -gt 0 ]]; then
          _die "distribute takes platform names only with -O"
        fi
      fi
      _require_root
      _require_o8
      _require_composer
      trap '_cleanup' EXIT
      _acquire_lock
      # /usr/bin/php must be a symlink we can swap and restore. Refuse to clobber a
      # real binary; if it is absent, remember to remove the link we create.
      if [[ -e "${_SYS_PHP}" && ! -L "${_SYS_PHP}" ]]; then
        _die "${_SYS_PHP} exists but is not a symlink; refusing to clobber it"
      fi
      if [[ -L "${_SYS_PHP}" ]]; then
        _PHP_ORIG="$(readlink "${_SYS_PHP}" 2>/dev/null)"
        [[ -n "${_PHP_ORIG}" ]] || _die "cannot read current ${_SYS_PHP} symlink target"
      else
        _PHP_LINK_CREATED=1
      fi
      _start_log "${_action}"
      _say "staticbuild ${_action}: ${_DAY_DIR}${_LOG:+ (log: ${_LOG})}"
      case "${_action}" in
        build)      do_build "$@" ;;
        package)    do_package ;;
        distribute) do_distribute ;;
        all)        do_build; do_package; do_distribute ;;
      esac
      print_summary
      # A refusal is the guard working: its own status, apart from a fatal error (1).
      # Per-target FAIL rows are reported in the summary only, as before.
      if [[ "${_REFUSED}" -gt 0 ]]; then
        _msg "${_REFUSED} tarball(s) left unpublished: same name, changed lock, adds advisories or not verified"
        exit 3
      fi
      ;;
    *)
      _die "unknown action '${_action}' (try -h)"
      ;;
  esac
}

main "$@"
