#!/bin/bash

# apt-fast v1.5 by Matt Parnell http://www.mattparnell.com, GNU GPLv3
# BOA-compatible patched variant:
# - keeps aptitude as the final package manager
# - uses apt-get only for --print-uris
# - translates aptitude-only --allow-untrusted to apt-get --allow-unauthenticated
# - translates aptitude full-upgrade/safe-upgrade for apt-get URI preview only
# - quotes variables and preserves original arguments safely

###################################################################
# CONFIGURATION OPTIONS                                           #
###################################################################

# Maximum number of connections
_MAXNUM=5

# Download manager selection

# aria2c:
#_DOWNLOADER='aria2c -c -j ${_MAXNUM} --input-file=/opt/tmp/apt-fast.list --connect-timeout=600 --timeout=600 -m0'

# aria2c with a proxy:
#_DOWNLOADER='aria2c -s 20 -j ${_MAXNUM} --http-proxy=http://username:password@proxy_ip:proxy_port -i /opt/tmp/apt-fast.list'

# axel:
_DOWNLOADER='cat /opt/tmp/apt-fast.list | xargs -r -l1 axel -n ${_MAXNUM} -a'

###################################################################
# DO NOT EDIT BELOW THIS LINE UNLESS YOU KNOW WHAT YOU ARE DOING! #
###################################################################

_LCK_FILE="/var/lock/apt-fast.lck"
_URI_LIST="/opt/tmp/apt-fast.list"
_APT_CACHE_DIR="/var/cache/apt/archives"

_unlock()
{
  rm -f "${_LCK_FILE}"
}

_die()
{
  echo "aptfast: ${1}" >&2
  _unlock
  exit 1
}

# Check for proper privileges.
if [ "$(whoami)" != "root" ]; then
  exec sudo "$0" "$@"
fi

trap 'if [ -f "${_LCK_FILE}" ]; then _unlock; fi' 0 1 2 3 13 15

# Basic lock protection.
if [ -f "${_LCK_FILE}" ]; then
  echo "aptfast: lock file exists: ${_LCK_FILE}" >&2
  echo "aptfast: another aptfast process may already be running." >&2
  exit 1
fi

touch "${_LCK_FILE}" || _die "cannot create lock file: ${_LCK_FILE}"

# Make sure one of the download managers is enabled.
if [ -z "${_DOWNLOADER}" ]; then
  _die "you must configure apt-fast to use axel or aria2c"
fi

mkdir -p "/opt/tmp" || _die "cannot create /opt/tmp"

_ORIG_ARGS=( "$@" )
_APTGET_ARGS=()

# Prepare arguments for apt-get --print-uris.
#
# The final install/upgrade is still performed by aptitude with the original
# arguments, but apt-get is used to print package URIs for parallel download.
#
# aptitude option:
#   --allow-untrusted
#
# apt-get equivalent:
#   --allow-unauthenticated
#
# aptitude action:
#   full-upgrade
#
# apt-get equivalent for URI preview:
#   dist-upgrade
#
# aptitude action:
#   safe-upgrade
#
# apt-get equivalent for URI preview:
#   upgrade
#
for _ARG in "${_ORIG_ARGS[@]}"; do
  case "${_ARG}" in
    --allow-untrusted)
      _APTGET_ARGS+=( "--allow-unauthenticated" )
      ;;
    full-upgrade)
      _APTGET_ARGS+=( "dist-upgrade" )
      ;;
    safe-upgrade)
      _APTGET_ARGS+=( "upgrade" )
      ;;
    *)
      _APTGET_ARGS+=( "${_ARG}" )
      ;;
  esac
done

# If the user entered arguments contain upgrade, full-upgrade, safe-upgrade,
# install, or dist-upgrade, pre-download packages using apt-get --print-uris.
if printf '%s\n' "${_ORIG_ARGS[@]}" | grep -Eq '^(upgrade|full-upgrade|safe-upgrade|install|dist-upgrade)$'; then
  echo "Working..."

  cd "${_APT_CACHE_DIR}" || _die "cannot enter ${_APT_CACHE_DIR}"

  : > "${_URI_LIST}" || _die "cannot write ${_URI_LIST}"

  apt-get -y --print-uris "${_APTGET_ARGS[@]}" \
    | grep -Eo "(https?|ftp)://[^']+" > "${_URI_LIST}"

  if [ -s "${_URI_LIST}" ]; then
    eval "${_DOWNLOADER}"
  fi

  aptitude "${_ORIG_ARGS[@]}"

  _APT_STATUS="${?}"

  echo -e "\nDone!\nVerify that all packages were installed successfully.\nIf errors are found, run aptitude clean as root\nand try again using aptitude directly.\n"

  exit "${_APT_STATUS}"
else
  aptitude "${_ORIG_ARGS[@]}"
  exit "${?}"
fi
