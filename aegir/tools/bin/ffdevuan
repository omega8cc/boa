#!/bin/bash

#
# Devuan mirrors → flat list for speed testing + apt sources rendering
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    chmod a+w /dev/null
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

# ===== Tunables ==============================================================
_MIRROR_SRC_URL="https://pkgmaster.devuan.org/mirror_list.txt"
# To use an already-downloaded file, set _MIRROR_SRC_FILE=/path/to/mirror_list.txt
_MIRROR_SRC_FILE="${_MIRROR_SRC_FILE:-}"

# Default suite for probing and for rendered sources.list
_SUITE_DEFAULT="${_SUITE_DEFAULT:-daedalus}"

# Reputation policy (from Devuan metadata)
_REQUIRE_DNSRR="NO"              # if YES, require DNSRR: yes
_REQUIRE_DNSRR_OR_CC="YES"       # if YES, require DNSRR: yes OR DNSRRCC: yes (recommended)

# Transport policy
_REQUIRE_HTTPS="YES"             # if YES, drop mirrors without HTTPS
_PROTOCOL_PREFERENCE="HTTPS"     # currently used only for clarity; we pick https if available

# Bandwidth policy
_MIN_MBPS="${_MIN_MBPS:-500}"    # drop mirrors reporting < 500 Mbps (approx) after normalization
_REJECT_IF_BW_NONE="YES"         # drop mirrors with Bandwidth: None/empty/unknown

# Quick live reliability probe
_REQUIRE_QUICK_PROBE="YES"       # if YES, try fetching 1 byte of Release; drop on timeout/SSL errors
_PROBE_TIMEOUT="${_PROBE_TIMEOUT:-5}"  # seconds per probe

# Static blacklist (comma-separated substrings matched vs FQDN or BaseURL), case-insensitive
_BLACKLISTED_MIRRORS="${_BLACKLISTED_MIRRORS:-mirror.abmanagement.al}"

# Output: flat list for ffmirror tester (one URL per line)
_FF_LIST="${_FF_LIST:-/var/log/boa/devaun-fast-mirrors-list.txt}"

# Curl commands
_CURL="curl -fsSL"
_CURL_HEAD="curl -fsSL -I"

# ===== Internals / temp files ===============================================
_TMP_DIR="$(mktemp -d)"
_RAW_LIST="${_TMP_DIR}/mirror_list.txt"

_cleanup() { rm -rf "${_TMP_DIR}" 2>/dev/null || true; }
trap _cleanup EXIT

# ===== Helpers ==============================================================

# Convert "Bandwidth: ..." to rough Mbps integer; unknown→0
_convert_bandwidth_to_mbps() {
  _bw_raw="$1"
  _bw_norm="$(printf '%s' "${_bw_raw}" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"

  case "${_bw_norm}" in
    *nolimit*|*unlimit*|*fewgb*|*10g*|*20g*|*26g*)
      echo 10000; return 0 ;;
  esac

  # Extract numeric part and unit
  _num="$(printf '%s' "${_bw_norm}" | sed -E 's/^([^0-9]*)([0-9]+(\.[0-9]+)?).*/\2/')" || true
  _unit="$(printf '%s' "${_bw_norm}" | sed -nE 's/.*([kmgt]?b(ps)?|[kmgt]?bit\/s).*/\1/p')" || true

  if [ -z "${_num:-}" ]; then
    echo 0; return 0
  fi

  _mbps="0"
  case "${_unit:-}" in
    g* ) _mbps="$(awk -v n="${_num}" 'BEGIN{printf "%.0f", n*1000}')" ;;
    m* ) _mbps="$(awk -v n="${_num}" 'BEGIN{printf "%.0f", n}')" ;;
    k* ) _mbps="$(awk -v n="${_num}" 'BEGIN{printf "%.0f", n/1000}')" ;;
    *  ) _mbps="$(awk -v n="${_num}" 'BEGIN{printf "%.0f", n}')" ;;
  esac
  echo "${_mbps}"
}

# Reputation gate based on Devuan metadata flags
_reputation_ok() {
  _dnsrr="$1"; _dnsrrcc="$2"
  _dnsrr_lc="$(printf '%s' "${_dnsrr}" | tr '[:upper:]' '[:lower:]')"
  _dnsrrcc_lc="$(printf '%s' "${_dnsrrcc}" | tr '[:upper:]' '[:lower:]')"

  if [ "${_REQUIRE_DNSRR}" = "YES" ] && [ "${_dnsrr_lc}" != "yes" ]; then
    return 1
  fi
  if [ "${_REQUIRE_DNSRR_OR_CC}" = "YES" ]; then
    if [ "${_dnsrr_lc}" = "yes" ] || [ "${_dnsrrcc_lc}" = "yes" ]; then
      return 0
    else
      return 1
    fi
  fi
  return 0
}

# Prefer HTTPS if listed; allow HTTP only if policy permits
_pick_scheme() {
  _protocols="$1"
  _p_lc="$(printf '%s' "${_protocols}" | tr '[:upper:]' '[:lower:]')"
  if echo "${_p_lc}" | grep -q "https"; then
    echo "https"; return 0
  fi
  if [ "${_REQUIRE_HTTPS}" = "YES" ]; then
    echo ""; return 0
  fi
  echo "http"
}

# Detect repo root by probing Release ("/merged" → "/devuan" → "")
_detect_repo_root() {
  _scheme="$1"; _base="$2"; _suite="${3:-${_SUITE_DEFAULT}}"

  _b="${_base#http://}"; _b="${_b#https://}"

  _try() {
    _path="$1"
    _url="${_scheme}://${_b}${_path}/dists/${_suite}/Release"
    _code="$(${_CURL_HEAD} --max-time "${_PROBE_TIMEOUT}" -o /dev/null -w '%{http_code}' "${_url}" || true)"
    if [ "${_code}" = "200" ] || [ "${_code}" = "301" ] || [ "${_code}" = "302" ]; then
      printf '%s' "${_path}"; return 0
    fi
    return 1
  }

  _try "/merged" && return 0
  _try "/devuan" && return 0
  _try "" && return 0

  echo ""; return 1
}

# Tiny GET to catch SSL/timeouts; returns 0 if ok
_quick_probe_release() {
  _fullbase="$1"   # e.g. https://mirror/foo
  _suite="${2:-${_SUITE_DEFAULT}}"
  ${_CURL} --max-time "${_PROBE_TIMEOUT}" -r 0-0 \
    "${_fullbase}/dists/${_suite}/Release" >/dev/null 2>&1
}

# ===== Fetch the mirror list =================================================
if [ -n "${_MIRROR_SRC_FILE}" ]; then
  cp -f "${_MIRROR_SRC_FILE}" "${_RAW_LIST}"
else
  ${_CURL} "${_MIRROR_SRC_URL}" > "${_RAW_LIST}"
fi

# ===== Parse blocks ==========================================================
_FQDN=""
_BASEURL=""
_PROTOCOLS=""
_ACTIVE=""
_DNSRR=""
_DNSRRCC=""
_BANDWIDTH=""

_ACCEPTED_URLS=""

_process_block() {
  # Minimal fields required
  if [ -z "${_FQDN}" ] || [ -z "${_BASEURL}" ]; then
    return 0
  fi

  # Active?
  _act_lc="$(printf '%s' "${_ACTIVE}" | tr '[:upper:]' '[:lower:]')"
  if [ "${_act_lc}" != "yes" ]; then
    return 0
  fi

  # Static blacklist
  if [ -n "${_BLACKLISTED_MIRRORS}" ]; then
    _ifs_save="${IFS}"; IFS=","
    for _bad in ${_BLACKLISTED_MIRRORS}; do
      IFS="${_ifs_save}"
      _bad_trim="$(printf '%s' "${_bad}" | xargs)"
      if [ -n "${_bad_trim}" ] && echo "${_FQDN} ${_BASEURL}" | grep -qi "${_bad_trim}"; then
        return 0
      fi
    done
    IFS="${_ifs_save}"
  fi

  # Scheme selection
  _scheme="$(_pick_scheme "${_PROTOCOLS}")"
  if [ -z "${_scheme}" ]; then
    return 0
  fi

  # Reputation (Devuan metadata)
  if ! _reputation_ok "${_DNSRR}" "${_DNSRRCC}"; then
    return 0
  fi

  # Bandwidth normalization & policy
  _bw_mbps="$(_convert_bandwidth_to_mbps "${_BANDWIDTH}")"
  if [ "${_REJECT_IF_BW_NONE}" = "YES" ]; then
    _bw_lc="$(printf '%s' "${_BANDWIDTH}" | tr '[:upper:]' '[:lower:]')"
    if [ -z "${_BANDWIDTH}" ] || [ "${_bw_lc}" = "none" ] || [ "${_bw_mbps}" -eq 0 ]; then
      return 0
    fi
  fi
  if [ "${_bw_mbps}" -lt "${_MIN_MBPS}" ]; then
    return 0
  fi

  # Detect repo root path (merged/devuan/bare)
  _root_path="$(_detect_repo_root "${_scheme}" "${_BASEURL}" "${_SUITE_DEFAULT}")" || true
  if [ -z "${_root_path}" ]; then
    return 0
  fi

  # Build apt base
  _b="${_BASEURL#http://}"; _b="${_b#https://}"
  _apt_base="${_scheme}://${_b}${_root_path}"

  # Quick reliability probe (cheap)
  if [ "${_REQUIRE_QUICK_PROBE}" = "YES" ]; then
    if ! _quick_probe_release "${_apt_base}" "${_SUITE_DEFAULT}"; then
      return 0
    fi
  fi

  # Append unique
  if ! printf '%s\n' "${_ACCEPTED_URLS}" | grep -qx "${_apt_base}"; then
    _ACCEPTED_URLS="$(printf '%s\n%s\n' "${_ACCEPTED_URLS}" "${_apt_base}" | sed '/^$/d')"
  fi
}

# Walk file, blocks separated by blank lines
while IFS= read -r _line || [ -n "${_line}" ]; do
  if [ -z "${_line}" ]; then
    _process_block
    _FQDN=""; _BASEURL=""; _PROTOCOLS=""; _ACTIVE=""; _DNSRR=""; _DNSRRCC=""; _BANDWIDTH=""
    continue
  fi

  case "${_line}" in
    FQDN:*)       _FQDN="$(printf '%s' "${_line#FQDN:}" | xargs)" ;;
    BaseURL:*)    _BASEURL="$(printf '%s' "${_line#BaseURL:}" | xargs)" ;;
    Protocols:*)  _PROTOCOLS="$(printf '%s' "${_line#Protocols:}" | xargs)" ;;
    Active:*)     _ACTIVE="$(printf '%s' "${_line#Active:}" | xargs)" ;;
    DNSRR:*)      _DNSRR="$(printf '%s' "${_line#DNSRR:}" | xargs)" ;;
    DNSRRCC:*)    _DNSRRCC="$(printf '%s' "${_line#DNSRRCC:}" | xargs)" ;;
    Bandwidth:*)  _BANDWIDTH="$(printf '%s' "${_line#Bandwidth:}" | xargs)" ;;
    # Other fields are ignored for filtering: Country, Rate, etc.
  esac
done < "${_RAW_LIST}"
# Process last block if file doesn't end with newline
_process_block

# ===== Emit the flat list ====================================================
mkdir -p "$(dirname "${_FF_LIST}")"
# Stable sorted unique list
printf '%s\n' "${_ACCEPTED_URLS}" | LC_ALL=C sort -u > "${_FF_LIST}"

if [ -s "${_FF_LIST}" ]; then
  echo "OK: wrote $(wc -l < "${_FF_LIST}") mirrors to ${_FF_LIST}"
  exit 0
else
  echo "No mirrors matched given policy."
  exit 1
fi
