#!/bin/bash

###
### xmass — Full BOA system migration via MySQL GTID replication + rsync
###
### For single-account migrations (and cross-Percona-version migrations) use xoct.
### xmass requires identical Percona MySQL versions on both servers and always
### migrates ALL Octopus instances and all Solr cores in a single operation.
###
### Usage:
###   xmass pre-mig <source-fqdn>                   (run on BOTH source and target)
###   xmass init    <target-ip> [--proxy-mode=temporary|permanent|ha-switch]
###                             [--proxy-deadline=YYYY-MM-DD|+Nd]   (run on SOURCE)
###   xmass sync    <target-ip> [--live]             (run on SOURCE, repeat as needed)
###   xmass status  <target-ip>                      (run on SOURCE)
###   xmass cutover <target-ip> [--proxy-mode=...] [--proxy-deadline=...] [--live]
###   xmass post-mig                                 (run on TARGET after DNS update)
###   xmass reset-phase <phase>                      (run on SOURCE; recovery only)
###
### Proxy modes are per ACCOUNT, not per box: --proxy-mode writes only the box
### DEFAULT (/data/conf/migproxy_mode.txt); a per-account pin set with
### 'xoct proxy-mode <oN> <mode>' always wins over it. --permanent-proxy is a
### deprecated alias for --proxy-mode=permanent.
###
### DRY/live gate: `sync` and `cutover` default to a read-only DRY run that resolves
### the target's attached mount, plans every storage decision (mirror onto the target
### mount vs de-reference to root) for ALL accounts + shared, checks space, and records
### CLEAN/NOT_CLEAN in a per-target state file. Re-run with --live to perform the
### migration; --live is accepted only after a CLEAN dry run for the same target and
### consumes that token (one dry can never arm two lives).
###
### Procedure overview:
###   1. pre-mig      Stop BOA background jobs; exchange SSH keys.
###   2. init         Install xtrabackup, enable GTID, take initial snapshot,
###                   restore on target, start replication slave.
###   3. sync         Rsync platforms, files, configs, Solr to target (repeatable).
###   4. status       Show replication lag and last sync time.
###   5. cutover      Block web, stop Solr, final sync, wait for lag=0,
###                   promote target, run renameaegirhost on target,
###                   convert source to proxy.
###   6. post-mig     Ensure Solr/nginx/cron are healthy on target.
###

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

### Match the box's installed BOA tree (see the same derivation in xoct):
### hardcoded dev would route any tree-sensitive action through the
### dev-license gate on lts boxes. Self-report first, ctrl marker fallback,
### historical dev default last.
_tRee=$(boa info 2>/dev/null \
  | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
  | tail -1 \
  | grep -oE '(dev|lts|pro)$')
if [ -z "${_tRee}" ]; then
  _tRee=$(ls -t /var/log/boa/*.ctrl.* 2>/dev/null \
    | head -1 \
    | grep -oE '\.(dev|lts|pro)\.' \
    | tr -d '.')
fi
[ -z "${_tRee}" ] && _tRee=dev
export _tRee
_xSrl=$(boa info 2>/dev/null \
  | grep -oE "BOA-[0-9.]+-${_tRee}-[0-9a-zA-Z]+" \
  | tail -1 \
  | awk -F- '{ print $NF }')
[ -z "${_xSrl}" ] && _xSrl="588811${_tRee}T01"
export _xSrl

export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
if [ -z "${TERM+x}" ]; then
  export TERM=vt100
fi

###-------------CONSTANTS------------------###

_XMASS_STATE_FILE="/data/conf/xmass_state.cnf"
_REPL_USER="xmass_repl"
_XTRA_STAGE_SRC="/var/backups/xmass_stage"
_XTRA_STAGE_TGT="/var/backups/xmass_restore"
_SOLR_DENY_FILE="/root/.deny.java.cnf"
_XMASS_SOLR_HOLD_FILE="/var/log/boa/.xmass_solr_hold.pid"
_PERM_PROXY_FLAG="/data/conf/xmass_permanent_proxy.pid"
_ieni="--ignore-errors"

### Replica catch-up ceiling for the cutover, in seconds. Percona 5.7 applies the
### relay log single-threaded unless slave_parallel_workers is set, so one large
### purge or index rebuild on a busy source can need far longer than the former
### hardcoded 1800s -- and that abort landed mid-outage with the web already
### blocked. Raise or lower per run by exporting _XMASS_SYNC_MAX_WAIT.
_XMASS_SYNC_MAX_WAIT="${_XMASS_SYNC_MAX_WAIT:-7200}"

### Set non-zero by _xmass_rsync when a transfer fails. Gated before every
### destructive step so a truncated tree can never reach the target promote.
_XMASS_RSYNC_RC=0

###-------------HELPERS--------------------###

_info() {
  echo "INFO: $*"
}

_alrt() {
  echo "ALRT: $*"
}

_die() {
  echo "ERROR: $*"
  exit 1
}

###-------------MIGRATION PROXY POLICY-###
###
### Mirrors xoct's migration-proxy policy primitives -- master and satellite
### copies are kept in step, not DRY-ed (the two tools ship and fetch
### independently). ONE deliberate difference: this _mig_resolve never runs
### the legacy-orphan sweep (xmass resolves inside read-only DRY runs, and
### the sweep writes), so the live paths call _mig_sweep_legacy explicitly.
### It also honours _MIG_BOX_MODE_OVERRIDE/_MIG_BOX_DEADLINE_OVERRIDE so a
### DRY cutover can simulate the box default its --live would write without
### touching disk.
###
_MIG_CNF_NAME="log/migproxy.cnf"
_MIG_BOX_MODE_FILE="/data/conf/migproxy_mode.txt"
_MIG_BOX_DEADLINE_FILE="/data/conf/migproxy_deadline.txt"
# The retired touch/rm pair around the old _PERM_PROXY_FLAG is gone; the file
# can only exist as the orphan of a cutover that died between those lines, and
# the sweep below converts it once into the box default it meant to express.
_MIG_LEGACY_ORPHAN="${_PERM_PROXY_FLAG}"

_mig_get() {
  local _f="$1" _k="$2"
  [ -r "${_f}" ] || return 1
  grep -m1 "^${_k}=" "${_f}" 2>/dev/null | cut -d= -f2- | tr -d '\r\n'
}

_mig_valid_mode() {
  case "$1" in
    temporary|permanent|ha-switch|retired) return 0 ;;
    *) return 1 ;;
  esac
}
_mig_valid_ip()  { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
_mig_valid_date() { [[ "$1" =~ ^20[0-9]{2}-[01][0-9]-[0-3][0-9]$ ]]; }

_mig_is_mine() {
  local _hip
  _hip="$(_mig_get "$1" _MIG_HOST_IP)"
  _mig_valid_ip "${_hip}" || return 1
  hostname -I 2>/dev/null | tr ' ' '\n' | grep -qxF "${_hip}"
}

_mig_norm_deadline() {
  local _in="$1" _out
  [ -z "${_in}" ] && { printf ''; return 0; }
  case "${_in}" in
    +[0-9]*d) _out="$(date -u -d "${_in%d} days" '+%Y-%m-%d' 2>/dev/null)" ;;
    *)        _out="$(date -u -d "${_in}" '+%Y-%m-%d' 2>/dev/null)" ;;
  esac
  _mig_valid_date "${_out}" || return 1
  [[ "${_out}" < "$(date -u '+%Y-%m-%d')" ]] && return 1
  printf '%s' "${_out}"
}

_mig_sweep_legacy() {
  [ -e "${_MIG_LEGACY_ORPHAN}" ] || return 0
  if [ ! -s "${_MIG_BOX_MODE_FILE}" ]; then
    mkdir -p "$(dirname "${_MIG_BOX_MODE_FILE}")" 2>/dev/null
    echo permanent > "${_MIG_BOX_MODE_FILE}"
    _alrt "legacy xmass permanent-proxy flag found; converted to box default 'permanent'"
  else
    _alrt "legacy xmass permanent-proxy flag found; box default already declared, flag removed"
  fi
  rm -f "${_MIG_LEGACY_ORPHAN}"
}

### SETS GLOBALS (_MIG_MODE/_MIG_DEADLINE/_MIG_SOURCE): never call inside
### $( ) or a pipeline, or the resolution is lost to the subshell.
_mig_resolve() {
  local _root="$1" _cnf _m _d
  _cnf="${_root}/${_MIG_CNF_NAME}"
  _MIG_MODE=""; _MIG_DEADLINE=""; _MIG_SOURCE=""

  if [ -r "${_cnf}" ] && _mig_is_mine "${_cnf}"; then
    _m="$(_mig_get "${_cnf}" _MIG_MODE)"
    _d="$(_mig_get "${_cnf}" _MIG_DEADLINE)"
    if _mig_valid_mode "${_m}"; then
      _MIG_MODE="${_m}"
      _MIG_SOURCE="$(_mig_get "${_cnf}" _MIG_SCOPE)"
      [ "${_MIG_SOURCE}" = "account" ] || _MIG_SOURCE=box
      _mig_valid_date "${_d}" && _MIG_DEADLINE="${_d}"
    else
      [ -n "${_m}" ] && echo "ALRT: ${_cnf}: invalid _MIG_MODE '${_m}' ignored"
    fi
  fi

  ### The override REPLACES the box-file level when set: a DRY cutover uses it
  ### to simulate exactly what --live will write over both files, so a stale
  ### on-disk mode or deadline must not leak past a pending change.
  if [ -z "${_MIG_MODE}" ]; then
    if [ -n "${_MIG_BOX_MODE_OVERRIDE}" ] \
      && _mig_valid_mode "${_MIG_BOX_MODE_OVERRIDE}"; then
      _MIG_MODE="${_MIG_BOX_MODE_OVERRIDE}"; _MIG_SOURCE=box
    elif [ -r "${_MIG_BOX_MODE_FILE}" ]; then
      _m="$(head -n1 "${_MIG_BOX_MODE_FILE}" 2>/dev/null | tr -d '\r\n')"
      if _mig_valid_mode "${_m}"; then
        _MIG_MODE="${_m}"; _MIG_SOURCE=box
      fi
    fi
  fi

  if [ -n "${_MIG_MODE}" ] && [ -z "${_MIG_DEADLINE}" ]; then
    if [ -n "${_MIG_BOX_MODE_OVERRIDE}" ]; then
      _mig_valid_date "${_MIG_BOX_DEADLINE_OVERRIDE}" \
        && _MIG_DEADLINE="${_MIG_BOX_DEADLINE_OVERRIDE}"
    else
      _d="$(head -n1 "${_MIG_BOX_DEADLINE_FILE}" 2>/dev/null | tr -d '\r\n')"
      _mig_valid_date "${_d}" && _MIG_DEADLINE="${_d}"
    fi
  fi

  if [ -z "${_MIG_MODE}" ]; then
    _MIG_MODE=temporary
    _MIG_SOURCE=default
  fi

  if [ "${_MIG_MODE}" = "ha-switch" ] && [ -n "${_MIG_DEADLINE}" ]; then
    _MIG_DEADLINE=""
  fi
  return 0
}

### Box DEFAULTS, never decisions: written only when the operator explicitly
### chose one (a flag now, or the legacy state mapping). Absent files leave
### every undeclared account on the built-in fallback, which cutover --live
### refuses.
_xmass_write_box_defaults() {
  if [ -z "${_XMASS_PROXY_MODE}" ]; then
    # A deadline with no mode would be normalised, accepted and then silently
    # dropped by the early return below -- refuse it instead.
    [ -n "${_XMASS_PROXY_DEADLINE}" ] \
      && _die "a proxy deadline needs a proxy mode: add --proxy-mode=temporary|permanent|ha-switch"
    return 0
  fi
  mkdir -p /data/conf 2>/dev/null
  echo "${_XMASS_PROXY_MODE}" > "${_MIG_BOX_MODE_FILE}"
  if [ -n "${_XMASS_PROXY_DEADLINE}" ]; then
    echo "${_XMASS_PROXY_DEADLINE}" > "${_MIG_BOX_DEADLINE_FILE}"
  else
    rm -f "${_MIG_BOX_DEADLINE_FILE}"
  fi
  _info "Box proxy default: ${_XMASS_PROXY_MODE}${_XMASS_PROXY_DEADLINE:+ (deadline ${_XMASS_PROXY_DEADLINE})}"
}

### Print each account's resolved proxy mode BEFORE anything destructive and
### collect the accounts that would fall back to the built-in default. At init
### this is free to fix; cutover --live refuses on it, because one wrong mail
### is recoverable and a boxful is not. A mode pin NEVER affects migration
### eligibility -- it only pins what that customer is told.
_xmass_report_account_modes() {
  local _oct
  _XMASS_MODE_UNDECLARED=""
  _info "Per-account proxy modes as they resolve now:"
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _mig_resolve "/data/disk/${_oct}" >/dev/null
    if [ "${_MIG_SOURCE}" = "account" ]; then
      _info "  ${_oct}: ${_MIG_MODE}${_MIG_DEADLINE:+ until ${_MIG_DEADLINE}} [pinned per account -- box default not applied]"
    elif [ "${_MIG_SOURCE}" = "default" ]; then
      _alrt "  ${_oct}: UNDECLARED -- would fall back to '${_MIG_MODE}'"
      _XMASS_MODE_UNDECLARED="${_XMASS_MODE_UNDECLARED} ${_oct}"
    else
      _info "  ${_oct}: ${_MIG_MODE}${_MIG_DEADLINE:+ until ${_MIG_DEADLINE}} [box default]"
    fi
  done
  if [ -n "${_XMASS_MODE_UNDECLARED}" ]; then
    _alrt "Declare a mode before 'cutover --live' (it refuses undeclared accounts):"
    _alrt "  box-wide:    xmass cutover <target-ip> --proxy-mode=<temporary|permanent|ha-switch>"
    _alrt "  per account: xoct proxy-mode <oN> <mode> [--deadline=YYYY-MM-DD|+Nd]"
  fi
  return 0
}

###-------------STATE FILE----------------###

_xmass_load_state() {
  if [ -e "${_XMASS_STATE_FILE}" ]; then
    # shellcheck disable=SC1090
    source "${_XMASS_STATE_FILE}"
  fi
  # A state file written by a pre-mode xmass carries only the old boolean. Map
  # it faithfully: the old NO path took the plain (non---permanent) trust and
  # the "as soon as possible" wording, which is exactly 'temporary'. The
  # source is the box-default level, NOT 'default', so the cutover --live gate
  # does not block an in-flight migration.
  # Gated on the schema marker: a state file the NEW xmass wrote also carries
  # _XMASS_PERMANENT_PROXY (kept one release), and without the marker a
  # no-flag init would round-trip NO into a phantom 'temporary' box default
  # that silently satisfies the very gate meant to refuse undeclared boxes.
  if [ -z "${_XMASS_STATE_V}" ] \
    && [ -z "${_XMASS_PROXY_MODE}" ] && [ -n "${_XMASS_PERMANENT_PROXY}" ]; then
    if [ "${_XMASS_PERMANENT_PROXY}" = "YES" ]; then
      _XMASS_PROXY_MODE=permanent
    else
      _XMASS_PROXY_MODE=temporary
    fi
    _alrt "state file carried the retired _XMASS_PERMANENT_PROXY=${_XMASS_PERMANENT_PROXY}"
    _alrt "mapped to --proxy-mode=${_XMASS_PROXY_MODE}; confirm with 'xmass status'"
  fi
}

_xmass_save_state() {
  mkdir -p "$(dirname "${_XMASS_STATE_FILE}")"
  # _XMASS_PERMANENT_PROXY is the legacy key, written for one more release so
  # a rolled-back xmass mid-migration still reads a coherent file.
  cat > "${_XMASS_STATE_FILE}" <<STATEEOF
_XMASS_TARGET_IP=${_XMASS_TARGET_IP}
_XMASS_SRC_IP=${_XMASS_SRC_IP}
_XMASS_REPL_PSWD=${_XMASS_REPL_PSWD}
_XMASS_PERCONA_V=${_XMASS_PERCONA_V}
_XMASS_INIT_TIME=${_XMASS_INIT_TIME}
_XMASS_LAST_SYNC=${_XMASS_LAST_SYNC}
_XMASS_PHASE=${_XMASS_PHASE}
_XMASS_PERMANENT_PROXY=${_XMASS_PERMANENT_PROXY}
_XMASS_PROXY_MODE=${_XMASS_PROXY_MODE}
_XMASS_PROXY_DEADLINE=${_XMASS_PROXY_DEADLINE}
_XMASS_STATE_V=2
STATEEOF
  chmod 600 "${_XMASS_STATE_FILE}"
}

###-------------CHECK ROOT----------------###

###-------------MIGRATION TARGET SEEDING----###
###
### Same block as in xoct (master and satellite copies are kept in step by
### convention, never DRY-ed): close the "wrong PHP / wrong identity after
### migration" class. The control files static/control/{fpm,cli}.info are the
### AUTHORITATIVE witnesses -- BOA derives /root/.<acct>.octopus.cnf FROM
### them (_satellite_cnf, manage_ltd_users), never the reverse -- so the
### seeding order is: gate on installed PHP, install, merge the cnf, force
### the control files, carry the credentials.

### Normalise a PHP version token to the dotted form BOA control files use;
### prints nothing for a token that is not a known BOA PHP version.
_mig_php_norm() {
  local _t="${1//[^0-9.]/}"
  case "${_t}" in
    8.5|85) echo 8.5 ;;
    8.4|84) echo 8.4 ;;
    8.3|83) echo 8.3 ;;
    8.2|82) echo 8.2 ;;
    8.1|81) echo 8.1 ;;
    8.0|80) echo 8.0 ;;
    7.4|74) echo 7.4 ;;
    7.3|73) echo 7.3 ;;
    7.2|72) echo 7.2 ;;
    7.1|71) echo 7.1 ;;
    7.0|70) echo 7.0 ;;
    5.6|56) echo 5.6 ;;
  esac
}

### Union of PHP versions one account is pinned to: the account-level
### static/control/{fpm,cli}.info defaults plus the per-site column of
### static/control/multi-fpm.info (dotted and shorthand forms both count).
_mig_php_versions_needed() {
  local _u="$1" _f _v _dom _rest _out=""
  for _f in "${_u}/static/control/fpm.info" "${_u}/static/control/cli.info"; do
    [ -e "${_f}" ] || continue
    _v="$(_mig_php_norm "$(tr -d ' \t\r\n' < "${_f}" 2>/dev/null)")"
    [ -n "${_v}" ] && _out="${_out} ${_v}"
  done
  if [ -e "${_u}/static/control/multi-fpm.info" ]; then
    while read -r _dom _v _rest; do
      ### place.holder.dont.remove is manage_ltd_users' filler line, not a
      ### site pin -- counting it would refuse migrations over a version no
      ### site actually uses.
      case "${_dom}" in \#*|""|place.holder.dont.remove) continue ;; esac
      _v="$(_mig_php_norm "${_v}")"
      [ -n "${_v}" ] && _out="${_out} ${_v}"
    done < "${_u}/static/control/multi-fpm.info"
  fi
  echo "${_out}" | tr ' ' '\n' | sort -u | tr '\n' ' '
}

### The tree the TARGET runs, for target-side barracuda verbs; fall back to
### this box's own tree when the query fails.
_xmass_target_tree() {
  local _t="$1" _tt _lt
  _tt=$(ssh root@"${_t}" "boa info 2>/dev/null" 2>/dev/null \
    | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
    | tail -1 \
    | grep -oE '(dev|lts|pro)$')
  if [ -z "${_tt}" ]; then
    _lt=$(boa info 2>/dev/null \
      | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
      | tail -1 \
      | grep -oE '(dev|lts|pro)$')
    # stderr: callers capture stdout as the tree token and splice it into a
    # remote root command -- a warning on stdout would become part of it.
    echo "ALRT: could not detect the BOA tree on ${_t}; falling back to local '${_lt:-lts}'" >&2
    _tt="${_lt:-lts}"
  fi
  echo "${_tt}"
}

### Extend the target's _PHP_MULTI_INSTALL with missing versions and run one
### barracuda system pass there to build them. Idempotent.
_xmass_fix_target_php() {
  local _t="$1" _add="$2" _cur _new _v _nv _tree
  # Normalise the fetched value token by token: the raw line may carry an
  # inline comment or quotes, and anything not a known PHP version must
  # never reach the remote root shell that rewrites the cnf.
  _cur=$(ssh root@"${_t}" "grep '^_PHP_MULTI_INSTALL=' /root/.barracuda.cnf 2>/dev/null" 2>/dev/null \
    | tail -1 | sed -E 's/^[^=]*=//; s/#.*$//; s/"//g' | tr -d '\n')
  _new=""
  for _v in ${_cur} ${_add}; do
    _nv="$(_mig_php_norm "${_v}")"
    [ -n "${_nv}" ] || continue
    case " ${_new} " in
      *" ${_nv} "*) : ;;
      *) _new="${_new} ${_nv}" ;;
    esac
  done
  _new="${_new## }"
  if [ -z "${_new}" ]; then
    _alrt "computed empty _PHP_MULTI_INSTALL for ${_t}; refusing"
    return 1
  fi
  # Belt-and-braces before the value reaches a remote sed: it is built only
  # from _mig_php_norm output, so it can hold nothing but digits, dots and
  # spaces -- assert that rather than trust it.
  case "${_new}" in
    *[!0-9.\ ]*) _alrt "refusing to write a non-version _PHP_MULTI_INSTALL value"; return 1 ;;
  esac
  _info "Setting _PHP_MULTI_INSTALL=\"${_new}\" on ${_t}"
  # Rewrite in place (keeps the line with the comment that documents it);
  # append only when the key is absent. The temp+size guard means a failed
  # write can never blank the box's barracuda.cnf.
  ssh root@"${_t}" "_m=\$(stat -c %a /root/.barracuda.cnf 2>/dev/null); \
    if grep -q '^_PHP_MULTI_INSTALL=' /root/.barracuda.cnf; then \
      sed 's|^_PHP_MULTI_INSTALL=.*|_PHP_MULTI_INSTALL=\\\"${_new}\\\"|' \
        /root/.barracuda.cnf > /root/.barracuda.cnf.phpnew; \
    else \
      cp -af /root/.barracuda.cnf /root/.barracuda.cnf.phpnew \
      && echo '_PHP_MULTI_INSTALL=\"${_new}\"' >> /root/.barracuda.cnf.phpnew; \
    fi; \
    [ -s /root/.barracuda.cnf.phpnew ] \
    && chmod \${_m:-600} /root/.barracuda.cnf.phpnew \
    && mv -f /root/.barracuda.cnf.phpnew /root/.barracuda.cnf" \
    || { _alrt "could not update _PHP_MULTI_INSTALL on ${_t}"; return 1; }
  _tree="$(_xmass_target_tree "${_t}")"
  case "${_tree}" in
    dev|lts|pro) : ;;
    *) _alrt "invalid tree token '${_tree}' -- refusing the remote barracuda run"; return 1 ;;
  esac
  _info "Driving 'barracuda up-${_tree} system noscreen' on ${_t} to build the missing PHP set;"
  _info "this is a full system pass and typically takes ~30 minutes"
  ssh root@"${_t}" "barracuda up-${_tree} system noscreen" \
    || { _alrt "barracuda system run on ${_t} returned non-zero"; return 1; }
  return 0
}

### Verify every PHP version pinned by ANY eligible account is installed on
### the target (the /opt/phpNN/bin/php probe BOA's own fallback ladders use).
### $2 selects the consequence: die | deny (DRY: DENY + NOT_CLEAN) | fix
### (extend _PHP_MULTI_INSTALL + one barracuda pass, then re-verify).
_xmass_php_coverage_gate() {
  local _t="$1" _on_missing="${2:-die}" _oct _need="" _v _sv _miss=""
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _need="${_need} $(_mig_php_versions_needed "/data/disk/${_oct}")"
  done
  _need=$(echo "${_need}" | tr ' ' '\n' | sort -u | tr '\n' ' ')
  [ -n "${_need// /}" ] || return 0
  _info "PHP versions required by the eligible accounts: ${_need}"
  for _v in ${_need}; do
    _sv=${_v//[^0-9]/}
    if ! ssh root@"${_t}" "[ -x /opt/php${_sv}/bin/php ]" 2>/dev/null; then
      _miss="${_miss} ${_v}"
    fi
  done
  _miss="${_miss## }"
  [ -z "${_miss}" ] && { _info "Target PHP coverage: OK"; return 0; }
  case "${_on_missing}" in
    fix)
      _alrt "target ${_t} lacks pinned PHP version(s): ${_miss} -- fixing (--fix-php)"
      _xmass_fix_target_php "${_t}" "${_miss}" || return 1
      for _v in ${_miss}; do
        _sv=${_v//[^0-9]/}
        ssh root@"${_t}" "[ -x /opt/php${_sv}/bin/php ]" 2>/dev/null \
          || { _alrt "PHP ${_v} still missing on ${_t} after the fix run"; return 1; }
      done
      return 0
    ;;
    deny)
      _alrt "DENY: target ${_t} lacks pinned PHP version(s): ${_miss} -- every affected"
      _alrt "DENY: site would silently serve on a different PHP after cutover."
      _alrt "DENY: fix: 'xmass prep-target ${_t} --fix-php', or add '${_miss}' to"
      _alrt "DENY: _PHP_MULTI_INSTALL in /root/.barracuda.cnf on the target and run"
      _alrt "DENY: 'barracuda up-<tree> system noscreen' there"
      _XMASS_NOT_CLEAN=YES
      return 1
    ;;
    *)
      _die "target ${_t} lacks pinned PHP version(s): ${_miss}." \
           " Every affected site would silently serve on a different PHP after cutover." \
           " Fix: 'xmass prep-target ${_t} --fix-php', or add '${_miss}' to _PHP_MULTI_INSTALL" \
           " in /root/.barracuda.cnf on the target and run 'barracuda up-<tree> system noscreen' there."
    ;;
  esac
}

### Verify the eligible accounts EXIST on the target as real installs (system
### users + install stamps), not just as rsync-created trees. $2: die | deny.
_xmass_verify_target_accounts() {
  local _t="$1" _on_missing="${2:-die}" _oct _bad="" _out
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _out=$(ssh root@"${_t}" "getent passwd ${_oct} >/dev/null 2>&1 \
      && getent passwd ${_oct}.ftp >/dev/null 2>&1 \
      && [ -e /data/disk/${_oct}/log/octopus_log.txt ] \
      && [ -e /data/disk/${_oct}/config/includes/nginx_vhost_common.conf ] \
      && [ -e /root/.${_oct}.octopus.cnf ] \
      && echo PRESENT" 2>/dev/null)
    [ "${_out}" = "PRESENT" ] || _bad="${_bad} ${_oct}"
  done
  _bad="${_bad## }"
  [ -z "${_bad}" ] && { _info "All eligible accounts installed on ${_t}: OK"; return 0; }
  if [ "${_on_missing}" = "deny" ]; then
    _alrt "DENY: account(s) missing or incomplete on target ${_t}: ${_bad}"
    _alrt "DENY: rsync into a never-installed account creates a root-owned tree with no"
    _alrt "DENY: system user, no FPM pool and no vhost include -- run 'xmass prep-target ${_t}'"
    _XMASS_NOT_CLEAN=YES
    return 1
  fi
  _die "account(s) missing or incomplete on target ${_t}: ${_bad}." \
       " Run 'xmass prep-target ${_t}' to install and seed them first."
}

### Merge the account-portable octopus.cnf lines from the source cnf into the
### target's copy: replace-or-append per key, whole lines, host axis excluded
### (_MY_OWNIP, _LOCAL_NETWORK_IP, _THIS_DB_HOST/_PORT, _DOMAIN are re-derived
### target-correct when absent and actively harmful when copied). Runs AFTER
### the target install by design: _satellite_cnf derives the PHP pins from
### static/control/*.info, so the control-file force is what makes the pins
### stick and the cnf carries everything only it owns.
_xmass_push_account_cnf() {
  local _acct="$1" _t="$2"
  local _sCnf="/root/.${_acct}.octopus.cnf"
  local _dCnf="/root/.${_acct}.octopus.cnf"
  local _rTmp="/root/.${_acct}.octopus.cnf.migrate-merge.tmp"
  local _rRun="/root/.${_acct}.octopus.cnf.migrate-merge.run"
  local _lTmp="/var/backups/.xmass.cnfmerge.$$.lines"
  local _lRun="/var/backups/.xmass.cnfmerge.$$.run"
  local _v _l _lst
  if [ ! -e "${_sCnf}" ]; then
    _alrt "no ${_sCnf} on the source; the target account keeps its install-time defaults"
    return 0
  fi
  if ! ssh root@"${_t}" "[ -e ${_dCnf} ]" 2>/dev/null; then
    _alrt "no ${_dCnf} on ${_t} (account not installed there?); skipping the cnf merge"
    return 1
  fi
  _lst="_PHP_FPM_VERSION _PHP_CLI_VERSION _PHP_FPM_WORKERS _PHP_FPM_TIMEOUT \
    _PHP_FPM_MAX_CHILDREN_FORCE _PHP_FPM_MEMORY_LIMIT_FORCE _PHP_FPM_RAM_PCT \
    _PHP_FPM_CPU_FACTOR _PHP_FPM_DENY _RESERVED_RAM _MY_OCTO_EMAIL \
    _CLIENT_EMAIL _CLIENT_OPTION _CLIENT_SUBSCR _CLIENT_CORES \
    _GHOST_PLATFORMS_CLEANUP _GHOST_VHOSTS_CLEANUP _GHOST_SITES_CLEANUP \
    _GHOST_SITE_FILES_CLEANUP _GHOST_ALIASES_CLEANUP \
    _DEL_OLD_BACKUPS _DEL_OLD_TMP _DEL_OLD_EMPTY_PLATFORMS \
    _SQL_CONVERT _STRONG_PASSWORDS _BACKDROP_SUPPORT _HOT_SAUCE \
    _USE_CURRENT _DL_MODE _FORCE_GIT_MIRROR _PLATFORMS_LIST \
    _AUTOPILOT _DNS_SETUP_TEST"
  echo "_USER=\"${_acct}\"" > "${_lTmp}"
  for _v in ${_lst}; do
    _l=$(grep "^${_v}=" "${_sCnf}" 2>/dev/null | tail -1)
    [ -n "${_l}" ] && printf '%s\n' "${_l}" >> "${_lTmp}"
  done
  {
    echo '#!/bin/bash'
    echo "_cnf=\"${_dCnf}\""
    echo "_mrg=\"${_rTmp}\""
    cat <<'MERGESH'
[ -e "${_cnf}" ] || exit 1
[ -e "${_mrg}" ] || exit 1
while IFS= read -r _l; do
  case "${_l}" in
    _*=*) : ;;
    *) continue ;;
  esac
  _k="${_l%%=*}"
  grep -v "^${_k}=" "${_cnf}" > "${_cnf}.mrgnew" 2>/dev/null
  printf '%s\n' "${_l}" >> "${_cnf}.mrgnew"
  mv -f "${_cnf}.mrgnew" "${_cnf}"
done < "${_mrg}"
chmod 644 "${_cnf}"
rm -f "${_mrg}"
MERGESH
  } > "${_lRun}"
  if ! rsync -a -e ssh "${_lTmp}" "root@${_t}:${_rTmp}" \
    || ! rsync -a -e ssh "${_lRun}" "root@${_t}:${_rRun}"; then
    _alrt "could not stage the cnf merge on ${_t}"
    rm -f "${_lTmp}" "${_lRun}"
    return 1
  fi
  rm -f "${_lTmp}" "${_lRun}"
  if ssh root@"${_t}" "bash ${_rRun}; _rc=\$?; rm -f ${_rRun}; exit \${_rc}"; then
    _info "  ${_acct}: merged source octopus.cnf values into the target copy"
    return 0
  fi
  _alrt "cnf merge for ${_acct} on ${_t} failed; the target keeps its current cnf"
  return 1
}

### Force the plan/identity stamps over WITHOUT -u: the target's fresh
### install wrote newer defaults that shadow every -u sync, and these files
### are exactly what BOA re-reads as _CLIENT_* on later upgrades and what
### sizes the FPM pools. domain.txt is deliberately NOT forced: the target's
### own FQDN stamp is what renameaegirhost wants.
_xmass_seed_account_stamps() {
  local _acct="$1" _t="$2" _f
  local _u="/data/disk/${_acct}"
  for _f in log/fpm.txt log/cli.txt log/email.txt log/option.txt \
    log/cores.txt log/subscr.txt; do
    [ -e "${_u}/${_f}" ] || continue
    _xmass_rsync -aEAX ${_ieni} -e ssh \
      "${_u}/${_f}" \
      "root@${_t}:${_u}/${_f}"
  done
  return 0
}

### Carry the client shell identity: the main <acct>.ftp shadow hash and
### log/pass.txt as a consistent pair, the sub-account password store
### /home/<acct>.ftp/users (whose carried entries manage_ltd_users honours at
### sub-user creation), and each existing sub-user's shadow hash and .ssh
### where the target user already exists (repeated syncs converge the rest).
### LIVE only -- callers must never invoke this from a DRY path.
_xmass_sync_shell_credentials() {
  local _acct="$1" _t="$2"
  local _u="/data/disk/${_acct}"
  local _hash _d _n _set=NO
  _hash=$(getent shadow "${_acct}.ftp" 2>/dev/null | cut -d: -f2)
  if [ -n "${_hash}" ] && [ "${_hash}" != "*" ] && [ "${_hash}" != "!" ]; then
    if ssh root@"${_t}" "getent passwd ${_acct}.ftp" &> /dev/null; then
      if printf '%s.ftp:%s\n' "${_acct}" "${_hash}" | ssh root@"${_t}" "chpasswd -e"; then
        _set=YES
        _info "  ${_acct}: carried the ${_acct}.ftp shell/SFTP password to ${_t}"
      else
        _alrt "  ${_acct}: could not set the carried password for ${_acct}.ftp on ${_t}"
      fi
    else
      _alrt "  ${_acct}: user ${_acct}.ftp missing on ${_t}; password not carried yet"
    fi
  fi
  # pass.txt travels ONLY when the paired hash actually landed: the file is
  # what the client is shown, and shipping it after a failed chpasswd would
  # advertise a password that does not work. A re-run converges both.
  if [ "${_set}" = "YES" ] && [ -e "${_u}/log/pass.txt" ]; then
    rsync -aEAX ${_ieni} -e ssh --no-devices --no-specials \
      "${_u}/log/pass.txt" \
      "root@${_t}:${_u}/log/pass.txt" 2>/dev/null \
      || _alrt "  ${_acct}: could not carry log/pass.txt (password IS set; re-run to converge)"
  elif [ -e "${_u}/log/pass.txt" ]; then
    _alrt "  ${_acct}: NOT carrying log/pass.txt -- the shadow hash was not set on ${_t}"
  fi
  if [ -d "/home/${_acct}.ftp/users" ]; then
    rsync -aEAX ${_ieni} -e ssh --no-devices --no-specials \
      "/home/${_acct}.ftp/users/" \
      "root@${_t}:/home/${_acct}.ftp/users/" 2>/dev/null \
      || _alrt "  ${_acct}: could not carry the sub-account password store"
  fi
  for _d in "${_u}"/clients/*/; do
    [ -d "${_d}" ] || continue
    _n=$(basename "${_d}")
    getent passwd "${_acct}.${_n}" &> /dev/null || continue
    _hash=$(getent shadow "${_acct}.${_n}" 2>/dev/null | cut -d: -f2)
    [ -n "${_hash}" ] && [ "${_hash}" != "*" ] && [ "${_hash}" != "!" ] || continue
    if ssh root@"${_t}" "getent passwd ${_acct}.${_n}" &> /dev/null; then
      if printf '%s.%s:%s\n' "${_acct}" "${_n}" "${_hash}" | ssh root@"${_t}" "chpasswd -e"; then
        _info "  ${_acct}: carried sub-account password for ${_acct}.${_n}"
      else
        _alrt "  ${_acct}: could not carry the sub-account password for ${_acct}.${_n}"
      fi
      if [ -d "/home/${_acct}.${_n}/.ssh" ]; then
        rsync -aEAXu ${_ieni} -e ssh --no-devices --no-specials \
          "/home/${_acct}.${_n}/.ssh" \
          "root@${_t}:/home/${_acct}.${_n}/" 2>/dev/null \
          || _alrt "  ${_acct}: could not carry .ssh for ${_acct}.${_n}"
      fi
    elif [ -d "/home/${_acct}.${_n}/.ssh" ]; then
      # The sub-user does not exist there yet: manage_ltd_users creates it
      # from clients/ within minutes and honours the carried store entry, so
      # the password converges. Its .ssh cannot be placed before the home
      # exists -- stage it where that creation pass adopts it.
      ssh root@"${_t}" "mkdir -p /var/backups/migrate-subuser-ssh/${_acct}.${_n}" &> /dev/null
      rsync -aEAXu ${_ieni} -e ssh --no-devices --no-specials \
        "/home/${_acct}.${_n}/.ssh" \
        "root@${_t}:/var/backups/migrate-subuser-ssh/${_acct}.${_n}/" 2>/dev/null \
        || _alrt "  ${_acct}: could not stage .ssh for ${_acct}.${_n}"
    fi
  done
  return 0
}

### Mirror the billing-suspension flag: it lives OUTSIDE the account tree on
### purpose (the owner must not be able to delete it), so no account sync can
### carry it -- a suspended account must never come back up serving 200s on
### the target. Mirrors presence AND absence (an un-suspension mid-migration
### must converge too).
_xmass_copy_suspended_flag() {
  local _acct="$1" _t="$2"
  if [ -e "/data/conf/suspended/${_acct}.pid" ]; then
    if ssh root@"${_t}" "mkdir -p /data/conf/suspended \
      && echo SUSPENDED > /data/conf/suspended/${_acct}.pid" 2>/dev/null; then
      _alrt "  ${_acct}: account is SUSPENDED on the source; flag mirrored to ${_t}"
    else
      # Loud AND blocking: an unmirrored suspension means a non-paying
      # account comes back up serving 200s on the target.
      _alrt "DENY: ${_acct}: could not mirror the SUSPENDED flag to ${_t} --"
      _alrt "DENY: the account would resume serving there after cutover"
      _XMASS_NOT_CLEAN=YES
      return 1
    fi
  else
    ssh root@"${_t}" "rm -f /data/conf/suspended/${_acct}.pid" 2>/dev/null
  fi
  return 0
}

### Source-side LE health sweep: dehydrated's broken-renewal shape writes a
### fresh key and a ZERO-BYTE certificate nightly and never advances the
### symlink. Migrating a broken renewal means debugging two things at once
### inside the cutover window, so name every broken pair now. Advisory.
_xmass_check_le_health() {
  local _c _end _bad=0
  _info "Checking source certificates for broken renewals ..."
  for _c in /data/disk/*/config/server_master/ssl.d/*/openssl.crt; do
    [ -e "${_c}" ] || continue
    if [ ! -s "${_c}" ]; then
      _alrt "  ZERO-BYTE certificate: ${_c} -- fix the renewal BEFORE migrating"
      _bad=$(( _bad + 1 ))
      continue
    fi
    _end=$(openssl x509 -noout -enddate -in "${_c}" 2>/dev/null | cut -d= -f2)
    if [ -z "${_end}" ]; then
      _alrt "  UNPARSEABLE certificate: ${_c} -- fix the renewal BEFORE migrating"
      _bad=$(( _bad + 1 ))
      continue
    fi
    if [ "$(date -u -d "${_end}" '+%s' 2>/dev/null || echo 0)" -lt "$(date -u '+%s')" ]; then
      _alrt "  EXPIRED certificate (${_end}): ${_c}"
      _bad=$(( _bad + 1 ))
    fi
  done
  if [ "${_bad}" -gt 0 ]; then
    _alrt "${_bad} broken/expired certificate(s) found -- fix renewals on the source first"
  else
    _info "Source certificates: OK"
  fi
  return 0
}

### Compare Solr core sets after the target's Solr starts: an rsynced core a
### fresh build never regenerates arrives as data and stays unregistered,
### silently returning wrong search results. Check-gate only: registration
### is core-shape-specific and stays with the operator.
_xmass_solr_core_parity() {
  local _t="$1" _src="" _d _tgtcores _c _missing="" _failed=""
  for _d in /opt/solr4/*/ /var/solr7/data/*/ /var/solr9/data/*/; do
    [ -d "${_d}" ] || continue
    if [ -e "${_d}core.properties" ] || [ -e "${_d}conf/solrconfig.xml" ]; then
      _src="${_src} $(basename "${_d}")"
    fi
  done
  _src="${_src## }"
  [ -z "${_src}" ] && return 0
  # BOA installs solr9 on 9099 and solr7 on 9077 (solr.sh.inc); jetty9/solr4
  # answers on 8099. 8983 stays as the upstream default for hand-installed
  # Solr. Probing the wrong set made every source core report missing and
  # left the parity-OK branch unreachable on a real Solr box.
  # Whitespace-stripped so the match survives Solr's pretty-printed output.
  _tgtcores=$(ssh root@"${_t}" "for p in 9099 9077 8099 8983; do curl -s -A iCab \"http://127.0.0.1:\${p}/solr/admin/cores?action=STATUS&wt=json\" 2>/dev/null; done" 2>/dev/null \
    | tr -d ' \n\t')
  for _c in ${_src}; do
    # Key on the core's own name field inside the STATUS entry, never the bare
    # name: Solr echoes the name of a core that FAILED to load in
    # initFailures too, and a bare-name match scored those as registered --
    # reporting parity OK for a core serving nothing.
    case "${_tgtcores}" in
      *"\"name\":\"${_c}\""*) : ;;
      *)
        _missing="${_missing} ${_c}"
        case "${_tgtcores}" in
          *"\"initFailures\":{"*"\"${_c}\":"*) _failed="${_failed} ${_c}" ;;
        esac
        ;;
    esac
  done
  if [ -n "${_missing}" ]; then
    _alrt "Solr cores present on the source but NOT registered on ${_t}:${_missing}"
    _alrt "their data arrived with the sync; register them on the target or the"
    _alrt "affected search indexes silently return wrong results"
    if [ -n "${_failed}" ]; then
      _alrt "of those, Solr FAILED to load (see its initFailures):${_failed}"
      _alrt "-- the core directory arrived but its configuration does not resolve"
      _alrt "on this box; fix the core's conf/ or configSet, then reload the core"
    fi
  else
    _info "Solr core parity source vs target: OK"
  fi
  return 0
}

### Devuan-safe cron stop + runner park, shared by the cutover LIVE path and
### the resume path: the box's own cron restores parked runners within
### minutes, so a park done at pre-mig time never survives until cutover --
### park HERE, immediately before the destructive sequence, then verify.
_xmass_park_runners_and_cron() {
  local _p
  _info "Stopping cron and parking BOA runners for the cutover window ..."
  _XMASS_RUNNERS_PARKED=YES
  /etc/init.d/cron stop &> /dev/null || service cron stop &> /dev/null
  pkill -x cron &> /dev/null
  for _p in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
    if [ -e "/var/xdrago/${_p}" ]; then
      mv -f "/var/xdrago/${_p}" "/var/xdrago/.${_p}.off"
      pkill -9 -f "${_p}" &> /dev/null
    fi
  done
  if pgrep -x cron &> /dev/null; then
    _die "cron is still running after the stop attempt -- stop it manually" \
         " (/etc/init.d/cron stop; pkill -x cron), then re-run"
  fi
  _info "cron stopped and runners parked: OK"
}

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    _die "This script must be run as root"
  fi
  ionice -c2 -n7 -p $$ &>/dev/null
  chmod a+w /dev/null
  if [ ! -e "/dev/fd" ] && [ -e "/proc/self/fd" ]; then
    rm -rf /dev/fd
    ln -sfn /proc/self/fd /dev/fd
  fi
  # shellcheck disable=SC1091
  [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
  [ -e "/root/.my.cnf" ] || _die "/root/.my.cnf missing — MySQL credentials required"
  _DF_TEST="$(df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 { gsub(/%/,"",$u); print $u }')"
  # reset-phase only rewrites one line of the state file. Refusing it on a full
  # disk locks the operator out of the recovery verb exactly when a stalled
  # migration is the likely reason the disk filled.
  if [ -n "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ] \
    && [ "${_cmd}" != "reset-phase" ] && [ "${_cmd}" != "status" ]; then
    _die "Disk usage at ${_DF_TEST}% — must be below 90% to proceed"
  fi
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
  _ADM_EMAIL=${_MY_EMAIL//\\\@/\@}
  _BCC_EMAIL=${_MY_EMAIL//\\\@/\@}
}

###-------------PERCONA VERSION-----------###

_xmass_detect_percona_version() {
  local _raw
  _raw=$(mysql -V 2>&1)
  _XMASS_PERCONA_V=$(echo "${_raw}" \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
    | head -1 \
    | cut -d"." -f1,2)
  case "${_XMASS_PERCONA_V}" in
    5.7|8.0|8.4)
      _info "Percona MySQL version detected: ${_XMASS_PERCONA_V}"
    ;;
    *)
      _die "Cannot detect Percona version from: ${_raw}"
    ;;
  esac
  # MySQL 8.4 REMOVED the legacy SLAVE/MASTER replication vocabulary
  # (CHANGE MASTER TO, START/STOP SLAVE, RESET MASTER/SLAVE, SHOW SLAVE STATUS
  # and the Slave_*/Seconds_Behind_Master fields). Pick the right dialect once
  # here; 5.7 and 8.0 keep the old verbs (8.0 still accepts them), 8.4 uses the
  # REPLICA/SOURCE forms. Verified live on 8.4 (RESET MASTER -> 1064; RESET
  # BINARY LOGS AND GTIDS / STOP REPLICA / CHANGE REPLICATION SOURCE TO OK).
  if [ "${_XMASS_PERCONA_V}" = "8.4" ]; then
    _XM_RESET_MASTER="RESET BINARY LOGS AND GTIDS"
    _XM_CHANGE="CHANGE REPLICATION SOURCE TO"
    _XM_HOST="SOURCE_HOST"; _XM_USER="SOURCE_USER"
    _XM_PASSWORD="SOURCE_PASSWORD"; _XM_AUTOPOS="SOURCE_AUTO_POSITION"
    _XM_START="START REPLICA"; _XM_STOP="STOP REPLICA"
    _XM_RESET_SLAVE="RESET REPLICA ALL"
    _XM_SHOW_STATUS="SHOW REPLICA STATUS"
    _XM_IO_FIELD="Replica_IO_Running"; _XM_SQL_FIELD="Replica_SQL_Running"
    _XM_LAG_FIELD="Seconds_Behind_Source"
  else
    _XM_RESET_MASTER="RESET MASTER"
    _XM_CHANGE="CHANGE MASTER TO"
    _XM_HOST="MASTER_HOST"; _XM_USER="MASTER_USER"
    _XM_PASSWORD="MASTER_PASSWORD"; _XM_AUTOPOS="MASTER_AUTO_POSITION"
    _XM_START="START SLAVE"; _XM_STOP="STOP SLAVE"
    _XM_RESET_SLAVE="RESET SLAVE ALL"
    _XM_SHOW_STATUS="SHOW SLAVE STATUS"
    _XM_IO_FIELD="Slave_IO_Running"; _XM_SQL_FIELD="Slave_SQL_Running"
    _XM_LAG_FIELD="Seconds_Behind_Master"
  fi
  # 8.0+ default the replication user to caching_sha2_password, which refuses
  # password auth over the plain (non-TLS) replication connection unless the
  # replica fetches the source's public key for the RSA exchange. 5.7 uses
  # mysql_native_password and needs neither (and lacks the option). Verified
  # live on 8.4: without it the IO thread stalls "Connecting" with errno 2061
  # 'Authentication requires secure connection'. Trailing comma so it drops
  # cleanly into the CHANGE ... SOURCE/MASTER statement (empty line on 5.7).
  case "${_XMASS_PERCONA_V}" in
    8.4) _XM_GET_PUBKEY="  GET_SOURCE_PUBLIC_KEY = 1," ;;
    8.0) _XM_GET_PUBKEY="  GET_MASTER_PUBLIC_KEY = 1," ;;
    *)   _XM_GET_PUBKEY="" ;;
  esac
}

_xmass_xtrabackup_pkg() {
  # Returns the apt package name for the correct xtrabackup version
  case "${_XMASS_PERCONA_V}" in
    5.7) echo "percona-xtrabackup-24" ;;
    8.0) echo "percona-xtrabackup-80" ;;
    8.4) echo "percona-xtrabackup-84" ;;
    *)   _die "No xtrabackup package known for Percona ${_XMASS_PERCONA_V}" ;;
  esac
}

_xmass_xtrabackup_repo() {
  # Percona ships xtrabackup in a SEPARATE apt repo component from the server
  # (BOA configures only the ps-* server repo), so 'apt-get install
  # percona-xtrabackup-NN' finds nothing until the matching pxb repo is added.
  case "${_XMASS_PERCONA_V}" in
    5.7) echo "pxb-24" ;;
    8.0) echo "pxb-80" ;;
    8.4) echo "pxb-84-lts" ;;
    *)   _die "No xtrabackup repo known for Percona ${_XMASS_PERCONA_V}" ;;
  esac
}

###-------------XTRABACKUP INSTALL-------###

# Enable the Percona repos xtrabackup needs, reusing the keyring + codename BOA
# already set up for the ps-* server repo (so signing + Devuan->bookworm
# mapping stay consistent). Two components are required:
#   ${_repo}  -- the version-specific xtrabackup repo (pxb-24/pxb-80/pxb-84-lts)
#   tools     -- ships Percona's libdbd-mysql-perl (epoch 1:5.013), which
#                percona-xtrabackup Depends on. Debian's libdbd-mysql-perl
#                Depends on libmariadb3, which BOA pins uninstallable
#                (/etc/apt/preferences.d/mariadb-common) to keep MariaDB libs
#                off a Percona box -- so without 'tools' the install dies on
#                'libmariadb3 not installable'. Percona's build Depends on the
#                Percona client instead and its epoch-1 version outranks
#                Debian's, so enabling 'tools' makes it the candidate.
# Idempotent; safe to re-run. Meant to run on the LOCAL box -- the target path
# wraps this same body over ssh. Emits the shell to run so both paths share one
# definition.
_xmass_pxb_repo_setup_cmd() {
  local _repo="$1"
  cat <<REPOEOF
_psList=/etc/apt/sources.list.d/percona-release.list
if [ ! -e "\${_psList}" ]; then
  echo "ERROR: \${_psList} missing -- Percona server repo not configured; cannot derive pxb repo" >&2
  exit 1
fi
# Reuse the server repo's exact codename + signed-by keyring; only swap the
# repo component (ps-XX -> target) and drop deb-src.
_psLine=\$(grep -E '^deb ' "\${_psList}" | grep -E 'ps-[0-9]' | head -1)
if [ -z "\${_psLine}" ]; then
  echo "ERROR: no ps-* deb line in \${_psList}" >&2
  exit 1
fi
for _comp in ${_repo} tools; do
  _compList=/etc/apt/sources.list.d/percona-\${_comp}.list
  _compLine=\$(echo "\${_psLine}" | sed -E "s#/ps-[0-9a-zA-Z-]+/#/\${_comp}/#")
  if ! grep -qF "\${_compLine}" "\${_compList}" 2>/dev/null; then
    echo "\${_compLine}" > "\${_compList}"
  fi
done
apt-get -q -y update >/dev/null 2>&1
REPOEOF
}

_xmass_install_xtrabackup_local() {
  local _pkg _repo
  _pkg=$(_xmass_xtrabackup_pkg)
  _repo=$(_xmass_xtrabackup_repo)
  if dpkg -l "${_pkg}" 2>/dev/null | grep -q "^ii"; then
    _info "xtrabackup (${_pkg}) already installed on source: OK"
    return
  fi
  _info "Enabling Percona ${_repo} repo on source ..."
  bash -c "$(_xmass_pxb_repo_setup_cmd "${_repo}")" \
    || _die "Failed to enable ${_repo} repo on source"
  _info "Installing ${_pkg} on source ..."
  apt-get -q -y install "${_pkg}" \
    || _die "Failed to install ${_pkg} on source"
  _info "Installed ${_pkg} on source: OK"
}

_xmass_install_xtrabackup_target() {
  local _pkg _repo
  _pkg=$(_xmass_xtrabackup_pkg)
  _repo=$(_xmass_xtrabackup_repo)
  local _already
  _already=$(ssh root@"${_tgt}" \
    "dpkg -l ${_pkg} 2>/dev/null | grep -c '^ii' || true" 2>/dev/null)
  if [ "${_already}" = "1" ]; then
    _info "xtrabackup (${_pkg}) already installed on target ${_tgt}: OK"
    return
  fi
  _info "Enabling Percona ${_repo} repo on target ${_tgt} ..."
  _xmass_pxb_repo_setup_cmd "${_repo}" | ssh root@"${_tgt}" "bash -s" \
    || _die "Failed to enable ${_repo} repo on target ${_tgt}"
  _info "Installing ${_pkg} on target ${_tgt} ..."
  ssh root@"${_tgt}" "apt-get -q -y install ${_pkg}" \
    || _die "Failed to install ${_pkg} on target ${_tgt}"
  _info "Installed ${_pkg} on target ${_tgt}: OK"
}

###-------------GTID SETUP---------------###

_ip_to_server_id() {
  # Convert an IPv4 address to a unique server_id using the last two octets.
  # Gives values 0-65535 which is well within MySQL's 1–2^32-1 range.
  echo "$1" | awk -F. '{ printf "%d\n", ($3 * 256) + $4 }'
}

_xmass_mysql_conf_dir() {
  # Return the include dir my.cnf ACTUALLY reads. Detecting by directory
  # existence is wrong on BOA boxes: /etc/mysql/percona-server.conf.d exists
  # but BOA's my.cnf only '!includedir /etc/mysql/conf.d/', so a gtid conf
  # dropped in the former is never parsed and GTID stays OFF after restart.
  # Parse the active !includedir first; fall back to existence guesses only if
  # my.cnf has none.
  local _inc
  _inc=$(grep -hE '^[[:space:]]*!includedir[[:space:]]' /etc/mysql/my.cnf 2>/dev/null \
    | head -1 \
    | sed -E 's/^[[:space:]]*!includedir[[:space:]]+//; s#/[[:space:]]*$##; s/[[:space:]]*$//')
  if [ -n "${_inc}" ] && [ -d "${_inc}" ]; then
    echo "${_inc}"
  elif [ -d "/etc/mysql/conf.d" ]; then
    echo "/etc/mysql/conf.d"
  elif [ -d "/etc/mysql/percona-server.conf.d" ]; then
    echo "/etc/mysql/percona-server.conf.d"
  elif [ -d "/etc/mysql/mysql.conf.d" ]; then
    echo "/etc/mysql/mysql.conf.d"
  else
    echo "/etc/mysql"
  fi
}

_xmass_write_gtid_conf_local() {
  local _sid="$1"
  local _conf_dir
  _conf_dir=$(_xmass_mysql_conf_dir)
  local _cnf="${_conf_dir}/xmass_gtid.cnf"
  # Only add log_bin directive if binlog is not already active
  local _logbin
  _logbin=$(mysql --defaults-file=/root/.my.cnf \
    -sNe "SHOW VARIABLES LIKE 'log_bin'" 2>/dev/null | awk '{print $2}')
  _info "Writing GTID config to ${_cnf} (server_id=${_sid}) ..."
  {
    echo "[mysqld]"
    echo "server_id                = ${_sid}"
    echo "gtid_mode                = ON"
    echo "enforce_gtid_consistency = ON"
    echo "log_slave_updates        = ON"
    echo "binlog_format            = ROW"
    # expire_logs_days was REMOVED in MySQL/Percona 8.4 (deprecated in 8.0);
    # its presence aborts mysqld at startup ("unknown variable"). Use the
    # replacement binlog_expire_logs_seconds on 8.0+; keep the old name on 5.7
    # where the new one does not exist.
    if [ "${_XMASS_PERCONA_V}" = "5.7" ]; then
      echo "expire_logs_days             = 7"
      # 5.7 applies the relay log single-threaded by default; on a
      # write-heavy source the replica drifts and blows the cutover lag
      # wait. 8.0.27+ already defaults to LOGICAL_CLOCK with 4 workers.
      echo "slave_parallel_type          = LOGICAL_CLOCK"
      echo "slave_parallel_workers       = ${_XMASS_PARALLEL_WORKERS:-4}"
    else
      echo "binlog_expire_logs_seconds   = 604800"
    fi
    [ "${_logbin}" != "ON" ] && echo "log_bin = /var/lib/mysql/mysql-bin"
  } > "${_cnf}"
  chmod 644 "${_cnf}"
}

_xmass_check_gtid_enabled_local() {
  mysql --defaults-file=/root/.my.cnf \
    --connect-timeout=5 -sNe \
    "SHOW VARIABLES LIKE 'gtid_mode'" 2>/dev/null | awk '{print $2}'
}

_xmass_configure_gtid_local() {
  local _mode
  _mode=$(_xmass_check_gtid_enabled_local)
  # ALWAYS (re)write the conf so GTID is PERSISTED. A runtime-only ON -- e.g. an
  # init re-run after a failed attempt, or a source already in a replication
  # topology -- is lost on the next restart, and on the target that restart is
  # the xtrabackup copy-back, after which CHANGE REPLICATION SOURCE fails with
  # GTID_MODE=OFF. Writing the conf is idempotent; restart only if it was OFF.
  local _src_id
  _src_id=$(_ip_to_server_id \
    "${_MY_OWNIP:-$(hostname -I 2>/dev/null | awk '{print $1}')}")
  _xmass_write_gtid_conf_local "${_src_id}"
  if [ "${_mode}" = "ON" ]; then
    _info "GTID already ON on source (conf persisted): OK"
    return
  fi
  _info "GTID not enabled on source (mode=${_mode}) — restarting to apply ..."
  /var/xdrago/move_sql.sh restart \
    || _die "MySQL restart failed on source (move_sql.sh)"
  _mode=$(_xmass_check_gtid_enabled_local)
  [ "${_mode}" = "ON" ] \
    || _die "GTID still not ON after restart on source (mode=${_mode})"
  _info "GTID enabled on source: OK"
}

_xmass_configure_gtid_target() {
  local _mode
  _mode=$(ssh root@"${_tgt}" \
    "mysql --defaults-file=/root/.my.cnf --connect-timeout=5 -sNe \
    \"SHOW VARIABLES LIKE 'gtid_mode'\" 2>/dev/null | awk '{print \$2}'" \
    2>/dev/null)
  # ALWAYS (re)write the conf so GTID is PERSISTED across the upcoming
  # xtrabackup copy-back restart, even when runtime GTID is already ON (init
  # re-run / pre-existing topology) -- a runtime-only ON is lost on that restart
  # and CHANGE REPLICATION SOURCE then fails with GTID_MODE=OFF. Idempotent;
  # restart only if it was OFF (below).
  local _tgt_id
  _tgt_id=$(_ip_to_server_id "${_tgt}")
  # Write the GTID config remotely. Detect the conf dir the SAME way as the
  # local path (_xmass_mysql_conf_dir): parse the !includedir my.cnf actually
  # reads, since the buggy existence-based guess wrote to percona-server.conf.d
  # (unread on a BOA box) and GTID stayed OFF -- surfacing only later as
  # 'CHANGE MASTER ... cannot be executed because GTID_MODE = OFF'.
  ssh root@"${_tgt}" "bash -s" <<REMOTEBASH
_inc=\$(grep -hE '^[[:space:]]*!includedir[[:space:]]' /etc/mysql/my.cnf 2>/dev/null \
  | head -1 \
  | sed -E 's/^[[:space:]]*!includedir[[:space:]]+//; s#/[[:space:]]*\$##; s/[[:space:]]*\$//')
if [ -n "\${_inc}" ] && [ -d "\${_inc}" ]; then
  _conf_dir="\${_inc}"
elif [ -d "/etc/mysql/conf.d" ]; then
  _conf_dir="/etc/mysql/conf.d"
elif [ -d "/etc/mysql/percona-server.conf.d" ]; then
  _conf_dir="/etc/mysql/percona-server.conf.d"
elif [ -d "/etc/mysql/mysql.conf.d" ]; then
  _conf_dir="/etc/mysql/mysql.conf.d"
else
  _conf_dir="/etc/mysql"
fi
_cnf="\${_conf_dir}/xmass_gtid.cnf"
_logbin=\$(mysql --defaults-file=/root/.my.cnf \
  -sNe "SHOW VARIABLES LIKE 'log_bin'" 2>/dev/null | awk '{print \$2}')
{
  echo "[mysqld]"
  echo "server_id                = ${_tgt_id}"
  echo "gtid_mode                = ON"
  echo "enforce_gtid_consistency = ON"
  echo "log_slave_updates        = ON"
  echo "binlog_format            = ROW"
  if [ "${_XMASS_PERCONA_V}" = "5.7" ]; then
    echo "expire_logs_days             = 7"
    echo "slave_parallel_type          = LOGICAL_CLOCK"
    echo "slave_parallel_workers       = ${_XMASS_PARALLEL_WORKERS:-4}"
  else
    echo "binlog_expire_logs_seconds   = 604800"
  fi
  [ "\${_logbin}" != "ON" ] && echo "log_bin = /var/lib/mysql/mysql-bin"
} > "\${_cnf}"
chmod 644 "\${_cnf}"
REMOTEBASH
  if [ "${_mode}" = "ON" ]; then
    _info "GTID already ON on target ${_tgt} (conf persisted): OK"
    return
  fi
  _info "GTID not enabled on target ${_tgt} (mode=${_mode}) — restarting to apply ..."
  ssh root@"${_tgt}" "/var/xdrago/move_sql.sh restart" \
    || _die "MySQL restart failed on target ${_tgt}"
  # Verify GTID actually came ON (the source path does the same). A silent
  # miss here otherwise surfaces much later at CHANGE REPLICATION SOURCE.
  local _tmode
  _tmode=$(ssh root@"${_tgt}" \
    "mysql --defaults-file=/root/.my.cnf -sNe \"SHOW VARIABLES LIKE 'gtid_mode'\" 2>/dev/null | awk '{print \$2}'")
  if [ "${_tmode}" != "ON" ]; then
    _die "GTID still not ON after restart on target ${_tgt} (mode=${_tmode})"
  fi
  _info "GTID configured on target ${_tgt}: OK"
}

###-------------REPLICATION USER---------###

_xmass_create_repl_user() {
  _info "Creating replication user '${_REPL_USER}'@'${_tgt}' on source ..."
  mysql --defaults-file=/root/.my.cnf <<SQLEOF
DROP USER IF EXISTS '${_REPL_USER}'@'${_tgt}';
CREATE USER '${_REPL_USER}'@'${_tgt}' IDENTIFIED BY '${_XMASS_REPL_PSWD}';
GRANT REPLICATION SLAVE ON *.* TO '${_REPL_USER}'@'${_tgt}';
FLUSH PRIVILEGES;
SQLEOF
  _info "Replication user '${_REPL_USER}'@'${_tgt}' created: OK"
}

_xmass_drop_repl_user() {
  _info "Dropping replication user '${_REPL_USER}'@'${_tgt}' on source ..."
  mysql --defaults-file=/root/.my.cnf \
    -e "DROP USER IF EXISTS '${_REPL_USER}'@'${_tgt}'; FLUSH PRIVILEGES;" \
    2>/dev/null \
    || _alrt "Could not drop replication user (may already be gone)"
}

###-------------XTRABACKUP TRANSFER------###

_xmass_decide_transfer_method() {
  # Stage locally if we have 1.5× the MySQL data size free on /; stream otherwise.
  local _mysql_kb _free_kb _needed_kb
  _mysql_kb=$(du -s /var/lib/mysql 2>/dev/null | awk '{print $1}')
  _free_kb=$(df -P / 2>/dev/null | awk 'NR==2{print $4}')
  _needed_kb=$(( _mysql_kb * 3 / 2 ))
  if [ "${_free_kb}" -gt "${_needed_kb}" ]; then
    _XTRA_METHOD="stage"
  else
    _XTRA_METHOD="stream"
  fi
  _info "xtrabackup method: ${_XTRA_METHOD}" \
    "(mysql=${_mysql_kb}K free=${_free_kb}K needed=${_needed_kb}K)"
  if [ "${_XTRA_METHOD}" = "stream" ]; then
    # Stream is one unresumable pipe with the target datadir already moved
    # aside; stage can resume an interrupted transfer. When reclaimable bulk
    # (duplicity caches, old backups, build trees) is what forces stream,
    # relocating it first is almost always worth it -- name the shortfall
    # and the usual suspects so that decision is informed, not discovered.
    _alrt "STREAM selected: the transfer is a single unresumable pipe. Shortfall:"
    _alrt "  $(( (_needed_kb - _free_kb) / 1024 ))M more free on / would enable resumable STAGE."
    _alrt "  Largest reclaim candidates (relocate, do not delete):"
    du -sk /root/.cache /var/backups /opt/tmp 2>/dev/null \
      | sort -rn | head -3 | awk '{ printf "ALRT:     %sM  %s\n", int($1/1024), $2 }'
  fi
}

_xmass_take_backup() {
  # Ensure stage dir on target exists regardless of method
  ssh root@"${_tgt}" "rm -rf ${_XTRA_STAGE_TGT}; mkdir -p ${_XTRA_STAGE_TGT}"

  if [ "${_XTRA_METHOD}" = "stage" ]; then
    _info "xtrabackup: backing up to ${_XTRA_STAGE_SRC} (stage method) ..."
    rm -rf "${_XTRA_STAGE_SRC}"
    mkdir -p "${_XTRA_STAGE_SRC}"
    xtrabackup \
      --defaults-file=/root/.my.cnf \
      --backup \
      --target-dir="${_XTRA_STAGE_SRC}" \
      || _die "xtrabackup --backup failed on source"

    _info "xtrabackup: preparing backup on source ..."
    xtrabackup \
      --prepare \
      --target-dir="${_XTRA_STAGE_SRC}" \
      || _die "xtrabackup --prepare failed on source"

    # _xmass_rsync deliberately returns 0 so a per-account transfer cannot abort
    # the middle of a multi-account pass; the rc is reported through
    # _XMASS_RSYNC_RC instead. This site is the exception that MUST fail closed:
    # everything after it rebuilds the target datadir from this snapshot, so a
    # short copy here is restored over a wiped /var/lib/mysql and replication is
    # attached to an incomplete dataset that only surfaces as missing rows days
    # later, after the source has already been proxied.
    _info "xtrabackup: rsyncing prepared backup to target ${_tgt} ..."
    _XMASS_RSYNC_RC=0
    _xmass_rsync -aEAXq ${_ieni} -e ssh \
      "${_XTRA_STAGE_SRC}/" \
      "root@${_tgt}:${_XTRA_STAGE_TGT}/"
    if [ "${_XMASS_RSYNC_RC:-0}" != "0" ]; then
      _die "rsync of the xtrabackup snapshot to target failed" \
           "(rc=${_XMASS_RSYNC_RC}) — target datadir NOT touched"
    fi

  else
    _info "xtrabackup: streaming backup directly to target ${_tgt} ..."
    xtrabackup \
      --defaults-file=/root/.my.cnf \
      --backup \
      --stream=xbstream \
      | ssh root@"${_tgt}" "xbstream -x -C ${_XTRA_STAGE_TGT}" \
      || _die "xtrabackup stream to target failed"

    _info "xtrabackup: preparing backup on target ${_tgt} ..."
    ssh root@"${_tgt}" \
      "xtrabackup --prepare --target-dir=${_XTRA_STAGE_TGT}" \
      || _die "xtrabackup --prepare on target failed"
  fi

  _info "xtrabackup snapshot complete"
}

_xmass_restore_backup() {
  _info "Stopping MySQL on target ${_tgt} via move_sql.sh ..."
  ssh root@"${_tgt}" "/var/xdrago/move_sql.sh stop" \
    || _die "MySQL stop on target failed"

  _info "Replacing MySQL data dir on target ..."
  ssh root@"${_tgt}" bash <<'REMOTE'
_ts=$(date +%Y%m%d%H%M%S)
mv -f /var/lib/mysql /var/lib/mysql.xmass_pre_${_ts} &>/dev/null || true
mkdir -p /var/lib/mysql
REMOTE

  _info "Running xtrabackup --copy-back on target ${_tgt} ..."
  ssh root@"${_tgt}" \
    "xtrabackup --copy-back \
      --target-dir=${_XTRA_STAGE_TGT} \
      --datadir=/var/lib/mysql" \
    || _die "xtrabackup --copy-back on target failed"

  _info "Fixing MySQL data dir ownership on target ..."
  ssh root@"${_tgt}" "chown -R mysql:mysql /var/lib/mysql"

  # Transfer credentials immediately so target MySQL client tools work
  _info "Transferring MySQL credentials to target ..."
  scp /root/.my.cnf "root@${_tgt}:/root/.my.cnf" \
    || _die "Failed to scp .my.cnf to target"
  scp /root/.my.pass.txt "root@${_tgt}:/root/.my.pass.txt" \
    || _die "Failed to scp .my.pass.txt to target"
  ssh root@"${_tgt}" \
    "chmod 600 /root/.my.cnf; chmod 600 /root/.my.pass.txt 2>/dev/null; true"

  _info "Starting MySQL on target ${_tgt} via move_sql.sh ..."
  ssh root@"${_tgt}" "/var/xdrago/move_sql.sh start" \
    || _die "MySQL start on target failed"
}

###-------------SLAVE SETUP--------------###

_xmass_setup_slave() {
  _info "Reading GTID set from xtrabackup_binlog_info on target ${_tgt} ..."
  local _binlog_info _gtid_set
  _binlog_info=$(ssh root@"${_tgt}" \
    "cat ${_XTRA_STAGE_TGT}/xtrabackup_binlog_info 2>/dev/null || echo ''" )
  _gtid_set=$(echo "${_binlog_info}" | awk '{print $3}')

  if [ -z "${_gtid_set}" ]; then
    _die "Empty GTID set in xtrabackup_binlog_info — " \
         "was GTID enabled on source before taking backup?"
  fi
  _info "GTID set from backup: ${_gtid_set}"

  # Runtime half of the 5.7 parallel-apply setup (the conf half persists it):
  # covers a target whose GTID was already ON, where no restart read the conf.
  # Legal here because the replica threads are not started yet.
  if [ "${_XMASS_PERCONA_V}" = "5.7" ]; then
    ssh root@"${_tgt}" "mysql --defaults-file=/root/.my.cnf \
      -e \"SET GLOBAL slave_parallel_type='LOGICAL_CLOCK'; \
           SET GLOBAL slave_parallel_workers=${_XMASS_PARALLEL_WORKERS:-4};\"" \
      || _alrt "could not set 5.7 parallel-apply on target (replica may lag single-threaded)"
  fi

  _info "Configuring replication slave on target ${_tgt} ..."
  ssh root@"${_tgt}" "mysql --defaults-file=/root/.my.cnf" <<SLAVEEOF
${_XM_RESET_MASTER};
SET GLOBAL gtid_purged='${_gtid_set}';
${_XM_CHANGE}
  ${_XM_HOST}='${_XMASS_SRC_IP}',
  ${_XM_USER}='${_REPL_USER}',
  ${_XM_PASSWORD}='${_XMASS_REPL_PSWD}',
${_XM_GET_PUBKEY}
  ${_XM_AUTOPOS}=1;
${_XM_START};
SLAVEEOF
  [ $? -eq 0 ] || _die "Slave configuration failed on target ${_tgt}"

  # The IO thread needs a moment to connect, so poll (not a single check), and
  # require BOTH threads = Yes -- the old single "Yes" match passed on
  # SQL_Running=Yes alone while IO_Running was still "Connecting" (or wedged on
  # an auth error), letting a broken replica through to sync/cutover.
  _info "Verifying replica IO+SQL threads are running on target ..."
  local _i _io _sql
  for _i in $(seq 1 12); do
    _io=$(ssh root@"${_tgt}" \
      "mysql --defaults-file=/root/.my.cnf -e \"${_XM_SHOW_STATUS}\G\" 2>/dev/null \
       | grep '${_XM_IO_FIELD}:' | awk '{print \$2}'" 2>/dev/null)
    _sql=$(ssh root@"${_tgt}" \
      "mysql --defaults-file=/root/.my.cnf -e \"${_XM_SHOW_STATUS}\G\" 2>/dev/null \
       | grep '${_XM_SQL_FIELD}:' | awk '{print \$2}'" 2>/dev/null)
    if [ "${_io}" = "Yes" ] && [ "${_sql}" = "Yes" ]; then
      _info "Replica running on target ${_tgt} (IO+SQL = Yes): OK"
      return 0
    fi
    sleep 5
  done
  local _err
  _err=$(ssh root@"${_tgt}" \
    "mysql --defaults-file=/root/.my.cnf -e \"${_XM_SHOW_STATUS}\G\" 2>/dev/null \
     | grep -E 'Last_IO_Error:|Last_SQL_Error:' | grep -v ': *\$'" 2>/dev/null)
  _die "Replica not running on target ${_tgt} (IO=${_io} SQL=${_sql}). ${_err}"
}

###-------------SOLR MANAGEMENT----------###

_xmass_prevent_solr_target() {
  _info "Holding Solr on target ${_tgt} until cutover sync completes ..."
  ssh root@"${_tgt}" bash <<'REMOTE'
mkdir -p /var/log/boa 2>/dev/null
touch /var/log/boa/.xmass_solr_hold.pid
for _svc in solr9 solr7 solr4 jetty9; do
  if [ -x "/etc/init.d/${_svc}" ]; then
    service ${_svc} stop &>/dev/null || true
  fi
done
REMOTE
  _info "Solr held on target ${_tgt}: OK"
}

_xmass_stop_solr_source() {
  _info "Stopping Solr on source and disabling it permanently ..."
  for _svc in solr9 solr7 solr4 jetty9; do
    if [ -x "/etc/init.d/${_svc}" ]; then
      service "${_svc}" stop &>/dev/null || true
      _info "  Stopped ${_svc} on source"
    fi
  done
  # Touch the BOA deny file so BOA never restarts Solr on source again;
  # also set the variable form so the deny survives the marker's eventual
  # retirement. The touch stays unconditional (skew armour: an older
  # BARRACUDA on this box honours only the file).
  touch "${_SOLR_DENY_FILE}"
  local _denyVarSet=NO
  if [ -e "/root/.barracuda.cnf" ]; then
    if grep -q "^_DENY_JAVA=" /root/.barracuda.cnf 2>/dev/null; then
      sed -i "s/^_DENY_JAVA=.*/_DENY_JAVA=YES/" /root/.barracuda.cnf
    else
      # Newline-terminate before the append; an unterminated last line
      # would swallow the previous key.
      [ -n "$(tail -c1 /root/.barracuda.cnf 2>/dev/null)" ] && echo >> /root/.barracuda.cnf
      echo "_DENY_JAVA=YES" >> /root/.barracuda.cnf
    fi
    # Report what LANDED, not what was attempted.
    grep -q "^_DENY_JAVA=YES" /root/.barracuda.cnf 2>/dev/null && _denyVarSet=YES
  fi
  if [ "${_denyVarSet}" = "YES" ]; then
    _info "Solr disabled on source (${_SOLR_DENY_FILE} created, _DENY_JAVA=YES set): OK"
  else
    _alrt "Solr disabled on source (${_SOLR_DENY_FILE} created) -- variable form NOT set; add _DENY_JAVA=YES to /root/.barracuda.cnf by hand"
  fi
}

_xmass_start_solr_target() {
  # Remove Solr transaction logs on target before first start.
  # Source Solr was stopped cleanly before final rsync, so tlogs should be
  # nearly empty, but removing them prevents any risk of double-indexing on
  # first startup. BOA performs no special Solr recovery beyond core health
  # checks and optimisation, so this is the correct pre-start procedure here.
  _info "Clearing Solr transaction logs on target ${_tgt} ..."
  ssh root@"${_tgt}" bash <<'REMOTE'
for _tlog in $(find /opt/solr4 /var/solr7/data /var/solr9/data \
  -name tlog -type d 2>/dev/null); do
  rm -rf "${_tlog}"
  echo "INFO: Removed tlog at ${_tlog}"
done
REMOTE
  _info "Starting Solr on target ${_tgt} ..."
  ssh root@"${_tgt}" bash <<'REMOTE'
rm -f /var/log/boa/.xmass_solr_hold.pid
for _svc in solr9 solr7; do
  if [ -x "/etc/init.d/${_svc}" ] \
    && [ -e "/etc/default/${_svc}.in.sh" ]; then
    pkill -9 -f ${_svc} &>/dev/null || true
    service ${_svc} start &>/dev/null || true
    echo "INFO: Started ${_svc} on target"
  fi
done
if [ -e "/etc/default/jetty9" ] && [ -e "/etc/init.d/jetty9" ]; then
  pkill -9 -f jetty9 &>/dev/null || true
  service jetty9 start &>/dev/null || true
  echo "INFO: Started jetty9 on target"
fi
REMOTE
  _info "Waiting 30s for Solr to initialise on target ..."
  sleep 30
  _xmass_solr_check_target
  _info "Solr started on target ${_tgt}: OK"
}

_xmass_solr_check_target() {
  # Informational HTTP reachability check against the ports BOA actually
  # installs on: solr9 9099, solr7 9077, jetty9/solr4 8099 (plus 8983 for a
  # hand-installed upstream Solr). Probed over ssh on 127.0.0.1 — Solr binds
  # localhost and CSF filters the public interface, so the old public-IP
  # probe of 8983/8984/8080 could never see a healthy BOA Solr.
  # A non-200/302 response is a warning, not a fatal error — Solr may still
  # be replaying its write-ahead log or warming up caches.
  _info "Checking Solr HTTP response on target ${_tgt} ..."
  local _line _rest _ok=NO
  while read -r _line; do
    [ -z "${_line}" ] && continue
    case "${_line}" in
      OK:*)
        _rest="${_line#OK:}"
        _info "  Solr responding on port ${_rest%%:*}: HTTP ${_rest#*:} OK"
        _ok=YES
        ;;
      NO:*)
        _rest="${_line#NO:}"
        _info "  Solr port ${_rest%%:*}: HTTP ${_rest#*:} (not yet ready or not active)"
        ;;
    esac
  done <<< "$(ssh root@"${_tgt}" 'for _p in 9099 9077 8099 8983; do
    _h=$(curl -s -o /dev/null -w "%{http_code}" --max-time 15 -A iCab "http://127.0.0.1:${_p}/solr/" 2>/dev/null)
    if [ "${_h}" = "200" ] || [ "${_h}" = "302" ]; then echo "OK:${_p}:${_h}"; else echo "NO:${_p}:${_h}"; fi
  done' 2>/dev/null)"
  if [ "${_ok}" = "NO" ]; then
    _alrt "No Solr port responded on target — check manually after cutover:" \
          " ssh root@${_tgt} 'curl http://127.0.0.1:9099/solr/'"
  fi
}

###-------------ACCOUNT ENUMERATION------###

_xmass_enumerate_accounts() {
  _ELIGIBLE_ACCOUNTS=""
  local _oct _udir _miss _skipped="" _line
  for _udir in $(find /data/disk -maxdepth 1 -mindepth 1 -type d | sort); do
    _oct=$(basename "${_udir}")
    case "${_oct}" in
      arch|all|lost+found|lostfound|backups|codebases-cleanup|legacy|xusage)
        continue ;;
    esac
    # Collect the reason(s) instead of silently dropping the account: an
    # ineligible account still replicates its databases, but its files are never
    # transferred and its vhosts are never converted, while the cutover reports
    # success. On a multi-account box the dropped account can be the one carrying
    # most of the traffic, so this must be visible BEFORE the operator commits.
    _miss=""
    [ -e "${_udir}/log/cores.txt" ]       || _miss="${_miss} log/cores.txt"
    [ -e "${_udir}/log/option.txt" ]      || _miss="${_miss} log/option.txt"
    [ -e "${_udir}/log/email.txt" ]       || _miss="${_miss} log/email.txt"
    [ -e "${_udir}/tools/le/dehydrated" ] || _miss="${_miss} tools/le/dehydrated"
    [ -e "${_udir}/log/CANCELLED" ]       && _miss="${_miss} log/CANCELLED(present)"
    if [ -z "${_miss}" ]; then
      _ELIGIBLE_ACCOUNTS="${_ELIGIBLE_ACCOUNTS} ${_oct}"
    else
      _skipped="${_skipped}${_oct}: ${_miss## }
"
    fi
  done
  _ELIGIBLE_ACCOUNTS="${_ELIGIBLE_ACCOUNTS## }"
  _info "Eligible Octopus accounts: ${_ELIGIBLE_ACCOUNTS:-none found}"
  if [ -n "${_skipped}" ]; then
    _alrt "SKIPPED accounts under /data/disk — these will NOT be migrated:"
    printf '%s' "${_skipped}" | while IFS= read -r _line; do
      [ -n "${_line}" ] && _alrt "    ${_line}"
    done
    _alrt "Confirm every skip above is intended before running --live."
  fi
  [ -z "${_ELIGIBLE_ACCOUNTS}" ] && _die "No eligible Octopus accounts found on source"
  return 0
}

# --- storage-aware store relocation (attached /mnt vs root, source vs target) ------
#
# A store directory (static/files, arch, or a legacy /mnt-anchored symlink) is
# transferred to the target honouring BOTH sides' disk reality:
#   source on a mount (symlink -> /mnt/...) + target HAS a mount -> MIRROR onto the
#       target mount and re-point the link there (even if root has room)
#   source on a mount + target has NO mount                      -> DE-REFERENCE to a
#       real dir on the target root
#   source a real dir on root                                    -> keep a real dir on
#       root; use the target mount only as a fallback if root cannot fit it
# DENY (non-zero) only when: a source symlink is dangling (attached disk not mounted),
# the target has MULTIPLE /mnt mounts, or the store fits nowhere.

# Print the target's single attached mountpoint under /mnt, "MULTI" if more than one,
# or nothing if none. Same detection migratefs + the lshell FTP-jail use.
# Prints "MULTI" (more than one), the single mountpoint path, or "NONE" (zero mounts).
# Empty output therefore means ONLY that the ssh query itself failed -> caller aborts,
# so a transient ssh hiccup never silently downgrades a mirror to a root de-reference.
_xmass_detect_target_mnt() {
  ssh root@"$1" 'p=$(stat -c "%d" /mnt 2>/dev/null); n=0; h=""; for m in /mnt/*; do [ -d "$m" ] || continue; if mountpoint -q "$m" 2>/dev/null || { [ -n "$p" ] && [ "$(stat -c "%d" "$m" 2>/dev/null)" != "$p" ]; }; then h="$m"; n=$((n+1)); fi; done; if [ "$n" -gt 1 ]; then echo MULTI; elif [ "$n" -eq 1 ]; then printf "%s" "$h"; else echo NONE; fi'
}

# Resolve the target's attached mount into _TGT_MNT ("" = none), aborting the run on a
# failed query, an empty target host, or more than one mount. $1 = target host.
_xmass_resolve_target_mnt() {
  local _raw
  if [ -z "$1" ]; then
    _die "empty target host — refusing"
  fi
  _raw="$(_xmass_detect_target_mnt "$1")"
  case "${_raw}" in
    MULTI)
      _die "target $1 has multiple /mnt mounts; BOA supports a single attached mount — refusing"
      ;;
    NONE) _TGT_MNT="" ;;
    "")
      _die "could not query /mnt on target $1 (ssh failed?) — refusing"
      ;;
    *) _TGT_MNT="${_raw}" ;;
  esac
}

# 0 if the target filesystem that would host <dest> (nearest existing ancestor) has
# room for <needKB>. Unknown size or unknown avail -> assume ok (do not block).
# --- DRY/live gate (autosymlink --batch model, keyed per target) --------------------
# Default is a read-only DRY run that records CLEAN/NOT_CLEAN; --live proceeds only if
# the last run for THIS target was a CLEAN DRY, then invalidates it so one dry
# can never arm two lives. xmass migrates many accounts to ONE target, so the state is
# keyed on the target host: a single DRY reports the plan for all accounts + shared.
_xmass_state_file() {
  local _key
  _key="$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"
  printf '/var/log/boa/xmass.migrate.%s.state' "${_key}"
}
_xmass_write_state() {   # 1 tgt 2 status 3 mode
  local _sf; _sf="$(_xmass_state_file "$1")"
  mkdir -p /var/log/boa 2>/dev/null
  { echo "_LAST_MODE=$3"; echo "_LAST_STATUS=$2"; echo "_LAST_TS=$(date '+%Y-%m-%d %H:%M:%S')"; } > "${_sf}"
}
_xmass_require_clean_dry() {   # 1 tgt -- exit unless last run was a CLEAN DRY
  local _sf _m _s; _sf="$(_xmass_state_file "$1")"
  if [ ! -f "${_sf}" ]; then
    _die "--live requires a prior CLEAN dry run for ${1}; run without --live first"
  fi
  _m=$(grep '^_LAST_MODE=' "${_sf}" | head -n1 | cut -d= -f2-)
  _s=$(grep '^_LAST_STATUS=' "${_sf}" | head -n1 | cut -d= -f2-)
  if [ "${_m}" != "DRY" ] || [ "${_s}" != "CLEAN" ]; then
    _die "--live needs the last run for ${1} to be a CLEAN dry run (got mode=${_m:-none} status=${_s:-none}); re-run the dry run and clear any DENY first"
  fi
  _xmass_write_state "$1" "LIVE" "LIVE"   # consume the clean-dry token
}
_xmass_finalize_dry() {   # 1 tgt
  if [ "${_XMASS_NOT_CLEAN}" = "NO" ]; then
    _info "[DRY] CLEAN: no blocking issues. Re-run the same command with --live to perform the migration."
    _xmass_write_state "$1" "CLEAN" "DRY"
  else
    _alrt "[DRY] NOT CLEAN: see DENY line(s) above. --live is refused until resolved."
    _xmass_write_state "$1" "NOT_CLEAN" "DRY"
  fi
}
# Mode-aware rsync: performs the transfer in LIVE, only reports it in DRY.
_xmass_rsync() {
  local _rc=0
  if [ "${_MODE}" = "LIVE" ]; then
    # Trailing (after "$@") is deliberate: callers pass -a/-aEAX which implies
    # -D; rsync honours the LAST matching option, so these must follow -a to
    # actually drop device/fifo/socket nodes. Never transfer specials.
    rsync "$@" --no-devices --no-specials || _rc=$?
    if [ "${_rc}" != "0" ]; then
      if [ "${_rc}" = "24" ]; then
        # 24 = "some files vanished before transfer". Expected on a live tree and
        # not an integrity problem: the file is gone on the source as well.
        _info "  rsync: some source files vanished during transfer (rc=24, benign)"
      else
        # Everything else -- including 23, partial transfer due to error -- means
        # the target tree may be incomplete. Callers never see this because they
        # cannot abort mid-account, so record it and let the caller's gate stop
        # the run before anything destructive happens.
        _alrt "DENY: rsync FAILED rc=${_rc}: $*"
        _XMASS_RSYNC_RC="${_rc}"
        _XMASS_NOT_CLEAN=YES
      fi
    fi
  else
    _info "[DRY-PLAN] would rsync: $*"
  fi
  return 0
}

# Solr indices can be large; fold them into the disk-space gate. Checks that <src>
# fits at its target destination dir (which follows the target's /var/solrN symlink
# onto a mount, or lands on root). Returns 0 if it fits (or src absent), 1 + DENY +
# NOT_CLEAN otherwise. Placement is unchanged (data-only rsync) — this only gates.
_xmass_solr_check() {   # 1 src  2 target-dest-dir  3 label
  local _sz
  [ -e "$1" ] || return 0
  _sz="$(du -sk "$1" 2>/dev/null | awk '{print $1}')"
  _xmass_target_fits "${_tgt}" "$2" "${_sz}" && return 0
  _alrt "DENY: $3: ${_sz:-?}K does not fit at target $2 — free space and retry"
  _XMASS_NOT_CLEAN=YES
  return 1
}

_xmass_target_fits() {
  local _av _q
  _q="$(_shq "$2")"
  _av=$(ssh root@"$1" "p='${_q}'; while [ -n \"\$p\" ] && [ \"\$p\" != / ] && [ ! -d \"\$p\" ]; do p=\$(dirname \"\$p\"); done; df -Pk \"\$p\" 2>/dev/null | awk 'NR==2{print \$4}'" 2>/dev/null)
  if [ -z "$3" ] || [ -z "${_av}" ]; then return 0; fi
  [ "${_av}" -ge "$3" ]
}

# Single-quote-escape a value for safe embedding in a remote 'single-quoted' ssh arg
# (covers a legacy path that might contain a quote).
_shq() { printf "%s" "$1" | sed "s/'/'\\\\''/g"; }

# De-reference: real dir at <dstRoot> on the target root; rsync the contents in.
# Returns non-zero if the copy fails (caller denies).
_xmass_put_on_root() {
  local _th="$1" _real="$2" _dstRoot="$3" _ie="$4" _q
  _q="$(_shq "${_dstRoot}")"
  ssh root@"${_th}" "if [ -L '${_q}' ]; then rm -f '${_q}'; elif [ -e '${_q}' ] && [ ! -d '${_q}' ]; then rm -f '${_q}'; fi; mkdir -p '${_q}'"
  # Tolerate rc 24 exactly as _xmass_rsync does. This gate was previously inert
  # (_xmass_handle_store returned an assignment's status instead of this one), so
  # making it work exposes it to the benign case: on a live tree during `xmass
  # sync`, files vanishing mid-transfer is normal and must not deny the run.
  local _rc=0
  rsync -aEAXqu --no-devices --no-specials ${_ie} -e ssh \
    "${_real}/" root@"${_th}":"${_dstRoot}/" || _rc=$?
  if [ "${_rc}" != "0" ] && [ "${_rc}" != "24" ]; then
    _alrt "DENY: rsync to ${_dstRoot} on target root failed (rc=${_rc})"
    return 3
  fi
  if [ "${_rc}" = "24" ]; then
    _info "  ${_dstRoot}: some source files vanished during transfer (rc=24, benign)"
  fi
  return 0
}

# Mirror: rsync contents to <mntDest> on the target mount, then make <dstRoot> a symlink
# to it. The store ends up on the mount AND stays on the source, so a stale prior copy
# at <dstRoot> (e.g. an earlier de-reference to root now being moved onto a freshly
# attached disk) is safe to replace once the mount copy is confirmed. Returns non-zero
# on any failure (caller denies); the remote replace is fenced to /data/disk.
_xmass_put_on_mount() {
  local _th="$1" _real="$2" _mntDest="$3" _dstRoot="$4" _ie="$5" _lbl="$6" _qm _qd
  _qm="$(_shq "${_mntDest}")"; _qd="$(_shq "${_dstRoot}")"
  ssh root@"${_th}" "mkdir -p '${_qm}'"
  # Same rc-24 tolerance as _xmass_put_on_root; see the note there.
  local _rc=0
  rsync -aEAXqu --no-devices --no-specials ${_ie} -e ssh \
    "${_real}/" root@"${_th}":"${_mntDest}/" || _rc=$?
  if [ "${_rc}" != "0" ] && [ "${_rc}" != "24" ]; then
    _alrt "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed (rc=${_rc}); target link left untouched"
    return 3
  fi
  if [ "${_rc}" = "24" ]; then
    _info "  ${_lbl}: some source files vanished during transfer (rc=24, benign)"
  fi
  if ! ssh root@"${_th}" "d='${_qd}'; case \"\$d\" in /data/disk/*) : ;; *) echo 'refuse: dstRoot outside /data/disk'; exit 9 ;; esac; if [ -L \"\$d\" ]; then rm -f \"\$d\"; elif [ -d \"\$d\" ]; then rm -rf \"\$d\"; elif [ -e \"\$d\" ]; then rm -f \"\$d\"; fi; mkdir -p \"\$(dirname \"\$d\")\"; ln -sfn '${_qm}' \"\$d\""; then
    _alrt "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target"
    return 3
  fi
}

# Storage-aware transfer of one store. Args:
#   1 source path  2 dest path on target root  3 mount-relative dest ("" => derive)
#   4 target host  5 target mount ("path"|""|"MULTI")  6 ieni  7 label
_xmass_handle_store() {
  local _src="$1" _dstRoot="$2" _mntRel="$3" _th="$4" _tm="$5" _ie="$6" _lbl="$7"
  local _real _link _sz _onMnt=NO _mntDest="" _act="" _reason="" _rc=0

  if [ ! -e "${_src}" ] && [ ! -L "${_src}" ]; then
    return 0
  fi

  # --- classify + resolve the source ---
  if [ "${_tm}" = "MULTI" ]; then
    _act=DENY; _reason="target has multiple /mnt mounts; cannot choose one"
  elif [ -L "${_src}" ]; then
    _link="$(readlink "${_src}" 2>/dev/null)"
    _real="$(readlink -f "${_src}" 2>/dev/null)"
    if [ -z "${_real}" ] || [ ! -d "${_real}" ]; then
      _act=DENY; _reason="${_src} is a dangling symlink (attached disk not mounted?)"
    else
      case "${_link}" in /mnt/*) _onMnt=YES ;; esac
    fi
  elif [ -d "${_src}" ]; then
    _real="${_src}"
  else
    return 0
  fi

  # --- decide (mirror / root / deny), source-shape preferred, space-checked ---
  if [ -z "${_act}" ]; then
    _sz="$(du -sk "${_real}" 2>/dev/null | awk '{print $1}')"
    if [ -z "${_mntRel}" ] && [ "${_onMnt}" = "YES" ]; then
      _mntRel="${_real#/mnt/*/}"
    fi
    [ -n "${_tm}" ] && [ -n "${_mntRel}" ] && _mntDest="${_tm}/${_mntRel}"
    if [ "${_onMnt}" = "YES" ] && [ -n "${_mntDest}" ]; then
      if _xmass_target_fits "${_th}" "${_mntDest}" "${_sz}"; then _act=MIRROR
      elif _xmass_target_fits "${_th}" "${_dstRoot}" "${_sz}"; then _act=ROOT
      else _act=DENY; _reason="does not fit on target mount (${_mntDest}) nor root (${_dstRoot})"; fi
    else
      if _xmass_target_fits "${_th}" "${_dstRoot}" "${_sz}"; then _act=ROOT
      elif [ -n "${_mntDest}" ]; then _act=MIRROR
      else _act=DENY; _reason="does not fit on target root (${_dstRoot}) and no usable target mount"; fi
    fi
  fi

  # --- execute per mode: DRY reports the plan + flags NOT CLEAN on any deny; LIVE acts ---
  case "${_act}" in
    DENY)
      _alrt "DENY: ${_lbl}: ${_reason} — free space / fix and retry"
      _XMASS_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && return 3
      return 0
      ;;
    MIRROR)
      if [ "${_MODE}" = "LIVE" ]; then
        # Capture rc FIRST: `|| { _XMASS_NOT_CLEAN=YES; return $?; }` returned the
        # assignment's status (always 0), so a failed placement reported success
        # and _XMASS_STORE_RC was never set by the caller.
        _xmass_put_on_mount "${_th}" "${_real}" "${_mntDest}" "${_dstRoot}" "${_ie}" "${_lbl}" \
          || { _rc=$?; _XMASS_NOT_CLEAN=YES; return "${_rc}"; }
        _info "${_lbl}: mirrored to target mount ${_mntDest}, symlinked ${_dstRoot}"
      else
        _info "[DRY-PLAN] ${_lbl}: would mirror onto target mount ${_mntDest} and symlink ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
    ROOT)
      if [ "${_MODE}" = "LIVE" ]; then
        _xmass_put_on_root "${_th}" "${_real}" "${_dstRoot}" "${_ie}" \
          || { _rc=$?; _XMASS_NOT_CLEAN=YES; return "${_rc}"; }
        _info "${_lbl}: real dir on target root ${_dstRoot}"
      else
        _info "[DRY-PLAN] ${_lbl}: would place real dir on target root ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
  esac
  return 0
}

# Catch-all: any symlink (besides static/files, handled explicitly) whose OWN target
# is /mnt/... gets the same storage-aware treatment, so non-standard legacy links are
# never left dangling on the target. Sets _XMASS_STORE_RC on any DENY. NOTE: on a rename
# the derived on-mount path keeps the SOURCE account name for a legacy link (it still
# resolves; only the mount-relative path is cosmetically old-named).
_xmass_catchall_mnt_symlinks() {
  local _root="$1" _dstRoot="$2" _th="$3" _tm="$4" _ie="$5"
  local _l _lt _rel _dl
  while IFS= read -r _l; do
    [ -n "${_l}" ] || continue
    [ "${_l}" = "${_root}/static/files" ] && continue
    _lt="$(readlink "${_l}" 2>/dev/null)"
    case "${_lt}" in /mnt/*) : ;; *) continue ;; esac
    _rel="${_l#"${_root}"/}"
    _dl="${_dstRoot}/${_rel}"
    _xmass_handle_store "${_l}" "${_dl}" "" "${_th}" "${_tm}" "${_ie}" "legacy symlink ${_rel}" || _XMASS_STORE_RC=$?
  done <<EOF
$(find "${_root}" -type l 2>/dev/null)
EOF
}

###-------------SYNC FUNCTIONS-----------###

_xmass_sync_static_symlink_safe() {
  # Mirrors xoct's _xoct_transfer_static_symlink_safe:
  # Preserves site-level symlinks inside static/ while relocating static/files
  # to the target honouring the target's disk reality (mirror onto an attached
  # mount, or de-reference to a real dir on root) via _xmass_handle_store.
  local _src_usr="$1"
  local _dst_usr="$2"
  local _tgt_mnt="$3"
  local _src_static="${_src_usr}/static"
  local _dst_static="${_dst_usr}/static"
  local _dst_sf="${_dst_usr}/static/files"
  local _dst_acct
  _dst_acct="$(basename "${_dst_usr}")"

  [ -d "${_src_static}" ] || return 0

  # Pass 1: sync static/ tree preserving symlinks, skip files/
  _xmass_rsync -aEAXqu ${_ieni} --exclude=/files \
    -e ssh "${_src_static}/" "root@${_tgt}:${_dst_static}/"

  # Pass 1b: the static sync uses -u (skip-newer), but the target's own fresh
  # Octopus install wrote default control files with a NEWER mtime, which
  # shadow the migrated ones -> every migrated site silently loses its PHP
  # pins and falls back to the target's install-time default. The per-site
  # multi-fpm.info lines key on the site domain (unchanged by migration), and
  # the account-level fpm.info/cli.info are the AUTHORITATIVE witnesses BOA
  # derives the octopus.cnf and the FPM pools from (_satellite_cnf and
  # manage_ltd_users both read .info -> rewrite cnf, never the reverse -- an
  # earlier comment here claimed the opposite direction and left the pins to
  # a hand-fix that never came). All three are directly valid on the target:
  # force them over WITHOUT -u. The PHP coverage gate already proved the
  # pinned versions are installed there, so a forced pin cannot strand a
  # site without a pool.
  local _ctl
  for _ctl in multi-fpm.info fpm.info cli.info; do
    if [ -e "${_src_static}/control/${_ctl}" ]; then
      _xmass_rsync -aEAX ${_ieni} -e ssh \
        "${_src_static}/control/${_ctl}" \
        "root@${_tgt}:${_dst_static}/control/${_ctl}"
    fi
  done

  # Pass 2: relocate static/files per target disk reality. Canonical mount layout
  # uses the DEST account name, so a rename lands correctly.
  _xmass_handle_store \
    "${_src_usr}/static/files" \
    "${_dst_sf}" \
    "files/${_dst_acct}/static/files" \
    "${_tgt}" "${_tgt_mnt}" "${_ieni}" \
    "static/files (${_dst_acct})" || _XMASS_STORE_RC=$?
}

_xmass_sync_account() {
  local _oct="$1"
  local _udir="/data/disk/${_oct}"
  local _dst="/data/disk/${_oct}"
  _info "  Syncing account ${_oct} ..."

  # Platform codebases (large; delta-synced efficiently by rsync)
  _xmass_rsync -aEAXqu ${_ieni} -e ssh \
    "${_udir}/distro/" "root@${_tgt}:${_dst}/distro/"

  # User uploaded files (symlink-safe, storage-aware relocation of static/files)
  _xmass_sync_static_symlink_safe "${_udir}" "${_dst}" "${_TGT_MNT}"

  # Log and control files (includes domain.txt, email.txt, etc.).
  # proxied.pid and migproxy.cnf are TARGET-ROLE state and must never arrive
  # from the source: on the documented reset-phase recovery path the source
  # already carries its own source-role copies, and landing them on the
  # target disables LE renewal there and overwrites the target's policy
  # record. pass.txt rides the credential carry below instead, paired with
  # the shadow hash so the two can never disagree.
  _xmass_rsync -aEAXqu ${_ieni} \
    --exclude=proxied.pid --exclude=migproxy.cnf --exclude=pass.txt \
    -e ssh \
    "${_udir}/log/" "root@${_tgt}:${_dst}/log/"

  # Drush aliases are copied WHOLE — including the source's server_master
  # and hostmaster aliases (site aliases get regenerated by renameaegirhost
  # later; synced here so nginx vhosts can reference them before that runs).
  # Which side's server_master copy survives is an rsync -u (skip-newer)
  # mtime race, which is why _xmass_renameaegirhost_all pins OLD via
  # --force-old instead of trusting alias auto-detection. Do NOT add
  # excludes for server_master/hostmaster here: the rename converges either
  # way, and the source platform_* and per-site aliases must always arrive.
  #
  # php.ini is the ONE exception: BOA generates it per box for the local
  # drush CLI and hardens it immutable (chattr +i), so the target's copy is
  # both correct and unreplaceable. Without the exclude, every sync to a
  # real BOA target fails rc=23 on the rename over the immutable file — a
  # failure the pre-rc-capture code swallowed silently for years and the
  # transfer gate now rightly refuses to ignore.
  _xmass_rsync -aEAXqu ${_ieni} --exclude=php.ini \
    -e ssh "${_udir}/.drush/" \
    "root@${_tgt}:${_dst}/.drush/"

  # Nginx vhost configs
  _xmass_rsync -aEAXqu ${_ieni} \
    --exclude=host8.biz --exclude=boa.io --exclude=aegir.cc \
    -e ssh "${_udir}/config/server_master/nginx/vhost.d/" \
    "root@${_tgt}:${_dst}/config/server_master/nginx/vhost.d/"

  for _subdir in pre.d post.d subdir.d platform.d; do
    _xmass_rsync -aEAXqu ${_ieni} \
      -e ssh "${_udir}/config/server_master/nginx/${_subdir}/" \
      "root@${_tgt}:${_dst}/config/server_master/nginx/${_subdir}/" \

  done

  # SSL certificates and LE config
  _xmass_rsync -aEAXqu ${_ieni} \
    -e ssh "${_udir}/config/ssl.d/" \
    "root@${_tgt}:${_dst}/config/ssl.d/"
  _xmass_rsync -aEAXqu ${_ieni} \
    -e ssh "${_udir}/config/server_master/ssl.d/" \
    "root@${_tgt}:${_dst}/config/server_master/ssl.d/"
  _xmass_rsync -aEAXqu ${_ieni} \
    -e ssh "${_udir}/tools/le" \
    "root@${_tgt}:${_dst}/tools/"

  # FTP account SSH keys
  if [ -d "/home/${_oct}.ftp/.ssh" ]; then
    _xmass_rsync -aEAXqu ${_ieni} \
      -e ssh "/home/${_oct}.ftp/.ssh" \
      "root@${_tgt}:/home/${_oct}.ftp/"
  fi

  # The sub-account password store must land BEFORE clients/ does:
  # manage_ltd_users creates sub-users from clients/ within minutes on the
  # target, and honours a pre-existing store entry (the carried password)
  # only if it is already there. Forced (no -u): the target's fresh install
  # must never shadow the carried credentials.
  if [ -d "/home/${_oct}.ftp/users" ]; then
    _xmass_rsync -aEAX ${_ieni} \
      -e ssh "/home/${_oct}.ftp/users/" \
      "root@${_tgt}:/home/${_oct}.ftp/users/"
  fi

  # Sub-account registry + the two dirs xoct always carried and xmass did
  # not: clients/ drives manage_ltd_users' sub-user creation on the target,
  # and backups/ is a hard requirement of renameaegirhost's Aegir-root
  # validation -- without it the cutover rename dies on every account.
  # backups/ can be large, so it goes through the same space gate the Solr
  # trees use before any bytes move; the dir itself must exist regardless.
  if [ -d "${_udir}/clients" ]; then
    _xmass_rsync -aEAXqu ${_ieni} -e ssh \
      "${_udir}/clients/" "root@${_tgt}:${_dst}/clients/"
  fi
  if [ -d "${_udir}/backups" ]; then
    if _xmass_solr_check "${_udir}/backups" "${_dst}/backups" "backups (${_oct})"; then
      _xmass_rsync -aEAXqu ${_ieni} -e ssh \
        "${_udir}/backups/" "root@${_tgt}:${_dst}/backups/"
    fi
  fi
  [ "${_MODE}" = "LIVE" ] \
    && ssh root@"${_tgt}" "mkdir -p ${_dst}/backups ${_dst}/clients" 2>/dev/null
  if [ -d "${_udir}/undo" ]; then
    _xmass_rsync -aEAXqu ${_ieni} -e ssh \
      "${_udir}/undo/" "root@${_tgt}:${_dst}/undo/"
  fi

  # Client-installed toolchains live outside /data/disk in the lshell jail's
  # writable trees and never travelled before -- migrate AS-IS.
  if [ -d "/opt/user/gems/${_oct}.ftp" ]; then
    _xmass_rsync -aEAXqu ${_ieni} -e ssh \
      "/opt/user/gems/${_oct}.ftp/" "root@${_tgt}:/opt/user/gems/${_oct}.ftp/"
  fi
  if [ -d "/opt/user/npm/${_oct}.ftp" ]; then
    _xmass_rsync -aEAXqu ${_ieni} -e ssh \
      "/opt/user/npm/${_oct}.ftp/" "root@${_tgt}:/opt/user/npm/${_oct}.ftp/"
  fi

  # Plan/identity stamps forced over the fresh install's newer defaults
  # (mode-aware helper; prints the plan in DRY).
  _xmass_seed_account_stamps "${_oct}" "${_tgt}"

  # Target-mutating seeding runs only in LIVE: merge the portable cnf values,
  # carry the client credentials, mirror the suspension flag. Repeated syncs
  # keep all three converged with source-side changes until cutover.
  if [ "${_MODE}" = "LIVE" ]; then
    _xmass_push_account_cnf "${_oct}" "${_tgt}"
    _xmass_sync_shell_credentials "${_oct}" "${_tgt}"
    _xmass_copy_suspended_flag "${_oct}" "${_tgt}" || _XMASS_STORE_RC=1
  fi

  # Catch-all: fix any OTHER /mnt-anchored symlink in the account tree that the
  # rsync -a passes above transferred as a bare (dangling-on-target) link.
  _xmass_catchall_mnt_symlinks "${_udir}" "${_dst}" "${_tgt}" "${_TGT_MNT}" "${_ieni}"
}

_xmass_sync_shared() {
  _info "Syncing shared data (/data/all, arch, legacy, bind, static) ..."
  local _item
  for _item in /data/all /data/disk/all /data/disk/legacy; do
    [ -d "${_item}" ] || continue
    [ -L "${_item}" ] && continue
    _xmass_rsync -aEAXqu ${_ieni} -e ssh \
      "${_item}" "root@${_tgt}:$(dirname "${_item}")/"
  done
  # arch: storage-aware -- mirror onto the target mount, or de-reference to root,
  # per the target's disk reality (canonical layout <mount>/files/system/arch).
  _xmass_handle_store "/data/disk/arch" "/data/disk/arch" "files/system/arch" \
    "${_tgt}" "${_TGT_MNT}" "${_ieni}" "arch" || _XMASS_STORE_RC=$?
  [ -d "/var/www/static" ] && \
    _xmass_rsync -aEAXqu ${_ieni} -e ssh \
      /var/www/static "root@${_tgt}:/var/www/"
  [ -d "/etc/bind" ] && \
    _xmass_rsync -aEAXq ${_ieni} -e ssh \
      /etc/bind "root@${_tgt}:/etc/"
  [ -d "/var/log/boa/usage" ] && \
    _xmass_rsync -aEAXq ${_ieni} -e ssh \
      /var/log/boa/usage "root@${_tgt}:/var/log/boa/"
  _info "Shared data sync complete"
}

_xmass_sync_solr() {
  # Solr data is server-wide; safe to rsync while Solr is stopped on source.
  # During periodic sync Solr is still running on source, so rsync is
  # best-effort and may catch slightly inconsistent index state — that is
  # acceptable since a clean final sync runs after Solr is stopped at cutover.
  _info "Syncing Solr data ..."
  local _dir
  for _dir in /opt/solr4 /var/solr7/data /var/solr9/data; do
    [ -e "${_dir}" ] || continue
    # A Solr tree that does not fit is a DENY, not a skip: continuing here
    # promoted a target carrying no search index, after the source's Solr had
    # already been stopped and deny-filed. Record it so the cutover gate stops.
    if ! _xmass_solr_check "${_dir}" "$(dirname "${_dir}")" "solr ${_dir}"; then
      _XMASS_STORE_RC=3
      continue
    fi
    # No output redirect here: _xmass_rsync emits the DENY line that the abort
    # messages tell the operator to look for, and it always returns 0, so a
    # `|| _alrt` handler on this call could never fire.
    _xmass_rsync -aEAXq ${_ieni} -e ssh \
      "${_dir}" "root@${_tgt}:$(dirname "${_dir}")/"
    [ "${_XMASS_RSYNC_RC:-0}" = "0" ] && _info "  Synced ${_dir}"
  done
  _info "Solr data sync complete"
}

###-------------REPLICATION LAG----------###

_xmass_get_repl_lag() {
  ssh root@"${_tgt}" \
    "mysql --defaults-file=/root/.my.cnf -e \
    \"${_XM_SHOW_STATUS}\G\" 2>/dev/null \
    | grep '${_XM_LAG_FIELD}' | awk '{print \$2}'" 2>/dev/null
}

# Say whether waiting longer would actually have helped. A replica that is falling
# further behind will never catch up by extending the timeout, and the operator is
# mid-outage with the web already blocked when they read this.
_xmass_report_lag_trend() {
  local _first="$1" _prev="$2" _last="$3" _elapsed="$4" _overall _recent
  [ -z "${_first}" ] && return 0
  [ -z "${_prev}" ] && _prev="${_first}"
  _overall=$(( _last - _first ))
  _recent=$(( _last - _prev ))
  _alrt "  Lag samples: first ${_first}s, previous ${_prev}s, last ${_last}s over ${_elapsed}s"
  # Judge on the RECENT interval, not first-vs-last: a replica that spiked early
  # and has been draining ever since looks "GROWING" overall while it is in fact
  # about to finish, and telling the operator to give up there is the worst call
  # the tool can make mid-window.
  if [ "${_recent}" -lt 0 ]; then
    _alrt "  Trend: CLOSING by $(( 0 - _recent ))s in the last interval — more time would likely help"
  elif [ "${_recent}" -gt 0 ]; then
    _alrt "  Trend: GROWING by ${_recent}s in the last interval — the replica is falling behind; more time alone will NOT help"
  else
    _alrt "  Trend: FLAT in the last interval"
  fi
  [ "${_overall}" != "${_recent}" ] \
    && _alrt "  Overall change since the first sample: ${_overall}s"
  return 0
}

_xmass_wait_for_sync() {
  # Wait until replica lag reaches 0, with triple-check confirmation.
  # $1 = max wait seconds (default _XMASS_SYNC_MAX_WAIT)
  local _max="${1:-${_XMASS_SYNC_MAX_WAIT}}"
  # A non-numeric or empty override would make every `[ "${_elapsed}" -ge ... ]`
  # comparison error out and the loop never terminate, mid-cutover.
  case "${_max}" in
    ''|*[!0-9]*) _die "_XMASS_SYNC_MAX_WAIT must be a whole number of seconds (got '${_max}')" ;;
  esac
  [ "${_max}" -lt 60 ] && _die "_XMASS_SYNC_MAX_WAIT of ${_max}s is too short to be meaningful"
  local _elapsed=0
  local _lag _pass _first="" _prev=""
  _info "Waiting for replica lag to reach 0 (max ${_max}s) ..."
  while true; do
    _lag=$(_xmass_get_repl_lag)
    if [ -z "${_lag}" ] || [ "${_lag}" = "NULL" ]; then
      _xmass_restore_hint
      _die "Cannot read replication lag — slave may have stopped on ${_tgt}"
    fi
    [ -z "${_first}" ] && _first="${_lag}"
    _info "  Replica lag: ${_lag}s (waited: ${_elapsed}s / ${_max}s)"
    [ "${_lag}" -eq 0 ] && break
    if [ "${_elapsed}" -ge "${_max}" ]; then
      _xmass_report_lag_trend "${_first}" "${_prev}" "${_lag}" "${_elapsed}"
      _xmass_restore_hint
      _die "Replica did not catch up within ${_max}s (last lag: ${_lag}s)." \
           "Raise _XMASS_SYNC_MAX_WAIT, or set slave_parallel_type=LOGICAL_CLOCK" \
           "and slave_parallel_workers=4 on the target. The phase is still" \
           "'syncing', so recover with a fresh DRY then 'xmass cutover ${_tgt} --live'."
    fi
    _prev="${_lag}"
    sleep 15
    _elapsed=$(( _elapsed + 15 ))
  done

  _info "Replica at lag=0; triple-checking (3 × 10s) ..."
  for _pass in 1 2 3; do
    sleep 10
    _lag=$(_xmass_get_repl_lag)
    if [ "${_lag}" != "0" ]; then
      _die "Replica lag not zero on confirmation check ${_pass}/3 (lag=${_lag}s)"
    fi
    _info "  Confirmation check ${_pass}/3: lag=${_lag}s OK"
  done
  _info "Replica fully in sync: OK"
}

###-------------WEB BLOCK / UNBLOCK------###

# Set once the source is serving 503, so _xmass_restore_hint stays silent for any
# abort that happened before the web was touched.
_XMASS_WEB_BLOCKED=NO

# Every abort after the web block leaves the source down. The operator reads this
# mid-window, so spell out the restore rather than making them find the runbook.
_xmass_restore_hint() {
  # Fire when the web block is up OR when only the park happened (an abort
  # between the park and the web block must still tell the operator that
  # cron and the runners are down on this box).
  if [ "${_XMASS_WEB_BLOCKED}" != "YES" ] \
    && [ "${_XMASS_RUNNERS_PARKED}" != "YES" ]; then
    return 0
  fi
  if [ "${_XMASS_WEB_BLOCKED}" = "YES" ]; then
    _alrt "SOURCE IS STILL SERVING 503. To restore service on the SOURCE:"
    _alrt '    rm -f /data/disk/*/static/control/http-off.pid'
    _alrt '    find /var/lib/nginx/speed -type f -delete'
    _alrt '    service nginx reload'
    _alrt "    rm -f ${_SOLR_DENY_FILE}   # only if Solr was serving from here"
    _alrt '    sed -i "s/^_DENY_JAVA=.*/_DENY_JAVA=NO/" /root/.barracuda.cnf   # the variable form of the same deny'
  else
    _alrt "cron and the BOA runners are PARKED on this source. To restore them:"
  fi
  _alrt '    service cron start'
  _alrt '    for s in runner owl usage graceful manage_ltd_users; do \'
  _alrt '      mv -f /var/xdrago/.$s.sh.off /var/xdrago/$s.sh 2>/dev/null; done'
  _alrt "Then confirm a site returns 200 before deciding what to do next."
}

_xmass_block_web_all() {
  _info "Blocking web (http-off.pid) on all source accounts ..."
  _XMASS_WEB_BLOCKED=YES
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    mkdir -p "/data/disk/${_oct}/static/control"
    echo 7200 > "/data/disk/${_oct}/static/control/http-off.pid"
    chown "${_oct}:users" "/data/disk/${_oct}/static/control/http-off.pid" \
      &>/dev/null || true
  done
  # Purge the Nginx speed cache so cached 200s don't mask the 503
  if [ -d "/var/lib/nginx/speed" ]; then
    find /var/lib/nginx/speed -type f -delete &>/dev/null
  fi
  service nginx reload &>/dev/null
  _info "Web blocked on all source accounts: OK"
}

_xmass_remove_http_off_all() {
  _info "Removing http-off.pid from source accounts ..."
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    case " ${_XMASS_PROXY_CONV_FAILED:-} " in
      *" ${_oct} "*)
        # A failed conversion means this account's vhosts still serve the OLD
        # local copy while the database now lives on the target; serving it
        # would fork the data silently. The 503 gate stays up until the
        # operator fixes the cause and re-runs xoct proxy for the account.
        _alrt "  ${_oct}: proxy conversion failed; keeping the 503 gate up"
        continue
      ;;
    esac
    rm -f "/data/disk/${_oct}/static/control/http-off.pid"
  done
  if [ -d "/var/lib/nginx/speed" ]; then
    find /var/lib/nginx/speed -type f -delete &>/dev/null
  fi
}

_xmass_remove_http_off_target() {
  # The source's export-time 503 gate (http-off.pid, a cache-TTL integer, not a
  # self-expiry) rides the final account rsync into each target account's
  # static/control and nothing on the target removes it -- so a freshly
  # promoted target serves 503 on every site (and the source proxy relays that
  # 503). Clear it on the target once the accounts are renamed and ready.
  _info "Removing http-off.pid from all target accounts on ${_tgt} ..."
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    ssh root@"${_tgt}" \
      "rm -f /data/disk/${_oct}/static/control/http-off.pid" 2>/dev/null \
      || _alrt "Could not remove http-off.pid for ${_oct} on target ${_tgt}"
  done
  ssh root@"${_tgt}" \
    "[ -d /var/lib/nginx/speed ] && find /var/lib/nginx/speed -type f -delete &>/dev/null; service nginx reload &>/dev/null; true"
  _info "Target web serving enabled (http-off.pid cleared): OK"
}

###-------------BOA PROCESS CHECK--------###

# Pause / resume the mysql.sh watchdog on BOTH hosts for a migration's critical
# section. While /run/boa_sql_maintenance.pid exists the watchdog stands down
# entirely (see monitor/check/mysql.sh), so it never restarts, lock-breaks, or
# query-kills MySQL mid xtrabackup snapshot, replica setup, or the cutover
# FLUSH lock. Best-effort on the target; the watchdog self-ignores a stale
# marker (>4h) and /run is tmpfs, so a died operation never wedges auto-heal.
_xmass_maint_on() {
  : > /run/boa_sql_maintenance.pid
  ssh root@"${_tgt}" ": > /run/boa_sql_maintenance.pid" 2>/dev/null || true
}
_xmass_maint_off() {
  rm -f /run/boa_sql_maintenance.pid
  ssh root@"${_tgt}" "rm -f /run/boa_sql_maintenance.pid" 2>/dev/null || true
}

_xmass_check_no_boa_running() {
  _info "Verifying BOA background jobs are stopped ..."
  # usage.sh was missing from this loop while pre-mig parks all five -- a
  # cron-restored usage.sh could be live through the whole cutover with this
  # gate reporting OK.
  local _fail=NO _p
  for _p in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
    if [ -e "/var/xdrago/${_p}" ]; then
      _alrt "BOA script still active: /var/xdrago/${_p} — run xmass pre-mig first"
      _fail=YES
    fi
  done
  if pgrep -x cron &>/dev/null; then
    _alrt "System cron is still running — stop it before cutover"
    _fail=YES
  fi
  [ "${_fail}" = "YES" ] \
    && _die "BOA/cron processes active — stop them before running cutover"
  _info "No conflicting BOA/cron processes: OK"
}

###-------------PROXY CONVERSION---------###

_xmass_convert_source_to_proxy() {
  # Delegate per-account proxy vhost conversion to xoct, which resolves each
  # account's proxy mode from its own record (or the box default written at
  # init/cutover), writes and pushes the policy records, wires the target
  # trust and mails the mode-selected completion notice. No mode flag is
  # passed down: a box-wide choice injected at flag precedence would clobber
  # per-account pins, which is the exact property the records exist for.
  #
  # exported.pid is touched per account to satisfy xoct's proxy gate check
  # (_migrate_sites verifies it before converting vhosts); xmass never runs
  # the export step that would normally create it.
  #
  # Failures collect per account instead of _alrt-and-forget: a failed
  # conversion must keep its 503 gate (step 17) and must not be stamped
  # proxied (step 18) -- its vhosts still serve the OLD local copy while the
  # database now lives on the target.
  _info "Converting all source accounts to proxy vhosts via xoct ..."
  _XMASS_PROXY_CONV_FAILED=""
  local _oct _rc
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    if [ -e "/data/disk/${_oct}/log/proxied.pid" ]; then
      _info "  ${_oct}: already proxied earlier; leaving as is"
      continue
    fi
    touch "/data/disk/${_oct}/log/exported.pid"
    _info "  xoct proxy ${_oct} ${_tgt} ..."
    xoct proxy "${_oct}" "${_tgt}"
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
      _alrt "xoct proxy returned rc=${_rc} for account ${_oct} -- NOT converted"
      _XMASS_PROXY_CONV_FAILED="${_XMASS_PROXY_CONV_FAILED} ${_oct}"
    fi
  done
  _info "Source proxy conversion via xoct complete"
}

###-------------MIGRATION PROXY TRUST------###

_xmass_setup_migration_proxy_trust() {
  # Wire the migration-proxy trust on the TARGET (new host) BEFORE the source
  # starts proxying, so the new host recovers the real client (nginx realip) and
  # never bans the proxy (csf) from the very first relayed request.  Without this
  # the new host keys every $remote_addr-based control (scan_nginx, geo ban,
  # ip_access, AI guards) and csf/lfd on the proxy IP -- unable to act on real
  # clients, and one ban on the proxy would blackhole every migrated site.  See
  # migration_proxy_trust.sh.  (No source-side trust is needed: the proxy only
  # makes OUTBOUND connections to the target, so the target never trips the
  # source's inbound csf/lfd, and a source-side whitelist would just orphan when
  # the source is later repurposed.)
  local _tool="/var/xdrago/migration_proxy_trust.sh"
  local _realip="/var/xdrago/migration_proxy_realip.sh"
  local _src_ips _perm=""

  # Forward the source's routable IPv4 address(es) as the trusted proxy peer(s):
  # the new host sees the proxy's egress IP as the TCP peer.  Drop IPv6 (the csf
  # whitelist is IPv4 and proxy_pass targets an IPv4 _target_ip) and loopback;
  # KEEP private IPs (the source->target hop may run over a private network).
  _src_ips="$(hostname -I 2>/dev/null | tr ' ' '\n' \
    | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
    | grep -vE '^127\.' | tr '\n' ' ')"
  _src_ips="${_src_ips%"${_src_ips##*[![:space:]]}"}"
  [ -n "${_src_ips}" ] || _src_ips="${_XMASS_SRC_IP}"
  # The permanent marker on the target is box-level and cannot be split per
  # account, so the aggregate takes the longest-lived mode present: ANY
  # account resolving permanent or ha-switch keeps the trust past post-mig
  # (ha-switch behaves exactly as permanent for trust and teardown; it
  # differs only in the client notification). The target's reconcile later
  # refines this from its own per-account records.
  local _poct
  for _poct in ${_ELIGIBLE_ACCOUNTS}; do
    _mig_resolve "/data/disk/${_poct}" >/dev/null
    case "${_MIG_MODE}" in
      permanent|ha-switch) _perm="--permanent"; break ;;
    esac
  done

  # The proxy resolves the real client for CF-fronted sites via its OWN http-level
  # Cloudflare realip (server.tpl.php), which the proxy vhost inherits.  Refresh
  # that trust now so the proxy forwards the visitor -- not the CF edge IP -- in
  # the CF-Connecting-IP header it hands the new host.
  [ -x "/var/xdrago/cloudflare_realip.sh" ] \
    && /var/xdrago/cloudflare_realip.sh >/dev/null 2>&1

  # Make the target self-sufficient: ship both tools (its BOA may predate them),
  # then wire the trust there.  trust.sh invokes migration_proxy_realip.sh.
  if [ -x "${_tool}" ] && [ -x "${_realip}" ]; then
    scp -q "${_tool}" "${_realip}" root@"${_tgt}":/var/xdrago/ 2>/dev/null \
      && ssh root@"${_tgt}" "chmod 0755 '${_tool}' '${_realip}'" 2>/dev/null
  fi

  if ssh root@"${_tgt}" "[ -x '${_tool}' ]" 2>/dev/null; then
    _info "Trusting migration proxy ${_src_ips// /, } on target ${_tgt} (realip + csf) ..."
    ssh root@"${_tgt}" "${_tool} trust ${_src_ips} ${_perm}" \
      || _alrt "migration_proxy_trust setup returned non-zero on target ${_tgt}"
  else
    _alrt "Skipping target trust: ${_tool} missing on target ${_tgt} -- realip/csf NOT wired; real-client bans and per-site ip_access will not work through the proxy"
  fi
}

###-------------PANEL DB REWIRE ON TARGET---###

_xmass_rewire_panel_db_access() {
  # The init-time datadir swap replaced the target's MySQL wholesale with
  # the source's: the fresh-install panel DBs that the surviving
  # NEW-host-named panel site dirs point at died with it, and the live
  # (source-named) panel DB users' passwords exist only as hashes inside
  # the replicated mysql.user — nothing on the target can rewire the panel
  # without resetting them. Rewire every Aegir root's control panel BEFORE
  # the step-13 rename so its queue passes (§5 cc, §7, §8) run against a
  # bootstrappable hostmaster: discover the live hostmaster DB per root
  # (same publish-path discriminator as renameaegirhost §5, refusing to
  # guess on zero or several matches), reset that DB user's password across
  # its enumerated host variants, and rewrite the panel dir's credential
  # fields in place, preserving exact ownership and modes. Idempotent: a
  # root whose panel drushrc already names a live DB is skipped, so resumed
  # runs and any flow without a datadir swap no-op here. Per-root failures
  # collect like the rename step's so the caller parks the cutover
  # resumably.
  local _rc _src_fqdn
  _src_fqdn=$(grep "remote_host" /var/aegir/.drush/server_master.alias.drushrc.php 2>/dev/null \
    | head -1 \
    | sed "s/.*remote_host.*=>//; s/[' ,;]//g")
  _src_fqdn=${_src_fqdn//[^a-zA-Z0-9.\-]/}
  [ -z "${_src_fqdn}" ] && _src_fqdn=$(hostname -f 2>/dev/null | tr -d '\n')
  if [ -z "${_src_fqdn}" ]; then
    _alrt "Cannot determine the source FQDN for the panel rewire step"
    _XMASS_PANEL_FAILED=" fqdn-detection"
    return 1
  fi

  _XMASS_PANEL_FAILED=""
  _info "Rewiring panel DB access on target ${_tgt} for all Aegir roots ..."

  local _probe_rc _root
  for _root in /var/aegir $(printf '/data/disk/%s ' ${_ELIGIBLE_ACCOUNTS}); do
    # Same 0/1-vs-ssh-failure split as the rename step: 255 (and anything
    # else) is an ssh-layer failure and must park, not silently skip.
    ssh root@"${_tgt}" \
      "[ -f '${_root}/.drush/hostmaster.alias.drushrc.php' ]" 2>/dev/null
    _probe_rc=$?
    if [ "${_probe_rc}" -eq 1 ]; then
      _alrt "Skipping panel rewire for ${_root} — hostmaster alias not found on target"
      continue
    elif [ "${_probe_rc}" -ne 0 ]; then
      _alrt "Cannot check ${_root} on target (ssh rc=${_probe_rc})"
      _XMASS_PANEL_FAILED="${_XMASS_PANEL_FAILED} ${_root}"
      continue
    fi
    _info "  Rewiring panel DB access for ${_root} on target ..."
    ssh root@"${_tgt}" "bash -s -- '${_root}' '${_src_fqdn}'" <<'REMOTE'
_R="$1"
_S="$2"
_R=${_R//[^a-zA-Z0-9\/._-]/}
_S=${_S//[^a-zA-Z0-9.-]/}
_NEW=$(hostname -f 2>/dev/null | tr -d '\n')
_NEW=${_NEW//[^a-zA-Z0-9.-]/}
if [ -z "${_R}" ] || [ -z "${_S}" ] || [ -z "${_NEW}" ]; then
  echo "PANEL-ERROR: bad arguments or no system FQDN (root=${_R} src=${_S} new=${_NEW})"
  exit 1
fi
_ALS="${_R}/.drush/hostmaster.alias.drushrc.php"
_SP=$(grep "site_path'" "${_ALS}" 2>/dev/null | head -1 | sed "s/.*=>//; s/[' ,;]//g")
if [ -z "${_SP}" ]; then
  echo "PANEL-ERROR: cannot read site_path from ${_ALS}"
  exit 1
fi
# The alias copy that survived the rsync -u mtime race may name either
# hostname variant, and on account roots BOTH panel dirs can exist on disk
# (the source platform tree rsyncs in). The dir the renamed site node will
# serve is the NEW-host-named one — prefer it whenever it exists.
_SPN=${_SP//${_S}/${_NEW}}
if [ -f "${_SPN}/drushrc.php" ]; then
  _SP="${_SPN}"
fi
_OLD_PLAT=""
_NEW_PLAT=""
# A hollow panel platform passes the site-file tests alone: §8 regenerates
# settings.php/drushrc.php into the DB-declared path even when the platform
# CODE was never built there, so a re-entered run would skip the divergence
# it still has. Probe the platform code, not just the site dir.
if [ ! -f "${_SP}/drushrc.php" ] || [ ! -f "${_SP}/settings.php" ] \
  || [ ! -e "$(dirname "$(dirname "${_SP}")")/index.php" ]; then
  # The fqdn substitution cannot heal a DISTRO-NUMBER divergence: the alias
  # that survived the rsync -u mtime race names the SOURCE's panel platform
  # (e.g. distro/003 after one more satellite upgrade there), while the
  # freshly built target's panel lives under a lower number (e.g. 002). A
  # months-old production source vs a fresh target ALWAYS has this shape, so
  # scan the target's own panel tree for the NEW-host-named panel dir and
  # adopt it only when the match is unambiguous — refuse to guess otherwise.
  _TREE=$(dirname "$(dirname "$(dirname "${_SP}")")")
  _FOUND=""; _N=0
  for _CAND in "${_TREE}"/*/sites/*"${_NEW}"*; do
    [ -f "${_CAND}/drushrc.php" ] || continue
    [ -f "${_CAND}/settings.php" ] || continue
    # A site dir on a code-less platform is the hollow shape this branch
    # exists to escape — it must never count as an adoption candidate.
    [ -e "$(dirname "$(dirname "${_CAND}")")/index.php" ] || continue
    _FOUND="${_CAND}"; _N=$((_N+1))
  done
  if [ "${_N}" = "1" ]; then
    echo "PANEL-NOTE: alias-named panel ${_SP} absent; adopted ${_FOUND} (distro number diverged source vs target)"
    # Heal the alias too, or the divergence just bites the next consumer:
    # renameaegirhost resolves the panel through this same alias and dies on
    # the same nonexistent distro/NNN — live-observed on the resume that
    # followed the first version of this fallback. The alias is the lie;
    # correct it once here and every downstream reader gets the truth.
    _OLD_PLAT=$(dirname "$(dirname "${_SP}")")
    _NEW_PLAT=$(dirname "$(dirname "${_FOUND}")")
    if [ "${_OLD_PLAT}" != "${_NEW_PLAT}" ] && [ -f "${_ALS}" ]; then
      sed -i "s|${_OLD_PLAT}|${_NEW_PLAT}|g" "${_ALS}" \
        && echo "PANEL-NOTE: hostmaster alias platform path corrected ${_OLD_PLAT} -> ${_NEW_PLAT}"
    fi
    _SP="${_FOUND}"
  elif [ "${_N}" -gt 1 ]; then
    echo "PANEL-ERROR: ${_N} candidate panel dirs under ${_TREE} match ${_NEW} — refusing to guess"
    exit 1
  fi
fi
if [ ! -f "${_SP}/drushrc.php" ] || [ ! -f "${_SP}/settings.php" ]; then
  echo "PANEL-ERROR: no panel settings.php/drushrc.php under ${_R} (looked at ${_SP})"
  exit 1
fi
_DEAD_DB=$(grep "options\['db_name'\]" "${_SP}/drushrc.php" | head -1 | sed "s/.*=//; s/[' ,;]//g")
_DEAD_DB=${_DEAD_DB//[^a-zA-Z0-9_]/}
if [ -z "${_DEAD_DB}" ]; then
  echo "PANEL-ERROR: cannot read db_name from ${_SP}/drushrc.php"
  exit 1
fi
if [ -n "$(mysql --defaults-file=/root/.my.cnf -N -B \
    -e "SHOW DATABASES LIKE '${_DEAD_DB}'" 2>/dev/null)" ]; then
  if [ -n "${_OLD_PLAT}" ] && [ "${_OLD_PLAT}" != "${_NEW_PLAT}" ]; then
    _NUP=$(mysql --defaults-file=/root/.my.cnf -N -B "${_DEAD_DB}" \
      -e "UPDATE hosting_platform SET publish_path='${_NEW_PLAT}' WHERE publish_path='${_OLD_PLAT}'; SELECT ROW_COUNT();" 2>/dev/null | tail -1)
    echo "PANEL-NOTE: hostmaster platform row repointed ${_OLD_PLAT} -> ${_NEW_PLAT} in ${_DEAD_DB} (rows=${_NUP})"
  fi
  echo "PANEL-OK: ${_R} panel DB ${_DEAD_DB} is live — nothing to rewire"
  exit 0
fi
_LIVE=""
for _C in $(mysql --defaults-file=/root/.my.cnf -N -B \
    -e "SHOW DATABASES" 2>/dev/null \
  | grep -vE "^(information_schema|performance_schema|mysql|sys)$"); do
  case "${_C}" in *[!A-Za-z0-9_]*) continue ;; esac
  if [ -n "$(mysql --defaults-file=/root/.my.cnf -N -B "${_C}" \
      -e "SELECT name FROM hosting_context WHERE name='server_master' LIMIT 1" 2>/dev/null)" ] \
    && [ -n "$(mysql --defaults-file=/root/.my.cnf -N -B "${_C}" \
      -e "SELECT publish_path FROM hosting_platform WHERE publish_path LIKE '${_R}/%' LIMIT 1" 2>/dev/null)" ]; then
    if [ -n "${_LIVE}" ]; then
      echo "PANEL-ERROR: multiple live hostmaster DBs match ${_R} (${_LIVE}, ${_C}) — refusing to guess"
      exit 1
    fi
    _LIVE="${_C}"
  fi
done
if [ -z "${_LIVE}" ]; then
  echo "PANEL-ERROR: dead panel DB ${_DEAD_DB} and no live hostmaster DB found for ${_R}"
  exit 1
fi
# Persist the adoption into the live DB. §8's hostmaster verify regenerates
# the alias FROM the DB, so an alias-only correction is undone on the next
# verify and the panel 404s from a hollow platform path. Path-keyed exact
# match; the stale row already naming the adopted path (the source's own
# platform history) carries no site and stays inert.
if [ -n "${_OLD_PLAT}" ] && [ "${_OLD_PLAT}" != "${_NEW_PLAT}" ]; then
  _NUP=$(mysql --defaults-file=/root/.my.cnf -N -B "${_LIVE}" \
    -e "UPDATE hosting_platform SET publish_path='${_NEW_PLAT}' WHERE publish_path='${_OLD_PLAT}'; SELECT ROW_COUNT();" 2>/dev/null | tail -1)
  echo "PANEL-NOTE: hostmaster platform row repointed ${_OLD_PLAT} -> ${_NEW_PLAT} in ${_LIVE} (rows=${_NUP})"
fi
# Aegir derives the site DB user from the DB name; enumerate its host
# variants from mysql.user instead of assuming (@% vs @127.0.0.1 vs
# @localhost all occur in the wild).
_HOSTS=$(mysql --defaults-file=/root/.my.cnf -N -B \
  -e "SELECT Host FROM mysql.user WHERE User='${_LIVE}'" 2>/dev/null)
if [ -z "${_HOSTS}" ]; then
  echo "PANEL-ERROR: no mysql user '${_LIVE}' found to reset"
  exit 1
fi
_PW=$(od -An -N8 -tx8 /dev/urandom | tr -d " \n" | cut -c1-14)
if [ -z "${_PW}" ]; then
  echo "PANEL-ERROR: could not generate a password"
  exit 1
fi
_SQL=""
while read -r _H; do
  [ -z "${_H}" ] && continue
  case "${_H}" in
    *[!A-Za-z0-9._%:-]*)
      echo "PANEL-ERROR: unexpected host variant '${_H}' for ${_LIVE} — refusing"
      exit 1
      ;;
  esac
  _SQL="${_SQL}ALTER USER '${_LIVE}'@'${_H}' IDENTIFIED BY '${_PW}'; "
done <<< "${_HOSTS}"
if ! mysql --defaults-file=/root/.my.cnf -e "${_SQL}FLUSH PRIVILEGES;"; then
  echo "PANEL-ERROR: password reset failed for ${_LIVE}"
  exit 1
fi
# Key-anchored rewrites so a re-entered run converges regardless of what
# the fields currently hold; root sed -i recreates files, so capture and
# restore the exact ownership and modes (a root-owned settings.php is
# silently skipped by drush/PHP). Each file is verified right after its
# rewrite, settings.php FIRST: drushrc.php is the re-entry skip key, so it
# must only be written once settings.php verifiably took the rewrite —
# a silent sed no-op (anchor drift) then parks loudly and re-entry retries
# instead of skipping past a stranded settings.php.
for _F in "${_SP}/settings.php" "${_SP}/drushrc.php"; do
  _O=$(stat -c '%U:%G' "${_F}")
  _M=$(stat -c '%a' "${_F}")
  sed -i \
    -e "s#^\( *'database' => \)[\"'][^\"']*[\"'],#\1\"${_LIVE}\",#" \
    -e "s#^\( *'username' => \)[\"'][^\"']*[\"'],#\1\"${_LIVE}\",#" \
    -e "s#^\( *'password' => \)[\"'][^\"']*[\"'],#\1\"${_PW}\",#" \
    -e "s#^\( *\$db_url\['default'\] = \"mysqli\{0,1\}://\)[^@]*@\([^/]*\)/[A-Za-z0-9_]*\";#\1${_LIVE}:${_PW}@\2/${_LIVE}\";#" \
    -e "s#^\(\$options\['db_name'\] = \)'[^']*';#\1'${_LIVE}';#" \
    -e "s#^\(\$options\['db_user'\] = \)'[^']*';#\1'${_LIVE}';#" \
    -e "s#^\(\$options\['db_passwd'\] = \)'[^']*';#\1'${_PW}';#" \
    "${_F}"
  [ -n "${_O}" ] && chown "${_O}" "${_F}"
  [ -n "${_M}" ] && chmod "${_M}" "${_F}"
  if ! grep -q "${_LIVE}" "${_F}"; then
    echo "PANEL-ERROR: rewrite did not land in ${_F} (no ${_LIVE} after sed) — check the credential line format"
    exit 1
  fi
done
echo "PANEL-OK: ${_R} panel rewired from dead ${_DEAD_DB} to live DB ${_LIVE}"
exit 0
REMOTE
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
      _alrt "panel rewire for ${_root} returned rc=${_rc} on target"
      _XMASS_PANEL_FAILED="${_XMASS_PANEL_FAILED} ${_root}"
    fi
  done

  if [ -n "${_XMASS_PANEL_FAILED}" ]; then
    return 1
  fi
  _info "Panel DB access rewired for all Aegir roots on target: OK"
  return 0
}

###-------------RENAMEAEGIRHOST ON TARGET---###

_xmass_renameaegirhost_all() {
  # OLD is pinned via --force-old to the source's own server_master alias
  # value (what a first-run auto-detect would see on the target) because:
  # - the .drush sync runs rsync -u (skip-newer), so which server_master
  #   alias survives on the target is an mtime race — auto-detection could
  #   silently see OLD==NEW and no-op the whole rename;
  # - a resumed run finds aliases a partial rename already rewrote, so
  #   auto-detection would no-op and leave the DB on the source FQDN.
  # Per-root exit codes are collected instead of _alrt-and-forget: any
  # failure makes this return non-zero so the caller parks the cutover
  # resumably instead of saving phase=complete.
  local _rc _src_fqdn
  _src_fqdn=$(grep "remote_host" /var/aegir/.drush/server_master.alias.drushrc.php 2>/dev/null \
    | head -1 \
    | sed "s/.*remote_host.*=>//; s/[' ,;]//g")
  _src_fqdn=${_src_fqdn//[^a-zA-Z0-9.\-]/}
  [ -z "${_src_fqdn}" ] && _src_fqdn=$(hostname -f 2>/dev/null | tr -d '\n')
  if [ -z "${_src_fqdn}" ]; then
    # Return, never _die: a die here would exit past the caller's park
    # block and wedge the state at phase=cutover with no resume path.
    _alrt "Cannot determine the source FQDN for the rename step"
    _XMASS_RENAME_FAILED=" fqdn-detection"
    return 1
  fi

  _XMASS_RENAME_FAILED=""
  _info "Running renameaegirhost on target ${_tgt} for all Aegir roots (old FQDN: ${_src_fqdn}) ..."

  # Aegir master first. The existence probe's own rc is only meaningful for
  # 0 (present) and 1 (absent): 255 (and anything else) is an ssh-layer
  # failure — an UNREACHABLE target at exactly this step must count as a
  # failed root and park the cutover, not silently skip toward
  # phase=complete with nothing renamed.
  local _probe_rc
  ssh root@"${_tgt}" \
    "[ -d '/var/aegir' ] && \
     [ -f '/var/aegir/.drush/server_master.alias.drushrc.php' ]" 2>/dev/null
  _probe_rc=$?
  if [ "${_probe_rc}" -eq 0 ]; then
    _info "  Renaming /var/aegir on target ..."
    ssh root@"${_tgt}" "renameaegirhost --aegir-root /var/aegir --force-old ${_src_fqdn}"
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
      _alrt "renameaegirhost /var/aegir returned rc=${_rc} on target"
      _XMASS_RENAME_FAILED="${_XMASS_RENAME_FAILED} /var/aegir"
    fi
  elif [ "${_probe_rc}" -eq 1 ]; then
    _alrt "Skipping renameaegirhost for /var/aegir — not found on target"
  else
    _alrt "Cannot check /var/aegir on target (ssh rc=${_probe_rc})"
    _XMASS_RENAME_FAILED="${_XMASS_RENAME_FAILED} /var/aegir"
  fi

  # All Octopus accounts — same 0/1-vs-ssh-failure split as the master root
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    ssh root@"${_tgt}" \
      "[ -f '/data/disk/${_oct}/.drush/server_master.alias.drushrc.php' ]" \
      2>/dev/null
    _probe_rc=$?
    if [ "${_probe_rc}" -eq 0 ]; then
      _info "  Renaming /data/disk/${_oct} on target ..."
      ssh root@"${_tgt}" "renameaegirhost --aegir-root /data/disk/${_oct} --force-old ${_src_fqdn}"
      _rc=$?
      if [ "${_rc}" -ne 0 ]; then
        _alrt "renameaegirhost /data/disk/${_oct} returned rc=${_rc} on target"
        _XMASS_RENAME_FAILED="${_XMASS_RENAME_FAILED} /data/disk/${_oct}"
      fi
    elif [ "${_probe_rc}" -eq 1 ]; then
      _alrt "Skipping renameaegirhost for ${_oct} — alias not found on target"
    else
      _alrt "Cannot check /data/disk/${_oct} on target (ssh rc=${_probe_rc})"
      _XMASS_RENAME_FAILED="${_XMASS_RENAME_FAILED} /data/disk/${_oct}"
    fi
  done

  if [ -n "${_XMASS_RENAME_FAILED}" ]; then
    return 1
  fi
  _info "renameaegirhost complete for all Aegir roots on target: OK"
  return 0
}

###=============SUBCOMMANDS===============###

_xmass_cmd_prep_target() {
  # Phase 0.5 -- everything the target must have BEFORE its Octopus installs
  # and BEFORE init's datadir swap, automated end-to-end: CSF allowed in both
  # directions with the reverse 3306 path proven, the pinned PHP set present
  # (or built with --fix-php), one Octopus account per eligible source
  # account installed by driving 'xoct create' (which installs from the
  # target's own tree with the source's plan stamps, seeds the sanitised
  # octopus.cnf, forces the PHP pin witnesses and carries the credentials),
  # the suspension flags mirrored, and a final installed-state verification.
  # Idempotent: a re-run skips existing installs and re-seeds/re-verifies.
  _XMASS_SRC_IP="${_MY_OWNIP:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
  _info "======================================================"
  _info "  xmass prep-target ${_tgt}"
  _info "======================================================"
  _xmass_enumerate_accounts
  ssh -o ConnectTimeout=10 -o BatchMode=yes root@"${_tgt}" "echo SSH_OK" \
    | grep -q "SSH_OK" \
    || _die "Cannot SSH to target ${_tgt}. All three causes are common and none" \
            " is fixable from here, because fixing the target needs the ssh this" \
            " check just failed:" \
            " (1) key exchange — run 'xmass pre-mig <source-fqdn>' on BOTH hosts;" \
            " (2) the TARGET's firewall is blocking this box — on the target run" \
            " 'csf -g ${_XMASS_SRC_IP:-<source-ip>}' to see it, 'csf -tr" \
            " ${_XMASS_SRC_IP:-<source-ip>}' to clear a temp deny, and 'csf -a" \
            " ${_XMASS_SRC_IP:-<source-ip>}' so it cannot come back;" \
            " (3) first contact needs the target's host key here —" \
            " 'ssh-keyscan -H ${_tgt} >> /root/.ssh/known_hosts'."

  # CSF both directions with csf -a (allow): csf.ignore alone does NOT stop
  # guard temp-denies, and the target dials BACK to source:3306 for
  # replication -- getting this wrong fails init AFTER the datadir swap.
  if [ -x "/usr/sbin/csf" ]; then
    if csf -a "${_tgt}" "xmass migration target" &> /dev/null; then
      _info "Source CSF: allowed ${_tgt}"
    else
      _alrt "source csf -a for ${_tgt} returned non-zero -- verify /etc/csf/csf.allow by hand"
    fi
  else
    _info "Source has no csf; nothing to allow here"
  fi
  local _tcsf
  _tcsf=$(ssh root@"${_tgt}" "if [ -x /usr/sbin/csf ]; then csf -a ${_XMASS_SRC_IP} 'xmass migration source' &> /dev/null && echo CSF_OK || echo CSF_FAIL; else echo CSF_NONE; fi" 2>/dev/null)
  case "${_tcsf}" in
    CSF_OK)   _info "Target CSF: allowed ${_XMASS_SRC_IP}" ;;
    CSF_NONE) _info "Target has no csf; nothing to allow there" ;;
    *)        _alrt "target CSF allow for ${_XMASS_SRC_IP} FAILED or was unreadable (${_tcsf:-no answer})" ;;
  esac
  # Fail closed: init's failure mode for a dead reverse path is a refused
  # replication AFTER the target datadir has been replaced.
  if ssh root@"${_tgt}" "timeout 5 bash -c '</dev/tcp/${_XMASS_SRC_IP}/3306'" 2>/dev/null; then
    _info "Reverse path target->source:3306: OK"
  elif [ "${_XMASS_SKIP_REVERSE_CHECK}" = "YES" ]; then
    _alrt "reverse path target->source:3306 is DEAD; continuing on _XMASS_SKIP_REVERSE_CHECK=YES"
  else
    _die "target ${_tgt} cannot reach ${_XMASS_SRC_IP}:3306 -- replication WILL fail at init," \
         " after the target datadir has already been replaced." \
         " Check CSF on the source and any parent-host firewall (a Proxmox parent running CSF" \
         " must be trusted by hand: migration_proxy_trust.sh trust <ip> --csf-only -- xmass" \
         " wires the guest only). Override with _XMASS_SKIP_REVERSE_CHECK=YES."
  fi

  # The pinned PHP set must exist before ANY account install: a fresh install
  # is born on the box default and every later heal depends on the pinned
  # interpreter being present.
  if [ "${_XMASS_FIX_PHP}" = "YES" ]; then
    _xmass_php_coverage_gate "${_tgt}" fix \
      || _die "PHP coverage fix failed on ${_tgt}"
  else
    _xmass_php_coverage_gate "${_tgt}" die
  fi

  # Advisory sweeps while acting on them is still cheap.
  _xmass_check_le_health
  _xmass_decide_transfer_method

  local _oct _rc _failed=""
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _info "Preparing account ${_oct} on ${_tgt} ..."
    if [ "${_XMASS_FIX_PHP}" = "YES" ]; then
      xoct create "${_oct}" "${_tgt}" --fix-php
    else
      xoct create "${_oct}" "${_tgt}"
    fi
    _rc=$?
    if [ "${_rc}" -ne 0 ]; then
      _alrt "xoct create returned rc=${_rc} for ${_oct}"
      _failed="${_failed} ${_oct}"
    fi
    _xmass_copy_suspended_flag "${_oct}" "${_tgt}"
  done
  [ -n "${_failed}" ] \
    && _die "account preparation failed for:${_failed} -- fix the cause and re-run prep-target"

  _xmass_verify_target_accounts "${_tgt}" die
  _info ""
  _info "======================================================"
  _info "  xmass prep-target COMPLETE for ${_tgt}"
  _info "  All eligible accounts installed and seeded."
  _info "  Next: 'xmass init ${_tgt} [--proxy-mode=...]' on this source."
  _info "======================================================"
}

_xmass_cmd_verify() {
  # Read-only post-cutover sweep replacing the manual checklist: one site per
  # account fetched twice >=5s apart direct-to-target (BOA answers fetch
  # bursts with transient 200 soft-404 bodies, so spacing matters and a
  # single fetch proves little), one relayed request through this source's
  # proxy, plus the local leftovers that keep sites 503-gated and the cron/
  # certificate-mirror state a long-lived proxy depends on.
  _xmass_enumerate_accounts
  local _oct _dom _vhd _c1 _c2 _cr _cs
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    if [ -e "/data/disk/${_oct}/static/control/http-off.pid" ]; then
      _alrt "  ${_oct}: http-off.pid still present on the source -- sites 503-gated here"
    fi
    # Real site vhosts only: post-cutover the ASCII-first entry is always the
    # dot-prefixed pre-proxy backup, and https.* companions are not domains.
    _vhd=$(find /data/disk/${_oct}/config/server_master/nginx/vhost.d \
      -maxdepth 1 -type f ! -name '.*' ! -name 'https.*' 2>/dev/null | sort | head -1)
    if [ -z "${_vhd}" ]; then
      _alrt "  ${_oct}: no vhosts found on the source"
      continue
    fi
    _dom=$(basename "${_vhd}")
    if ! printf '%s' "${_dom}" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'; then
      _alrt "  ${_oct}: skipping vhost '${_dom}' (not a plain domain name)"
      continue
    fi
    _c1=$(curl -s -o /dev/null -w '%{http_code}' -A iCab --max-time 30 \
      --resolve "${_dom}:80:${_tgt}" "http://${_dom}/" 2>/dev/null)
    sleep 6
    _c2=$(curl -s -o /dev/null -w '%{http_code}' -A iCab --max-time 30 \
      --resolve "${_dom}:80:${_tgt}" "http://${_dom}/" 2>/dev/null)
    _cr=$(curl -s -o /dev/null -w '%{http_code}' -A iCab --max-time 30 \
      -H "Host: ${_dom}" "http://127.0.0.1/" 2>/dev/null)
    _cs="-"
    if [ -d "/data/disk/${_oct}/config/server_master/ssl.d/${_dom}" ]; then
      _cs=$(curl -sk -o /dev/null -w '%{http_code}' -A iCab --max-time 30 \
        --resolve "${_dom}:443:${_tgt}" "https://${_dom}/" 2>/dev/null)
    fi
    if { [ "${_c1}" = "200" ] || [ "${_c2}" = "200" ]; } \
      && { [ "${_cr}" = "200" ] || [ "${_cr}" = "301" ] || [ "${_cr}" = "302" ]; }; then
      _info "  ${_oct}: ${_dom} target=${_c1}/${_c2} relay=${_cr} https=${_cs}: OK"
    else
      _alrt "  ${_oct}: ${_dom} target=${_c1}/${_c2} relay=${_cr} https=${_cs} -- investigate"
      _alrt "    (transient 200 'Page not found' bodies are BOA burst protection; re-run"
      _alrt "    verify before recording a site broken)"
    fi
  done
  if ! pgrep -x cron &> /dev/null; then
    _alrt "cron is NOT running on this source -- the daily certificate mirror is DOWN"
  fi
  if [ ! -x "/var/xdrago/migration_proxy_certs.sh" ]; then
    _alrt "/var/xdrago/migration_proxy_certs.sh is MISSING on this source (see cutover notes)"
  elif ! grep -q "migration_proxy_certs" /var/spool/cron/crontabs/root 2>/dev/null; then
    _alrt "migration_proxy_certs.sh is present but NOT SCHEDULED (no root crontab line)"
  fi
  _info "verify sweep complete (read-only)"
}

_xmass_pre_mig() {
  # Stop BOA background jobs and exchange SSH keys between source and target.
  # Run on BOTH hosts: first on source (to publish its pub key),
  # then on target (to fetch and install that key).
  if [ -e "/vservers" ]; then
    _die "Cannot run pre-mig on a parent/host system"
  fi
  _info "Running pre-mig on ${_hName} ..."
  for _script in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
    if [ -e "/var/xdrago/${_script}" ]; then
      mv -f "/var/xdrago/${_script}" "/var/xdrago/.${_script}.off"
      pkill -9 -f "${_script}" &>/dev/null || true
      _info "  Stopped and disabled ${_script}"
    fi
  done
  if [ "${_hName}" = "${_hst}" ]; then
    _info "Source mode: publishing SSH pub key for target to fetch ..."
    if [ ! -e "/root/.ssh/id_ed25519.pub" ]; then
      ssh-keygen -t ed25519 -N '' -f /root/.ssh/id_ed25519
    fi
    mkdir -p /var/www/nginx-default
    cp -af /root/.ssh/id_ed25519.pub \
      /var/www/nginx-default/auth_undefined_keys.txt
    _info "Source key published at http://undefined.${_hName}/auth_undefined_keys.txt"
  else
    _info "Target mode: fetching and installing source SSH key ..."
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    rm -f /root/.ssh/auth_undefined_keys.txt
    curl -s -A iCab \
      "http://undefined.${_hst}/auth_undefined_keys.txt" \
      -o /root/.ssh/auth_undefined_keys.txt \
      || _die "Failed to fetch source key from http://undefined.${_hst}/"
    if [ -e "/root/.ssh/auth_undefined_keys.txt" ]; then
      echo >> /root/.ssh/authorized_keys
      cat /root/.ssh/auth_undefined_keys.txt >> /root/.ssh/authorized_keys
      chmod 600 /root/.ssh/authorized_keys
      _info "Source SSH key installed in authorized_keys: OK"
    else
      _die "Source key file empty or not fetched"
    fi
  fi
  _info "pre-mig complete on ${_hName}"
}

_xmass_cmd_init() {
  _xmass_load_state
  if [ "${_XMASS_PHASE}" = "syncing" ] \
    || [ "${_XMASS_PHASE}" = "cutover" ] \
    || [ "${_XMASS_PHASE}" = "rename-failed" ] \
    || [ "${_XMASS_PHASE}" = "complete" ]; then
    _die "xmass already in phase '${_XMASS_PHASE}' — cannot re-init." \
         " Remove ${_XMASS_STATE_FILE} to start over, or use" \
         " 'xmass reset-phase <phase>' to correct a wedged phase."
  fi

  _XMASS_TARGET_IP="${_tgt}"
  _XMASS_SRC_IP="${_MY_OWNIP:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
  _info "Source IP : ${_XMASS_SRC_IP}"
  _info "Target IP : ${_XMASS_TARGET_IP}"

  # Proxy-mode declaration, surfaced NOW where it is free to fix: cutover
  # --live refuses undeclared accounts, and discovering that inside the
  # maintenance window is the most expensive possible moment.
  _mig_sweep_legacy
  [ -n "${_proxy_mode}" ] && _XMASS_PROXY_MODE="${_proxy_mode}"
  [ -n "${_proxy_deadline}" ] && _XMASS_PROXY_DEADLINE="${_proxy_deadline}"
  _xmass_write_box_defaults
  _xmass_enumerate_accounts
  _xmass_report_account_modes

  # Verify SSH connectivity to target
  ssh -o ConnectTimeout=10 -o BatchMode=yes root@"${_tgt}" "echo SSH_OK" \
    | grep -q "SSH_OK" \
    || _die "Cannot SSH to target ${_tgt}. All three causes are common and none" \
            " is fixable from here, because fixing the target needs the ssh this" \
            " check just failed:" \
            " (1) key exchange — run 'xmass pre-mig <source-fqdn>' on BOTH hosts;" \
            " (2) the TARGET's firewall is blocking this box — on the target run" \
            " 'csf -g ${_XMASS_SRC_IP:-<source-ip>}' to see it, 'csf -tr" \
            " ${_XMASS_SRC_IP:-<source-ip>}' to clear a temp deny, and 'csf -a" \
            " ${_XMASS_SRC_IP:-<source-ip>}' so it cannot come back;" \
            " (3) first contact needs the target's host key here —" \
            " 'ssh-keyscan -H ${_tgt} >> /root/.ssh/known_hosts'."

  # The datadir swap below is destructive; everything the target must already
  # have is gated HERE, where a refusal costs nothing: real account installs
  # (not rsync-created trees), the full pinned PHP set, and distinct
  # replication server ids (last two IP octets only -- two boxes in the same
  # /16 can collide, and replication then simply refuses to start AFTER the
  # target datadir has been replaced).
  _xmass_verify_target_accounts "${_tgt}" die
  _xmass_php_coverage_gate "${_tgt}" die
  local _src_sid _tgt_sid
  _src_sid=$(_ip_to_server_id "${_XMASS_SRC_IP}")
  _tgt_sid=$(_ip_to_server_id "${_tgt}")
  if [ "${_src_sid}" = "${_tgt_sid}" ]; then
    _die "server_id collision: source ${_XMASS_SRC_IP} and target ${_tgt} both derive" \
         " server_id=${_src_sid} (last two octets) — replication cannot start." \
         " Give the target an IP differing in the last two octets, or migrate via xoct."
  fi
  _info "Replication server ids distinct (${_src_sid} vs ${_tgt_sid}): OK"
  # Advisory: broken LE renewals migrate into two problems at once.
  _xmass_check_le_health

  _xmass_detect_percona_version

  # Verify target runs the same Percona version
  local _tgt_v
  _tgt_v=$(ssh root@"${_tgt}" "mysql -V 2>&1" 2>/dev/null \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
    | head -1 \
    | cut -d"." -f1,2)
  if [ "${_tgt_v}" != "${_XMASS_PERCONA_V}" ]; then
    _die "Target Percona version (${_tgt_v}) does not match source (${_XMASS_PERCONA_V})." \
         " xmass requires identical versions on both servers. Use xoct instead."
  fi
  _info "Percona version match (${_XMASS_PERCONA_V}) on both servers: OK"

  # The restore replaces the target's datadir while the snapshot is still on
  # its disk, so the target transiently needs room for both plus growth
  # margin. Until now this was human arithmetic that failed AFTER the old
  # datadir was displaced. Override: _XMASS_SKIP_DISK_GATE=YES.
  local _src_dd_kb _tgt_free_kb _need_kb
  _src_dd_kb=$(du -sL /var/lib/mysql 2>/dev/null | awk '{print $1}')
  _tgt_free_kb=$(ssh root@"${_tgt}" "df -Pk /var/lib/mysql 2>/dev/null | awk 'NR==2{print \$4}'" 2>/dev/null)
  _need_kb=$(( ${_src_dd_kb:-0} * 22 / 10 ))
  if [ "${_XMASS_SKIP_DISK_GATE}" = "YES" ]; then
    _alrt "target datadir space gate SKIPPED by _XMASS_SKIP_DISK_GATE=YES"
  elif [ -z "${_src_dd_kb}" ] || [ -z "${_tgt_free_kb}" ]; then
    # Fail closed: an unmeasurable gate that prints OK is worse than none,
    # because init's next steps displace the target's datadir.
    _die "could not measure datadir space (source=${_src_dd_kb:-unknown}K" \
         " target-free=${_tgt_free_kb:-unknown}K) -- re-check the target, or export" \
         " _XMASS_SKIP_DISK_GATE=YES to proceed deliberately."
  elif [ "${_tgt_free_kb}" -lt "${_need_kb}" ]; then
    _die "target ${_tgt} has ${_tgt_free_kb}K free at /var/lib/mysql but the restore" \
         " transiently needs ~${_need_kb}K (2.2x the ${_src_dd_kb}K source datadir)." \
         " Free space on the target, or export _XMASS_SKIP_DISK_GATE=YES to override."
  else
    _info "Target datadir space check: OK (free=${_tgt_free_kb}K need~${_need_kb}K)"
  fi

  # Pause the mysql.sh watchdog on BOTH hosts for the whole init critical
  # section: it must not restart the LIVE source mid xtrabackup snapshot
  # (corrupt backup) nor the target during restore/replica setup.
  _xmass_maint_on
  _xmass_install_xtrabackup_local
  _xmass_install_xtrabackup_target
  _xmass_configure_gtid_local
  _xmass_configure_gtid_target

  # Generate a random replication password and save state
  _XMASS_REPL_PSWD=$(head -c 48 /dev/urandom \
    | base64 | tr -dc 'a-zA-Z0-9' | head -c 32)
  _XMASS_INIT_TIME=$(date +%Y%m%d-%H%M%S)
  _XMASS_LAST_SYNC=""
  _XMASS_PHASE="init"
  # Legacy boolean derived from the mode (kept one release for a rolled-back
  # xmass mid-migration); ha-switch keeps trust like permanent.
  case "${_XMASS_PROXY_MODE}" in
    permanent|ha-switch) _XMASS_PERMANENT_PROXY=YES ;;
    temporary)           _XMASS_PERMANENT_PROXY=NO ;;
    *)                   _XMASS_PERMANENT_PROXY="${_permanent_proxy:-NO}" ;;
  esac
  _xmass_save_state

  _xmass_create_repl_user
  _xmass_prevent_solr_target
  _xmass_decide_transfer_method
  _xmass_take_backup
  _xmass_restore_backup
  _xmass_setup_slave

  _XMASS_PHASE="syncing"
  _xmass_save_state
  # Sync is plain rsync + live replication; the watchdog can resume protecting
  # both servers between now and cutover.
  _xmass_maint_off

  _info ""
  _info "======================================================"
  _info "  xmass init COMPLETE"
  _info "  Replication from ${_XMASS_SRC_IP} to ${_tgt} is running."
  _info "  Run 'xmass sync ${_tgt}' to sync files (repeat as often as needed)."
  _info "  Run 'xmass status ${_tgt}' to check replication lag."
  _info "  When ready: 'xmass cutover ${_tgt} [--proxy-mode=...] [--proxy-deadline=...]'"
  if [ -n "${_XMASS_MODE_UNDECLARED}" ]; then
    _info "  NB: undeclared proxy modes above must be resolved before cutover --live."
  fi
  _info "======================================================"
}

_xmass_cmd_sync() {
  _xmass_load_state
  _xmass_detect_percona_version   # set _XM_* replication dialect (init-only otherwise)
  [ "${_XMASS_PHASE}" = "syncing" ] \
    || _die "Not in syncing phase (phase=${_XMASS_PHASE}) — run 'xmass init' first," \
            "or 'xmass reset-phase syncing' if a cutover aborted before promoting the target"

  # Resolve the target's attached mount ONCE up-front (aborts on empty/unreachable/
  # multi-mount) and reuse it for every account + shared store below.
  _xmass_resolve_target_mnt "${_tgt}"
  # Target-readiness gates run BEFORE the clean-dry token is consumed, so a
  # refusal here never forces another DRY: rsync into a never-installed
  # account creates a root-owned tree that renames and serves nothing, and a
  # missing pinned PHP means silent wrong-PHP serving after cutover. In DRY
  # both report as DENY and mark the run NOT CLEAN.
  _xmass_enumerate_accounts
  if [ "${_MODE}" = "LIVE" ]; then
    _xmass_verify_target_accounts "${_tgt}" die
    _xmass_php_coverage_gate "${_tgt}" die
  else
    _xmass_verify_target_accounts "${_tgt}" deny || true
    _xmass_php_coverage_gate "${_tgt}" deny || true
  fi
  # --live requires a prior CLEAN dry run for THIS target (mass plan for all accounts).
  [ "${_MODE}" = "LIVE" ] && _xmass_require_clean_dry "${_tgt}"
  _XMASS_STORE_RC=0
  _XMASS_RSYNC_RC=0

  if [ "${_MODE}" = "LIVE" ]; then
    _info "xmass sync: syncing files to ${_tgt} ..."
  else
    _info "xmass sync: DRY run — planning file relocation to ${_tgt} (no changes made) ..."
  fi
  _xmass_enumerate_accounts
  _xmass_sync_shared
  _xmass_sync_solr
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _xmass_sync_account "${_oct}"
  done

  if [ "${_MODE}" = "LIVE" ]; then
    if [ "${_XMASS_STORE_RC:-0}" != "0" ]; then
      _die "a store/symlink could not be placed on the target (see DENY above); sync incomplete"
    fi
    if [ "${_XMASS_RSYNC_RC:-0}" != "0" ]; then
      _die "a file transfer failed (see DENY above); sync incomplete — re-run before cutover"
    fi
    _XMASS_LAST_SYNC=$(date +%Y%m%d-%H%M%S)
    _xmass_save_state
    _info "xmass sync complete at ${_XMASS_LAST_SYNC}"
  else
    _xmass_finalize_dry "${_tgt}"
  fi
}

# Any failure between the lag wait and the panel rewire leaves _XMASS_PHASE at
# "cutover", which init, sync and cutover all refuse — so the migration was wedged
# with no recovery except hand-editing the state file, undocumented and mid-outage.
# This makes that an explicit, auditable operator action instead. It is deliberately
# NOT an automatic re-entry: whether resuming is safe depends on whether the target
# was already promoted, and only the operator can know that from the log.
_xmass_cmd_reset_phase() {
  _xmass_load_state
  local _new="$1"
  [ -e "${_XMASS_STATE_FILE}" ] \
    || _die "No xmass state file at ${_XMASS_STATE_FILE} — nothing to reset"
  case "${_new}" in
    init|syncing|cutover|rename-failed|complete) : ;;
    *) _die "reset-phase: unknown phase '${_new}'." \
            "Valid: init | syncing | cutover | rename-failed | complete" ;;
  esac
  _info "======================================================"
  _info "  xmass reset-phase"
  _info "  Current phase : ${_XMASS_PHASE:-none}"
  _info "  New phase     : ${_new}"
  _info "======================================================"
  if [ "${_new}" = "rename-failed" ]; then
    _alrt "'rename-failed' arms the RESUME path, which skips the web block, the"
    _alrt "final sync, the lag wait, the MySQL lock and the target promote, and"
    _alrt "goes straight to the rename and panel rewire. Set it ONLY when the"
    _alrt "target was already promoted and only the rename tail remains."
  fi
  if [ "${_new}" = "complete" ]; then
    _alrt "'complete' closes the migration: no subcommand will resume afterwards."
  fi
  if [ "${_XMASS_PHASE}" = "cutover" ] && [ "${_new}" = "syncing" ]; then
    _alrt "Returning to 'syncing' is correct ONLY if the cutover aborted BEFORE the"
    _alrt "target was promoted — i.e. the log never printed 'Target MySQL is now"
    _alrt "standalone: OK'. After that point replication is gone, the target has"
    _alrt "diverged, and re-running cutover will fail at the lag check. In that"
    _alrt "case use 'xmass reset-phase rename-failed' to resume the rename tail"
    _alrt "instead, and only rebuild from a fresh 'xmass init' if the promote"
    _alrt "itself did not complete."
    _alrt "Also confirm the source is not still holding a read lock (UNLOCK TABLES)"
    _alrt "and that its cron and runners are back before you resume."
  fi
  _XMASS_PHASE="${_new}"
  _xmass_save_state
  _info "Phase set to '${_new}'. Confirm with 'xmass status'."
}

_xmass_cmd_status() {
  _xmass_load_state
  _xmass_detect_percona_version   # set _XM_* replication dialect (init-only otherwise)
  local _lag="N/A"
  if [ "${_XMASS_PHASE}" = "syncing" ] && [ -n "${_XMASS_TARGET_IP}" ]; then
    _tgt="${_XMASS_TARGET_IP}"
    _lag=$(_xmass_get_repl_lag 2>/dev/null || echo "unreachable")
  fi
  echo ""
  echo "======================================================"
  echo "  xmass status"
  echo "======================================================"
  echo "  Phase            : ${_XMASS_PHASE:-uninitialized}"
  echo "  Source IP        : ${_XMASS_SRC_IP:-unknown}"
  echo "  Target IP        : ${_XMASS_TARGET_IP:-unknown}"
  echo "  Percona version  : ${_XMASS_PERCONA_V:-unknown}"
  echo "  Init time        : ${_XMASS_INIT_TIME:-n/a}"
  echo "  Last file sync   : ${_XMASS_LAST_SYNC:-never}"
  echo "  Replication lag  : ${_lag}s"
  echo "  Proxy default    : $( [ -s "${_MIG_BOX_MODE_FILE}" ] && head -n1 "${_MIG_BOX_MODE_FILE}" 2>/dev/null || echo "none (per-account records or fallback)" )"
  echo "======================================================"
  # Same table xoct renders: what each account's customer will be told and
  # what they were last told.
  if command -v xoct >/dev/null 2>&1; then
    echo ""
    xoct proxy-mode --all 2>/dev/null | sed 's/^/  /'
  fi
  echo ""
}

_xmass_cutover_finish() {
  # Steps 12.5..18 — everything after the target promotion. Shared by the
  # normal cutover flow and the 'rename-failed' resume path; every step here
  # is safe to re-enter (rm/touch/service loops, forced renames converge,
  # the panel rewire skips roots whose panel already names a live DB, and
  # step 16 skips accounts already stamped proxied, so a resumed run does
  # not re-send their completion emails).

  # Step 12.5: Rewire panel DB access on the target BEFORE the rename, so
  # the rename step's queue passes run against a bootstrappable hostmaster
  # (the datadir swap killed the fresh-install panel DBs — panels answered
  # 500 after every completed cutover until this step existed).
  if ! _xmass_rewire_panel_db_access; then
    _XMASS_PHASE="rename-failed"
    _xmass_save_state
    _die "panel DB rewire failed on target for:${_XMASS_PANEL_FAILED} — cutover PARKED (phase=rename-failed)." \
         " The source stays 503-gated and the SQL watchdogs stay paused." \
         " Fix the cause on ${_tgt}, then re-run 'xmass cutover ${_tgt} --live' to resume from this step."
  fi

  # Step 13: Run renameaegirhost on target for all Aegir roots.
  # This rewrites drush aliases, vhosts, and the Aegir DB to the new hostname,
  # then runs the Aegir task queue 5 times to regenerate everything on disk.
  # On any per-root failure: park resumably — NEVER save phase=complete over
  # a half-renamed target (the failure would only surface later as a
  # wrong-host control panel).
  if ! _xmass_renameaegirhost_all; then
    _XMASS_PHASE="rename-failed"
    _xmass_save_state
    _die "renameaegirhost failed on target for:${_XMASS_RENAME_FAILED} — cutover PARKED (phase=rename-failed)." \
         " The source stays 503-gated and the SQL watchdogs stay paused." \
         " Fix the cause on ${_tgt}, then re-run 'xmass cutover ${_tgt} --live' to resume from this step."
  fi

  # Step 13.5: Clear the migrated-in 503 gate on the target so it actually
  # serves (the source's http-off.pid arrived with the final account rsync).
  _xmass_remove_http_off_target

  # Step 14: Start Solr on target now that Solr data sync is complete
  _xmass_start_solr_target

  # Step 14.5: Core parity check -- an rsynced core a fresh build never
  # regenerates arrives as data and stays unregistered, silently returning
  # wrong search results on a cutover this tool then calls successful.
  _xmass_solr_core_parity "${_tgt}"

  # Step 15: Start cron and restore BOA runners on target
  _info "Starting cron and restoring BOA runners on target ${_tgt} ..."
  ssh root@"${_tgt}" bash <<'REMOTE'
service cron start &>/dev/null
for _s in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
  if [ ! -e "/var/xdrago/${_s}" ] \
    && [ -e "/var/xdrago/.${_s}.off" ]; then
    mv -f "/var/xdrago/.${_s}.off" "/var/xdrago/${_s}"
  fi
done
REMOTE

  # Step 15.9: Wire migration-proxy realip+csf trust BEFORE the source starts
  # proxying, so the new host recovers the real client and never bans the proxy
  # from the first relayed request.
  _xmass_setup_migration_proxy_trust

  # Step 16: Convert source vhosts to proxy via xoct (handles vhost templates,
  # nginx reload, and per-account migration-complete notification emails).
  # http-off.pid removal per account is also handled by xoct proxy.
  # First confirm the certificate mirror is present on this box: from here on
  # the source serves the proxied sites' TLS, renewals stop by design, and
  # only the daily mirror keeps a long-lived proxy from serving expired
  # certificates in ~90 days.
  if [ ! -x "/var/xdrago/migration_proxy_certs.sh" ]; then
    _alrt "/var/xdrago/migration_proxy_certs.sh is MISSING on this source -- long-lived"
    _alrt "proxies will serve expired certificates once the current ones age out."
    _alrt "It ships with the current release: run 'barracuda up-<tree> system noscreen'"
    _alrt "here after the cutover, or copy the script from the target."
  elif ! grep -q "migration_proxy_certs" /var/spool/cron/crontabs/root 2>/dev/null; then
    _alrt "migration_proxy_certs.sh is present but NOT SCHEDULED (no root crontab line);"
    _alrt "the daily mirror never runs until the 06:45 line exists -- a barracuda up-* run"
    _alrt "or the BOA fetch pass restores it."
  fi
  _xmass_convert_source_to_proxy

  # Step 17: Remove http-off.pid on source (belt-and-braces; xoct proxy
  # already removes it per account, but clean up any missed by xoct).
  _xmass_remove_http_off_all

  # Step 18: Mark all eligible source accounts as proxied. xoct proxy now
  # stamps its own successes, so this is belt-and-braces -- and it must never
  # stamp what step 16 could not convert: a bare COMPLETE over a failed
  # conversion hides the failure and stops owl.sh renewing certificates for
  # an account whose vhosts still serve locally.
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    case " ${_XMASS_PROXY_CONV_FAILED:-} " in
      *" ${_oct} "*)
        _alrt "  ${_oct}: proxy conversion FAILED; NOT stamping proxied.pid"
        continue
      ;;
    esac
    if [ -e "/data/disk/${_oct}/log/proxied.pid" ]; then
      _info "  ${_oct}: already stamped proxied, left as found"
      continue
    fi
    if [ ! -e "/data/disk/${_oct}/config/server_master/nginx/vhost.d" ]; then
      _alrt "  ${_oct}: no vhost.d on this box; NOT stamping proxied.pid"
      continue
    fi
    echo "COMPLETE" > "/data/disk/${_oct}/log/proxied.pid"
  done

  # Step 18.5: Restore cron and the five runners on the SOURCE. Until now
  # only the abort path printed this recipe and only the TARGET got a live
  # restore -- so a successful cutover left the source with cron stopped
  # forever, which silently disabled the daily certificate mirror (the one
  # mechanism that keeps a long-lived proxy's TLS fresh) and every runner.
  # The runners self-skip proxied accounts, so restoring them is safe for
  # every proxy mode.
  _info "Restoring cron and BOA runners on the source ..."
  /etc/init.d/cron start &> /dev/null || service cron start &> /dev/null
  local _scr
  for _scr in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
    if [ ! -e "/var/xdrago/${_scr}" ] && [ -e "/var/xdrago/.${_scr}.off" ]; then
      mv -f "/var/xdrago/.${_scr}.off" "/var/xdrago/${_scr}"
      _info "  Restored ${_scr}"
    fi
  done
  if ! pgrep -x cron &> /dev/null; then
    _alrt "cron did not start on the source; the daily certificate mirror is DOWN --"
    _alrt "start it manually: /etc/init.d/cron start"
  fi

  # Cutover done: re-arm the watchdog on both hosts.
  _xmass_maint_off

  _XMASS_PHASE="complete"
  _xmass_save_state

  _info ""
  _info "======================================================"
  _info "  xmass cutover COMPLETE"
  _info "  Source ${_hName} is now proxying all sites to ${_tgt}"
  if [ -n "${_XMASS_PROXY_CONV_FAILED}" ]; then
    _alrt "  Accounts NOT converted to proxy:${_XMASS_PROXY_CONV_FAILED}"
    _alrt "  They stay 503-gated on this source; fix the cause and re-run"
    _alrt "  'xoct proxy <oN> ${_tgt}' for each, then clear its http-off.pid"
  fi
  _info "  Proxy modes are per account: see 'xoct proxy-mode --all' on this box"
  _info "  Next: run 'xmass post-mig' on the TARGET after DNS is updated"
  _info "======================================================"
}

_xmass_cmd_cutover() {
  _xmass_load_state
  _xmass_detect_percona_version   # set _XM_* replication dialect (init-only otherwise)

  # Cutover flags override whatever was set at init (--permanent-proxy is the
  # deprecated alias, already mapped to _proxy_mode=permanent by the parser).
  [ -n "${_proxy_mode}" ] && _XMASS_PROXY_MODE="${_proxy_mode}"
  [ -n "${_proxy_deadline}" ] && _XMASS_PROXY_DEADLINE="${_proxy_deadline}"
  case "${_XMASS_PROXY_MODE}" in
    permanent|ha-switch) _XMASS_PERMANENT_PROXY=YES ;;
    temporary)           _XMASS_PERMANENT_PROXY=NO ;;
  esac

  if [ "${_XMASS_PHASE}" = "rename-failed" ]; then
    # Parked by a failed step-13 rename: everything up to and including the
    # target promotion already happened and cannot re-run. Resume from the
    # rename step and finish the cutover tail.
    [ "${_MODE}" = "LIVE" ] \
      || _die "cutover is parked at phase 'rename-failed' — re-run 'xmass cutover ${_XMASS_TARGET_IP} --live' to resume from the rename step"
    _tgt="${_XMASS_TARGET_IP}"
    [ -z "${_tgt}" ] && _die "No target IP in state file — cannot resume"
    _info "======================================================"
    _info "  xmass cutover RESUME (from parked rename step)"
    _info "  Target           : ${_tgt}"
    _info "======================================================"
    _xmass_enumerate_accounts
    # A run parked by a pre-mode xmass has its mode only in the mapped state,
    # not on disk yet; the resumed tail re-runs xoct proxy, which resolves
    # from the box default files, so materialise them and gate exactly as the
    # normal --live path does. Gates BEFORE the park: a refused resume must
    # not leave cron and the runners freshly stopped.
    _mig_sweep_legacy
    _xmass_write_box_defaults
    _xmass_report_account_modes
    [ -n "${_XMASS_MODE_UNDECLARED}" ] \
      && _die "undeclared proxy mode for:${_XMASS_MODE_UNDECLARED} -- declare it (see above), then re-run"
    _xmass_park_runners_and_cron
    _xmass_check_no_boa_running
    # Keep the SQL watchdogs paused through the resumed tail (idempotent;
    # re-asserts the marker in case the box rebooted while parked)
    _xmass_maint_on
    _xmass_cutover_finish
    return 0
  fi

  [ "${_XMASS_PHASE}" = "syncing" ] \
    || _die "Not in syncing phase (phase=${_XMASS_PHASE}) — cannot cut over." \
            "If a previous cutover aborted before promoting the target, resume with" \
            "'xmass reset-phase syncing' then re-run the DRY and --live"

  _tgt="${_XMASS_TARGET_IP}"
  [ -z "${_tgt}" ] && _die "No target IP in state file — was xmass init run?"

  # Resolve the target's attached mount ONCE up-front (aborts on empty/unreachable/
  # multi-mount) and reuse it for every account + shared store below.
  _xmass_resolve_target_mnt "${_tgt}"

  # cutover is destructive and irreversible (locks MySQL, promotes the target,
  # renames the Aegir host). The DRY run therefore does the storage-plan pass ONLY,
  # for all accounts + shared, and STOPS before any destructive step — nothing on
  # source or target is altered. --live requires that CLEAN dry, then proceeds.
  if [ "${_MODE}" != "LIVE" ]; then
    _info "======================================================"
    _info "  xmass cutover — DRY run (planning only, no changes)"
    _info "  Target           : ${_tgt}"
    _info "======================================================"
    _xmass_enumerate_accounts
    # Target-readiness gates as DENY: a missing account install or a missing
    # pinned PHP version discovered inside the cutover window is the most
    # expensive possible discovery -- surface both in the plan.
    _xmass_verify_target_accounts "${_tgt}" deny || true
    _xmass_php_coverage_gate "${_tgt}" deny || true
    # DRY stays read-only: simulate the box default --live would write, so
    # the printed per-account plan matches what --live will do. The override
    # must engage whenever a mode is pending -- INCLUDING when it changes an
    # existing box default -- or the DRY table shows the stale file while
    # --live rewrites it and mails a different story.
    if [ -n "${_XMASS_PROXY_MODE}" ]; then
      _MIG_BOX_MODE_OVERRIDE="${_XMASS_PROXY_MODE}"
      _MIG_BOX_DEADLINE_OVERRIDE="${_XMASS_PROXY_DEADLINE}"
      if [ "$(head -n1 "${_MIG_BOX_MODE_FILE}" 2>/dev/null)" != "${_XMASS_PROXY_MODE}" ] \
        || [ "$(head -n1 "${_MIG_BOX_DEADLINE_FILE}" 2>/dev/null)" != "${_XMASS_PROXY_DEADLINE}" ]; then
        _info "[DRY-PLAN] would write box default: mode=${_XMASS_PROXY_MODE}${_XMASS_PROXY_DEADLINE:+ deadline=${_XMASS_PROXY_DEADLINE}}"
      fi
    fi
    _xmass_report_account_modes
    [ -n "${_XMASS_MODE_UNDECLARED}" ] \
      && _alrt "[DRY] --live would REFUSE: undeclared proxy mode for:${_XMASS_MODE_UNDECLARED}"
    _XMASS_STORE_RC=0
    _XMASS_RSYNC_RC=0
    _xmass_sync_shared
    # Solr must be space-gated in the DRY run too. The LIVE path syncs it at step 3
    # and `sync` gates it, but the cutover DRY did not — so a Solr tree too large
    # for the target was only discovered mid-cutover, with the 503 already up.
    _xmass_sync_solr
    local _oct
    for _oct in ${_ELIGIBLE_ACCOUNTS}; do
      _xmass_sync_account "${_oct}"
    done
    _xmass_finalize_dry "${_tgt}"
    return 0
  fi

  _info "======================================================"
  _info "  xmass cutover starting"
  _info "  Target           : ${_tgt}"
  _info "  Proxy default    : ${_XMASS_PROXY_MODE:-none}${_XMASS_PROXY_DEADLINE:+ (deadline ${_XMASS_PROXY_DEADLINE})}"
  _info "======================================================"

  # A dropped ssh session mid-cutover strands the source on 503 (the runbooks
  # mandated screen for years); make the discipline a refusal instead of lore.
  if [ -z "${STY}" ] && [ -z "${TMUX}" ] && [ "${_XMASS_NO_SCREEN}" != "YES" ]; then
    _die "cutover --live outside screen/tmux: a dropped session strands the source on 503." \
         " Run: screen -dmS xmass xmass cutover ${_tgt} --live" \
         " (or export _XMASS_NO_SCREEN=YES to override deliberately)"
  fi

  # EVERY refusable gate runs BEFORE the first source mutation: a refused
  # cutover must leave the live source exactly as found. Parking cron/runners
  # is a mutation, so it comes only after the last gate below.
  _xmass_enumerate_accounts
  _xmass_verify_target_accounts "${_tgt}" die
  _xmass_php_coverage_gate "${_tgt}" die

  # Freeze the box default to disk, then refuse to proceed while any account
  # would resolve to the built-in fallback: a single-account misfire mails one
  # client the wrong story and warns; a mass cutover mails a whole box the
  # wrong story at once and cannot be unsent. This gate runs BEFORE the
  # clean-dry token is consumed, so a refusal here does not force another DRY.
  _mig_sweep_legacy
  _xmass_write_box_defaults
  _xmass_report_account_modes
  [ -n "${_XMASS_MODE_UNDECLARED}" ] \
    && _die "undeclared proxy mode for:${_XMASS_MODE_UNDECLARED} -- declare it (see above), then re-run --live"

  # --live requires a prior CLEAN dry run for THIS target (mass plan for all accounts).
  _xmass_require_clean_dry "${_tgt}"
  _XMASS_STORE_RC=0
  _XMASS_RSYNC_RC=0

  # All gates passed: park cron + runners HERE instead of refusing -- the
  # box's own cron restores a pre-mig-time park within minutes, so demanding
  # a manual re-park immediately before --live was a race the operator had
  # to win. This is the first source mutation of the cutover; step 18.5
  # restores it on success and _xmass_restore_hint covers the aborts below.
  _xmass_park_runners_and_cron
  _xmass_check_no_boa_running

  # Pause the mysql.sh watchdog on BOTH hosts for the whole cutover: the
  # FLUSH TABLES WITH READ LOCK on the source piles up connections, and the
  # watchdog's busy/high-load restart would break that lock mid-cutover =>
  # DATA LOSS. Also covers the target promote + renameaegirhost DB work.
  _xmass_maint_on

  # Step 0: Re-hold Solr on target in case it was manually started since init.
  # Also stops any running instance so the final Solr rsync gets a clean state.
  _xmass_prevent_solr_target

  # Step 1: Block all web traffic on source (serves 503 via http-off.pid)
  _xmass_block_web_all

  # Step 2: Stop Solr on source and disable it permanently with deny file.
  # Must happen BEFORE final sync so the Solr data rsync sees a clean,
  # fully-flushed index with no in-progress writes.
  _xmass_stop_solr_source

  # Step 3: Final file sync — Solr is now stopped on both ends so rsync
  # produces a consistent, replay-safe copy of all index data
  _info "Running final pre-cutover file sync ..."
  _xmass_sync_shared
  _xmass_sync_solr
  local _oct
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _xmass_sync_account "${_oct}"
  done

  # A store/symlink that could not be placed on the target, or a failed transfer, is
  # a hard stop BEFORE any destructive step (MySQL lock, target promotion) — abort
  # with source untouched.
  if [ "${_XMASS_STORE_RC:-0}" != "0" ]; then
    _xmass_restore_hint
    _die "a store/symlink could not be placed on the target (see DENY above); cutover aborted before locking MySQL"
  fi
  if [ "${_XMASS_RSYNC_RC:-0}" != "0" ]; then
    _xmass_restore_hint
    _die "a file transfer failed (see DENY above); the target tree may be incomplete — cutover aborted before locking MySQL"
  fi

  # Step 4: Wait for replica to fully catch up
  _xmass_wait_for_sync

  # Step 5: Final static/files pass — deliberately BEFORE the MySQL lock.
  #
  # This pass used to run INSIDE FLUSH TABLES WITH READ LOCK, which was wrong on
  # both counts: a read lock gates database writes, not file writes, so it bought
  # nothing here; and _xmass_handle_store runs `du -sk` over each store plus an ssh
  # `df` probe, so on a large account it held the entire source database locked for
  # hours while it walked millions of files, with the SQL watchdog muted. What
  # actually quiesces the files is the web block from step 1, which is already in
  # force, and nothing between here and the lock writes to them.
  _info "Final static/files rsync pass (web already blocked; pre-lock) ..."
  for _oct in ${_ELIGIBLE_ACCOUNTS}; do
    _xmass_sync_static_symlink_safe \
      "/data/disk/${_oct}" "/data/disk/${_oct}" "${_TGT_MNT}"
  done

  # Re-gate: this pass can set either rc again, and until now nothing re-checked
  # them, so a store that failed placement here proceeded to promote the target.
  if [ "${_XMASS_STORE_RC:-0}" != "0" ]; then
    _xmass_restore_hint
    _die "a store/symlink could not be placed on the target in the final pass (see DENY above); cutover aborted before locking MySQL"
  fi
  if [ "${_XMASS_RSYNC_RC:-0}" != "0" ]; then
    _xmass_restore_hint
    _die "the final static/files transfer failed (see DENY above); cutover aborted before locking MySQL"
  fi

  # Everything above this line is still recoverable: the source serves 503, but
  # nothing on either host has been mutated destructively, so an abort should
  # leave the state machine at "syncing" and let the operator simply re-run.
  # Persisting phase=cutover any earlier wedged the run on a pre-lock failure and
  # made the abort messages ("source untouched") untrue.
  _XMASS_PHASE="cutover"
  _xmass_save_state

  # Step 6: Lock source MySQL — no more writes possible
  _info "Flushing and locking source MySQL (FLUSH TABLES WITH READ LOCK) ..."
  if ! mysql --defaults-file=/root/.my.cnf \
    -e "FLUSH TABLES WITH READ LOCK;"; then
    _xmass_restore_hint
    _die "FLUSH TABLES WITH READ LOCK failed on source"
  fi

  # Step 7: Triple-check lag is still zero after the lock
  local _lag _pass
  for _pass in 1 2 3; do
    sleep 10
    _lag=$(_xmass_get_repl_lag)
    if [ "${_lag}" != "0" ]; then
      # Unlock before aborting so source MySQL is not stuck
      mysql --defaults-file=/root/.my.cnf \
        -e "UNLOCK TABLES;" &>/dev/null || true
      _xmass_restore_hint
      _die "Replica lag not zero after FLUSH LOCK on check ${_pass}/3" \
           " (lag=${_lag}s) — cutover aborted, source MySQL unlocked"
    fi
    _info "Post-lock confirmation check ${_pass}/3: lag=${_lag}s OK"
  done

  # Step 8: Promote target — stop slave, decouple completely.
  # On failure the source MUST be unlocked before aborting, exactly as step 7 does.
  # Without this the source was left holding a global read lock indefinitely, with
  # the SQL watchdog deliberately muted by _xmass_maint_on — so nothing on the box
  # would recover it and every site stayed down until someone found it by hand.
  _info "Stopping and decoupling slave on target ${_tgt} ..."
  if ! ssh root@"${_tgt}" \
    "mysql --defaults-file=/root/.my.cnf \
     -e '${_XM_STOP}; ${_XM_RESET_SLAVE};'"; then
    mysql --defaults-file=/root/.my.cnf \
      -e "UNLOCK TABLES;" &>/dev/null || true
    _xmass_restore_hint
    _die "Failed to stop/decouple slave on target ${_tgt}" \
         "— cutover aborted, source MySQL unlocked"
  fi
  _info "Target MySQL is now standalone: OK"

  # Step 9: Unlock source MySQL
  mysql --defaults-file=/root/.my.cnf \
    -e "UNLOCK TABLES;" &>/dev/null || true
  _info "Source MySQL tables unlocked"

  # Step 10: Re-transfer MySQL credentials (belt and braces after promotion)
  scp /root/.my.cnf "root@${_tgt}:/root/.my.cnf" \
    || _alrt "Failed to re-transfer .my.cnf to target"
  scp /root/.my.pass.txt "root@${_tgt}:/root/.my.pass.txt" \
    || _alrt "Failed to re-transfer .my.pass.txt to target"
  ssh root@"${_tgt}" \
    "chmod 600 /root/.my.cnf; chmod 600 /root/.my.pass.txt 2>/dev/null; true"

  # Step 11: Drop the replication user from source (no longer needed)
  _xmass_drop_repl_user

  # Step 12: Start nginx on target so it can serve proxied traffic immediately
  _info "Starting nginx on target ${_tgt} ..."
  ssh root@"${_tgt}" \
    "service nginx start &>/dev/null || service nginx reload &>/dev/null"

  # Steps 13..18 + completion — shared with the 'rename-failed' resume path
  _xmass_cutover_finish
}

_xmass_post_mig() {
  # Run on TARGET after DNS is updated and traffic flows directly.
  # Ensures Solr, nginx, and BOA runners are in clean state.
  if [ -e "/vservers" ]; then
    _die "Cannot run post-mig on a parent/host system"
  fi
  _info "Running post-mig on ${_hName} ..."
  # Remove Solr hold flag if still present
  rm -f "${_XMASS_SOLR_HOLD_FILE}"
  # (Re)start Solr services cleanly
  for _svc in solr9 solr7; do
    if [ -x "/etc/init.d/${_svc}" ] && [ -e "/etc/default/${_svc}.in.sh" ]; then
      pkill -9 -f "${_svc}" &>/dev/null || true
      service "${_svc}" start &>/dev/null
      _info "  ${_svc} restarted"
    fi
  done
  pkill -9 -f jetty9 &>/dev/null || true
  rm -rf /tmp/drush* /tmp/pear /tmp/jetty*
  rm -f /var/log/jetty9/* &>/dev/null || true
  if [ -e "/etc/default/jetty9" ] && [ -e "/etc/init.d/jetty9" ]; then
    service jetty9 start &>/dev/null
    _info "  jetty9 restarted"
  fi
  service nginx reload &>/dev/null
  # Harsh cache flush: cold-restart Valkey/Redis (drop stale D8+ containers
  # carried from the source) + restart every PHP-FPM master (drop opcache/APCu),
  # the only treatment trusted against cache/container poisoning. Correct
  # per-site PHP is preserved by the migrated multi-fpm.info.
  _info "Cold cache flush (Valkey/Redis drop + PHP-FPM restart) ..."
  if [ -x "/etc/init.d/valkey-server" ]; then
    killall -9 valkey-server &>/dev/null
    rm -f /var/lib/valkey/* &>/dev/null
    service valkey-server start &>/dev/null
  elif [ -x "/etc/init.d/redis-server" ]; then
    killall -9 redis-server &>/dev/null
    rm -f /var/lib/redis/* &>/dev/null
    service redis-server start &>/dev/null
  fi
  for _fpm in /etc/init.d/php*-fpm; do
    [ -x "${_fpm}" ] && service "$(basename "${_fpm}")" restart &>/dev/null
  done
  rm -f /run/boa_wait.pid
  for _script in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
    if [ ! -e "/var/xdrago/${_script}" ] \
      && [ -e "/var/xdrago/.${_script}.off" ]; then
      mv -f "/var/xdrago/.${_script}.off" "/var/xdrago/${_script}"
      _info "  Restored ${_script}"
    fi
  done
  # Traffic now flows directly to this host. Reconcile the migration-proxy
  # trust from the per-account policy records: temporary peers are dropped,
  # permanent/ha-switch peers stay trusted (restricted to the live peer set),
  # and with no records at all this behaves exactly as the old unconditional
  # teardown (permanent marker honoured), so an unconverted fleet sees
  # bit-identical behaviour.
  if [ -x "/var/xdrago/migration_proxy_trust.sh" ]; then
    /var/xdrago/migration_proxy_trust.sh reconcile \
      || _alrt "migration_proxy_trust reconcile returned non-zero"
  fi
  _info "post-mig complete on ${_hName}"
}

###=============ARGUMENT PARSING==========###

_cmd="$1"
shift 2>/dev/null || true

# The DRY/live gate applies ONLY to the mass-cutover transfer commands — `sync` and
# `cutover`. Utility commands (pre-mig, post-mig, init, status) run unaffected (LIVE)
# and their arguments are never touched. For sync/cutover the default is a read-only
# DRY run and an explicit --live is required (accepted only after a CLEAN dry run for
# the same target — the autosymlink --batch model). Only --prefixed mode flags are
# recognised (and stripped), so no positional argument is ever mistaken for one.
_MODE=LIVE
_XMASS_NOT_CLEAN=NO
case "${_cmd}" in
  sync|cutover)
    _MODE=DRY
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --live)        _MODE=LIVE ;;
        --dry|--test)  _MODE=DRY ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
esac

case "${_cmd}" in
  pre-mig)
    _hst="$1"
    [ -z "${_hst}" ] && _die "Usage: xmass pre-mig <source-fqdn>"
    _check_root
    _xmass_pre_mig
  ;;
  prep-target)
    _tgt="$1"
    shift 2>/dev/null || true
    _XMASS_FIX_PHP=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --fix-php) _XMASS_FIX_PHP=YES; shift ;;
        *) _die "Unknown argument: $1" ;;
      esac
    done
    [ -z "${_tgt}" ] && _die "Usage: xmass prep-target <target-ip> [--fix-php]"
    _check_root
    _xmass_cmd_prep_target
  ;;
  verify)
    _tgt="${1:-}"
    _check_root
    if [ -z "${_tgt}" ]; then
      _xmass_load_state
      _tgt="${_XMASS_TARGET_IP}"
    fi
    [ -z "${_tgt}" ] && _die "Usage: xmass verify [target-ip]"
    _xmass_cmd_verify
  ;;
  init)
    _tgt="$1"
    shift 2>/dev/null || true
    while [ $# -gt 0 ]; do
      case "$1" in
        --proxy-mode=*)
          _proxy_mode="${1#*=}"
          case "${_proxy_mode}" in
            temporary|permanent|ha-switch) : ;;
            *) _die "invalid --proxy-mode '${_proxy_mode}' (temporary|permanent|ha-switch)" ;;
          esac
          shift ;;
        --proxy-deadline=*)
          _proxy_deadline="$(_mig_norm_deadline "${1#*=}")" \
            || _die "invalid --proxy-deadline '${1#*=}' (YYYY-MM-DD or +Nd, today or later)"
          shift ;;
        --permanent-proxy)
          _alrt "--permanent-proxy is deprecated; use --proxy-mode=permanent"
          _permanent_proxy=YES
          _proxy_mode=permanent
          shift ;;
        *) _die "Unknown argument: $1" ;;
      esac
    done
    [ -z "${_tgt}" ] && _die "Usage: xmass init <target-ip> [--proxy-mode=...] [--proxy-deadline=...]"
    _check_root
    _xmass_cmd_init
  ;;
  sync)
    _tgt="$1"
    [ -z "${_tgt}" ] && _die "Usage: xmass sync <target-ip> [--live]"
    _check_root
    _xmass_cmd_sync
  ;;
  status)
    _tgt="${1:-}"
    _check_root
    _xmass_cmd_status
  ;;
  cutover)
    _tgt="$1"
    shift 2>/dev/null || true
    while [ $# -gt 0 ]; do
      case "$1" in
        --proxy-mode=*)
          _proxy_mode="${1#*=}"
          case "${_proxy_mode}" in
            temporary|permanent|ha-switch) : ;;
            *) _die "invalid --proxy-mode '${_proxy_mode}' (temporary|permanent|ha-switch)" ;;
          esac
          shift ;;
        --proxy-deadline=*)
          _proxy_deadline="$(_mig_norm_deadline "${1#*=}")" \
            || _die "invalid --proxy-deadline '${1#*=}' (YYYY-MM-DD or +Nd, today or later)"
          shift ;;
        --permanent-proxy)
          _alrt "--permanent-proxy is deprecated; use --proxy-mode=permanent"
          _permanent_proxy=YES
          _proxy_mode=permanent
          shift ;;
        *) _die "Unknown argument: $1" ;;
      esac
    done
    [ -z "${_tgt}" ] && _die "Usage: xmass cutover <target-ip> [--proxy-mode=...] [--proxy-deadline=...] [--live]"
    _check_root
    _xmass_cmd_cutover
  ;;
  reset-phase)
    _new="$1"
    [ -z "${_new}" ] \
      && _die "Usage: xmass reset-phase <init|syncing|cutover|rename-failed|complete>"
    _check_root
    _xmass_cmd_reset_phase "${_new}"
  ;;
  post-mig)
    _check_root
    _xmass_post_mig
  ;;
  *)
    echo ""
    echo "Usage: xmass pre-mig <source-fqdn>                    (run on BOTH source and target)"
    echo "Usage: xmass prep-target <target-ip> [--fix-php]      (run on source AFTER both pre-migs:"
    echo "                     CSF both ways, PHP coverage, per-account installs + seeding)"
    echo "Usage: xmass init    <target-ip> [--proxy-mode=temporary|permanent|ha-switch]"
    echo "                     [--proxy-deadline=YYYY-MM-DD|+Nd]  (run on source)"
    echo "Usage: xmass sync    <target-ip> [--live]             (run on source, repeat)"
    echo "Usage: xmass status  [target-ip]                      (run on source)"
    echo "Usage: xmass cutover <target-ip> [--proxy-mode=...] [--proxy-deadline=...] [--live]"
    echo "Usage: xmass verify  [target-ip]                      (run on source after cutover; read-only)"
    echo "Usage: xmass post-mig                                 (run on target after DNS)"
    echo "Usage: xmass reset-phase <phase>                      (run on source; recovery)"
    echo ""
    echo "Notes:"
    echo "  - Requires identical Percona MySQL versions on both servers."
    echo "  - Migrates ALL Octopus accounts and Solr cores in one operation."
    echo "  - For single-account or cross-version migrations use xoct instead."
    echo "  - Proxy modes are per ACCOUNT: --proxy-mode writes only the box DEFAULT;"
    echo "    a pin set with 'xoct proxy-mode <oN> <mode>' always wins over it."
    echo "    --permanent-proxy is a deprecated alias for --proxy-mode=permanent."
    echo "  - State is kept in ${_XMASS_STATE_FILE}"
    echo "  - reset-phase is a recovery verb: a cutover that fails between the lag"
    echo "    wait and the panel rewire leaves phase=cutover, which every other"
    echo "    subcommand refuses. Only safe back to 'syncing' if the target was NOT"
    echo "    yet promoted."
    echo ""
    exit 1
  ;;
esac

exit 0
