      _crontab_cleanup
      service cron restart
      touch "/var/log/boa/.etc_crontab_update_dev_ctrl_588844v01.${_tRee}.${_xSrl}.pid"
    fi
  else
    if [ ! -e "/var/log/boa/.etc_crontab_update_prod_ctrl_588844v01.${_tRee}.${_xSrl}.pid" ]; then
      rm -f /var/log/boa/.etc_crontab_update_prod_ctrl*.pid
      if [ -n "${_AUTO_UP_MONTH}" ] && [ -n "${_AUTO_UP_DAY}" ]; then
        _crontab_update
      else
        _crontab_cleanup
      fi
      service cron restart
      touch "/var/log/boa/.etc_crontab_update_prod_ctrl_588844v01.${_tRee}.${_xSrl}.pid"
    fi
  fi

  if [ ! -e "/var/log/boa/.etc_csf_allow_ctrl.${_tRee}.${_xSrl}.pid" ]; then
    [ -d "/var/backups/csf" ] || mkdir -p /var/backups/csf
    cp -a /etc/csf/csf.ignore /var/backups/csf/csf.ignore.${_tRee}.${_xSrl}.txt
    cp -a /etc/csf/csf.allow /var/backups/csf/csf.allow.${_tRee}.${_xSrl}.txt
    rm -f /root/.*.pid
    rm -f /var/log/boa/.etc_csf_allow_ctrl*
    touch /var/log/boa/.etc_csf_allow_ctrl.${_tRee}.${_xSrl}.pid
  fi

  ###
  ### Fix for iptables paths backward compatibility
  ###
  if [ -x "/sbin/iptables" ] && [ ! -e "/usr/sbin/iptables" ]; then
    ln -sfn /sbin/iptables /usr/sbin/iptables
  fi
  if [ -x "/usr/sbin/iptables" ] && [ ! -e "/sbin/iptables" ]; then
    ln -sfn /usr/sbin/iptables /sbin/iptables
  fi
  if [ -x "/sbin/iptables-save" ] && [ ! -e "/usr/sbin/iptables-save" ]; then
    ln -sfn /sbin/iptables-save /usr/sbin/iptables-save
  fi
  if [ -x "/usr/sbin/iptables-save" ] && [ ! -e "/sbin/iptables-save" ]; then
    ln -sfn /usr/sbin/iptables-save /sbin/iptables-save
  fi
  if [ -x "/sbin/iptables-restore" ] && [ ! -e "/usr/sbin/iptables-restore" ]; then
    ln -sfn /sbin/iptables-restore /usr/sbin/iptables-restore
  fi
  if [ -x "/usr/sbin/iptables-restore" ] && [ ! -e "/sbin/iptables-restore" ]; then
    ln -sfn /usr/sbin/iptables-restore /sbin/iptables-restore
  fi
  if [ -x "/sbin/ip6tables" ] && [ ! -e "/usr/sbin/ip6tables" ]; then
    ln -sfn /sbin/ip6tables /usr/sbin/ip6tables
  fi
  if [ -x "/usr/sbin/ip6tables" ] && [ ! -e "/sbin/ip6tables" ]; then
    ln -sfn /usr/sbin/ip6tables /sbin/ip6tables
  fi
  if [ -x "/sbin/ip6tables-save" ] && [ ! -e "/usr/sbin/ip6tables-save" ]; then
    ln -sfn /sbin/ip6tables-save /usr/sbin/ip6tables-save
  fi
  if [ -x "/usr/sbin/ip6tables-save" ] && [ ! -e "/sbin/ip6tables-save" ]; then
    ln -sfn /usr/sbin/ip6tables-save /sbin/ip6tables-save
  fi
  if [ -x "/sbin/ip6tables-restore" ] && [ ! -e "/usr/sbin/ip6tables-restore" ]; then
    ln -sfn /sbin/ip6tables-restore /usr/sbin/ip6tables-restore
  fi
  if [ -x "/usr/sbin/ip6tables-restore" ] && [ ! -e "/sbin/ip6tables-restore" ]; then
    ln -sfn /usr/sbin/ip6tables-restore /sbin/ip6tables-restore
  fi
  ###
  ### Fix for iptables paths backward compatibility
  ###

  _NFTABLES_TEST=$(iptables -V)
  if [[ "${_NFTABLES_TEST}" =~ "nf_tables" ]]; then
    if [ -e "/usr/sbin/iptables-legacy" ]; then
      update-alternatives --set iptables /usr/sbin/iptables-legacy &> /dev/null
    fi
    if [ -e "/usr/sbin/ip6tables-legacy" ]; then
      update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy &> /dev/null
    fi
    if [ -e "/usr/sbin/arptables-legacy" ]; then
      update-alternatives --set arptables /usr/sbin/arptables-legacy &> /dev/null
    fi
    if [ -e "/usr/sbin/ebtables-legacy" ]; then
      update-alternatives --set ebtables /usr/sbin/ebtables-legacy &> /dev/null
    fi
    touch /var/log/boa/.nf_tables_ctrl.${_tRee}.${_xSrl}.pid
  fi

  if [ -x "/etc/init.d/site24x7monagent" ] \
    && [ ! -e "/var/log/boa/.site24x7monagent_ctrl.${_tRee}.${_xSrl}.pid" ]; then
    service site24x7monagent stop
    wait
    service site24x7monagent start
    rm -f /var/log/boa/.site24x7monagent*
    touch /var/log/boa/.site24x7monagent_ctrl.${_tRee}.${_xSrl}.pid
  fi

  if [ -x "/usr/local/bin/curl" ] \
    && [ ! -e "/var/log/boa/.curl_ctrl.${_tRee}.${_xSrl}.pid" ]; then
    if [ -f "/usr/bin/curl" ]; then
      mv -f /usr/bin/curl /usr/bin/legacy-curl
    fi
    ln -sfn /usr/local/bin/curl /usr/bin/curl
    touch /var/log/boa/.curl_ctrl.${_tRee}.${_xSrl}.pid
  fi

  _IS_MOVESQL_RUNNING=$(pgrep -f move_sql.sh)
  if [ ! -z "${_IS_MOVESQL_RUNNING}" ]; then
    _CNT=$(pgrep -fc move_sql.sh)
    if (( _CNT > 2 )); then
      pkill -9 -f move_sql.sh
      rm -f /run/mysql_restart_running.pid
      rm -f /run/boa_wait.pid
      rm -f /var/log/boa/.move_sql_ctrl*
      touch /var/log/boa/.move_sql_ctrl.${_tRee}.${_xSrl}.pid
    fi
  fi

  _IS_SQLCLEANUP_RUNNING=$(pgrep -f mysql_cleanup.sh)
  if [ ! -z "${_IS_SQLCLEANUP_RUNNING}" ]; then
    _CNT=$(pgrep -fc mysql_cleanup.sh)
    if (( _CNT > 2 )); then
      pkill -9 -f mysql_cleanup.sh
      rm -f /run/mysql_backup_running.pid
      rm -f /var/log/boa/.sqlcleanup_ctrl*
      touch /var/log/boa/.sqlcleanup_ctrl.${_tRee}.${_xSrl}.pid
    fi
  fi

  _IS_SOLRSTART_RUNNING=$(pgrep -f 'solr start')
  if [ ! -z "${_IS_SOLRSTART_RUNNING}" ]; then
    _CNT=$(pgrep -fc "solr start")
    if (( _CNT > 2 )); then
      pkill -9 -f 'solr start'
      touch /var/log/boa/.solr_start_ctrl.${_tRee}.${_xSrl}.pid
    fi
  fi

  _IS_PROCTRL_RUNNING=$(pgrep -f proc_num_ctrl.pl)
  if [ ! -z "${_IS_PROCTRL_RUNNING}" ]; then
    _CNT=$(pgrep -fc proc_num_ctrl.pl)
    if (( _CNT > 1 )); then
      pkill -9 -f proc_num_ctrl.pl
      touch /var/log/boa/.proc_num_ctrl.${_tRee}.${_xSrl}.pid
    fi
  fi

  rm -f /run/fmp_wait.pid

  _IS_SQLBACKUP_RUNNING=$(pgrep -f mysql_backup.sh)
  if [ ! -z "${_IS_SQLBACKUP_RUNNING}" ]; then
    _CNT=$(pgrep -fc mysql_backup.sh)
    if (( _CNT > 2 )); then
      pkill -9 -f mysql_backup.sh
      pkill -9 -f mydumper
      pkill -9 -f usage.sh
      pkill -9 -f runner.sh
      rm -f /run/boa_sql_backup.pid
      rm -f /run/mysql_backup_running.pid
      rm -f /run/boa_wait.pid
      rm -f /run/daily-fix.pid
      rm -f /var/log/boa/.sqlbackup_ctrl*
      touch /var/log/boa/.sqlbackup_ctrl.${_tRee}.${_xSrl}.pid
    fi
  fi
fi

exit 0
