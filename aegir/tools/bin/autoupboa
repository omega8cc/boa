if [[ "${_CRON_TEST}" =~ "clear.xsh" ]]; then
  _ADD_XTRA=NO
fi

_TIME=$(date +%H%M)
_TIME=${_TIME//[^0-9-]/}
_MINUTE=$(date +%M)
_MINUTE=${_MINUTE//[^0-9-]/}
_NOW=$(date +%y%m%d-%H%M%S)
_NOW=${_NOW//[^0-9-]/}

_if_hosted_sys() {
  _find_correct_ip
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
  if [ -e "/root/.host8.cnf" ] \
    || [[ "${_hName}" =~ ".aegir.cc"($) ]]; then
    _hostedSys=YES
    [ -e "/root/.auto.up.cnf" ] || touch /root/.auto.up.cnf
  else
    _hostedSys=NO
  fi
}

_send_boa_system_report() {
  if [ -e "${_barCnf}" ]; then
    _RCPT_EMAIL=
    _BCC_EMAIL=
    _repBodFile=/var/backups/hosted-boa-status.txt
    _if_hosted_sys
    if [ "${_hostedSys}" = "YES" ]; then
      _RCPT_EMAIL="systems@omega8.cc"
      _BCC_EMAIL="notify@omega8.cc"
    fi
    if [ ! -z "${_RCPT_EMAIL}" ] \
      && [ ! -z "${_BCC_EMAIL}" ] \
      && [ -e "/etc/boa/.run.example.report.cnf" ]; then
      _repSub="BOA Status on ${_hName}"
      _repSub=$(echo -n ${_repSub} | fmt -su -w 2500 2>&1)
      _repSent=NO
      boa info report both > ${_repBodFile}
      if [ -s "${_repBodFile}" ]; then
        s-nail -b ${_BCC_EMAIL} -s "${_repSub} at ${_NOW}" ${_RCPT_EMAIL} \
          < ${_repBodFile} && _repSent=YES
      fi
      rm -f ${_repBodFile}
      ### Consume the request only once the report has reached the local
      ### MTA on a non-empty body -- handoff, not delivery confirmation.
      ### Until this, a request made outside the send window was wiped by
      ### the hosted pass below before it could ever be honoured.
      if [ "${_repSent}" = "YES" ]; then
        rm -f /etc/boa/.run.example.report.cnf
      fi
    fi
  fi
}

if [ "${_TIME}" = "1200" ] || [ "${_MINUTE}" = "00" ]; then
  export TERM=vt100
  _send_boa_system_report
fi

_check_system_manufacturer() {
  # Extract manufacturer string
  _SYS_MANUFACTURER_RAW=$(dmidecode -s system-manufacturer 2>/dev/null)

  # Trim leading/trailing whitespace, convert spaces to underscores
  _SYS_MANUFACTURER_CLEAN=$(printf "%s" "${_SYS_MANUFACTURER_RAW}" \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/[[:space:]]\+/_/g')

  # Normalise: keep only A-Za-z0-9_
  _SYS_MANUFACTURER=$(printf "%s" "${_SYS_MANUFACTURER_CLEAN}" | tr -cd 'A-Za-z0-9_')

  # Enforce max length with safe underscore-aware truncation
  _MAX_LEN=32
  if [ "${#_SYS_MANUFACTURER}" -gt "${_MAX_LEN}" ]; then
    _CUT=$(printf "%s" "${_SYS_MANUFACTURER}" | cut -c1-"${_MAX_LEN}")
    _SAFE_CUT=$(printf "%s" "${_CUT}" | sed 's/_[^_]*$//')
    if [ -n "${_SAFE_CUT}" ]; then
      _SYS_MANUFACTURER="${_SAFE_CUT}"
    else
      _SYS_MANUFACTURER="${_CUT}"
    fi
  fi

  # Secondary variable: lowercase
  _SYS_MANUFACTURER_LC=$(printf "%s" "${_SYS_MANUFACTURER}" | tr 'A-Z' 'a-z')

  if [ "${_DEBUG_MODE}" = "YES" ]; then
    echo "_SYS_MANUFACTURER_RAW: ${_SYS_MANUFACTURER_RAW}"
    echo "_SYS_MANUFACTURER_CLEAN: ${_SYS_MANUFACTURER_CLEAN}"
    echo "_SYS_MANUFACTURER: ${_SYS_MANUFACTURER}"
    echo "_SYS_MANUFACTURER_LC: ${_SYS_MANUFACTURER_LC}"
  fi
}

_is_protected_run() {
  _protectedRun=FALSE
  _optBin="/opt/local/bin"
  _boaBins="autoinit automini barracuda boa octopus"
  for _cbn in ${_boaBins}; do
    if [ -e "${_optBin}/${_cbn}" ]; then
      _CNT=$(pgrep -fc /local/bin/${_cbn})
      if (( _CNT > 0 )); then
        echo "The ${_cbn} is running!"
        _protectedRun=TRUE
      fi
    fi
  done
  # The chained install's legs run as "bash /var/backups/*.sh.txt", not as
  # the wrapper binaries swept above -- match them too
  if pgrep -f "/var/backups/BARRACUDA.sh.txt" > /dev/null 2>&1 \
    || pgrep -f "/var/backups/OCTOPUS.sh.txt" > /dev/null 2>&1; then
    _protectedRun=TRUE
  fi
  [ -e "/run/octopus_install_run.pid" ] && _protectedRun=TRUE
  [ -e "/run/boa_run.pid" ] && _protectedRun=TRUE
  [ -e "/run/boa_wait.pid" ] && _protectedRun=TRUE
}

_generic_vm_postinstall() {
  _is_protected_run
  if [ "${_protectedRun}" = "FALSE" ]; then
    rm -f /var/log/boa/${_SYS_MANUFACTURER_LC}_vm.pid
    _TODAY=$(date +%y%m%d)
    _TODAY=${_TODAY//[^0-9]/}
    _NOW=$(date +%y%m%d-%H%M%S)
    _NOW=${_NOW//[^0-9-]/}
    _vBs="/var/backups"
    _LOG_UP_DIR="${_vBs}/reports/up/$(basename "$0")/${_TODAY}"
    _UP_BARRACUDA_LOG="${_LOG_UP_DIR}/$(basename "$0")-up-barracuda-${_NOW}.log"
    mkdir -p ${_LOG_UP_DIR}
    nohup /opt/local/bin/barracuda up-${_tRee} system noscreen >${_UP_BARRACUDA_LOG} 2>&1 &
  fi
}

# Restrict sendmail access unless /etc/boa/.allow.sendmail.cnf exists
_restrict_sendmail() {
  _SNAIL_EXISTS=$(getent group allow-snail 2>&1)
  if [[ ! "${_SNAIL_EXISTS}" =~ "allow-snail" ]]; then
    addgroup --system allow-snail &> /dev/null
    chown root /usr/sbin/sendmail &> /dev/null
    chgrp allow-snail /usr/sbin/sendmail &> /dev/null
  fi
  if [ "${_ALLOW_SENDMAIL}" != "YES" ] \
    && [ ! -e "/etc/boa/.allow.sendmail.cnf" ]; then
    chmod 750 /usr/sbin/sendmail &> /dev/null
  fi
}

_if_restrict_sendmail() {
  # Symmetric with the 750 arm below: an explicit YES re-asserts 755 on
  # every pass, so a hand-set 750 no longer sticks until the next serial.
  if [ "${_ALLOW_SENDMAIL}" = "YES" ] \
    || [ -e "/etc/boa/.allow.sendmail.cnf" ]; then
    chmod 755 /usr/sbin/sendmail &> /dev/null
  else
    _restrict_sendmail
  fi
}

if [ "$(boa info | grep -c Percona)" -ge 3 ] && [ -e "/usr/sbin/csf" ]; then
  _is_protected_run
  if [ "${_protectedRun}" = "FALSE" ]; then
    _if_restrict_sendmail
  fi
fi

_status_vm_postinstall() {
  _check_system_manufacturer
  _VM_N_PID="/var/log/boa/${_SYS_MANUFACTURER_LC}_vm.pid"
  _VM_N_SYS="/var/log/boa/${_SYS_MANUFACTURER_LC}_vm_postinstall.pid"
  _VM_O_PID="/run/${_SYS_MANUFACTURER_LC}_vm.pid"
  _VM_O_SYS="/run/${_SYS_MANUFACTURER_LC}_vm_postinstall.pid"
  if [ -e "${_VM_O_PID}" ] && [ ! -e "${_VM_N_PID}" ]; then
    touch ${_VM_N_PID}
  fi
  if [ -e "${_VM_O_SYS}" ] && [ ! -e "${_VM_N_SYS}" ]; then
    touch ${_VM_N_SYS}
    chattr +i ${_VM_N_SYS}
  fi
  if [ "$(boa info | grep -c Percona)" -lt 3 ] || [ ! -e "/usr/sbin/csf" ]; then
    _NEEDS_UPGRADE=YES
    echo "A _NEEDS_UPGRADE is ${_NEEDS_UPGRADE}"
    [ -n "${_SYS_MANUFACTURER_LC}" ] && _generic_vm_postinstall
  else
    _NEEDS_UPGRADE=NO
    echo "B _NEEDS_UPGRADE is ${_NEEDS_UPGRADE}"
    if [ ! -e "${_VM_N_PID}" ] && [ ! -e "${_VM_N_SYS}" ]; then
      touch ${_VM_N_SYS}
      chattr +i ${_VM_N_SYS}
      _is_protected_run
      if [ "${_protectedRun}" = "FALSE" ]; then
        rm -rf /opt/tmp/*
      fi
    fi
    if [ ! -e "/var/log/boa/reset_no_new_password.pid" ]; then
      # Re-enable default MySQL/Valkey/Redis password update logic once
      [ -e "/root/.mysql.no.new.password.cnf" ]  && rm -f /root/.mysql.no.new.password.cnf
      [ -e "/root/.valkey.no.new.password.cnf" ] && rm -f /root/.valkey.no.new.password.cnf
      [ -e "/root/.redis.no.new.password.cnf" ]  && rm -f /root/.redis.no.new.password.cnf
      touch /var/log/boa/reset_no_new_password.pid
      chattr +i /var/log/boa/reset_no_new_password.pid
    fi
  fi
}

_opt_tmp_cleanup() {
  _is_protected_run
  if [ "${_protectedRun}" = "FALSE" ]; then
    _OLD_FOUND="NO"
    # Detect anything in /opt/tmp/boa older than 24 hours
    if find /opt/tmp/boa -mindepth 1 -mtime +0 -print -quit 2>/dev/null | grep -q .; then
      _OLD_FOUND="YES"
    fi
    if [ "${_OLD_FOUND}" = "YES" ]; then
      # Remove everything under /opt/tmp safely
      rm -rf /opt/tmp/*
    fi
  fi
}

if [ -e "/var/aegir/.drush/hm.alias.drushrc.php" ] \
  && [ -e "/data/u" ] \
  && [ -e "/var/xdrago" ]; then
  if [ ! -e "/var/log/boa/reset_no_new_password.pid" ]; then
    _status_vm_postinstall
  else
    _opt_tmp_cleanup
  fi
fi

_cron_names_to_numbers() {
  # crontab(5) accepts three-letter names in the month and dow fields
  echo "$1" | tr 'A-Z' 'a-z' | sed \
    -e 's/sun/0/g' -e 's/mon/1/g' -e 's/tue/2/g' -e 's/wed/3/g' \
    -e 's/thu/4/g' -e 's/fri/5/g' -e 's/sat/6/g' \
    -e 's/jan/1/g' -e 's/feb/2/g' -e 's/mar/3/g' -e 's/apr/4/g' \
    -e 's/may/5/g' -e 's/jun/6/g' -e 's/jul/7/g' -e 's/aug/8/g' \
    -e 's/sep/9/g' -e 's/oct/10/g' -e 's/nov/11/g' -e 's/dec/12/g'
}

_cron_field_matches() {
  # Does one crontab date field (dom/mon/dow) cover the given value?
  # Handles *, N, A-B, */S, A-B/S and comma lists; names are already
  # normalized by the caller. Anything unparseable counts as a match:
  # a strange hand-edited entry must block the reboot, not be ignored.
  local _fLd="$1" _vAl="$2" _mIn="$3"
  local _aTom="" _rNge="" _sTep="" _lOw="" _hIgh="" _rEst=""
  [ "${_fLd}" = "*" ] && return 0
  [[ "${_vAl}" =~ ^[0-9]+$ ]] || return 0
  ### 10# everywhere a field value enters arithmetic: crontab accepts
  ### zero-padded values (08/09) which bash $(( )) reads as invalid octal,
  ### and the arithmetic abort would discard the whole caller block
  _vAl=$((10#${_vAl}))
  _rEst="${_fLd},"
  while [ -n "${_rEst}" ]; do
    _aTom="${_rEst%%,*}"
    _rEst="${_rEst#*,}"
    [ -z "${_aTom}" ] && continue
    _sTep=1
    _rNge="${_aTom}"
    if [[ "${_aTom}" == */* ]]; then
      _rNge="${_aTom%%/*}"
      _sTep="${_aTom#*/}"
      [[ "${_sTep}" =~ ^[0-9]+$ ]] || return 0
      _sTep=$((10#${_sTep}))
      [ "${_sTep}" -eq 0 ] && return 0
    fi
    if [ "${_rNge}" = "*" ]; then
      _lOw="${_mIn}"
      _hIgh=99
    elif [[ "${_rNge}" =~ ^[0-9]+-[0-9]+$ ]]; then
      _lOw=$((10#${_rNge%%-*}))
      _hIgh=$((10#${_rNge#*-}))
    elif [[ "${_rNge}" =~ ^[0-9]+$ ]]; then
      _lOw=$((10#${_rNge}))
      _hIgh="${_lOw}"
    else
      return 0
    fi
    [ "${_lOw}" -gt "${_hIgh}" ] && return 0
    if [ "${_vAl}" -ge "${_lOw}" ] && [ "${_vAl}" -le "${_hIgh}" ] \
      && [ $(( (_vAl - _lOw) % _sTep )) -eq 0 ]; then
      return 0
    fi
  done
  return 1
}

_upgrade_scheduled_today() {
  # TRUE when any active /etc/crontab entry that runs a barracuda or
  # octopus upgrade -- directly or via the autoupboa weekly wrapper --
  # is scheduled for today's date. The kernel-activation reboot must
  # never share a day with a scheduled upgrade run, so a staged kernel
  # waits for the next free night instead. crontab(5) semantics: dom
  # and dow combine as OR when both are restricted, otherwise all date
  # fields must agree.
  local _cMin="" _cHour="" _cDom="" _cMon="" _cDow="" _cRest="" _domOk="" _dowOk=""
  local _dNow="$(date +%-d)" _mNow="$(date +%-m)" _wNow="$(date +%w)"
  [ -e "/etc/crontab" ] || return 1
  ### read-splitting, never `set -- $line`: an unquoted * field would
  ### glob-expand against the current directory
  while read -r _cMin _cHour _cDom _cMon _cDow _cRest; do
    if [[ "${_cMin}" == @* ]]; then
      ### @daily/@weekly/... carry no date fields to test -- fail closed,
      ### treat the upgrade as scheduled today
      return 0
    fi
    [ -n "${_cRest}" ] || continue
    _cDom=$(_cron_names_to_numbers "${_cDom}")
    _cMon=$(_cron_names_to_numbers "${_cMon}")
    _cDow=$(_cron_names_to_numbers "${_cDow}")
    _cron_field_matches "${_cMon}" "${_mNow}" 1 || continue
    _domOk=1
    _cron_field_matches "${_cDom}" "${_dNow}" 1 && _domOk=0
    _dowOk=1
    if _cron_field_matches "${_cDow}" "${_wNow}" 0; then
      _dowOk=0
    elif [ "${_wNow}" -eq 0 ] && _cron_field_matches "${_cDow}" "7" 0; then
      _dowOk=0
    fi
    ### Vixie cron flags a dom/dow field as unrestricted from its FIRST
    ### character, so */N counts as star and keeps the AND rule; only
    ### two genuinely restricted fields combine as OR
    if [[ "${_cDom}" != \** ]] && [[ "${_cDow}" != \** ]]; then
      if [ "${_domOk}" -eq 0 ] || [ "${_dowOk}" -eq 0 ]; then
        return 0
      fi
    else
      if [ "${_domOk}" -eq 0 ] && [ "${_dowOk}" -eq 0 ]; then
        return 0
      fi
    fi
  done < <(grep -iE '^[[:space:]]*[^#[:space:]].*((barracuda|octopus)[[:space:]]+up-|autoupboa[[:space:]]+weekly-system)' /etc/crontab 2>/dev/null)
  return 1
}

_announce_kernel_reboot() {
  # An unattended kernel-activation reboot must never be silent: log it
  # in /var/log/boa/ and alert the admin by email before firing, so an
  # overnight restart is never a mystery. The short sleep gives postfix
  # a chance to relay the alert before the shutdown; a queued copy still
  # delivers after boot either way.
  local _rLog="/var/log/boa/kernel-reboot.log"
  local _hostN="$(cat /etc/hostname 2>/dev/null | tr -d '\n')"
  local _mailTo="" _stAmp="$(date 2>/dev/null)" _rBody=""
  [ -d "/var/log/boa" ] || mkdir -p /var/log/boa
  ### one body, written to the log and mailed as-is -- never re-read the
  ### append-only log for the mail, a previous entry would splice in
  _rBody="[${_stAmp}] REBOOT: staged kernel activated via boa reboot (04:00-04:59 window)
[${_stAmp}] Kernel running before this reboot: $(uname -r 2>/dev/null)"
  if [ -e "/run/reboot-required.pkgs" ]; then
    _rBody="${_rBody}
[${_stAmp}] Pending packages: $(tr '\n' ' ' < /run/reboot-required.pkgs 2>/dev/null)"
  fi
  echo "${_rBody}" >> "${_rLog}"
  _if_hosted_sys
  if [ "${_hostedSys}" = "YES" ]; then
    _mailTo="$(basename "$0")@omega8.cc"
  else
    _mailTo="${_MY_EMAIL}"
  fi
  if [ ! -z "${_mailTo}" ] && [ -x "$(command -v s-nail)" ]; then
    echo "${_rBody}" \
      | s-nail -S ttycharset=utf-8 -S sendcharsets=utf-8 \
        -s "REBOOT: New kernel activated on ${_hostN}" "${_mailTo}" &> /dev/null
    sleep 8
  fi
}

_if_new_kernel_reboot() {
  _isReboot=NO
  _is_protected_run
  if [ "${_protectedRun}" = "FALSE" ]; then
    if [ -e "/run/reboot-required.pkgs" ]; then
      if grep -q linux "/run/reboot-required.pkgs"; then
        _isReboot=REQ
      fi
    fi
    if [ "$(boa info | grep -c Next)" -ge 1 ]; then
      _isReboot=REQ
    fi
    if [ "${_isReboot}" = "REQ" ]; then
      ### A staged kernel is activated only inside the silent night
      ### maintenance window (04:00-04:59 server time): an apt security
      ### run staging a kernel mid-day must never reboot a box mid-day.
      if [ "$(date +%H)" != "04" ]; then
        echo "NOTE: kernel reboot pending, waiting for the night window"
        return 0
      fi
      ### ...and never on a day when /etc/crontab schedules a barracuda
      ### or octopus upgrade, so the reboot cannot land near or inside
      ### an upgrade run.
      if _upgrade_scheduled_today; then
        echo "NOTE: kernel reboot pending, deferred: upgrade scheduled today"
        return 0
      fi
      _announce_kernel_reboot
      nohup /opt/local/bin/boa reboot > /dev/null 2>&1 &
      exit 1
    fi
  fi
}

_if_hosted_sys
if [ "${_hostedSys}" = "YES" ] || [ -e "/root/.allow.auto.reboot.cnf" ]; then
  _if_new_kernel_reboot
fi

_crontab_monitor_cleanup() {
  if [ -e "/etc/crontab" ] && [ -e "/var/xdrago/monitor/log" ] && [ -e "/etc/csf" ]; then
    if ! grep -q "/var/xdrago/monitor/log" /etc/crontab; then
      echo "*/59 *  * * *   root    rm -f /var/xdrago/monitor/log/web.log >/dev/null 2>&1" >> /etc/crontab
      echo "*/59 *  * * *   root    rm -f /var/xdrago/monitor/log/ssh.log >/dev/null 2>&1" >> /etc/crontab
      echo "*/59 *  * * *   root    rm -f /var/xdrago/monitor/log/ftp.log >/dev/null 2>&1" >> /etc/crontab
    fi
  fi
}
_crontab_monitor_cleanup

_crontab_update() {
  if [ -e "/etc/crontab" ]; then
    sed -i "s/.*xdrago.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*arracuda.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*autoupboa weekly.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*ctopus.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*du.*sql.*//gi" /etc/crontab &> /dev/null
    wait
    if [ "${_ADD_XTRA}" = "YES" ]; then
      ### 3-59/19 (minutes 3, 22, 41) never coincides with the */5 root-crontab
      ### line, so the redundant schedule can no longer double-start clear.sh.
      echo "3-59/19 *  * * *   root    bash /var/xdrago/clear.sh >/dev/null 2>&1" >> /etc/crontab
    fi

    _crontab_monitor_cleanup

    sed -i "/^$/d" /etc/crontab &> /dev/null
    wait

    if [ "${_AUTO_PHP}" = "php-all" ]; then
      _BCDA_FULL="up-${_AUTO_VER} log php-all"
      _BCDA_SYST="up-${_AUTO_VER} system php-all"
    elif [ "${_AUTO_PHP}" = "php-min" ]; then
      _BCDA_FULL="up-${_AUTO_VER} log php-min"
      _BCDA_SYST="up-${_AUTO_VER} system php-min"
    elif [ "${_AUTO_PHP}" = "php-max" ]; then
      _BCDA_FULL="up-${_AUTO_VER} log php-max"
      _BCDA_SYST="up-${_AUTO_VER} system php-max"
    else
      _BCDA_FULL="up-${_AUTO_VER} log"
      _BCDA_SYST="up-${_AUTO_VER} system"
    fi
    _OCTO_FULL="up-${_AUTO_VER} all force log"

    _BCDA_FULL="${_BCDA_FULL} noscreen"
    _BCDA_SYST="${_BCDA_SYST} noscreen"
    _OCTO_FULL="${_OCTO_FULL} noscreen"

    ### every interpolated schedule field must be non-empty: an empty one
    ### shifts the remaining fields left, producing a line cron cannot run
    ### but _upgrade_scheduled_today must treat as scheduled forever
    if [ ! -z "${_BCDA_SYST}" ] && [ ! -z "${_AUTO_UP_WEEKLY}" ] \
      && [ ! -z "${_AUTO_UP_MINUTE}" ] && [ ! -z "${_AUTO_UP_HOUR}" ]; then
      echo "# Barracuda weekly system only upgrade" >> /etc/crontab
      echo "${_AUTO_UP_MINUTE} ${_AUTO_UP_HOUR}    * * ${_AUTO_UP_WEEKLY}   root    bash /opt/local/bin/autoupboa weekly-system ${_BCDA_SYST}" >> /etc/crontab
    fi

    if [ ! -z "${_BCDA_FULL}" ] && [ ! -z "${_AUTO_UP_DAY}" ] && [ ! -z "${_AUTO_UP_MONTH}" ] \
      && [ ! -z "${_AUTO_UP_MINUTE}" ] && [ ! -z "${_AUTO_UP_HOUR}" ]; then
      echo "# Barracuda ${_AUTO_VER} full upgrade" >> /etc/crontab
      echo "${_AUTO_UP_MINUTE} ${_AUTO_UP_HOUR}    ${_AUTO_UP_DAY} ${_AUTO_UP_MONTH} *   root    bash /opt/local/bin/barracuda ${_BCDA_FULL}" >> /etc/crontab
    fi

    if [ ! -z "${_OCTO_FULL}" ] && [ ! -z "${_AUTO_UP_DAY}" ] && [ ! -z "${_AUTO_UP_MONTH}" ] \
      && [ ! -z "${_AUTO_OCT_UP_MINUTE}" ] && [ ! -z "${_AUTO_OCT_UP_HOUR}" ]; then
      echo "# Octopus ${_AUTO_VER} full upgrade" >> /etc/crontab
      echo "${_AUTO_OCT_UP_MINUTE} ${_AUTO_OCT_UP_HOUR}    ${_AUTO_UP_DAY} ${_AUTO_UP_MONTH} *   root    bash /opt/local/bin/octopus ${_OCTO_FULL}" >> /etc/crontab
    fi

    echo Cron Update Completed
  fi
}

_crontab_cleanup() {
  if [ -e "/etc/crontab" ]; then
    sed -i "s/.*xdrago.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*arracuda.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*autoupboa weekly.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*ctopus.*//gi" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*du.*sql.*//gi" /etc/crontab &> /dev/null
    wait
    if [ "${_ADD_XTRA}" = "YES" ]; then
      ### 3-59/19 (minutes 3, 22, 41) never coincides with the */5 root-crontab
      ### line, so the redundant schedule can no longer double-start clear.sh.
      echo "3-59/19 *  * * *   root    bash /var/xdrago/clear.sh >/dev/null 2>&1" >> /etc/crontab
    fi

    _crontab_monitor_cleanup

    sed -i "/^$/d" /etc/crontab &> /dev/null
    wait
    echo Cron Cleanup Completed
  fi
}

