#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=lts
export _xSrl=588844ltsT01

_barCnf="/root/.barracuda.cnf"
_crlGet="-L --max-redirs 3 -s --fail --retry 9 --retry-delay 9 -A iCab"

# Defaults before the cnf source below so the cnf value wins; the
# variable is the supported switch, the marker stays honoured for
# one release while fleets converge.
_DENY_JETTY9=NO
_DENY_SOLR7=NO
_DENY_SOLR9=NO
_ALLOW_SENDMAIL=NO
_DENY_JAVA=NO

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    chmod a+w /dev/null
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

# Weekly system-upgrade wrapper, invoked by the weekly auto-update cron as
#   autoupboa weekly-system up-<tier> system [php-*] noscreen
# (written by _crontab_update). Runs ONLY where auto-updates are enabled; boxes
# without auto-updates use the manual procedure (see docs/ICU-PIN.md). If PHP 7.4 is
# present but its intl is missing (e.g. an ICU 76 bump rebuilt 7.4 without intl),
# bootstrap it: pin ICU to a 7.4-safe version so 7.4 rebuilds WITH intl on ICU 73,
# then unpin so 8.x return to the OS-default ICU while 7.4 keeps its ICU-73 intl.
# Orchestrated HERE (never inside barracuda, which would self-call and loop);
# barracuda is only ever a leaf call. Self-limiting: once 7.4 carries intl the plain
# upgrade path runs.
_php74_intl_missing() {
  [ -x "/opt/php74/bin/php" ] || return 1
  /opt/php74/bin/php -m 2>/dev/null | grep -qiE '^intl$' && return 1
  return 0
}
_run_weekly_system_upgrade() {
  shift  ### drop the weekly-system keyword; "$@" is now the barracuda upgrade args
  local _bootMark="/var/log/boa/.php74_intl_bootstrap.active"
  ### resume safety: a leftover marker means a prior run pinned but did not unpin
  ### (the pin is ours, not an operator's), so clear it before deciding this run
  if [ -e "${_bootMark}" ]; then
    sed -i '/^_ICU_FORCE_VRN=/d' "${_barCnf}"
    rm -f "${_bootMark}"
  fi
  if _php74_intl_missing; then
    echo "INFO: PHP 7.4 present without intl -- bootstrapping via temporary ICU 73 pin"
    touch "${_bootMark}"
    /opt/local/bin/barracuda php-idle disable
    wait
    sed -i '/^#\?_ICU_FORCE_VRN=/d' "${_barCnf}"
    echo '_ICU_FORCE_VRN="73-1"' >> "${_barCnf}"
    /opt/local/bin/barracuda "$@"   ### pin pass: 7.4 rebuilt with intl on ICU 73
    wait
    sed -i '/^_ICU_FORCE_VRN=/d' "${_barCnf}"
    rm -f "${_bootMark}"
    /opt/local/bin/barracuda "$@"   ### unpin pass: 8.x return to OS-default ICU
    wait
    if _php74_intl_missing; then
      echo "INFO: PHP 7.4 intl bootstrap did not yield intl -- retry on next weekly run"
    else
      echo "INFO: PHP 7.4 intl bootstrap completed"
    fi
  else
    /opt/local/bin/barracuda "$@"   ### normal weekly system upgrade
    wait
  fi
}
### The weekly dispatch sits above every other guard in this file, so it
### needs its own pre-flight: the chained install's octopus leg holds only
### octopus_install_run.pid, which barracuda's own two-pid pre-flight never
### consulted -- a weekly pass starting there purges the build tree the
### install is still consuming. Same checks as _is_protected_run (defined
### far below, hence mirrored here, not called).
_weekly_install_in_flight() {
  local _cbn=""
  local _cPat=""
  local _CNT=0
  for _cbn in autoinit automini barracuda boa octopus; do
    if [ -e "/opt/local/bin/${_cbn}" ]; then
      _cPat="/local/bin/${_cbn}"
      # Bare "boa" also matches the boa-info probes other cron ticks fire
      # every few minutes, and an unanchored "boa in-" matches a REMOTE
      # install driven from this box over ssh; only a LOCAL in-flight
      # INSTALL may defer the weekly, or transient probes and remote legs
      # walk it into the skip-a-week terminal state
      [ "${_cbn}" = "boa" ] && _cPat="^(/[^ ]*/)?bash (-c )?/(opt|usr)/local/bin/boa in-"
      _CNT=$(pgrep -fc "${_cPat}")
      if (( _CNT > 0 )); then
        return 0
      fi
    fi
  done
  if pgrep -f "/var/backups/BARRACUDA.sh.txt" > /dev/null 2>&1 \
    || pgrep -f "/var/backups/OCTOPUS.sh.txt" > /dev/null 2>&1; then
    return 0
  fi
  [ -e "/run/octopus_install_run.pid" ] && return 0
  [ -e "/run/boa_run.pid" ] && return 0
  [ -e "/run/boa_wait.pid" ] && return 0
  return 1
}
if [ "$1" = "weekly-system" ]; then
  ### Defer, don't collide: wait for a clear box so the weekly window is
  ### delayed rather than lost; if still busy after the bounded wait, skip
  ### -- the next weekly run retries
  _wCnt=0
  while _weekly_install_in_flight; do
    _wCnt=$(( _wCnt + 1 ))
    if (( _wCnt > 90 )); then
      echo "INFO: install or pass still in flight after 90 min -- weekly-system skipped"
      exit 0
    fi
    echo "INFO: install or pass in flight -- weekly-system waiting (${_wCnt}/90)"
    sleep 60
  done
  _run_weekly_system_upgrade "$@"
  exit 0
fi

#
# Fix for Sequel (Pro/Ace/Ace fork) support
_fix_allow_tcp_forwarding() {
  if grep -q "^AllowTcpForwarding no" /etc/ssh/sshd_config; then
    echo "AllowTcpForwarding no detected, fixing to local"
    sed -i "s/^AllowTcpForwarding no/AllowTcpForwarding local/g" /etc/ssh/sshd_config
    wait
    if grep -q "^AllowTcpForwarding local" /etc/ssh/sshd_config; then
      echo "AllowTcpForwarding set to local, reloading sshd"
      service ssh reload &> /dev/null
    else
      echo "AllowTcpForwarding fix failed, please check /etc/ssh/sshd_config"
    fi
  else
    echo "AllowTcpForwarding fix not needed"
  fi
}
_fix_allow_tcp_forwarding

#
# Purge memory swap if bloated
_kill_stuck_fire_external() {
  _FIRE_WATCHDOG_TIMEOUT=180  # seconds — matches guest-fire.sh's own threshold
  _FIRE_WATCHDOG_LOG="/var/log/boa/fire_stuck.log"
  _FIRE_SCRIPT="guest-fire.sh"
  local _BOOT_TIME _PID _START_TICKS _ELAPSED _NOW _CLK_TCK
  _NOW=$(date +%s)
  _BOOT_TIME=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
  _CLK_TCK=$(getconf CLK_TCK 2>/dev/null || echo 100)

  while IFS= read -r _PID; do
    [[ -z "${_PID}" ]] && continue
    # /proc/PID/stat field 22 = process start time in clock ticks since boot
    _START_TICKS=$(awk '{print $22}' "/proc/${_PID}/stat" 2>/dev/null)
    [[ -z "${_START_TICKS}" ]] && continue
    # Convert: start_seconds_since_boot = start_ticks / CLK_TCK
    # Elapsed = now - (boot_epoch + start_seconds_since_boot)
    _BOOT_EPOCH=$(( _NOW - _BOOT_TIME ))
    _START_EPOCH=$(( _BOOT_EPOCH + _START_TICKS / _CLK_TCK ))
    _ELAPSED=$(( _NOW - _START_EPOCH ))
    if (( _ELAPSED > _FIRE_WATCHDOG_TIMEOUT )); then
      echo "$(date) [fire-watchdog-ext] PID ${_PID} (${_FIRE_SCRIPT}) stuck ${_ELAPSED}s > ${_FIRE_WATCHDOG_TIMEOUT}s — killing" \
        >> "${_FIRE_WATCHDOG_LOG}"
      kill -9 "${_PID}" 2>/dev/null || true
      rm -f "/run/fire.pid"
    fi
  done < <(pgrep -f "${_FIRE_SCRIPT}" 2>/dev/null)
}
_kill_stuck_fire_external

#
# Purge memory swap if bloated
_swap_purge_if_bloated() {
  local _SWAP_THRESHOLD="${1:-50}"
  local _swap_total _swap_used _swap_pct

  _swap_total=$(awk '/SwapTotal/ {print $2}' /proc/meminfo)
  _swap_used=$(awk '/SwapFree/ {gsub(/SwapFree:[ \t]+/,""); print $1}' /proc/meminfo)

  if [[ -z "${_swap_total}" || "${_swap_total}" -eq 0 ]]; then
    echo "SWP no swap configured or swap total is zero, skipping"
    return 0
  fi

  _swap_used=$(awk '/SwapTotal/{t=$2} /SwapFree/{f=$2} END{print t-f}' /proc/meminfo)
  _swap_pct=$(( _swap_used * 100 / _swap_total ))

  echo "SWP swap usage: ${_swap_pct}% (${_swap_used} kB used of ${_swap_total} kB, threshold: ${_SWAP_THRESHOLD}%)"

  if [[ "${_swap_pct}" -ge "${_SWAP_THRESHOLD}" ]]; then
    echo "SWP swap at ${_swap_pct}% >= threshold ${_SWAP_THRESHOLD}%, purging"
    sync && echo 3 | tee /proc/sys/vm/drop_caches
    local _mem_free
    _mem_free=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    if [[ "${_mem_free}" -lt "${_swap_used}" ]]; then
      echo "SWP insufficient free RAM (${_mem_free} kB) to absorb swap (${_swap_used} kB), aborting purge"
      return 1
    fi
    if swapoff -a; then
      echo "SWP swapoff complete"
    else
      echo "SWP swapoff failed"
      return 1
    fi
    if swapon -a; then
      echo "SWP swapon complete, swap purged successfully"
    else
      echo "SWP swapon failed after swapoff — swap may be offline"
      return 1
    fi
    sync && echo 3 | tee /proc/sys/vm/drop_caches
  else
    echo "SWP swap usage healthy, no action taken"
  fi
}
_swap_purge_if_bloated

#
# Protect from any autoupboa updates when _SKYNET_MODE=OFF
if [ ! -z "${_SKYNET_MODE}" ] && [ "${_SKYNET_MODE}" = "OFF" ]; then
  exit 0
fi

# Free the dpkg lock right before real apt work (avahi purge, apparmor removal,
# the unattended-upgrades self-heal install). The daily worker's cmdline is
# "/usr/bin/python3 /usr/bin/unattended-upgrade" -- match the script path
# (never the plural package name, which no worker cmdline carries), bracketed
# so concurrent guards never match each other's pkill. Kill the
# apt.systemd.daily parent first or it respawns the worker moments later; heal
# any interrupted dpkg state the kill may leave, matching the autoinit
# backstop. Called only from branches about to install/remove packages:
# autoupboa runs every few minutes via clear.sh, so killing on every pass
# would starve every daily security-updates run. A killed security-only run
# simply retries on its next daily timer.
_free_dpkg_lock() {
  if pgrep -f '/usr/lib/apt/apt.systemd.dail[y]' >/dev/null 2>&1; then
    pkill -9 -f '/usr/lib/apt/apt.systemd.dail[y]'
  fi
  if pgrep -f '/usr/bin/unattended-upgrad[e]' >/dev/null 2>&1; then
    pkill -9 -f '/usr/bin/unattended-upgrad[e]'
    /usr/bin/dpkg --configure -a &> /dev/null
  fi
}

#
# Find correct IP.
_find_correct_ip() {
  if [ -e "/root/.found_correct_ipv4.cnf" ]; then
    _LOC_IP=$(cat /root/.found_correct_ipv4.cnf 2>/dev/null | tr -d '\n')
  else
    _LOC_IP=$(curl ${_crlGet} https://api.ipify.org | sed 's/[^0-9\.]//g')
    if [ -z "${_LOC_IP}" ]; then
      _LOC_IP=$(curl ${_crlGet} http://ipv4.icanhazip.com | sed 's/[^0-9\.]//g')
    fi
    if [ ! -z "${_LOC_IP}" ]; then
      echo ${_LOC_IP} > /root/.found_correct_ipv4.cnf
    fi
  fi
  if [ -n "${_LOC_IP}" ] && grep -qE "${_LOC_IP}\s" /etc/hosts; then
    cp -af /etc/hosts /etc/.was.hosts
    sed -i "s/^${_LOC_IP}.*//g" /etc/hosts
    [ -x "/etc/init.d/unbound" ] && [ ! -e "/usr/etc/unbound/unbound.conf.d" ] && mkdir -p /usr/etc/unbound/unbound.conf.d
    [ -x "/etc/init.d/unbound" ] && service unbound restart &> /dev/null
  fi
}

#
# Valkey without RDB snapshots
_valkey_no_rdb() {
  if [ -e "/etc/valkey/valkey.conf" ]; then
    _NEEDS_VALKEY_RESTART=
    if ! grep -qE '^maxmemory-policy[[:space:]]*volatile-lfu' /etc/valkey/valkey.conf; then
      sed -i "s/^maxmemory-policy .*/maxmemory-policy volatile-lfu/g" /etc/valkey/valkey.conf &> /dev/null
      _NEEDS_VALKEY_RESTART=YES
    fi
    if ! grep -qE '^[[:space:]]*save\b' /etc/valkey/valkey.conf; then
      sed -i "s/^# save \"\"/save \"\"/g" /etc/valkey/valkey.conf &> /dev/null
      _NEEDS_VALKEY_RESTART=YES
    fi
    if ! grep -qE '^[[:space:]]*save\b' /etc/valkey/valkey.conf; then
      printf '\n# Cache-only instance: disable persistence (no RDB snapshots)\nsave ""\n' >> /etc/valkey/valkey.conf
      _NEEDS_VALKEY_RESTART=YES
    fi
    if [ -n "${_NEEDS_VALKEY_RESTART}" ]; then
      service valkey-server restart &> /dev/null
    fi
  fi
}
_valkey_no_rdb

#
# Purge not used Avahi
_purge_avahi() {
  local _avahi_bin
  _avahi_bin="$(command -v avahi-daemon 2>/dev/null)"
  if [ -z "${_avahi_bin}" ] && ! dpkg -l avahi-daemon 2>/dev/null | grep -q "^ii"; then
    return 0
  fi
  service avahi-daemon stop 2>/dev/null
  update-rc.d avahi-daemon disable 2>/dev/null
  _free_dpkg_lock
  apt-get purge -y avahi-daemon avahi-utils libnss-mdns 2>/dev/null
  apt-get autoremove -y 2>/dev/null
  if dpkg -l avahi-daemon 2>/dev/null | grep -q "^ii"; then
    echo "AVAHI purge failed, please check manually"
  fi
}

[ -e "/root/.avahi_purged.lock" ] && [ ! -e "/var/log/boa/.avahi_purged.lock" ] && { mkdir -p /var/log/boa 2>/dev/null; cp -a /root/.avahi_purged.lock /var/log/boa/ 2>/dev/null; }
if [ ! -e "/var/log/boa/.avahi_purged.lock" ]; then
  _purge_avahi
  touch /var/log/boa/.avahi_purged.lock
fi

# Function to disable dns checks in csf
_fix_csf_lf_lookups() {
  local _CSF_CONF="/etc/csf/csf.conf"
  local _DONE_FLAG="/root/.csf.no.lf.lookups.cnf"

  [ -e "${_DONE_FLAG}" ] && return 0
  [ ! -f "${_CSF_CONF}" ] && return 0

  local _LF_LOOKUPS _CC_LOOKUPS
  _LF_LOOKUPS=$(grep -E "^LF_LOOKUPS" "${_CSF_CONF}" | cut -d'"' -f2)
  _CC_LOOKUPS=$(grep -E "^CC_LOOKUPS" "${_CSF_CONF}" | cut -d'"' -f2)

  if [ "${_LF_LOOKUPS}" = "1" ]; then
    echo "LF_LOOKUPS is enabled -- disabling to prevent DNS lookup delays on csf -td"
    sed -i 's/^LF_LOOKUPS = "1"/LF_LOOKUPS = "0"/' "${_CSF_CONF}"
  fi
  if [ "${_CC_LOOKUPS}" = "1" ]; then
    echo "CC_LOOKUPS is enabled -- disabling to prevent GeoIP DNS lookup overhead"
    sed -i 's/^CC_LOOKUPS = "1"/CC_LOOKUPS = "0"/' "${_CSF_CONF}"
  fi

  csf -r &> /dev/null
  echo "CSF reloaded"
  touch "${_DONE_FLAG}"
}
_fix_csf_lf_lookups

# Function to enable fstrim instead of discard
_if_enable_fstrim() {
  if [ -x "/usr/sbin/fstrim" ] && [ -d "/etc/cron.daily" ] && [ ! -e "/etc/cron.daily/fstrim" ]; then
    cat > /etc/cron.daily/fstrim <<'EOF'
#!/bin/bash
# Run TRIM periodically instead of using mount option "discard"
command -v fstrim >/dev/null 2>&1 || exit 0
fstrim -av >/dev/null 2>&1
exit 0
EOF
    chmod 0755 /etc/cron.daily/fstrim
  fi
}
_if_enable_fstrim

# Function to calculate RAM usage percentage as an integer
_calculate_ram_usage_percent() {
  _total_ram_kb=$1
  _available_ram_kb=$2
  used_ram_kb=$((_total_ram_kb - _available_ram_kb))

  # Using integer division to get a whole number percentage
  echo $(( (used_ram_kb * 100) / _total_ram_kb ))
}

# Function to check and display system info
_check_system_ram() {
  # Get the total and available RAM in KB
  _total_ram_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  _available_ram_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')

  # Calculate RAM usage percentage
  _ram_usage_percent=$(_calculate_ram_usage_percent ${_total_ram_kb} ${_available_ram_kb})
}

# Function to check and optimize RAM and disk caches
_optimize_ram() {
  _check_system_ram
  if [ "${_ram_usage_percent}" -gt 90 ]; then
    sync && echo 3 | tee /proc/sys/vm/drop_caches
  fi
}

###
### Return 0 if package is installed, 1 otherwise.
###
_pkg_installed() {
  /usr/bin/dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -qx 'install ok installed'
}

###
### Turn off AppArmor
###
_turn_off_apparmor() {

  # Fix shell in AppArmor scripts (only do this if needed)
  grep -q "/usr/bin/sh" /lib/apparmor/apparmor.systemd && \
    sed -i "s#/usr/bin/sh#/bin/bash#g" /lib/apparmor/apparmor.systemd
  grep -q "/bin/sh" /lib/apparmor/apparmor.systemd && \
    sed -i "s#/bin/sh#/bin/bash#g" /lib/apparmor/apparmor.systemd

  grep -q "/usr/bin/sh" /lib/apparmor/rc.apparmor.functions && \
    sed -i "s#/usr/bin/sh#/bin/bash#g" /lib/apparmor/rc.apparmor.functions
  grep -q "/bin/sh" /lib/apparmor/rc.apparmor.functions && \
    sed -i "s#/bin/sh#/bin/bash#g" /lib/apparmor/rc.apparmor.functions

  grep -q "/usr/bin/sh" /lib/apparmor/profile-load && \
    sed -i "s#/usr/bin/sh#/bin/bash#g" /lib/apparmor/profile-load
  grep -q "/bin/sh" /lib/apparmor/profile-load && \
    sed -i "s#/bin/sh#/bin/bash#g" /lib/apparmor/profile-load

  # Disable AppArmor and Auditd
  if [ -e "/etc/apparmor.d" ] && [ -e "/var/cache/apparmor" ]; then
    rm -rf /var/cache/apparmor/* &> /dev/null
    rm -f /etc/apparmor.d/*~ &> /dev/null
    apparmor_parser -r /etc/apparmor.d/* &> /dev/null
    rm -f /etc/apparmor.d/*~ &> /dev/null
    aa-complain /etc/apparmor.d/* &> /dev/null
  fi
  if [ -x "/etc/init.d/apparmor" ]; then
    service apparmor stop &> /dev/null
    update-rc.d -f apparmor remove &> /dev/null
    service auditd stop &> /dev/null
    update-rc.d -f auditd remove &> /dev/null
  fi
  if [ -x "/usr/sbin/aa-teardown" ]; then
    aa-teardown &> /dev/null
  fi
  _free_dpkg_lock
  for _PKG in auditd apparmor apparmor-utils apparmor-notify apparmor-profiles apparmor-profiles-extra; do
    if _pkg_installed "${_PKG}"; then
      /usr/bin/apt-get remove ${_PKG} -y -qq &> /dev/null
    fi
  done
  _isAppArmorGrubFile="/etc/default/grub.d/apparmor.cfg"
  mkdir -p /etc/default/grub.d
  echo 'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT apparmor=0"' | tee ${_isAppArmorGrubFile} &> /dev/null
  update-grub &> /dev/null
  [ ! -e "/root/.disable.apparmor.cnf" ] && touch /root/.disable.apparmor.cnf
}

###
### Only disable AppArmor if it’s active (profiles currently loaded)
###
_if_off_apparmor() {
  if [ ! -e "/root/.keep_apparmor_on.cnf" ]; then
    _isAppArmOn=N
    if [ -e "/sys/module/apparmor/parameters/enabled" ]; then
      _isAppArmOn="$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null | tr -d '\n')"
    fi
    if [ "${_isAppArmOn}" = "Y" ]; then
      _turn_off_apparmor
    fi
  fi
}
_if_off_apparmor

# Define default values
_DEFAULT_CPU_CRIT_RATIO="8.1"
_DEFAULT_CPU_MAX_RATIO="6.1"
_DEFAULT_CPU_TASK_RATIO="3.1"
_DEFAULT_CPU_SPIDER_RATIO="2.1"
_LOCK_CPU_CONFIG="/root/.lock.cpu.update.f97.cnf"
_UPDATE_CPU_PID="/var/log/boa/.update_conf_variable.ctrl.f97.${_tRee}.${_xSrl}.pid"
_LOCK_DOS_CONFIG="/root/.lock.dos.update.f98.cnf"
_LOCK_DOS_PID="/var/log/boa/.sync_scan_nginx.ctrl.f98.${_tRee}.${_xSrl}.pid"
_DEFAULT_NGINX_DOS_LINES=1999
_DEFAULT_NGINX_DOS_LIMIT=399
_DEFAULT_NGINX_DOS_MODE=2
_DEFAULT_NGINX_DOS_DIV_INC_NR=40
_DEFAULT_NGINX_DOS_INC_MIN=3
_DEFAULT_NGINX_DOS_LOG=SILENT
_DEFAULT_NGINX_DOS_IGNORE="doccomment"
_DEFAULT_NGINX_DOS_STOP="WAITFOR.DELAY|DECLARE.*@x|/\*\*/|%27.*%29.*%3B|0x[0-9a-f]{6}"

# Function to update or add variables in the configuration file
_update_conf_variable() {
  _var_name="$1"
  _default_value="$2"
  _conf_file="$3"

  if grep -qE "^#?${_var_name}=" "${_conf_file}"; then
    # Variable exists, uncomment and update value
    sed -i "s|^#\?${_var_name}=.*|${_var_name}=\"${_default_value}\"|g" "${_conf_file}"
  else
    # Variable doesn't exist, append to the file
    echo "${_var_name}=\"${_default_value}\"" >> "${_conf_file}"
  fi
}

if [ ! -e "${_LOCK_CPU_CONFIG}" ]; then
  if [ ! -e "${_UPDATE_CPU_PID}" ]; then
    # Update variables
    _update_conf_variable "_CPU_CRIT_RATIO" "${_DEFAULT_CPU_CRIT_RATIO}" "${_barCnf}"
    _update_conf_variable "_CPU_MAX_RATIO" "${_DEFAULT_CPU_MAX_RATIO}" "${_barCnf}"
    _update_conf_variable "_CPU_TASK_RATIO" "${_DEFAULT_CPU_TASK_RATIO}" "${_barCnf}"
    _update_conf_variable "_CPU_SPIDER_RATIO" "${_DEFAULT_CPU_SPIDER_RATIO}" "${_barCnf}"
    rm -f /var/log/boa/.update_conf_variable.ctrl*
    touch ${_UPDATE_CPU_PID}
    touch ${_LOCK_CPU_CONFIG}
  fi
fi

# Define directories and error log path
_SSL_DIR="/etc/ssl/private"
_NGINX_ERROR_LOG="/var/log/nginx/error.log"

# Function to check if a file is empty
_is_empty_file() {
  local file="$1"
  [[ ! -s "$file" ]]
}

# Check for empty .dhp files and attempt to replace or regenerate them
_process_dhp_files() {
  _dhp_files=("${_SSL_DIR}"/*.dhp)
  _non_empty_dhp=""
  # Find the first non-empty .dhp file
  for _dhp_file in "${_dhp_files[@]}"; do
    if ! _is_empty_file "${_dhp_file}"; then
      _non_empty_dhp="${_dhp_file}"
      break
    fi
  done
  # Loop over all .dhp files
  for _dhp_file in "${_dhp_files[@]}"; do
    if _is_empty_file "${_dhp_file}"; then
      if [[ -n "${_non_empty_dhp}" ]]; then
        echo "Replacing empty file ${_dhp_file} with ${_non_empty_dhp}"
        cp "${_non_empty_dhp}" "${_dhp_file}"
      else
        echo "No non-empty .dhp file found, generating new file for ${_dhp_file}"
        openssl dhparam -out "${_dhp_file}" 4096 > /dev/null 2>&1 &
      fi
    fi
  done
}

# Scan Nginx error log for .dhp related errors
_scan_nginx_errors() {
  grep "PEM_read_bio_DHparams" "${_NGINX_ERROR_LOG}" | awk -F'(")' '{print $2}' | while read -r _missing_dhp; do
    if [[ ! -f "${_missing_dhp}" ]]; then
      echo "Missing .dhp file detected: ${_missing_dhp}"
      if [[ -n "${_non_empty_dhp}" ]]; then
        echo "Copying non-empty .dhp file to ${_missing_dhp}"
        cp "${_non_empty_dhp}" "${_missing_dhp}"
      else
        echo "Generating new .dhp file for ${_missing_dhp}"
        openssl dhparam -out "${_missing_dhp}" 4096 > /dev/null 2>&1 &
      fi
    fi
  done
}

_process_dhp_files
_scan_nginx_errors

_crontab_check_clean_race() {
  _CSF_CRON_TEST=$(grep water /etc/crontab 2>&1)
  if [ -e "/etc/csf/csf.deny" ] \
    && [ -x "/usr/sbin/csf" ] \
    && [[ "${_CSF_CRON_TEST}" =~ "water" ]]; then
    sed -i "s/.*fire.*//g" /etc/crontab &> /dev/null
    wait
    sed -i "s/.*water.*//g" /etc/crontab &> /dev/null
    wait
    sed -i "/^$/d" /etc/crontab &> /dev/null
    wait
  fi
}
_crontab_check_clean_race

_bring_all_ram_cpu_online() {
  _RAM_AUTO_FILE="/sys/devices/system/memory/auto_online_blocks"
  if [ -f "${_RAM_AUTO_FILE}" ]; then
    if grep -qx offline "${_RAM_AUTO_FILE}"; then
      echo online > "${_RAM_AUTO_FILE}"
    fi
  fi
  for _CPU_DIR in /sys/devices/system/cpu/cpu[0-9]*
  do
    _CPU=${_CPU_DIR##*/}
    _CPU_STATE_FILE="${_CPU_DIR}/online"
    if [ -f "${_CPU_STATE_FILE}" ]; then
      if grep -qx 0 "${_CPU_STATE_FILE}"; then
        echo 1 > "${_CPU_STATE_FILE}"
      fi
    fi
  done
  for _RAM_DIR in /sys/devices/system/memory/memory[0-9]*
  do
    _RAM=${_RAM_DIR##*/}
    _RAM_STATE_FILE="${_RAM_DIR}/state"
    if [ -f "${_RAM_STATE_FILE}" ]; then
      if grep -qx offline "${_RAM_STATE_FILE}"; then
        echo online > "${_RAM_STATE_FILE}"
      fi
    fi
  done
}
_bring_all_ram_cpu_online

_if_disable_not_used_services() {
  _clearSwap=No

  if [ "${_tRee}" = "dev" ] && [ -e "/etc/boa/.ice.vm.cnf" ]; then
    echo > /var/xdrago/move_sql.sh
    echo > /var/xdrago/proc_num_ctrl.pl
    echo > /var/xdrago/runner.sh
    echo > /var/xdrago/monitor/check/nginx.sh
    echo > /var/xdrago/monitor/check/mysql.sh
    echo > /var/xdrago/mysql_backup.sh
    rm -f /var/spool/cron/crontabs/aegir
    killall -9 pure-ftpd
    killall -9 newrelic-daemon
    [ -e "/run/nginx.pid" ] && service nginx stop
    [ -e "/run/php83-fpm.pid" ] && killall -9 php-fpm
    [ -e "/run/mysqld/mysqld.pid" ] && service mysql stop
    [ -e "/run/valkey/valkey.pid" ] && service valkey-server stop
    [ -e "/run/redis/redis.pid" ] && service redis-server stop
    [ -e "/root/.deny.clamav.cnf" ] && touch /root/.deny.clamav.cnf
    [ -e "/root/.deny.java.cnf" ] && touch /root/.deny.java.cnf
    _clearSwap=YES
  fi

  if { [ ! -e "/root/.allow.clamav.cnf" ] \
    && ! grep -qiE "^[[:space:]]*(export[[:space:]]+)?_ALLOW_CLAMAV=[\"' ]*YES" /root/.barracuda.cnf 2>/dev/null; } \
    || [ -e "/root/.deny.clamav.cnf" ] \
    || grep -qiE "^[[:space:]]*(export[[:space:]]+)?_DENY_CLAMAV=[\"' ]*YES" /root/.barracuda.cnf 2>/dev/null; then
    if [ -e "/etc/init.d/clamav-daemon" ]; then
      _clearSwap=YES
      update-rc.d -f clamav-daemon remove &> /dev/null
      mv -f /etc/init.d/clamav-daemon /var/backups/clamav-daemon.initd
    fi
    if [ -e "/etc/init.d/clamav-freshclam" ]; then
      _clearSwap=YES
      update-rc.d -f clamav-freshclam remove &> /dev/null
      mv -f /etc/init.d/clamav-freshclam /var/backups/clamav-freshclam.initd
    fi
    pkill -9 -f clamd
    pkill -9 -f freshclam
    rm -f /run/clamav/*
  fi

  if [ "${_DENY_JAVA}" = "YES" ] \
    || [ -e "/root/.deny.java.cnf" ]; then
    if [ -e "/etc/init.d/solr9" ]; then
      _clearSwap=YES
      update-rc.d -f solr9 remove &> /dev/null
      mv -f /etc/init.d/solr9 /var/backups/solr9.initd
    fi
    if [ -e "/etc/init.d/solr7" ]; then
      _clearSwap=YES
      update-rc.d -f solr7 remove &> /dev/null
      mv -f /etc/init.d/solr7 /var/backups/solr7.initd
    fi
    if [ -e "/etc/init.d/jetty9" ]; then
      _clearSwap=YES
      update-rc.d -f jetty9 remove &> /dev/null
      mv -f /etc/init.d/jetty9 /var/backups/jetty9.initd
    fi
    pkill -9 -f avahi-daemon
    pkill -9 -f java
  fi

  if [ "${_DENY_JETTY9}" = "YES" ] \
    || [ -e "/etc/boa/.deny.jetty9.cnf" ]; then
    if [ -e "/etc/init.d/jetty9" ]; then
      _clearSwap=YES
      update-rc.d -f jetty9 remove &> /dev/null
      mv -f /etc/init.d/jetty9 /var/backups/jetty9.initd
      pkill -9 -f avahi-daemon
      pkill -9 -f jetty9
    fi
  fi

  if [ "${_DENY_SOLR7}" = "YES" ] \
    || [ -e "/etc/boa/.deny.solr7.cnf" ]; then
    if [ -e "/etc/init.d/solr7" ]; then
      _clearSwap=YES
      update-rc.d -f solr7 remove &> /dev/null
      mv -f /etc/init.d/solr7 /var/backups/solr7.initd
      pkill -9 -f avahi-daemon
      pkill -9 -f solr7
    fi
  fi

  if [ "${_DENY_SOLR9}" = "YES" ] \
    || [ -e "/etc/boa/.deny.solr9.cnf" ]; then
    if [ -e "/etc/init.d/solr9" ]; then
      _clearSwap=YES
      update-rc.d -f solr9 remove &> /dev/null
      mv -f /etc/init.d/solr9 /var/backups/solr9.initd
      pkill -9 -f avahi-daemon
      pkill -9 -f solr9
    fi
  fi

  if [ "${_clearSwap}" = "YES" ]; then
    _optimize_ram
  fi
}
_if_disable_not_used_services

_os_detection_minimal() {
  _APT_UPDATE="apt-get update"
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  _OS_LIST="excalibur daedalus chimaera beowulf buster bullseye bookworm trixie"
  for e in ${_OS_LIST}; do
    if [ "${e}" = "${_OS_CODE}" ]; then
      _APT_UPDATE="apt-get update --allow-releaseinfo-change"
    fi
  done
}
_os_detection_minimal

_apt_clean_update() {
  ${_APT_UPDATE} -qq 2>/dev/null
  _CALLER_SCRIPT="$(basename "${BASH_SOURCE[-1]}")"
  _CALLER_SCRIPT="${_CALLER_SCRIPT//[^a-zA-Z0-9._-]/_}"
  date +%s > "/run/_latest_apt_clean_update.${_CALLER_SCRIPT}.pid"
}

###
### Ensure the unattended-upgrades package is present and configured for
### security-only updates. Idempotent and cheap once converged: the codename
### floor, the opt-out check and the installed-package check all short-circuit
### before any apt work, and the two managed apt.conf.d files are rewritten only
### on content drift. Never touches the stock 50 conffile (dist-upgrades replace
### it). Kernel activation stays with _if_new_kernel_reboot and its existing
### gating -- Automatic-Reboot is deliberately left false.
###
_write_managed_apt_conf() {
  # Returns 2 when the target is rewritten, 0 when already converged, 1 on error.
  local _dst="$1"
  local _want="$2"
  local _tmp
  if [[ -e "${_dst}" ]] && [[ "$(cat "${_dst}" 2>/dev/null)" = "${_want}" ]]; then
    return 0
  fi
  _tmp="$(mktemp /etc/apt/.boa-apt-conf.XXXXXX 2>/dev/null)"
  [[ -z "${_tmp}" ]] && return 1
  printf '%s\n' "${_want}" > "${_tmp}"
  chmod 0644 "${_tmp}"
  mv -f "${_tmp}" "${_dst}" || return 1
  return 2
}

_ensure_unattended_upgrades() {
  # Floor to distros with a live *-security archive; older codenames are
  # dead/dying upstream, so enabling there would be a pointless no-op.
  case "${_OS_CODE}" in
    daedalus|excalibur|bookworm|trixie) ;;
    *) return 0 ;;
  esac
  # Opt-out wins but never tears down: NO means "stop managing", not "remove".
  if [[ "${_SYSTEM_AUTO_SECURITY}" = "NO" ]]; then
    return 0
  fi
  local _uu_changed=NO
  # Install only when missing. A conffile prompt is fatal under cron (EOF on
  # stdin aborts mid-install), so keep the local file and continue. Refresh the
  # lists first so the install works on a box with empty/stale lists -- the
  # in-run _apt_clean_update happens later, after this self-heal.
  if ! _pkg_installed unattended-upgrades; then
    _free_dpkg_lock
    ${_APT_UPDATE} -qq 2>/dev/null
    DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install unattended-upgrades \
      -y -qq -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
      &> /dev/null
    _uu_changed=YES
  fi
  # Enabler: refresh package lists and run the unattended upgrade periodically.
  _write_managed_apt_conf "/etc/apt/apt.conf.d/20auto-upgrades" \
'APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";'
  [[ "$?" -eq 2 ]] && _uu_changed=YES
  # BOA policy overlay (apt merges *.conf.d): the archive-based a=*-security
  # origin matches both Debian and Devuan security archives, where the stock
  # origin= patterns miss Devuan. The blacklist documents intent -- our
  # nginx/php are source-built and Percona is not a *-security repo.
  _write_managed_apt_conf "/etc/apt/apt.conf.d/51unattended-upgrades-boa" \
'// Managed by BOA (autoupboa). Security-only unattended upgrades.
// Opt out with _SYSTEM_AUTO_SECURITY=NO in /root/.barracuda.cnf.
Unattended-Upgrade::Origins-Pattern {
  "a=*-security";
};
Unattended-Upgrade::Package-Blacklist {
  "percona-*";
  "nginx*";
  "php*";
};'
  [[ "$?" -eq 2 ]] && _uu_changed=YES
  # Narrate only when something actually changed; converged runs stay quiet.
  if [[ "${_uu_changed}" = "YES" ]]; then
    echo "INFO: unattended-upgrades configured for automatic OS security updates"
  fi
}
_ensure_unattended_upgrades

_system_hostname_check_fix() {
  if [ -e "${_barCnf}" ]; then
    if [ ! -z "${_MY_HOSTN}" ]; then
      _diffHostTest=$(diff -w -B /etc/hostname /etc/mailname 2>&1)
      if [ -z "${_diffHostTest}" ]; then
        _hostUpdate=""
        echo "INFO: hostname/mailname diff empty -- nothing to update"
      else
        _hostUpdate=YES
        _diffHostTest=$(echo -n ${_diffHostTest} | fmt -su -w 2500 2>&1)
        echo "INFO: hostname/mailname diff ${_diffHostTest}"
      fi
      if [ "${_hostUpdate}" = "YES" ]; then
        hostname -b ${_MY_HOSTN} ### force our custom FQDN/local hostname
        echo "${_MY_HOSTN}" > /etc/hostname
        echo "${_MY_HOSTN}" > /etc/mailname
      fi
    fi
  fi
}
_system_hostname_check_fix

