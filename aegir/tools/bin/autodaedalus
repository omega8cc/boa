###----------------------------------------###
### How To: Launch auto-upgrade properly   ###
###----------------------------------------###
###
###  Start with manual barracuda upgrade.
###
###    $ barracuda up-lts system
###
###  !!! CREATE A FRESH VM BACKUP SNAPSHOT !!!
###  !!! TEST THE FRESHLY CREATED BACKUP.. !!!
###  !!! BY USING IT TO CREATE NEW TEST VM !!!
###  !!! DO NOT CONTINUE UNTIL IT WORKS... !!!
###
###  Reboot the server to make sure there are
###  no issues with boot process.
###
###    $ shutdown -r now
###
###  If reboot worked and there are no issues,
###  you are ready for the automated magic...
###
###    $ touch /root/.run-to-daedalus.cnf
###    $ service clean-boa-env start
###
###  Once enabled, the system will launch
###  a series of barracuda upgrades/reboots
###  until it migrates any supported Debian
###  or Devuan version to Devuan Daedalus.
###
###  !!! WARNING !!!
###
###  EXPECT IT TO CRASH COMPLETELY, SO ONLY
###  FULL RESTORE FROM LATEST BACKUP SNAPSHOT
###  OF ENTIRE VM WILL BRING IT BACK TO LIVE.
###
###  DO NOT PROCEED UNTIL YOU ARE READY FOR
###  DISASTER RECOVERY FROM TESTED BACKUP!
###
###----------------------------------------###


###----------------------------------------###
### DON'T EDIT ANYTHING BELOW THIS LINE    ###
###----------------------------------------###

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec
export _tRee=dev
export _xSrl=588855devT01

_barCnf="/root/.barracuda.cnf"
_logAds="/root/.autodaedalus.log"

###
### Avoid too many questions
###
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
if [ -z "${TERM+x}" ]; then
  export TERM=vt100
fi

_aptAllow="--allow-unauthenticated"
_INITINS="/usr/bin/apt-get ${_aptAllow} -y install"
_dstUpArg="-fuy -q ${_aptAllow} --config-file /opt/apt/apt.conf.noi.dist"
_nrmUpArg="-fuy -q ${_aptAllow} --config-file /opt/apt/apt.conf.noi.nrml"

_TODAY=$(date +%y%m%d)
_TODAY=${_TODAY//[^0-9]/}
_OS_CODE=check
#

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    [ -e "/var/lib/man-db/auto-update" ] && rm -f /var/lib/man-db/auto-update
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
}
_check_root
cd /root/

if [ "${_tRee}" = "dev" ]; then
  touch /root/.debug-boa-installer.cnf
  touch /root/.debug-octopus-installer.cnf
fi

###
### Noticeable messages
###
_msg() {
  echo "AutoDaedalus v.${_tRee} [$(date +%T)] ==> $*"
}

_check_manufacturer_compatibility() {
  # Install dmidecode if not present
  if ! command -v dmidecode &> /dev/null; then
    /usr/bin/apt-get update --allow-insecure-repositories &> /dev/null
    ${_INITINS} dmidecode &> /dev/null
  fi
  # Read the system manufacturer. A machine with no SMBIOS/DMI table answers
  # with nothing, which is the normal state of a Xen paravirtualized guest
  # domain or a container -- environments this tree lists as supported -- so an
  # empty answer is never grounds for refusing to run.
  local _DMI_RAW=""
  _HOST_INFO=""
  _DMI_TEST="$(command -v dmidecode 2> /dev/null)"
  if [ -x "${_DMI_TEST}" ]; then
    _DMI_RAW="$("${_DMI_TEST}" -s system-manufacturer 2> /dev/null)"
  elif [ -r "/sys/class/dmi/id/sys_vendor" ]; then
    # Only when dmidecode is absent entirely, so the check is not left blind on
    # a host where the package could not be installed. Never when dmidecode is
    # merely silent, and never inside a container this can recognise: there
    # that file describes the HOST, so a container on an EC2 host would be
    # refused as EC2, and containers are on this tree's supported list. The
    # apt install above is unchecked, so a container can reach this arm; left
    # unread, it is the DMI-less guest it is and passes. The recognition set:
    # Docker leaves /.dockerenv; systemd writes /run/systemd/container when
    # it is the container's own PID 1; LXC, LXD, podman and nspawn set
    # container= in PID 1's environment (matched at the start of a record,
    # not as a substring); an OpenVZ guest has /proc/vz but not the host-only
    # /proc/bc; a VServer guest carries the VxID that boa's _check_virt
    # already greps for, same expression.
    if [ ! -e "/.dockerenv" ] \
      && [ ! -e "/run/systemd/container" ] \
      && ! { [ -e "/proc/vz" ] && [ ! -e "/proc/bc" ]; } \
      && ! { tr '\0' '\n' < /proc/1/environ 2> /dev/null | grep -q '^container='; } \
      && ! grep -qE 'VxID:[[:space:]]*[0-9]{2,}$' /proc/self/status 2> /dev/null; then
      _DMI_RAW="$(cat /sys/class/dmi/id/sys_vendor 2> /dev/null)"
    fi
  fi
  # Older dmidecode prints a banner and status lines on stdout ahead of the
  # value, so keep the last line that is none of them.
  _HOST_INFO="$(printf '%s\n' "${_DMI_RAW}" \
    | grep -v '^# ' \
    | grep -v '^SMBIOS .* present\.$' \
    | grep -v '^Getting SMBIOS data ' \
    | grep -v '^[[:space:]]*$' \
    | tail -n1)"
  # Amazon EC2 is the one manufacturer this refuses: it blocks the Devuan
  # conversion BOA has to perform. Match the whole reading, as before, so an
  # old dmidecode that prints a banner still matches.
  if printf '%s\n' "${_DMI_RAW}" | grep -qi 'Amazon EC2'; then
    _VMFAMILY="AWS"
    _msg "Not supported environment detected: ${_HOST_INFO}" >> "${_logAds}"
    _msg "Please check https://docs.boa.io/self-hosting/before-you-install" >> "${_logAds}"
    _msg "Bye!" >> "${_logAds}"
    echo "Not supported environment detected: ${_HOST_INFO}"
    echo "Please check https://docs.boa.io/self-hosting/before-you-install"
    echo "Bye!"
    exit 1
  fi
  if [ -z "${_HOST_INFO}" ]; then
    _msg "No DMI table here, system manufacturer unreadable, continuing" >> "${_logAds}"
  fi
}
_check_manufacturer_compatibility

_check_mysql_compatibility() {
  _DB_V=$(mysql -V 2>&1 \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
    | head -1 \
    | cut -d"." -f1,2)
  case "${_DB_V}" in
    5.7|8.0|8.4) ;;
    *)
      _msg "Not supported DB server detected ${_DB_V}" >> "${_logAds}"
      exit 1
    ;;
  esac
}
_check_mysql_compatibility

###
### Faster reboot
###
_faster_reboot() {
  _msg "Faster reboot prepare..." >> "${_logAds}"
  service cron stop &> /dev/null
  killall cron &> /dev/null
  pkill -9 -f second.sh
  pkill -9 -f minute.sh
  pkill -9 -f runner.sh
  _msg "Cron has been stopped" >> "${_logAds}"
  _msg "Now waiting 60 seconds for any running tasks to complete" >> "${_logAds}"
  sleep 55
  if { [ ! -e "/root/.allow.clamav.cnf" ] \
    && ! grep -qiE "^[[:space:]]*(export[[:space:]]+)?_ALLOW_CLAMAV=[\"' ]*YES" /root/.barracuda.cnf 2>/dev/null; } \
    || [ -e "/root/.deny.clamav.cnf" ] \
    || grep -qiE "^[[:space:]]*(export[[:space:]]+)?_DENY_CLAMAV=[\"' ]*YES" /root/.barracuda.cnf 2>/dev/null; then
    if [ -e "/etc/init.d/clamav-daemon" ]; then
      update-rc.d -f clamav-daemon remove &> /dev/null
    fi
    if [ -e "/etc/init.d/clamav-freshclam" ]; then
      update-rc.d -f clamav-freshclam remove &> /dev/null
    fi
  fi
  pkill -9 -f avahi-daemon
  pkill -9 -f clamd
  pkill -9 -f freshclam
  pkill -9 -f java
  rm -f /run/clamav/*
  _msg "Java/Solr/Clamav have been stopped" >> "${_logAds}"
  service nginx stop &> /dev/null
  killall nginx &> /dev/null
  killall php &> /dev/null
  pkill -9 -f php-fpm
  _msg "Nginx, PHP-CLI and PHP-FPM have been stopped" >> "${_logAds}"
  csf -df &> /dev/null
  csf -tf &> /dev/null
  _msg "Firewall has been purged" >> "${_logAds}"
  if [ -e "/root/.my.cnf" ]; then
    _IS_MYSQLD_RUNNING=$(pgrep -f /usr/sbin/mysqld)
    if [ ! -z "${_IS_MYSQLD_RUNNING}" ]; then
      _msg "Preparing MySQLD for quick shutdown..." >> "${_logAds}"
      mysql -u root -e "SET GLOBAL innodb_max_dirty_pages_pct = 0;" &> /dev/null
      mysql -u root -e "SET GLOBAL innodb_change_buffering = 'none';" &> /dev/null
      mysql -u root -e "SET GLOBAL innodb_buffer_pool_dump_at_shutdown = 1;" &> /dev/null
      mysql -u root -e "SET GLOBAL innodb_io_capacity=3000;" &> /dev/null
      mysql -u root -e "SET GLOBAL innodb_io_capacity_max=6000;" &> /dev/null
      if [ "${_DB_V}" = "5.7" ]; then
        mysql -u root -e "SET GLOBAL innodb_buffer_pool_dump_pct = 100;" &> /dev/null
        mysql -u root -e "SET GLOBAL innodb_buffer_pool_dump_now = ON;" &> /dev/null
      fi
      mysql -u root -e "SET GLOBAL innodb_fast_shutdown = 1;" &> /dev/null
      _msg "Stopping MySQLD now..." >> "${_logAds}"
      service mysql stop &> /dev/null
      wait
      _msg "MySQLD stopped" >> "${_logAds}"
    else
      _msg "MySQLD already stopped" >> "${_logAds}"
    fi
  fi
  _msg "Faster reboot done" >> "${_logAds}"
}

if [ ! -e "/root/.run-to-daedalus.cnf" ]; then
  echo "ERROR: /root/.run-to-daedalus.cnf is required!"
  exit 1
fi

_check_os_compatibility() {
  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  if [ "${_OS_CODE}" = "daedalus" ] \
    && [ ! -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] \
    && [ ! -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ]; then
    echo "This server already runs ${_OS_DIST}/${_OS_CODE}"
    echo "Bye!"
    exit 1
  fi
  if [ "${_OS_CODE}" = "chimaera" ]; then
    _NEXT_OS_CODE=daedalus
  elif [ "${_OS_CODE}" = "bookworm" ]; then
    _NEXT_OS_CODE=daedalus
  elif [ "${_OS_CODE}" = "beowulf" ]; then
    _NEXT_OS_CODE=chimaera
  elif [ "${_OS_CODE}" = "bullseye" ]; then
    _NEXT_OS_CODE=chimaera
  elif [ "${_OS_CODE}" = "buster" ]; then
    _NEXT_OS_CODE=beowulf
  else
    if [ ! -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] \
      && [ ! -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ]; then
      echo "This procedure does not support ${_OS_DIST}/${_OS_CODE}"
      echo "The minimum supported system is Debian/buster"
      echo "The maximum supported system is Debian/bookworm or Devuan/chimaera"
      echo "Bye!"
      exit 1
    fi
  fi
}
_check_os_compatibility

if [ -x "/opt/local/bin/killer" ]; then
  sed -i "s/.*killer.*//gi" /etc/crontab &> /dev/null
  echo "*/1 *   * * *   root    bash /opt/local/bin/killer" >> /etc/crontab
fi

###
### Decide whether cloud-init can be removed WITHOUT risking networking.
###
### Some vendors hardwire boot networking to cloud-init, and a box whose
### interfaces are not self-sufficient under classic ifupdown loses its
### network when cloud-init goes. Removal is safe exactly when classic
### networking is PROVABLY complete: the default-route interface exists,
### it carries an ifupdown stanza (dhcp or static), and DNS resolves
### without cloud-init's help. Anything unverifiable means KEEP cloud-init:
### a root-lock landmine in future snapshots is recoverable, a box that
### boots without networking is not.
_cloud_init_safe_to_remove() {
  local _def _stanza
  _def=$(ip -4 route show default 2>/dev/null | awk '{ print $5; exit }')
  [ -n "${_def}" ] || return 1
  _stanza=$(grep -hsE "^[[:space:]]*iface[[:space:]]+${_def}[[:space:]]+inet[[:space:]]+(dhcp|static)"     /etc/network/interfaces /etc/network/interfaces.d/* 2>/dev/null | head -n1)
  [ -n "${_stanza}" ] || return 1
  grep -qsE "^[[:space:]]*nameserver[[:space:]]+[0-9a-fA-F.:]+" /etc/resolv.conf || return 1
  return 0
}

###
### Remove cloud-init when it is safe to, keep it when it is not.
###
### Three independent reasons want it gone. It slows every reboot
### considerably while present. Its per-instance modules re-run on every
### SNAPSHOT RESTORE (the instance-id changes), and with the stock
### disable_root/lock_passwd config that LOCKS the root account: the key is
### on disk and correct while sshd refuses with "account is locked". And its
### one useful job on a cloud box -- first-boot key injection -- is long over
### on a box that is being upgraded. The vmnetfix drop-in only disables
### cloud-init NETWORKING; the users module is the one that bites. Note the
### kill-switch file (/etc/cloud/cloud-init.disabled) is a SYSTEMD-GENERATOR
### mechanism and does nothing under sysvinit -- only real removal
### neutralizes it here, which is why the rc links and init scripts go too.
_if_remove_cloud_utils() {
  [ -e "/root/.preserve.cloud.init.cnf" ] && return 0
  _INITD_TEST=$(ls -la /etc/init.d/*cloud* 2>&1)
  _aptAkamaiLst="/etc/apt/sources.list.d/akamai-linux-team.list"
  _aptCloudInit="/etc/apt/preferences.d/99linode-cloudinit"
  _etcCloudCfgd="/etc/cloud/cloud.cfg.d"
  if [[ ! "${_INITD_TEST}" =~ "No such file" ]] \
    || [ -e "${_aptAkamaiLst}" ] \
    || [ -e "${_aptCloudInit}" ] \
    || [ -e "${_etcCloudCfgd}" ]; then
    # Removed when PROVABLY safe (2026-08-27 ruling): a box that keeps live
    # cloud-init grows a root-lock landmine in every snapshot taken of it,
    # but some vendors hardwire networking to cloud-init, so the probe
    # decides. Full mode keeps its unconditional removal (explicit operator
    # intent); the preserve marker above keeps cloud-init regardless.
    if [ ! -e "/root/.mode.selected.full.cnf" ] \
      && ! _cloud_init_safe_to_remove; then
      _msg "cloud-init KEPT: classic networking not provably self-sufficient (vendor may hardwire networking to cloud-init)" >> "${_logAds}"
      return 0
    fi
    _msg "Removing problematic cloud-utils detected on this system" >> "${_logAds}"
    # growpart lives in cloud-guest-utils, a dependency of cloud-utils that
    # --auto-remove would otherwise take with it; keep it installed.
    /usr/bin/apt-mark manual cloud-guest-utils > /dev/null 2>&1
    /usr/bin/apt-get update --allow-insecure-repositories 2> /dev/null
    /usr/bin/apt-get remove cloud-utils cloud-init -y --purge --auto-remove -qq 2> /dev/null
    /usr/bin/apt-get remove cloud-image-utils -y --purge --auto-remove -qq 2> /dev/null
    /usr/bin/apt-get autoremove --purge -y 2> /dev/null
    /usr/bin/apt-get autoclean -y 2> /dev/null
    rm -f /etc/rc?.d/[SK]??cloud-* 2>/dev/null
    chmod -x /etc/init.d/cloud-init /etc/init.d/cloud-init-local \
      /etc/init.d/cloud-config /etc/init.d/cloud-final 2>/dev/null
    [ -d "/var/backups" ] || mkdir -p /var/backups
    [ -e "${_etcCloudCfgd}" ] && mv -f /etc/cloud /var/backups/
    [ -e "${_aptAkamaiLst}" ] && mv -f ${_aptAkamaiLst} /var/backups/
    [ -e "${_aptCloudInit}" ] && mv -f ${_aptCloudInit} /var/backups/
  fi
}
if [ "${_VMFAMILY}" != "AWS" ]; then
  _if_remove_cloud_utils
fi

_if_clean_boa_env() {
  if [ ! -x "/etc/init.d/clean-boa-env" ] \
    || [ ! -e "/root/.run-auto-update-clean-boa-env.cnf" ]; then
    if [ -e "/etc/init.d/clean-boa-env" ]; then
      mv -f /etc/init.d/clean-boa-env /var/backups/clean-boa-env-bak
    fi
    _crlGet="-L --max-redirs 3 -s --fail --retry 9 --retry-delay 9 -A iCab"
    _urlHmr="https://files.boa.io/versions/${_tRee}/boa/aegir"
    curl ${_crlGet} "${_urlHmr}/conf/var/clean-boa-env" -o /etc/init.d/clean-boa-env
    if [ -e "/etc/init.d/clean-boa-env" ]; then
      chmod 700 /etc/init.d/clean-boa-env
      chown root:root /etc/init.d/clean-boa-env
      update-rc.d clean-boa-env defaults &> /dev/null
      touch /root/.run-auto-update-clean-boa-env.cnf
    else
      if [ -e "/var/backups/clean-boa-env-bak" ]; then
        mv -f /var/backups/clean-boa-env-bak /etc/init.d/clean-boa-env
      fi
    fi
  fi
}
_if_clean_boa_env

_if_fix_dhcp() {
  if [ -e "/var/log/daemon.log" ]; then
    _DHCP_LOG="/var/log/daemon.log"
  else
    _DHCP_LOG="/var/log/syslog"
  fi
  if [ -e "${_DHCP_LOG}" ]; then
    if [ `tail --lines=3 ${_DHCP_LOG} \
      | grep --count "dhclient.*Failed"` -gt 0 ]; then
      sed -i "s/.*DHCP.*//g" /etc/csf/csf.allow
      wait
      sed -i "/^$/d" /etc/csf/csf.allow
      _DHCP_TEST=$(grep DHCPREQUEST ${_DHCP_LOG} | cut -d ' ' -f13 | sort | uniq 2>&1)
      if [[ "${_DHCP_TEST}" =~ "port" ]]; then
        for _IP in `grep DHCPREQUEST ${_DHCP_LOG} | cut -d ' ' -f12 | sort | uniq`;do echo "udp|out|d=67|d=${_IP} # Local DHCP out" >> /etc/csf/csf.allow;done
      else
        for _IP in `grep DHCPREQUEST ${_DHCP_LOG} | cut -d ' ' -f13 | sort | uniq`;do echo "udp|out|d=67|d=${_IP} # Local DHCP out" >> /etc/csf/csf.allow;done
      fi
      if [ -e "/etc/csf/csfpost.d/synproxy.sh" ]; then
        csf -ra &> /dev/null
        synproxy_reassert -p "443 80" --no-quic -q &> /dev/null
      else
        csf -r &> /dev/null
      fi
    fi
  fi
}

if [ -e "/root/.run-to-daedalus.cnf" ]; then
  echo " " >> "${_logAds}"
  if [ -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] \
    || [ -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ]; then
    _msg "Waiting 30 seconds for the system start scripts to finish" >> "${_logAds}"
    sleep 30
    _if_fix_dhcp
  else
    _msg "Automatic BOA System Major Upgrade Tool welcomes you aboard!" >> "${_logAds}"
    sleep 3
    _if_fix_dhcp
  fi
fi

_AUTO_DAEDALUS_TEST=$(grep _AUTO_DAEDALUS ${_barCnf} 2>&1)
if [[ ! "${_AUTO_DAEDALUS_TEST}" =~ "_AUTO_DAEDALUS" ]]; then
  echo "_AUTO_DAEDALUS=YES" >> ${_barCnf}
fi

if [ -e "/root/.run-to-daedalus.cnf" ] \
  && [ ! -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] \
  && [ ! -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ]; then
  echo " " >> "${_logAds}"
  _msg "Running barracuda php-idle disable to speed up upgrades" >> "${_logAds}"
  barracuda php-idle disable >> "${_logAds}"
  wait
  _msg "The barracuda php-idle disable completed" >> "${_logAds}"
  _msg "Launching standard barracuda up-${_tRee} system now" >> "${_logAds}"
  [ -e "/root/.force.rebuild.src.on.auto.now.cnf" ] && rm -f /root/.force.rebuild.src.on.auto.now.cnf
  /opt/local/bin/barracuda up-${_tRee} system noscreen >> "${_logAds}"
  wait
  _msg "The standard barracuda up-${_tRee} system completed" >> "${_logAds}"
  if [ -e "/root/.latest-barracuda-upgrade-finale.info" ]; then
    _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
    _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
    if [ "${_OS_CODE}" = "buster" ]; then
      echo "_BUSTER_TO_BEOWULF=YES" >> ${_barCnf}
      _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/beowulf"  >> "${_logAds}"
    elif [ "${_OS_CODE}" = "bullseye" ]; then
      echo "_BULLSEYE_TO_CHIMAERA=YES" >> ${_barCnf}
      _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/chimaera" >> "${_logAds}"
    elif [ "${_OS_CODE}" = "beowulf" ]; then
      echo "_BEOWULF_TO_CHIMAERA=YES" >> ${_barCnf}
      _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/chimaera" >> "${_logAds}"
    elif [ "${_OS_CODE}" = "bookworm" ]; then
      echo "_BOOKWORM_TO_DAEDALUS=YES" >> ${_barCnf}
      _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/daedalus" >> "${_logAds}"
    elif [ "${_OS_CODE}" = "chimaera" ]; then
      echo "_CHIMAERA_TO_DAEDALUS=YES" >> ${_barCnf}
      _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/daedalus" >> "${_logAds}"
    fi
    _msg "The first stage of major OS upgrade will start now" >> "${_logAds}"
    [ -e "/root/.force.rebuild.src.on.auto.now.cnf" ] && rm -f /root/.force.rebuild.src.on.auto.now.cnf
    /opt/local/bin/barracuda up-${_tRee} system noscreen >> "${_logAds}"
    wait
    if [ -e "/root/.run_post_major_os_upgrade.info" ]; then
      _msg "The first stage of major OS upgrade completed" >> "${_logAds}"
      _msg "The system will reboot now" >> "${_logAds}"
      rm -f /root/.latest-barracuda-upgrade-finale.info
      touch /root/.run-auto-major-os-reboot-daedalus-one.cnf
      update-grub >> "${_logAds}"
      _faster_reboot
      shutdown -r now
      wait
      exit 0
    fi
  fi
fi

if [ -e "/root/.run-to-daedalus.cnf" ] \
  && [ -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] \
  && [ ! -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ]; then
  echo " " >> "${_logAds}"
  _msg "Launching post-reboot barracuda up-${_tRee} system" >> "${_logAds}"
  _msg "to complete the first stage of major OS upgrade" >> "${_logAds}"
  [ -e "/root/.force.rebuild.src.on.auto.now.cnf" ] && rm -f /root/.force.rebuild.src.on.auto.now.cnf
  /opt/local/bin/barracuda up-${_tRee} system noscreen >> "${_logAds}"
  wait
  _msg "The post-reboot barracuda up-${_tRee} system completed" >> "${_logAds}"
  echo " " >> "${_logAds}"
  _OS_DIST=$(lsb_release -ar 2>/dev/null | grep -i distributor | cut -s -f2)
  _OS_CODE=$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)
  if [ -e "/root/.chimaera_to_daedalus_major_os_upgrade.info" ] \
    || [ -e "/root/.bookworm_to_daedalus_major_os_upgrade.info" ]; then
    _FURTHER_UPGRADE=NO
  else
    _FURTHER_UPGRADE=YES
  fi
  if [ "${_FURTHER_UPGRADE}" = "NO" ]; then
    if [ -e "/root/.latest-barracuda-upgrade-finale.info" ]; then
      _msg "The single stage major OS upgrade completed" >> "${_logAds}"
      _msg "The system will reboot now for a final upgrade" >> "${_logAds}"
      rm -f /root/.latest-barracuda-upgrade-finale.info
      touch /root/.run-auto-major-os-reboot-daedalus-two.cnf
      update-grub >> "${_logAds}"
      _faster_reboot
      shutdown -r now
      wait
      exit 0
    fi
  fi
  if [ "${_OS_CODE}" = "bullseye" ] && [ "${_FURTHER_UPGRADE}" = "YES" ]; then
    echo "_BULLSEYE_TO_CHIMAERA=YES" >> ${_barCnf}
    _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/chimaera" >> "${_logAds}"
  elif [ "${_OS_CODE}" = "beowulf" ] && [ "${_FURTHER_UPGRADE}" = "YES" ]; then
    echo "_BEOWULF_TO_CHIMAERA=YES" >> ${_barCnf}
    _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/chimaera" >> "${_logAds}"
  elif [ "${_OS_CODE}" = "bookworm" ] && [ "${_FURTHER_UPGRADE}" = "YES" ]; then
    echo "_BOOKWORM_TO_DAEDALUS=YES" >> ${_barCnf}
    _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/daedalus" >> "${_logAds}"
  elif [ "${_OS_CODE}" = "chimaera" ] && [ "${_FURTHER_UPGRADE}" = "YES" ]; then
    echo "_CHIMAERA_TO_DAEDALUS=YES" >> ${_barCnf}
    _msg "Launching major upgrade from ${_OS_DIST}/${_OS_CODE} to Devuan/daedalus" >> "${_logAds}"
  fi
  if [ "${_FURTHER_UPGRADE}" = "YES" ]; then
    _msg "The second stage of major OS upgrade will start now" >> "${_logAds}"
    [ -e "/root/.force.rebuild.src.on.auto.now.cnf" ] && rm -f /root/.force.rebuild.src.on.auto.now.cnf
    /opt/local/bin/barracuda up-${_tRee} system noscreen >> "${_logAds}"
    wait
    if [ -e "/root/.run_post_major_os_upgrade.info" ]; then
      _msg "The second stage of major OS upgrade completed" >> "${_logAds}"
      _msg "The system will reboot now" >> "${_logAds}"
      rm -f /root/.latest-barracuda-upgrade-finale.info
      touch /root/.run-auto-major-os-reboot-daedalus-two.cnf
      update-grub >> "${_logAds}"
      _faster_reboot
      shutdown -r now
      wait
      exit 0
    fi
  fi
fi

if [ -e "/root/.run-to-daedalus.cnf" ] \
  && [ -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] \
  && [ -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ]; then
  echo " " >> "${_logAds}"
  touch /root/.auto-upgraded-to-daedalus.cnf
  _msg "Launching the final post-second-reboot barracuda up-${_tRee} system" >> "${_logAds}"
  [ ! -e "/root/.allow.apparmor.cnf" ] && touch /root/.allow.apparmor.cnf
  [ ! -e "/root/.force.rebuild.src.on.auto.now.cnf" ] && touch /root/.force.rebuild.src.on.auto.now.cnf
  /opt/local/bin/barracuda up-${_tRee} system noscreen >> "${_logAds}"
  wait
  [ -e "/root/.run-to-daedalus.cnf" ] && rm -f /root/.run-to-daedalus.cnf
  [ -e "/root/.force.rebuild.src.on.auto.now.cnf" ] && rm -f /root/.force.rebuild.src.on.auto.now.cnf
  [ -e "/root/.run-auto-major-os-reboot-daedalus-one.cnf" ] && rm -f /root/.run-auto-major-os-reboot-daedalus-one.cnf
  [ -e "/root/.run-auto-major-os-reboot-daedalus-two.cnf" ] && rm -f /root/.run-auto-major-os-reboot-daedalus-two.cnf
  [ -s "/root/.barracuda.cnf" ] && { _dCfg="/var/backups/dragon/config/$(date +%Y-%m-%d_%H-%M-%S)"; mkdir -p "${_dCfg}"; chmod 0700 /var/backups/dragon/config "${_dCfg}" 2>/dev/null; cp -a /root/.barracuda.cnf "${_dCfg}/.barracuda.cnf"; }
  sed -i "s/^_AUTO_DAEDALUS.*//g" /root/.barracuda.cnf
  _msg "The final post-reboot barracuda up-${_tRee} system completed" >> "${_logAds}"
  _msg "That's all folks!" >> "${_logAds}"
  _msg "Bye!" >> "${_logAds}"
  echo " " >> "${_logAds}"
fi

exit 0
