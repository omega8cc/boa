#!/bin/bash

#
# Purpose:
#   Fix group writable permissions on an entire codebase (app root) and its Git metadata,
#   while preserving safe execute bits and ensuring setgid on directories for group inheritance.
#
# Usage:
#   fixrepo /path/to/codebase
#
# Example:
#   fixrepo /data/disk/o1/static/live/drupal_v11_2026
#
# Notes:
#   - Designed for shared workflows (e.g. o1 + o1.ftp in the same group).
#   - Applies to the whole codebase and explicitly to .git when present.
#   - Sets git core.sharedRepository=group (best effort, as the repo owner).
#   - Uses g+rwX (capital X) so regular non-executable files do not become executable.
#   - Refuses paths outside /data/disk/<user>/, /var/aegir/, /var/www/, /home/<user>/.
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_DEBUG_MODE="${_DEBUG_MODE:-NO}"
_STRICT_MODE="${_STRICT_MODE:-YES}"

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

_msg() {
  if [ "${_DEBUG_MODE}" = "YES" ]; then
    printf '%s\n' "$*"
  fi
}

_die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

_usage() {
  cat <<'EOF'
Usage:
  fixrepo /absolute/or/relative/path/to/codebase

Description:
  Fixes group-writable permissions recursively on the codebase root, ensures setgid on
  all directories, and (if present) explicitly fixes .git internals and sets:
    git config core.sharedRepository group
  Only paths inside /data/disk/<user>/, /var/aegir/, /var/www/ or /home/<user>/ are
  accepted; anything else is refused before any change is made.

Environment (optional):
  _DEBUG_MODE=YES   Enable verbose progress messages
  _STRICT_MODE=NO   Continue on non-fatal chmod/find errors (default: YES)
EOF
}

_require_cmd() {
  _CMD="${1}"
  command -v "${_CMD}" >/dev/null 2>&1 || _die "Required command not found: ${_CMD}"
}

_run_cmd() {
  # Wrapper to optionally continue on non-fatal errors.
  # Usage: _run_cmd "description" command arg1 arg2 ...
  _DESC="${1}"
  shift

  _msg "==> ${_DESC}"
  "$@"
  _RC=$?

  if [ "${_RC}" -ne 0 ]; then
    if [ "${_STRICT_MODE}" = "YES" ]; then
      _die "${_DESC} failed (exit code: ${_RC})"
    else
      printf 'WARNING: %s failed (exit code: %s)\n' "${_DESC}" "${_RC}" >&2
    fi
  fi

  return 0
}

_fix_permissions_tree() {
  _TARGET_DIR="${1}"

  [ -n "${_TARGET_DIR}" ] || return 1
  # chmod -R below follows a symlink given AS ITS ARGUMENT (it only refuses
  # ones met during the walk), so never hand it one: [ -d ] alone is true for
  # a symlink to a directory.
  [ -L "${_TARGET_DIR}" ] && return 1
  [ -d "${_TARGET_DIR}" ] || return 1

  _msg "Processing tree: ${_TARGET_DIR}"

  # Add group read/write to all files and dirs; add execute only to dirs and already executable files.
  _run_cmd "chmod -R g+rwX on ${_TARGET_DIR}" chmod -R g+rwX "${_TARGET_DIR}"

  # Ensure all directories are group-traversable, writable, and setgid so new files inherit group.
  _run_cmd "setgid on directories in ${_TARGET_DIR}" \
    find "${_TARGET_DIR}" -type d -exec chmod g+rws {} +

  return 0
}

_set_git_shared_mode() {
  _REPO_ROOT="${1}"

  [ -n "${_REPO_ROOT}" ] || return 1
  [ -d "${_REPO_ROOT}" ] || return 1
  [ -d "${_REPO_ROOT}/.git" ] || return 0

  if ! command -v git >/dev/null 2>&1; then
    printf 'WARNING: git not found; skipped core.sharedRepository setting for %s\n' "${_REPO_ROOT}" >&2
    return 0
  fi

  # Run git as the repo owner: git refuses cross-owner repos ("dubious
  # ownership"), and a root-run config rewrite would leave .git/config
  # root-owned. Best effort by design -- a failure warns, never aborts.
  _GIT_OWNER="$(stat -c %U "${_REPO_ROOT}/.git" 2>/dev/null)"
  if [ -n "${_GIT_OWNER}" ] && [ "${_GIT_OWNER}" != "root" ] \
    && id -u "${_GIT_OWNER}" >/dev/null 2>&1; then
    _msg "==> git core.sharedRepository=group in ${_REPO_ROOT} (as ${_GIT_OWNER})"
    su -s /bin/bash "${_GIT_OWNER}" -c "git -C '${_REPO_ROOT}' config core.sharedRepository group"
  else
    _msg "==> git core.sharedRepository=group in ${_REPO_ROOT}"
    git -C "${_REPO_ROOT}" config core.sharedRepository group
  fi
  if [ $? -ne 0 ]; then
    printf 'WARNING: could not set core.sharedRepository=group in %s\n' "${_REPO_ROOT}" >&2
  fi

  return 0
}

_show_summary() {
  _REPO_ROOT="${1}"

  printf '\nDone.\n'
  printf 'Codebase fixed: %s\n' "${_REPO_ROOT}"

  if [ -d "${_REPO_ROOT}/.git" ] && [ ! -L "${_REPO_ROOT}/.git" ]; then
    printf 'Git metadata fixed: %s/.git\n' "${_REPO_ROOT}"
    if command -v git >/dev/null 2>&1; then
      # --file skips repo discovery, so root can read it on any-owner repos.
      _GIT_SHARED="$(git config --file "${_REPO_ROOT}/.git/config" --get core.sharedRepository 2>/dev/null)"
      if [ -n "${_GIT_SHARED}" ]; then
        printf 'git core.sharedRepository: %s\n' "${_GIT_SHARED}"
      fi
    fi
  elif [ -e "${_REPO_ROOT}/.git" ]; then
    printf '.git exists but is not a directory (worktree or submodule checkout?); Git-specific steps skipped.\n'
  else
    printf 'No .git directory detected (skipped Git-specific steps).\n'
  fi

  cat <<'EOF'

Recommended for shared write operations (shell/session):
  umask 002

This helps new files remain group-writable together with setgid directories.
EOF
}

_main() {
  if [ "${#}" -ne 1 ]; then
    _usage
    exit 1
  fi

  _REPO_ROOT="${1}"

  [ "${_REPO_ROOT}" = "-h" ] && { _usage; exit 0; }
  [ "${_REPO_ROOT}" = "--help" ] && { _usage; exit 0; }

  _require_cmd chmod
  _require_cmd find

  [ -e "${_REPO_ROOT}" ] || _die "Path does not exist: ${_REPO_ROOT}"
  [ -d "${_REPO_ROOT}" ] || _die "Path is not a directory: ${_REPO_ROOT}"

  # Resolve to an absolute physical path; the scope guard below must see the
  # real target, not a relative path or a symlink alias.
  _GIVEN="$(CDPATH= cd -- "${_REPO_ROOT}" 2>/dev/null && pwd)"
  _RESOLVED="$(readlink -f "${_REPO_ROOT}" 2>/dev/null)"
  if [ -z "${_RESOLVED}" ] || [ ! -d "${_RESOLVED}" ]; then
    _RESOLVED="$(CDPATH= cd -- "${_REPO_ROOT}" 2>/dev/null && pwd -P)"
  fi
  if [ -n "${_RESOLVED}" ] && [ -d "${_RESOLVED}" ]; then
    _REPO_ROOT="${_RESOLVED}"
  else
    _die "Cannot resolve path: ${_REPO_ROOT}"
  fi

  # Every component of the argument sits in a tenant-writable tree (~/static is
  # 02775, group-writable by the account's shell identities; an lshell home owns
  # its own sites/static links), so an alias
  # can be re-pointed at another account or at /var/aegir between operator runs
  # and this root chmod would then open THAT tree instead -- the allowlist below
  # spans every account and cannot tell the difference. Refuse a target reached
  # through a symlink unless the operator has seen where it really goes.
  # BOA's own home links are how an operator reaches a tenant codebase --
  # /home/<oN>.ftp/static -> ~oN/static (satellite.sh.inc:4386), backups and
  # clients likewise, /home/<ltd>/sites -> ~oN/clients/<client>
  # (manage_ltd_users.sh:784) -- and the allowlist below advertises /home/*.
  # So do not refuse a symlinked target outright: always SHOW where it really
  # went (the summary only says so after the chmod), and refuse only a
  # resolution that CROSSES accounts or reaches /var/aegir from outside it.
  _acct_seg() {
    case "$1" in
      /data/disk/*/*) printf '%s' "${1#/data/disk/}" | cut -d/ -f1 ;;
      *)              printf '' ;;
    esac
  }
  if [ -n "${_GIVEN}" ] && [ "${_GIVEN}" != "${_REPO_ROOT}" ]; then
    printf 'Note: %s resolves to %s\n' "${_GIVEN}" "${_REPO_ROOT}"
    _GIVEN_ACCT="$(_acct_seg "${_GIVEN}")"
    _REAL_ACCT="$(_acct_seg "${_REPO_ROOT}")"
    if [ "${_ALLOW_SYMLINKED_TARGET:-NO}" != "YES" ]; then
      if [ -n "${_GIVEN_ACCT}" ] && [ "${_GIVEN_ACCT}" != "${_REAL_ACCT}" ]; then
        _die "Refusing ${_GIVEN}; it resolves into a different account (${_REPO_ROOT})"
      fi
      case "${_GIVEN}" in
        /var/aegir/*) : ;;
        *)
          case "${_REPO_ROOT}/" in
            /var/aegir/*) _die "Refusing ${_GIVEN}; it resolves into /var/aegir (${_REPO_ROOT})" ;;
          esac
          ;;
      esac
    fi
  fi

  # Scope guard: a recursive chmod as root must never run outside the trees
  # that hold codebases -- a typo like / or /etc would loosen system files
  # box-wide. Same allowlist idea as fix-drupal-platform-permissions.sh, plus
  # /var/www, and at least one level below each allowed base.
  # Account credential stores, not codebases: g+rwX there hands the account's
  # shell identities -- every box user while the instance still carries the
  # box-wide 'users' group -- the tenant's DB aliases and pass.txt. Anchor on the
  # FIRST segment under the account -- "*" matches "/" in a case pattern, so
  # /data/disk/*/log would also refuse a codebase's own log/ subdirectory.
  case "${_REPO_ROOT}" in
    /var/aegir/.drush|/var/aegir/.drush/*|/var/aegir/.ssh|/var/aegir/.ssh/*)
      _die "Refusing ${_REPO_ROOT}; it is a credential store, not a codebase"
      ;;
    /data/disk/*)
      _SUB="${_REPO_ROOT#/data/disk/}"
      case "${_SUB}" in
        */*) _SUB="${_SUB#*/}" ;;
        *)   _SUB="" ;;
      esac
      case "${_SUB}" in
        .drush|.drush/*|.ssh|.ssh/*|log|log/*)
          _die "Refusing ${_REPO_ROOT}; it is a credential store, not a codebase"
          ;;
      esac
      ;;
  esac

  case "${_REPO_ROOT}" in
    /data/disk/*/?*|/var/aegir/?*|/var/www/?*|/home/*/?*)
      ;;
    *)
      _die "Refusing ${_REPO_ROOT}; allowed: /data/disk/<user>/..., /var/aegir/..., /var/www/..., /home/<user>/..."
      ;;
  esac

  # The .git step interpolates this path into a su -c command string; a single
  # quote in it would break out of that command. No codebase path needs one.
  case "${_REPO_ROOT}" in
    *\'*) _die "Refusing ${_REPO_ROOT}; path contains a single quote" ;;
  esac

  _msg "Target codebase root: ${_REPO_ROOT}"
  _msg "STRICT_MODE=${_STRICT_MODE}"
  _msg "DEBUG_MODE=${_DEBUG_MODE}"

  # Fix whole codebase tree first.
  _fix_permissions_tree "${_REPO_ROOT}" || _die "Failed to fix codebase permissions"

  # Explicitly fix .git tree too (clarity + robustness in shared workflows).
  # .git is a name a tenant can plant in the group-writable codebase root
  # (~/static is 02775 and group-writable), and chmod -R DOES follow a symlink handed to
  # it as its argument -- it only refuses ones met during the walk -- so a
  # planted .git -> / would loosen the whole box. A symlinked .git is never
  # legitimate here; skip it, the tree pass above already covered everything
  # that really lives in the tree.
  if [ -L "${_REPO_ROOT}/.git" ]; then
    printf 'WARNING: %s/.git is a symlink; Git-specific steps skipped.\n' "${_REPO_ROOT}" >&2
  elif [ -d "${_REPO_ROOT}/.git" ]; then
    _set_git_shared_mode "${_REPO_ROOT}"
    _fix_permissions_tree "${_REPO_ROOT}/.git" || _die "Failed to fix .git permissions"
  fi

  _show_summary "${_REPO_ROOT}"
}

_main "$@"

exit 0
