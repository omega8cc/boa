#!/bin/bash

#
# Keep SYNPROXY/NOTRACK ordering correct after any CSF change; optional QUIC mgmt.
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

set -u

# ---- defaults (override via flags/env) ----
_TCP_PORTS="${_TCP_PORTS:-443 80}"
_QUIC_PORT="${_QUIC_PORT:-443}"        # set empty to skip QUIC mgmt entirely
_ENABLE_QUIC_LIMITER="${_ENABLE_QUIC_LIMITER:-NO}"     # default OFF to avoid surprises
_REBUILD_CHAIN="${_REBUILD_CHAIN:-YES}"                # YES -> flush SYNPROXY_EARLY first
_TRUSTED_SRC="${_TRUSTED_SRC:-}"       # e.g. "203.0.113.0/24 198.51.100.10/32"
_RATE_PER_IP="${_RATE_PER_IP:-80/second}"
_BURST_PER_IP="${_BURST_PER_IP:-160}"
_RATE_PER_24="${_RATE_PER_24:-800/second}"
_BURST_PER_24="${_BURST_PER_24:-1600}"
_QUIET="${_QUIET:-NO}"
_VERBOSE="${_VERBOSE:-NO}"

# ---- logging ----
_msg(){ [ "${_QUIET}" = "YES" ] && return 0; echo "[REASSERT] $*"; }
_v(){ [ "${_VERBOSE}" = "YES" ] && _msg "$@"; }

# ---- args ----
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--ports)        _TCP_PORTS="$2"; shift 2;;
    --quic-port)       _QUIC_PORT="$2"; shift 2;;
    --no-quic)         _ENABLE_QUIC_LIMITER="NO"; shift 1;;
    --rate-ip)         _RATE_PER_IP="$2"; shift 2;;
    --burst-ip)        _BURST_PER_IP="$2"; shift 2;;
    --rate-24)         _RATE_PER_24="$2"; shift 2;;
    --burst-24)        _BURST_PER_24="$2"; shift 2;;
    --rebuild-chain)   _REBUILD_CHAIN="YES"; shift 1;;
    --no-rebuild)      _REBUILD_CHAIN="NO"; shift 1;;
    --trust)           _TRUSTED_SRC="${2:-}"; shift 2;;
    -q|--quiet)        _QUIET="YES"; _VERBOSE="NO"; shift 1;;
    -v|--verbose)      _VERBOSE="YES"; _QUIET="NO"; shift 1;;
    -h|--help)
      cat <<USAGE
Usage: synproxy_reassert [options]
  -p, --ports "443 80"      TCP ports to protect (default: "443 80")
      --quic-port 443       QUIC UDP port (default: 443)
      --no-quic             Disable QUIC limiter AND purge any existing QUIC rules
      --rate-ip X/second    Per-IP QUIC rate (default: 80/second)
      --burst-ip N          Per-IP QUIC burst (default: 160)
      --rate-24 X/second    Per-/24 QUIC rate (default: 800/second)
      --burst-24 N          Per-/24 QUIC burst (default: 1600)
      --rebuild-chain       Flush & rebuild SYNPROXY_EARLY (default)
      --no-rebuild          Ensure-only (no flush)
      --trust "CIDR ..."    Bypass SYNPROXY for these sources (optional)
  -q, --quiet               Minimal output
  -v, --verbose             Extra output
Examples:
  synproxy_reassert -p "443" --quic-port 443 -v
  synproxy_reassert -p "443 80" --no-quic -q
USAGE
      exit 0;;
    *) _msg "Unknown option: $1"; exit 2;;
  esac
done

# ---- tools/wrappers ----
command -v iptables >/dev/null 2>&1 || { _msg "iptables not found"; exit 0; }
command -v modprobe >/dev/null 2>&1 || true
_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

# ---- modules (best-effort) ----
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
modprobe nf_synproxy_core 2>/dev/null || true
modprobe xt_hashlimit 2>/dev/null || true

# ---- helpers ----
_del_specs_from_INPUT(){
  local _pat="$1" _line _spec
  while :; do
    _line="$({ iptables -S INPUT 2>/dev/null || true; } | grep -E -- "${_pat}" | head -n1 || true)"
    [ -n "${_line}" ] || break
    _spec="${_line#-A INPUT }"
    _ipt -D INPUT ${_spec} 2>/dev/null || break
  done
}

_purge_quic_rules(){
  [ -n "${_QUIC_PORT}" ] || return 0
  local _p="${_QUIC_PORT}"
  # Remove our hashlimit rules (any order)
  _del_specs_from_INPUT "-p udp .*--dport ${_p} .*hashlimit-name quic${_p}_ip"
  _del_specs_from_INPUT "-p udp .*--dport ${_p} .*hashlimit-name quic${_p}_24"
  # Remove ANY UDP/${_p} INVALID drop (conntrack or state module)
  _del_specs_from_INPUT "-p udp .*--dport ${_p} .* (-m conntrack --ctstate INVALID|-m state --state INVALID) .* -j DROP"
}

_ensure_quic_limits(){
  [ -n "${_QUIC_PORT}" ] || return 0
  if [ "${_ENABLE_QUIC_LIMITER}" != "YES" ]; then
    _purge_quic_rules
    _v "INPUT: QUIC limiter disabled; rules purged for UDP:${_QUIC_PORT}"
    return 0
  fi
  local _p="${_QUIC_PORT}"
  _purge_quic_rules
  # Canonical order at the very top
  _ipt -I INPUT 1 -p udp --dport "${_p}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
  _ipt -I INPUT 1 -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_ip \
      --hashlimit-above "${_RATE_PER_IP}" --hashlimit-burst "${_BURST_PER_IP}" \
      --hashlimit-mode srcip --hashlimit-htable-expire 60000 -j DROP 2>/dev/null || true
  _ipt -I INPUT 1 -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_24 \
      --hashlimit-above "${_RATE_PER_24}" --hashlimit-burst "${_BURST_PER_24}" \
      --hashlimit-mode srcip --hashlimit-srcmask 24 --hashlimit-htable-expire 60000 -j DROP 2>/dev/null || true
}

_ensure_notrack(){
  local _port="$1"
  while _ipt -t raw -C PREROUTING -p tcp --syn --dport "${_port}" -j CT --notrack 2>/dev/null; do
    _ipt -t raw -D PREROUTING -p tcp --syn --dport "${_port}" -j CT --notrack 2>/dev/null || break
  done
  while _ipt -t raw -C PREROUTING -p tcp --syn --dport "${_port}" -j NOTRACK 2>/dev/null; do
    _ipt -t raw -D PREROUTING -p tcp --syn --dport "${_port}" -j NOTRACK 2>/dev/null || break
  done
  _ipt -t raw -I PREROUTING 1 -p tcp --syn --dport "${_port}" -j CT --notrack 2>/dev/null || true
  _v "raw: CT --notrack for :${_port}"
}

_pin_early_jump(){
  _chain_exists SYNPROXY_EARLY || _ipt -N SYNPROXY_EARLY 2>/dev/null || true
  while _ipt -C INPUT -j SYNPROXY_EARLY 2>/dev/null; do _ipt -D INPUT -j SYNPROXY_EARLY 2>/dev/null || break; done
  _ipt -I INPUT 1 -j SYNPROXY_EARLY 2>/dev/null || true
  if _chain_exists LOCALINPUT; then
    while _ipt -C LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null; do _ipt -D LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null || break; done
    _ipt -I LOCALINPUT 1 -j SYNPROXY_EARLY 2>/dev/null || true
  fi
}

_purge_legacy_rules(){
  # Remove any old NEW->DROP or old “NEW !SYN -> ACCEPT” shims we previously created
  local _line _spec
  while :; do
    _line="$({ iptables -S SYNPROXY_EARLY 2>/dev/null || true; } | grep -E -- '-m state --state NEW .* --dport [0-9]+ .* -j (DROP|ACCEPT)' | head -n1 || true)"
    [ -n "${_line}" ] || break
    _spec="${_line#-A SYNPROXY_EARLY }"
    _ipt -D SYNPROXY_EARLY ${_spec} 2>/dev/null || break
  done
}

_populate_early_chain(){
  # (a) bypass lo/trusted → (b) EST/REL → (c) UNTRACKED+SYN SYNPROXY
  # (d) NEW+SYN SYNPROXY → (e) ACK-only NEW accept → (f) INVALID drop
  [ "${_REBUILD_CHAIN}" = "YES" ] && _ipt -F SYNPROXY_EARLY 2>/dev/null || true

  # (a) bypasses: loopback + optional trusted sources
  _ipt -C SYNPROXY_EARLY -i lo -j RETURN 2>/dev/null || _ipt -I SYNPROXY_EARLY 1 -i lo -j RETURN
  if [ -n "${_TRUSTED_SRC}" ]; then
    for _cidr in ${_TRUSTED_SRC}; do
      _ipt -C SYNPROXY_EARLY -s "${_cidr}" -j RETURN 2>/dev/null || _ipt -I SYNPROXY_EARLY 2 -s "${_cidr}" -j RETURN
    done
  fi

  # (b) established
  _ipt -C SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true

  local _p
  for _p in ${_TCP_PORTS}; do
    # (c) UNTRACKED+SYN
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -m conntrack --ctstate UNTRACKED \
      -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null \
      || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -m conntrack --ctstate UNTRACKED \
         -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
    # (d) NEW+SYN
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -m conntrack --ctstate NEW \
      -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null \
      || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -m conntrack --ctstate NEW \
         -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss 1460 2>/dev/null || true
    # (e) ACK-only NEW (final ACK of TCP 3WHS)
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags SYN,RST,ACK ACK -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null \
      || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags SYN,RST,ACK ACK -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null || true
  done

  # (f) INVALID drop
  _ipt -C SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true

  _purge_legacy_rules
}

# ---------- do the work ----------
_msg "Reassert SYNPROXY/NOTRACK; QUIC: $([ "${_ENABLE_QUIC_LIMITER}" = "YES" ] && echo "enabled on ${_QUIC_PORT}" || echo "disabled") (ports: ${_TCP_PORTS})"

# 1) NOTRACK on SYNs (raw)
for _pp in ${_TCP_PORTS}; do _ensure_notrack "${_pp}"; done

# 2) Early jump at rule #1
_pin_early_jump

# 3) Early chain content (with ACK-accept shim)
_populate_early_chain

# 4) QUIC management (purge or ensure)
_ensure_quic_limits

_v "Done."
exit 0
