#!/bin/bash

#
# Enforces:
#   raw/PREROUTING : CT --notrack for inbound SYN to protected ports
#   filter/INPUT   : rule #1 jump to SYNPROXY_EARLY (respects CSF LOCALINPUT topology)
#   SYNPROXY_EARLY : lo/trusted RETURN, EST/REL ACCEPT, ANY SYN -> SYNPROXY, INVALID DROP,
#                    NEW !SYN -> DROP  (strict guard)
#   filter/OUTPUT  : (1) ACCEPT EST/REL
#                    (2) ACCEPT SYN,ACK and RST from --sport <ports>
#                    (3) ACCEPT ACK’ed data from --sport <ports>  <—— **added**
#
# QUIC limiter flags accepted (OFF by default). All vars+funcs are underscored; refs use ${_VAR}.
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

set -u

# -------- defaults -------------------------------------------------------------
_TCP_PORTS="${_TCP_PORTS:-443 80}"
_MSS="${_MSS:-1400}"
_TRUSTED_SRC="${_TRUSTED_SRC:-}"
_REBUILD_CHAIN="${_REBUILD_CHAIN:-YES}"
_STRICT="${_STRICT:-NO}"

_ENABLE_QUIC_LIMITER="${_ENABLE_QUIC_LIMITER:-NO}"
_QUIC_PORT="${_QUIC_PORT:-443}"
_RATE_PER_IP="${_RATE_PER_IP:-80/second}"
_BURST_PER_IP="${_BURST_PER_IP:-160}"
_RATE_PER_24="${_RATE_PER_24:-800/second}"
_BURST_PER_24="${_BURST_PER_24:-1600}"

_RETRY_MAX="${_RETRY_MAX:-120}"
_RETRY_SLEEP="${_RETRY_SLEEP:-0.25}"

_QUIET="${_QUIET:-NO}"
_VERBOSE="${_VERBOSE:-NO}"

# -------- logging --------------------------------------------------------------
_msg(){ [ "${_QUIET}" = "YES" ] && return 0; echo "[REASSERT] $*"; }
_v(){ [ "${_VERBOSE}" = "YES" ] && _msg "$@"; }
_die(){ echo "[REASSERT][ERROR] $*" >&2; exit 1; }

# -------- args ----------------------------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--ports)      _TCP_PORTS="$2"; shift 2;;
    --mss)           _MSS="$2"; shift 2;;
    --trust)         _TRUSTED_SRC="${2:-}"; shift 2;;
    --rebuild-chain) _REBUILD_CHAIN="YES"; shift 1;;
    --no-rebuild)    _REBUILD_CHAIN="NO"; shift 1;;
    --strict)        _STRICT="YES"; shift 1;;
    --no-strict)     _STRICT="NO"; shift 1;;
    --no-quic)       _ENABLE_QUIC_LIMITER="NO"; shift 1;;
    --quic-port)     _QUIC_PORT="$2"; shift 2;;
    --rate-ip)       _RATE_PER_IP="$2"; shift 2;;
    --burst-ip)      _BURST_PER_IP="$2"; shift 2;;
    --rate-24)       _RATE_PER_24="$2"; shift 2;;
    --burst-24)      _BURST_PER_24="$2"; shift 2;;
    -q|--quiet)      _QUIET="YES"; _VERBOSE="NO"; shift 1;;
    -v|--verbose)    _VERBOSE="YES"; _QUIET="NO"; shift 1;;
    -h|--help)
      cat <<USAGE
Usage: synproxy_reassert [options]
  -p, --ports "443 80"   TCP ports to protect (default: "443 80")
      --mss 1400         MSS for SYNPROXY cookie (default: 1400)
      --trust "CIDR ..." Bypass SYNPROXY for these sources
      --rebuild-chain    Flush & rebuild SYNPROXY_EARLY (default)
      --no-rebuild       Ensure-only (no flush)
      --strict           Add per-port NEW !SYN -> DROP (default: off)
      --no-strict        Disable the above
  QUIC limiter (OFF unless enabled):
      --no-quic          Disable limiter (default)
      --quic-port 443    QUIC UDP port
      --rate-ip X/sec    Per-IP rate (default: 80/second)
      --burst-ip N       Per-IP burst (default: 160)
      --rate-24 X/sec    Per-/24 rate (default: 800/second)
      --burst-24 N       Per-/24 burst (default: 1600)
  -q, --quiet            Minimal output
  -v, --verbose          Extra output
Examples:
  synproxy_reassert -p "443" --quic-port 443 -v
  synproxy_reassert -p "443 80" --no-quic -q
USAGE
      exit 0;;
    *) _die "Unknown option: $1";;
  esac
done

# -------- tools/wrappers ------------------------------------------------------
command -v iptables >/dev/null 2>&1 || { _msg "iptables not found"; exit 0; }
command -v modprobe >/dev/null 2>&1 || true
command -v sleep >/dev/null 2>&1 || _die "sleep not found"

_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

# -------- modules (best-effort) ----------------------------------------------
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_state 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
modprobe nf_synproxy_core 2>/dev/null || true
modprobe xt_hashlimit 2>/dev/null || true

# -------- NOTRACK detection (v4) ---------------------------------------------
_NOTRACK_KIND=""
_detect_notrack_kind(){
  if iptables -t raw -I PREROUTING 1 -p tcp --syn --dport 9 -j CT --notrack 2>/dev/null; then
    iptables -t raw -D PREROUTING -p tcp --syn --dport 9 -j CT --notrack 2>/dev/null || true
    _NOTRACK_KIND="CT"; _v "NOTRACK: CT --notrack"; return 0
  fi
  if iptables -t raw -I PREROUTING 1 -p tcp --syn --dport 9 -j NOTRACK 2>/dev/null; then
    iptables -t raw -D PREROUTING -p tcp --syn --dport 9 -j NOTRACK 2>/dev/null || true
    _NOTRACK_KIND="LEGACY"; _v "NOTRACK: NOTRACK target"; return 0
  fi
  _die "Kernel lacks CT --notrack/NOTRACK support; cannot proceed"
}

# -------- helpers -------------------------------------------------------------
_del_specs_from(){
  local _table="$1" _chain="$2" _pat="$3" _line _spec
  while :; do
    _line="$({ iptables -t "${_table}" -S "${_chain}" 2>/dev/null || true; } | grep -E -- "${_pat}" | head -n1 || true)"
    [ -n "${_line}" ] || break
    _spec="${_line#-A ${_chain} }"
    _ipt -t "${_table}" -D "${_chain}" ${_spec} 2>/dev/null || break
  done
}

_first_rule_line(){ iptables -S INPUT 2>/dev/null | awk '$1=="-A"&&$2=="INPUT"{print;exit}'; }
_first_rule_target(){
  local _line; _line="$(_first_rule_line)"; echo "${_line}" \
  | awk '{for(i=1;i<=NF;i++) if($i=="-j"&&i+1<=NF){print $(i+1); exit}}'
}

_ensure_raw_notrack_port(){
  local _port="$1"
  if [ "${_NOTRACK_KIND}" = "CT" ]; then
    while _ipt -t raw -C PREROUTING -p tcp --syn --dport "${_port}" -j CT --notrack 2>/dev/null; do
      _ipt -t raw -D PREROUTING -p tcp --syn --dport "${_port}" -j CT --notrack || break
    done
    _ipt -t raw -I PREROUTING 1 -p tcp --syn --dport "${_port}" -j CT --notrack 2>/dev/null || true
  else
    while _ipt -t raw -C PREROUTING -p tcp --syn --dport "${_port}" -j NOTRACK 2>/dev/null; do
      _ipt -t raw -D PREROUTING -p tcp --syn --dport "${_port}" -j NOTRACK || break
    done
    _ipt -t raw -I PREROUTING 1 -p tcp --syn --dport "${_port}" -j NOTRACK 2>/dev/null || true
  fi
  _v "raw: NOTRACK for :${_port} (${_NOTRACK_KIND})"
}

_ensure_jump_order(){
  local _i=0 _ok="NO"
  _chain_exists SYNPROXY_EARLY || _ipt -N SYNPROXY_EARLY 2>/dev/null || true
  while [ "${_i}" -lt "${_RETRY_MAX}" ]; do
    local _tgt="$(_first_rule_target)"
    if [ "${_tgt}" = "LOCALINPUT" ] && _chain_exists LOCALINPUT; then
      while _ipt -C LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null; do _ipt -D LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null || break; done
      _ipt -I LOCALINPUT 1 -j SYNPROXY_EARLY 2>/dev/null || true
      [ "$(iptables -S LOCALINPUT | awk '$1=="-A"&&$2=="LOCALINPUT"{for(i=1;i<=NF;i++) if($i=="-j"&&i+1<=NF){print $(i+1); exit}}')" = "SYNPROXY_EARLY" ] && _ok="YES"
    else
      while _ipt -C INPUT -j SYNPROXY_EARLY 2>/dev/null; do _ipt -D INPUT -j SYNPROXY_EARLY 2>/dev/null || break; done
      _ipt -I INPUT 1 -j SYNPROXY_EARLY 2>/dev/null || true
      [ "$(_first_rule_target)" = "SYNPROXY_EARLY" ] && _ok="YES"
    fi
    [ "${_ok}" = "YES" ] && return 0
    sleep "${_RETRY_SLEEP}"; _i=$((_i+1))
  done
  return 1
}

# -------- OUTPUT allows (incl. ACK’ed data) -----------------------------------
_ensure_output_synproxy_allow(){
  # ESTABLISHED/RELATED (both matchers)
  _ipt -C OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || _ipt -I OUTPUT 1 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
  _ipt -C OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null      || _ipt -I OUTPUT 1 -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null      || true

  local _p
  for _p in ${_TCP_PORTS}; do
    # SYN,ACK replies
    _ipt -C OUTPUT -p tcp --sport "${_p}" -m tcp --tcp-flags SYN,ACK SYN,ACK -j ACCEPT 2>/dev/null \
      || _ipt -I OUTPUT 1 -p tcp --sport "${_p}" -m tcp --tcp-flags SYN,ACK SYN,ACK -j ACCEPT 2>/dev/null || true
    # RST cleanups
    _ipt -C OUTPUT -p tcp --sport "${_p}" -m tcp --tcp-flags RST RST -j ACCEPT 2>/dev/null \
      || _ipt -I OUTPUT 1 -p tcp --sport "${_p}" -m tcp --tcp-flags RST RST -j ACCEPT 2>/dev/null || true
    # ACK’ed data (first ServerHello, etc.)  <—— **NEW**
    _ipt -C OUTPUT -p tcp --sport "${_p}" -m tcp --tcp-flags ACK ACK -j ACCEPT 2>/dev/null \
      || _ipt -I OUTPUT 1 -p tcp --sport "${_p}" -m tcp --tcp-flags ACK ACK -j ACCEPT 2>/dev/null || true
  done
  _v "output: allow EST/REL + SYN,ACK/RST + ACK-data from service ports: ${_TCP_PORTS}"
}

# -------- purge legacy ---------------------------------------------------------
_purge_legacy(){
  local _ports_re; _ports_re="$(printf '%s|' ${_TCP_PORTS})"; _ports_re="${_ports_re%|}"
  _del_specs_from filter INPUT      "-j SYNPROXY"
  _del_specs_from filter LOCALINPUT "-j SYNPROXY"
  _del_specs_from filter SYNPROXY_EARLY "-p tcp .* --dport (${_ports_re}) .*(tcp-flags .* ACK|! --syn) .*(ctstate NEW|state NEW) .* -j ACCEPT"
  while :; do
    local _line _spec
    _line="$({ iptables -t filter -S SYNPROXY_EARLY 2>/dev/null || true; } \
      | grep -E -- "-p tcp .* --dport (${_ports_re}) .*(ctstate NEW|state NEW) .* -j DROP" \
      | grep -v '! --syn' | head -n1 || true)"
    [ -n "${_line}" ] || break
    _spec="${_line#-A SYNPROXY_EARLY }"
    _ipt -t filter -D SYNPROXY_EARLY ${_spec} 2>/dev/null || break
  done
}

# -------- populate SYNPROXY_EARLY ---------------------------------------------
_populate_filter_early(){
  [ "${_REBUILD_CHAIN}" = "YES" ] && _ipt -F SYNPROXY_EARLY 2>/dev/null || true

  # loopback & trusted bypass
  _ipt -C SYNPROXY_EARLY -i lo -j RETURN 2>/dev/null || _ipt -I SYNPROXY_EARLY 1 -i lo -j RETURN
  if [ -n "${_TRUSTED_SRC}" ]; then
    local _cidr
    for _cidr in ${_TRUSTED_SRC}; do
      _ipt -C SYNPROXY_EARLY -s "${_cidr}" -j RETURN 2>/dev/null || _ipt -I SYNPROXY_EARLY 2 -s "${_cidr}" -j RETURN
    done
  fi

  # established accepts
  _ipt -C SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
  _ipt -C SYNPROXY_EARLY -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true

  # SYN -> SYNPROXY (explicit flags form; monitor should treat as present)
  local _p
  for _p in ${_TCP_PORTS}; do
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN \
      -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss "${_MSS}" 2>/dev/null || \
    _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN \
      -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss "${_MSS}" 2>/dev/null || true

    if [ "${_STRICT}" = "YES" ]; then
      _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m conntrack --ctstate NEW -m tcp ! --tcp-flags FIN,SYN,RST,ACK SYN -j DROP 2>/dev/null \
        || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m conntrack --ctstate NEW -m tcp ! --tcp-flags FIN,SYN,RST,ACK SYN -j DROP 2>/dev/null || true
      _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m state --state NEW -m tcp ! --tcp-flags FIN,SYN,RST,ACK SYN -j DROP 2>/dev/null \
        || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m state --state NEW -m tcp ! --tcp-flags FIN,SYN,RST,ACK SYN -j DROP 2>/dev/null || true
    fi
  done

  # INVALID -> DROP
  _ipt -C SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
  _ipt -C SYNPROXY_EARLY -m state --state INVALID -j DROP 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m state --state INVALID -j DROP 2>/dev/null || true
}

# -------- QUIC limiter (off unless enabled) -----------------------------------
_purge_quic_rules(){
  [ -n "${_QUIC_PORT}" ] || return 0
  _del_specs_from filter INPUT "-p udp .*--dport ${_QUIC_PORT} .*hashlimit-name quic${_QUIC_PORT}_ip"
  _del_specs_from filter INPUT "-p udp .*--dport ${_QUIC_PORT} .*hashlimit-name quic${_QUIC_PORT}_24"
  _del_specs_from filter INPUT "-p udp .*--dport ${_QUIC_PORT} .*(-m conntrack --ctstate INVALID|-m state --state INVALID).* -j DROP"
}
_ensure_quic_limits(){
  [ -n "${_QUIC_PORT}" ] || return 0
  if [ "${_ENABLE_QUIC_LIMITER}" != "YES" ]; then
    _purge_quic_rules; _v "input: QUIC limiter disabled; purged for UDP:${_QUIC_PORT}"; return 0
  fi
  _purge_quic_rules
  _ipt -I INPUT 1 -p udp --dport "${_QUIC_PORT}" -m hashlimit --hashlimit-name quic${_QUIC_PORT}_24 --hashlimit-above "${_RATE_PER_24}" --hashlimit-burst "${_BURST_PER_24}" --hashlimit-mode srcip --hashlimit-srcmask 24 --hashlimit-htable-expire 60000 -j DROP 2>/dev/null || true
  _ipt -I INPUT 1 -p udp --dport "${_QUIC_PORT}" -m hashlimit --hashlimit-name quic${_QUIC_PORT}_ip --hashlimit-above "${_RATE_PER_IP}" --hashlimit-burst "${_BURST_PER_IP}" --hashlimit-mode srcip --hashlimit-htable-expire 60000 -j DROP 2>/dev/null || true
  _ipt -I INPUT 1 -p udp --dport "${_QUIC_PORT}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null || true
}

# -------- verification ---------------------------------------------------------
_verify_once(){
  local _ok=1 _why=""
  # jump placement
  if [ "$(_first_rule_target)" = "LOCALINPUT" ] && _chain_exists LOCALINPUT; then
    [ "$(iptables -S LOCALINPUT | awk '$1=="-A"&&$2=="LOCALINPUT"{for(i=1;i<=NF;i++) if($i=="-j"&&i+1<=NF){print $(i+1); exit}}')" = "SYNPROXY_EARLY" ] || { _why="${_why}\n - LOCALINPUT #1 != SYNPROXY_EARLY"; _ok=0; }
  else
    [ "$(_first_rule_target)" = "SYNPROXY_EARLY" ] || { _why="${_why}\n - INPUT #1 != SYNPROXY_EARLY"; _ok=0; }
  fi

  # raw NOTRACK
  local _p _has
  for _p in ${_TCP_PORTS}; do
    _has="NO"
    iptables -t raw -C PREROUTING -p tcp --syn --dport "${_p}" -j CT --notrack 2>/dev/null && _has="YES"
    iptables -t raw -C PREROUTING -p tcp --syn --dport "${_p}" -j NOTRACK 2>/dev/null && _has="YES"
    [ "${_has}" = "YES" ] || { _why="${_why}\n - raw/PREROUTING missing NOTRACK for SYN dport ${_p}"; _ok=0; }
  done

  # SYNPROXY per port (accept either --syn or --tcp-flags form)
  for _p in ${_TCP_PORTS}; do
    iptables -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --syn -j SYNPROXY 2>/dev/null || \
    iptables -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j SYNPROXY 2>/dev/null || {
      _why="${_why}\n - SYNPROXY_EARLY missing SYNPROXY for dport ${_p}"
      _ok=0
    }
  done

  # OUTPUT allows (EST/REL + SYN,ACK + RST + ACK-data)
  for _p in ${_TCP_PORTS}; do
    iptables -C OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || iptables -C OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || {
      _why="${_why}\n - OUTPUT lacks EST/REL ACCEPT"; _ok=0; }
    iptables -C OUTPUT -p tcp --sport "${_p}" -m tcp --tcp-flags SYN,ACK SYN,ACK -j ACCEPT 2>/dev/null || {
      _why="${_why}\n - OUTPUT lacks SYN,ACK allow for --sport ${_p}"; _ok=0; }
    iptables -C OUTPUT -p tcp --sport "${_p}" -m tcp --tcp-flags RST RST -j ACCEPT 2>/dev/null || {
      _why="${_why}\n - OUTPUT lacks RST allow for --sport ${_p}"; _ok=0; }
    iptables -C OUTPUT -p tcp --sport "${_p}" -m tcp --tcp-flags ACK ACK -j ACCEPT 2>/dev/null || {
      _why="${_why}\n - OUTPUT lacks ACK-data allow for --sport ${_p}"; _ok=0; }
  done

  if [ "${_ok}" -ne 1 ]; then _why="${_why#\\n }"; echo "${_why}"; return 1; fi
  return 0
}

_verify_with_retry(){
  local _i=0
  while [ "${_i}" -lt "${_RETRY_MAX}" ]; do
    if _verify_once >/dev/null; then return 0; fi
    # repair
    local _p
    for _p in ${_TCP_PORTS}; do _ensure_raw_notrack_port "${_p}"; done
    _ensure_jump_order || true
    _ensure_output_synproxy_allow || true
    sleep "${_RETRY_SLEEP}"; _i=$((_i+1))
  done
  local _why="$(_verify_once || true)"
  _die "One or more invariants failed; SYNPROXY not active:${_why:+ ${_why}}"
}

# -------- go ------------------------------------------------------------------
_msg "Reassert SYNPROXY (ports: ${_TCP_PORTS}, mss: ${_MSS}, strict: ${_STRICT}, quic: ${_ENABLE_QUIC_LIMITER})"

_detect_notrack_kind

for _pp in ${_TCP_PORTS}; do _ensure_raw_notrack_port "${_pp}"; done
_ensure_jump_order || _die "Could not place jump to SYNPROXY_EARLY at top of INPUT/LOCALINPUT after retries"

_purge_legacy
_populate_filter_early

_ensure_output_synproxy_allow
_ensure_quic_limits

_verify_with_retry
_v "Done."
exit 0
