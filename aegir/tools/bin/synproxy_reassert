#!/bin/bash

#
# SYNPROXY limiter for CSF/Devuan (IPv4).
# QUIC limiter flags accepted (OFF by default).
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

# Function to check if the script is run as root
_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

###
### Atomic lock/unlock to prevent TOCTOU race
###
_manage_single_lock() {
  _SELF_NAME="${_SELF_NAME:-$(basename "$0")}"
  for _L in "/opt/local/bin/lock.inc" "/opt/local/lib/lock.inc"; do
    [ -r "$_L" ] && . "$_L" && break
  done
  if [ -n "${_SINGLE_INSTANCE_LIB_VER:-}" ] && command -v _single_instance_lock >/dev/null 2>&1; then
    # use shared lock if available
    _single_instance_lock
  else
    # -------- legacy pgrep guard ---------
    # Exit if more than 2 instances of this script are running
    _SCRIPT=$(basename "$0")
    _CNT=$(pgrep -fc ${_SCRIPT})
    if (( _CNT > 2 )); then
      echo "Too many ${_SCRIPT} running $(date) (count=${_CNT})" >> /var/log/boa/too.many.log
      exit 0
    fi
  fi
}
_manage_single_lock

set -u

# ---------- Defaults ----------
_TCP_PORTS="${_TCP_PORTS:-443 80}"
_MSS="${_MSS:-1400}"
_TRUSTED_SRC="${_TRUSTED_SRC:-}"
_REBUILD_CHAIN="${_REBUILD_CHAIN:-YES}"
_STRICT="${_STRICT:-NO}"

_ENABLE_QUIC_LIMITER="${_ENABLE_QUIC_LIMITER:-NO}"
_QUIC_PORT="${_QUIC_PORT:-443}"
_RATE_PER_IP="${_RATE_PER_IP:-80/second}"
_BURST_PER_IP="${_BURST_PER_IP:-160}"
_RATE_PER_24="${_RATE_PER_24:-800/second}"
_BURST_PER_24="${_BURST_PER_24:-1600}"

_RETRY_MAX="${_RETRY_MAX:-120}"     # ~30s with default sleep
_RETRY_SLEEP="${_RETRY_SLEEP:-0.25}"

_QUIET="${_QUIET:-NO}"
_VERBOSE="${_VERBOSE:-NO}"

# ---------- Logging ----------
_msg(){ [ "${_QUIET}" = "YES" ] && return 0; echo "[REASSERT] $*"; }
_v(){ [ "${_VERBOSE}" = "YES" ] && _msg "$@"; }
_die(){ echo "[REASSERT][ERROR] $*" >&2; exit 1; }

# ---------- Args ----------
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--ports)      _TCP_PORTS="$2"; shift 2;;
    --mss)           _MSS="$2"; shift 2;;
    --trust)         _TRUSTED_SRC="${2:-}"; shift 2;;
    --rebuild-chain) _REBUILD_CHAIN="YES"; shift 1;;
    --no-rebuild)    _REBUILD_CHAIN="NO"; shift 1;;
    --strict)        _STRICT="YES"; shift 1;;
    --no-strict)     _STRICT="NO"; shift 1;;
    --no-quic)       _ENABLE_QUIC_LIMITER="NO"; shift 1;;
    --quic-port)     _QUIC_PORT="$2"; shift 2;;
    --rate-ip)       _RATE_PER_IP="$2"; shift 2;;
    --burst-ip)      _BURST_PER_IP="$2"; shift 2;;
    --rate-24)       _RATE_PER_24="$2"; shift 2;;
    --burst-24)      _BURST_PER_24="$2"; shift 2;;
    -q|--quiet)      _QUIET="YES"; _VERBOSE="NO"; shift 1;;
    -v|--verbose)    _VERBOSE="YES"; _QUIET="NO"; shift 1;;
    -h|--help)
      cat <<USAGE
Usage: synproxy_reassert [options]
  -p, --ports "443 80"   TCP ports to protect (default: "443 80")
      --mss 1400         MSS for SYNPROXY cookie (default: 1400)
      --trust "CIDR ..." Bypass SYNPROXY for sources (space-separated)
      --rebuild-chain    Flush & rebuild SYNPROXY_EARLY/EGRESS (default)
      --no-rebuild       Ensure-only (no flush)
      --strict           Add per-port NEW !SYN -> DROP (default: off)
      --no-strict        Disable the above
  QUIC limiter (OFF unless enabled):
      --no-quic          Disable limiter (default)
      --quic-port 443    QUIC UDP port
      --rate-ip X/sec    Per-IP rate (default: 80/second)
      --burst-ip N       Per-IP burst (default: 160)
      --rate-24 X/sec    Per-/24 rate (default: 800/second)
      --burst-24 N       Per-/24 burst (default: 1600)
  -q, --quiet            Minimal output
  -v, --verbose          Extra output
Examples:
  synproxy_reassert -p "443" --quic-port 443 -v
  synproxy_reassert -p "443 80" --no-quic -q
USAGE
      exit 0;;
    *) _die "Unknown option: $1";;
  esac
done

# ---------- Tools ----------
command -v iptables >/dev/null 2>&1 || { _msg "iptables not found"; exit 0; }
command -v modprobe >/dev/null 2>&1 || true
command -v sleep >/dev/null 2>&1 || _die "sleep not found"

_IPT_HAS_W="NO"; iptables -w -L -n >/dev/null 2>&1 && _IPT_HAS_W="YES"
_ipt(){ if [ "${_IPT_HAS_W}" = "YES" ]; then iptables -w "$@"; else iptables "$@"; fi; }
_chain_exists(){ _ipt -L "$1" -n >/dev/null 2>&1; }

# -------- modules (best-effort) ----------------------------------------------
modprobe xt_CT 2>/dev/null || true
modprobe xt_conntrack 2>/dev/null || true
modprobe xt_state 2>/dev/null || true
modprobe xt_SYNPROXY 2>/dev/null || true
modprobe nf_synproxy_core 2>/dev/null || true
modprobe xt_hashlimit 2>/dev/null || true

grep -wq SYNPROXY /proc/net/ip_tables_targets 2>/dev/null \
  || _die "Kernel target SYNPROXY not available (xt_SYNPROXY/nf_synproxy_core not loaded?)"

# ---------- Detect NOTRACK flavor ----------
_NOTRACK_KIND=""
if iptables -t raw -I PREROUTING 1 -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport 9 -j CT --notrack 2>/dev/null; then
  iptables -t raw -D PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport 9 -j CT --notrack >/dev/null 2>&1 || true
  _NOTRACK_KIND="CT"
elif iptables -t raw -I PREROUTING 1 -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport 9 -j NOTRACK 2>/dev/null; then
  iptables -t raw -D PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport 9 -j NOTRACK >/dev/null 2>&1 || true
  _NOTRACK_KIND="LEGACY"
else
  _die "Kernel lacks CT --notrack/NOTRACK support"
fi
_v "NOTRACK flavor: ${_NOTRACK_KIND}"

# ---------- Helpers ----------
_add_or_die(){
  if ! iptables "$@"; then
    echo "[REASSERT][iptables] iptables $* failed:" >&2
    iptables "$@" 2>&1 | sed 's/^/[REASSERT][iptables] /' >&2 || true
    _die "iptables insertion failed (see above)"
  fi
}

# ensure raw NOTRACK for SYN to a port (insert at top; dedupe)
_ensure_raw_notrack_port(){
  local _p="$1"
  if [ "${_NOTRACK_KIND}" = "CT" ]; then
    while _ipt -t raw -C PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j CT --notrack 2>/dev/null; do
      _ipt -t raw -D PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j CT --notrack || break
    done
    _add_or_die -t raw -I PREROUTING 1 -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j CT --notrack
  else
    while _ipt -t raw -C PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j NOTRACK 2>/dev/null; do
      _ipt -t raw -D PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j NOTRACK || break
    done
    _add_or_die -t raw -I PREROUTING 1 -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j NOTRACK
  fi
}

# ensure INPUT/LOCALINPUT has early jump (we try to be #1 but verify presence)
_ensure_jump_order_INPUT(){
  local _i=0
  _chain_exists SYNPROXY_EARLY || _ipt -N SYNPROXY_EARLY
  while [ "${_i}" -lt "${_RETRY_MAX}" ]; do
    # prefer LOCALINPUT first hop if CSF uses it
    if _ipt -C INPUT -j LOCALINPUT 2>/dev/null && _chain_exists LOCALINPUT; then
      _ipt -C LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null && _ipt -D LOCALINPUT -j SYNPROXY_EARLY || true
      _ipt -I LOCALINPUT 1 -j SYNPROXY_EARLY 2>/dev/null || true
      _ipt -C LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null && return 0
    else
      _ipt -C INPUT -j SYNPROXY_EARLY 2>/dev/null && _ipt -D INPUT -j SYNPROXY_EARLY || true
      _ipt -I INPUT 1 -j SYNPROXY_EARLY 2>/dev/null || true
      _ipt -C INPUT -j SYNPROXY_EARLY 2>/dev/null && return 0
    fi
    sleep "${_RETRY_SLEEP}"; _i=$((_i+1))
  done
  return 1
}

# (re)build contents of SYNPROXY_EARLY (—tcp-flags SYN form) + post-SYN DROP
_populate_filter_early(){
  [ "${_REBUILD_CHAIN}" = "YES" ] && _ipt -F SYNPROXY_EARLY || true

  # loopback/trusted bypass
  _ipt -C SYNPROXY_EARLY -i lo -j RETURN 2>/dev/null || _ipt -I SYNPROXY_EARLY 1 -i lo -j RETURN
  if [ -n "${_TRUSTED_SRC}" ]; then
    local _c
    for _c in ${_TRUSTED_SRC}; do
      _ipt -C SYNPROXY_EARLY -s "${_c}" -j RETURN 2>/dev/null || _ipt -I SYNPROXY_EARLY 2 -s "${_c}" -j RETURN
    done
  fi

  # established/related accept (both matchers for broad compatibility)
  _ipt -C SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  _ipt -C SYNPROXY_EARLY -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m state --state ESTABLISHED,RELATED -j ACCEPT

  # per-port guards + SYNPROXY + post-SYN DROP
  local _p
  for _p in ${_TCP_PORTS}; do
    if [ "${_STRICT}" = "YES" ]; then
      _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m conntrack --ctstate NEW -m tcp '!' --syn -j DROP 2>/dev/null \
        || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m conntrack --ctstate NEW -m tcp '!' --syn -j DROP
      _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m state --state NEW -m tcp '!' --syn -j DROP 2>/dev/null \
        || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m state --state NEW -m tcp '!' --syn -j DROP
    fi
    # ANY SYN -> SYNPROXY (exact spec we also use for -C checks)
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN \
         -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss "${_MSS}" 2>/dev/null \
      || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN \
         -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss "${_MSS}"
    # Drop the original SYN so it can't fall through into CSF paths
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j DROP 2>/dev/null \
      || _ipt -A SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j DROP
  done

  # INVALID -> DROP (both matchers)
  _ipt -C SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m conntrack --ctstate INVALID -j DROP
  _ipt -C SYNPROXY_EARLY -m state --state INVALID -j DROP 2>/dev/null \
    || _ipt -A SYNPROXY_EARLY -m state --state INVALID -j DROP
}

# OUTPUT: own chain + single jump (we verify with -C only)
_ensure_output_egress_chain(){
  _chain_exists SYNPROXY_EGRESS || _ipt -N SYNPROXY_EGRESS
  [ "${_REBUILD_CHAIN}" = "YES" ] && _ipt -F SYNPROXY_EGRESS || true

  # Canonical egress allows (SYNPROXY replies + first data)
  _ipt -C SYNPROXY_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  _ipt -C SYNPROXY_EGRESS -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || _ipt -A SYNPROXY_EGRESS -m state --state ESTABLISHED,RELATED -j ACCEPT

  local _p
  for _p in ${_TCP_PORTS}; do
    _ipt -C SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags ACK ACK -j ACCEPT 2>/dev/null \
      || _ipt -A SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags ACK ACK -j ACCEPT
    _ipt -C SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags SYN,ACK SYN,ACK -j ACCEPT 2>/dev/null \
      || _ipt -A SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags SYN,ACK SYN,ACK -j ACCEPT
    _ipt -C SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags RST RST -j ACCEPT 2>/dev/null \
      || _ipt -A SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags RST RST -j ACCEPT
  done

  # Ensure OUTPUT jump exists and is near top; we verify presence, not position.
  _ipt -C OUTPUT -j SYNPROXY_EGRESS 2>/dev/null || _ipt -I OUTPUT 1 -j SYNPROXY_EGRESS
}

# QUIC limiter (optional)
_purge_quic_rules(){
  [ -n "${_QUIC_PORT}" ] || return 0
  local _p="${_QUIC_PORT}"
  while _ipt -C INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_24 -j DROP 2>/dev/null; do
    _ipt -D INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_24 -j DROP || break
  done
  while _ipt -C INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_ip -j DROP 2>/dev/null; do
    _ipt -D INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_ip -j DROP || break
  done
  while _ipt -C INPUT -p udp --dport "${_p}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null; do
    _ipt -D INPUT -p udp --dport "${_p}" -m conntrack --ctstate INVALID -j DROP || break
  done
}
_ensure_quic_limits(){
  [ -n "${_QUIC_PORT}" ] || return 0
  if [ "${_ENABLE_QUIC_LIMITER}" != "YES" ]; then
    _purge_quic_rules; _v "QUIC limiter disabled; purged for UDP:${_QUIC_PORT}"; return 0
  fi
  local _p="${_QUIC_PORT}"
  # Place after early jump (positions 2/3/4 typically); verify by presence only.
  _ipt -C INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_24 \
       --hashlimit-above "${_RATE_PER_24}" --hashlimit-burst "${_BURST_PER_24}" \
       --hashlimit-mode srcip --hashlimit-srcmask 24 --hashlimit-htable-expire 60000 -j DROP 2>/dev/null \
    || _ipt -I INPUT 2 -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_24 \
       --hashlimit-above "${_RATE_PER_24}" --hashlimit-burst "${_BURST_PER_24}" \
       --hashlimit-mode srcip --hashlimit-srcmask 24 --hashlimit-htable-expire 60000 -j DROP

  _ipt -C INPUT -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_ip \
       --hashlimit-above "${_RATE_PER_IP}" --hashlimit-burst "${_BURST_PER_IP}" \
       --hashlimit-mode srcip --hashlimit-htable-expire 60000 -j DROP 2>/dev/null \
    || _ipt -I INPUT 3 -p udp --dport "${_p}" -m hashlimit --hashlimit-name quic${_p}_ip \
       --hashlimit-above "${_RATE_PER_IP}" --hashlimit-burst "${_BURST_PER_IP}" \
       --hashlimit-mode srcip --hashlimit-htable-expire 60000 -j DROP

  _ipt -C INPUT -p udp --dport "${_p}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null \
    || _ipt -I INPUT 4 -p udp --dport "${_p}" -m conntrack --ctstate INVALID -j DROP

  _v "QUIC limiter enabled on UDP:${_p}"
}

# ---------- Verify using iptables -C only ----------
_verify_once(){
  local _ok=1 _why=""

  # Early jump present (either INPUT or LOCALINPUT topology)
  if _ipt -C INPUT -j LOCALINPUT 2>/dev/null && _chain_exists LOCALINPUT; then
    _ipt -C LOCALINPUT -j SYNPROXY_EARLY 2>/dev/null || { _why="${_why}\n - LOCALINPUT lacks jump to SYNPROXY_EARLY"; _ok=0; }
  else
    _ipt -C INPUT -j SYNPROXY_EARLY 2>/dev/null || { _why="${_why}\n - INPUT lacks jump to SYNPROXY_EARLY"; _ok=0; }
  fi

  # raw NOTRACK per port
  local _p
  for _p in ${_TCP_PORTS}; do
    if [ "${_NOTRACK_KIND}" = "CT" ]; then
      _ipt -t raw -C PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j CT --notrack 2>/dev/null \
        || { _why="${_why}\n - raw/PREROUTING missing CT --notrack for dport ${_p}"; _ok=0; }
    else
      _ipt -t raw -C PREROUTING -p tcp --tcp-flags FIN,SYN,RST,ACK SYN --dport "${_p}" -j NOTRACK 2>/dev/null \
        || { _why="${_why}\n - raw/PREROUTING missing NOTRACK for dport ${_p}"; _ok=0; }
    fi
  done

  # SYNPROXY + post-SYN DROP present for each port
  for _p in ${_TCP_PORTS}; do
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN \
         -j SYNPROXY --sack-perm --timestamp --wscale 7 --mss "${_MSS}" 2>/dev/null \
      || { _why="${_why}\n - SYNPROXY_EARLY missing SYNPROXY (dport ${_p})"; _ok=0; }
    _ipt -C SYNPROXY_EARLY -p tcp --dport "${_p}" -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j DROP 2>/dev/null \
      || { _why="${_why}\n - SYNPROXY_EARLY missing post-SYN DROP (dport ${_p})"; _ok=0; }
  done

  # OUTPUT: either has our jump or inline egress rules — we require the jump
  _ipt -C OUTPUT -j SYNPROXY_EGRESS 2>/dev/null || { _why="${_why}\n - OUTPUT lacks jump to SYNPROXY_EGRESS"; _ok=0; }
  # And the egress chain must have its accepts
  _ipt -C SYNPROXY_EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || { _why="${_why}\n - SYNPROXY_EGRESS lacks EST/REL accept"; _ok=0; }
  _ipt -C SYNPROXY_EGRESS -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
    || { _why="${_why}\n - SYNPROXY_EGRESS lacks state EST/REL accept"; _ok=0; }
  for _p in ${_TCP_PORTS}; do
    _ipt -C SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags ACK ACK -j ACCEPT 2>/dev/null \
      || { _why="${_why}\n - SYNPROXY_EGRESS lacks ACK allow (sport ${_p})"; _ok=0; }
    _ipt -C SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags SYN,ACK SYN,ACK -j ACCEPT 2>/dev/null \
      || { _why="${_why}\n - SYNPROXY_EGRESS lacks SYN,ACK allow (sport ${_p})"; _ok=0; }
    _ipt -C SYNPROXY_EGRESS -p tcp --sport "${_p}" -m tcp --tcp-flags RST RST -j ACCEPT 2>/dev/null \
      || { _why="${_why}\n - SYNPROXY_EGRESS lacks RST allow (sport ${_p})"; _ok=0; }
  done

  # QUIC (if enabled)
  if [ "${_ENABLE_QUIC_LIMITER}" = "YES" ] && [ -n "${_QUIC_PORT}" ]; then
    _ipt -C INPUT -p udp --dport "${_QUIC_PORT}" -m hashlimit --hashlimit-name "quic${_QUIC_PORT}_24" -j DROP 2>/dev/null \
      || { _why="${_why}\n - QUIC /24 hashlimit missing (udp ${_QUIC_PORT})"; _ok=0; }
    _ipt -C INPUT -p udp --dport "${_QUIC_PORT}" -m hashlimit --hashlimit-name "quic${_QUIC_PORT}_ip" -j DROP 2>/dev/null \
      || { _why="${_why}\n - QUIC per-IP hashlimit missing (udp ${_QUIC_PORT})"; _ok=0; }
    _ipt -C INPUT -p udp --dport "${_QUIC_PORT}" -m conntrack --ctstate INVALID -j DROP 2>/dev/null \
      || { _why="${_why}\n - QUIC INVALID drop missing (udp ${_QUIC_PORT})"; _ok=0; }
  fi

  if [ "${_ok}" -ne 1 ]; then _why="${_why#\\n }"; echo "${_why}"; return 1; fi
  return 0
}

_verify_with_retry(){
  local _i=0
  while [ "${_i}" -lt "${_RETRY_MAX}" ]; do
    if _verify_once >/dev/null; then return 0; fi
    # attempt repairs during churn
    local _p
    for _p in ${_TCP_PORTS}; do _ensure_raw_notrack_port "${_p}"; done
    _ensure_jump_order_INPUT || true
    _ensure_output_egress_chain || true
    _ensure_quic_limits || true
    sleep "${_RETRY_SLEEP}"; _i=$((_i+1))
  done
  local _why="$(_verify_once || true)"
  _die "One or more invariants failed; SYNPROXY not active:${_why:+ ${_why}}"
}

# ---------- Execute ----------
_msg "Reassert SYNPROXY (ports: ${_TCP_PORTS}, mss: ${_MSS}, strict: ${_STRICT}, quic: ${_ENABLE_QUIC_LIMITER} on udp/${_QUIC_PORT})"

# 1) raw NOTRACK per protected port
for _pp in ${_TCP_PORTS}; do _ensure_raw_notrack_port "${_pp}"; done

# 2) early jump placement (INPUT/LOCALINPUT)
_ensure_jump_order_INPUT || _die "Could not place jump to SYNPROXY_EARLY in INPUT/LOCALINPUT"

# 3) canonical early chain with SYNPROXY + post-SYN DROP
_populate_filter_early

# 4) egress chain + OUTPUT jump
_ensure_output_egress_chain

# 5) QUIC limiter (optional)
_ensure_quic_limits

# 6) verify with retries
_verify_with_retry

_v "Done."
exit 0
