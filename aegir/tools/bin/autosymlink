#!/bin/bash

#
# Sites Files Auto Symlink
#
# Modes:
#   DRY     (default) : no changes, only show + log actions, and record if run is CLEAN
#   LIVE    (live)    : apply changes, per-site confirmation
#   BATCH   (batch)   : apply changes for all sites without confirmation,
#                       allowed only after a CLEAN DRY run
#   BATCH_IF_CLEAN    : run DRY and if CLEAN automatically run BATCH (cron-safe)
#   REPORT  (report)  : read-only report of shared files/private symlinks
#
# A DRY run that is NOT CLEAN blocks batch/live for the whole sweep, so it ends
# with an [EXPLAINED] section: every finding that caused the verdict is re-checked
# against the filesystem right then and printed with what was seen, what was
# probed, the diagnosis and the fix. The commonest one by far is a ghost Drush
# alias whose site no longer exists. Read-only, and drush is never called.
#

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

_check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
}
_check_root

_MODE="DRY"
_NARROW="NO"
_ONE_SITE=""
_ONE_ACCOUNT=""
_APPLY_FLAG="NO"
_FORCE_UNSHARE="NO"

# Back-compat positional modes (DRY default / live / batch / batch-if-clean /
# report) plus flags for the narrow single-site mode used by the Provision clone
# hook: --site <url> [--account <oNNN>] [--apply]. Narrow mode never touches the
# global CLEAN-DRY state file or sweeps all accounts.
while [ "$#" -gt 0 ]; do
  case "$1" in
    live|LIVE|--live)
      _MODE="LIVE"
      ;;
    batch|BATCH|--batch)
      _MODE="BATCH"
      ;;
    --batch-if-clean|batch-if-clean|BATCH_IF_CLEAN|batch_if_clean)
      _MODE="BATCH_IF_CLEAN"
      ;;
    report|REPORT|--report)
      _MODE="REPORT"
      ;;
    dry|DRY|--dry)
      _MODE="DRY"
      ;;
    --site)
      _NARROW="YES"
      shift
      _ONE_SITE="$1"
      ;;
    --account)
      shift
      _ONE_ACCOUNT="$1"
      ;;
    --apply)
      _APPLY_FLAG="YES"
      ;;
    --force-unshare)
      # Clone path: break an inherited cross-account share even if a share
      # control file exists (the clone never opted into sharing).
      _FORCE_UNSHARE="YES"
      ;;
    *)
      : # ignore unknown args
      ;;
  esac
  [ "$#" -gt 0 ] && shift
done

# In narrow mode the action is selected by --apply (BATCH semantics: apply
# without per-site prompt) or defaults to a read-only DRY for that one site.
if [ "${_NARROW}" = "YES" ]; then
  if [ "${_APPLY_FLAG}" = "YES" ]; then
    _MODE="BATCH"
  else
    _MODE="DRY"
  fi
fi

_LOG_DIR="/var/log/boa"
_LOG_FILE="${_LOG_DIR}/autosymlink.log"

if [ ! -d "${_LOG_DIR}" ]; then
  mkdir -p "${_LOG_DIR}"
fi

_STATE_FILE="${_LOG_DIR}/autosymlink.state"

# Flags used only during DRY mode
_DRY_HAS_ERRORS="NO"
_DRY_HAS_EDGE_CASES="NO"

# Findings behind those two flags, for the end-of-run [EXPLAINED] section. The
# flags are bare booleans, so a NOT CLEAN verdict on its own never says which
# site tripped it, and every context variable in this script is a plain global
# that the next site/account iteration overwrites -- the offender's identity has
# to be captured at detection time or it is lost. One element per finding:
# "CODE|k=v|k=v|...". The probing is deliberately deferred to render time, so a
# CLEAN run pays nothing and every reported detail is read from the live
# filesystem rather than from a value cached earlier in the run.
_ANOMALIES=()

# Count applied changes in LIVE/BATCH modes
_APPLY_COUNT=0
_LAST_ACTION=NO

# Per-site LIVE confirmation flag (reset in _process_site)
_LIVE_SITE_APPROVED="NO"

# Cache for global FS pair status: key="SRC_DEV|TGT_DEV", value="SPACIOUS" or "TIGHT"
declare -A _FS_PAIR_STATUS
# Cumulative planned/reserved KB per target filesystem (used mainly for break-sharing copies)
declare -A _FS_RESERVED_KB

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_log() {
  # Single place to log + print
  # Arguments: message...
  _NOW="$(date "+%Y-%m-%d %H:%M:%S")"
  _LINE="${_NOW} $*"

  # Track applied changes only for modes which can apply changes
  if [ "${_MODE}" = "LIVE" ] || [ "${_MODE}" = "BATCH" ] || [ "${_MODE}" = "BATCH_IF_CLEAN" ]; then
    case "${_LINE}" in
      *"[APPLY]"*)
        _APPLY_COUNT=$(( _APPLY_COUNT + 1 ))
        ;;
    esac
  fi

  echo "${_LINE}" | tee -a "${_LOG_FILE}"
}

_record_anomaly() {
  # Capture one not-clean finding WITH its identity, next to the flag it raises.
  # Args: 1: CODE, 2..: k=v context fields.
  # '|' separates fields, so strip it from values ("${_SRC_DEV}|${_TGT_DEV}" pair
  # keys are the one real source of a stray pipe); values are single log-line
  # fragments already, so no newline can reach here.
  _REC="$1"
  shift
  for _RECF in "$@"; do
    _REC="${_REC}|${_RECF//|/ }"
  done
  _ANOMALIES+=("${_REC}")
}

_reset_anomalies() {
  _ANOMALIES=()
}

_write_state() {
  # Write a small state file with mode + status
  # Args: 1: status (CLEAN / NOT_CLEAN / FAILED / etc.)
  #       2: mode   (DRY / LIVE / BATCH / REPORT / BATCH_IF_CLEAN)
  _STATUS="$1"
  _MODE_SAVED="$2"
  _TS="$(date "+%Y-%m-%d %H:%M:%S")"

  if [ "${_APPLY_COUNT}" -gt 0 ]; then
    _LAST_ACTION="YES"
  else
    _LAST_ACTION=NO
  fi

  {
    echo "_LAST_MODE=${_MODE_SAVED}"
    echo "_LAST_STATUS=${_STATUS}"
    echo "_LAST_ACTION=${_LAST_ACTION}"
    echo "_LAST_APPLY_COUNT=${_APPLY_COUNT}"
    echo "_LAST_TS=${_TS}"
  } > "${_STATE_FILE}"
}

_require_clean_dry_run_or_exit() {
  # For BATCH mode: ensure a CLEAN DRY run was executed just before.
  if [ ! -f "${_STATE_FILE}" ]; then
    _log "[ERROR] Batch mode requires a prior CLEAN DRY-RUN, but no state file found: ${_STATE_FILE}"
    exit 1
  fi

  _LAST_MODE=$(grep '^_LAST_MODE=' "${_STATE_FILE}" 2>/dev/null | head -n 1 | cut -d= -f2-)
  _LAST_STATUS=$(grep '^_LAST_STATUS=' "${_STATE_FILE}" 2>/dev/null | head -n 1 | cut -d= -f2-)
  _LAST_TS=$(grep '^_LAST_TS=' "${_STATE_FILE}" 2>/dev/null | head -n 1 | cut -d= -f2-)

  if [ -z "${_LAST_MODE}" ] || [ -z "${_LAST_STATUS}" ]; then
    _log "[ERROR] State file ${_STATE_FILE} is incomplete. Run DRY-RUN again before using batch mode."
    exit 1
  fi

  if [ "${_LAST_MODE}" != "DRY" ] || [ "${_LAST_STATUS}" != "CLEAN" ]; then
    _log "[ERROR] Batch mode requires last run to be DRY and CLEAN, but got _LAST_MODE='${_LAST_MODE}', _LAST_STATUS='${_LAST_STATUS}' (at ${_LAST_TS})."
    _log "[ERROR] Please run this script in DRY-RUN mode again and ensure no edge cases/errors appear."
    exit 1
  fi

  _log "[INFO] Batch mode: confirmed last run was CLEAN DRY-RUN at ${_LAST_TS}."
  # Invalidate the CLEAN DRY status immediately so another batch cannot reuse it.
  _write_state "BATCH" "BATCH"
}

_finalize_dry_run_state() {
  # Evaluate DRY flags and write state
  if [ "${_DRY_HAS_ERRORS}" = "NO" ] && [ "${_DRY_HAS_EDGE_CASES}" = "NO" ]; then
    _log "[DRY] OK: checks passed (including any pending break-sharing fixes). Batch LIVE mode is allowed."
    _write_state "CLEAN" "DRY"
  else
    _log "[DRY] NOT CLEAN: edge cases and/or errors detected. Batch LIVE mode is NOT allowed."
    # Explain before writing state, so the section is the last thing in the log
    # and in the mail body the operator actually opens.
    _explain_anomalies
    _write_state "NOT_CLEAN" "DRY"
  fi
}


_log_reserved_fs_summary() {
  # End-of-run summary for cumulative break-sharing copy reservations per target filesystem.
  # Helps estimate whether planned batch work will overcommit storage.
  _HAS_RESERVED="NO"

  for _FS_DEV in "${!_FS_RESERVED_KB[@]}"; do
    _HAS_RESERVED="YES"
    break
  done

  if [ "${_HAS_RESERVED}" != "YES" ]; then
    return
  fi

  _log "------------------------------------------------------------------"
  _log "[INFO] Cumulative reservation summary for pending break-sharing copies"

  for _FS_DEV in $(printf '%s\n' "${!_FS_RESERVED_KB[@]}" | sort); do
    _RES_KB="${_FS_RESERVED_KB[${_FS_DEV}]}"
    _FS_FREE_KB=$(df -Pk "${_FS_DEV}" 2>/dev/null | awk 'NR==2 {print $4}')
    _FS_MOUNT=$(df -Pk "${_FS_DEV}" 2>/dev/null | awk 'NR==2 {print $6}')

    if [ -z "${_FS_FREE_KB}" ]; then
      _log "[INFO] ${_FS_DEV}: reserved=${_RES_KB}K, current free=?, projected free=? (unable to read df)"
      continue
    fi

    _FS_PROJ_KB=$(( _FS_FREE_KB - _RES_KB ))
    if [ "${_FS_PROJ_KB}" -lt 0 ]; then
      _FS_PROJ_KB=0
    fi

    if [ -n "${_FS_MOUNT}" ]; then
      _log "[INFO] ${_FS_DEV} (${_FS_MOUNT}): current free=${_FS_FREE_KB}K, reserved=${_RES_KB}K, projected free=${_FS_PROJ_KB}K"
    else
      _log "[INFO] ${_FS_DEV}: current free=${_FS_FREE_KB}K, reserved=${_RES_KB}K, projected free=${_FS_PROJ_KB}K"
    fi
  done
}

_get_site_path() {
  # Extracts site_path from a Drush alias file.
  # Usage: _get_site_path "/path/to/file.alias.drushrc.php"
  _ALIAS_FILE="$1"

  if [ ! -f "${_ALIAS_FILE}" ]; then
    echo ""
    return
  fi

  # Expect line like:
  # 'site_path' => '/data/disk/oXXX/static/.../sites/example.com',
  _LINE=$(grep -E "'site_path'\s*=>" "${_ALIAS_FILE}" 2>/dev/null | head -n 1)

  if [ -z "${_LINE}" ]; then
    echo ""
    return
  fi

  # Split by single quote and take the path part
  _SITE_PATH=$(printf '%s\n' "${_LINE}" | awk -F"'" '{print $4}')
  echo "${_SITE_PATH}"
}

# ---------------------------------------------------------------------------
# [EXPLAINED] diagnostics
# ---------------------------------------------------------------------------
# A single anomaly anywhere in the sweep marks the whole DRY run NOT CLEAN and
# blocks batch/live, but the verdict line names neither the site nor the reason:
# the operator had to find the one [WARN] among hundreds of [INFO] lines, work
# out which site it belonged to, then hand-check the alias, the platform and the
# store to learn what it meant. _explain_anomalies() does exactly that hand-check
# for every recorded finding and prints the result.
#
# All probes are read-only filesystem reads. Drush is deliberately NEVER called:
# this script runs as root with HOME=/root, so a drush run would resolve
# ~/.drush instead of the account's /data/disk/oN/.drush, provision refuses to
# run as root anyway, and it would leave root-owned cache/log files behind in an
# oN-owned tree.
#
# Probe locals are all prefixed _EXP_/_AN_ because this file is global-by-design
# (it has exactly one `local`), and render time is late enough that clobbering a
# name like _SITE_PATH or _ALIAS_FILE would corrupt state a caller still reads.

_explain_log() {
  # One [EXPLAINED] line, through _log so it keeps the timestamp and reaches the
  # log file + the "AutoSymlink Details Report" mail body like everything else.
  # Two literals must never appear in this output: "[APPLY]", which _log counts
  # as an applied change, and "[REPORT] ORPHAN", which updatesymlinks greps
  # (case-sensitively) to decide whether to send an orphan report mail. Use
  # lowercase "orphan" in prose here.
  _log "[EXPLAINED] $*"
}

_explain_wrap() {
  # Emit a remedy sentence at the same width as the rest of the section, so a
  # long fix does not run off the edge of a mail body.
  # Args: 1 label (blank-padded by the caller), 2.. text.
  _EXP_WL="$1"
  shift
  printf '%s\n' "$*" | fold -s -w 74 | sed 's/[[:space:]]*$//' | while IFS= read -r _EXP_WLINE; do
    _explain_log "  ${_EXP_WL}${_EXP_WLINE}"
    _EXP_WL="             "
  done
}

_anom_field() {
  # Echo field <key> of a recorded anomaly, or "" when the key is absent.
  # Args: 1 record, 2 key.
  _AN_REC="$1"
  _AN_KEY="$2"

  case "${_AN_REC}" in
    *"|${_AN_KEY}="*)
      _AN_TAIL="${_AN_REC#*|${_AN_KEY}=}"
      echo "${_AN_TAIL%%|*}"
      ;;
    *)
      echo ""
      ;;
  esac
}

_alias_field() {
  # Read one "'key' => value," field from a Drush alias file, in the two shapes
  # provision-save writes: a quoted string ('root' => '/data/disk/o1/...') and a
  # bare scalar ('site_enabled' => true). Echoes "" when the key is absent.
  # Args: 1 alias file, 2 key.
  _EXP_AF_FILE="$1"
  _EXP_AF_KEY="$2"

  if [ ! -f "${_EXP_AF_FILE}" ]; then
    echo ""
    return
  fi

  _EXP_AF_LINE=$(grep -E "'${_EXP_AF_KEY}'[[:space:]]*=>" "${_EXP_AF_FILE}" 2>/dev/null | head -n 1)
  if [ -z "${_EXP_AF_LINE}" ]; then
    echo ""
    return
  fi

  case "${_EXP_AF_LINE}" in
    *"=>"*"'"*"'"*)
      # Quoted string: same field split as _get_site_path().
      printf '%s\n' "${_EXP_AF_LINE}" | awk -F"'" '{print $4}'
      ;;
    *)
      # Bare scalar (true/false/NULL/number).
      printf '%s\n' "${_EXP_AF_LINE#*=>}" | tr -d " ,"
      ;;
  esac
}

_exp_is_abs_path() {
  # Guard before probing a path taken out of an alias file: only an absolute
  # path is worth stat-ing, and refusing the rest keeps a malformed or hand-edited
  # alias from producing a nonsense probe result.
  case "$1" in
    /*) return 0 ;;
    *)  return 1 ;;
  esac
}

_exp_file_stamp() {
  # Args: 1 path. Echoes "" when the file is gone.
  date -r "$1" "+%Y-%m-%d %H:%M:%S" 2>/dev/null
}

_exp_platform_root() {
  # Resolve a site alias's 'platform' ref (@platform_foo) to the platform's own
  # recorded root. Echoes "" when the platform alias is gone -- itself a finding.
  # Args: 1 account dir, 2 platform ref.
  _EXP_PR_ACCT="$1"
  _EXP_PR_REF="${2#@}"

  if [ -z "${_EXP_PR_REF}" ]; then
    echo ""
    return
  fi
  _alias_field "${_EXP_PR_ACCT}/.drush/${_EXP_PR_REF}.alias.drushrc.php" "root"
}

_exp_site_on_other_platform() {
  # Look for the site's directory under any OTHER platform of this account, which
  # is what a completed-but-unfinished migrate leaves behind. The platform roots
  # come from the account's platform_* Drush aliases (the authoritative registry):
  # a static/*/* glob would sweep static/files, static/control and static/trash,
  # which are not platforms, and would miss the distro/ and aegir/distro/ trees
  # that most platforms actually live in.
  # Args: 1 account dir, 2 site name, 3 the site_path already known to be missing.
  _EXP_OP_ACCT="$1"
  _EXP_OP_SITE="$2"
  _EXP_OP_SKIP="$3"
  _EXP_OP_HIT=""

  for _EXP_OP_ALIAS in "${_EXP_OP_ACCT}"/.drush/platform_*.alias.drushrc.php; do
    [ -f "${_EXP_OP_ALIAS}" ] || continue
    _EXP_OP_ROOT=$(_alias_field "${_EXP_OP_ALIAS}" "root")
    _exp_is_abs_path "${_EXP_OP_ROOT}" || continue
    _EXP_OP_CAND="${_EXP_OP_ROOT}/sites/${_EXP_OP_SITE}"
    [ "${_EXP_OP_CAND}" = "${_EXP_OP_SKIP}" ] && continue
    if [ -d "${_EXP_OP_CAND}" ]; then
      _EXP_OP_HIT="${_EXP_OP_CAND}"
      break
    fi
  done
  echo "${_EXP_OP_HIT}"
}

_exp_client_symlink() {
  # Report the site's clients/<client>/<uri> symlink, which provision points at
  # site_path on install and on verify (_provision_client_create_symlink). It
  # tells apart a site directory that once existed (link present but dangling)
  # from one that never got that far (no link at all).
  # Args: 1 account dir, 2 client name, 3 site name.
  _EXP_CS_LINK="$1/clients/$2/$3"

  if [ -z "$2" ]; then
    echo "not checked (alias records no client_name)"
    return
  fi
  if [ -L "${_EXP_CS_LINK}" ]; then
    if [ -d "${_EXP_CS_LINK}" ]; then
      echo "present and resolves: ${_EXP_CS_LINK}"
    else
      echo "present but DANGLING: ${_EXP_CS_LINK} -> $(readlink "${_EXP_CS_LINK}" 2>/dev/null)"
    fi
    return
  fi
  echo "absent under $1/clients/$2/"
}

_exp_vhost_kind() {
  # Classify a site's nginx vhost the way symlinkinfo does: BOA rewrites a
  # DISABLED site's vhost into an inert placeholder on the nginx default docroot,
  # while an enabled site keeps a real docroot vhost.
  # Args: 1 vhost file.
  if [ ! -f "$1" ]; then
    echo "absent"
    return
  fi
  if grep -qE 'Do not reveal Aegir front-end URL|root[[:space:]]+/var/www/nginx-default' "$1" 2>/dev/null; then
    echo "present, disabled placeholder (inert, serves nothing)"
  else
    echo "present, real docroot (nginx still serves this name)"
  fi
}

_exp_store_state() {
  # Describe the per-site store, which answers the only question that matters
  # before any cleanup: is there data to lose here? A site delete never removes
  # the store, so a store here can outlive its site.
  # Args: 1 account dir, 2 site name.
  _EXP_ST_DIR="$1/static/files/$2"

  if [ -d "${_EXP_ST_DIR}" ]; then
    _EXP_ST_KB=$(du -sk "${_EXP_ST_DIR}" 2>/dev/null | awk 'NR==1 {print $1}')
    echo "present at ${_EXP_ST_DIR} (${_EXP_ST_KB:-?}K) -- DATA PRESENT, do not remove by hand"
  else
    echo "none at ${_EXP_ST_DIR} (no files data at stake)"
  fi
}

_explain_ghost_alias() {
  # SITE_PATH_DIR_ABSENT: the alias parses and names a site_path, but that
  # directory is not on disk. The account sweep only reaches a site that has BOTH
  # a Drush alias and an nginx vhost, so this is Aegir context outliving its site.
  # Walk platform -> sites/ -> this site's dir and let the first level that fails
  # name the cause; report the store and the vhost either way.
  # Args: 1 site, 2 account dir, 3 alias file, 4 missing site_path.
  _EXP_GA_SITE="$1"
  _EXP_GA_ACCT="$2"
  _EXP_GA_ALIAS="$3"
  _EXP_GA_PATH="$4"

  # The alias can be rewritten or removed by a task between detection and here;
  # say so rather than reporting every field as missing and calling it corrupt.
  if [ ! -f "${_EXP_GA_ALIAS}" ]; then
    _explain_log "  Seen: the Drush alias named a site_path that was not on disk."
    _explain_log "  Alias      : ${_EXP_GA_ALIAS} -- GONE since the check"
    _explain_log "  Diagnosis  : the alias was removed while this run was in progress, so a task"
    _explain_log "    was working on this site during the sweep."
    _explain_log "  Fix        : re-run the dry run; this finding should not come back."
    return
  fi

  _EXP_GA_URI=$(_alias_field "${_EXP_GA_ALIAS}" "uri")
  _EXP_GA_SROOT=$(_alias_field "${_EXP_GA_ALIAS}" "root")
  _EXP_GA_PLAT=$(_alias_field "${_EXP_GA_ALIAS}" "platform")
  _EXP_GA_ENABLED=$(_alias_field "${_EXP_GA_ALIAS}" "site_enabled")
  _EXP_GA_CLIENT=$(_alias_field "${_EXP_GA_ALIAS}" "client_name")
  _EXP_GA_PROOT=$(_exp_platform_root "${_EXP_GA_ACCT}" "${_EXP_GA_PLAT}")
  _EXP_GA_STAMP=$(_exp_file_stamp "${_EXP_GA_ALIAS}")
  _EXP_GA_VHOST=$(_exp_vhost_kind "${_EXP_GA_ACCT}/config/server_master/nginx/vhost.d/${_EXP_GA_SITE}")
  _EXP_GA_STORE=$(_exp_store_state "${_EXP_GA_ACCT}" "${_EXP_GA_SITE}")

  _explain_log "  Seen: the Drush alias names a site_path that is not on disk, so the site was"
  _explain_log "    skipped and the run was marked NOT CLEAN."
  _explain_log "  Alias      : ${_EXP_GA_ALIAS}${_EXP_GA_STAMP:+ (modified ${_EXP_GA_STAMP})}"
  _explain_log "  site_path  : ${_EXP_GA_PATH} -- MISSING"
  _explain_log "  Alias says : platform=${_EXP_GA_PLAT:-?} uri=${_EXP_GA_URI:-?} site_enabled=${_EXP_GA_ENABLED:-?} client=${_EXP_GA_CLIENT:-?}"
  _explain_log "  nginx vhost: ${_EXP_GA_VHOST}"
  _explain_log "  Files store: ${_EXP_GA_STORE}"

  if [ -z "${_EXP_GA_SROOT}" ] && [ -z "${_EXP_GA_PROOT}" ]; then
    _explain_log "  Platform   : the alias records no 'root' and its platform alias is gone"
    _explain_log "  Diagnosis  : INCOMPLETE ALIAS -- the platform behind this site cannot be"
    _explain_log "    resolved at all, so the alias is corrupt or truncated rather than merely"
    _explain_log "    stale."
    _EXP_GA_FIX="Verify the site's platform in the Aegir front-end to rewrite its contexts."
  elif ! _exp_is_abs_path "${_EXP_GA_PROOT:-${_EXP_GA_SROOT}}"; then
    _explain_log "  Platform   : recorded root is not an absolute path: '${_EXP_GA_PROOT:-${_EXP_GA_SROOT}}'"
    _explain_log "  Diagnosis  : INCOMPLETE ALIAS -- the recorded platform root is malformed."
    _EXP_GA_FIX="Verify the site's platform in the Aegir front-end to rewrite its contexts."
  elif [ ! -d "${_EXP_GA_PROOT:-${_EXP_GA_SROOT}}" ]; then
    _explain_log "  Platform   : ${_EXP_GA_PROOT:-${_EXP_GA_SROOT}} -- MISSING"
    _explain_log "  Diagnosis  : PLATFORM GONE -- the whole platform directory is missing, so"
    _explain_log "    every site on it is a ghost, not just this one. Deleting a platform that"
    _explain_log "    still had sites removes the platform root and the platform's own alias,"
    _explain_log "    but leaves each site's alias and vhost behind; a platform moved or"
    _explain_log "    removed outside Aegir looks identical from here."
    _explain_log "    Expect sibling findings for the other sites of the same platform."
    _EXP_GA_FIX="Restore or rebuild the platform if the sites are still wanted; otherwise delete the platform and its sites in the Aegir front-end so the contexts go with them."
  elif [ ! -d "${_EXP_GA_PROOT:-${_EXP_GA_SROOT}}/sites" ]; then
    _explain_log "  Platform   : ${_EXP_GA_PROOT:-${_EXP_GA_SROOT}} (present)"
    _explain_log "  Platform sites/: MISSING"
    _explain_log "  Diagnosis  : BROKEN PLATFORM -- the platform directory exists but has no"
    _explain_log "    sites/ tree, so it is not a usable Drupal docroot (an incomplete or"
    _explain_log "    half-built platform)."
    _EXP_GA_FIX="Verify (or rebuild) the platform in the Aegir front-end."
  else
    _EXP_GA_ROOT="${_EXP_GA_PROOT:-${_EXP_GA_SROOT}}"
    _EXP_GA_SIBS=$(ls -1 "${_EXP_GA_ROOT}/sites" 2>/dev/null | grep -c .)
    _EXP_GA_ELSE=$(_exp_site_on_other_platform "${_EXP_GA_ACCT}" "${_EXP_GA_SITE}" "${_EXP_GA_PATH}")
    _explain_log "  Platform   : ${_EXP_GA_ROOT} (present, sites/ entries: ${_EXP_GA_SIBS:-0})"

    if [ -n "${_EXP_GA_URI}" ] && [ "${_EXP_GA_URI}" != "${_EXP_GA_SITE}" ]; then
      _explain_log "  Alias name : file is named for '${_EXP_GA_SITE}' but its own uri is '${_EXP_GA_URI}'"
      _explain_log "  Diagnosis  : RENAME LEFTOVER -- a rename/migrate writes one alias file per"
      _explain_log "    name and only unlinks the site's current name, so this file is a leftover"
      _explain_log "    under the OLD name while the live site runs under '${_EXP_GA_URI}'."
      _EXP_GA_FIX="Confirm '${_EXP_GA_URI}' is healthy in the Aegir front-end; this leftover alias belongs to the old name."
    elif [ -n "${_EXP_GA_ELSE}" ]; then
      _explain_log "  Site dir   : FOUND on a different platform: ${_EXP_GA_ELSE}"
      _explain_log "  Diagnosis  : MIGRATE STRANDED -- this alias names a platform that has no"
      _explain_log "    directory for the site, while the site's data still sits on the platform"
      _explain_log "    shown above. A migrate re-points the alias at the new platform before the"
      _explain_log "    new directory is deployed, so an interrupted migrate leaves exactly this"
      _explain_log "    split. Which of the two platforms is the newer one cannot be told from"
      _explain_log "    disk alone."
      _explain_log "    The data shown above is intact -- do not delete anything."
      _EXP_GA_FIX="Verify the site in the Aegir front-end so its alias matches where the site actually lives; if the migrate failed, re-run or roll it back from the front-end."
    elif [ -n "${_EXP_GA_SROOT}" ] && [ -n "${_EXP_GA_PROOT}" ] && [ "${_EXP_GA_SROOT}" != "${_EXP_GA_PROOT}" ]; then
      _explain_log "  Site dir   : MISSING (not found on any other platform of this account)"
      _explain_log "  Root drift : alias root='${_EXP_GA_SROOT}' but platform alias root='${_EXP_GA_PROOT}'"
      _explain_log "  Diagnosis  : STALE ALIAS -- the site alias's cached root disagrees with its"
      _explain_log "    own platform's current root, so the alias was written against a platform"
      _explain_log "    layout that no longer holds."
      _EXP_GA_FIX="Verify the site in the Aegir front-end to rewrite its alias from the front-end database."
    else
      _EXP_GA_CS=$(_exp_client_symlink "${_EXP_GA_ACCT}" "${_EXP_GA_CLIENT}" "${_EXP_GA_SITE}")
      _explain_log "  Site dir   : MISSING (not found on any other platform of this account)"
      _explain_log "  Client link: ${_EXP_GA_CS}"
      _explain_log "  Diagnosis  : GHOST ALIAS -- the platform is healthy and still hosts other"
      _explain_log "    sites, but this site's directory exists nowhere. Aegir context was"
      _explain_log "    written for a site that was never finished or whose directory was removed"
      _explain_log "    later: typically an install or clone that failed or was rolled back, or a"
      _explain_log "    directory removed outside Aegir. An interrupted DELETE is ruled out --"
      _explain_log "    delete unlinks the alias first and the directory second, so a half-done"
      _explain_log "    delete leaves the opposite (a directory with no alias)."
      case "${_EXP_GA_CS}" in
        *DANGLING*)
          _explain_log "    The dangling client symlink says the directory DID exist once, so this"
          _explain_log "    is a rolled-back install/clone or a later manual removal."
          ;;
        absent*)
          _explain_log "    No client symlink was ever created, which points at an install/clone"
          _explain_log "    that died before it got that far rather than a later removal."
          ;;
      esac
      _EXP_GA_FIX="Nothing here is recoverable from disk. Resolve the stale context in the Aegir front-end: delete the site, or re-run the failed install/clone."
    fi
  fi

  case "${_EXP_GA_VHOST}" in
    *"real docroot"*)
      # An enabled vhost roots at the PLATFORM, not at site_path, so nginx keeps
      # answering for the name (and configtest keeps passing) with no site behind
      # it. A disabled site would instead have an inert placeholder vhost.
      _explain_log "  Note       : this name still has an enabled vhost rather than a disabled"
      _explain_log "    placeholder, so nginx keeps answering for it with no site behind it --"
      _explain_log "    visitors get errors rather than a disabled page. Disabling the site in"
      _explain_log "    the Aegir front-end makes the vhost inert."
      ;;
  esac

  _explain_wrap "Fix        : " "${_EXP_GA_FIX}"
  _explain_log "    Removing the alias file by hand is NOT a fix: the alias is only provision's"
  _explain_log "    cache of the front-end database, and the next Verify task writes it back."
  _explain_log "    Nightly maintenance can move the leftover alias and vhost aside once the"
  _explain_log "    ghost is confirmed across runs (_GHOST_SITES_CLEANUP=YES) and notify the"
  _explain_log "    account owner to remove the front-end record (_GHOST_CLIENT_NOTIFY=YES)."
  _explain_log "    History for this name: symlinkinfo ${_EXP_GA_SITE}"
}

_explain_alias_no_site_path() {
  # ALIAS_NO_SITE_PATH: the alias file is there and vhost-paired, but no
  # 'site_path' line could be read out of it at all.
  # Args: 1 site, 2 account dir, 3 alias file.
  _EXP_NP_SITE="$1"
  _EXP_NP_ACCT="$2"
  _EXP_NP_ALIAS="$3"

  if [ ! -f "${_EXP_NP_ALIAS}" ]; then
    _explain_log "  Seen: no 'site_path' could be read from the alias."
    _explain_log "  Alias      : ${_EXP_NP_ALIAS} -- GONE since the check"
    _explain_log "  Diagnosis  : the alias was removed while this run was in progress, so a task"
    _explain_log "    was working on this site during the sweep."
    _explain_log "  Fix        : re-run the dry run; this finding should not come back."
    return
  fi

  _EXP_NP_STAMP=$(_exp_file_stamp "${_EXP_NP_ALIAS}")
  _EXP_NP_CTX=$(_alias_field "${_EXP_NP_ALIAS}" "context_type")
  _EXP_NP_URI=$(_alias_field "${_EXP_NP_ALIAS}" "uri")
  _EXP_NP_ROOT=$(_alias_field "${_EXP_NP_ALIAS}" "root")
  _EXP_NP_BYTES=$(wc -c < "${_EXP_NP_ALIAS}" 2>/dev/null | tr -d " ")
  _EXP_NP_OWNER=$(ls -ld "${_EXP_NP_ALIAS}" 2>/dev/null | awk '{print $3":"$4" "$1}')

  _explain_log "  Seen: no 'site_path' could be read from the alias, so the site was skipped"
  _explain_log "    and the run was marked NOT CLEAN."
  _explain_log "  Alias      : ${_EXP_NP_ALIAS}${_EXP_NP_STAMP:+ (modified ${_EXP_NP_STAMP})}"
  _explain_log "  Alias size : ${_EXP_NP_BYTES:-?} bytes, owner/mode ${_EXP_NP_OWNER:-?}"
  _explain_log "  Alias says : context_type=${_EXP_NP_CTX:-<none>} uri=${_EXP_NP_URI:-<none>} root=${_EXP_NP_ROOT:-<none>}"
  _explain_log "  Files store: $(_exp_store_state "${_EXP_NP_ACCT}" "${_EXP_NP_SITE}")"

  if [ -n "${_EXP_NP_CTX}" ] && [ "${_EXP_NP_CTX}" != "site" ]; then
    _explain_log "  Diagnosis  : NOT A SITE CONTEXT -- this alias describes a '${_EXP_NP_CTX}',"
    _explain_log "    which has no site_path by design, yet a vhost exists under the same name,"
    _explain_log "    which is why the sweep picked it up as a site."
    _explain_log "  Fix        : check why an nginx vhost exists for a ${_EXP_NP_CTX} context named"
    _explain_log "    '${_EXP_NP_SITE}'; the alias itself is not the problem."
  elif [ "${_EXP_NP_BYTES:-0}" -lt 100 ] 2>/dev/null; then
    _explain_log "  Diagnosis  : TRUNCATED ALIAS -- the file is far too short to be a complete"
    _explain_log "    site alias, so it was most likely cut off while being written."
    _explain_log "  Fix        : Verify the site in the Aegir front-end to rewrite the alias."
  else
    _explain_log "  Diagnosis  : MALFORMED ALIAS -- the file exists and looks site-sized, but"
    _explain_log "    carries no readable site_path line."
    _explain_log "  Fix        : inspect the file, then Verify the site in the Aegir front-end to"
    _explain_log "    rewrite it from the front-end database."
  fi
  _explain_log "    Removing the alias file by hand is NOT a fix: the next Verify writes it back."
}

_explain_symlink_broken() {
  # SYMLINK_EMPTY_OR_BROKEN: the in-site path IS a symlink but readlink gave
  # nothing back.
  # Args: 1 site, 2 account dir, 3 type, 4 path.
  _EXP_SB_SITE="$1"
  _EXP_SB_ACCT="$2"
  _EXP_SB_TYPE="$3"
  _EXP_SB_PATH="$4"

  _explain_log "  Seen: the in-site ${_EXP_SB_TYPE} path is a symlink whose target could not be"
  _explain_log "    read, so it was skipped and the run was marked NOT CLEAN."
  _explain_log "  Symlink    : ${_EXP_SB_PATH}"
  _explain_log "  Reads back : '$(readlink "${_EXP_SB_PATH}" 2>&1)'"
  if [ -L "${_EXP_SB_PATH}" ]; then
    _explain_log "  Still a symlink now: yes"
  else
    _explain_log "  Still a symlink now: NO -- it changed since the check, so a task was probably"
    _explain_log "    running over this site during the sweep; re-run the dry run."
  fi
  _explain_log "  Files store: $(_exp_store_state "${_EXP_SB_ACCT}" "${_EXP_SB_SITE}")"
  _explain_log "  Diagnosis  : BROKEN SYMLINK -- autosymlink will not repoint a link it cannot"
  _explain_log "    read, because it cannot tell whose data is on the other side."
  _explain_log "  Fix        : inspect the link above. If the store shown holds this site's data,"
  _explain_log "    the link can be recreated to point at it; otherwise Verify the site in the"
  _explain_log "    Aegir front-end and re-run the dry run."
}

_explain_symlink_unknown() {
  # SYMLINK_UNKNOWN_PATTERN: the only edge-case (rather than error) finding.
  # Args: 1 site, 2 account dir, 3 type, 4 path, 5 link target.
  _EXP_SU_SITE="$1"
  _EXP_SU_ACCT="$2"
  _EXP_SU_TYPE="$3"
  _EXP_SU_PATH="$4"
  _EXP_SU_TGT="$5"

  _explain_log "  Seen: the in-site ${_EXP_SU_TYPE} symlink points somewhere that does not match"
  _explain_log "    the expected .../static/files/<site>/${_EXP_SU_TYPE} store layout, so the"
  _explain_log "    script refused to guess who owns the target and marked the run NOT CLEAN."
  _explain_log "  Symlink    : ${_EXP_SU_PATH}"
  _explain_log "  Points at  : ${_EXP_SU_TGT}"
  # readlink hands back the link text verbatim, and a hand-made link -- exactly
  # the population that lands here -- is often relative. Resolve it against the
  # link's own directory before probing: this script never chdir's, so testing
  # the raw text would answer from cron's cwd and could call a live link
  # dangling (or size up an unrelated directory). Absolute targets are unchanged.
  if _exp_is_abs_path "${_EXP_SU_TGT}"; then
    _EXP_SU_PROBE="${_EXP_SU_TGT}"
  else
    _EXP_SU_PROBE="${_EXP_SU_PATH%/*}/${_EXP_SU_TGT}"
  fi
  if [ -e "${_EXP_SU_PROBE}" ]; then
    _EXP_SU_KB=$(du -sk "${_EXP_SU_PROBE}" 2>/dev/null | awk 'NR==1 {print $1}')
    _explain_log "  Target     : exists (${_EXP_SU_KB:-?}K) -- the site's ${_EXP_SU_TYPE} are being"
    _explain_log "    served from there right now, so this link is live"
  else
    _explain_log "  Target     : DOES NOT EXIST -- this link is dangling, so the site's"
    _explain_log "    ${_EXP_SU_TYPE} are unavailable to it right now"
  fi
  case "${_EXP_SU_TGT}" in
    /data/disk/*) _explain_log "  Location   : inside /data/disk (an Aegir account tree)" ;;
    /*)           _explain_log "  Location   : OUTSIDE /data/disk -- points off the Aegir account tree" ;;
    *)            _explain_log "  Location   : a RELATIVE link, resolved against ${_EXP_SU_PATH%/*}" ;;
  esac
  _explain_log "  Files store: $(_exp_store_state "${_EXP_SU_ACCT}" "${_EXP_SU_SITE}")"
  _explain_log "  Diagnosis  : NON-STANDARD SYMLINK -- most often a hand-made link (an admin"
  _explain_log "    pointing files at attached storage, or a leftover from a manual migration)."
  _explain_log "    It is reported rather than touched, on purpose: repointing it blindly could"
  _explain_log "    strand live data."
  _explain_log "  Fix        : if the link is intentional, move the data under the per-site store"
  _explain_log "    (.../static/files/${_EXP_SU_SITE}/${_EXP_SU_TYPE}) and relink so the sweep"
  _explain_log "    can manage it; if it is a leftover, remove it and Verify the site in the"
  _explain_log "    Aegir front-end. Until then this finding keeps batch/live blocked."
}

_explain_break_sharing_source() {
  # BREAK_SHARING_SOURCE_MISSING: this site's link points at another site's store
  # and the source we would copy from is gone.
  # Args: 1 site, 2 account dir, 3 type, 4 path, 5 link target, 6 target site,
  #       7 original top.
  _EXP_BS_SITE="$1"
  _EXP_BS_ACCT="$2"
  _EXP_BS_TYPE="$3"
  _EXP_BS_PATH="$4"
  _EXP_BS_TGT="$5"
  _EXP_BS_TSITE="$6"
  _EXP_BS_ORIG="$7"

  _explain_log "  Seen: this site's ${_EXP_BS_TYPE} are shared from another site's store, and the"
  _explain_log "    source to copy from is missing, so un-sharing would fail and the run was"
  _explain_log "    marked NOT CLEAN."
  _explain_log "  Symlink    : ${_EXP_BS_PATH}"
  _explain_log "  Points at  : ${_EXP_BS_TGT} (store owned by ${_EXP_BS_TSITE})"
  _explain_log "  Copy source: ${_EXP_BS_ORIG} -- MISSING"

  # The store's owner can live in ANOTHER account: an inherited cross-account
  # symlink (a clone of a shared site into a different account) points into the
  # source account's store, which is why the break-sharing path derives its copy
  # source from the link's own prefix rather than from this account. Probe the
  # owner where the link actually points, or a cross-account share reports its
  # recoverable data as lost. Same-account shares are unaffected: the prefix
  # equals this account.
  _EXP_BS_OWNACCT="${_EXP_BS_TGT%%/static/files/*}"
  if [ -z "${_EXP_BS_OWNACCT}" ] || [ "${_EXP_BS_OWNACCT}" = "${_EXP_BS_TGT}" ]; then
    _EXP_BS_OWNACCT="${_EXP_BS_ACCT}"
  fi

  _EXP_BS_OWNER_ALIAS="${_EXP_BS_OWNACCT}/.drush/${_EXP_BS_TSITE}.alias.drushrc.php"
  if [ -f "${_EXP_BS_OWNER_ALIAS}" ]; then
    _explain_log "  Owner site : ${_EXP_BS_TSITE} still has an alias in $(basename "${_EXP_BS_OWNACCT}")"
  else
    _explain_log "  Owner site : ${_EXP_BS_TSITE} has NO alias in $(basename "${_EXP_BS_OWNACCT}") -- it looks deleted"
  fi
  if [ "${_EXP_BS_OWNACCT}" != "${_EXP_BS_ACCT}" ]; then
    _explain_log "  Note       : this is a CROSS-ACCOUNT share -- the store belongs to account"
    _explain_log "    $(basename "${_EXP_BS_OWNACCT}"), not to $(basename "${_EXP_BS_ACCT}")"
  fi

  # The nightly sweep archives a deleted site's leftover store into .archived, so
  # a source that vanished is very often sitting there rather than lost.
  _EXP_BS_ARCH=""
  for _EXP_BS_CAND in "${_EXP_BS_OWNACCT}"/static/files/.archived/*/"${_EXP_BS_TSITE}"; do
    if [ -e "${_EXP_BS_CAND}" ]; then
      _EXP_BS_ARCH="${_EXP_BS_CAND}"
    fi
  done
  if [ -n "${_EXP_BS_ARCH}" ]; then
    _EXP_BS_AKB=$(du -sk "${_EXP_BS_ARCH}" 2>/dev/null | awk 'NR==1 {print $1}')
    _explain_log "  Archived   : the owner's store WAS archived by an earlier sweep and is still"
    _explain_log "    on disk: ${_EXP_BS_ARCH} (${_EXP_BS_AKB:-?}K)"
    _explain_log "  Diagnosis  : SHARED FROM AN ARCHIVED STORE -- ${_EXP_BS_TSITE} was deleted and"
    _explain_log "    its leftover store archived aside, which pulled the data out from under"
    _explain_log "    this site's symlink. The data is not lost; it is in the archive above."
    _explain_log "  Fix        : restore the archived copy to ${_EXP_BS_ORIG}, or copy it straight"
    _explain_log "    to ${_EXP_BS_ACCT}/static/files/${_EXP_BS_SITE}/${_EXP_BS_TYPE} and repoint"
    _explain_log "    the link, then re-run the dry run."
  else
    _explain_log "  Archived   : no archived copy of ${_EXP_BS_TSITE} found under $(basename "${_EXP_BS_OWNACCT}")"
    _explain_log "  Diagnosis  : SHARED FROM A MISSING STORE -- this site's ${_EXP_BS_TYPE} link"
    _explain_log "    points into a store that no longer exists, so the site has no ${_EXP_BS_TYPE}"
    _explain_log "    right now and the un-share has nothing to copy."
    _explain_log "  Fix        : restore ${_EXP_BS_ORIG} from backup if the data is wanted, or"
    _explain_log "    remove/repoint the dangling link and Verify the site in the Aegir front-end."
  fi
  _explain_log "    History for both names: symlinkinfo ${_EXP_BS_SITE} ${_EXP_BS_TSITE}"
}

_explain_space() {
  # The four _check_space_for_transfer findings. Re-read df/du now rather than
  # reprinting the recorded numbers, so the operator sees whether the condition
  # still holds.
  # Args: 1 code, 2 record.
  _EXP_SP_CODE="$1"
  _EXP_SP_REC="$2"

  _EXP_SP_SITE=$(_anom_field "${_EXP_SP_REC}" "site")
  _EXP_SP_DESC=$(_anom_field "${_EXP_SP_REC}" "desc")
  _EXP_SP_SRC=$(_anom_field "${_EXP_SP_REC}" "src_dir")
  _EXP_SP_TGT=$(_anom_field "${_EXP_SP_REC}" "target_check")
  _EXP_SP_NEED=$(_anom_field "${_EXP_SP_REC}" "size_kb")
  _EXP_SP_AVAIL=$(_anom_field "${_EXP_SP_REC}" "avail_kb")
  _EXP_SP_RES=$(_anom_field "${_EXP_SP_REC}" "reserved_kb")

  _explain_log "  Operation  : ${_EXP_SP_DESC:-?} for site ${_EXP_SP_SITE}"
  _explain_log "  Source     : ${_EXP_SP_SRC:-?}"

  case "${_EXP_SP_CODE}" in
    SPACE_SRC_DIR_MISSING)
      _explain_log "  Seen: the directory to transfer does not exist."
      if [ -e "${_EXP_SP_SRC}" ]; then
        _explain_log "  Now        : it EXISTS again -- it was created or restored since the check,"
        _explain_log "    so a task was probably running over this site during the sweep."
        _explain_log "  Fix        : re-run the dry run; it should come back clean."
      else
        _explain_log "  Now        : still missing"
        _explain_log "  Diagnosis  : the site's ${_EXP_SP_DESC##* } directory is gone from the"
        _explain_log "    platform while the site is still registered."
        _explain_log "  Fix        : Verify the site in the Aegir front-end, which recreates the"
        _explain_log "    missing site directories, then re-run the dry run."
      fi
      ;;
    SPACE_SIZE_UNKNOWN)
      _EXP_SP_NOW=$(du -sk "${_EXP_SP_SRC}" 2>&1 | awk 'NR==1 {print $1}')
      _explain_log "  Seen: the source size could not be measured (du returned nothing)."
      _explain_log "  Now        : du reports '${_EXP_SP_NOW:-nothing}'"
      _explain_log "  Owner/mode : $(ls -ld "${_EXP_SP_SRC}" 2>&1 | awk '{print $3":"$4" "$1}')"
      _explain_log "  Diagnosis  : the source could not be read. An unreadable directory is the"
      _explain_log "    usual cause -- for example ownership changed to root by an edit made as"
      _explain_log "    root -- or it vanished mid-sweep."
      _explain_log "  Fix        : make the source readable (restore its oN ownership if a root"
      _explain_log "    edit changed it), then re-run the dry run."
      ;;
    SPACE_TARGET_AVAIL_UNKNOWN)
      _explain_log "  Seen: free space on the target could not be read (df returned nothing)."
      _explain_log "  Target     : ${_EXP_SP_TGT:-?}"
      _explain_log "  Now        : df says '$(df -Pk "${_EXP_SP_TGT}" 2>&1 | awk 'NR==2 {print $4"K free on "$1}')'"
      _explain_log "  Diagnosis  : the target filesystem could not be queried -- typically a mount"
      _explain_log "    that is not there (attached storage for static/files), rather than a"
      _explain_log "    problem with the site itself."
      _explain_log "  Fix        : check the mount behind ${_EXP_SP_TGT:-the target}, then re-run"
      _explain_log "    the dry run."
      ;;
    SPACE_INSUFFICIENT)
      _explain_log "  Seen: the transfer does not fit on the target filesystem."
      _explain_log "  Needs      : ${_EXP_SP_NEED:-?}K"
      _explain_log "  Target     : ${_EXP_SP_TGT:-?}"
      _explain_log "  At check   : ${_EXP_SP_AVAIL:-?}K free${_EXP_SP_RES:+, ${_EXP_SP_RES}K already reserved for other planned copies this run}"
      _explain_log "  Now        : $(df -Pk "${_EXP_SP_TGT}" 2>/dev/null | awk 'NR==2 {print $4"K free on "$1" ("$6")"}')"
      _explain_log "  Diagnosis  : OUT OF SPACE -- nothing is wrong with the site; the target"
      _explain_log "    filesystem cannot hold the copy. Reservations are cumulative across the"
      _explain_log "    run, so several planned copies onto one filesystem are counted together"
      _explain_log "    rather than each 'fitting' on its own."
      _explain_log "  Fix        : free space on the target, then re-run the dry run. The archived"
      _explain_log "    store pile under <account>/static/files/.archived is never pruned"
      _explain_log "    automatically and is usually the cheapest thing to reclaim -- the report"
      _explain_log "    run lists its size per account."
      ;;
  esac
}

_explain_anomalies() {
  # Render the [EXPLAINED] section for every finding recorded this run.
  _EXP_N="${#_ANOMALIES[@]}"

  if [ "${_EXP_N}" -eq 0 ]; then
    return 0
  fi

  _log "=================================================================="
  if [ "${_EXP_N}" -eq 1 ]; then
    _explain_log "1 finding made this run NOT CLEAN. It is re-checked below against the"
  else
    _explain_log "${_EXP_N} findings made this run NOT CLEAN. Each is re-checked below against the"
  fi
  _explain_log "filesystem as it is right now, and nothing here was changed."
  # The narrow run is a Provision install/clone hook: it has no batch gate to
  # block, it just declined to convert this one site.
  if [ "${_NARROW}" = "YES" ]; then
    _explain_log "The files/private conversion for this site was skipped as a result."
  else
    _explain_log "Batch and live mode stay blocked until every finding is resolved and a fresh"
    _explain_log "dry run reports CLEAN."
  fi

  _EXP_I=0
  while [ "${_EXP_I}" -lt "${_EXP_N}" ]; do
    _EXP_REC="${_ANOMALIES[${_EXP_I}]}"
    _EXP_I=$(( _EXP_I + 1 ))
    _EXP_CODE="${_EXP_REC%%|*}"
    _EXP_SITE=$(_anom_field "${_EXP_REC}" "site")
    _EXP_ACCT=$(_anom_field "${_EXP_REC}" "account_dir")
    _EXP_ALIAS=$(_anom_field "${_EXP_REC}" "alias")

    _log "------------------------------------------------------------------"
    _explain_log "(${_EXP_I}/${_EXP_N}) ${_EXP_CODE} -- site ${_EXP_SITE:-?} in account $(basename "${_EXP_ACCT:-?}")"

    case "${_EXP_CODE}" in
      SITE_PATH_DIR_ABSENT)
        _explain_ghost_alias "${_EXP_SITE}" "${_EXP_ACCT}" "${_EXP_ALIAS}" \
          "$(_anom_field "${_EXP_REC}" "site_path")"
        ;;
      ALIAS_NO_SITE_PATH)
        _explain_alias_no_site_path "${_EXP_SITE}" "${_EXP_ACCT}" "${_EXP_ALIAS}"
        ;;
      SYMLINK_EMPTY_OR_BROKEN)
        _explain_symlink_broken "${_EXP_SITE}" "${_EXP_ACCT}" \
          "$(_anom_field "${_EXP_REC}" "type")" "$(_anom_field "${_EXP_REC}" "path")"
        ;;
      SYMLINK_UNKNOWN_PATTERN)
        _explain_symlink_unknown "${_EXP_SITE}" "${_EXP_ACCT}" \
          "$(_anom_field "${_EXP_REC}" "type")" "$(_anom_field "${_EXP_REC}" "path")" \
          "$(_anom_field "${_EXP_REC}" "link_target")"
        ;;
      BREAK_SHARING_SOURCE_MISSING)
        _explain_break_sharing_source "${_EXP_SITE}" "${_EXP_ACCT}" \
          "$(_anom_field "${_EXP_REC}" "type")" "$(_anom_field "${_EXP_REC}" "path")" \
          "$(_anom_field "${_EXP_REC}" "link_target")" \
          "$(_anom_field "${_EXP_REC}" "target_site")" \
          "$(_anom_field "${_EXP_REC}" "original_top")"
        ;;
      SPACE_*)
        _explain_space "${_EXP_CODE}" "${_EXP_REC}"
        ;;
      *)
        _explain_log "  No explainer for this code; raw record: ${_EXP_REC}"
        ;;
    esac
  done
  _log "------------------------------------------------------------------"
}

_ask_confirm_site() {
  # Ask once per site if we should perform the prepared actions.
  # Expects "yes" or "Y" (case-insensitive).
  _SITE_NAME="$1"

  echo
  echo "READY TO APPLY CHANGES FOR SITE: ${_SITE_NAME}"
  printf "Type 'yes' or 'Y' to proceed, anything else to skip: "
  read _ANSWER

  case "${_ANSWER}" in
    y|Y|yes|Yes|YES)
      return 0
      ;;
    *)
      _log "[LIVE] Skipping changes for site: ${_SITE_NAME}"
      return 1
      ;;
  esac
}

_make_unique_target() {
  # Ensure the given path becomes unique by renaming the existing
  # file/dir/symlink to PATH-<timestamp>-<pid>-<random>
  _TARGET="$1"

  if [ ! -e "${_TARGET}" ] && [ ! -L "${_TARGET}" ]; then
    return
  fi

  _SUFFIX="$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"
  _NEW_TARGET="${_TARGET}-${_SUFFIX}"

  _log "[APPLY] Target exists, renaming: ${_TARGET} -> ${_NEW_TARGET}"
  mv "${_TARGET}" "${_NEW_TARGET}"
}

_archive_existing_store_target() {
  # Move a pre-existing per-site store target ASIDE into a timestamped archive
  # UNDER the store itself: static/files/.archived/<stamp>/<site>/<type>. The
  # leading-dot .archived is skipped by the orphan/site scan (it ignores .*), so
  # it is never mistaken for a live/orphan site, while a script that knows the
  # path still tracks it. Keeping it under static/files (NOT a static/files-*
  # sibling) guarantees the archive lands on the SAME filesystem as the store:
  # static/files may be a symlink to a large dedicated disk, whereas a sibling
  # would fall on the possibly-tiny root filesystem, turning a free rename into a
  # cross-FS copy that can fill the disk. Used when a fresh install/clone reuses a
  # site name whose store dir was left behind by a prior lifecycle (site delete
  # does not remove it): a non-destructive self-heal. ALWAYS archives (never
  # skips) and ALWAYS reports the incident with a disk-space snapshot for the
  # ghost, even when space is ample. Degrades to an in-place rename if the archive
  # would be a cross-FS move that does not fit, or if the move fails, so it never
  # blocks the conversion.
  # Args: 1 store target to move aside (.../static/files/<site>/<type>)
  #       2 account dir (/data/disk/oX)
  #       3 site name
  #       4 type label (files|private)
  _ARCH_SRC="$1"
  _ARCH_ACCOUNT_DIR="$2"
  _ARCH_SITE="$3"
  _ARCH_TYPE="$4"

  if [ ! -e "${_ARCH_SRC}" ] && [ ! -L "${_ARCH_SRC}" ]; then
    return 0
  fi

  # Run-scoped stamp so a site's files + private land under one archive dir; fall
  # back to a fresh stamp if _process_site did not set it.
  _ARCH_STAMP="${_ARCHIVE_STAMP:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
  _ARCH_BASE="${_ARCH_ACCOUNT_DIR}/static/files/.archived/${_ARCH_STAMP}/${_ARCH_SITE}"

  # Disk-space snapshot for the archived ghost only, ALWAYS reported (even with
  # ample space): the ghost's own size and the free space where the archive lands.
  _ARCH_SRC_KB=$(du -sk "${_ARCH_SRC}" 2>/dev/null | awk 'NR==1 {print $1}')
  _ARCH_SRC_KB="${_ARCH_SRC_KB:-?}"
  _ARCH_AVAIL_KB=$(df -Pk "${_ARCH_ACCOUNT_DIR}/static/files" 2>/dev/null | awk 'NR==2 {print $4}')
  _ARCH_AVAIL_KB="${_ARCH_AVAIL_KB:-?}"
  _log "[REPORT] ORPHAN archive incident: ${_ARCH_SITE}/${_ARCH_TYPE} stale store size=${_ARCH_SRC_KB}K -> static/files/.archived/${_ARCH_STAMP}/ (target FS avail=${_ARCH_AVAIL_KB}K)"

  if ! mkdir -p "${_ARCH_BASE}"; then
    _log "[WARN] Could not create archive dir ${_ARCH_BASE}; renaming ${_ARCH_SRC} aside in place instead"
    _make_unique_target "${_ARCH_SRC}"
    return 0
  fi

  _ARCH_DST="${_ARCH_BASE}/${_ARCH_TYPE}"
  if [ -e "${_ARCH_DST}" ] || [ -L "${_ARCH_DST}" ]; then
    _make_unique_target "${_ARCH_DST}"
  fi

  # Secondary space check: .archived under static/files is normally the SAME
  # device as the ghost (free rename). If it is somehow a different device and the
  # ghost would not fit in the archive target's free space, do NOT risk a cross-FS
  # copy that could fill the disk -- keep it in place (a same-device rename aside).
  _ARCH_SRC_DEV=$(df -P "${_ARCH_SRC}" 2>/dev/null | awk 'NR==2 {print $1}')
  _ARCH_DST_DEV=$(df -P "${_ARCH_BASE}" 2>/dev/null | awk 'NR==2 {print $1}')
  if [ -n "${_ARCH_SRC_DEV}" ] && [ -n "${_ARCH_DST_DEV}" ] \
    && [ "${_ARCH_SRC_DEV}" != "${_ARCH_DST_DEV}" ] \
    && [ "${_ARCH_SRC_KB}" != "?" ] && [ "${_ARCH_AVAIL_KB}" != "?" ] \
    && [ "${_ARCH_SRC_KB}" -gt "${_ARCH_AVAIL_KB}" ]; then
    _log "[WARN] Archive target is a different filesystem (${_ARCH_DST_DEV}) with insufficient space (need ${_ARCH_SRC_KB}K, avail ${_ARCH_AVAIL_KB}K) for ${_ARCH_SITE}/${_ARCH_TYPE}; renaming ${_ARCH_SRC} aside in place instead"
    _make_unique_target "${_ARCH_SRC}"
    return 0
  fi

  _log "[APPLY] Archiving stale store target: ${_ARCH_SRC} -> ${_ARCH_DST}"
  if ! mv "${_ARCH_SRC}" "${_ARCH_DST}"; then
    _log "[WARN] Archive move failed for ${_ARCH_TYPE} of site ${_ARCH_SITE}; renaming ${_ARCH_SRC} aside in place instead"
    _make_unique_target "${_ARCH_SRC}"
  fi
  return 0
}

_archive_orphan_store() {
  # Archive a whole DELETED-site leftover store (static/files/<site>/) ASIDE into
  # static/files/.archived/<stamp>/<site>/ -- the same hidden, same-filesystem archive
  # the reuse self-heal uses, with the same layout (…/<site>/files, …/<site>/private).
  # NEVER deletes: pruning the .archived pile stays operator-only. Same-device free
  # rename; if the archive would be a cross-FS move that does not fit, leave the orphan
  # in place and report, so it can never fill a tiny root fs. The CALLER only invokes
  # this for a store whose name has NEITHER a drush alias NOR a vhost (a genuinely
  # deleted site) -- a merely-disabled site keeps its alias and is left untouched.
  # Args: 1 store dir (…/static/files/<site>), 2 account dir, 3 site name, 4 size KB
  _ORPH_SRC="$1"
  _ORPH_ACCT="$2"
  _ORPH_SITE="$3"
  _ORPH_KB="$4"

  { [ -e "${_ORPH_SRC}" ] || [ -L "${_ORPH_SRC}" ]; } || return 0

  # Run/account-scoped stamp so all orphans of one sweep land under one archive dir.
  _ORPH_STAMP="${_ARCHIVE_STAMP:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
  _ORPH_BASE="${_ORPH_ACCT}/static/files/.archived/${_ORPH_STAMP}"
  _ORPH_DST="${_ORPH_BASE}/${_ORPH_SITE}"

  _ORPH_AVAIL_KB=$(df -Pk "${_ORPH_ACCT}/static/files" 2>/dev/null | awk 'NR==2 {print $4}')
  _ORPH_AVAIL_KB="${_ORPH_AVAIL_KB:-?}"
  _log "[REPORT] ORPHAN archive incident: ${_ORPH_SITE} deleted-site leftover size=${_ORPH_KB}K -> static/files/.archived/${_ORPH_STAMP}/ (target FS avail=${_ORPH_AVAIL_KB}K)"

  if ! mkdir -p "${_ORPH_BASE}"; then
    _log "[WARN] Could not create archive dir ${_ORPH_BASE}; leaving orphan store ${_ORPH_SRC} in place"
    return 0
  fi
  if [ -e "${_ORPH_DST}" ] || [ -L "${_ORPH_DST}" ]; then
    _make_unique_target "${_ORPH_DST}"
  fi

  # Same-device guard: .archived under static/files is normally the SAME device as the
  # store (free rename). If it is somehow a different device and the orphan would not
  # fit, do NOT risk a cross-FS copy that could fill the disk -- leave it in place.
  _ORPH_SRC_DEV=$(df -P "${_ORPH_SRC}" 2>/dev/null | awk 'NR==2 {print $1}')
  _ORPH_DST_DEV=$(df -P "${_ORPH_BASE}" 2>/dev/null | awk 'NR==2 {print $1}')
  if [ -n "${_ORPH_SRC_DEV}" ] && [ -n "${_ORPH_DST_DEV}" ] \
    && [ "${_ORPH_SRC_DEV}" != "${_ORPH_DST_DEV}" ] \
    && [ "${_ORPH_KB}" != "?" ] && [ "${_ORPH_AVAIL_KB}" != "?" ] \
    && [ "${_ORPH_KB}" -gt "${_ORPH_AVAIL_KB}" ]; then
    _log "[WARN] Archive target is a different filesystem (${_ORPH_DST_DEV}) with insufficient space (need ${_ORPH_KB}K, avail ${_ORPH_AVAIL_KB}K) for orphan ${_ORPH_SITE}; leaving in place"
    return 0
  fi

  _log "[APPLY] Archiving orphan store (deleted-site leftover): ${_ORPH_SRC} -> ${_ORPH_DST}"
  if ! mv "${_ORPH_SRC}" "${_ORPH_DST}"; then
    _log "[WARN] Archive move failed for orphan store ${_ORPH_SITE}; leaving ${_ORPH_SRC} in place"
    return 0
  fi
  return 0
}

_check_space_for_transfer() {
  # Args:
  #   1: source directory
  #   2: target base directory (where new dir will live, e.g. /data/disk/oX/static/files/SITE)
  #   3: description (e.g. "move files", "copy private")
  #   4: site name
  #   5: force detailed check (YES/NO, optional)
  _SRC_DIR="$1"
  _TARGET_BASE="$2"
  _DESC="$3"
  _SITE="$4"
  _FORCE_DETAILED_CHECK="$5"

  if [ ! -d "${_SRC_DIR}" ]; then
    _log "[WARN] Source directory missing for ${_DESC} of site ${_SITE}: ${_SRC_DIR}"
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      # Returns before the target device/space is resolved, so there is no
      # df/du context to record here yet.
      _record_anomaly "SPACE_SRC_DIR_MISSING" "site=${_SITE}" "account_dir=${_ACCOUNT_DIR}" \
        "desc=${_DESC}" "src_dir=${_SRC_DIR}" "target_base=${_TARGET_BASE}"
    fi
    return 1
  fi

  # Resolve the target filesystem by walking up to the nearest EXISTING ancestor.
  # A brand-new account may not have the static/files store base at all, in which
  # case a single dirname still lands on a non-existent path and df returns nothing
  # -- a false "Unable to determine available space" that fails the DRY run
  # (NOT CLEAN) so batch never gets to auto-create the store. Walking up until a
  # real directory is found yields the correct device (the same FS a later mkdir -p
  # would land on), so a same-FS account is correctly seen as a free rename and the
  # DRY run stays CLEAN. If static/files is a symlink onto attached storage the loop
  # stops at it (-d follows the link), so the cross-FS space check still runs.
  _TARGET_CHECK="${_TARGET_BASE}"
  while [ -n "${_TARGET_CHECK}" ] && [ "${_TARGET_CHECK}" != "/" ] && [ ! -d "${_TARGET_CHECK}" ]; do
    _TARGET_CHECK=$(dirname "${_TARGET_CHECK}")
  done

  # Detect source and target devices
  _SRC_DEV=$(df -P "${_SRC_DIR}" 2>/dev/null | awk 'NR==2 {print $1}')
  _TGT_DEV=$(df -P "${_TARGET_CHECK}" 2>/dev/null | awk 'NR==2 {print $1}')

  # If we got both devs and they match, a move on the same FS usually does not need
  # extra free space. However, for copy operations used to break shared symlinks we
  # must still verify there is enough space even on the same filesystem.
  if [ -n "${_SRC_DEV}" ] && [ -n "${_TGT_DEV}" ] && [ "${_SRC_DEV}" = "${_TGT_DEV}" ]; then
    if [ "${_FORCE_DETAILED_CHECK}" = "YES" ]; then
      _log "[INFO] Same filesystem detected for ${_DESC} of site ${_SITE} (${_SRC_DEV}) but detailed space check is required for copy operation."
    else
      _log "[INFO] Space check skipped for ${_DESC} of site ${_SITE}: source and target on same filesystem (${_SRC_DEV})."
      return 0
    fi
  fi

  # Build FS pair key if possible
  _KEY="${_SRC_DEV}|${_TGT_DEV}"

  # For anomaly handling (copy ... break sharing), always run a real per-site du/df check.
  # We may still log global pair info for visibility, but we must not skip the detailed check.
  if [ "${_FORCE_DETAILED_CHECK}" = "YES" ]; then
    if [ -n "${_SRC_DEV}" ] && [ -n "${_TGT_DEV}" ]; then
      _SRC_USED_KB=$(df -Pk "${_SRC_DIR}" 2>/dev/null | awk 'NR==2 {print $3}')
      _AVAIL_TGT_KB=$(df -Pk "${_TARGET_CHECK}" 2>/dev/null | awk 'NR==2 {print $4}')
      if [ -n "${_SRC_USED_KB}" ] && [ -n "${_AVAIL_TGT_KB}" ]; then
        _log "[INFO] Global filesystem snapshot for ${_DESC} of site ${_SITE}: pair ${_KEY}, src used=${_SRC_USED_KB}K, tgt avail=${_AVAIL_TGT_KB}K (informational only; per-site du/df check will still run)"
      fi
    fi
  else
    # If we already know this pair is SPACIOUS, skip per-site checks (normal move logic only)
    if [ -n "${_SRC_DEV}" ] && [ -n "${_TGT_DEV}" ] && [ -n "${_FS_PAIR_STATUS[${_KEY}]+x}" ]; then
      if [ "${_FS_PAIR_STATUS[${_KEY}]}" = "SPACIOUS" ]; then
        _log "[INFO] Space check skipped for ${_DESC} of site ${_SITE}: filesystem pair ${_KEY} already marked SPACIOUS."
        return 0
      fi
      # If marked TIGHT, we fall through to detailed per-site check below
    fi

    # If this FS pair hasn't been classified yet and we have dev IDs, try a global check.
    if [ -n "${_SRC_DEV}" ] && [ -n "${_TGT_DEV}" ] && [ -z "${_FS_PAIR_STATUS[${_KEY}]+x}" ]; then
      _SRC_USED_KB=$(df -Pk "${_SRC_DIR}" 2>/dev/null | awk 'NR==2 {print $3}')
      _AVAIL_TGT_KB=$(df -Pk "${_TARGET_CHECK}" 2>/dev/null | awk 'NR==2 {print $4}')

      if [ -n "${_SRC_USED_KB}" ] && [ -n "${_AVAIL_TGT_KB}" ] && [ "${_AVAIL_TGT_KB}" -ge "${_SRC_USED_KB}" ]; then
        _FS_PAIR_STATUS[${_KEY}]="SPACIOUS"
        _log "[INFO] Filesystem pair ${_KEY} marked SPACIOUS (src used=${_SRC_USED_KB}K, tgt avail=${_AVAIL_TGT_KB}K) – skipping per-site size checks."
        return 0
      else
        _FS_PAIR_STATUS[${_KEY}]="TIGHT"
        _log "[INFO] Filesystem pair ${_KEY} marked TIGHT or unknown (src used=${_SRC_USED_KB:-?}K, tgt avail=${_AVAIL_TGT_KB:-?}K) – will run per-site space checks."
        # Fall through to per-site du logic
      fi
    fi
  fi

  # Per-site detailed size check (fallback when FS pair is TIGHT or devs unknown)
  _SIZE_KB=$(du -sk "${_SRC_DIR}" 2>/dev/null | awk '{print $1}')
  if [ -z "${_SIZE_KB}" ]; then
    _log "[WARN] Unable to determine size for ${_SRC_DIR} (${_DESC} of site ${_SITE})"
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      _record_anomaly "SPACE_SIZE_UNKNOWN" "site=${_SITE}" "account_dir=${_ACCOUNT_DIR}" \
        "desc=${_DESC}" "src_dir=${_SRC_DIR}" "target_check=${_TARGET_CHECK}"
    fi
    return 1
  fi

  _AVAIL_KB=$(df -Pk "${_TARGET_CHECK}" 2>/dev/null | awk 'NR==2 {print $4}')
  if [ -z "${_AVAIL_KB}" ]; then
    _log "[WARN] Unable to determine available space on ${_TARGET_CHECK} (${_DESC} of site ${_SITE})"
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      _record_anomaly "SPACE_TARGET_AVAIL_UNKNOWN" "site=${_SITE}" "account_dir=${_ACCOUNT_DIR}" \
        "desc=${_DESC}" "src_dir=${_SRC_DIR}" "size_kb=${_SIZE_KB}" "target_check=${_TARGET_CHECK}"
    fi
    return 1
  fi

  _RESERVED_KB=0
  _IS_BREAK_SHARING="NO"
  _USE_CUMULATIVE_RESERVATION="NO"
  if printf '%s' "${_DESC}" | grep -q "break sharing"; then
    _IS_BREAK_SHARING="YES"
    # Cumulative reservation is for planning only (DRY mode).
    # In LIVE/BATCH, df reflects actual space after each completed copy,
    # so keeping reservations would double-count and cause false warnings.
    if [ "${_MODE}" = "DRY" ]; then
      _USE_CUMULATIVE_RESERVATION="YES"
    fi
  fi
  if [ "${_USE_CUMULATIVE_RESERVATION}" = "YES" ]; then
    if [ -n "${_TGT_DEV}" ] && [ -n "${_FS_RESERVED_KB[${_TGT_DEV}]+x}" ]; then
      _RESERVED_KB="${_FS_RESERVED_KB[${_TGT_DEV}]}"
    fi
  fi

  _EFFECTIVE_AVAIL_KB="${_AVAIL_KB}"
  if [ "${_RESERVED_KB}" -gt 0 ]; then
    _EFFECTIVE_AVAIL_KB=$(( _AVAIL_KB - _RESERVED_KB ))
    if [ "${_EFFECTIVE_AVAIL_KB}" -lt 0 ]; then
      _EFFECTIVE_AVAIL_KB=0
    fi
  fi

  if [ "${_EFFECTIVE_AVAIL_KB}" -lt "${_SIZE_KB}" ]; then
    if [ "${_IS_BREAK_SHARING}" = "YES" ] && [ "${_USE_CUMULATIVE_RESERVATION}" = "YES" ]; then
      _log "[WARN] Not enough space on ${_TARGET_CHECK} for ${_DESC} of site ${_SITE}: need ${_SIZE_KB}K, free now ${_AVAIL_KB}K, already reserved ${_RESERVED_KB}K, effective free ${_EFFECTIVE_AVAIL_KB}K"
    elif [ "${_IS_BREAK_SHARING}" = "YES" ]; then
      _log "[WARN] Not enough space on ${_TARGET_CHECK} for ${_DESC} of site ${_SITE}: need ${_SIZE_KB}K, free now ${_AVAIL_KB}K"
    else
      _log "[WARN] Not enough space on ${_TARGET_CHECK} for ${_DESC} of site ${_SITE}: need ${_SIZE_KB}K, have ${_EFFECTIVE_AVAIL_KB}K"
    fi
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      _record_anomaly "SPACE_INSUFFICIENT" "site=${_SITE}" "account_dir=${_ACCOUNT_DIR}" \
        "desc=${_DESC}" "src_dir=${_SRC_DIR}" "size_kb=${_SIZE_KB}" \
        "avail_kb=${_AVAIL_KB}" "reserved_kb=${_RESERVED_KB}" "target_check=${_TARGET_CHECK}"
    fi
    return 1
  fi

  if [ "${_IS_BREAK_SHARING}" = "YES" ]; then
    _AFTER_COPY_KB=$(( _EFFECTIVE_AVAIL_KB - _SIZE_KB ))
    if [ "${_USE_CUMULATIVE_RESERVATION}" = "YES" ]; then
      _log "[INFO] Ready to copy for ${_DESC} of site ${_SITE}: source size=${_SIZE_KB}K, target free now=${_AVAIL_KB}K, reserved on fs=${_RESERVED_KB}K, effective free=${_EFFECTIVE_AVAIL_KB}K, projected free after copy=${_AFTER_COPY_KB}K on ${_TARGET_CHECK}"
    else
      _log "[INFO] Ready to copy for ${_DESC} of site ${_SITE}: source size=${_SIZE_KB}K, target free now=${_AVAIL_KB}K, projected free after copy=${_AFTER_COPY_KB}K on ${_TARGET_CHECK}"
    fi
    if [ "${_USE_CUMULATIVE_RESERVATION}" = "YES" ] && [ -n "${_TGT_DEV}" ]; then
      _FS_RESERVED_KB[${_TGT_DEV}]=$(( _RESERVED_KB + _SIZE_KB ))
      _log "[INFO] Reserved cumulative space for pending break-sharing copies on ${_TGT_DEV}: ${_FS_RESERVED_KB[${_TGT_DEV}]}K"
    fi
  else
    _log "[INFO] Space check OK for ${_DESC} of site ${_SITE}: need ${_SIZE_KB}K, available ${_EFFECTIVE_AVAIL_KB}K on ${_TARGET_CHECK}"
  fi
  return 0
}

_check_symlink_sharing() {
  # Args:
  #   1: path to symlink (e.g. /.../sites/example.com/files)
  #   2: type: "files" or "private"
  #   3: site name (e.g. example.com)
  #   4: account dir (/data/disk/o1)
  _PATH="$1"
  _TYPE="$2"
  _SITE_NAME="$3"
  _ACCOUNT_DIR="$4"

  if [ ! -L "${_PATH}" ]; then
    return
  fi

  _LINK_TARGET=$(readlink "${_PATH}")

  if [ -z "${_LINK_TARGET}" ]; then
    _log "[WARN] ${_TYPE} symlink for site ${_SITE_NAME} is empty or broken: ${_PATH}"
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      _record_anomaly "SYMLINK_EMPTY_OR_BROKEN" "site=${_SITE_NAME}" "account_dir=${_ACCOUNT_DIR}" \
        "type=${_TYPE}" "path=${_PATH}"
    fi
    return
  fi

  # Expect something like /data/disk/o1/static/files/OTHER-SITE/files[/...]
  case "${_LINK_TARGET}" in
    *"/static/files/"*/"${_TYPE}"|*"/static/files/"*/"${_TYPE}/"|*"/static/files/"*/"${_TYPE}/"* )
      _AFTER="${_LINK_TARGET#*/static/files/}"
      _TARGET_SITE_NAME="${_AFTER%%/*}"
      ;;
    *)
      # Unknown layout; in REPORT we just note it, in DRY we treat as edge case.
      if [ "${_MODE}" = "REPORT" ]; then
        _log "[REPORT] ${_TYPE} symlink for site ${_SITE_NAME} has non-standard target: ${_LINK_TARGET}"
        return
      fi
      _log "[WARN] ${_TYPE} symlink for site ${_SITE_NAME} points to unknown pattern: ${_LINK_TARGET} – skipping"
      if [ "${_MODE}" = "DRY" ]; then
        _DRY_HAS_EDGE_CASES="YES"
        # The only edge-case (rather than error) finding in the script.
        # _TARGET_SITE_NAME is deliberately not recorded: this is the case where
        # the target layout did not parse, so no owner site is known.
        _record_anomaly "SYMLINK_UNKNOWN_PATTERN" "site=${_SITE_NAME}" "account_dir=${_ACCOUNT_DIR}" \
          "type=${_TYPE}" "path=${_PATH}" "link_target=${_LINK_TARGET}"
      fi
      return
      ;;
  esac

  # REPORT mode: just classify and exit.
  if [ "${_MODE}" = "REPORT" ]; then
    if [ "${_TARGET_SITE_NAME}" = "${_SITE_NAME}" ]; then
      # Proper, non-shared symlink.
      _log "[REPORT] ${_TYPE} symlink for site ${_SITE_NAME} → self (${_TARGET_SITE_NAME}), OK, target='${_LINK_TARGET}'"
      return
    fi

    _CONTROL_DIR="${_ACCOUNT_DIR}/static/control"
    _SHARE_THIS="${_CONTROL_DIR}/share.files.${_SITE_NAME}.info"
    _SHARE_TARGET="${_CONTROL_DIR}/share.files.${_TARGET_SITE_NAME}.info"

    _INTENT="ACCIDENTAL"
    if [ -f "${_SHARE_THIS}" ] || [ -f "${_SHARE_TARGET}" ]; then
      _INTENT="INTENTIONAL"
      _SITE_HAS_INTENTIONAL_SHARED_SYMLINK="YES"
    else
      _SITE_NEEDS_SHARED_SYMLINK_FIX="YES"
    fi

    _log "[REPORT] ${_TYPE} symlink for site ${_SITE_NAME} → ${_TARGET_SITE_NAME} (${_INTENT}), target='${_LINK_TARGET}'"
    return
  fi

  # For non-REPORT modes, continue with normal sharing logic.

  if [ "${_TARGET_SITE_NAME}" = "${_SITE_NAME}" ]; then
    return
  fi

  _CONTROL_DIR="${_ACCOUNT_DIR}/static/control"
  _SHARE_THIS="${_CONTROL_DIR}/share.files.${_SITE_NAME}.info"
  _SHARE_TARGET="${_CONTROL_DIR}/share.files.${_TARGET_SITE_NAME}.info"

  if [ "${_FORCE_UNSHARE}" = "YES" ]; then
    # Clone path: a freshly cloned site never opted into sharing, so break an
    # inherited cross-account symlink even when a share control file exists for
    # the source/target site (it belongs to the source, not this new clone).
    if [ -f "${_SHARE_THIS}" ] || [ -f "${_SHARE_TARGET}" ]; then
      _log "[INFO] ${_TYPE} symlink for site ${_SITE_NAME} points to ${_TARGET_SITE_NAME} with a share control file present, but --force-unshare is set – breaking sharing for this site"
    fi
  elif [ -f "${_SHARE_THIS}" ] || [ -f "${_SHARE_TARGET}" ]; then
    _SITE_HAS_INTENTIONAL_SHARED_SYMLINK="YES"
    _log "[INFO] ${_TYPE} symlink for site ${_SITE_NAME} intentionally shares with ${_TARGET_SITE_NAME} (control file present) – leaving as is"
    return
  fi

  _SITE_NEEDS_SHARED_SYMLINK_FIX="YES"

  _NEW_TARGET_BASE="${_ACCOUNT_DIR}/static/files/${_SITE_NAME}"
  # Derive the copy source from the link's OWN /static/files prefix, not the
  # current account, so an inherited cross-account symlink (e.g. a clone of a
  # shared site into a different account) copies from the real source store.
  # Same-account shares are unaffected (the prefix equals ${_ACCOUNT_DIR}).
  _LINK_PREFIX="${_LINK_TARGET%%/static/files/*}"
  _ORIGINAL_TOP="${_LINK_PREFIX}/static/files/${_TARGET_SITE_NAME}/${_TYPE}"
  _NEW_TARGET="${_NEW_TARGET_BASE}/${_TYPE}"

  _log "[INFO] ${_TYPE} symlink for site ${_SITE_NAME} currently points to ${_LINK_TARGET} (owned by ${_TARGET_SITE_NAME})"
  _log "[PLAN] Break sharing: copy from ${_ORIGINAL_TOP} to ${_NEW_TARGET} and update symlink at ${_PATH}"

  if [ "${_MODE}" = "LIVE" ] && [ "${_LIVE_SITE_APPROVED}" != "YES" ]; then
    if ! _ask_confirm_site "${_SITE_NAME}"; then
      _log "[LIVE] Skipping shared symlink fix for site: ${_SITE_NAME}"
      _SITE_SHARED_SYMLINK_FIX_SKIPPED="YES"
      return
    fi
    _LIVE_SITE_APPROVED="YES"
  fi

  if [ "${_MODE}" = "DRY" ]; then
    if [ ! -d "${_ORIGINAL_TOP}" ]; then
      _log "[WARN] Original ${_TYPE} directory not found at ${_ORIGINAL_TOP} – would fail breaking sharing"
      _DRY_HAS_ERRORS="YES"
      # No inline mode test here on purpose: this whole block is already DRY-only.
      _record_anomaly "BREAK_SHARING_SOURCE_MISSING" "site=${_SITE_NAME}" "account_dir=${_ACCOUNT_DIR}" \
        "type=${_TYPE}" "path=${_PATH}" "link_target=${_LINK_TARGET}" \
        "target_site=${_TARGET_SITE_NAME}" "original_top=${_ORIGINAL_TOP}"
      return
    fi
    # Check space on target filesystem (if different FS)
    if ! _check_space_for_transfer "${_ORIGINAL_TOP}" "${_NEW_TARGET_BASE}" "copy ${_TYPE} (break sharing)" "${_SITE_NAME}" "YES"; then
      # _check_space_for_transfer already logged + flagged DRY errors if needed
      return
    fi
    return
  fi

  if [ ! -d "${_ORIGINAL_TOP}" ]; then
    _log "[WARN] Original ${_TYPE} directory not found at ${_ORIGINAL_TOP} – cannot break sharing for ${_SITE_NAME}"
    _SITE_SHARED_SYMLINK_FIX_SKIPPED="YES"
    return
  fi

  # LIVE / BATCH: space check
  if ! _check_space_for_transfer "${_ORIGINAL_TOP}" "${_NEW_TARGET_BASE}" "copy ${_TYPE} (break sharing)" "${_SITE_NAME}" "YES"; then
    _log "[WARN] Skipping breaking sharing for ${_TYPE} of site ${_SITE_NAME} due to insufficient space."
    _SITE_SHARED_SYMLINK_FIX_SKIPPED="YES"
    return
  fi

  if [ -e "${_NEW_TARGET_BASE}" ] && [ ! -d "${_NEW_TARGET_BASE}" ]; then
    _make_unique_target "${_NEW_TARGET_BASE}"
  fi

  if [ ! -d "${_NEW_TARGET_BASE}" ]; then
    _log "[APPLY] Creating directory: ${_NEW_TARGET_BASE}"
    mkdir -p "${_NEW_TARGET_BASE}"
  fi

  if [ -e "${_NEW_TARGET}" ] || [ -L "${_NEW_TARGET}" ]; then
    # A pre-existing store at this (renamed/migrated) target name is a stale ghost
    # from a prior lifecycle: archive it aside (tracked, into static/files/.archived)
    # rather than renaming it in place, so break-sharing collisions are handled the
    # same way as the local-convert path (_convert_dir_to_symlink) and land in the
    # reported/prunable archive instead of cluttering the live store.
    _archive_existing_store_target "${_NEW_TARGET}" "${_ACCOUNT_DIR}" "${_SITE_NAME}" "${_TYPE}"
  fi

  _log "[APPLY] Copying ${_ORIGINAL_TOP} -> ${_NEW_TARGET}"
  mkdir -p "${_NEW_TARGET}"
  if ! rsync -a --no-devices --no-specials "${_ORIGINAL_TOP}/" "${_NEW_TARGET}/"; then
    _log "[ERROR] rsync failed for site ${_SITE_NAME} (${_TYPE}: ${_ORIGINAL_TOP} -> ${_NEW_TARGET}) – leaving symlink unchanged."
    _SITE_SHARED_SYMLINK_FIX_SKIPPED="YES"
    return
  fi

  _log "[APPLY] Updating symlink: ${_PATH} -> ${_NEW_TARGET}"
  rm -f "${_PATH}"
  if ! ln -s "${_NEW_TARGET}" "${_PATH}"; then
    _log "[ERROR] Failed to create symlink for site ${_SITE_NAME} (${_TYPE}: ${_PATH} -> ${_NEW_TARGET})"
    _SITE_SHARED_SYMLINK_FIX_SKIPPED="YES"
    return
  fi
  _match_symlink_owner "${_PATH}" "${_NEW_TARGET}"
  _SITE_SHARED_SYMLINK_FIX_APPLIED="YES"
}

_match_symlink_owner() {
  # Set an in-site files/private symlink's OWN owner:group to match its store
  # target, so the link does not linger root-owned when no later perms-fix
  # re-chowns it. On install a subsequent fix-drupal-site-ownership run fixes it;
  # on clone the unshare's rm+ln -s is the LAST step, so without this the clone's
  # link stays root:root until the next verify. Best-effort (chown -h
  # --reference is GNU coreutils; a failure is harmless).
  # Args: 1 in-site symlink path, 2 store target dir (reference for owner:group).
  [ -L "$1" ] && chown -h --reference="$2" "$1" 2>/dev/null
  return 0
}

_self_heal_symlink() {
  # Recover a site left without an in-site files/private link by an interrupted
  # prior conversion: if the in-site path is gone but the store dir still holds
  # the data, recreate the symlink. This closes the only non-atomic window in
  # _convert_dir_to_symlink (between a successful move and the `ln -s`).
  # Args: 1 in-site path, 2 store target dir.
  _SITE_LINK="$1"
  _STORE_DIR="$2"

  if [ "${_MODE}" = "REPORT" ] || [ "${_MODE}" = "DRY" ]; then
    return 0
  fi
  if [ -e "${_SITE_LINK}" ] || [ -L "${_SITE_LINK}" ]; then
    return 0
  fi
  if [ -d "${_STORE_DIR}" ] && [ -n "$(ls -A "${_STORE_DIR}" 2>/dev/null)" ]; then
    _log "[APPLY] Self-heal: in-site path missing, recreating symlink ${_SITE_LINK} -> ${_STORE_DIR}"
    ln -s "${_STORE_DIR}" "${_SITE_LINK}"
    _match_symlink_owner "${_SITE_LINK}" "${_STORE_DIR}"
  fi
}

_convert_dir_to_symlink() {
  # Crash-safe conversion of a real in-site directory into a symlink pointing at
  # the per-site store. Replaces the former non-atomic `mv; ln -s` pair.
  #
  # Safety invariants:
  #   - rc-checked move: `mv` removes the source only after a successful copy
  #     (same-fs = atomic rename, cross-fs = copy-then-unlink), so the source dir
  #     survives any move failure; on failure we leave the real dir in place and
  #     never create a symlink.
  #   - the only non-atomic window is between a successful move and `ln -s`; it is
  #     recovered by _self_heal_symlink() on the next run. Concurrent converters
  #     are corruption-safe: the losing `mv` fails (source already gone) and
  #     self-heal/idempotency repoint to the winner's store dir.
  # Args: 1 in-site real dir, 2 store target dir, 3 type label, 4 site name.
  # Returns 0 on success, 1 on hard error (real dir left intact).
  _SRC="$1"
  _DST="$2"
  _TYPE="$3"
  _SITE="$4"

  if [ ! -d "${_SRC}" ] || [ -L "${_SRC}" ]; then
    return 0
  fi

  if [ -e "${_DST}" ] || [ -L "${_DST}" ]; then
    # Archive a stale store target aside (non-destructive) rather than renaming it
    # in place, so a reused site name never collides with a prior lifecycle's store.
    _archive_existing_store_target "${_DST}" "${_ACCOUNT_DIR}" "${_SITE}" "${_TYPE}"
  fi

  _log "[APPLY] Moving: ${_SRC} -> ${_DST}"
  if ! mv "${_SRC}" "${_DST}"; then
    _log "[ERROR] Move failed for ${_TYPE} of site ${_SITE}: ${_SRC} -> ${_DST}; leaving real dir in place (no symlink created)"
    return 1
  fi

  _log "[APPLY] Creating symlink: ${_SRC} -> ${_DST}"
  if ! ln -s "${_DST}" "${_SRC}"; then
    _log "[ERROR] Failed to create symlink for ${_TYPE} of site ${_SITE}: ${_SRC} -> ${_DST}; data is safe in ${_DST}, self-heal will retry the link"
    return 1
  fi
  _match_symlink_owner "${_SRC}" "${_DST}"
  return 0
}

_process_site() {
  # Handle single site for given account.
  # Args:
  #   1: account name (e.g. o1)
  #   2: account dir (e.g. /data/disk/o1)
  #   3: site name (e.g. example.com)
  #   4: alias file (e.g. /data/disk/o1/.drush/example.com.alias.drushrc.php)
  _ACCOUNT_NAME="$1"
  _ACCOUNT_DIR="$2"
  _SITE_NAME="$3"
  _ALIAS_FILE="$4"

  _SITE_PATH=$(_get_site_path "${_ALIAS_FILE}")

  if [ -z "${_SITE_PATH}" ]; then
    _log "[WARN] No site_path found for ${_SITE_NAME} in ${_ALIAS_FILE} – skipping"
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      _record_anomaly "ALIAS_NO_SITE_PATH" "site=${_SITE_NAME}" "account_dir=${_ACCOUNT_DIR}" \
        "alias=${_ALIAS_FILE}"
    fi
    return
  fi

  if [ ! -d "${_SITE_PATH}" ]; then
    _log "[WARN] site_path directory does not exist for ${_SITE_NAME}: ${_SITE_PATH} – skipping"
    if [ "${_MODE}" = "DRY" ]; then
      _DRY_HAS_ERRORS="YES"
      _record_anomaly "SITE_PATH_DIR_ABSENT" "site=${_SITE_NAME}" "account_dir=${_ACCOUNT_DIR}" \
        "alias=${_ALIAS_FILE}" "site_path=${_SITE_PATH}"
    fi
    return
  fi

  _FILES_PATH="${_SITE_PATH}/files"
  _PRIVATE_PATH="${_SITE_PATH}/private"

  _TARGET_BASE="${_ACCOUNT_DIR}/static/files/${_SITE_NAME}"
  # One archive timestamp per site run, so a stale store's files + private land
  # together under static/files/.archived/<stamp>/<site>/.
  _ARCHIVE_STAMP="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  _DO_FILES_CONVERT="NO"
  _DO_PRIVATE_CONVERT="NO"

  # Recover any site left without an in-site files/private link by an interrupted
  # prior conversion (store dir present, in-site link missing). No-op in DRY/REPORT.
  _self_heal_symlink "${_FILES_PATH}" "${_TARGET_BASE}/files"
  _self_heal_symlink "${_PRIVATE_PATH}" "${_TARGET_BASE}/private"

  # Per-site flags used for summary / LIVE confirmation re-use
  _LIVE_SITE_APPROVED="NO"
  _SITE_NEEDS_SHARED_SYMLINK_FIX="NO"
  _SITE_HAS_INTENTIONAL_SHARED_SYMLINK="NO"
  _SITE_SHARED_SYMLINK_FIX_APPLIED="NO"
  _SITE_SHARED_SYMLINK_FIX_SKIPPED="NO"

  # Decide what needs to be done for files/
  if [ -d "${_FILES_PATH}" ] && [ ! -L "${_FILES_PATH}" ]; then
    _DO_FILES_CONVERT="YES"
  fi

  # Decide what needs to be done for private/
  if [ -d "${_PRIVATE_PATH}" ] && [ ! -L "${_PRIVATE_PATH}" ]; then
    _DO_PRIVATE_CONVERT="YES"
  fi

  _HAS_LOCAL_CONVERT="NO"
  if [ "${_DO_FILES_CONVERT}" = "YES" ] || [ "${_DO_PRIVATE_CONVERT}" = "YES" ]; then
    _HAS_LOCAL_CONVERT="YES"
  fi

  _log "------------------------------------------------------------------"
  _log "[INFO] Site: ${_SITE_NAME}"
  _log "[INFO] Alias: ${_ALIAS_FILE}"
  _log "[INFO] site_path: ${_SITE_PATH}"

  # Always inspect symlinks, even when files/private are already symlinks,
  # because they may accidentally point to another site's target.
  if [ -L "${_FILES_PATH}" ]; then
    _check_symlink_sharing "${_FILES_PATH}" "files" "${_SITE_NAME}" "${_ACCOUNT_DIR}"
  fi
  if [ -L "${_PRIVATE_PATH}" ]; then
    _check_symlink_sharing "${_PRIVATE_PATH}" "private" "${_SITE_NAME}" "${_ACCOUNT_DIR}"
  fi

  # Clearer one-line summary per site after symlink inspection.
  _SHARED_FIX_SUMMARY="shared symlink fix needed"
  if [ "${_SITE_NEEDS_SHARED_SYMLINK_FIX}" = "YES" ] && [ "${_MODE}" != "DRY" ] && [ "${_MODE}" != "REPORT" ]; then
    if [ "${_SITE_SHARED_SYMLINK_FIX_APPLIED}" = "YES" ] && [ "${_SITE_SHARED_SYMLINK_FIX_SKIPPED}" = "YES" ]; then
      _SHARED_FIX_SUMMARY="shared symlink fix partially applied"
    elif [ "${_SITE_SHARED_SYMLINK_FIX_APPLIED}" = "YES" ]; then
      _SHARED_FIX_SUMMARY="shared symlink fix applied"
    elif [ "${_SITE_SHARED_SYMLINK_FIX_SKIPPED}" = "YES" ]; then
      _SHARED_FIX_SUMMARY="shared symlink fix pending (not applied)"
    fi
  fi

  if [ "${_HAS_LOCAL_CONVERT}" = "YES" ] && [ "${_SITE_NEEDS_SHARED_SYMLINK_FIX}" = "YES" ]; then
    _log "[INFO] Summary for ${_SITE_NAME}: local conversion needed + ${_SHARED_FIX_SUMMARY}"
  elif [ "${_HAS_LOCAL_CONVERT}" = "YES" ]; then
    _log "[INFO] Summary for ${_SITE_NAME}: local conversion needed"
  elif [ "${_SITE_NEEDS_SHARED_SYMLINK_FIX}" = "YES" ]; then
    _log "[INFO] Summary for ${_SITE_NAME}: ${_SHARED_FIX_SUMMARY}"
  elif [ "${_SITE_HAS_INTENTIONAL_SHARED_SYMLINK}" = "YES" ]; then
    _log "[INFO] Summary for ${_SITE_NAME}: intentional sharing detected (left as is)"
  else
    _log "[INFO] Summary for ${_SITE_NAME}: clean (no conversion needed, no accidental sharing)"
  fi

  # REPORT mode is read-only; symlink sharing checks above already produced output.
  if [ "${_MODE}" = "REPORT" ]; then
    return
  fi

  # If nothing needs conversion from local dir -> symlink, and symlink checks were done,
  # then only now it's safe to say "nothing to do".
  if [ "${_HAS_LOCAL_CONVERT}" != "YES" ]; then
    _log "[INFO] No local files/private dirs to convert for site ${_SITE_NAME} (symlink sharing already checked above)"
    return
  fi

  # --- Normal modes (DRY / LIVE / BATCH) ---

  if [ "${_DO_FILES_CONVERT}" = "YES" ]; then
    if [ -e "${_TARGET_BASE}/files" ] || [ -L "${_TARGET_BASE}/files" ]; then
      # Stale store target from a prior lifecycle of a reused site name: archived
      # aside automatically (see _archive_existing_store_target). A defined,
      # non-destructive remedy -- NOT a blocking edge case, so the narrow
      # install/clone apply proceeds instead of skipping with a warning.
      _log "[PLAN] Existing (stale) store target will be archived before move: ${_TARGET_BASE}/files -> ${_ACCOUNT_DIR}/static/files/.archived/<stamp>/${_SITE_NAME}/files"
    fi
    _log "[PLAN] Move directory: ${_FILES_PATH} -> ${_TARGET_BASE}/files"
    _log "[PLAN] Symlink: ${_FILES_PATH} -> ${_TARGET_BASE}/files"

    # DRY: check space for cross-FS moves, so batch can know if it's safe.
    if [ "${_MODE}" = "DRY" ]; then
      _check_space_for_transfer "${_FILES_PATH}" "${_TARGET_BASE}" "move files" "${_SITE_NAME}" || true
    fi
  fi

  if [ "${_DO_PRIVATE_CONVERT}" = "YES" ]; then
    if [ -e "${_TARGET_BASE}/private" ] || [ -L "${_TARGET_BASE}/private" ]; then
      # Stale store target from a prior lifecycle of a reused site name: archived
      # aside automatically (see _archive_existing_store_target). A defined,
      # non-destructive remedy -- NOT a blocking edge case, so the narrow
      # install/clone apply proceeds instead of skipping with a warning.
      _log "[PLAN] Existing (stale) store target will be archived before move: ${_TARGET_BASE}/private -> ${_ACCOUNT_DIR}/static/files/.archived/<stamp>/${_SITE_NAME}/private"
    fi
    _log "[PLAN] Move directory: ${_PRIVATE_PATH} -> ${_TARGET_BASE}/private"
    _log "[PLAN] Symlink: ${_PRIVATE_PATH} -> ${_TARGET_BASE}/private"

    if [ "${_MODE}" = "DRY" ]; then
      _check_space_for_transfer "${_PRIVATE_PATH}" "${_TARGET_BASE}" "move private" "${_SITE_NAME}" || true
    fi
  fi

  if [ "${_MODE}" = "DRY" ]; then
    _log "[DRY] DRY-RUN mode – conversion planned for ${_SITE_NAME}, no changes applied"
  else
    # LIVE and BATCH
    if [ "${_MODE}" = "LIVE" ]; then
      if [ "${_LIVE_SITE_APPROVED}" != "YES" ]; then
        if ! _ask_confirm_site "${_SITE_NAME}"; then
          _log "[LIVE] Skipping conversion for site: ${_SITE_NAME}"
          return
        fi
        _LIVE_SITE_APPROVED="YES"
      fi

      if [ -e "${_TARGET_BASE}" ] && [ ! -d "${_TARGET_BASE}" ]; then
        _make_unique_target "${_TARGET_BASE}"
      fi
      if [ ! -d "${_TARGET_BASE}" ]; then
        _log "[APPLY] Creating directory: ${_TARGET_BASE}"
        mkdir -p "${_TARGET_BASE}"
      fi

      if [ "${_DO_FILES_CONVERT}" = "YES" ]; then
        if ! _check_space_for_transfer "${_FILES_PATH}" "${_TARGET_BASE}" "move files" "${_SITE_NAME}"; then
          _log "[WARN] Skipping moving files for site ${_SITE_NAME} due to insufficient space."
        else
          _convert_dir_to_symlink "${_FILES_PATH}" "${_TARGET_BASE}/files" "files" "${_SITE_NAME}"
        fi
      fi

      if [ "${_DO_PRIVATE_CONVERT}" = "YES" ]; then
        if ! _check_space_for_transfer "${_PRIVATE_PATH}" "${_TARGET_BASE}" "move private" "${_SITE_NAME}"; then
          _log "[WARN] Skipping moving private for site ${_SITE_NAME} due to insufficient space."
        else
          _convert_dir_to_symlink "${_PRIVATE_PATH}" "${_TARGET_BASE}/private" "private" "${_SITE_NAME}"
        fi
      fi
    else
      # BATCH (no per-site confirmation)
      if [ -e "${_TARGET_BASE}" ] && [ ! -d "${_TARGET_BASE}" ]; then
        _make_unique_target "${_TARGET_BASE}"
      fi
      if [ ! -d "${_TARGET_BASE}" ]; then
        _log "[APPLY] Creating directory: ${_TARGET_BASE}"
        mkdir -p "${_TARGET_BASE}"
      fi

      if [ "${_DO_FILES_CONVERT}" = "YES" ]; then
        if ! _check_space_for_transfer "${_FILES_PATH}" "${_TARGET_BASE}" "move files" "${_SITE_NAME}"; then
          _log "[WARN] Skipping moving files for site ${_SITE_NAME} due to insufficient space."
        else
          _convert_dir_to_symlink "${_FILES_PATH}" "${_TARGET_BASE}/files" "files" "${_SITE_NAME}"
        fi
      fi

      if [ "${_DO_PRIVATE_CONVERT}" = "YES" ]; then
        if ! _check_space_for_transfer "${_PRIVATE_PATH}" "${_TARGET_BASE}" "move private" "${_SITE_NAME}"; then
          _log "[WARN] Skipping moving private for site ${_SITE_NAME} due to insufficient space."
        else
          _convert_dir_to_symlink "${_PRIVATE_PATH}" "${_TARGET_BASE}/private" "private" "${_SITE_NAME}"
        fi
      fi
    fi
  fi
}

_process_account() {
  # Handle one /data/disk/* account.
  # Arg: account dir (/data/disk/o1)
  _ACCOUNT_DIR="$1"
  _ACCOUNT_NAME=$(basename "${_ACCOUNT_DIR}")

  # Ignore /data/disk/arch/
  if [ "${_ACCOUNT_NAME}" = "arch" ]; then
    return
  fi

  _VHOST_DIR="${_ACCOUNT_DIR}/config/server_master/nginx/vhost.d"
  _DRUSH_DIR="${_ACCOUNT_DIR}/.drush"

  if [ ! -d "${_VHOST_DIR}" ]; then
    return
  fi

  if [ ! -d "${_DRUSH_DIR}" ]; then
    return
  fi

  _log "=================================================================="
  _log "[INFO] Processing account: ${_ACCOUNT_NAME} (${_ACCOUNT_DIR})"

  # Track detected/valid sites for orphan static/files reporting
  local -A _SITES_IN_ACCOUNT

  # Iterate Drush aliases, use base name as site name, match with vhost.
  for _ALIAS_FILE in "${_DRUSH_DIR}"/*.alias.drushrc.php; do
    if [ ! -f "${_ALIAS_FILE}" ]; then
      continue
    fi

    _ALIAS_BASENAME=$(basename "${_ALIAS_FILE}")
    # Strip .alias.drushrc.php
    _SITE_NAME=${_ALIAS_BASENAME%.alias.drushrc.php}

    _VHOST_FILE="${_VHOST_DIR}/${_SITE_NAME}"

    # Proceed only for valid vhost/drush-alias pairs
    if [ ! -f "${_VHOST_FILE}" ]; then
      continue
    fi

    _SITES_IN_ACCOUNT["${_SITE_NAME}"]="YES"

    _process_site "${_ACCOUNT_NAME}" "${_ACCOUNT_DIR}" "${_SITE_NAME}" "${_ALIAS_FILE}"
  done

  # Orphaned static/files stores are leftovers from a site DELETE (deleting a site does
  # not remove its per-site store). Runs in the account-sweep only (never the narrow
  # single-site Provision hook).
  #   REPORT       : list them for the operator email (read-only).
  #   LIVE / BATCH : ARCHIVE each deleted-site leftover ASIDE into
  #                  static/files/.archived/<stamp>/<site>/ (NEVER delete -- pruning the
  #                  pile stays operator-only), unless the kill-switch cnf is present.
  # SAFETY: only a name with NEITHER a drush alias NOR a vhost is archived. A merely
  # DISABLED site keeps its alias (it has no active vhost+alias pair, so it is still an
  # "orphan" to the scan below) -- it is reported but LEFT IN PLACE so its data survives
  # a later re-enable. The nightly sweep runs with the Aegir task queue paused + drained,
  # so no install/clone is mid-flight to make a live site transiently look deleted.
  if [ "${_MODE}" = "REPORT" ] || [ "${_MODE}" = "LIVE" ] || [ "${_MODE}" = "BATCH" ]; then
    _STATIC_FILES_DIR="${_ACCOUNT_DIR}/static/files"
    if [ -d "${_STATIC_FILES_DIR}" ]; then
      # Archive in the apply modes only, and only if the operator has not disabled it.
      _ORPHAN_ARCHIVE="NO"
      case "${_MODE}" in LIVE|BATCH) _ORPHAN_ARCHIVE="YES" ;; esac
      [ -f /data/conf/disable_orphan_store_archiving.cnf ] && _ORPHAN_ARCHIVE="NO"
      # One archive stamp for all of this account's orphans in this sweep.
      _ARCHIVE_STAMP="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null)-$$"
      _FOUND_ORPHANS="NO"
      for _CAND in "${_STATIC_FILES_DIR}"/*; do
        if [ ! -e "${_CAND}" ]; then
          continue
        fi

        _CAND_NAME=$(basename "${_CAND}")

        # Skip known non-site entries
        if [ "${_CAND_NAME}" = "dbackup" ] || [ "${_CAND_NAME}" = "foo.com" ]; then
          continue
        fi

        # Ignore hidden/metadata entries (this skips .archived itself).
        case "${_CAND_NAME}" in
          .*|lost+found)
            continue
            ;;
        esac

        # Only consider entries that look like site storage (dir or symlink with files/private inside).
        if [ -d "${_CAND}" ] || [ -L "${_CAND}" ]; then
          if [ -d "${_CAND}/files" ] || [ -d "${_CAND}/private" ] || [ -L "${_CAND}" ]; then
            if [ -z "${_SITES_IN_ACCOUNT["${_CAND_NAME}"]+x}" ]; then
              _FOUND_ORPHANS="YES"
              _ORPH_KB=$(du -sk "${_CAND}" 2>/dev/null | awk 'NR==1 {print $1}')
              if [ -z "${_ORPH_KB}" ]; then
                _ORPH_KB="?"
              fi
              # Deleted (safe to archive) vs disabled/partial (keep): require BOTH the
              # drush alias AND the vhost to be absent before moving anything.
              _CAND_ALIAS="${_DRUSH_DIR}/${_CAND_NAME}.alias.drushrc.php"
              _CAND_VHOST="${_VHOST_DIR}/${_CAND_NAME}"
              if [ -e "${_CAND_ALIAS}" ] || [ -e "${_CAND_VHOST}" ]; then
                _log "[REPORT] ORPHAN static/files entry in account ${_ACCOUNT_NAME}: ${_CAND} (size=${_ORPH_KB}K) – a surviving alias/vhost remains (disabled or partial state); left in place, NOT archived"
              elif [ "${_ORPHAN_ARCHIVE}" = "YES" ]; then
                _archive_orphan_store "${_CAND}" "${_ACCOUNT_DIR}" "${_CAND_NAME}" "${_ORPH_KB}"
              else
                _log "[REPORT] ORPHAN static/files entry in account ${_ACCOUNT_NAME}: ${_CAND} (size=${_ORPH_KB}K) – no matching active site (vhost+alias) found"
              fi
            fi
          fi
        fi
      done

      if [ "${_FOUND_ORPHANS}" != "YES" ]; then
        _log "[REPORT] No orphan static/files entries detected in account ${_ACCOUNT_NAME}"
      fi

      # Track the archived-ghost pile under static/files/.archived (a hidden
      # subdir the orphan scan above skips, on the SAME filesystem as the store).
      # It accumulates over reused-name conversions, so report its total size and,
      # above a threshold, flag it ORPHAN-class so the daily email surfaces it for
      # pruning. Read-only; moves nothing. Threshold is cnf-tunable in KB via
      # /data/conf/native_files_archive_alert_kb.cnf (default 1 GiB).
      # The .archived pile-size accounting stays a REPORT-mode diagnostic (read-only).
      if [ "${_MODE}" = "REPORT" ]; then
        _ARCH_ROOT="${_STATIC_FILES_DIR}/.archived"
        if [ -d "${_ARCH_ROOT}" ]; then
          _ARCH_TOTAL_KB=$(du -sk "${_ARCH_ROOT}" 2>/dev/null | awk 'NR==1 {print $1}')
          _ARCH_TOTAL_KB="${_ARCH_TOTAL_KB:-0}"
          _ARCH_ALERT_KB=1048576
          if [ -f /data/conf/native_files_archive_alert_kb.cnf ]; then
            _ARCH_ALERT_CNF=$(head -n1 /data/conf/native_files_archive_alert_kb.cnf 2>/dev/null | tr -dc '0-9')
            [ -n "${_ARCH_ALERT_CNF}" ] && _ARCH_ALERT_KB="${_ARCH_ALERT_CNF}"
          fi
          if [ "${_ARCH_TOTAL_KB}" -ge "${_ARCH_ALERT_KB}" ]; then
            _log "[REPORT] ORPHAN archived-store pile in account ${_ACCOUNT_NAME}: ${_ARCH_ROOT} total=${_ARCH_TOTAL_KB}K >= threshold ${_ARCH_ALERT_KB}K - prune old entries to reclaim space"
          else
            _log "[REPORT] Archived-store pile in account ${_ACCOUNT_NAME}: ${_ARCH_ROOT} total=${_ARCH_TOTAL_KB}K (below threshold ${_ARCH_ALERT_KB}K)"
          fi
        fi
      fi
    fi
  fi
}

_run_one_site() {
  # Narrow single-site driver for the Provision clone hook. Resolves the owning
  # account (explicit --account preferred; otherwise by locating the valid
  # vhost+alias pair), validates tokens fail-closed, and converts exactly that
  # one site via _process_site. It never reads or writes the global CLEAN-DRY
  # state file and never sweeps other accounts. Always returns 0 (done or
  # safe-skip); the caller treats any internal warning as non-fatal.
  _SITE="${_ONE_SITE}"
  _ACCOUNT_DIR=""
  _ACCOUNT_NAME=""

  # Fail-closed token validation (reject empty / traversal / path separators).
  case "${_SITE}" in
    ""|*..*|*/*)
      _log "[ERROR] Narrow mode: invalid or missing --site token"
      return 0
      ;;
  esac
  if ! printf '%s' "${_SITE}" | grep -qE '^[a-z0-9][a-z0-9._-]*$'; then
    _log "[ERROR] Narrow mode: invalid --site token '${_SITE}'"
    return 0
  fi

  if [ -n "${_ONE_ACCOUNT}" ]; then
    case "${_ONE_ACCOUNT}" in
      *..*|*/*)
        _log "[ERROR] Narrow mode: invalid --account token '${_ONE_ACCOUNT}'"
        return 0
        ;;
    esac
    if ! printf '%s' "${_ONE_ACCOUNT}" | grep -qE '^[A-Za-z0-9._-]+$'; then
      _log "[ERROR] Narrow mode: invalid --account token '${_ONE_ACCOUNT}'"
      return 0
    fi
    _ACCOUNT_DIR="/data/disk/${_ONE_ACCOUNT}"
    _ACCOUNT_NAME="${_ONE_ACCOUNT}"
  else
    # Derive the account by locating the valid vhost+alias pair for this site.
    for _CAND in /data/disk/*; do
      [ -d "${_CAND}" ] || continue
      [ -f "${_CAND}/.drush/${_SITE}.alias.drushrc.php" ] || continue
      [ -f "${_CAND}/config/server_master/nginx/vhost.d/${_SITE}" ] || continue
      _ACCOUNT_DIR="${_CAND}"
      _ACCOUNT_NAME="$(basename "${_CAND}")"
      break
    done
  fi

  if [ -z "${_ACCOUNT_DIR}" ] || [ ! -d "${_ACCOUNT_DIR}" ]; then
    _log "[INFO] Narrow mode: no owning account found for site ${_SITE}; nothing to do"
    return 0
  fi

  _ALIAS_FILE="${_ACCOUNT_DIR}/.drush/${_SITE}.alias.drushrc.php"
  _VHOST_FILE="${_ACCOUNT_DIR}/config/server_master/nginx/vhost.d/${_SITE}"
  # The Drush alias is the authoritative "site exists" marker (written by
  # provision-save). The nginx vhost is written LATER by provision-verify, so a
  # caller passing an explicit --account (a Provision install hook running before
  # the site's first verify) is trusted on the alias alone; the auto-resolve path
  # below already matched the vhost+alias pair when it picked the account.
  if [ ! -f "${_ALIAS_FILE}" ]; then
    _log "[INFO] Narrow mode: site ${_SITE} has no Drush alias under ${_ACCOUNT_NAME}; nothing to do"
    return 0
  fi
  if [ -z "${_ONE_ACCOUNT}" ] && [ ! -f "${_VHOST_FILE}" ]; then
    _log "[INFO] Narrow mode: site ${_SITE} has no vhost under ${_ACCOUNT_NAME}; nothing to do"
    return 0
  fi

  # Start from a clean per-run state; never consult or write the global gate.
  _APPLY_COUNT=0
  _DRY_HAS_ERRORS="NO"
  _DRY_HAS_EDGE_CASES="NO"
  _reset_anomalies
  _FS_PAIR_STATUS=()
  _FS_RESERVED_KB=()

  _log "=================================================================="
  _log "[INFO] Narrow single-site run: site=${_SITE} account=${_ACCOUNT_NAME} apply=${_APPLY_FLAG}"

  if [ "${_APPLY_FLAG}" = "YES" ]; then
    # Defer if a maintenance pause (e.g. the nightly batch via updatesymlinks)
    # is in progress, so a clone-time conversion never interleaves with the
    # global sweep on the same store (break-sharing rsync is not concurrency
    # safe). The nightly batch in turn bails while a provision/clone process is
    # running, so the two do not overlap.
    if [ -e "/etc/boa/.pause_tasks_maint.cnf" ]; then
      _log "[WARN] Narrow apply for ${_SITE} deferred: maintenance pause in progress"
      if [ "${_FORCE_UNSHARE}" = "YES" ]; then
        _log "[ALERT] Clone unshare for ${_SITE} not completed (deferred); files may still be shared with the source - manual review required"
        return 3
      fi
      return 0
    fi

    # Mirror the global "clean dry-run before any live change" rule, scoped to
    # this one site and WITHOUT touching the shared CLEAN-DRY state file: run a
    # per-site DRY pass first and apply only if that single-site dry-run is clean.
    _MODE="DRY"
    _DRY_HAS_ERRORS="NO"
    _DRY_HAS_EDGE_CASES="NO"
    _reset_anomalies
    _APPLY_COUNT=0
    _process_site "${_ACCOUNT_NAME}" "${_ACCOUNT_DIR}" "${_SITE}" "${_ALIAS_FILE}"
    if [ "${_DRY_HAS_ERRORS}" != "NO" ] || [ "${_DRY_HAS_EDGE_CASES}" != "NO" ]; then
      _log "[WARN] Narrow dry-run for ${_SITE} is NOT CLEAN; skipping apply (manual review needed)."
      # Same explanation for the Provision install/clone hook: this is where a
      # clone silently declines to convert, so the reason belongs in its log too.
      _explain_anomalies
      if [ "${_FORCE_UNSHARE}" = "YES" ]; then
        _log "[ALERT] Clone unshare for ${_SITE} not completed (dry-run not clean); files may still be shared with the source - manual review required"
        return 3
      fi
      return 0
    fi
    _log "[INFO] Narrow dry-run for ${_SITE} is CLEAN; applying."
    _MODE="BATCH"
    _APPLY_COUNT=0
    _FS_PAIR_STATUS=()
    _FS_RESERVED_KB=()
    _process_site "${_ACCOUNT_NAME}" "${_ACCOUNT_DIR}" "${_SITE}" "${_ALIAS_FILE}"

    # A clone explicitly requested --force-unshare but the inherited share could
    # not be broken (missing source / no space / rsync fail): the in-site link
    # may still point at another site's store. Surface it loudly and signal the
    # caller (non-zero, still non-fatal to the clone).
    if [ "${_FORCE_UNSHARE}" = "YES" ] \
      && [ "${_SITE_NEEDS_SHARED_SYMLINK_FIX}" = "YES" ] \
      && [ "${_SITE_SHARED_SYMLINK_FIX_APPLIED}" != "YES" ]; then
      _log "[ALERT] Clone unshare for ${_SITE} not completed; files may still be shared with the source - manual review required"
      return 3
    fi
  else
    _MODE="DRY"
    _process_site "${_ACCOUNT_NAME}" "${_ACCOUNT_DIR}" "${_SITE}" "${_ALIAS_FILE}"
  fi

  return 0
}

_main() {
  # Narrow single-site mode (Provision clone hook): convert just one site and
  # exit, without sweeping all accounts and without touching the global state
  # file. The clone hook calls this binary DIRECTLY (never updatesymlinks, which
  # pgrep-greps 'provision' and would bail under a running clone).
  if [ "${_NARROW}" = "YES" ]; then
    _log "=================================================================="
    _log "[START] autosymlink narrow single-site mode (site=${_ONE_SITE}, apply=${_APPLY_FLAG})"
    _run_one_site
    _NARROW_RC=$?
    _log "[DONE] autosymlink finished (narrow mode)"
    return ${_NARROW_RC}
  fi

  _log "=================================================================="
  if [ "${_MODE}" = "BATCH_IF_CLEAN" ]; then
    _log "[START] autosymlink running in BATCH_IF_CLEAN mode (DRY -> if CLEAN -> BATCH)"
    # First pass: DRY run
    _MODE="DRY"
    _DRY_HAS_ERRORS="NO"
    _DRY_HAS_EDGE_CASES="NO"
    _reset_anomalies
    _APPLY_COUNT=0

    for _ACCOUNT_DIR in /data/disk/*; do
      if [ ! -d "${_ACCOUNT_DIR}" ] || [ ! -e "${_ACCOUNT_DIR}/tools/drush" ]; then
        continue
      fi
      _process_account "${_ACCOUNT_DIR}"
    done

    _log_reserved_fs_summary
    _finalize_dry_run_state

    if [ "${_DRY_HAS_ERRORS}" != "NO" ] || [ "${_DRY_HAS_EDGE_CASES}" != "NO" ]; then
      _write_state "NOT_CLEAN" "BATCH_IF_CLEAN"
      _log "[WARN] DRY run is NOT CLEAN, skipping BATCH"
      _log "[DONE] autosymlink finished"
      exit 10
    fi

    # Second pass: BATCH
    _MODE="BATCH"
    _APPLY_COUNT=0
    _log "=================================================================="
    _log "[START] autosymlink running in BATCH mode (no per-site confirmation)"
    _require_clean_dry_run_or_exit

    for _ACCOUNT_DIR in /data/disk/*; do
      if [ ! -d "${_ACCOUNT_DIR}" ] || [ ! -e "${_ACCOUNT_DIR}/tools/drush" ]; then
        continue
      fi
      _process_account "${_ACCOUNT_DIR}"
    done

    _log_reserved_fs_summary
    _write_state "DONE" "BATCH_IF_CLEAN"
    _log "[DONE] autosymlink finished"
    exit 0
  fi

  if [ "${_MODE}" = "LIVE" ]; then
    _log "[START] autosymlink running in LIVE mode (per-site confirmation required)"
  elif [ "${_MODE}" = "BATCH" ]; then
    _log "[START] autosymlink running in BATCH mode (no per-site confirmation)"
    _require_clean_dry_run_or_exit
  elif [ "${_MODE}" = "REPORT" ]; then
    _log "[START] autosymlink running in REPORT mode (read-only, no changes)"
  else
    _log "[START] autosymlink running in DRY-RUN mode (no changes will be made)"
  fi

  for _ACCOUNT_DIR in /data/disk/*; do
    if [ ! -d "${_ACCOUNT_DIR}" ] || [ ! -e "${_ACCOUNT_DIR}/tools/drush" ]; then
      continue
    fi
    _process_account "${_ACCOUNT_DIR}"
  done

  _log_reserved_fs_summary

  if [ "${_MODE}" = "DRY" ]; then
    _finalize_dry_run_state
  fi

  _log "[DONE] autosymlink finished"
}

# Propagate the exit code. Non-narrow modes return 0 here (BATCH_IF_CLEAN exits
# internally); narrow apply returns 3 only as a non-fatal advisory when a clone
# --force-unshare could not break an inherited cross-account share.
_main "$@"
exit $?
