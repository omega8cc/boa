#!/bin/bash

PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
SHELL=/bin/bash

###
### xtrim -- shrink a fully proxied (PX0) source box so it fits a minimal
### plan, without ever guessing: every deletion is derived from this box's
### own saved vhosts and drush aliases, proven still-served by the TARGET
### over ssh, dumped and verified locally first, and recorded in a manifest
### before the first byte is removed.
###
### Verbs:
###   xtrim status                    read-only: proxy state, cert horizon,
###                                   reclaimable bytes
###   xtrim plan    <oN|all>          full precondition battery + itemised
###                                   deletion plan (DRY)
###   xtrim quiesce <oN|all> [--live] stage A ONLY: park the account and
###                                   quarantine its pools/includes/cores.
###                                   Reversible, deletes nothing. Leaves
###                                   the account inspectable before the
###                                   one-way step, and is the state
###                                   `restore` undoes.
###   xtrim shrink <oN|all> [--live]  stage A (skipped when already
###                                   quiesced) + stage B (one-way removal)
###   xtrim finalize [--live] [--drop-datadir]
###                                   box-wide stage C, only when every
###                                   account is shrunk
###   xtrim restore <oN>              undo stage A from quarantine (refused
###                                   once stage B has started)
###   xtrim names [<oN>|all]          read-only: where DNS points every name
###                                   the relay answers for (this box, the
###                                   target, elsewhere, nowhere)
###   xtrim space                     read-only: what the root filesystem
###                                   holds, largest trees first, for the
###                                   read before a smaller plan
###
### DRY/--live token is PER VERB: a clean DRY of one verb never arms a live
### run of another (the historical xoct/xmass defect is not inherited).
###
### Certificate refresh is deliberately NOT an xtrim verb -- it belongs to
### the daily migration_proxy_certs.sh mirror, which must keep running long
### after the shrink.
###

_XTRIM_BASE="/var/backups/xtrim"
_XTRIM_STATE_DIR="/var/log/boa"
_NGX_LOCK="/run/boa_nginx_config.lock"
_SQLCLEAN_LOCK="/run/sqlclean.lock"

_msg()  { echo "xtrim: $*"; }
_info() { echo "INFO: $*"; }
_alrt() { echo "ALRT: $*"; }
_die()  { echo "ERROR: $*"; exit 1; }

_check_root() {
  if [ "$(id -u)" != "0" ]; then
    _die "This script should be ran as a root user"
  fi
}

### Single instance, house pattern (lock.inc when present, legacy fallback).
_manage_single_lock() {
  local _L
  _SELF_NAME="xtrim"
  for _L in "/opt/local/bin/lock.inc" "/opt/local/lib/lock.inc"; do
    [ -r "${_L}" ] && . "${_L}" && break
  done
  if [ -n "${_SINGLE_INSTANCE_LIB_VER:-}" ] \
    && command -v _single_instance_lock >/dev/null 2>&1; then
    _single_instance_lock
  else
    if [ "$(pgrep -fc '[x]trim')" -gt 2 ]; then
      echo "$(date 2>/dev/null) too many xtrim already running" \
        >> /var/log/boa/too.many.log
      exit 0
    fi
  fi
}

### Mutual exclusion with sqlclean: its interlock greps for provision and
### the boa pids only -- it cannot see xtrim, so xtrim must hold sqlclean's
### own lock for the whole run (and thereby also refuses while sqlclean
### runs). Never call sqlclean from here: it is box-wide by construction
### and an account mid-trim classifies as ghosts everywhere else.
_take_sqlclean_lock() {
  exec 8>"${_SQLCLEAN_LOCK}"
  if ! flock -n 8; then
    _die "sqlclean (or another xtrim) is active -- refusing to run"
  fi
}

### The account's static/control is its main login's, and oN owns the rest
### of /data/disk/oN (log/, .drush): either can put a link or a FIFO at any
### name there, or at the directory itself. Run "$@" inside the real
### directory $1: below /data/disk and /home every name on the path must be
### a real directory; once entered, ./name stays there whatever is swapped.
_in_real_dir() {
  local _d="${1}" _a="" _want
  shift
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
  esac
  if [ -n "${_a}" ]; then
    _want="$(cd -P -- "${_a}" 2> /dev/null && /bin/pwd -P)${_d#"${_a}"}"
  else
    ### The parent of a top-level directory (/root) is "/", never the empty
    ### name: cd "" fails on one bash and follows CDPATH on another.
    _want="$(cd -P -- "${_d%/*}/" 2> /dev/null && /bin/pwd -P)"
    _want="${_want%/}/${_d##*/}"
  fi
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(/bin/pwd -P)" = "${_want}" ] && "$@" )
}

### ./$1 in the current (pinned) directory: never through a link, never
### blocked on a FIFO, at most 1 MiB; empty for anything else.
_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2> /dev/null
}

### The file $1, read as _read_here reads it inside its real directory.
_read_file() {
  _in_real_dir "${1%/*}" _read_here "${1##*/}"
}

_web_group_state() {
  # The account's own web group, wg-<account>, derived on the box and never
  # taken from argv or a cnf: the group its pools, backend user and shell
  # users share for its web paths once the account is converted to it.
  # Prints "<state> <gid> <group>", "none - -" when there is no such group
  # (the record is root's: run as another user, converted reads as held):
  #   none       no group of that name
  #   foreign    the group exists, but an identity outside the account holds
  #              it too: never joined nor written to unless root's record
  #              names its gid at phase A or B (_web_group, _web_group_conv);
  #              claim passes still leave its paths alone (taking them would
  #              cut the pools off)
  #   held       the group exists and only this account's identities hold it:
  #              claim passes leave its paths alone, new identities join it
  #   converted  and root's record names that gid: writers use the group
  #   phaseb     and the record says the identities have left www-data
  # The record is /root/.<account>.web-group.txt, "wg-<account> gid=<n>
  # phase=<A|B> ...", root's own file outside the account tree, so neither
  # the account nor a copy or restore of its tree can make or move it.
  # $1 = account name, one of its identities (oN.ftp, oN.<sub>, oN.web,
  # oN.NN.web), or a path under /data/disk/<oN>, /home/<oN>.*, the account's
  # gems or npm tree, or its store on attached storage
  # (/mnt/<m>/files/<oN>/static/files).
  local _a="${1}" _e _gid _u _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  # a path is read as written (an alias the account wrote can carry "..",
  # "." or "//"): normalised by text alone, never through a link, first
  case "${_a}" in
    */*) _a=$(realpath -m -s -- "${_a}" 2> /dev/null) || { echo "none - -"; return 0; } ;;
  esac
  case "${_a}" in
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    /home/*) _a="${_a#/home/}"; _a="${_a%%/*}" ;;
    /opt/user/gems/*|/opt/user/npm/*) _a="${_a#/opt/user/*/}"; _a="${_a%%/*}" ;;
    /mnt/*/files/*/static/files|/mnt/*/files/*/static/files/*)
      _a="${_a#/mnt/}"; _a="${_a#*/files/}"; _a="${_a%%/*}" ;;
    */*) echo "none - -"; return 0 ;;
  esac
  _a="${_a%%.*}"
  case "${_a}" in
    ""|all|aegir|root|www-data|wg-*|*[!a-z0-9-]*) echo "none - -"; return 0 ;;
  esac
  _e=$(getent group "wg-${_a}" 2> /dev/null) || { echo "none - -"; return 0; }
  _gid=$(printf '%s' "${_e}" | cut -d: -f3)
  case "${_gid}" in
    ""|*[!0-9]*) echo "none - -"; return 0 ;;
  esac
  # every holder of the gid: members of each group entry carrying it (a
  # second entry can share the number) and every user with it as primary
  for _u in $(getent group | awk -F: -v g="${_gid}" '$3 == g { print $4 }' | tr ',' ' ') \
    $(getent passwd | awk -F: -v g="${_gid}" '$4 == g { print $1 }'); do
    [[ "${_u}" =~ ^${_a}(\.[a-z0-9]+(-dev)?|\.[0-9]+\.web)?$ ]] \
      || { echo "foreign ${_gid} wg-${_a}"; return 0; }
  done
  _r="/root/.${_a}.web-group.txt"
  if [ -f "${_r}" ] && [ ! -L "${_r}" ] \
    && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
    read -r _rg _rgid _rph _ < "${_r}" || :
  fi
  if [ "${_rg}" != "wg-${_a}" ] || [ "${_rgid}" != "gid=${_gid}" ]; then
    echo "held ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=B" ]; then
    echo "phaseb ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=A" ]; then
    echo "converted ${_gid} wg-${_a}"
  else
    echo "held ${_gid} wg-${_a}"
  fi
}
_web_group_rb() {
  # "rb" when the account's record says phase B (_web_group_state phaseb,
  # or foreign while the record names the group's current gid: the
  # _web_group_conv rule) and carries the fourth field rb=1: a rollback of
  # phase B was cut short, so the record says B only because the pools may
  # still lack www-data, and no share check has passed since. Empty
  # otherwise. The pool line is left out while it stands and the account's
  # shell user is still listed in www-data. $1 as _web_group_state.
  local _s _a _r _rg="" _rgid="" _rph="" _rtk="" IFS=$' \t\n'
  _s=$(_web_group_state "${1}")
  case "${_s%% *}" in
    phaseb|foreign) ;;
    *) return 0 ;;
  esac
  _a="${_s##* }"
  _a="${_a#wg-}"
  _r="/root/.${_a}.web-group.txt"
  if [ -f "${_r}" ] && [ ! -L "${_r}" ] \
    && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
    read -r _rg _rgid _rph _rtk _ < "${_r}" || :
  fi
  if [ "${_rg}" = "${_s##* }" ] && [ "${_rgid}" = "gid=$(printf '%s' "${_s}" | cut -d' ' -f2)" ] \
    && [ "${_rph}" = "phase=B" ] && [ "${_rtk}" = "rb=1" ]; then
    echo "rb"
  fi
  return 0
}

_web_group_conv() {
  # The account's web group and its phase, "wg-<account> A" or "wg-<account>
  # B", once the account is converted onto that group; nothing otherwise:
  # converted and phaseb as _web_group_state reads them, and a group an
  # identity outside the account has come to hold too (foreign) while
  # root's record names its current gid at phase A or B, read as root (the
  # rule _web_group follows). The listings in the group and the pool line
  # follow it, so an identity made while the name is held joins the group
  # its paths are in. $1 as _web_group_state; $2, when given, the line that
  # read printed for $1 (no second read).
  local _s="${2:-}" _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  [ -n "${_s}" ] || _s=$(_web_group_state "${1}")
  case "${_s%% *}" in
    converted) echo "${_s##* } A" ;;
    phaseb) echo "${_s##* } B" ;;
    foreign)
      _r="/root/.${_s##* wg-}.web-group.txt"
      if [ "$(id -u)" = "0" ] && [ -f "${_r}" ] && [ ! -L "${_r}" ] \
        && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
        read -r _rg _rgid _rph _ < "${_r}" || :
      fi
      if [ "${_rg}" = "${_s##* }" ] && [ "${_rgid}" = "gid=$(printf '%s' "${_s}" | cut -d' ' -f2)" ]; then
        case "${_rph}" in
          phase=A) echo "${_rg} A" ;;
          phase=B) echo "${_rg} B" ;;
        esac
      fi
      ;;
  esac
  return 0
}

### A quarantined pool file of account $1 put in the state the account's
### pool writers would write it before it goes back: exactly one line
### group = wg-<account> while its record says phase B (_web_group_conv: the
### group resolving, and no rollback token left while its own user is still
### in www-data), none otherwise. $2 = the file, root's, in the quarantine.
_pool_line_fix() {
  local _oN="${1}" _f="${2}" _s _l _t
  _l="group = wg-${_oN}"
  _s=$(_web_group_state "${_oN}")
  _t="${_f}.wg.$$"
  rm -f -- "${_t}"
  grep -vxF -- "${_l}" "${_f}" > "${_t}" 2> /dev/null
  # phase B as the pool writers read it: phaseb, or a group an identity
  # outside the account holds too while root's record names it at B
  if [ "$(_web_group_conv "${_oN}" "${_s}")" = "wg-${_oN} B" ] \
    && getent group "wg-${_oN}" > /dev/null 2>&1 \
    && ! { [ "$(_web_group_rb "${_oN}")" = "rb" ] \
      && [[ ",$(getent group www-data | cut -d: -f4)," == *",${_oN},"* ]]; }; then
    printf '%s\n' "${_l}" >> "${_t}"
  fi
  chmod --reference="${_f}" -- "${_t}" 2> /dev/null
  mv -f -- "${_t}" "${_f}" || { rm -f -- "${_t}"; return 1; }
}

### The regular files of the real directory $1 that the find tests after it
### select, one name per line, listed inside that directory (empty when $1
### is not a real directory).
_names_in() {
  local _d="$1"
  shift
  _in_real_dir "${_d}" find . -maxdepth 1 -mindepth 1 -type f "$@" \
    2> /dev/null | sed 's|^\./||' | sort
}

### A certificate a vhost names, read only for its dates: an absolute path,
### at most 1 MiB, never blocked on a FIFO (the Let's Encrypt layout reaches
### the file through links, so the name is followed).
_cert_text() {
  case "$1" in
    /?*) ;;
    *) return 1 ;;
  esac
  timeout 10 dd if="$1" iflag=nonblock,fullblock bs=1048576 count=1 \
    status=none 2> /dev/null
}

### The policy record and the proxied marker root decides from are
### /root/.<oN>.migproxy.cnf and /root/.<oN>.migproxy.proxied, root:root
### 0600: parsed, never sourced, and never taken from the account's tree
### (log/migproxy.cnf and log/proxied.pid are the account's to write).
### Plain assignments, never taken from the environment. The readers below
### are kept in step with the copies in xoct and xmass, not shared: each
### body is theirs except the directory pin (_in_real_dir).
_MIG_REC_DIR="/root"
_MIG_ADOPT_STAMP="/root/.migration.records.adopted"
_MIG_TRUST_TOOL="/var/xdrago/migration_proxy_trust.sh"
_MIG_OCTET="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
### ./$1 read through one handle opened O_RDONLY|O_NOFOLLOW|O_NONBLOCK, and
### only while that handle is a regular file with one link, owned by root,
### writable by no one else, at most 64 KiB; the shape "legacy" also wants
### group root and mode 0600. Prints the handle's mtime on a line of its own,
### then the bytes. Status 3 absent, 4 anything else, 5 a read error.
_MIG_HREAD_PL='use Fcntl; use Errno qw(ENOENT); my ($n, $s) = @ARGV; exit 4 unless defined $s && ($s eq "root" || $s eq "legacy"); sysopen(my $h, $n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit($! == ENOENT ? 3 : 4); my @t = stat($h); exit 4 unless @t && -f _ && $t[3] == 1 && $t[4] == 0 && $t[7] <= 65536 && ($t[2] & 022) == 0; exit 4 if $s eq "legacy" && !($t[5] == 0 && ($t[2] & 07777) == 0600); my ($d, $r) = (""); while ($r = sysread($h, my $c, 65536)) { $d .= $c; exit 4 if length($d) > 65536; } exit 5 unless defined $r; close($h); binmode(STDOUT); print "$t[9]\n", $d or exit 5; exit 0'

_mig_valid_mode() {
  case "$1" in
    temporary|permanent|ha-switch|retired) return 0 ;;
    *) return 1 ;;
  esac
}
_mig_valid_acct() { [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]; }
_mig_valid_date() { [[ "$1" =~ ^20[0-9]{2}-[01][0-9]-[0-3][0-9]$ ]]; }
### Strict dotted quad: every octet 0-255, no leading zero, no prefix.
_mig_quad() { [[ "${1}" =~ ^(${_MIG_OCTET}\.){3}${_MIG_OCTET}$ ]]; }
### $1 is one of the addresses this box holds.
_mig_own_addr() {
  [ -n "${1}" ] || return 1
  hostname -I 2> /dev/null | tr ' ' '\n' | grep -qxF -- "${1}"
}
### A peer address a record may name: a strict dotted quad that is neither
### the all-zeros host, loopback, nor one of this box's own addresses.
_mig_peer_ok() {
  _mig_quad "${1}" || return 1
  [ "${1}" != "0.0.0.0" ] || return 1
  case "${1}" in
    127.*) return 1 ;;
  esac
  ! _mig_own_addr "${1}"
}
### Each non-blank line a comment or one _MIG_ key assignment, no key twice:
### anything else makes the whole text malformed. Reads stdin.
_mig_grammar_ok() {
  awk '/^[ \t]*$/ { next }
    /^#/ { next }
    /^_MIG_[A-Z_]+=/ { k = $0; sub(/=.*/, "", k); if (k in s) b = 1; s[k] = 1; next }
    { b = 1 }
    END { exit b }'
}
### The value of the key $2 in the record text $1; empty when missing.
_mig_txt_get() {
  printf '%s\n' "${1}" | grep -m1 "^${2}=" | cut -d= -f2- | tr -d '\r\n'
}
### The file $2 in the real directory $1, read with _MIG_HREAD_PL in the
### shape $3: the handle's mtime line, then the content. Status 0 read, 3
### absent, 4 anything else at the name (or the directory not a real one),
### 5 a read error.
_mig_hread() {
  local _rc
  case "${2}" in
    ""|*/*) return 4 ;;
  esac
  if [ ! -e "${1}" ] && [ ! -L "${1}" ]; then
    return 3
  fi
  _in_real_dir "${1}" perl -e "${_MIG_HREAD_PL}" -- "./${2}" "${3}"
  _rc=$?
  case "${_rc}" in
    0|3|4|5) return "${_rc}" ;;
  esac
  return 4
}
### The root record and marker paths of the account $1; status 1, nothing
### printed, for a name that is not an account's.
_mig_rec() {
  _mig_valid_acct "${1}" && [ "${1#.}" = "${1}" ] || return 1
  printf '%s\n' "${_MIG_REC_DIR}/.${1}.migproxy.cnf"
}
_mig_mark() {
  _mig_valid_acct "${1}" && [ "${1#.}" = "${1}" ] || return 1
  printf '%s\n' "${_MIG_REC_DIR}/.${1}.migproxy.proxied"
}
### The root file $1 (a name in _MIG_REC_DIR) without its mtime line, CR
### stripped, once it reads in the root shape and keeps the grammar. Status 3
### absent, 4 anything else.
_mig_root_text() {
  local _t _rc
  _t="$(_mig_hread "${_MIG_REC_DIR}" "${1}" root)"
  _rc=$?
  case "${_rc}" in
    0) ;;
    3) return 3 ;;
    *) return 4 ;;
  esac
  _t="$(printf '%s\n' "${_t}" | sed 1d | tr -d '\r')"
  printf '%s\n' "${_t}" | _mig_grammar_ok || return 4
  printf '%s\n' "${_t}"
}
### The root record of the account $1. Status 1 bad name, 3 none, 4
### malformed.
_mig_rec_text() {
  local _n
  _n="$(_mig_rec "${1}")" || return 1
  _mig_root_text "${_n##*/}"
}
### The value of the key $2 in the root record of $1 (empty when the key is
### missing). Parsed, never sourced.
_mig_rec_get() {
  local _t _rc
  _t="$(_mig_rec_text "${1}")"
  _rc=$?
  [ "${_rc}" = "0" ] || return "${_rc}"
  _mig_txt_get "${_t}" "${2}"
  return 0
}
### The record text $1 authored by this box: its _MIG_HOST_IP is one of
### this box's addresses. A record for another address (a renumbered box)
### is reported, never acted on.
_mig_txt_mine() {
  local _h
  _h="$(_mig_txt_get "${1}" _MIG_HOST_IP)"
  _mig_quad "${_h}" && _mig_own_addr "${_h}"
}
_mig_is_mine() {
  local _t
  _t="$(_mig_rec_text "${1}")" || return 1
  _mig_txt_mine "${_t}"
}
### Every key of the record text $1 within its grammar; the first failing
### reason printed, status 1. Unknown keys are left to the caller.
_mig_txt_valid() {
  local _t="${1}" _v _role _peer _ip _k
  local -a _ips
  _role="$(_mig_txt_get "${_t}" _MIG_ROLE)"
  case "${_role}" in
    source|target) ;;
    *) echo "invalid _MIG_ROLE '${_role}'"; return 1 ;;
  esac
  _v="$(_mig_txt_get "${_t}" _MIG_HOST_IP)"
  _mig_quad "${_v}" || { echo "invalid _MIG_HOST_IP '${_v}'"; return 1; }
  _peer="$(_mig_txt_get "${_t}" _MIG_PEER_IP)"
  if [ -n "${_peer}" ] && ! _mig_peer_ok "${_peer}"; then
    echo "invalid _MIG_PEER_IP '${_peer}'"
    return 1
  fi
  if [ "${_role}" = "target" ] && [ -z "${_peer}" ]; then
    echo "target record without _MIG_PEER_IP"
    return 1
  fi
  _v="$(_mig_txt_get "${_t}" _MIG_PEER_IPS)"
  IFS=' ,' read -r -a _ips <<< "${_v}"
  for _ip in "${_ips[@]}"; do
    _mig_peer_ok "${_ip}" || { echo "invalid _MIG_PEER_IPS address '${_ip}'"; return 1; }
  done
  _v="$(_mig_txt_get "${_t}" _MIG_PEER_OCT)"
  if [ -n "${_v}" ] && ! _mig_valid_acct "${_v}"; then
    echo "invalid _MIG_PEER_OCT '${_v}'"
    return 1
  fi
  _v="$(_mig_txt_get "${_t}" _MIG_MODE)"
  _mig_valid_mode "${_v}" || { echo "invalid _MIG_MODE '${_v}'"; return 1; }
  _v="$(_mig_txt_get "${_t}" _MIG_SCOPE)"
  case "${_v}" in
    account|box|"") ;;
    *) echo "invalid _MIG_SCOPE '${_v}'"; return 1 ;;
  esac
  _v="$(_mig_txt_get "${_t}" _MIG_DEADLINE)"
  if [ -n "${_v}" ] && [ "${_v}" != "none" ] && ! _mig_valid_date "${_v}"; then
    echo "invalid _MIG_DEADLINE '${_v}'"
    return 1
  fi
  for _k in _MIG_RETIRE_DATE _MIG_STAMPED _MIG_ADOPTED _MIG_RELAY_ENDED; do
    _v="$(_mig_txt_get "${_t}" "${_k}")"
    if [ -n "${_v}" ] && ! _mig_valid_date "${_v}"; then
      echo "invalid ${_k} '${_v}'"
      return 1
    fi
  done
  return 0
}
### The epoch the account $1 was proxied at, printed when its root marker is
### valid: root shape, the grammar, COMPLETE, and a sane date (no later than
### a day ahead). Status 1 otherwise.
_mig_mark_at() {
  local _n _t _at
  _n="$(_mig_mark "${1}")" || return 1
  _t="$(_mig_root_text "${_n##*/}")" || return 1
  [ "$(_mig_txt_get "${_t}" _MIG_PROXIED)" = "COMPLETE" ] || return 1
  _at="$(_mig_txt_get "${_t}" _MIG_PROXIED_AT)"
  [[ "${_at}" =~ ^[0-9]{9,11}$ ]] || return 1
  [ "${_at}" -le "$(( $(date +%s) + 86400 ))" ] || return 1
  printf '%s\n' "${_at}"
}
_mig_is_proxied() {
  _mig_mark_at "${1}" > /dev/null
}
### Records written into log/ by older tools are imported once, by
### migration_proxy_trust.sh adopt --once, and never read after that. The
### BOA agent pass runs it; this is the fallback for a verb that reads
### records before that pass. A no-op once the stamp exists.
_mig_adopt_once() {
  [ -e "${_MIG_ADOPT_STAMP}" ] && return 0
  [ -x "${_MIG_TRUST_TOOL}" ] || return 0
  if ! bash "${_MIG_TRUST_TOOL}" adopt --once; then
    echo "ALRT: record adoption did not complete; log records stay unread (no decision is taken from them)"
  fi
  return 0
}
### The target a source-role root record of this box names for account $1,
### once the record is strictly valid; empty otherwise.
_mig_src_peer() {
  local _t
  _t="$(_mig_rec_text "${1}")" || return 0
  [ "$(_mig_txt_get "${_t}" _MIG_ROLE)" = "source" ] || return 0
  _mig_txt_mine "${_t}" || return 0
  _mig_txt_valid "${_t}" > /dev/null || return 0
  _mig_txt_get "${_t}" _MIG_PEER_IP
}
### Display only, never a decision input: whether anything sits at the
### account's own log/proxied.pid (read through the handle, so a link or a
### FIFO there counts as seen, never as followed).
_log_pid_seen() {
  _mig_hread "/data/disk/${1}/log" proxied.pid root > /dev/null
  [ "$?" -ne 3 ]
}

_sane_ident() {
  local _v="${1//[^A-Za-z0-9_]/}"
  [ "${_v}" = "$1" ] && [ -n "${_v}" ] && echo "${_v}"
}

### An alias field; .drush is oN's, so the alias is read inside the real
### directory, never through a link or into a FIFO put at the name.
_alias_field() {
  _read_file "$1" \
    | sed -n "s/.*'$2'[[:space:]]*=>[[:space:]]*'\([^']*\)'.*/\1/p" \
    | head -n1
}

### The account proves it owns a database by logging in as its own user and
### using it: BOA sets db_user == db_name (one user per site DB), so a login
### as that user with that password can reach only databases the account
### really owns. $1 = db (== user), $2 = its password. The socket login
### matches the user at 'localhost'; Provision also grants every site user
### at '127.0.0.1' (and imported users hold '%'), which a TCP login to this
### box's own server on 3306 matches whatever _THIS_DB_HOST the box uses.
_cred_ok() {
  [ -n "$1" ] && [ -n "$2" ] || return 1
  mysql -u"$1" -p"$2" -N -B -e "USE \`$1\`" > /dev/null 2>&1 && return 0
  mysql --protocol=tcp -h127.0.0.1 -P3306 -u"$1" -p"$2" -N -B \
    -e "USE \`$1\`" > /dev/null 2>&1
}

### db_name for the site at $1, echoed ONLY when it is the account's own:
### the site_path must lie under the account, its drushrc is read inside the
### real directory (never through a link or FIFO), db_user must equal
### db_name, and the account's own credentials must open it. A database is
### dumped or dropped only when all of that holds. Returns 1 when the site
### has no drushrc.php at all, or one that defines no database; any other
### refusal prints the step that failed (site-path, read, db_user!=db_name,
### login) and returns 2.
_acct_owns_db() {
  local _sp="$1" _rc _dn _du _dp
  case "${_sp}/" in
    "${_USR}"/*) ;;
    *)
      [ -e "${_sp}/drushrc.php" ] || [ -L "${_sp}/drushrc.php" ] || return 1
      echo "site-path"
      return 2
      ;;
  esac
  [ -e "${_sp}/drushrc.php" ] || [ -L "${_sp}/drushrc.php" ] || return 1
  _rc="$(_read_file "${_sp}/drushrc.php")"
  ### A site without a database: a site on the 'none' database server (a
  ### Grav site, a Textpattern or Grav site kept without a store) carries a
  ### drushrc.php that defines no db_name at all, only 'installed' and the
  ### package list. Nothing to prove, nothing to dump or drop: the same
  ### return as no drushrc, never the fail-closed 'read' below, which is for
  ### a db_name that is defined and cannot be read sanely.
  printf '%s\n' "${_rc}" | grep -q "^[$]options\['db_name'\]" || return 1
  _dn=$(printf '%s\n' "${_rc}" \
    | sed -n "s/^\$options\['db_name'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" | head -n1)
  _du=$(printf '%s\n' "${_rc}" \
    | sed -n "s/^\$options\['db_user'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" | head -n1)
  _dp=$(printf '%s\n' "${_rc}" \
    | sed -n "s/^\$options\['db_passwd'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" | head -n1)
  _dn="$(_sane_ident "${_dn}")"
  [ -n "${_dn}" ] || { echo "read"; return 2; }
  [ "${_du}" = "${_dn}" ] || { echo "db_user!=db_name"; return 2; }
  _cred_ok "${_dn}" "${_dp}" || { echo "login"; return 2; }
  echo "${_dn}"
}

### _acct_owns_db for the site at $1 in _map_account: sets _db to the proven
### database, or empty; a site whose drushrc.php exists but whose database
### cannot be proven is added to _MAP_UNPROVEN as <site_path>:<step>.
_map_own_db() {
  local _out _rc
  _db=""
  _out="$(_acct_owns_db "$1")"
  _rc=$?
  if [ "${_rc}" = "0" ]; then
    _db="${_out}"
  elif [ "${_rc}" = "2" ]; then
    _MAP_UNPROVEN="${_MAP_UNPROVEN} ${1}:${_out}"
  fi
}

### -------------------------------------------------------------- state ---

_state_file() {
  echo "${_XTRIM_STATE_DIR}/xtrim.$1.$2.state"
}

_state_write() {
  ### $1 verb, $2 acct, $3 mode, $4 status
  {
    echo "_LAST_VERB=$1"
    echo "_LAST_MODE=$3"
    echo "_LAST_STATUS=$4"
    echo "_LAST_TS=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
  } > "$(_state_file "$1" "$2")"
  chmod 600 "$(_state_file "$1" "$2")" 2>/dev/null
}

_require_clean_dry() {
  ### $1 verb, $2 acct: --live is armed only by a CLEAN DRY of the SAME
  ### verb for the SAME account, and the token is consumed before work.
  local _f
  _f="$(_state_file "$1" "$2")"
  if [ ! -r "${_f}" ] \
    || ! grep -q "^_LAST_VERB=$1$" "${_f}" \
    || ! grep -q "^_LAST_MODE=DRY$" "${_f}" \
    || ! grep -q "^_LAST_STATUS=CLEAN$" "${_f}"; then
    _die "$1 --live for $2 requires a prior CLEAN DRY run of '$1' -- run 'xtrim $1 $2' first"
  fi
  _state_write "$1" "$2" LIVE LIVE
}

_phase_get() {
  local _f="${_XTRIM_BASE}/$1/phase.txt"
  [ -r "${_f}" ] && cat "${_f}" 2>/dev/null | tr -d '\n'
}

_phase_set() {
  mkdir -p "${_XTRIM_BASE}/$1"
  echo -n "$2" > "${_XTRIM_BASE}/$1/phase.txt"
}

### ---------------------------------------------------------- discovery ---

_load_cnf_defaults() {
  ### Operator values in the master cnf always win; scrub to numeric.
  [ -e "/root/.barracuda.cnf" ] && . /root/.barracuda.cnf
  _MIN_DAYS="${_XTRIM_MIN_DAYS:-14}"
  case "${_MIN_DAYS}" in ''|*[!0-9]*) _MIN_DAYS=14 ;; esac
  ### Hard floor: a proxy younger than 7 days has not proven itself quiet.
  [ "${_MIN_DAYS}" -lt "7" ] && _MIN_DAYS=7
}

_list_accounts() {
  local _d _n
  for _d in $(find /data/disk/ -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort); do
    _n="$(basename "${_d}")"
    case "${_n}" in
      arch|all|lost+found|lostfound|backups|codebases-cleanup) continue ;;
    esac
    [ -e "${_d}/log/cores.txt" ] || continue
    echo "${_n}"
  done
}

_settings_here() {
  [ -f ./settings.php ] && [ ! -L ./settings.php ]
}
### True when the vhost $2 of the account $1 is the control panel of another box,
### which a sync carried here: its root is the account's panel tree, in the plain
### spelling, and holds no such panel. It is no site of this account and nothing of
### it was proxied. xoct reads it by the same rule.
_vhost_other_panel() {
  local _r
  _r="$(_read_file "/data/disk/${1}/config/server_master/nginx/vhost.d/${2}" \
    | sed -n 's/^[[:space:]]*root[[:space:]][[:space:]]*\([^;[:space:]]*\)[[:space:]]*;.*/\1/p' \
    | head -n 1)"
  case "${_r}" in
    */|*//*|*/./*|*/.|*/..|*/../*|*[!A-Za-z0-9_./-]*) return 1 ;;
    "/data/disk/${1}"/aegir/*) ;;
    *) return 1 ;;
  esac
  ! _in_real_dir "${_r}/sites/${2}" _settings_here
}

_panel_only() {
  ### $1 acct: true when the account's only live vhost is its own (local,
  ### non-proxy) control panel -- nothing of it was ever proxied.
  ### vhost.d is the account's: listed and read inside the real directory.
  local _oN="$1" _vhd="/data/disk/$1/config/server_master/nginx/vhost.d" _u _n=0 _d
  _u="$(_alias_field "/data/disk/${_oN}/.drush/hostmaster.alias.drushrc.php" "uri")"
  [ -n "${_u}" ] || return 1
  [ -e "${_vhd}/${_u}" ] || return 1
  _read_file "${_vhd}/${_u}" | grep -q "proxy_pass" && return 1
  while IFS= read -r _d; do
    [ -n "${_d}" ] || continue
    _vhost_other_panel "${_oN}" "${_d}" || _n=$(( _n + 1 ))
  done < <(_names_in "${_vhd}" ! -name '.*' ! -name 'https.*' \
    ! -name "${_u}" ! -name "www.${_u}")
  [ "${_n}" = "0" ]
}

_resolve_mnt_store() {
  ### The single attached store, when one exists. More than one /mnt mount
  ### is a refusal for any deletion that resolves into /mnt.
  _MNT_STORE=""
  _MNT_COUNT=$(mount 2>/dev/null | awk '$3 ~ /^\/mnt\// { print $3 }' | sort -u | wc -l | tr -d ' ')
  if [ "${_MNT_COUNT}" = "1" ]; then
    _MNT_STORE=$(mount 2>/dev/null | awk '$3 ~ /^\/mnt\// { print $3 }' | sort -u | head -1)
  fi
}

_safe_resolved() {
  ### $1 path, $2 acct root: resolved target must live inside the account
  ### or inside this account's own part of the single /mnt store (the
  ### store layout <mount>/files/<oN>/...). static/ is group-writable, so a
  ### link there can name another account's store: anything else is refused
  ### upstream.
  local _r
  _r=$(readlink -f "$1" 2>/dev/null)
  [ -z "${_r}" ] && return 1
  case "${_r}" in
    "$2"/*) echo "${_r}"; return 0 ;;
  esac
  if [ -n "${_MNT_STORE}" ]; then
    case "${_r}" in
      "${_MNT_STORE}/files/${2##*/}"/*) echo "${_r}"; return 0 ;;
    esac
  elif [ "${_MNT_COUNT}" != "0" ]; then
    return 1
  fi
  return 1
}

### The static/ trees removed, run inside the real static/ ($1 account, $2
### its root), control kept: a link's store is removed only when it
### resolves where _safe_resolved allows, and as a name inside its real
### parent directory; the link itself always goes, never followed by rm.
_trim_static_here() {
  local _f _r
  if [ -L ./files ]; then
    _r="$(_safe_resolved ./files "${2}")"
    if [ -n "${_r}" ]; then
      _in_real_dir "${_r%/*}" rm -rf -- "./${_r##*/}" && rm -f -- ./files \
        && _info "${1}: removed resolved files store ${_r}"
    else
      _alrt "${1}: static/files resolves outside the account/store -- left in place"
    fi
  fi
  for _f in ./*; do
    [ -e "${_f}" ] || continue
    case "${_f#./}" in
      control) continue ;;
    esac
    if [ -L "${_f}" ]; then
      _r="$(_safe_resolved "${_f}" "${2}")"
      if [ -n "${_r}" ]; then
        _in_real_dir "${_r%/*}" rm -rf -- "./${_r##*/}"
        rm -f -- "${_f}"
        _info "${1}: removed static tree ${2}/static/${_f#./} (store ${_r})"
      else
        ### The link resolves outside the account and its own store, so the
        ### store is not this account's to remove: keep both, name the target,
        ### and leave the deletion to a deliberate decision.
        _alrt "${1}: static/${_f#./} resolves to $(readlink -f "${_f}" 2> /dev/null) outside the account/store -- link and data left in place"
        continue
      fi
    else
      rm -rf -- "${_f}"
      _info "${1}: removed static tree ${2}/static/${_f#./}"
    fi
  done
}

_map_account() {
  ### Populates the per-account map. Everything downstream reads ONLY
  ### these; nothing re-derives mid-deletion.
  local _oN="$1" _v _d _al _sp _db
  _USR="/data/disk/${_oN}"
  _VHD="${_USR}/config/server_master/nginx/vhost.d"
  _MAP_DOMS=""; _MAP_TGT=""; _MAP_TGT_BAD=""; _MAP_REDIR=""; _MAP_TGT_FROM_REC=NO
  _MAP_REC_TGT=""; _MAP_VHOST_TGT=""
  _MAP_SITES=""; _MAP_DBS=""; _MAP_HM_DB=""; _MAP_ALL_DBS=""; _MAP_UNPROVEN=""
  _MAP_HM_WHY=""
  _MAP_PLATS=""; _MAP_NOSAVED=""
  ### The account's own control panel is never proxied: the cutover leaves
  ### it LOCAL in maintenance mode on this box (its vhost is a plain PHP
  ### vhost by design, not an integrity failure), so it is kept out of the
  ### proxy map, its database and panel platform out of stage B, and the
  ### default include + pool it answers through out of stage A. The panel
  ### name is the hostmaster alias uri, never a hostname guess.
  _MAP_PANEL_DOM=""; _MAP_PANEL_LOCAL=NO
  if [ -r "${_USR}/.drush/hostmaster.alias.drushrc.php" ]; then
    _MAP_PANEL_DOM="$(_alias_field "${_USR}/.drush/hostmaster.alias.drushrc.php" "uri")"
  fi
  ### Live vhosts must all be proxies pointing at ONE target. vhost.d is the
  ### account's: each vhost is listed and read inside the real directory,
  ### never through a link or into a FIFO put at its name.
  local _vt
  for _d in $(_names_in "${_VHD}" ! -name '.*' ! -name 'https.*'); do
    _vt="$(_read_file "${_VHD}/${_d}")"
    if [ -n "${_MAP_PANEL_DOM}" ] \
      && { [ "${_d}" = "${_MAP_PANEL_DOM}" ] || [ "${_d}" = "www.${_MAP_PANEL_DOM}" ]; } \
      && ! printf '%s\n' "${_vt}" | grep -q "proxy_pass"; then
      _MAP_PANEL_LOCAL=YES
      continue
    fi
    _vhost_other_panel "${_oN}" "${_d}" && continue
    _MAP_DOMS="${_MAP_DOMS} ${_d}"
    ### A site named under THIS box's own hostname was renamed on the target
    ### by the cutover, and its old name is answered here with a 301 to the
    ### new one: xoct's redirect vhost carries its own banner, no proxy_pass
    ### and no fastcgi site, only a bare return 301. It is a live vhost of a
    ### proxied account, not an integrity failure: it stays in the map (the
    ### liveness probe re-probes a renamed name under its new name on the
    ### target) and is counted as its own class -- no stage reads a target
    ### from it, no stage has content to shrink behind it, and it keeps
    ### serving after finalize like every other kept vhost under config/.
    ### The reader matches the writer: any other 301-only vhost still fails
    ### the integrity check below.
    if printf '%s\n' "${_vt}" | grep -q "renamed site: redirect to its new name" \
      && ! printf '%s\n' "${_vt}" | grep -q "proxy_pass" \
      && ! printf '%s\n' "${_vt}" | grep -q "fastcgi_param db_name" \
      && printf '%s\n' "${_vt}" | grep -q "^[[:space:]]*return 301 "; then
      _MAP_REDIR="${_MAP_REDIR} ${_d}"
      [ -e "${_VHD}/.${_d}" ] || _MAP_NOSAVED="${_MAP_NOSAVED} ${_d}"
      continue
    fi
    if ! printf '%s\n' "${_vt}" | grep -q "proxy_pass" \
      || printf '%s\n' "${_vt}" | grep -q "fastcgi_param db_name"; then
      _MAP_TGT_BAD="${_MAP_TGT_BAD} ${_d}:not-a-proxy-vhost"
    fi
    _t=$(printf '%s\n' "${_vt}" | grep -m1 "proxy_pass" \
      | sed "s|.*proxy_pass[[:space:]]*https\{0,1\}://||; s|;.*||" | tr -d ' ')
    if [ -n "${_t}" ]; then
      if [ -z "${_MAP_TGT}" ]; then
        _MAP_TGT="${_t}"
      elif [ "${_MAP_TGT}" != "${_t}" ]; then
        _MAP_TGT_BAD="${_MAP_TGT_BAD} ${_d}:target-${_t}-disagrees-with-${_MAP_TGT}"
      fi
    fi
    [ -e "${_VHD}/.${_d}" ] || _MAP_NOSAVED="${_MAP_NOSAVED} ${_d}"
  done
  ### An account whose sites were ALL named under the old box name carries
  ### only redirect vhosts, so no proxy_pass names its target: the root
  ### policy record does (source role, this box's own, strictly valid).
  ### Derived HERE, not in the preflight, so every reader of the map
  ### (status, restore) sees the same target.
  _MAP_REC_TGT="$(_mig_src_peer "${_oN}")"
  if [ -z "${_MAP_TGT}" ] && [ -n "${_MAP_REDIR// /}" ]; then
    _MAP_TGT="${_MAP_REC_TGT}"
    [ -n "${_MAP_TGT}" ] && _MAP_TGT_FROM_REC=YES
  fi
  ### Root connects to the mapped target (the target proofs, the probes
  ### after a restore), so the address is the root record's: a proxy_pass
  ### is the account's to write and only has to agree with it. Without that
  ### record, or when the two disagree, no target is mapped; the vhost's own
  ### address is kept apart, for the refusal alone.
  if [ -n "${_MAP_TGT}" ] && [ "${_MAP_TGT}" != "${_MAP_REC_TGT}" ]; then
    _MAP_VHOST_TGT="${_MAP_TGT}"
    _MAP_TGT=""
  fi
  ### Sites + DBs from the drush aliases (authoritative), sqlclean idioms:
  ### context_type == site, anchored db_name parse, fail-closed idents.
  for _al in "${_USR}"/.drush/*.alias.drushrc.php; do
    [ -e "${_al}" ] || continue
    case "$(basename "${_al}")" in
      hostmaster.alias*|hm.alias*|none.alias*|self*|platform_*|server_*) continue ;;
    esac
    [ "$(_alias_field "${_al}" "context_type")" = "site" ] || continue
    _sp="$(_alias_field "${_al}" "site_path")"
    [ -z "${_sp}" ] && continue
    _MAP_SITES="${_MAP_SITES} ${_sp}"
    ### Only a database the account can prove it owns enters the drop list;
    ### a site whose drushrc names one that cannot be proven fails the
    ### preflight (see _MAP_UNPROVEN there).
    _map_own_db "${_sp}"
    [ -n "${_db}" ] && _MAP_DBS="${_MAP_DBS} ${_db}"
  done
  _MAP_DBS=$(echo "${_MAP_DBS}" | tr ' ' '\n' | sort -u | tr '\n' ' ')
  ### The account's OWN dedicated Aegir site (oN.<this-host-fqdn>) is local
  ### infrastructure, not client data: an xoct move gives the account a
  ### FRESH one on the target under the target's hostname, so this database
  ### has no same-named counterpart there by construction. Classify it now
  ### so the target proof can hold client data to a strict name match while
  ### judging the account's own plumbing by whether the account really
  ### exists and serves on the target.
  _MAP_OWN_DBS=""
  local _selfdom
  _selfdom="${_oN}.$(hostname -f 2>/dev/null | tr -d '\n')"
  if [ -r "${_USR}/.drush/${_selfdom}.alias.drushrc.php" ]; then
    _sp="$(_alias_field "${_USR}/.drush/${_selfdom}.alias.drushrc.php" "site_path")"
    if [ -n "${_sp}" ]; then
      _db="$(_acct_owns_db "${_sp}")" || _db=""
      [ -n "${_db}" ] && _MAP_OWN_DBS="${_MAP_OWN_DBS} ${_db}"
    fi
  fi
  ### The account panel database. Ownership proven like every other; the
  ### panel is only exempt from the target-NAME proof, never from ownership.
  if [ -r "${_USR}/.drush/hostmaster.alias.drushrc.php" ]; then
    _sp="$(_alias_field "${_USR}/.drush/hostmaster.alias.drushrc.php" "site_path")"
    if [ -n "${_sp}" ]; then
      _MAP_HM_DB="$(_acct_owns_db "${_sp}")" || {
        _MAP_HM_WHY="${_MAP_HM_DB}"
        _MAP_HM_DB=""
      }
    fi
  fi
  ### Platform roots come from platform_* aliases, never a glob.
  for _al in "${_USR}"/.drush/platform_*.alias.drushrc.php; do
    [ -e "${_al}" ] || continue
    _d="$(_alias_field "${_al}" "root")"
    case "${_d}" in
      /*) _MAP_PLATS="${_MAP_PLATS} ${_d}" ;;
    esac
  done
  _MAP_PLATS=$(echo "${_MAP_PLATS}" | tr ' ' '\n' | sort -u | tr '\n' ' ')
  ### One deduped work list. The panel database is normally already in
  ### the map (it is one of the account's own), so a plain concatenation
  ### dumped and dropped it twice.
  _MAP_ALL_DBS=$(echo ${_MAP_DBS} ${_MAP_HM_DB} | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ')
  if [ "${_MAP_PANEL_LOCAL}" = "YES" ]; then
    ### A local panel keeps its database (and the account's own dedicated
    ### site's), and the panel platform tree under aegir/ is not a tenant
    ### platform: neither may be dumped-and-dropped or removed.
    local _keep _x _out=""
    _keep=" ${_MAP_HM_DB} ${_MAP_OWN_DBS} "
    for _x in ${_MAP_ALL_DBS}; do
      case "${_keep}" in *" ${_x} "*) continue ;; esac
      _out="${_out} ${_x}"
    done
    _MAP_ALL_DBS=$(echo ${_out} | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ')
    _out=""
    for _x in ${_MAP_PLATS}; do
      case "${_x}" in "${_USR}"/aegir/*) continue ;; esac
      _out="${_out} ${_x}"
    done
    _MAP_PLATS=$(echo ${_out} | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ')
  fi
}

_solr_cores_for() {
  ### All historical core-name formats, both live solr trees + solr4.
  local _oN="$1" _b _c
  for _b in /var/solr9/data /var/solr7/data /opt/solr4; do
    [ -d "${_b}" ] || continue
    for _c in "${_b}/oct.${_oN}."* "${_b}/solr.${_oN}."* "${_b}/${_oN}."*; do
      [ -d "${_c}" ] && echo "${_c}"
    done
  done
}

### ------------------------------------------------------------- probes ---

_probe_catchall_baseline() {
  ### Self-calibrating negative control, taken once per account run: what does
  ### the target answer for a hostname that CANNOT exist? Anything a real
  ### domain answers that is byte-identical to that is the catch-all vhost
  ### replying, not a site.
  ###
  ### This exists because a status code proves nothing here. The probe below
  ### is the tool's whole premise -- "proven still-served by the TARGET" --
  ### and it gates a one-way DROP of this box's databases, yet a renamed
  ### site's retired old name answers 200 from the target's "Under
  ### Construction" page and used to sail through. Measured on the xb1 rig:
  ### two different impossible hostnames hash identically, the retired name
  ### hashed the same as them, and the live site differed.
  local _t="$1"
  local _bogus="no-such-site.xtrim-probe.invalid"
  _BASE_DIRECT=$(curl -s -A iCab --max-time 30 \
    --resolve "${_bogus}:80:${_t}" "http://${_bogus}/" 2>/dev/null \
    | md5sum | cut -d' ' -f1)
  _BASE_RELAY=$(curl -s -A iCab --max-time 30 \
    -H "Host: ${_bogus}" "http://127.0.0.1/" 2>/dev/null \
    | md5sum | cut -d' ' -f1)
  ### The status of the same answers: a target whose default page is missing
  ### or refused answers an error for any unknown name, with one body.
  _BASE_DIRECT_CODE=$(curl -s -o /dev/null -w '%{http_code}' -A iCab --max-time 30 \
    --resolve "${_bogus}:80:${_t}" "http://${_bogus}/" 2>/dev/null)
  _BASE_RELAY_CODE=$(curl -s -o /dev/null -w '%{http_code}' -A iCab --max-time 30 \
    -H "Host: ${_bogus}" "http://127.0.0.1/" 2>/dev/null)
}

_is_catchall_body() {
  ### $1 body file, $2 status, $3 baseline hash, $4 the baseline's own
  ### status. Meaningful for a 200: a legitimate 301/302 body is an nginx stub
  ### and carries no site content either way, and those are accepted by
  ### status for SSL-required sites. And for the one error the baseline
  ### itself answers (a 4xx or 5xx with the same body): then the default
  ### server gives that error for any name it does not hold, and a name
  ### answering it is not a site refusing.
  case "$2" in
    200) ;;
    4??|5??) [ -n "$4" ] && [ "$2" = "$4" ] || return 1 ;;
    *) return 1 ;;
  esac
  [ -n "$3" ] || return 1
  [ "$(md5sum < "$1" | cut -d' ' -f1)" = "$3" ]
}

_probe_dom() {
  ### $1 domain, $2 target ip; direct + relayed, iCab UA, spaced >=5s,
  ### failures re-verified once (BOA answers bursts with soft-404 bodies).
  local _d="$1" _t="$2" _c1 _cr
  local _b1="/tmp/.xtrim-probe-d.$$" _br="/tmp/.xtrim-probe-r.$$"
  _c1=$(curl -s -o "${_b1}" -w '%{http_code}' -A iCab --max-time 30 \
    --resolve "${_d}:80:${_t}" "http://${_d}/" 2>/dev/null)
  sleep 6
  _cr=$(curl -s -o "${_br}" -w '%{http_code}' -A iCab --max-time 30 \
    -H "Host: ${_d}" "http://127.0.0.1/" 2>/dev/null)
  ### Both legs land on the target's port 80: an SSL-Required site answers
  ### a legitimate 301 to https there, so the direct leg must accept
  ### redirects exactly like the relay leg does.
  if ! echo "${_c1}" | grep -qE '^(200|301|302)$' \
    || ! echo "${_cr}" | grep -qE '^(200|301|302)$'; then
    sleep 6
    _c1=$(curl -s -o "${_b1}" -w '%{http_code}' -A iCab --max-time 30 \
      --resolve "${_d}:80:${_t}" "http://${_d}/" 2>/dev/null)
    sleep 6
    _cr=$(curl -s -o "${_br}" -w '%{http_code}' -A iCab --max-time 30 \
      -H "Host: ${_d}" "http://127.0.0.1/" 2>/dev/null)
  fi
  ### A 200 that is byte-identical to the impossible-hostname answer is the
  ### catch-all vhost, not this site. Refusing here is the difference between
  ### "the target answers" and "the target serves THIS site", and the caller
  ### is about to drop databases on the strength of it.
  local _catch=""
  if _is_catchall_body "${_b1}" "${_c1}" "${_BASE_DIRECT}" "${_BASE_DIRECT_CODE}"; then
    _catch=" direct=CATCH-ALL"
    _c1="catchall"
  fi
  ### The relay carries the target's answer, so the target's catch-all is one
  ### too: the two boxes' pages differ after a pass on one of them alone.
  if _is_catchall_body "${_br}" "${_cr}" "${_BASE_RELAY}" "${_BASE_RELAY_CODE}" \
    || _is_catchall_body "${_br}" "${_cr}" "${_BASE_DIRECT}" "${_BASE_DIRECT_CODE}"; then
    _catch="${_catch} relay=CATCH-ALL"
    _cr="catchall"
  fi
  rm -f "${_b1}" "${_br}"
  echo "direct=${_c1} relay=${_cr}${_catch}"
  ### A basic-auth protected site challenges (401/403) from the target and
  ### through the relay alike -- that IS the site serving, the catch-all
  ### never challenges (xmass verify judges the same case the same way).
  if [ "${_c1}" = "${_cr}" ] && echo "${_c1}" | grep -qE '^(401|403)$'; then
    return 0
  fi
  echo "${_c1}" | grep -qE '^(200|301|302)$' \
    && echo "${_cr}" | grep -qE '^(200|301|302)$'
}

_probe_rename_map() {
  ### A rename-mode migration RETIRES the source's host-derived names by
  ### design: the box FQDN changed, so a site that embedded it now lives on
  ### the target as <label>.<target FQDN>. Learn the mapping once, so a
  ### retired name can be re-probed under the name it actually has instead of
  ### being counted as missing -- refusing every rename-mode shrink would be
  ### its own kind of wrong.
  _MAP_SRC_FQDN=$(hostname -f 2>/dev/null)
  _MAP_TGT_FQDN=$(ssh -o BatchMode=yes -o ConnectTimeout=10 \
    "root@${_MAP_TGT}" 'hostname -f' 2>/dev/null | tr -d '\r\n')
}

_renamed_dom() {
  ### Echo $1 with the source FQDN swapped for the target's. Empty when the
  ### domain does not embed the source FQDN -- a customer's own domain never
  ### does, and those must keep proving themselves under their real name.
  local _d="$1"
  [ -n "${_MAP_SRC_FQDN}" ] && [ -n "${_MAP_TGT_FQDN}" ] || return 0
  [ "${_MAP_SRC_FQDN}" = "${_MAP_TGT_FQDN}" ] && return 0
  case "${_d}" in
    *"${_MAP_SRC_FQDN}"*) echo "${_d//${_MAP_SRC_FQDN}/${_MAP_TGT_FQDN}}" ;;
  esac
}

_probe_dom_direct() {
  ### Direct leg only, with the same catch-all discrimination. Used for a
  ### renamed name: the relay leg goes through the SOURCE, which has no vhost
  ### for a name it never served, so only the target's answer means anything.
  local _d="$1" _t="$2" _c1
  local _b1="/tmp/.xtrim-probe-n.$$"
  _c1=$(curl -s -o "${_b1}" -w '%{http_code}' -A iCab --max-time 30 \
    --resolve "${_d}:80:${_t}" "http://${_d}/" 2>/dev/null)
  if _is_catchall_body "${_b1}" "${_c1}" "${_BASE_DIRECT}" "${_BASE_DIRECT_CODE}"; then
    _c1="catchall"
  fi
  rm -f "${_b1}"
  echo "${_c1}"
  echo "${_c1}" | grep -qE '^(200|301|302|401|403)$'
}

_target_vhost_disabled() {
  ### $1 domain: is it disabled in the panel on the target? Its vhost there holds
  ### the placeholder a Disable writes and its alias says so, as symlinkinfo reads
  ### a disabled site: a placeholder alone is a botched state or a task's own
  ### short one. Under any live account there, as _target_proof_vhosts reads them,
  ### and every copy of the name must agree: a live vhost beside a stale
  ### placeholder is not a disabled site. Read in the real vhost.d, never through
  ### a link or blocked on a FIFO the account put there. The name comes from a
  ### vhost file on this box, so it is checked before it reaches the remote shell.
  printf '%s' "$1" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || return 1
  [ "$(ssh -o BatchMode=yes -o ConnectTimeout=15 "root@${_MAP_TGT}" "
    _n=0; _ok=0; _b=\$(cd -P -- /data/disk 2>/dev/null && /bin/pwd -P)
    for _a in /data/disk/*; do
      _v=\"\${_a}/config/server_master/nginx/vhost.d\"
      [ -e \"\${_v}/$1\" ] || [ -L \"\${_v}/$1\" ] || continue
      [ -e \"\${_a}/log/CANCELLED\" ] && continue
      _n=\$((_n + 1))
      [ \"\$(cd -P -- \"\${_v}\" 2>/dev/null && /bin/pwd -P)\" = \"\${_b}/\${_a##*/}/config/server_master/nginx/vhost.d\" ] || continue
      timeout 10 dd if=\"\${_v}/$1\" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2>/dev/null \
        | grep -qE 'Do not reveal Aegir front-end URL|root[[:space:]]+/var/www/nginx-default' || continue
      timeout 10 dd if=\"\${_a}/.drush/$1.alias.drushrc.php\" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2>/dev/null \
        | grep -qiE \"'site_enabled'[[:space:]]*=>[[:space:]]*false\" || continue
      _ok=\$((_ok + 1))
    done
    [ \"\${_n}\" -gt 0 ] && [ \"\${_n}\" = \"\${_ok}\" ] && echo disabled
  " 2>/dev/null)" = "disabled" ]
}

### The operator's list of names that do not serve on the target and are
### accepted as they are: /root/.<oN>.xtrim.accept.cnf, one name a line, a
### line starting with # a comment. Root's file alone (a regular file of
### root's that no one else can write, read through one handle); a name that
### is no host name is dropped. Prints the names, one a line.
_accept_file() {
  _mig_valid_acct "${1}" && [ "${1#.}" = "${1}" ] || return 1
  printf '%s\n' "${_MIG_REC_DIR}/.${1}.xtrim.accept.cnf"
}
_accept_names() {
  local _f _t
  _f="$(_accept_file "${1}")" || return 0
  _t="$(_mig_hread "${_MIG_REC_DIR}" "${_f##*/}" root)" || return 0
  printf '%s\n' "${_t}" | sed 1d | tr -d '\r' | sed 's/[[:space:]]*$//; s/^[[:space:]]*//' \
    | grep -E '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'
}
### True when the name $2 is on the list of the account $1.
_accepted_down() {
  [ -n "${2}" ] || return 1
  _accept_names "${1}" | grep -qxF -- "${2}"
}
### True when the probe line $1 is the same refusal on both routes: one HTTP
### status of the 4xx or 5xx class from the target itself and through the
### relay. Then the relay hands on what the target answers, and the answer is
### the site's own there (its maintenance mode, a site broken before the
### move). No answer at all (000), a catch-all page and two different
### answers are never that.
_same_refusal() {
  [[ "${1}" =~ ^direct=([45][0-9]{2})\ relay=([45][0-9]{2})$ ]] \
    && [ "${BASH_REMATCH[1]}" = "${BASH_REMATCH[2]}" ]
}

_probe_all_doms() {
  local _oN="$1" _d _r _rc=0 _nd _nr _af
  _MAP_ACCEPTED=""
  _af="$(_accept_file "${_oN}")"
  ### A list that is there and is not read says so: a link, a file of
  ### another owner or one others can write is never taken, and the hint
  ### below would otherwise send the operator to a list that already names
  ### the site.
  if [ -n "${_af}" ]; then
    _mig_hread "${_MIG_REC_DIR}" "${_af##*/}" root > /dev/null 2>&1
    case "$?" in
      0|3) ;;
      *) _alrt "${_oN}: ${_af} is there and is NOT read: the list must be root's own regular file that no other user can write (chown root:root, chmod 600)" ;;
    esac
  fi
  _probe_catchall_baseline "${_MAP_TGT}"
  _probe_rename_map
  for _d in ${_MAP_DOMS}; do
    _r=$(_probe_dom "${_d}" "${_MAP_TGT}")
    if [ $? -ne 0 ]; then
      ### Before calling it a failure: was this name simply renamed with the
      ### box? Only a name embedding the source FQDN can have been, and it
      ### must then prove itself under its NEW name on the target.
      _nd=$(_renamed_dom "${_d}")
      if [ -n "${_nd}" ]; then
        sleep 6
        _nr=$(_probe_dom_direct "${_nd}" "${_MAP_TGT}")
        if [ $? -eq 0 ]; then
          _info "${_oN}: ${_d} retired by the rename; serves as ${_nd} (direct=${_nr})"
          sleep 6
          continue
        fi
        if [ "${_nr}" = "catchall" ] && _target_vhost_disabled "${_nd}"; then
          _info "${_oN}: ${_d} retired by the rename; ${_nd} is disabled in the panel on the target: the placeholder vhost, by design (direct=${_nr})"
          sleep 6
          continue
        fi
        ### A renamed site that answers a refusal of its own under its new
        ### name is judged as any other below: only a name the operator
        ### listed, and only on a status the target itself gives.
        if [[ "${_nr}" =~ ^[45][0-9]{2}$ ]]; then
          if _accepted_down "${_oN}" "${_d}"; then
            _info "${_oN}: ${_d} retired by the rename; ${_nd} does not serve on the target (direct=${_nr}): accepted, named in ${_af}"
            _MAP_ACCEPTED="${_MAP_ACCEPTED} ${_d}:${_nr}"
            sleep 6
            continue
          fi
          _alrt "${_oN}: ${_d} probe FAILED (${_r}) and its renamed form ${_nd} does not serve either (direct=${_nr})"
          _alrt "${_oN}:   when that answer is the site's own state on the target (its maintenance mode, a site broken before the move), name ${_d} in ${_af}, one name a line, and run this again"
          _rc=1
          sleep 6
          continue
        fi
        _alrt "${_oN}: ${_d} probe FAILED (${_r}) and its renamed form ${_nd} does not serve either (direct=${_nr})"
        _rc=1
        sleep 6
        continue
      fi
      ### A site disabled in the panel answers the placeholder page, and that
      ### body IS the catch-all this probe refuses: its state, not a broken
      ### name. Only that answer on both routes can be it, a dead port or a 500
      ### is something else wrong; and only the target can say so: a site
      ### disabled there after the move has no trace on this box.
      case "${_r}" in
        "direct=catchall relay=catchall"*)
          if _target_vhost_disabled "${_d}"; then
            _info "${_oN}: ${_d} is disabled in the panel on the target: the placeholder vhost, by design (${_r})"
            sleep 6
            continue
          fi
          ;;
      esac
      ### A site in its own maintenance mode, or one that was broken before
      ### the move, answers the same refusal from the target and through the
      ### relay for as long as its owner leaves it so, and would hold the
      ### account's shrink, and with it the box's finalize, for good. Nothing
      ### here can tell that state from a move that broke the site, so only
      ### the operator can: a name root listed is accepted on such an answer,
      ### said in the plan and kept in the manifest. The target-side proofs
      ### of its database still follow.
      if _same_refusal "${_r}"; then
        if _accepted_down "${_oN}" "${_d}"; then
          _info "${_oN}: ${_d} does not serve on the target (${_r}): accepted, named in ${_af}"
          _nr="${_r#direct=}"
          _MAP_ACCEPTED="${_MAP_ACCEPTED} ${_d}:${_nr%% *}"
          sleep 6
          continue
        fi
        _alrt "${_oN}: ${_d} probe FAILED (${_r})"
        _alrt "${_oN}:   the same answer on both routes: when it is the site's own state on the target (its maintenance mode, a site broken before the move), name ${_d} in ${_af}, one name a line, and run this again"
        _rc=1
        sleep 6
        continue
      fi
      _alrt "${_oN}: ${_d} probe FAILED (${_r})"
      _rc=1
    else
      _info "${_oN}: ${_d} serves through target + relay (${_r})"
    fi
    sleep 6
  done
  return ${_rc}
}

_target_ssh_ok() {
  ssh -o BatchMode=yes -o ConnectTimeout=10 "root@${_MAP_TGT}" 'echo ok' \
    2>/dev/null | grep -q ok
}

_target_proof_db() {
  ### $1 db: the TARGET must hold a schema of this name with a non-zero
  ### table count AND serve a real (non-proxy) vhost for this account --
  ### this is what stops a proxy chain being mistaken for a target.
  local _db="$1" _n
  _n=$(ssh -o BatchMode=yes -o ConnectTimeout=15 "root@${_MAP_TGT}" \
    "mysql --silent -u root -N -B -e \"SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='${_db}'\"" 2>/dev/null | tr -d ' \n')
  [ -n "${_n}" ] && [ "${_n}" != "0" ]
}

_target_proof_vhosts() {
  ### At least one REAL vhost for this account on the target (fastcgi, not
  ### proxy_pass) proves the sites genuinely serve THERE.
  local _oN="$1"
  ssh -o BatchMode=yes -o ConnectTimeout=15 "root@${_MAP_TGT}" \
    "grep -L proxy_pass /data/disk/*/config/server_master/nginx/vhost.d/* 2>/dev/null | head -1" \
    2>/dev/null | grep -q "vhost.d"
}

### True when the target holds no newer certificate than the one this box
### serves for the name $2 of the account $1 ($3 its end here, in epoch
### seconds): the paired account's own store there (the account the root
### policy record names, this account's name when it names none) holds no
### set for the name, or one that ends no later. Then the daily mirror has
### nothing to pull and nothing on this box can renew the set, since the
### target is the only issuer. Read strictly, inside the set's own real
### directory (the store is the account's there: a link at the set's name,
### or a fullchain.pem that leads out of it, is never followed; the dated
### file dehydrated links it to in the same directory is): a store or a set
### that is no real directory, a set whose end cannot be read, a newer set
### (the mirror is behind) and a target that does not answer are all "no".
_target_cert_not_newer() {
  local _oN="$1" _dom="$2" _lend="$3" _po _out
  printf '%s' "${_dom}" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || return 1
  case "${_lend}" in ''|*[!0-9]*) return 1 ;; esac
  _po="$(_mig_rec_get "${_oN}" _MIG_PEER_OCT)"
  [ -n "${_po}" ] || _po="${_oN}"
  _mig_valid_acct "${_po}" && [ "${_po#.}" = "${_po}" ] || return 1
  _out="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "root@${_MAP_TGT}" "
    _b=\$(cd -P -- /data/disk 2>/dev/null && /bin/pwd -P)
    _s=/data/disk/${_po}/tools/le/certs
    [ -n \"\${_b}\" ] && [ \"\$(cd -P -- \"\${_s}\" 2>/dev/null && /bin/pwd -P)\" = \"\${_b}/${_po}/tools/le/certs\" ] || exit 4
    [ -e \"\${_s}/${_dom}\" ] || [ -L \"\${_s}/${_dom}\" ] || { echo none; exit 0; }
    cd -P -- \"\${_s}/${_dom}\" 2>/dev/null && [ \"\$(/bin/pwd -P)\" = \"\${_b}/${_po}/tools/le/certs/${_dom}\" ] || exit 4
    _f=fullchain.pem
    if [ -L \"\${_f}\" ]; then
      _f=\$(readlink -- \"\${_f}\")
      case \"\${_f}\" in ''|*/*) exit 5 ;; esac
    fi
    _e=\$(timeout 10 dd if=\"./\${_f}\" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2>/dev/null \
      | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    [ -n \"\${_e}\" ] || exit 5
    date -ud \"\${_e}\" +%s
  " 2>/dev/null)" || return 1
  [ "${_out}" = "none" ] && return 0
  case "${_out}" in ''|*[!0-9]*) return 1 ;; esac
  [ "${_out}" -le "${_lend}" ]
}

_cert_horizon() {
  ### $1 acct: earliest notAfter behind retained https vhosts; refuses on
  ### an already-expired cert. Prints "<days> <domain>" for the earliest
  ### ("-" when none), then the names it left out: as it stands a name whose
  ### site is disabled on the target, as nr:<name> one the target holds
  ### nothing newer for.
  ### The vhosts are read inside the real vhost.d, the certificate each
  ### names as _cert_text reads it.
  local _oN="$1" _v _crt _end _now _days _min=999999 _mind="" _dis=""
  _now=$(date +%s)
  for _v in $(_names_in "${_VHD}" -name 'https.*'); do
    ### A retired (renamed) name's certificate is outside the horizon --
    ### nothing renews it; the preflight reports that class by name.
    case " ${_MAP_REDIR} " in
      *" ${_v#https.} "*) continue ;;
    esac
    _crt=$(_read_file "${_VHD}/${_v}" | grep -m1 "ssl_certificate " \
      | awk '{ print $2 }' | tr -d ';')
    [ -r "${_crt}" ] || continue
    _end=$(_cert_text "${_crt}" | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    [ -z "${_end}" ] && continue
    _end=$(date -d "${_end}" +%s 2>/dev/null)
    [ -z "${_end}" ] && continue
    _days=$(( (_end - _now) / 86400 ))
    ### A set that ended within the last day divides to 0 days: it has
    ### expired all the same, and reads as a day past its end.
    [ "${_end}" -le "${_now}" ] && [ "${_days}" -ge 0 ] && _days=-1
    ### An expired set of a site disabled in the panel on the target is that
    ### site's state, not a mirror to fix: the target's nightly renews no
    ### disabled site, so it would hold the account's shrink for good. Only
    ### an expired set asks, and the target is read strictly, so a live
    ### site's expired set still refuses.
    if [ "${_days}" -lt 0 ] && [ -n "${_MAP_TGT}" ] \
      && _target_vhost_disabled "${_v#https.}"; then
      _dis="${_dis} ${_v#https.}"
      continue
    fi
    ### So is the expired set of a live site that the target holds nothing
    ### newer for: its renewal fails there (the name's DNS left, the client
    ### let it lapse) or was never asked for, the mirror has nothing to pull,
    ### and it too would hold the shrink for good. A newer set on the target
    ### means the mirror is behind, and that still refuses.
    if [ -n "${_MAP_TGT}" ] && [ "${_days}" -lt 0 ] \
      && _target_cert_not_newer "${_oN}" "${_v#https.}" "${_end}"; then
      _dis="${_dis} nr:${_v#https.}"
      continue
    fi
    if [ "${_days}" -lt "${_min}" ]; then
      _min="${_days}"
      _mind="${_v#https.}"
    fi
  done
  echo "${_min} ${_mind:--}${_dis}"
}

### -------------------------------------------------------- preflight -----

_preflight() {
  ### The hard refusal battery. $1 acct. Sets the account map.
  local _oN="$1" _age _hz _hzd _hzx _db _fail=0 _vt
  _USR="/data/disk/${_oN}"
  [ -d "${_USR}" ] || _die "${_oN}: no such account"
  ### Eligibility triple + ownership markers.
  if [ ! -e "${_USR}/log/cores.txt" ] \
    || [ ! -e "${_USR}/log/option.txt" ] \
    || [ ! -e "${_USR}/log/email.txt" ]; then
    _die "${_oN}: not eligible: broken (cores/option/email.txt missing)"
  fi
  if [ -e "${_USR}/log/CANCELLED" ]; then
    ### Cancelled accounts belong to boa cleanup; mixing the two
    ### machineries is how customer data is lost.
    _die "${_oN}: log/CANCELLED present -- use 'boa cleanup', never xtrim"
  fi
  ### Only the root marker proves a proxied source: log/proxied.pid is the
  ### account's to write, and so are its times.
  local _at
  _at="$(_mig_mark_at "${_oN}")" \
    || _die "${_oN}: no root proxied marker (/root/.${_oN}.migproxy.proxied) -- not a proxied source; a log/proxied.pid alone is not trusted (converted before the marker existed: the BOA agent pass adopts it, or re-run xoct proxy ${_oN} <target-ip> [<target-oN>] --repair)"
  ### Age floor: the proxy must have proven itself quiet first. The age is
  ### the date the marker records, never a file time.
  _age=$(( ( $(date +%s) - _at ) / 86400 ))
  if [ "${_age}" -lt "${_MIN_DAYS}" ]; then
    _die "${_oN}: root proxied marker is ${_age}d old; floor is ${_MIN_DAYS}d (_XTRIM_MIN_DAYS)"
  fi
  ### Root disk sanity.
  local _dfp _dip
  _dfp=$(df -P / 2>/dev/null | awk 'NR==2 { gsub(/%/,""); print $5 }')
  [ -n "${_dfp}" ] && [ "${_dfp}" -gt "90" ] \
    && _die "root filesystem at ${_dfp}% -- refusing to stage dumps"
  ### Every file takes an inode: out of them the filesystem is full while
  ### its space still looks fine (btrfs keeps no count, prints -, no check).
  _dip=$(LC_ALL=C df -P -i / 2>/dev/null | awk 'NR==2 { gsub(/%/,""); print $5 }' | tr -dc '0-9')
  [ -n "${_dip}" ] && [ "${_dip}" -gt "90" ] \
    && _die "root filesystem inodes at ${_dip}% used -- refusing to stage dumps (df -i /)"
  ### Quiescence: no installer/migrator/task machinery in flight.
  for _p in boa_run.pid boa_wait.pid octopus_install_run.pid; do
    [ -e "/run/${_p}" ] && _die "/run/${_p} present -- an install/upgrade is in flight"
  done
  ### Anchored here too, for the reason the comment below already gives: the
  ### bracket trick defeats only SELF-match, so any other command line that
  ### merely mentions a provision path phantom-refuses a live shrink.
  pgrep -f '(^| )provision-[a-z0-9-]+( |$)' >/dev/null 2>&1 \
    && _die "a provision task is running -- refusing"
  ### ( |$) is load-bearing: it must not match hosting-tasks / hosting-dispatch,
  ### the per-minute pollers, or every shrink would be refused.
  pgrep -f "hosting-task( |$)" >/dev/null 2>&1 \
    && _die "an Aegir hosting task is running -- refusing"
  pgrep -f "^([^ ]*/)?(php[0-9.]*|su|env|drush[0-9]*)( |$).*provision" >/dev/null 2>&1 \
    && _die "a provision task is running -- refusing"
  ### Anchored EREs, not bracket tricks: bracketing defeats only SELF-match,
  ### while several shipped monitors run unbracketed pgreps every few
  ### minutes whose own argv would satisfy a substring pattern and phantom-
  ### refuse a live shrink. An anchored process form cannot be satisfied by
  ### any pgrep argv. Covers the tools' shebang form, the chained install's
  ### uppercase /var/backups legs, and the 'boa in-' launcher; the piped
  ### 'wget | bash' window is covered by the /run marker tests above.
  for _p in \
    "^(/[^ ]*/)?bash (-c )?/(opt|usr)/local/bin/(barracuda|octopus|xoct|xmass|sqlclean)( |$)" \
    "^(/[^ ]*/)?bash (-c )?/(var/backups|var/opt/boa-dist)/(BARRACUDA|OCTOPUS)\.sh\.txt" \
    "^(/[^ ]*/)?bash (-c )?/(opt|usr)/local/bin/boa in-"; do
    pgrep -f "${_p}" >/dev/null 2>&1 \
      && _die "an install/upgrade/migration process is running (${_p}) -- refusing"
  done
  _resolve_mnt_store
  [ "${_MNT_COUNT}" -gt "1" ] \
    && _die "more than one /mnt mount (${_MNT_COUNT}) -- refusing to resolve stores"
  ### Classification reads LOCAL aliases, so the SQL endpoint must be this
  ### box's own server -- never a remote/cluster endpoint via /root/.my.cnf.
  local _sqlh
  _sqlh=$(mysql --silent -u root -N -B -e "SELECT @@hostname" 2>/dev/null | tr -d ' \n')
  if [ -n "${_sqlh}" ]; then
    if [ "${_sqlh}" != "$(hostname 2>/dev/null)" ] \
      && [ "${_sqlh}" != "$(hostname -f 2>/dev/null)" ] \
      && [ "${_sqlh}" != "$(hostname -s 2>/dev/null)" ]; then
      _die "SQL endpoint @@hostname='${_sqlh}' is not this box -- refusing (cluster/remote /root/.my.cnf)"
    fi
  fi
  _map_account "${_oN}"
  ### Proxy integrity.
  [ "${_MAP_PANEL_LOCAL}" = "YES" ] \
    && _info "${_oN}: control panel ${_MAP_PANEL_DOM} is local by design (never proxied) -- kept out of the proxy map; its db${_MAP_HM_DB:+ ${_MAP_HM_DB}}, panel platform, default include and pool stay"
  if [ -z "${_MAP_DOMS// /}" ] && [ "${_MAP_PANEL_LOCAL}" = "YES" ]; then
    ### Nothing was ever proxied for this account: its only vhost is the
    ### local panel. There is nothing to quiesce or shrink, and finalize
    ### must not wait for it (see _panel_only).
    _info "${_oN}: panel-only account (its control panel is local, no proxied domain) -- nothing to shrink"
    ### A skip, not an exit: under 'all' the fan-out runs every account in
    ### this one process, and an exit here ended the sweep at the first
    ### panel-only account with a clean-looking status.
    return 9
  fi
  [ -z "${_MAP_DOMS// /}" ] && _die "${_oN}: no live vhosts at all"
  if [ -n "${_MAP_TGT_BAD// /}" ]; then
    _alrt "${_oN}: proxy integrity failures:${_MAP_TGT_BAD}"
    _die "${_oN}: every live vhost must be a proxy vhost agreeing on one target, or the cutover's 301 redirect for a renamed box-named site"
  fi
  [ -n "${_MAP_REDIR// /}" ] \
    && _info "${_oN}: renamed box-named site(s) answered here with a 301 to the new name (no proxy behind them, kept in the map):${_MAP_REDIR}"
  [ "${_MAP_TGT_FROM_REC}" = "YES" ] \
    && _info "${_oN}: every live vhost is a rename redirect -- target ${_MAP_TGT} taken from the root policy record"
  ### Record disagreement guard, same stance as the cert mirror: the target
  ### is the root policy record's alone (see _map_account), and the vhost's
  ### address is named here only once it is a plain one.
  if [ -n "${_MAP_VHOST_TGT}" ]; then
    _vt="${_MAP_VHOST_TGT}"
    _mig_quad "${_vt}" || _vt="(not an address)"
    [ -n "${_MAP_REC_TGT}" ] \
      && _die "${_oN}: root policy record peer ${_MAP_REC_TGT} disagrees with vhost target ${_vt} -- run 'xoct proxy ${_oN} <ip> --repair --retarget' first"
    _die "${_oN}: no root policy record (/root/.${_oN}.migproxy.cnf, role source, this box's own) names the vhost target ${_vt}; a proxy_pass is the account's to write, so root does not connect to it -- restate it: xoct proxy ${_oN} <target-ip> [<target-oN>] --repair --proxy-mode=<mode>"
  fi
  [ -z "${_MAP_TGT}" ] \
    && _die "${_oN}: could not derive the target IP: no proxy_pass names it and no root policy record (/root/.${_oN}.migproxy.cnf, role source, this box's own) does -- restate it: xoct proxy ${_oN} <target-ip> [<target-oN>] --repair --proxy-mode=<mode>"
  if [ -n "${_MAP_NOSAVED// /}" ]; then
    _alrt "${_oN}: live vhosts without a saved .original:${_MAP_NOSAVED}"
    _alrt "${_oN}: their site/db map cannot be cross-checked from the saved vhost"
  fi
  ### Cert horizon: refuse on an expired cert behind a retained vhost.
  read -r _hz _hzd _hzx <<< "$(_cert_horizon "${_oN}")"
  if [ "${_hz}" != "999999" ] && [ "${_hz}" -lt "0" ]; then
    _die "${_oN}: certificate for ${_hzd} already EXPIRED -- fix the mirror first (the target holds a newer set, or its store could not be read)"
  fi
  local _hzw _hzdis="" _hznr=""
  for _hzw in ${_hzx}; do
    case "${_hzw}" in
      nr:*) _hznr="${_hznr} ${_hzw#nr:}" ;;
      *) _hzdis="${_hzdis} ${_hzw}" ;;
    esac
  done
  [ -n "${_hzdis}" ] \
    && _info "${_oN}: expired certificate left out, its site disabled in the panel on the target (not renewed while disabled):${_hzdis}"
  [ -n "${_hznr}" ] \
    && _alrt "${_oN}: expired certificate left out, the target holds nothing newer for it (nothing for the mirror to pull; HTTPS through this relay meets the browser's warning until the target renews it) -- reported, not refused:${_hznr}"
  ### A retired (renamed) name is outside that horizon: the target no longer
  ### issues for it and the daily certificate mirror skips a vhost with no
  ### proxy_pass, so nothing on either box can renew it and a refusal here
  ### could never be cleared. Reported, never refused: the 301 keeps working
  ### over HTTP, an HTTPS visitor of the old URL meets the browser's warning.
  local _rd _rcrt _rend _rdays
  for _rd in ${_MAP_REDIR}; do
    [ -e "${_VHD}/https.${_rd}" ] || continue
    _rcrt=$(_read_file "${_VHD}/https.${_rd}" | grep -m1 "ssl_certificate " | awk '{ print $2 }' | tr -d ';')
    [ -r "${_rcrt}" ] || continue
    _rend=$(_cert_text "${_rcrt}" | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    _rend=$(date -d "${_rend}" +%s 2>/dev/null)
    [ -n "${_rend}" ] || continue
    _rdays=$(( (_rend - $(date +%s)) / 86400 ))
    [ "${_rend}" -le "$(date +%s)" ] && [ "${_rdays}" -ge 0 ] && _rdays=-1
    if [ "${_rdays}" -lt "14" ]; then
      _alrt "${_oN}: retired name ${_rd} still answers HTTPS here on a certificate nothing renews ($( [ "${_rdays}" -lt "0" ] && echo "EXPIRED ${_rdays#-}d ago" || echo "${_rdays}d left")) -- reported, not refused"
    fi
  done
  ### A site whose drushrc.php names a database the account cannot prove
  ### its own would stay outside the target-side schema proof below, and
  ### stage B would still remove its platform: nothing goes while one is
  ### listed. A panel database that cannot be proven is kept, never dropped.
  local _u
  for _u in ${_MAP_UNPROVEN}; do
    _alrt "${_oN}: site ${_u%:*}: its database cannot be proven the account's own (failed at: ${_u##*:})"
    _fail=1
  done
  [ "${_fail}" != "0" ] \
    && _die "${_oN}: site database ownership not proven -- fix the site or its alias first; nothing will be removed"
  [ -n "${_MAP_HM_WHY}" ] \
    && _alrt "${_oN}: panel database cannot be proven the account's own (failed at: ${_MAP_HM_WHY}) -- it is kept, never dumped or dropped"
  ### Target liveness for every server_name, direct AND through the proxy.
  _probe_all_doms "${_oN}" || _die "${_oN}: target liveness probes failed"
  ### Target-side proof, mandatory in v1.
  _target_ssh_ok || _die "${_oN}: cannot ssh root@${_MAP_TGT} -- the mandatory target-side proof needs it"
  _target_proof_vhosts "${_oN}" \
    || _die "${_oN}: target ${_MAP_TGT} shows no real (non-proxy) vhost -- proxy chain? refusing"
  ### CLIENT data: strict name match on the target, no exceptions.
  for _db in ${_MAP_DBS}; do
    case " ${_MAP_OWN_DBS} ${_MAP_HM_DB} " in
      *" ${_db} "*) continue ;;
    esac
    if ! _target_proof_db "${_db}"; then
      _alrt "${_oN}: target has NO populated schema '${_db}'"
      _fail=1
    fi
  done
  [ "${_fail}" != "0" ] && _die "${_oN}: target-side schema proof failed -- nothing will be dropped"
  ### The account's OWN plumbing (its panel and its dedicated Aegir site)
  ### is rebuilt fresh on the target by an xoct move, under the target's
  ### hostname, so a same-named schema there is the WRONG thing to demand:
  ### requiring it made xtrim refuse for ever on every xoct-migrated
  ### source. Prove instead that the account genuinely exists and serves
  ### its own panel on the target -- if it does not, this is not a
  ### completed migration and nothing may be dropped.
  if [ -n "${_MAP_OWN_DBS// /}" ] || [ -n "${_MAP_HM_DB}" ]; then
    if ! ssh -o BatchMode=yes -o ConnectTimeout=15 "root@${_MAP_TGT}" \
      "[ -d /data/disk/${_oN} ] && [ -s /data/disk/${_oN}/log/cores.txt ] \
       && [ -e /data/disk/${_oN}/.drush/hostmaster.alias.drushrc.php ] && echo OK" 2>/dev/null \
      | grep -q OK; then
      _die "${_oN}: target ${_MAP_TGT} has no working ${_oN} account -- refusing to drop this account's own panel/site databases"
    fi
    _info "${_oN}: account plumbing (${_MAP_OWN_DBS# }${_MAP_HM_DB:+ ${_MAP_HM_DB}}) verified by a live ${_oN} account on the target, not by name"
  fi
  _info "${_oN}: preflight CLEAN (target ${_MAP_TGT}, $(echo ${_MAP_DBS} | wc -w | tr -d ' ') site dbs, panel db ${_MAP_HM_DB:-none})"
}

### ---------------------------------------------------------- manifest ----

_write_manifest() {
  local _oN="$1" _mode="$2" _f _d
  local _mf="${_XTRIM_BASE}/${_oN}/manifest-$(date -u '+%Y%m%d-%H%M%S').txt"
  mkdir -p "${_XTRIM_BASE}/${_oN}/aliases" "${_XTRIM_BASE}/${_oN}/quarantine"
  {
    echo "# xtrim manifest ${_oN} mode=${_mode} $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    echo "target=${_MAP_TGT}"
    echo "domains=${_MAP_DOMS# }"
    echo "redirect_domains=${_MAP_REDIR# }"
    echo "site_dbs=${_MAP_DBS# }"
    echo "panel_db=${_MAP_HM_DB}"
    echo "platform_roots=${_MAP_PLATS# }"
    echo "min_days=${_MIN_DAYS}"
    echo "accepted_not_serving=${_MAP_ACCEPTED# }"
    echo "## dns snapshot"
    for _d in ${_MAP_DOMS}; do
      echo "dns ${_d} $(dig +short A "${_d}" 2>/dev/null | tr '\n' ' ')"
    done
    echo "## deletion candidates (du -sk)"
    for _f in "${_USR}/backups" "${_USR}/src" "${_USR}/distro" \
      ${_MAP_PLATS} "${_USR}/static"; do
      [ -e "${_f}" ] && du -sk "${_f}" 2>/dev/null
    done
    echo "## retained (hard deny list)"
    echo "keep ${_USR}/config (incl. ssl.d)"
    echo "keep ${_USR}/tools/le"
    echo "keep ${_USR}/log"
    echo "keep ${_USR}/.drush (archived copy below)"
  } > "${_mf}"
  cp -a "${_USR}/.drush" "${_XTRIM_BASE}/${_oN}/aliases/.drush-$(date -u '+%Y%m%d-%H%M%S')" 2>/dev/null
  [ -e "/root/.${_oN}.octopus.cnf" ] \
    && cp -a "/root/.${_oN}.octopus.cnf" "${_XTRIM_BASE}/${_oN}/aliases/" 2>/dev/null
  chmod 600 "${_mf}" 2>/dev/null
  _info "${_oN}: manifest written: ${_mf}"
}

### ------------------------------------------------------------ stage A ---

_nginx_reload_locked() {
  ### Every nginx-config writer serialises on the shared advisory lock.
  (
    exec 7>"${_NGX_LOCK}"
    flock -w 30 7 || exit 1
    nginx -t &> /dev/null || exit 2
    service nginx reload &> /dev/null
  )
}

### post.d is the account's: its fpm includes are parked as names inside the
### real directory ($1 the quarantine, $2 YES keeps the default include) and
### put back the same way, never through a link put at post.d.
_park_postd_here() {
  local _p _r=0
  for _p in ./fpm_include_default.inc ./fpm_include_panel.inc ./fpm_include_platform.inc ./fpm_include_site_*; do
    [ -e "${_p}" ] || [ -L "${_p}" ] || continue
    # a local panel keeps its default include and its own pool's include
    [ "${2}" = "YES" ] && [ "${_p}" = "./fpm_include_default.inc" ] && continue
    [ "${2}" = "YES" ] && [ "${_p}" = "./fpm_include_panel.inc" ] && continue
    mv -f -T -- "${_p}" "${1}/${_p#./}" 2> /dev/null || _r=1
  done
  return "${_r}"
}
_unpark_postd_here() {
  local _p _r=0
  for _p in "${1}"/*; do
    [ -e "${_p}" ] || [ -L "${_p}" ] || continue
    mv -f -T -- "${_p}" "./${_p##*/}" 2> /dev/null || _r=1
  done
  return "${_r}"
}

_stage_a() {
  ### Two locals: in one statement the RHS expands before _oN is assigned.
  local _oN="$1"
  local _q="${_XTRIM_BASE}/${_oN}/quarantine" _p _m _c _fail=0
  mkdir -p "${_q}/pools" "${_q}/postd" "${_q}/solr"
  _info "${_oN}: stage A -- quiesce (reversible)"
  ### Park the runner OUT of /var/xdrago (runner.sh matches any 'run-'
  ### name there) and NEVER into /var/backups/off-run (BOA hands back what
  ### it finds there: the release pass to an account that keeps its
  ### dispatcher, a promotion to each account it moves).
  if [ -e "/var/xdrago/run-${_oN}" ]; then
    mv -f "/var/xdrago/run-${_oN}" "${_q}/held-run-${_oN}"
    _info "${_oN}: dispatcher parked"
  fi
  local _w=0
  while pgrep -f "[r]un-${_oN}([^0-9a-z]|$)" >/dev/null 2>&1 \
    || pgrep -u "${_oN}" -f "hosting-dispatch|hosting-tasks|provision-" >/dev/null 2>&1; do
    _w=$(( _w + 5 ))
    [ "${_w}" -ge "900" ] && { _alrt "${_oN}: drain timeout"; _fail=1; break; }
    sleep 5
  done
  ### nginx post.d fpm includes FIRST (so nothing references the sockets),
  ### then the pool files -- never the system www<NN> pool, which backs
  ### the panel front's /sqladmin box-wide.
  ### A local panel answers through the default include and the account's
  ### default-version pool: both stay, only the per-site pins are parked.
  local _panel_pool=""
  if [ "${_MAP_PANEL_LOCAL}" = "YES" ]; then
    _panel_pool=$(grep -m1 '^_PHP_FPM_VERSION=' "/root/.${_oN}.octopus.cnf" 2>/dev/null | cut -d= -f2 | tr -d -c 0-9)
    _info "${_oN}: local panel ${_MAP_PANEL_DOM}: keeping fpm_include_default.inc and pool ${_oN}.${_panel_pool:-?}.conf"
  fi
  _p="${_USR}/config/server_master/nginx/post.d"
  if [ -e "${_p}" ] || [ -L "${_p}" ]; then
    if ! _in_real_dir "${_p}" true; then
      _alrt "${_oN}: post.d is not a real directory -- fpm includes not parked"
      _fail=1
    elif ! _in_real_dir "${_p}" _park_postd_here "${_q}/postd" "${_MAP_PANEL_LOCAL}"; then
      _alrt "${_oN}: an fpm include in post.d could not be parked"
      _fail=1
    fi
  fi
  _nginx_reload_locked || { _alrt "${_oN}: nginx reload after include removal FAILED"; _fail=1; }
  _AFFECTED_MASTERS=""
  for _p in /opt/php*/etc/pool.d/"${_oN}".conf /opt/php*/etc/pool.d/"${_oN}".*.conf; do
    [ -e "${_p}" ] || continue
    case "$(basename "${_p}")" in
      www*) continue ;;
    esac
    [ -n "${_panel_pool}" ] && [ "$(basename "${_p}")" = "${_oN}.${_panel_pool}.conf" ] && continue
    # a local panel also keeps the pool of its own (oN.hm), on any version
    [ "${_MAP_PANEL_LOCAL}" = "YES" ] && [ "$(basename "${_p}")" = "${_oN}.hm.conf" ] && continue
    _m=$(echo "${_p}" | sed "s|/opt/php\([0-9]*\)/.*|\1|")
    mv -f "${_p}" "${_q}/pools/" && _AFFECTED_MASTERS="${_AFFECTED_MASTERS} ${_m}"
  done
  for _m in $(echo "${_AFFECTED_MASTERS}" | tr ' ' '\n' | sort -u); do
    [ -x "/etc/init.d/php${_m}-fpm" ] && service "php${_m}-fpm" reload &> /dev/null
  done
  ### Solr: UNLOAD (all delete flags false) + move aside -- the reversible
  ### stop, mirroring the orphan archiver. Never 'solr delete' here.
  ### Quarantine SIBLING to the resolved data dir: /var/solrN is routinely
  ### a symlink onto the attached /mnt store, and moving a large index onto
  ### the root filesystem would fill it. The origin dir + port are recorded
  ### in MAP.txt because the core NAME does not encode the tree (oct.* cores
  ### exist on solr7 and solr9 alike) -- restore replays the map, never a
  ### name heuristic.
  for _c in $(_solr_cores_for "${_oN}"); do
    local _core _port _res _qsolr
    _core="$(basename "${_c}")"
    case "${_c}" in
      /var/solr9/*) _port=9099 ;;
      /var/solr7/*) _port=9077 ;;
      *) _port=8099 ;;
    esac
    _res="$(readlink -f "${_c}")"
    [ -d "${_res}" ] || continue
    _qsolr="$(dirname "$(dirname "${_res}")")/xtrim-quarantine"
    mkdir -p "${_qsolr}"
    curl -s --max-time 15 \
      "http://127.0.0.1:${_port}/solr/admin/cores?action=UNLOAD&core=${_core}&deleteIndex=false&deleteDataDir=false&deleteInstanceDir=false" &> /dev/null
    if mv -f "${_res}" "${_qsolr}/${_core}" 2>/dev/null; then
      echo "${_core}|$(dirname "${_res}")|${_port}|${_qsolr}/${_core}" >> "${_q}/solr/MAP.txt"
      _info "${_oN}: solr core ${_core} unloaded + quarantined at ${_qsolr}/${_core}"
    fi
  done
  ### Re-probe; any regression auto-restores and aborts.
  if [ "${_fail}" != "0" ] || ! _probe_all_doms "${_oN}"; then
    _alrt "${_oN}: stage A regression detected -- auto-restoring"
    _restore_stage_a "${_oN}" \
      || _die "${_oN}: stage A aborted; restore incomplete (see ALRT above); nothing deleted"
    _die "${_oN}: stage A aborted and restored; nothing deleted"
  fi
  _phase_set "${_oN}" "stage-a"
  _info "${_oN}: stage A complete (proxy re-probed clean)"
}

_restore_stage_a() {
  local _oN="$1"
  local _q="${_XTRIM_BASE}/${_oN}/quarantine" _p _m _c
  ### Refuse a typo outright: without this, any string returned a cheerful
  ### "restored from quarantine" having done nothing at all.
  if [ -z "${_oN}" ] || [ ! -d "/data/disk/${_oN}" ]; then
    _die "restore: no such account '${_oN}'"
  fi
  if [ ! -d "${_q}" ]; then
    _die "${_oN}: nothing to restore -- no quarantine at ${_q} (was it ever quiesced?)"
  fi
  _USR="/data/disk/${_oN}"
  case "$(_phase_get "${_oN}")" in
    stage-b*)
      _die "${_oN}: stage B already ran (or crashed mid-run) -- restore is a migration back, not an unpark (see the manifest + archived aliases)"
    ;;
  esac
  local _nn _left=0
  for _p in "${_q}"/pools/*; do
    [ -e "${_p}" ] || continue
    ### The panel pool (oN.hm.conf) is rebuilt by the ltd worker on its next
    ### pass, in the tree the box switch names: the saved copy is dropped,
    ### never moved into the tree of the account's fpm.info.
    if [ "$(basename "${_p}")" = "${_oN}.hm.conf" ]; then
      rm -f "${_p}"
      continue
    fi
    ### Multi pool oN.NN.conf encodes its tree in the filename; the single
    ### pool oN.conf is pinned by the ACCOUNT's static/control/fpm.info --
    ### the box-level _PHP_FPM_VERSION is a different knob and lands the
    ### pool in a tree whose master never serves this account.
    _nn=$(basename "${_p}" | sed -n "s/^${_oN}\.\([0-9]*\)\.conf$/\1/p")
    ### static/control is the tenant's: read inside the real directory,
    ### never through a link or into a FIFO put at either name
    if [ -z "${_nn}" ]; then
      _nn=$(_in_real_dir "${_USR}/static/control" _read_here fpm.info \
        | head -c 64 | tr -d -c 0-9)
    fi
    if [ -z "${_nn}" ]; then
      _nn=$(grep -m1 '^_PHP_FPM_VERSION' /root/.barracuda.cnf 2>/dev/null | tr -d -c 0-9)
    fi
    if [ -n "${_nn}" ] && [ -d "/opt/php${_nn}/etc/pool.d" ]; then
      _pool_line_fix "${_oN}" "${_p}" \
        || _alrt "${_oN}: the web group line of $(basename "${_p}") could not be set; restored as it was saved"
      if mv -f "${_p}" "/opt/php${_nn}/etc/pool.d/"; then
        service "php${_nn}-fpm" reload &> /dev/null
      else
        _alrt "${_oN}: could not move pool $(basename "${_p}") into /opt/php${_nn}/etc/pool.d; left in quarantine"
        _left=1
      fi
    else
      _alrt "${_oN}: cannot place pool $(basename "${_p}") -- no /opt/php${_nn:-?} tree; left in quarantine"
      _left=1
    fi
  done
  if [ -n "$(ls -A "${_q}/postd" 2> /dev/null)" ] \
    && ! _in_real_dir "${_USR}/config/server_master/nginx/post.d" \
      _unpark_postd_here "${_q}/postd"; then
    _alrt "${_oN}: fpm includes NOT put back: post.d is not a real directory, or a move failed"
    _alrt "${_oN}:   they are still in ${_q}/postd"
    _left=1
  fi
  ### Restore replays the recorded quarantine map -- origin dir + port were
  ### captured at stage A time; a name heuristic would misplace oct.* cores
  ### that live on solr7.
  local _solr_left=0 _rc
  if [ -r "${_q}/solr/MAP.txt" ]; then
    while IFS='|' read -r _core _origin _port _held; do
      if [ ! -d "${_held}" ]; then
        _alrt "${_oN}: solr core ${_core}: quarantined dir ${_held} is gone -- skipped"
        _solr_left=1
        continue
      fi
      if [ ! -d "${_origin}" ]; then
        _alrt "${_oN}: solr core ${_core}: origin ${_origin} no longer exists -- skipped"
        _solr_left=1
        continue
      fi
      if ! mv -f "${_held}" "${_origin}/${_core}"; then
        _alrt "${_oN}: could not move solr core ${_core} back to ${_origin} -- left in quarantine"
        _solr_left=1
        continue
      fi
      ### RELOAD cannot bring back a core that stage A UNLOADed: unloading
      ### DE-REGISTERS it, so reload answers 400 and the core stays dark
      ### with its index intact but invisible. CREATE with the instance dir
      ### is what re-registers it (core.properties is still in place).
      _rc=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 \
        "http://127.0.0.1:${_port}/solr/admin/cores?action=CREATE&name=${_core}&instanceDir=${_origin}/${_core}" 2>/dev/null)
      if [ "${_rc}" = "200" ]; then
        _info "${_oN}: solr core ${_core} restored to ${_origin} and re-registered"
      else
        _alrt "${_oN}: solr core ${_core} moved back but re-register returned ${_rc:-no-answer}"
        case "${_port}" in 9099) _svcR=solr9 ;; 9077) _svcR=solr7 ;; *) _svcR=jetty9 ;; esac
        _alrt "${_oN}:   the index is intact on disk; recover with a solr restart:"
        _alrt "${_oN}:   pkill -9 -u ${_svcR} || pkill -9 -f '^[^ ]*java[0-9]* .*${_svcR}' ; service ${_svcR} start"
        _solr_left=1
      fi
    done < "${_q}/solr/MAP.txt"
    ### Keep the map when anything was skipped or failed -- deleting it
    ### would erase the only record of where those cores belong.
    if [ "${_solr_left}" = "0" ]; then
      rm -f "${_q}/solr/MAP.txt"
    else
      _alrt "${_oN}: solr quarantine map KEPT at ${_q}/solr/MAP.txt (unfinished entries)"
      _left=1
    fi
  fi
  if [ -e "${_q}/held-run-${_oN}" ]; then
    ### A PROXIED account must never get its dispatcher back: its Ægir
    ### queue regenerates the site vhosts from the database and silently
    ### undoes the proxy conversion (the reason xoct parks it at
    ### conversion time). Undoing the quiesce must not undo that too, so
    ### hand it to BOA's own off-run directory instead of /var/xdrago.
    if _mig_is_proxied "${_oN}"; then
      mkdir -p /var/backups/off-run
      mv -f "${_q}/held-run-${_oN}" "/var/backups/off-run/run-${_oN}" 2>/dev/null \
        && _info "${_oN}: dispatcher kept parked (account is proxied); moved to /var/backups/off-run"
    else
      mv -f "${_q}/held-run-${_oN}" "/var/xdrago/run-${_oN}"
      chmod 700 "/var/xdrago/run-${_oN}" 2>/dev/null
    fi
  fi
  if _nginx_reload_locked; then
    _phase_set "${_oN}" "restored"
    if [ "${_left}" = "0" ]; then
      _info "${_oN}: stage A restored from quarantine"
    else
      _alrt "${_oN}: stage A restored from quarantine EXCEPT what the ALRT lines above name"
      return 1
    fi
  else
    ### Do NOT claim success on a failed configtest/reload: the files are
    ### back but nginx is still serving the quiesced configuration.
    _phase_set "${_oN}" "restored"
    _alrt "${_oN}: files restored BUT nginx configtest/reload FAILED -- the"
    _alrt "${_oN}: running config is still the quiesced one. Run 'nginx -t'"
    _alrt "${_oN}: and reload by hand before treating this account as live."
    return 1
  fi
}

### ------------------------------------------------------------ stage B ---

### The safety dumps never carry this box's GTID state. By default
### (--set-gtid-purged=AUTO) a dump taken while GTID is on (every box an
### xmass run touched: BOA's my.cnf leaves it off, xmass_gtid.cnf turns it
### on) opens with SET @@SESSION.SQL_LOG_BIN=0 and sets
### @@GLOBAL.GTID_PURGED. Loading it back then fails on this box and on any
### box sharing that history, the xmass target that replicated from it
### included (ERROR 3546 on 8.x, 1840 on 5.7). OFF writes neither. Sets
### _MYSQLDUMP_GTID to the
### option when the local mysqldump takes it: one that does not (MariaDB's)
### would refuse it and writes neither anyway, so it is asked, never assumed.
_mysqldump_gtid_opts() {
  _MYSQLDUMP_GTID=()
  if mysqldump --help 2> /dev/null | grep -q -- '--set-gtid-purged'; then
    _MYSQLDUMP_GTID=(--set-gtid-purged=OFF)
  fi
  return 0
}

_stage_b() {
  local _oN="$1"
  local _db _f _r _dumps="${_XTRIM_BASE}/${_oN}/dbdumps"
  mkdir -p "${_dumps}"
  _info "${_oN}: stage B -- data removal (ONE-WAY on this box)"
  _mysqldump_gtid_opts
  [ "${#_MYSQLDUMP_GTID[@]}" -eq 0 ] \
    && _info "${_oN}: this mysqldump takes no --set-gtid-purged: its dumps carry no GTID state"
  ### Databases: dump + verify EVERY database first, then drop, deriving
  ### from the map (saved vhosts + aliases) -- never from sqlclean.
  for _db in ${_MAP_ALL_DBS}; do
    ### A pipeline reports the LAST element's status, so `mysqldump | gzip`
    ### returns gzip's 0 even when mysqldump died -- and neither `-s` nor
    ### `gzip -t` can catch it, because gzip of an empty stream is a valid
    ### 20-byte archive and gzip of a TRUNCATED dump is a valid archive of
    ### garbage. That combination would drop a live database against a
    ### dump containing nothing. pipefail is scoped to this subshell on
    ### purpose: globally it would change the meaning of the ssh/pgrep
    ### pipelines used as boolean tests elsewhere in this file.
    ### The safety dump is the only copy this box keeps once the database
    ### is dropped, so it carries the stored routines and events as well
    ### (mysqldump writes neither unless asked; triggers it always writes).
    if ( set -o pipefail
         mysqldump "${_MYSQLDUMP_GTID[@]}" --single-transaction --quick --no-autocommit \
           --skip-add-locks --no-tablespaces --hex-blob --routines --events "${_db}" 2>/dev/null \
           | gzip > "${_dumps}/${_db}.sql.gz" ); then
      ### Two different faults, two different tests: gzip -t catches a
      ### corrupt archive, the trailer catches a well-formed archive of an
      ### incomplete dump. mysqldump writes "-- Dump completed" last and
      ### no --compact/--skip-comments is passed above, so its absence
      ### means the dump did not run to the end.
      if [ -s "${_dumps}/${_db}.sql.gz" ] \
        && gzip -t "${_dumps}/${_db}.sql.gz" 2>/dev/null \
        && gzip -dc "${_dumps}/${_db}.sql.gz" 2>/dev/null | tail -5 | grep -q "Dump completed"; then
        _info "${_oN}: ${_db} dumped + verified (complete)"
      else
        rm -f "${_dumps}/${_db}.sql.gz"
        _die "${_oN}: dump of ${_db} is empty/truncated/corrupt -- stopping BEFORE any drop"
      fi
    else
      rm -f "${_dumps}/${_db}.sql.gz"
      _die "${_oN}: mysqldump ${_db} failed -- stopping BEFORE any drop"
    fi
  done
  ### Re-prove the target one last time between dump and drop -- with the
  ### SAME classification the preflight uses. The account's own panel and
  ### dedicated site never exist under these names on an xoct target (it
  ### builds fresh ones named for its own host), so demanding them here
  ### aborted every shrink after the dumps were already taken.
  for _db in ${_MAP_DBS}; do
    case " ${_MAP_OWN_DBS} ${_MAP_HM_DB} " in
      *" ${_db} "*) continue ;;
    esac
    _target_proof_db "${_db}" \
      || _die "${_oN}: target lost schema ${_db} between dump and drop -- stopping"
  done
  ### Mark the irreversible point HERE, not at function entry: everything
  ### above (dump, verify, re-proof) deletes nothing, and stamping earlier
  ### made `restore` refuse after a failed dump that had destroyed nothing.
  _phase_set "${_oN}" "stage-b-started"
  for _db in ${_MAP_ALL_DBS}; do
    mysql --silent -u root -e "DROP DATABASE IF EXISTS \`${_db}\`" 2>/dev/null \
      && _info "${_oN}: dropped database ${_db}"
    ### Drop the paired user only when it holds no grant on any OTHER db.
    ### mysql.db stores a grant's escaped name (a\_b): compared without the
    ### escapes, or the user's own grant reads as another db's.
    _r=$(mysql --silent -u root -N -B -e \
      "SELECT COUNT(*) FROM mysql.db WHERE User='${_db}' AND REPLACE(Db,'\\\\','')<>'${_db}'" 2>/dev/null | tr -d ' \n')
    if [ "${_r}" = "0" ]; then
      ### Provision always grants an extra 127.0.0.1 account on top of the
      ### requested host -- drop all three or the user survives half-dead.
      mysql --silent -u root -e "DROP USER IF EXISTS '${_db}'@'localhost'" 2>/dev/null
      mysql --silent -u root -e "DROP USER IF EXISTS '${_db}'@'127.0.0.1'" 2>/dev/null
      mysql --silent -u root -e "DROP USER IF EXISTS '${_db}'@'%'" 2>/dev/null
    fi
  done
  ### One probe pass after the drops, not one per drop: the proxy does not
  ### depend on local SQL, and a pass costs 12 s per domain -- per drop it
  ### made a 33-domain, 33-database account take four and a half hours.
  _probe_all_doms "${_oN}" >/dev/null 2>&1 \
    || _alrt "${_oN}: probe wobble after the drops -- proxy does not depend on local SQL, continuing"
  mysqladmin -u root flush-privileges &> /dev/null
  ### Trees: backups, exports, distro, platforms, dated static trees.
  for _f in "${_USR}/backups" "${_USR}/src" "${_USR}/undo" "${_USR}/distro"; do
    [ -e "${_f}" ] && rm -rf "${_f}" && _info "${_oN}: removed ${_f}"
  done
  ### A platform root comes from an alias in .drush, which is oN's: it is
  ### removed only as a name inside its real parent directory in the
  ### account, so no link or .. on the way can take the removal elsewhere.
  for _f in ${_MAP_PLATS}; do
    _f="${_f%/}"
    case "${_f}" in
      "${_USR}"/?*) ;;
      *) _alrt "${_oN}: platform root ${_f} lies outside the account -- left in place"; continue ;;
    esac
    [ -e "${_f}" ] || continue
    if ! _in_real_dir "${_f%/*}" true; then
      _alrt "${_oN}: platform root ${_f} is not in a real directory of the account -- left in place"
      continue
    fi
    _in_real_dir "${_f%/*}" rm -rf -- "./${_f##*/}" \
      && _info "${_oN}: removed platform ${_f}"
  done
  ### The files store: resolve FIRST, delete the resolved directory, then
  ### the symlink -- never 'rm -rf static' blind (the known cleanup leak).
  ### static/ is group-writable: its entries are listed and removed from
  ### inside the real directory, never through a link put in its place.
  if _in_real_dir "${_USR}/static" true; then
    _in_real_dir "${_USR}/static" _trim_static_here "${_oN}" "${_USR}"
  elif [ -e "${_USR}/static" ] || [ -L "${_USR}/static" ]; then
    _alrt "${_oN}: static/ is not a real directory of the account -- left in place"
  fi
  ### Stamp BEFORE the closing probe: the deletion is already complete, so
  ### a probe wobble must not leave the account stuck at stage-b-started,
  ### where finalize would refuse for ever and restore is meaningless.
  _phase_set "${_oN}" "stage-b"
  _probe_all_doms "${_oN}" \
    || _alrt "${_oN}: POST-REMOVAL probe failed -- data removal COMPLETED; proxy vhosts untouched, investigate the proxy"
  _info "${_oN}: stage B complete; dumps retained under ${_dumps}"
}

### --drop-datadir removes MySQL's data. /var/lib/mysql is a real folder, or a
### symbolic link onto a folder of the attached mount: rm -rf of a link takes
### the link and leaves the data where it is, so there the folder the link
### names is what goes, then the link. Never a mount's own root (every store
### of the volume lives under it), nor a folder that holds no MySQL data:
### such a link is named and left for a removal by hand.
_xtrim_drop_datadir() {
  local _dd _mpA _mpB
  if [ ! -L /var/lib/mysql ]; then
    rm -rf /var/lib/mysql && _info "finalize: /var/lib/mysql DROPPED (--drop-datadir)"
    return 0
  fi
  _dd="$(readlink -f /var/lib/mysql 2> /dev/null)"
  _mpA="$(df -P "${_dd}" 2> /dev/null | awk 'NR==2 { print $NF }')"
  _mpB="$(df -P "${_dd%/*}/" 2> /dev/null | awk 'NR==2 { print $NF }')"
  if [[ "${_dd}" =~ ^(/[A-Za-z0-9._-]+)+$ ]] && [ -d "${_dd}" ] \
    && [ -n "${_mpA}" ] && [ "${_mpA}" = "${_mpB}" ] \
    && { [ -e "${_dd}/ibdata1" ] || [ -d "${_dd}/mysql" ]; }; then
    rm -rf "${_dd}" && rm -f /var/lib/mysql \
      && _info "finalize: ${_dd} DROPPED, with the link at /var/lib/mysql (--drop-datadir)"
  else
    _alrt "finalize: /var/lib/mysql is a link onto ${_dd:-nowhere}, which this run does not drop (a mount's own root, a folder without MySQL data, or a volume that is away): left as it is -- remove it by hand"
  fi
}

### ------------------------------------------------------------ stage C ---

### The buffer pool a finalized proxy's MySQL starts with. mysqld touches
### about a tenth of its configured pool as it starts, whatever data it
### holds, and this box's pool was written from its RAM for the hosting it
### used to do: on the small plan that follows a trim the kernel kills it
### for memory before it answers. The kept MySQL serves local control panels
### alone, so my.cnf takes the floor the system tuning keeps on a proxy from
### here on. The file alone, written as the tuning writes it: the running
### server keeps its pool until its next start.
_XTRIM_PROXY_POOL_MB=256
_XTRIM_MYCNF="/etc/mysql/my.cnf"
### The pool my.cnf names, in MB: every such line is read and the largest
### counts, since mysqld takes the last one and the write below sets them
### all. Status 1 when there is no line, or one is no plain M or G figure.
_proxy_sql_pool_read() {
  local _v _m _max=""
  while IFS= read -r _v; do
    if [[ "${_v}" =~ ^([0-9]{1,9})[Mm]$ ]]; then
      _m="$(( 10#${BASH_REMATCH[1]} ))"
    elif [[ "${_v}" =~ ^([0-9]{1,6})[Gg]$ ]]; then
      _m="$(( 10#${BASH_REMATCH[1]} * 1024 ))"
    else
      return 1
    fi
    [ -n "${_max}" ] && [ "${_max}" -ge "${_m}" ] || _max="${_m}"
  done < <(grep -E '^innodb_buffer_pool_size[[:space:]]*=' "${_XTRIM_MYCNF}" 2>/dev/null \
    | sed 's/^[^=]*=//' | tr -d ' \t\r')
  [ -n "${_max}" ] || return 1
  echo "${_max}"
}
_proxy_sql_pool() {
  local _mode="$1" _cur _keep="${_XTRIM_BASE}/finalize/my.cnf.before-proxy-pool"
  if ! _cur="$(_proxy_sql_pool_read)"; then
    _alrt "finalize: no plain innodb_buffer_pool_size line in ${_XTRIM_MYCNF} -- MySQL's buffer pool is left as it is; read it before a smaller plan"
    return 0
  fi
  if [ "${_cur}" -le "${_XTRIM_PROXY_POOL_MB}" ]; then
    _info "finalize: MySQL's buffer pool in ${_XTRIM_MYCNF} is ${_cur}M -- left as it is"
    return 0
  fi
  if [ "${_mode}" != "LIVE" ]; then
    _info "[DRY-PLAN] would lower MySQL's buffer pool in ${_XTRIM_MYCNF} from ${_cur}M to ${_XTRIM_PROXY_POOL_MB}M, taken at its next start (the kept MySQL serves local control panels alone, and mysqld touches about a tenth of its pool as it starts)"
    return 0
  fi
  mkdir -p "${_XTRIM_BASE}/finalize"
  ### The copy takes its name only when it is whole: a copy cut short would
  ### pass for the file as it was on the next run.
  if [ ! -s "${_keep}" ]; then
    if ! cp -p "${_XTRIM_MYCNF}" "${_keep}.new" || ! mv -f "${_keep}.new" "${_keep}"; then
      rm -f "${_keep}.new"
      _alrt "finalize: could not keep a copy of ${_XTRIM_MYCNF} -- MySQL's buffer pool is left at ${_cur}M; lower it before a smaller plan"
      return 0
    fi
  fi
  sed -i "s/^innodb_buffer_pool_size.*/innodb_buffer_pool_size = ${_XTRIM_PROXY_POOL_MB}M/g" "${_XTRIM_MYCNF}"
  if [ "$(_proxy_sql_pool_read)" = "${_XTRIM_PROXY_POOL_MB}" ]; then
    _info "finalize: MySQL's buffer pool in ${_XTRIM_MYCNF} lowered from ${_cur}M to ${_XTRIM_PROXY_POOL_MB}M, taken at its next start (the file as it was: ${_keep})"
  else
    _alrt "finalize: could not lower MySQL's buffer pool in ${_XTRIM_MYCNF} -- lower it before a smaller plan"
  fi
}
### One line for status on a finalized proxy whose MySQL runs: the pool its
### next start takes, and what a larger one means for a smaller plan.
_proxy_sql_pool_status() {
  local _cur
  [ -e "/root/.proxy.cnf" ] || return 0
  pgrep -x mysqld > /dev/null 2>&1 || return 0
  _cur="$(_proxy_sql_pool_read)" || {
    echo "box: MySQL runs here; no plain innodb_buffer_pool_size line in ${_XTRIM_MYCNF} -- read it before a smaller plan"
    return 0
  }
  if [ "${_cur}" -le "${_XTRIM_PROXY_POOL_MB}" ]; then
    echo "box: MySQL kept for the local control panel(s), buffer pool in ${_XTRIM_MYCNF} ${_cur}M"
  else
    echo "box: MySQL kept for the local control panel(s), buffer pool in ${_XTRIM_MYCNF} ${_cur}M -- mysqld touches about a tenth of it as it starts and may not start on a smaller plan: run xtrim finalize, then xtrim finalize --live (it lowers it to ${_XTRIM_PROXY_POOL_MB}M)"
  fi
}

_finalize() {
  local _mode="$1" _drop_datadir="$2" _n _nn _panel _p
  ### Only when every real account is shrunk. A panel-only account (its
  ### control panel local, no proxied domain) has nothing to shrink and is
  ### not waited for -- its panel keeps serving through the kept MySQL.
  for _n in $(_list_accounts); do
    if _panel_only "${_n}"; then
      _info "finalize: ${_n} is a panel-only account (no proxied domain) -- nothing to shrink, not waited for"
      continue
    fi
    if [ "$(_phase_get "${_n}")" != "stage-b" ]; then
      _die "finalize: account ${_n} is not shrunk (phase '$(_phase_get "${_n}")') -- finalize is all-accounts-or-nothing"
    fi
  done
  _panel=$(grep -m1 '^_PHP_FPM_VERSION' /root/.barracuda.cnf 2>/dev/null | tr -d -c 0-9)
  [ -z "${_panel}" ] && _panel=84
  ### Every account whose control panel stayed LOCAL (never proxied) keeps
  ### its panel database and the FPM master its panel answers through:
  ### MySQL stays up on a finalized proxy that still serves a panel, and
  ### --drop-datadir is refused there (ruling 2026-09-08).
  local _u _v _keep_sql="" _keep_masters=""
  for _n in $(_list_accounts); do
    _u="$(_alias_field "/data/disk/${_n}/.drush/hostmaster.alias.drushrc.php" "uri")"
    [ -n "${_u}" ] || continue
    [ -e "/data/disk/${_n}/config/server_master/nginx/vhost.d/${_u}" ] || continue
    _read_file "/data/disk/${_n}/config/server_master/nginx/vhost.d/${_u}" \
      | grep -q "proxy_pass" && continue
    _keep_sql="${_keep_sql} ${_n}:${_u}"
    _v=$(grep -m1 '^_PHP_FPM_VERSION=' "/root/.${_n}.octopus.cnf" 2>/dev/null | cut -d= -f2 | tr -d -c 0-9)
    [ -n "${_v}" ] && _keep_masters="${_keep_masters} ${_v}"
  done
  ### A local panel answers through its own pool (oN.hm), which lives in
  ### the tree the box switch names, else the box default: that master
  ### stays too.
  if [ -n "${_keep_sql}" ]; then
    _v=$(grep -m1 '^_HM_FPM_VERSION=' /root/.barracuda.cnf 2>/dev/null | cut -d= -f2 | tr -d -c 0-9)
    [ -n "${_v}" ] && [ -x "/opt/php${_v}/bin/php" ] || _v="${_panel}"
    _keep_masters="${_keep_masters} ${_v}"
  fi
  _keep_masters=$(echo ${_keep_masters} | tr ' ' '\n' | sort -u | tr '\n' ' ')
  if [ -n "${_keep_sql}" ] && [ "${_drop_datadir}" = "YES" ]; then
    _die "finalize: --drop-datadir refused -- local control panel(s) keep their databases here:${_keep_sql}"
  fi
  if [ "${_mode}" != "LIVE" ]; then
    _info "[DRY-PLAN] would remove shared codebases /data/all"
    if [ -n "${_keep_sql}" ]; then
      _info "[DRY-PLAN] would KEEP mysql running for the local control panel database(s):${_keep_sql}"
      _proxy_sql_pool DRY
    else
      _info "[DRY-PLAN] would stop + disable mysql (datadir kept$( [ "${_drop_datadir}" = "YES" ] && echo ", then DROPPED"))"
    fi
    _info "[DRY-PLAN] would stop + disable solr9/solr7/jetty9"
    _info "[DRY-PLAN] would keep ONLY the www${_panel} pool + master$( [ -n "${_keep_masters}" ] && echo " (and the php${_keep_masters// /,php}-fpm master(s) the local panels answer through)"); quarantine the other www pools, stop+disable their masters"
    _info "[DRY-PLAN] would touch /root/.proxy.cnf LAST"
    return 0
  fi
  mkdir -p "${_XTRIM_BASE}/finalize/pools"
  ### Shared codebases live under BOTH roots.
  [ -d "/data/all" ] && rm -rf /data/all && _info "finalize: removed /data/all"
  [ -d "/data/disk/all" ] && rm -rf /data/disk/all && _info "finalize: removed /data/disk/all"
  ### Solr off -- and DISARMED: the /var/xdrago/monitor tree is deliberately
  ### not .proxy.cnf-gated, and java.sh restarts any solr whose init script
  ### is executable. Dropping the exec bit is the guard's own key; the
  ### script stays on disk, +x re-arms it.
  for _n in solr9 solr7 jetty9; do
    if [ -x "/etc/init.d/${_n}" ]; then
      # By service account when it exists, else the JVM at argv[0]: a bare
      # token matched csf's hourly md5sum sweep (its argv names /usr/bin/java
      # and /etc/init.d/solr9) and any command line naming the service.
      if id "${_n}" &> /dev/null; then
        pkill -9 -u "${_n}" &> /dev/null
      else
        pkill -9 -f "^[^ ]*java[0-9]* .*${_n}" &> /dev/null
      fi
      update-rc.d "${_n}" disable &> /dev/null
      chmod -x "/etc/init.d/${_n}" 2>/dev/null
      _info "finalize: ${_n} stopped + disabled + watchdog disarmed (init script -x)"
    fi
  done
  ### MySQL off (datadir kept unless explicitly dropped) -- unless a local
  ### control panel still needs its database here.
  if [ -n "${_keep_sql}" ]; then
    _info "finalize: mysql KEPT running for the local control panel database(s):${_keep_sql}"
    _proxy_sql_pool LIVE
  else
    service mysql stop &> /dev/null
    update-rc.d mysql disable &> /dev/null
    _info "finalize: mysql stopped + disabled"
    if [ "${_drop_datadir}" = "YES" ]; then
      _xtrim_drop_datadir
    fi
  fi
  ### FPM: keep only the panel-front master + its www pool; a master with
  ### zero pools refuses to start, so disabling the others is stable. A
  ### master a local panel answers through keeps running on the account
  ### pool stage A left in place -- its www pool is still quarantined.
  for _p in /opt/php*/etc/pool.d/www*.conf; do
    [ -e "${_p}" ] || continue
    _nn=$(echo "${_p}" | sed "s|/opt/php\([0-9]*\)/.*|\1|")
    [ "${_nn}" = "${_panel}" ] && continue
    mv -f "${_p}" "${_XTRIM_BASE}/finalize/pools/"
    case " ${_keep_masters} " in
      *" ${_nn} "*)
        [ -x "/etc/init.d/php${_nn}-fpm" ] && service "php${_nn}-fpm" reload &> /dev/null
        _info "finalize: php${_nn}-fpm KEPT for a local control panel (www${_nn} pool quarantined)"
        continue ;;
    esac
    if [ -x "/etc/init.d/php${_nn}-fpm" ]; then
      service "php${_nn}-fpm" stop &> /dev/null
      update-rc.d "php${_nn}-fpm" disable &> /dev/null
    fi
    _info "finalize: php${_nn}-fpm stood down (www${_nn} pool quarantined)"
  done
  ### LAST: stand the ~20 .proxy.cnf consumers down. This must come after
  ### everything that still needed the database/backup/usage machinery.
  ### /var/xdrago/monitor is deliberately NOT gated by this marker -- the
  ### nginx watchdog keeps running, which is what a proxy box wants.
  if [ ! -e "/root/.proxy.cnf" ]; then
    {
      echo "# PX0 proxy node -- created by xtrim finalize $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    } > /root/.proxy.cnf
    _info "finalize: /root/.proxy.cnf created -- BOA machinery stands down"
  else
    _alrt "finalize: /root/.proxy.cnf already existed -- left as found"
  fi
  _info "finalize: COMPLETE. To retire the proxy itself later, use the boa cleanup sequence -- xtrim never does that."
  _info "finalize: before a smaller plan at the provider, read 'xtrim space' (what the root disk holds) and 'xtrim names all' (the names that still resolve here go dark while this box is off)"
}

### ------------------------------------------------------------- verbs ----

_cmd_status() {
  local _n _hz _hzd _hzx _sz _ph _tg _hzw _hzdis _hznr
  _load_cnf_defaults
  echo "xtrim status -- $(hostname -f 2>/dev/null) $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  [ -e "/root/.proxy.cnf" ] && echo "box: /root/.proxy.cnf PRESENT (finalized proxy node)"
  _proxy_sql_pool_status
  for _n in $(_list_accounts); do
    _USR="/data/disk/${_n}"
    _VHD="${_USR}/config/server_master/nginx/vhost.d"
    _ph="$(_phase_get "${_n}")"
    if ! _mig_is_proxied "${_n}"; then
      if _log_pid_seen "${_n}"; then
        echo "${_n}: log/proxied.pid without a root marker -- not trusted (adopt or xoct proxy --repair)"
      else
        echo "${_n}: NOT proxied -- not xtrim material"
      fi
      continue
    fi
    ### A panel-only account has no proxied domain, so no vhost and no record
    ### names a target for it: say what it is instead of "proxied -> ?".
    if _panel_only "${_n}"; then
      echo "${_n}: panel-only (its control panel is local, no proxied domain) | phase=${_ph:-none} | nothing to shrink"
      continue
    fi
    _map_account "${_n}"
    read -r _hz _hzd _hzx <<< "$(_cert_horizon "${_n}")"
    _hzdis=""; _hznr=""
    for _hzw in ${_hzx}; do
      case "${_hzw}" in
        nr:*) _hznr="${_hznr} ${_hzw#nr:}" ;;
        *) _hzdis="${_hzdis} ${_hzw}" ;;
      esac
    done
    _hzx=""
    [ -n "${_hzdis}" ] && _hzx=" [disabled on the target, expired:${_hzdis}]"
    [ -n "${_hznr}" ] && _hzx="${_hzx} [nothing newer on the target, expired:${_hznr}]"
    _sz=$(du -sk "${_USR}/backups" "${_USR}/src" "${_USR}/distro" \
      ${_MAP_PLATS} "${_USR}/static" 2>/dev/null | awk '{ s+=$1 } END { printf "%.1fG", s/1048576 }')
    _tg="${_MAP_TGT:-?}"
    [ -n "${_MAP_VHOST_TGT}" ] && _tg="? (its vhost target is not the root policy record's)"
    echo "${_n}: proxied -> ${_tg} | phase=${_ph:-none} | cert-horizon=$( [ "${_hz}" = "999999" ] && echo n/a || echo "${_hz}d (${_hzd})" )${_hzx} | reclaimable~${_sz}"
  done
}

### ------------------------------------------------------------- names ----

### Every name the live vhost $1 of the mapped account answers for, one a
### line: the words of its server_name lines, read inside the real vhost.d.
_vhost_names() {
  _read_file "${_VHD}/${1}" \
    | sed -n 's/^[[:space:]]*server_name[[:space:]]\{1,\}\([^;]*\);.*$/\1/p' \
    | tr -s '[:space:]' '\n' | sed '/^$/d' | LC_ALL=C sort -u
}
### A plain host name, one DNS can be asked about: no wildcard, no regex
### name, not the catch-all.
_name_plain() {
  printf '%s' "$1" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'
}
### The addresses DNS gives for the name $1, on one line: the A and AAAA
### records at the end of whatever chain this box's resolver follows (a
### CNAME's own line is no address). A lookup that fails (no reply, or an
### answer that is neither "no error" nor "no such name") is asked once
### more, and then printed as "?": a name that could not be asked about is
### never read as a name with no address.
_name_addrs() {
  local _o _t _i _ok _out=""
  for _t in A AAAA; do
    _ok=NO
    for _i in 1 2; do
      if _o="$(dig +noall +comments +answer +time=3 +tries=2 "$1" "${_t}" 2> /dev/null)" \
        && printf '%s\n' "${_o}" | grep -qE 'status: (NOERROR|NXDOMAIN)'; then
        _out="${_out}$(printf '%s\n' "${_o}" | awk -v t="${_t}" '$3 == "IN" && $4 == t { print $5 }')"$'\n'
        _ok=YES
        break
      fi
      sleep 2
    done
    if [ "${_ok}" != "YES" ]; then
      printf '?'
      return 0
    fi
  done
  printf '%s' "${_out}" | sed '/^$/d' | LC_ALL=C sort -u | tr '\n' ' ' | sed 's/ $//'
}
### Where the addresses $1 lead: HERE when one of them is this box's (the name
### still arrives here, wholly or in part), otherwise ELSEWHERE when one is
### neither this box's nor the target's, otherwise TARGET, and NONE without
### any; UNKNOWN for a lookup that failed. _NAMES_TGT_ADDRS holds the
### target's addresses.
_name_where() {
  local _a _h=NO _t=NO _o=NO
  if [ "$1" = "?" ]; then
    echo UNKNOWN
    return 0
  fi
  for _a in $1; do
    if _mig_own_addr "${_a}"; then
      _h=YES
    elif [[ " ${_NAMES_TGT_ADDRS} " == *" ${_a} "* ]]; then
      _t=YES
    else
      _o=YES
    fi
  done
  if [ "${_h}" = "YES" ]; then
    echo HERE
  elif [ "${_o}" = "YES" ]; then
    echo ELSEWHERE
  elif [ "${_t}" = "YES" ]; then
    echo TARGET
  else
    echo NONE
  fi
}

### One name of the report: $1 the name, $2 a note for its line. Prints the
### line and sets _NAMES_W to its verdict.
_names_one() {
  local _ad
  if ! _name_plain "$1"; then
    printf '  %-10s %s\n' PATTERN "$1 (no single name to ask DNS about)"
    _NAMES_W=PATTERN
    return 0
  fi
  _ad="$(_name_addrs "$1")"
  _NAMES_W="$(_name_where "${_ad}")"
  printf '  %-10s %s %s%s\n' "${_NAMES_W}" "$1" "${_ad:--}" "$2"
}

### xtrim names [<oN>|all]: for every name a proxied account's vhosts answer
### for, where its DNS points today. It reads, asks DNS and the target for
### its own addresses, and changes nothing. A name that resolves to this box
### is reached through the relay and goes dark with it; one that resolves to
### the target is done; one that resolves elsewhere sits behind a CDN or
### another front, whose origin DNS cannot show.
_cmd_names() {
  local _sel="${1:-all}" _n _d _nm _c _box=0 _accts="" _seen _unk=0
  local _nh _nt _ne _nn _nw _nb _nu _pn _rn _bn _bx
  command -v dig > /dev/null 2>&1 || _die "names needs dig on this box (the dnsutils package)"
  _load_cnf_defaults
  _bx="$(hostname -f 2>/dev/null | tr 'A-Z' 'a-z' | tr -d '\n')"
  ### Only a full host name marks a name as this box's own: a bare label
  ### would match inside a client's domain.
  case "${_bx}" in
    *.*) ;;
    *) _bx="" ;;
  esac
  echo "xtrim names -- $(hostname -f 2>/dev/null) $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  echo "this box's addresses: $(hostname -I 2>/dev/null | tr -s ' ' | sed 's/ $//')"
  for _n in $(_list_accounts); do
    [ "${_sel}" = "all" ] || [ "${_sel}" = "${_n}" ] || continue
    if ! _mig_is_proxied "${_n}"; then
      [ "${_sel}" = "all" ] || _die "${_n}: not a proxied account (no root proxied marker)"
      continue
    fi
    _seen=YES
    if _panel_only "${_n}"; then
      echo "${_n}: panel-only (its control panel is local, no proxied domain)"
      continue
    fi
    _map_account "${_n}"
    if [ -z "${_MAP_TGT}" ]; then
      echo "${_n}: no target named by a root policy record -- names not judged (see xtrim status)"
      continue
    fi
    ### The target's own addresses, IPv6 with them: the record names one
    ### IPv4 only, and an AAAA at the target would otherwise read as elsewhere.
    _NAMES_TGT_ADDRS="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "root@${_MAP_TGT}" 'hostname -I' 2>/dev/null | tr -s '[:space:]' ' ')"
    case " ${_NAMES_TGT_ADDRS} " in
      *" ${_MAP_TGT} "*) ;;
      *)
        [ -z "${_NAMES_TGT_ADDRS// /}" ] \
          && echo "${_n}: the target ${_MAP_TGT} did not give its addresses over ssh -- judged by that address alone (an AAAA at the target reads ELSEWHERE)"
        _NAMES_TGT_ADDRS="${_MAP_TGT} ${_NAMES_TGT_ADDRS}"
      ;;
    esac
    _c="$(_read_file "${_USR}/log/email.txt" | tr -s '[:space:]' ' ' | cut -c1-200)"
    _c="${_c# }"
    _c="${_c% }"
    echo "${_n}: relay to ${_MAP_TGT} | contact: ${_c:-none in log/email.txt}"
    _nh=0; _nt=0; _ne=0; _nn=0; _nw=0; _nb=0; _nu=0
    ### Every name once an account, in lower case, whatever its spelling and
    ### however many vhosts carry it. A site named under this box's own name
    ### was renamed on the target by the move, and its old vhost answers here
    ### with a 301 for ALL its names: the site's own (BOX-NAMED, this box's
    ### by its name) and every other name it carried, a client's own domain
    ### among them, which is judged like any relayed name.
    _pn=""; _rn=""; _bn=""
    for _d in ${_MAP_DOMS}; do
      case " ${_MAP_REDIR} " in
        *" ${_d} "*)
          _bn="${_bn}${_d,,}"$'\n'
          _rn="${_rn}${_d,,}"$'\n'"$(_vhost_names "${_d}" | tr 'A-Z' 'a-z')"$'\n'
        ;;
        *)
          _pn="${_pn}$(_vhost_names "${_d}" | tr 'A-Z' 'a-z')"$'\n'
        ;;
      esac
    done
    _pn="$(printf '%s' "${_pn}" | sed '/^$/d' | LC_ALL=C sort -u)"
    _rn="$(printf '%s' "${_rn}" | sed '/^$/d' | LC_ALL=C sort -u)"
    while IFS= read -r _nm; do
      [ -n "${_nm}" ] || continue
      ### This box's own by its name, and in no DNS count: a renamed site's
      ### own name, and any other name that carries this box's hostname (the
      ### rule the move renames by). It resolves here by this box's own
      ### records and is never a client's to move.
      if printf '%s' "${_bn}" | grep -qxF -- "${_nm}"; then
        printf '  %-10s %s\n' BOX-NAMED "${_nm} (answered here with a 301 to its new name)"
        _nb=$(( _nb + 1 ))
        continue
      fi
      if [ -n "${_bx}" ] && [ "${_nm}" != "${_nm//"${_bx}"/}" ]; then
        printf '  %-10s %s\n' BOX-NAMED "${_nm} (carries this box's own name)"
        _nb=$(( _nb + 1 ))
        continue
      fi
      if printf '%s\n' "${_rn}" | grep -qxF -- "${_nm}" && ! printf '%s\n' "${_pn}" | grep -qxF -- "${_nm}"; then
        _names_one "${_nm}" " (a renamed site's name: answered here with a 301)"
      else
        _names_one "${_nm}" ""
      fi
      case "${_NAMES_W}" in
        HERE) _nh=$(( _nh + 1 )) ;;
        TARGET) _nt=$(( _nt + 1 )) ;;
        ELSEWHERE) _ne=$(( _ne + 1 )) ;;
        PATTERN) _nw=$(( _nw + 1 )) ;;
        UNKNOWN) _nu=$(( _nu + 1 )) ;;
        *) _nn=$(( _nn + 1 )) ;;
      esac
    done <<< "$(printf '%s\n%s\n' "${_pn}" "${_rn}" | sed '/^$/d' | LC_ALL=C sort -u)"
    echo "${_n}: ${_nh} here, ${_nt} on the target, ${_ne} elsewhere, ${_nn} with no address, ${_nw} patterns, ${_nb} box-named, ${_nu} lookups failed"
    _unk=$(( _unk + _nu ))
    if [ "${_nh}" -gt 0 ]; then
      _box=$(( _box + _nh ))
      _accts="${_accts} ${_n}"
    fi
  done
  [ -n "${_seen}" ] || [ "${_sel}" = "all" ] || _die "${_sel}: no such account"
  echo "box: ${_box} names still resolve to this box$( [ -n "${_accts}" ] && echo ", in:${_accts}" )"
  [ "${_unk}" -gt 0 ] \
    && echo "box: ${_unk} lookups FAILED (UNKNOWN above): those names are in no count -- run this again before relying on it"
  echo "note: HERE names go dark whenever this box is down; ELSEWHERE names sit behind a CDN or another front, or on another server, and DNS cannot say whether that front still sends them here."
}

### xtrim space: what the root filesystem holds, for the read before a
### smaller plan: a provider shrinks a disk no further than the space in use.
### One pass over the root filesystem alone (other mounts are named, not
### walked), the largest trees two levels deep first. Read-only.
_cmd_space() {
  local _m
  echo "xtrim space -- $(hostname -f 2>/dev/null) $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  [ -e "/root/.proxy.cnf" ] && echo "box: /root/.proxy.cnf PRESENT (finalized proxy node)"
  LC_ALL=C df -Pk / 2>/dev/null \
    | awk 'NR == 2 { printf "root filesystem: %.1fG used of %.1fG (%s), %.1fG free\n", $3/1048576, $2/1048576, $5, $4/1048576 }'
  LC_ALL=C df -Pi / 2>/dev/null \
    | awk 'NR == 2 { printf "root filesystem inodes: %s used\n", $5 }'
  echo "largest trees on the root filesystem (two levels, other mounts not walked):"
  LC_ALL=C du -xk --max-depth=2 / 2>/dev/null | sort -rn \
    | awk 'NR > 1 && NR <= 26 { k = $1; sub(/^[0-9]+[ \t]+/, ""); printf "  %8.1fG %s\n", k/1048576, $0 }'
  echo "what a trim leaves and never removes, where present:"
  for _m in "${_XTRIM_BASE}" /var/lib/mysql /var/solr9 /var/solr7 /opt/solr4 /opt/jetty9 /data/disk/arch; do
    [ -e "${_m}" ] || continue
    LC_ALL=C du -sk "$(readlink -f "${_m}")" 2>/dev/null \
      | awk -v p="${_m}" '{ printf "  %8.1fG %s\n", $1/1048576, p }'
  done
  echo "other mounts (not part of a root disk shrink):"
  ### Every mounted filesystem that holds data, by its type: a memory or
  ### kernel filesystem is none, and a mount point may hold a blank.
  LC_ALL=C df -PTk 2>/dev/null \
    | awk 'NR > 1 && $2 !~ /^(tmpfs|devtmpfs|ramfs|overlay|squashfs|proc|sysfs|cgroup|cgroup2|efivarfs|devpts|securityfs|debugfs|tracefs|pstore|bpf|autofs|mqueue|hugetlbfs|fusectl|configfs)$/ {
        m = $7; for (i = 8; i <= NF; i++) m = m " " $i
        if (m == "/") next
        printf "  %s (%s) %.1fG used of %.1fG\n", m, $2, $4/1048576, $3/1048576; n++
      } END { if (!n) print "  none" }'
}

_run_one() {
  ### $1 verb (plan|quiesce|shrink), $2 acct, $3 mode
  local _verb="$1" _oN="$2" _mode="$3"
  local _phase
  _load_cnf_defaults
  _preflight "${_oN}"
  case $? in
    0) : ;;
    9) return 0 ;;
    *) exit 1 ;;
  esac
  _write_manifest "${_oN}" "${_mode}"
  _phase="$(_phase_get "${_oN}")"
  if [ "${_verb}" = "quiesce" ]; then
    ### Stage A as a first-class operator step. Without it the reversible
    ### state existed only for the microseconds between stage A's last
    ### statement and stage B's first, so `restore` could never be used
    ### deliberately -- the gap the first xtrim leg exposed and a ruling set out
    ### to close.
    case "${_phase}" in
      stage-b-started)
        _die "${_oN}: stage B has STARTED (deletion may be partial) -- quiesce is not meaningful; inspect ${_XTRIM_BASE}/${_oN}"
      ;;
      stage-b)
        _die "${_oN}: stage B has completed -- quiesce is not meaningful; see the manifest"
      ;;
      stage-a)
        _info "${_oN}: already quiesced (phase stage-a) -- nothing to do"
        _info "${_oN}: proceed with 'xtrim shrink ${_oN}' then 'xtrim shrink ${_oN} --live' (ONE-WAY),"
        _info "${_oN}: or undo with 'xtrim restore ${_oN}'"
        return 0
      ;;
    esac
    if [ "${_mode}" = "LIVE" ]; then
      _stage_a "${_oN}"
      _state_write quiesce "${_oN}" LIVE DONE
      _info "${_oN}: QUIESCED and reversible. Nothing has been deleted."
      _info "${_oN}:   undo   -> xtrim restore ${_oN}"
      _info "${_oN}:   proceed-> xtrim shrink ${_oN}  (DRY, then --live; ONE-WAY)"
    else
      _info "${_oN}: quiesce DRY -- would park run-${_oN}, quarantine FPM pools + post.d includes, unload+quarantine solr cores, re-probe"
      _info "${_oN}: nothing would be deleted; the account stays fully restorable"
      _state_write quiesce "${_oN}" DRY CLEAN
      _info "${_oN}: quiesce DRY CLEAN -- next: xtrim quiesce ${_oN} --live"
    fi
    return 0
  fi
  if [ "${_verb}" = "shrink" ]; then
    case "${_phase}" in
      stage-b)
        _die "${_oN}: already shrunk (phase stage-b) -- nothing left to remove"
      ;;
      stage-b-started)
        _die "${_oN}: a previous stage B did not finish (phase stage-b-started) -- inspect ${_XTRIM_BASE}/${_oN} before re-running"
      ;;
    esac
  fi
  if [ "${_verb}" = "plan" ]; then
    _info "${_oN}: PLAN (DRY): stage A would park run-${_oN}, quarantine FPM pools + post.d includes, unload+quarantine solr cores"
    _info "${_oN}: PLAN (DRY): stage B would dump+verify then DROP: ${_MAP_ALL_DBS}"
    _info "${_oN}: PLAN (DRY): stage B would remove backups/, src/, undo/, distro/, platforms, static trees (store resolved first)"
    [ -n "${_MAP_ACCEPTED// /}" ] \
      && _alrt "${_oN}: PLAN (DRY): accepted as not serving on the target, by the operator's list (name:answer):${_MAP_ACCEPTED} -- their data goes with the rest"
    _state_write plan "${_oN}" DRY CLEAN
    _info "${_oN}: plan CLEAN"
    return 0
  fi
  if [ "${_mode}" = "LIVE" ]; then
    ### An account quiesced earlier is already in stage A; re-running it
    ### would re-park an empty quarantine and re-drain for nothing.
    if [ "${_phase}" = "stage-a" ]; then
      _info "${_oN}: already quiesced -- skipping stage A, going straight to stage B"
    else
      _stage_a "${_oN}"
    fi
    _stage_b "${_oN}"
    _state_write shrink "${_oN}" LIVE DONE
  else
    _info "${_oN}: shrink DRY -- stage A/B actions planned only (see plan output above)"
    _state_write shrink "${_oN}" DRY CLEAN
    _info "${_oN}: shrink DRY CLEAN -- next: xtrim shrink ${_oN} --live"
  fi
}

_check_root
umask 022

### The run log. Every verb keeps its whole output, both streams, in
### /var/backups/reports/<tool>/<YYMMDD>/<tool>-<verb>-<YYMMDD-HHMMSS>-<pid>.log,
### readable by root alone, as barracuda and octopus keep theirs under
### reports/up; not the polled ones (xmass status, xmass autosync --run, whose
### monitor keeps each pass, and --status) nor a call with no verb. As the
### barracuda wrapper runs its worker, this process becomes a wrapper: it runs
### the same tool with the same arguments as its child, both streams into the
### file, shows the file on the console with a tail, and returns the child's
### status only once the tail has handed on the last line, so a caller that
### reads its own copy at once finds it whole. The child keeps the signal
### dispositions and the input the wrapper was started with, and the third
### header line names its pid. A daemon a verb starts inherits the file, never
### the console. A tool another migration tool runs on this box keeps no log
### and leaves its streams as they were, so its output goes where its caller
### sends it, into the caller's log when there is one (_MIG_RUNLOG, exported,
### reads "none" when the caller keeps no log); the caller's terminal is
### handed down in _MIG_RUNLOG_TTY for the notices that go straight to it. No
### log is kept, silently, for a user other than root or a tool whose own path
### cannot be read; nor, with one line saying so, with under 1 GiB free or free
### space that cannot be read, in a folder that cannot be written, with a tail
### lacking --pid or when the placeholder for the console cannot be opened.
### _MIG_RUNLOG_DIR and _MIG_RUNLOG_MIN_KB are for tests.
_mig_runlog_start() {
  local _tool="${1}" _a _verb _now _dir _file _base _free _self _term="" _lead=NO _hw="" _h _t _c _rc _tp _td=" " _s
  shift
  if [ -n "${_MIG_RUNLOG:-}" ]; then
    if [ "${_MIG_RUNLOG_WRAPPER:-}" = "${PPID}" ]; then
      echo "== run pid $$"
      unset _MIG_RUNLOG_WRAPPER
    fi
    return 0
  fi
  export _MIG_RUNLOG=none
  unset _MIG_RUNLOG_TTY _MIG_RUNLOG_WRAPPER
  _verb=""
  for _a in "$@"; do
    case "${_a}" in
      -*|*=*) continue ;;
    esac
    _verb="${_a}"
    break
  done
  [ -n "${_verb}" ] || return 0
  case "${_tool}:${_verb}" in
    xmass:status) return 0 ;;
    xmass:autosync)
      case " $* " in
        *" --run "*|*" --status "*) return 0 ;;
      esac
      ;;
  esac
  [ -n "${_MIG_RUNLOG_DIR:-}" ] || [ "$(id -u)" = "0" ] || return 0
  _self="$(readlink -f -- "$0" 2> /dev/null)"
  [ -n "${_self}" ] && [ -f "${_self}" ] || return 0
  _verb="$(printf '%s' "${_verb}" | tr -cd 'a-z0-9-' | cut -c1-32)"
  _now="$(date +%y%m%d-%H%M%S)"
  _base="${_MIG_RUNLOG_DIR:-/var/backups/reports/${_tool}}"
  _dir="${_base}/${_now%%-*}"
  _file="${_dir}/${_tool}-${_verb:-none}-${_now}-$$.log"
  if ! tail --pid=1 -n 0 /dev/null > /dev/null 2>&1; then
    echo "ALRT: ${_tool}: no run log kept, this tail has no --pid" >&2
    return 0
  fi
  while [ ! -d "${_base}" ]; do
    case "${_base}" in
      */*) _base="${_base%/*}" ;;
      *) _base=. ;;
    esac
    [ -n "${_base}" ] || _base=/
  done
  _free="$(df -Pk "${_base}" 2> /dev/null | awk 'NR == 2 { print $4 }')"
  case "${_free}" in
    ''|*[!0-9]*)
      echo "ALRT: ${_tool}: no run log kept, the free space for ${_file} cannot be read" >&2
      return 0
      ;;
  esac
  if [ "${_free}" -lt "${_MIG_RUNLOG_MIN_KB:-1048576}" ]; then
    echo "ALRT: ${_tool}: no run log kept, ${_free} KiB free for ${_file}" >&2
    return 0
  fi
  if ! ( umask 077; mkdir -p "${_dir}" && : >> "${_file}" ) 2> /dev/null \
    || [ -L "${_file}" ] || [ ! -f "${_file}" ]; then
    echo "ALRT: ${_tool}: no run log kept, ${_file} cannot be written" >&2
    return 0
  fi
  {
    echo "== ${_tool} $* | $(date '+%F %T %Z') | $(hostname -f 2> /dev/null) | wrapper pid $$"
    echo "== run log: ${_file}"
  } >> "${_file}"
  [ -t 2 ] && _term="$(tty <&2 2> /dev/null)"
  export _MIG_RUNLOG="${_file}"
  export _MIG_RUNLOG_WRAPPER="$$"
  case "${_term}" in
    /dev/*) export _MIG_RUNLOG_TTY="${_term}" ;;
  esac
  ### The dispositions found on entry: _tp sets back those trapped or ignored,
  ### _td names the signals at their default.
  _tp="$(trap -p HUP INT QUIT TERM)"
  for _s in HUP INT QUIT TERM; do
    [ -n "$(trap -p "${_s}")" ] || _td="${_td}${_s} "
  done
  ### A wrapper that leads its session on a terminal (session id its own pid,
  ### a terminal number set) is read before anything is started.
  case "$(awk '{ sub(/.*\) /, ""); print $4 " " $5 }' "/proc/$$/stat" 2> /dev/null)" in
    "$$ 0"|"") : ;;
    "$$ "*) _lead=YES ;;
  esac
  ### The placeholder reads a pipe only the wrapper writes to: it ends when the
  ### wrapper closes it, or when the wrapper is gone, even as a zombie its
  ### caller has not reaped yet. It takes its ignores from the wrapper, as a
  ### process substitution may not keep its own for INT and QUIT. The tail
  ### follows the placeholder, and both ignore every signal the run may get.
  ### Until the run is forked, a signal then only runs a no-op, so the wrapper
  ### is not lost in that moment, and the run gets the dispositions the wrapper
  ### was started with.
  trap '' HUP INT QUIT TERM
  exec {_hw}> >(exec cat > /dev/null)
  _h=$!
  trap : HUP INT QUIT TERM
  if [ -z "${_hw}" ] || [ -z "${_h}" ] || ! kill -0 "${_h}" 2> /dev/null; then
    [ -z "${_hw}" ] || exec {_hw}>&-
    ### Back to the dispositions found on entry. Only a signal then at its
    ### default is reset: a reset makes an INT ignored when bash started (a
    ### job started with &) fatal again, and no trap ignores it after that.
    for _s in HUP INT QUIT TERM; do
      case "${_td}" in *" ${_s} "*) trap - "${_s}" ;; esac
    done
    eval "${_tp}"
    echo "ALRT: ${_tool}: no run log kept, the placeholder for the console could not be opened" >&2
    ### The day folder stays: another run may be making its file there.
    rm -f "${_file}"
    export _MIG_RUNLOG=none
    unset _MIG_RUNLOG_WRAPPER _MIG_RUNLOG_TTY
    return 0
  fi
  ( trap '' HUP INT QUIT TERM PIPE
    exec tail -n +1 -s 0.2 --pid="${_h}" -f - ) {_hw}>&- 2> /dev/null < "${_file}" &
  _t=$!
  ### The run keeps the wrapper's input: 0<&0 counts as its own input, which a
  ### job started with & would otherwise lose to /dev/null. INT and QUIT, which
  ### bash ignores in a job started with &, are put back.
  if { true <&0; } 2> /dev/null; then
    ( trap - INT QUIT
      exec "${BASH:-/bin/bash}" "${_self}" "$@" ) {_hw}>&- 0<&0 >> "${_file}" 2>&1 &
  else
    ( trap - INT QUIT
      exec "${BASH:-/bin/bash}" "${_self}" "$@" ) {_hw}>&- < /dev/null >> "${_file}" 2>&1 &
  fi
  _c=$!
  ### A signal for the run reaches it in its group (Ctrl-C, timeout, a closed
  ### session) or at its own pid, the third header line, and the wrapper
  ### ignores it, so one wait gives the run's exact status. A wrapper that leads
  ### its session (a remote terminal or a screen window with the tool as its
  ### whole command) keeps HUP: the hangup the terminal sends it alone ends it,
  ### and the terminal then hangs up the run's group, as it did the bare tool.
  trap '' INT QUIT TERM
  if [ "${_lead}" = YES ]; then
    trap - HUP
  else
    trap '' HUP
  fi
  wait "${_c}"
  _rc=$?
  exec {_hw}>&-
  wait "${_t}" 2> /dev/null
  ### A run that ended with 129, 130 or 143, the status of a run ended by HUP,
  ### INT or TERM (the tools' own traps exit 130 on all three), ends the wrapper
  ### on that signal, so a calling script stops at Ctrl-C (lock.inc re-raises
  ### its signal for the same reason).
  case "${_rc}" in
    129|130|143)
      trap - HUP INT TERM
      kill -s "$(kill -l "${_rc}")" "$$"
      ;;
  esac
  exit "${_rc}"
}
_mig_runlog_start xtrim "$@"

_XTRIM_MODE=DRY
_XTRIM_DROP_DATADIR=NO
_margs=()
for _a in "$@"; do
  case "${_a}" in
    --live)         _XTRIM_MODE=LIVE ;;
    --dry|--test)   _XTRIM_MODE=DRY ;;
    --drop-datadir) _XTRIM_DROP_DATADIR=YES ;;
    --*)
      echo "ERROR: unknown option '${_a}'"
      exit 1
      ;;
    *) _margs+=("${_a}") ;;
  esac
done
set -- "${_margs[@]}"

case "$1" in
  status)
    _manage_single_lock
    _cmd_status
  ;;
  names)
    ### Read-only, and no lock: it must run beside a long shrink too.
    _cmd_names "$2"
  ;;
  space)
    _cmd_space
  ;;
  plan|quiesce|shrink)
    _verb="$1"
    _acct="$2"
    [ -z "${_acct}" ] && _die "Usage: xtrim ${_verb} <oN|all> [--live]"
    _manage_single_lock
    _take_sqlclean_lock
    _mig_adopt_once
    ### 'all' means all PROXIED accounts: a box mid-drain legitimately
    ### holds unproxied ones, and _die-ing on the first would make the
    ### fan-out unusable. The single-account form still refuses loudly.
    ### Per-verb token: quiesce arms only quiesce, shrink only shrink.
    if { [ "${_verb}" = "shrink" ] || [ "${_verb}" = "quiesce" ]; } \
      && [ "${_XTRIM_MODE}" = "LIVE" ]; then
      if [ "${_acct}" = "all" ]; then
        for _n in $(_list_accounts); do
          _mig_is_proxied "${_n}" || continue
          ### Accounts the fan-out will skip have no token and need none;
          ### demanding one made 'all --live' permanently unusable as soon
          ### as a single account moved past the verb.
          ### A panel-only account has no DRY token: its preflight skips it
          ### (see _preflight) and _finalize already exempts it.
          _panel_only "${_n}" && continue
          case "$(_phase_get "${_n}")" in
            stage-b|stage-b-started) continue ;;
            stage-a) [ "${_verb}" = "quiesce" ] && continue ;;
          esac
          _require_clean_dry "${_verb}" "${_n}"
        done
      else
        _require_clean_dry "${_verb}" "${_acct}"
      fi
    fi
    if [ "${_acct}" = "all" ]; then
      for _n in $(_list_accounts); do
        if ! _mig_is_proxied "${_n}"; then
          _info "${_n}: not proxied -- skipped by 'all' (name it explicitly to see the refusal)"
          continue
        fi
        ### A fan-out must not abort the whole sweep because ONE account is
        ### already past this verb; name it and move on. The single-account
        ### form still refuses loudly.
        case "$(_phase_get "${_n}")" in
          stage-b|stage-b-started)
            [ "${_verb}" = "shrink" ] || [ "${_verb}" = "quiesce" ] \
              && { _info "${_n}: past ${_verb} (phase $(_phase_get "${_n}")) -- skipped by 'all'"; continue; }
          ;;
          stage-a)
            [ "${_verb}" = "quiesce" ] \
              && { _info "${_n}: already quiesced -- skipped by 'all'"; continue; }
          ;;
        esac
        _run_one "${_verb}" "${_n}" "${_XTRIM_MODE}"
      done
    else
      _run_one "${_verb}" "${_acct}" "${_XTRIM_MODE}"
    fi
  ;;
  finalize)
    _manage_single_lock
    _take_sqlclean_lock
    _load_cnf_defaults
    if [ "${_XTRIM_MODE}" = "LIVE" ]; then
      ### The datadir drop is part of WHAT was planned, so it belongs in the
      ### token key: a DRY that planned "datadir kept" must never arm a LIVE
      ### run that destroys it.
      _require_clean_dry "finalize-dd${_XTRIM_DROP_DATADIR}" box
      _finalize LIVE "${_XTRIM_DROP_DATADIR}"
      _state_write "finalize-dd${_XTRIM_DROP_DATADIR}" box LIVE DONE
    else
      _finalize DRY "${_XTRIM_DROP_DATADIR}"
      _state_write "finalize-dd${_XTRIM_DROP_DATADIR}" box DRY CLEAN
      _info "finalize DRY CLEAN -- next: xtrim finalize --live${_XTRIM_DROP_DATADIR:+ }$([ "${_XTRIM_DROP_DATADIR}" = "YES" ] && echo '--drop-datadir')"
    fi
  ;;
  restore)
    _acct="$2"
    [ -z "${_acct}" ] && _die "Usage: xtrim restore <oN>"
    _manage_single_lock
    _take_sqlclean_lock
    _mig_adopt_once
    _load_cnf_defaults
    _map_account "${_acct}"
    _rrc=0
    _restore_stage_a "${_acct}" || _rrc=1
    ### The probes reach the target as root: only one the root policy record
    ### names (see _map_account).
    if [ -n "${_MAP_TGT}" ]; then
      _probe_all_doms "${_acct}" || _alrt "${_acct}: post-restore probes not clean -- check manually"
    else
      _alrt "${_acct}: no target named by a root policy record -- post-restore probes skipped; check manually"
    fi
    [ "${_rrc}" = "0" ] || _die "${_acct}: restore incomplete (see ALRT above)"
  ;;
  *)
    echo "Usage: xtrim status"
    echo "       xtrim plan     <oN|all>            preflight + itemised plan; writes a manifest"
    echo "       xtrim quiesce  <oN|all> [--live]   stage A only -- REVERSIBLE, deletes nothing"
    echo "       xtrim restore  <oN>                undo a quiesce from quarantine"
    echo "       xtrim shrink   <oN|all> [--live]   stage A (if needed) + stage B -- ONE-WAY"
    echo "       xtrim finalize [--live] [--drop-datadir]   box-wide, all accounts shrunk"
    echo "       xtrim names    [<oN>|all]          where DNS points each relayed name -- read-only"
    echo "       xtrim space                        what the root filesystem holds -- read-only"
    exit 1
  ;;
esac
exit 0
