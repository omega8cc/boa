#!/bin/bash
#
# stackbuild - package the heavy stack components a real "barracuda up-<tree>"
# run just built on THIS builder mirror VM, and publish them as prebuilt .deb
# packages to the mirror tree the fleet fetches from (_USE_PREBUILT_PKGS).
#
# The builder NEVER re-implements build logic: run the real barracuda upgrade
# first (the _*_VRN pins in BARRACUDA.sh.txt stay the single source of truth,
# and the mirror src tarballs it fetches are the canonical sources, BOA-patched
# or not - by construction); stackbuild only snapshots the installed trees,
# assembles per-release .debs, and publishes them with sha256 sidecars. A
# package can only exist if the real upgrade succeeded on a real box of this
# release, so the builder doubles as a standing upgrade canary. Run daily from
# cron right after "barracuda up-<tree>" (both are cheap no-ops when nothing
# changed).
#
# A published package can go stale without its own version changing: an
# OpenSSL pin bump makes the real barracuda run rebuild PHP and Nginx (their
# own probes force it), yet their versions - and so the published filenames -
# stay the same, leaving the mirror serving payloads built against the
# previous OpenSSL. The same trust-the-installer doctrine applies here: a
# package is stale exactly when the installed tree was rebuilt after the
# package was published (mtime of the component's probe binary vs the
# published .gz), and 'package'/'all' rebuild it like a missing one. No
# dependency map is re-implemented in this tool - components the real
# upgrade does NOT rebuild on such a bump (the dynamically linked unbound
# and curl follow the in-place lib) correctly stay untouched.
#
# Components (phase 1): ssl3 ssl-legacy icu curl php56..php85 (whatever
# /opt/php*/bin/php exists). Phase 2 adds valkey (major 9 only -- the
# builder always runs the forced-default Valkey 9, and majors 7/8 plus
# Redis stay source-only by never being published) and nginx (default
# build shape only -- custom-shape boxes are refused the deb installer-
# side; the payload is the bare binary, overlaying the file the distro
# nginx package owns on fresh boxes via Replaces:, while that package
# stays installed, pinned and held as the structure provider). Unbound
# follows the nginx overlay pattern (binaries only, Replaces: against the
# distro unbound/unbound-anchor packages, which stay installed as the
# structure providers). Pure-ftpd follows the valkey shape (plain
# /usr/local binaries, no distro overlay): the ten bin/sbin tools,
# explicitly listed; config, PAM, TLS cert and DH params stay
# installer-managed and are never packaged. Versions are NOT hardcoded -
# each is detected
# from the installed tree, so a pin bump is packaged on the next run.
# Inter-boa companion ordering is enforced by the INSTALLER, not by control
# file Depends (a box whose companion fell back to source has the correct
# tree but no dpkg record); Depends carries distro libs only, resolved on
# this box via dpkg-shlibdeps --ignore-missing-info.
#
# Usage:
#   stackbuild check                report installed versions vs published packages
#   stackbuild package [name ...]   build the missing/stale (or named) packages
#   stackbuild publish              gzip + sha256 sidecar into the mirror tree
#   stackbuild sync                 rsync fresh packages to the peer active mirror
#   stackbuild all                  package missing + stale + publish + sync
#   stackbuild force [name ...]     rebuild named (all installed if none given)
#                                   regardless of state + publish + sync
# Component names: ssl3 ssl-legacy icu curl valkey nginx unbound pure-ftpd php56 php70 .. php85
#
# The builder box MUST keep _USE_PREBUILT_PKGS=NO in /root/.barracuda.cnf
# (it must always compile from source, or it would install its own packages
# and repackage them in a circle) - stackbuild refuses to run otherwise.
# It must also carry FTP in _XTRAS_LIST: pure-ftpd is the only xtra-gated
# component, and a builder without it silently never publishes the package.

# ---------------------------------------------------------------------------
# Configuration.
# ---------------------------------------------------------------------------

# Where the mirror serves https://<mirror>/dev/ from. Empty = auto-detect from
# the existing prebuilt packages (mydumper precedent) under /var/www.
_PUB_DIR=""

# Peer ACTIVE builder mirror to cross-sync fresh packages to (rsync-over-ssh
# target, e.g. "root@excalibur-mirror:/var/www/...dev/"). Set it in
# /root/.stackbuild.cnf (sourced below), never by editing this copy. Empty =
# skip sync with a WARNING. Passive mirrors keep syncing from the
# authoritative mirror exactly as they do today - that is not stackbuild's job.
_PEER_MIRROR=""

# Codenames packages are built for (D-2026-07-14: daedalus + excalibur only;
# beowulf/chimaera age out on the source path).
_BUILD_CODENAMES="daedalus excalibur"

_WORK_DIR="/var/opt/stackbuild"
_LOCK="/run/stackbuild.lock"
_MAINTAINER="BOA Dev Team <boa@omega8.cc>"
_ARCH="amd64"

# Box-local builder configuration. This script is redeployed from the boa
# tree on every barracuda run, which resets the defaults above -- values that
# must survive updates (notably _PEER_MIRROR) belong in the control file,
# never in edits to a deployed copy.
if [[ -r "/root/.stackbuild.cnf" ]]; then
  source "/root/.stackbuild.cnf"
fi

# Runtime state.
_OS_CODE=""
_LOCK_HELD=0
_RESULTS=()

# ---------------------------------------------------------------------------
# Output helpers.
# ---------------------------------------------------------------------------

_msg()  { printf '%s\n' "$*"; }
_info() { printf '\033[0;32m%s\033[0m\n' "$*"; }
_alrt() { printf '\033[0;33m%s\033[0m\n' "$*" >&2; }
_die()  { printf '\033[0;31mFATAL ERROR: %s\033[0m\n' "$*" >&2; _cleanup; exit 1; }

_cleanup() {
  if [[ "${_LOCK_HELD}" == "1" ]]; then
    rmdir "${_LOCK}" 2>/dev/null
    _LOCK_HELD=0
  fi
}

_acquire_lock() {
  if ! mkdir "${_LOCK}" 2>/dev/null; then
    _die "another stackbuild run holds ${_LOCK} (remove it if stale)"
  fi
  _LOCK_HELD=1
}

# ---------------------------------------------------------------------------
# Environment checks.
# ---------------------------------------------------------------------------

_require_root() {
  [[ "$(id -u)" == "0" ]] || _die "must run as root (dpkg-deb staging + mirror writes)"
}

_require_builder() {
  # The whole design collapses if the builder installs its own packages.
  if grep -q "^_USE_PREBUILT_PKGS=YES" /root/.barracuda.cnf 2>/dev/null; then
    _die "_USE_PREBUILT_PKGS=YES in /root/.barracuda.cnf - a builder box must compile from source"
  fi
  _OS_CODE="$(lsb_release -ar 2>/dev/null | grep -i codename | cut -s -f2)"
  [[ -n "${_OS_CODE}" ]] || _die "cannot detect the OS codename (lsb_release)"
  case " ${_BUILD_CODENAMES} " in
    *" ${_OS_CODE} "*) ;;
    *) _die "codename '${_OS_CODE}' is not a build target (${_BUILD_CODENAMES}); edit _BUILD_CODENAMES if the matrix grew" ;;
  esac
}

_require_tools() {
  command -v dpkg-deb >/dev/null 2>&1 || _die "dpkg-deb not found"
  command -v file >/dev/null 2>&1 || _die "file not found"
  command -v sha256sum >/dev/null 2>&1 || _die "sha256sum not found"
  if ! command -v dpkg-shlibdeps >/dev/null 2>&1; then
    _alrt "dpkg-shlibdeps missing; installing dpkg-dev"
    apt-get install -y dpkg-dev -qq >/dev/null 2>&1
    command -v dpkg-shlibdeps >/dev/null 2>&1 || _die "dpkg-shlibdeps still missing (dpkg-dev)"
  fi
}

_detect_pub_dir() {
  if [[ -z "${_PUB_DIR}" ]]; then
    # Evidence-driven: the dir serving the existing prebuilt .deb.gz packages
    # (mydumper precedent) IS the https://<mirror>/dev/ docroot.
    _PUB_DIR="$(find /var/www -maxdepth 6 -name 'mydumper_*_amd64.deb.gz' 2>/dev/null \
      | head -n 1 | xargs -r dirname)"
  fi
  [[ -n "${_PUB_DIR}" && -d "${_PUB_DIR}" ]] \
    || _die "cannot resolve the /dev/ publish dir; set _PUB_DIR in the configuration block"
}

# ---------------------------------------------------------------------------
# Component registry - everything below is data-driven from these four maps.
# _comp_version  : installed version on this box, empty = not installed here
# _comp_paths    : absolute paths to snapshot (whitespace-separated, may glob)
# _comp_excludes : tar --exclude patterns relative to / (may be empty)
# _comp_desc     : one-line package description
# ---------------------------------------------------------------------------

_all_components() {
  local _c _n
  _c="ssl3 ssl-legacy icu curl valkey nginx unbound pure-ftpd"
  for _n in 56 70 71 72 73 74 80 81 82 83 84 85; do
    [[ -x "/opt/php${_n}/bin/php" ]] && _c="${_c} php${_n}"
  done
  printf '%s\n' "${_c}"
}

_comp_version() {
  local _comp="$1" _v=""
  case "${_comp}" in
    ssl3)
      [[ -x /usr/local/ssl3/bin/openssl ]] \
        && _v="$(/usr/local/ssl3/bin/openssl version 2>/dev/null | awk '{print $2}')" ;;
    ssl-legacy)
      [[ -x /usr/local/ssl/bin/openssl ]] \
        && _v="$(/usr/local/ssl/bin/openssl version 2>/dev/null | awk '{print $2}')" ;;
    icu)
      # /usr/local/lib/icu/current -> .../76.1; the package version keeps the
      # icu-release tarball form (76-1), which is what the installer's
      # _ICU_TARGET_VRN carries in the fetch filename.
      if [[ -e /usr/local/lib/icu/current ]]; then
        _v="$(basename "$(readlink -f /usr/local/lib/icu/current 2>/dev/null)" 2>/dev/null)"
        _v="${_v/./-}"
      fi ;;
    curl)
      [[ -x /usr/local/bin/curl ]] \
        && _v="$(/usr/local/bin/curl --version 2>/dev/null | head -n 1 | awk '{print $2}')" ;;
    valkey)
      # Mirror the installer's quirk-aware parse (valkey.sh.inc) so the
      # filename version equals the _VALKEY_NINE_VRN pin character-for-
      # character; tr -d strips the v/= characters, and when the banner's
      # leading words collapse to 'serer' the version sits in field 3.
      if [[ -x /usr/bin/valkey-server ]]; then
        _v="$(/usr/bin/valkey-server -v 2>/dev/null | tr -d '\n' | tr -d 'v=' \
          | cut -d' ' -f2 | awk '{print $1}')"
        [[ "${_v}" == "serer" ]] \
          && _v="$(/usr/bin/valkey-server -v 2>/dev/null | tr -d '\n' | tr -d 'v=' \
            | cut -d' ' -f3 | awk '{print $1}')"
      fi ;;
    nginx)
      # Mirror the installer's parse (nginx.sh.inc) so the filename version
      # equals the _NGINX_VRN pin character-for-character.
      [[ -x /usr/sbin/nginx ]] \
        && _v="$(/usr/sbin/nginx -v 2>&1 | tr -d '\n' | cut -d'/' -f2 | awk '{print $1}')" ;;
    unbound)
      # Mirror the installer's parse (dns.sh.inc) so the filename version
      # equals the _UNBOUND_VRN pin character-for-character; the newline
      # strip glues 'Configure' onto the 'Version N.N.N' banner field,
      # which the sed removes.
      [[ -x /usr/sbin/unbound ]] \
        && _v="$(/usr/sbin/unbound -V 2>/dev/null | tr -d '\n' | cut -d' ' -f2 \
          | awk '{print $1}' | sed 's/Configure//gi')" ;;
    pure-ftpd)
      # Mirror the installer's parse (_install_ftpd_deb, system.sh.inc) so
      # the filename version equals the _PURE_FTPD_VRN pin character-for-
      # character. The 'pure-ftpd vN.N.NN [privsep]' banner prints only for
      # root, which _require_root guarantees; a broken binary yields an
      # empty version -> SKIP, never a garbage-version filename.
      [[ -x /usr/local/sbin/pure-ftpd ]] \
        && _v="$(/usr/local/sbin/pure-ftpd --help 2>/dev/null | head -n 1 \
          | cut -d' ' -f2 | tr -d 'v' | awk '{print $1}')" ;;
    php*)
      local _n="${_comp#php}"
      [[ -x "/opt/php${_n}/bin/php" ]] \
        && _v="$("/opt/php${_n}/bin/php" -v 2>/dev/null | grep '^PHP' | head -n 1 | awk '{print $2}')" ;;
  esac
  printf '%s\n' "${_v}"
}

_comp_mtime_ref() {
  # The staleness witness: one payload file per component that every real
  # rebuild reinstalls with a fresh mtime - the same binary _comp_version
  # probes. Newer than the published .gz means the canonical barracuda run
  # rebuilt this tree since it was last packaged (an OpenSSL bump forcing
  # PHP/Nginx rebuilds is the motivating case), so the package must be
  # rebuilt even though its own version - and filename - did not change.
  local _comp="$1"
  case "${_comp}" in
    ssl3)       printf '%s\n' "/usr/local/ssl3/bin/openssl" ;;
    ssl-legacy) printf '%s\n' "/usr/local/ssl/bin/openssl" ;;
    icu)        printf '%s\n' "/usr/local/bin/icuinfo" ;;
    curl)       printf '%s\n' "/usr/local/bin/curl" ;;
    valkey)     printf '%s\n' "/usr/bin/valkey-server" ;;
    nginx)      printf '%s\n' "/usr/sbin/nginx" ;;
    unbound)    printf '%s\n' "/usr/sbin/unbound" ;;
    pure-ftpd)  printf '%s\n' "/usr/local/sbin/pure-ftpd" ;;
    php*)       printf '%s\n' "/opt/php${_comp#php}/bin/php" ;;
  esac
}

_comp_paths() {
  local _comp="$1" _dot
  case "${_comp}" in
    ssl3)       printf '%s\n' "/usr/local/ssl3" ;;
    ssl-legacy) printf '%s\n' "/usr/local/ssl" ;;
    icu)
      _dot="$(basename "$(readlink -f /usr/local/lib/icu/current 2>/dev/null)" 2>/dev/null)"
      # The versioned tree + the libs/headers/tools an ICU consumer (PHP build
      # or runtime link) needs. 'current' itself stays installer-managed.
      printf '%s\n' "/usr/local/lib/icu/${_dot} /usr/local/lib/libicu* /usr/local/include/unicode /usr/local/lib/pkgconfig/icu-*.pc /usr/local/share/icu/${_dot} /usr/local/bin/icu-config /usr/local/bin/icuinfo /usr/local/bin/icuexportdata /usr/local/bin/uconv /usr/local/bin/derb /usr/local/bin/genbrk /usr/local/bin/gencfu /usr/local/bin/gencnval /usr/local/bin/gendict /usr/local/bin/genrb /usr/local/bin/makeconv /usr/local/bin/pkgdata /usr/local/sbin/genccode /usr/local/sbin/gencmn /usr/local/sbin/gensprep /usr/local/sbin/icupkg /usr/local/sbin/escapesrc" ;;
    curl)
      printf '%s\n' "/usr/local/bin/curl /usr/local/bin/curl-config /usr/local/lib/libcurl.so* /usr/local/lib/libcurl.a /usr/local/lib/libcurl.la /usr/local/lib/pkgconfig/libcurl.pc /usr/local/include/curl" ;;
    valkey)
      # The valkey-* binaries plus the redis-* compat symlinks valkey's
      # 'make PREFIX=/usr install' creates; the builder is a Valkey-9 box
      # by construction (the installer forces major 9), so no real Redis
      # build can be swept up. /etc/valkey and the runtime dirs stay
      # installer-managed and are never packaged.
      printf '%s\n' "/usr/bin/valkey* /usr/bin/redis*" ;;
    nginx)
      # The bare binary only: BOA owns /etc/nginx, the init script and
      # mime.types on every box, and the smaller the payload the smaller
      # the Replaces: surface against the distro nginx package.
      printf '%s\n' "/usr/sbin/nginx" ;;
    unbound)
      # The six sbin binaries only, listed explicitly (no glob) so the
      # payload is deterministic - a tool upstream adds on a pin bump is
      # reviewed in, never swept in. The make-install /usr/lib/libunbound.*
      # residue is never packaged: the libunbound.so.8 the anchor and host
      # tools resolve at runtime is the distro multiarch lib (ld.so.cache
      # order), which the computed Depends carries. /etc/unbound,
      # /usr/etc/unbound, keys and the init script stay installer-managed.
      printf '%s\n' "/usr/sbin/unbound /usr/sbin/unbound-anchor /usr/sbin/unbound-checkconf /usr/sbin/unbound-control /usr/sbin/unbound-control-setup /usr/sbin/unbound-host" ;;
    pure-ftpd)
      # The ten bin/sbin tools, listed explicitly (no glob, unbound
      # precedent); man pages deliberately not packaged. pure-config.pl,
      # pure-ftpd.conf and the PAM file stay installer-managed, and the
      # TLS cert/DH params are box-generated private material that must
      # never ride a fleet-wide package.
      printf '%s\n' "/usr/local/sbin/pure-ftpd /usr/local/sbin/pure-ftpwho /usr/local/sbin/pure-mrtginfo /usr/local/sbin/pure-quotacheck /usr/local/sbin/pure-uploadscript /usr/local/sbin/pure-authd /usr/local/sbin/pure-certd /usr/local/bin/pure-pw /usr/local/bin/pure-pwconvert /usr/local/bin/pure-statsdecode" ;;
    php*)
      printf '%s\n' "/opt/php${_comp#php}" ;;
  esac
}

_comp_excludes() {
  local _comp="$1"
  case "${_comp}" in
    php*)
      # Runtime config is host-tuned and regenerated on every target from the
      # repo templates - never baked into the package.
      printf '%s\n' "opt/php${_comp#php}/etc opt/php${_comp#php}/lib/php.ini" ;;
    *) printf '%s\n' "" ;;
  esac
}

_comp_replaces() {
  # Extra control-file fields per component (beyond the computed Depends).
  # nginx: on fresh boxes /usr/sbin/nginx is dpkg-OWNED by the distro nginx
  # package (naming varies by release), so without Replaces: dpkg refuses
  # the overwrite and every fresh box silently source-builds. Replaces:
  # against a package that is not installed is inert, so the full alias
  # list is safe on every codename. Deliberately NO Conflicts: - the
  # distro package stays installed (pinned and held) as the structure
  # provider, and it must never be dragged out by our package.
  local _comp="$1"
  case "${_comp}" in
    nginx)   printf '%s\n' "nginx, nginx-core, nginx-full, nginx-light, nginx-extras" ;;
    unbound)
      # The distro unbound package owns four of the six payload paths and
      # unbound-anchor owns the fifth; unbound-host is not listed because
      # its distro binary lives in /usr/bin, outside the payload. Same
      # deliberate no-Conflicts shape as nginx: both distro packages stay
      # installed as the structure providers (unbound user, init
      # integration, dns-root-data pull-in). Unlike nginx they are NOT
      # pinned/held, because the DNS repair branch in
      # _dns_unbound_install_upgrade must stay able to purge and
      # reinstall them; dpkg never hands Replaces:-owned paths back, so
      # that branch drops the boa-unbound record first (installer-side
      # counterpart in dns.sh.inc).
      printf '%s\n' "unbound, unbound-anchor" ;;
    *)       printf '%s\n' "" ;;
  esac
}

_comp_desc() {
  local _comp="$1"
  case "${_comp}" in
    ssl3)       printf '%s\n' "BOA Modern OpenSSL tree (/usr/local/ssl3), built by barracuda on ${_OS_CODE}" ;;
    ssl-legacy) printf '%s\n' "BOA Legacy OpenSSL tree (/usr/local/ssl), built by barracuda on ${_OS_CODE}" ;;
    icu)        printf '%s\n' "BOA ICU libs (/usr/local), built by barracuda on ${_OS_CODE}" ;;
    curl)       printf '%s\n' "BOA cURL (/usr/local), built by barracuda on ${_OS_CODE}" ;;
    valkey)     printf '%s\n' "BOA Valkey (/usr/bin, incl. redis-compat symlinks), built by barracuda on ${_OS_CODE}" ;;
    nginx)      printf '%s\n' "BOA Nginx binary (/usr/sbin/nginx, static OpenSSL), built by barracuda on ${_OS_CODE}" ;;
    unbound)    printf '%s\n' "BOA Unbound DNS cache binaries (/usr/sbin, BOA OpenSSL linked), built by barracuda on ${_OS_CODE}" ;;
    pure-ftpd)  printf '%s\n' "BOA Pure-FTPd binaries (/usr/local, BOA OpenSSL linked), built by barracuda on ${_OS_CODE}" ;;
    php*)       printf '%s\n' "BOA PHP ${_comp#php} prefix (/opt/${_comp}) incl. phpize/headers, built by barracuda on ${_OS_CODE}" ;;
  esac
}

_deb_name() {
  # boa-<comp>_<ver>.<codename>_amd64.deb - the exact filename grammar the
  # installer constructs from its own pins (the mydumper precedent).
  local _comp="$1" _ver="$2"
  printf '%s\n' "boa-${_comp}_${_ver}.${_OS_CODE}_${_ARCH}.deb"
}

# ---------------------------------------------------------------------------
# Packaging primitives.
# ---------------------------------------------------------------------------

_stage_tree() {
  # Snapshot the component's paths into ${_stage} preserving ownership/modes.
  # Paths may glob; excludes are tar patterns relative to /.
  local _stage="$1" _paths="$2" _excludes="$3"
  local _p _rel _tarx=()
  local _rels=()
  # ${_paths} expands globs here; an unmatched glob stays literal and is
  # reported as absent (optional members like .la files are tolerated).
  for _p in ${_paths}; do
    if [[ -e "${_p}" || -L "${_p}" ]]; then
      _rels+=("${_p#/}")
    else
      _msg "  note: ${_p} not present; skipped"
    fi
  done
  [[ "${#_rels[@]}" -gt 0 ]] || return 1
  for _rel in ${_excludes}; do
    _tarx+=("--exclude=${_rel}")
  done
  tar -C / -cf - "${_tarx[@]}" "${_rels[@]}" 2>/dev/null | tar -C "${_stage}" -xf -
}

_calc_depends() {
  # Resolve distro-lib Depends for every ELF object in the staged tree via
  # dpkg-shlibdeps on THIS box (per-release sonames come out right by
  # construction). --ignore-missing-info skips the unpackaged /usr/local
  # trees, which is exactly the inter-boa ordering the installer owns.
  # Echoes the Depends value (may be empty); never fails the build.
  local _stage="$1" _work="$2"
  local _elves=() _f _out
  while IFS= read -r -d '' _f; do
    if file -b "${_f}" 2>/dev/null | grep -q '^ELF'; then
      _elves+=("${_f}")
    fi
  done < <(find "${_stage}" -type f \( -perm -u+x -o -name '*.so*' \) -print0 2>/dev/null)
  [[ "${#_elves[@]}" -gt 0 ]] || { printf '\n'; return 0; }
  mkdir -p "${_work}/debian"
  cat > "${_work}/debian/control" <<EOF
Source: stackbuild-stub
Section: misc
Priority: optional
Maintainer: ${_MAINTAINER}

Package: stackbuild-stub
Architecture: ${_ARCH}
Description: shlibdeps stub
EOF
  _out="$(cd "${_work}" \
    && dpkg-shlibdeps -O --ignore-missing-info "${_elves[@]}" 2>/dev/null \
    | grep '^shlibs:Depends=' | sed 's/^shlibs:Depends=//')"
  rm -rf "${_work}/debian"
  printf '%s\n' "${_out}"
}

_package_one() {
  local _comp="$1"
  local _ver _deb _paths _excludes _stage _work _deps _replaces _ref
  _ver="$(_comp_version "${_comp}")"
  if [[ -z "${_ver}" ]]; then
    _RESULTS+=("SKIP  ${_comp} (not installed on this box)")
    return 0
  fi
  _deb="$(_deb_name "${_comp}" "${_ver}")"
  if [[ -e "${_WORK_DIR}/${_deb}" ]]; then
    _ref="$(_comp_mtime_ref "${_comp}")"
    if [[ -n "${_ref}" && -e "${_ref}" && "${_ref}" -nt "${_WORK_DIR}/${_deb}" ]]; then
      # The pending build predates a rebuild of the installed tree (a publish
      # failed, then e.g. an OpenSSL bump rebuilt this component): publishing
      # it would freshen the .gz mtime over stale bytes and latch them, so
      # rebuild instead of skipping.
      _msg "  note: pending ${_deb} predates the installed tree; rebuilding"
      rm -f "${_WORK_DIR}/${_deb}"
    else
      _RESULTS+=("SKIP  ${_deb} (already built; publish pending)")
      return 0
    fi
  fi
  _msg "package: ${_deb}"
  _work="${_WORK_DIR}/.work.${_comp}"
  _stage="${_work}/root"
  rm -rf "${_work}"
  mkdir -p "${_stage}/DEBIAN"
  _paths="$(_comp_paths "${_comp}")"
  _excludes="$(_comp_excludes "${_comp}")"
  if ! _stage_tree "${_stage}" "${_paths}" "${_excludes}"; then
    _RESULTS+=("FAIL  ${_deb} (staging produced nothing)")
    rm -rf "${_work}"
    return 1
  fi
  _deps="$(_calc_depends "${_stage}" "${_work}")"
  _replaces="$(_comp_replaces "${_comp}")"
  {
    printf 'Package: boa-%s\n' "${_comp}"
    printf 'Version: %s\n' "${_ver}"
    printf 'Section: misc\n'
    printf 'Priority: optional\n'
    printf 'Architecture: %s\n' "${_ARCH}"
    [[ -n "${_deps}" ]] && printf 'Depends: %s\n' "${_deps}"
    [[ -n "${_replaces}" ]] && printf 'Replaces: %s\n' "${_replaces}"
    printf 'Maintainer: %s\n' "${_MAINTAINER}"
    printf 'Description: %s\n' "$(_comp_desc "${_comp}")"
  } > "${_stage}/DEBIAN/control"
  if dpkg-deb --build --root-owner-group "${_stage}" "${_WORK_DIR}/${_deb}" >/dev/null 2>&1; then
    _RESULTS+=("OK    ${_deb}")
  else
    _RESULTS+=("FAIL  ${_deb} (dpkg-deb)")
    rm -rf "${_work}"
    return 1
  fi
  rm -rf "${_work}"
}

# ---------------------------------------------------------------------------
# Verbs.
# ---------------------------------------------------------------------------

do_check() {
  local _comp _ver _deb _state _ref
  _detect_pub_dir
  _msg "codename: ${_OS_CODE}   publish dir: ${_PUB_DIR}"
  for _comp in $(_all_components); do
    _ver="$(_comp_version "${_comp}")"
    if [[ -z "${_ver}" ]]; then
      printf '  %-12s %-12s %s\n' "${_comp}" "-" "not installed on this box"
      continue
    fi
    _deb="$(_deb_name "${_comp}" "${_ver}")"
    _ref="$(_comp_mtime_ref "${_comp}")"
    if [[ -e "${_PUB_DIR}/${_deb}.gz" ]]; then
      _state="published"
      if [[ -n "${_ref}" && -e "${_ref}" && "${_ref}" -nt "${_PUB_DIR}/${_deb}.gz" ]]; then
        _state="STALE (tree rebuilt since publish)"
      fi
    elif [[ -e "${_WORK_DIR}/${_deb}" ]]; then
      _state="BUILT, publish pending"
      if [[ -n "${_ref}" && -e "${_ref}" && "${_ref}" -nt "${_WORK_DIR}/${_deb}" ]]; then
        _state="BUILT, STALE (tree rebuilt since build)"
      fi
    else
      _state="MISSING"
    fi
    printf '  %-12s %-12s %s\n' "${_comp}" "${_ver}" "${_state}"
  done
}

_missing_components() {
  local _comp _ver _deb
  for _comp in $(_all_components); do
    _ver="$(_comp_version "${_comp}")"
    [[ -n "${_ver}" ]] || continue
    _deb="$(_deb_name "${_comp}" "${_ver}")"
    [[ -e "${_PUB_DIR}/${_deb}.gz" ]] && continue
    printf '%s ' "${_comp}"
  done
}

_stale_components() {
  # Published but rebuilt on this box since (see _comp_mtime_ref). A missing
  # probe file means staleness cannot be judged - never guess, skip.
  local _comp _ver _deb _ref
  for _comp in $(_all_components); do
    _ver="$(_comp_version "${_comp}")"
    [[ -n "${_ver}" ]] || continue
    _deb="$(_deb_name "${_comp}" "${_ver}")"
    [[ -e "${_PUB_DIR}/${_deb}.gz" ]] || continue
    _ref="$(_comp_mtime_ref "${_comp}")"
    [[ -n "${_ref}" && -e "${_ref}" ]] || continue
    if [[ "${_ref}" -nt "${_PUB_DIR}/${_deb}.gz" ]]; then
      printf '%s ' "${_comp}"
    fi
  done
}

_installed_components() {
  local _comp
  for _comp in $(_all_components); do
    [[ -n "$(_comp_version "${_comp}")" ]] && printf '%s ' "${_comp}"
  done
}

do_package() {
  # $@ = component names, or empty for every missing or stale one.
  local _targets="$*" _comp
  _detect_pub_dir
  mkdir -p "${_WORK_DIR}"
  [[ -n "${_targets}" ]] || _targets="$(_missing_components)$(_stale_components)"
  if [[ -z "${_targets// /}" ]]; then
    _msg "nothing to package - all installed components are published and current"
    return 0
  fi
  for _comp in ${_targets}; do
    case "${_comp}" in
      ssl3|ssl-legacy|icu|curl|valkey|nginx|unbound|pure-ftpd|php[0-9][0-9]) _package_one "${_comp}" ;;
      *) _alrt "unknown component: ${_comp}" ;;
    esac
  done
}

do_publish() {
  # Move every built .deb into the mirror tree as .deb.gz + sha256 sidecar.
  # The sidecar hashes the COMPRESSED file (the installer verifies before
  # gunzip). Old versions are never deleted - mirrors keep them so slower
  # trees and older pins keep finding their exact filename.
  local _t _base _comp _ref _n=0
  _detect_pub_dir
  for _t in "${_WORK_DIR}"/boa-*.deb; do
    [[ -e "${_t}" ]] || continue
    _base="${_t##*/}"
    # The same staleness guard as _package_one: a pending deb that predates
    # a rebuild of its tree (a failed publish, then e.g. an OpenSSL bump)
    # must never be swept out here - the fresh .gz mtime would latch the
    # stale bytes beyond staleness detection for good. Dropped debs surface
    # as MISSING/STALE on the next package run and rebuild through the
    # guarded path. Component names carry no underscore, so the parse is
    # exact; an unknown name yields no ref and publishes as before.
    _comp="${_base#boa-}"
    _comp="${_comp%%_*}"
    _ref="$(_comp_mtime_ref "${_comp}")"
    if [[ -n "${_ref}" && -e "${_ref}" && "${_ref}" -nt "${_t}" ]]; then
      _alrt "stale pending ${_base} (tree rebuilt since build); dropped, not published"
      rm -f "${_t}"
      continue
    fi
    if ! gzip -9 -c "${_t}" > "${_PUB_DIR}/${_base}.gz.tmp"; then
      _alrt "gzip failed: ${_base}"
      rm -f "${_PUB_DIR}/${_base}.gz.tmp"
      continue
    fi
    # Checked: on a same-version republish the target already exists, and a
    # refused overwrite (immutable bit, permissions) would otherwise leave the
    # old bytes in place while the sidecar below is rebuilt from them and the
    # run still reports success - stale bytes, self-consistent, undetectable.
    if ! mv -f "${_PUB_DIR}/${_base}.gz.tmp" "${_PUB_DIR}/${_base}.gz"; then
      _alrt "publish failed (cannot replace): ${_base}.gz"
      rm -f "${_PUB_DIR}/${_base}.gz.tmp"
      continue
    fi
    # Sidecar gets the same tmp+mv treatment as the .gz: an in-place rewrite
    # would expose a new-.gz/old-sidecar window on a same-version republish,
    # tripping spurious checksum-mismatch source fallbacks fleet-wide.
    if ! (cd "${_PUB_DIR}" && sha256sum "${_base}.gz" > "${_base}.gz.sha256.tmp" \
      && mv -f "${_base}.gz.sha256.tmp" "${_base}.gz.sha256"); then
      # Fail closed: no sidecar means the installer will not use the package.
      _alrt "sha256 sidecar failed: ${_base}.gz; removing the package"
      rm -f "${_PUB_DIR}/${_base}.gz" "${_PUB_DIR}/${_base}.gz.sha256" \
        "${_PUB_DIR}/${_base}.gz.sha256.tmp"
      continue
    fi
    rm -f "${_t}"
    _msg "published: ${_base}.gz (+ sha256)"
    _n=$((_n + 1))
  done
  [[ "${_n}" -gt 0 ]] || _msg "nothing to publish (run 'package' first)"
}

do_sync() {
  # Cross-sync to the peer ACTIVE mirror so both hold the complete package
  # tree; never delete on the peer (keep-old-versions applies there too).
  _detect_pub_dir
  if [[ -z "${_PEER_MIRROR}" ]]; then
    _alrt "SKIPPED cross-sync: _PEER_MIRROR is not set, so freshly built"
    _alrt "packages exist ONLY on this mirror. On a paired builder set"
    _alrt "_PEER_MIRROR in /root/.stackbuild.cnf and re-run: stackbuild sync"
    return 0
  fi
  # --delay-updates moves every transferred file into place at the end of the
  # run, keeping the .gz/.sha256 pair window on the peer as small as possible.
  # --update is load-bearing, not tidiness: this box carries its own copies of
  # the PEER's codename files, and a same-version republish now rewrites an
  # existing filename rather than only adding new ones. Without it, a sync
  # overlapping the peer's publish window pushes our older copy of a file the
  # peer just republished, reverting it - content and mtime alike, so the
  # reverted pair looks consistent and staleness detection never fires again
  # (observed: two components published at the head of a peer's loop reverted
  # while everything published after it survived). Never move a file backwards
  # in time on the peer; a deliberate rollback goes through 'force', which
  # republishes with a current mtime.
  if rsync -a --update --delay-updates \
    --include='boa-*_amd64.deb.gz' --include='boa-*_amd64.deb.gz.sha256' \
    --exclude='*' "${_PUB_DIR}/" "${_PEER_MIRROR}/"; then
    _msg "cross-synced boa-* packages to ${_PEER_MIRROR}"
  else
    _alrt "cross-sync to ${_PEER_MIRROR} failed"
    return 1
  fi
}

print_summary() {
  [[ "${#_RESULTS[@]}" -gt 0 ]] || return 0
  _msg ""
  _info "=== stackbuild summary (${_OS_CODE}) ==="
  local _r
  for _r in "${_RESULTS[@]}"; do
    _msg "  ${_r}"
  done
}

usage() {
  awk 'NR<3{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"
}

main() {
  local _action="${1:-}"
  [[ -n "${_action}" ]] || { usage; exit 1; }
  shift || true

  case "${_action}" in
    -h|--help|help)
      usage
      exit 0
      ;;
    check)
      _require_root
      _require_builder
      do_check
      ;;
    package)
      _require_root
      _require_builder
      _require_tools
      trap '_cleanup' EXIT
      _acquire_lock
      do_package "$@"
      print_summary
      ;;
    publish)
      _require_root
      _require_builder
      trap '_cleanup' EXIT
      _acquire_lock
      do_publish
      ;;
    sync)
      _require_root
      _require_builder
      do_sync
      ;;
    all)
      _require_root
      _require_builder
      _require_tools
      trap '_cleanup' EXIT
      _acquire_lock
      do_package
      do_publish
      do_sync
      print_summary
      ;;
    force)
      # Rebuild and republish regardless of what the mirror already holds -
      # the operator hammer for when the mtime heuristic cannot be trusted
      # (a mirror tree restored from backup, clock skew, doubt).
      _require_root
      _require_builder
      _require_tools
      trap '_cleanup' EXIT
      _acquire_lock
      local _targets="$*" _fComp _fVer
      [[ -n "${_targets// /}" ]] || _targets="$(_installed_components)"
      # force distrusts mtimes entirely - drop any pending build for the
      # targets first, so the pending-deb heuristic cannot skip the rebuild.
      for _fComp in ${_targets}; do
        _fVer="$(_comp_version "${_fComp}")"
        [[ -n "${_fVer}" ]] && rm -f "${_WORK_DIR}/$(_deb_name "${_fComp}" "${_fVer}")"
      done
      do_package ${_targets}
      do_publish
      do_sync
      print_summary
      ;;
    *)
      _die "unknown action '${_action}' (try -h)"
      ;;
  esac
}

main "$@"
