#!/bin/bash

# Environment setup
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

# Function to display usage information
_usage() {
  echo "Usage: $0 restore <SERVICE> <USER> [RESTORE_TARGET] [RESTORE_PATH] [RESTORE_TIME]"
  echo
  echo "Example restore commands:"
  echo "  $0 restore aws john ~/static/restores /specific/path 1D"
  echo "  $0 restore b2 jane ~/static/restores /another/path 2W"
  echo
  echo "Supported services:"
  echo "  aws, aws_one_zone, aws_standard_ia, gcs, b2, azure, upcloud, ibm, wasabi, do_spaces, linode"
  echo
  exit 1
}

# Function to load credentials from a file
_load_credentials() {
  local _service=$1
  local _creds_path="~/static/control/remote_backups/credentials/${_service}.txt"
  _creds_path=$(eval echo "${_creds_path}")  # Expand ~ for the user
  if [ -f "${_creds_path}" ]; then
    source "${_creds_path}"
  else
    echo "Credentials file ${_creds_path} not found."
    exit 1
  fi
}

# Function to load paths and other settings from a file
_load_paths() {
  local _paths_path="~/static/control/remote_backups/config/paths.txt"
  _paths_path=$(eval echo "${_paths_path}")  # Expand ~ for the user
  if [ -f "${_paths_path}" ]; then
    source "${_paths_path}"
  else
    echo "Paths configuration file ${_paths_path} not found."
    exit 1
  fi
}

# Function to construct _BUCKET_NAME
_construct_bucket_name() {
  local _service_abbr=$1
  local _hostname=$(hostname -s)
  _BUCKET_NAME="${_hostname}-${_service_abbr}-${_USER}"
}

# Function to restore backup
_restore() {
  local _restore_target=$1
  local _restore_path=$2
  local _restore_time=$3
  local _restore_command="duplicity restore --allow-source-mismatch"

  # Ensure _RESTORE_TARGET exists
  if [ ! -d "${_restore_target}" ]; then
    echo "Creating restore target directory: ${_restore_target}"
    mkdir -p "${_restore_target}"
  fi

  if [ -n "${_restore_time}" ]; then
    _restore_command="${_restore_command} --time ${_restore_time}"
  fi

  _restore_command="${_restore_command} ${_BACKUP_TARGET}"

  if [ -n "${_restore_path}" ]; then
    _restore_command="${_restore_command} ${_restore_path}"
  fi

  _restore_command="${_restore_command} ${_restore_target}"

  eval "${_restore_command}"
}

# Function to set backup target based on service
_set_backup_target() {
  local _service=$1

  case "${_service}" in
    aws|aws_one_zone|aws_standard_ia)
      _load_credentials "${_service}"
      _construct_bucket_name "${_service}"
      local _s3_endpoint="https://s3.dualstack.${AWS_REGION}.amazonaws.com"
      local _s3_options="--s3-endpoint-url ${_s3_endpoint} --s3-region-name ${AWS_REGION}"
      if [ "${_service}" = "aws_standard_ia" ] || [ "${_service}" = "aws_one_zone" ]; then
        _s3_options="${_s3_options} --s3-use-ia"
      fi
      _BACKUP_TARGET="boto3+s3://${_BUCKET_NAME} ${_s3_options}"
      ;;
    gcs)
      _load_credentials "gcs"
      _construct_bucket_name "gcs"
      _BACKUP_TARGET="gs://${_BUCKET_NAME}"
      ;;
    b2)
      _load_credentials "b2"
      _construct_bucket_name "b2"
      _BACKUP_TARGET="b2://${B2_ACCOUNT_ID}:${B2_APPLICATION_KEY}@${_BUCKET_NAME}"
      ;;
    azure)
      _load_credentials "azure"
      _construct_bucket_name "azure"
      _BACKUP_TARGET="azure://${AZURE_STORAGE_ACCOUNT}@${_BUCKET_NAME}"
      ;;
    upcloud)
      _load_credentials "upcloud"
      _construct_bucket_name "upcloud"
      _BACKUP_TARGET="s3://${UPCLOUD_USERNAME}:${UPCLOUD_PASSWORD}@${REGION}/${_BUCKET_NAME}"
      ;;
    ibm)
      _load_credentials "ibm"
      _construct_bucket_name "ibm"
      _BACKUP_TARGET="ibmcos://${IBM_API_KEY_ID}:${IBM_SERVICE_INSTANCE_ID}@${IBM_REGION}/${_BUCKET_NAME}"
      ;;
    wasabi)
      _load_credentials "wasabi"
      _construct_bucket_name "wasabi"
      _BACKUP_TARGET="s3://${WASABI_ACCESS_KEY}:${WASABI_SECRET_KEY}@${WASABI_REGION}/${_BUCKET_NAME}"
      ;;
    do_spaces)
      _load_credentials "do_spaces"
      _construct_bucket_name "do_spaces"
      _BACKUP_TARGET="s3://${DO_SPACES_KEY}:${DO_SPACES_SECRET}@${DO_SPACES_REGION}/${_BUCKET_NAME}"
      ;;
    linode)
      _load_credentials "linode"
      _construct_bucket_name "linode"
      _BACKUP_TARGET="s3://${LINODE_ACCESS_KEY}:${LINODE_SECRET_KEY}@${LINODE_REGION}/${_BUCKET_NAME}"
      ;;
    *)
      echo "Error: Unknown service ${_service}"
      exit 1
      ;;
  esac
}

# Main script
if [ "$#" -lt 3 ]; then
  _usage
fi

_ACTION=$1
_SERVICE=$2
_USER=$3
_RESTORE_TARGET="${4:-~/static/restores}"
_RESTORE_PATH="${5:-}"
_RESTORE_TIME="${6:-}"

if [ "${_ACTION}" != "restore" ]; then
  echo "Error: Only the restore action is allowed."
  exit 1
fi

_load_paths
_set_backup_target "${_SERVICE}"

_restore "${_RESTORE_TARGET}" "${_RESTORE_PATH}" "${_RESTORE_TIME}"
