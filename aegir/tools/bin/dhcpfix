#!/bin/bash

# dhcpfix - stop the DHCP client from overwriting /etc/resolv.conf
#
# Target stack: Devuan/SysVinit + ISC dhclient. dhcpcd and NetworkManager are
# handled for completeness but are not the live case here.
#
# Safe on live boxes by design:
#   - installs a resolv.conf no-op hook (does NOT rewrite dhclient.conf)
#   - does NOT release/renew the lease and does NOT touch /etc/network/interfaces
#   - writes resolv.conf once, left mutable so BOA stays the owner
# The hook takes effect on the next natural RENEW; the file is correct immediately.

# set -euo pipefail   # safe to enable now that the awk/rewrite block is gone

# === Config ===
# Must match BOA's canonical resolv.conf. 127.0.0.1 is the local unbound.
# The public fallbacks let lookups survive unbound being down, but they also let
# queries bypass unbound (cache / RPZ / split view) when unbound is unreachable or
# times out. Reduce to 127.0.0.1-only if BOA canonicalizes to that, otherwise BOA
# may treat this file as drift and rewrite it.
_RESOLV_TARGET_CONTENT=$'nameserver 127.0.0.1\nnameserver 1.1.1.1\nnameserver 8.8.8.8\nnameserver 9.9.9.9\n'
_DEBUG_MODE="${_DEBUG_MODE:-NO}"

# === Internals ===
_DHCLIENT_HOOK="/etc/dhcp/dhclient-enter-hooks.d/nodnsupdate"
_DHCPCD_CONF="/etc/dhcpcd.conf"
_NM_CONF="/etc/NetworkManager/NetworkManager.conf"
_RESOLV="/etc/resolv.conf"

_log() {
  echo "[dhcpfix] $*"
}

_msg() {
  [ "${_DEBUG_MODE}" = "YES" ] && echo "[dhcpfix] $*"
  return 0
}

_backup_file() {
  [ -f "$1" ] && cp -a "$1" "$1.bak.$(date +%s)"
  return 0
}

_detect_client() {
  if pgrep -x dhclient        >/dev/null 2>&1; then echo "dhclient";       return; fi
  if pgrep -x dhcpcd          >/dev/null 2>&1; then echo "dhcpcd";         return; fi
  if pgrep -x NetworkManager  >/dev/null 2>&1; then echo "networkmanager"; return; fi
  echo "none"
}

_configure_dhclient() {
  # The no-op make_resolv_conf is sufficient on its own: dhclient-script sources
  # this directory AFTER defining its own make_resolv_conf, so resolv.conf is never
  # written regardless of which DNS options the lease carries. No request-line
  # surgery, no lease churn. Effective at the next RENEW.
  mkdir -p "$(dirname "${_DHCLIENT_HOOK}")"
  cat > "${_DHCLIENT_HOOK}" <<'EOF'
#!/bin/sh
# Installed by dhcpfix: prevent dhclient from overwriting /etc/resolv.conf
make_resolv_conf() { :; }
EOF
  chmod 0755 "${_DHCLIENT_HOOK}"
  _log "dhclient: installed resolv.conf no-op hook (effective next RENEW)"
}

_configure_dhcpcd() {
  [ -f "${_DHCPCD_CONF}" ] && _backup_file "${_DHCPCD_CONF}"
  touch "${_DHCPCD_CONF}"
  if ! grep -qE '^[[:space:]]*nohook[[:space:]]+resolv\.conf' "${_DHCPCD_CONF}"; then
    echo "nohook resolv.conf" >> "${_DHCPCD_CONF}"
  fi
  # No forced dhcpcd restart: avoids interrupting the lease on a live box. nohook
  # applies on the next dhcpcd reload/reboot; the file written below is already
  # correct in the meantime.
  _log "dhcpcd: ensured 'nohook resolv.conf' (full effect next dhcpcd cycle)"
}

_configure_nm() {
  if [ -f "${_NM_CONF}" ]; then
    _backup_file "${_NM_CONF}"
  else
    mkdir -p "$(dirname "${_NM_CONF}")"
    touch "${_NM_CONF}"
  fi
  if grep -q '^\[main\]' "${_NM_CONF}" 2>/dev/null; then
    awk '
      BEGIN{inmain=0}
      /^\[main\]/ {print; inmain=1; next}
      /^\[/ && $0 !~ /^\[main\]/ { if(inmain){print "dns=none"; inmain=0}; print; next}
      { if(inmain && $0 ~ /^dns=/){ next } print }
      END{ if(inmain){print "dns=none"} }
    ' "${_NM_CONF}" > "${_NM_CONF}.new" && mv -f "${_NM_CONF}.new" "${_NM_CONF}"
  else
    printf '[main]\ndns=none\n' > "${_NM_CONF}"
  fi
  # reload (not restart) picks up dns=none without bouncing the connection
  service network-manager reload 2>/dev/null || true
  _log "NetworkManager: set dns=none and reloaded"
}

_finalize_resolv() {
  # Replace whatever is there (symlink or file) with a plain, mutable file.
  if [ -L "${_RESOLV}" ] || [ -e "${_RESOLV}" ]; then
    _backup_file "${_RESOLV}"
    chattr -i "${_RESOLV}" 2>/dev/null || true
    rm -f "${_RESOLV}"
  fi
  printf '%s' "${_RESOLV_TARGET_CONTENT}" > "${_RESOLV}"
  chmod 0644 "${_RESOLV}"
  # Deliberately left mutable (no chattr +i): BOA remains the owner of this file.
  _log "wrote ${_RESOLV} (mutable; first nameserver 127.0.0.1)"
}

_main() {
  _CLIENT="$(_detect_client)"
  _log "detected dhcp client: ${_CLIENT}"
  case "${_CLIENT}" in
    dhclient)       _configure_dhclient ;;
    dhcpcd)         _configure_dhcpcd ;;
    networkmanager) _configure_nm ;;
    none)           _log "no active dhcp client; finalizing resolv.conf only" ;;
  esac
  _finalize_resolv
  _log "current: $(grep -E '^(domain|search|nameserver|options)' "${_RESOLV}" | tr '\n' ' ')"
}

_main "$@"
