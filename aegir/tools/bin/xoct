#!/bin/bash

export HOME=/root
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/local/sbin:/opt/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/libexec

### The tree used for the target-side account install (boa in-octopus) must
### match the box's installed BOA tree — a hardcoded dev sent lts-tree
### migrations through the dev-license gate, which denies non-licensed
### hostnames. Derive from the box's own self-report; fall back to the
### newest tools ctrl marker, then to the historical dev default.
_tRee=$(boa info 2>/dev/null \
  | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
  | tail -1 \
  | grep -oE '(dev|lts|pro)$')
if [ -z "${_tRee}" ]; then
  _tRee=$(ls -t /var/log/boa/*.ctrl.* 2>/dev/null \
    | head -1 \
    | grep -oE '\.(dev|lts|pro)\.' \
    | tr -d '.')
fi
[ -z "${_tRee}" ] && _tRee=dev
export _tRee
_xSrl=$(boa info 2>/dev/null \
  | grep -oE "BOA-[0-9.]+-${_tRee}-[0-9a-zA-Z]+" \
  | tail -1 \
  | awk -F- '{ print $NF }')
[ -z "${_xSrl}" ] && _xSrl="588855${_tRee}T01"
export _xSrl

_WEBG=www-data
_THIS_DB_PORT=3306
_ieni="--ignore-errors"

### Copied verbatim from the shared library: a standalone tool cannot source
### it, so the definition travels with every writer that needs it.
_acct_group() {
  # Group that owns an account's tree. Derived, never a literal: an account
  # converted to a private primary group named after itself gets that group,
  # everything else (an unconverted box, root, www-data, an adopted odd
  # group) falls back to 'users' -- so a tool landing on an unconverted or
  # half-converted box leaves it exactly as it is today. Box-wide paths
  # (/data/conf, /data/u, the shared cores) keep 'users' and never use this.
  # $1 = account name (oN, oN.ftp, oN.<sub>) or a path under /data/disk/<oN>
  # or /var/aegir (the master keeps 'users' in this phase).
  local _a="${1}" _g
  case "${_a}" in
    /var/aegir|/var/aegir/*|aegir|root|www-data) echo "users"; return 0 ;;
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    */*) echo "users"; return 0 ;;
  esac
  _a="${_a%%.*}"
  [ -n "${_a}" ] || { echo "users"; return 0; }
  _g=$(id -gn "${_a}" 2> /dev/null)
  [ "${_g}" = "${_a}" ] || _g="users"
  echo "${_g}"
}

_web_group_state() {
  # The account's own web group, wg-<account>, derived on the box and never
  # taken from argv or a cnf: the group its pools, backend user and shell
  # users share for its web paths once the account is converted to it.
  # Prints "<state> <gid> <group>", "none - -" when there is no such group
  # (the record is root's: run as another user, converted reads as held):
  #   none       no group of that name
  #   foreign    the group exists, but an identity outside the account holds
  #              it too: never joined nor written to; claim passes still leave
  #              its paths alone (taking them would cut the pools off)
  #   held       the group exists and only this account's identities hold it:
  #              claim passes leave its paths alone, new identities join it
  #   converted  and root's record names that gid: writers use the group
  #   phaseb     and the record says the identities have left www-data
  # The record is /root/.<account>.web-group.txt, "wg-<account> gid=<n>
  # phase=<A|B> ...", root's own file outside the account tree, so neither
  # the account nor a copy or restore of its tree can make or move it.
  # $1 = account name, one of its identities (oN.ftp, oN.<sub>, oN.web,
  # oN.NN.web), or a path under /data/disk/<oN>, /home/<oN>.*, the account's
  # gems or npm tree, or its store on attached storage
  # (/mnt/<m>/files/<oN>/static/files).
  local _a="${1}" _e _gid _u _r _rg="" _rgid="" _rph="" IFS=$' \t\n'
  # a path is read as written (an alias the account wrote can carry "..",
  # "." or "//"): normalised by text alone, never through a link, first
  case "${_a}" in
    */*) _a=$(realpath -m -s -- "${_a}" 2> /dev/null) || { echo "none - -"; return 0; } ;;
  esac
  case "${_a}" in
    /data/disk/*) _a="${_a#/data/disk/}"; _a="${_a%%/*}" ;;
    /home/*) _a="${_a#/home/}"; _a="${_a%%/*}" ;;
    /opt/user/gems/*|/opt/user/npm/*) _a="${_a#/opt/user/*/}"; _a="${_a%%/*}" ;;
    /mnt/*/files/*/static/files|/mnt/*/files/*/static/files/*)
      _a="${_a#/mnt/}"; _a="${_a#*/files/}"; _a="${_a%%/*}" ;;
    */*) echo "none - -"; return 0 ;;
  esac
  _a="${_a%%.*}"
  case "${_a}" in
    ""|all|aegir|root|www-data|wg-*|*[!a-z0-9-]*) echo "none - -"; return 0 ;;
  esac
  _e=$(getent group "wg-${_a}" 2> /dev/null) || { echo "none - -"; return 0; }
  _gid=$(printf '%s' "${_e}" | cut -d: -f3)
  case "${_gid}" in
    ""|*[!0-9]*) echo "none - -"; return 0 ;;
  esac
  # every holder of the gid: members of each group entry carrying it (a
  # second entry can share the number) and every user with it as primary
  for _u in $(getent group | awk -F: -v g="${_gid}" '$3 == g { print $4 }' | tr ',' ' ') \
    $(getent passwd | awk -F: -v g="${_gid}" '$4 == g { print $1 }'); do
    [[ "${_u}" =~ ^${_a}(\.[a-z0-9]+(-dev)?|\.[0-9]+\.web)?$ ]] \
      || { echo "foreign ${_gid} wg-${_a}"; return 0; }
  done
  _r="/root/.${_a}.web-group.txt"
  if [ -f "${_r}" ] && [ ! -L "${_r}" ] \
    && [ "$(stat -c %u -- "${_r}" 2> /dev/null)" = "0" ]; then
    read -r _rg _rgid _rph _ < "${_r}" || :
  fi
  if [ "${_rg}" != "wg-${_a}" ] || [ "${_rgid}" != "gid=${_gid}" ]; then
    echo "held ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=B" ]; then
    echo "phaseb ${_gid} wg-${_a}"
  elif [ "${_rph}" = "phase=A" ]; then
    echo "converted ${_gid} wg-${_a}"
  else
    echo "held ${_gid} wg-${_a}"
  fi
}

_web_group() {
  # The group a root writer gives an account's web paths (files/, private/,
  # settings.php and the like): wg-<account> once the account is converted,
  # www-data otherwise, as always. Until the record says converted every
  # identity of the account still holds www-data (a conversion grants the web
  # group first and a revert gives www-data back before it moves any path),
  # so www-data is the old state, never an outage. Callers write
  # "${_owner}${_wg:+:${_wg}}": a missing helper, an empty answer, changes no
  # group and never hands a path to a login group. Run as any user but root,
  # which cannot read root's record, a held group answers empty: the group
  # each path has is kept. $1 as _web_group_state.
  local _s
  _s=$(_web_group_state "${1}")
  case "${_s%% *}" in
    converted|phaseb) echo "${_s##* }" ;;
    held) [ "$(id -u)" = "0" ] && echo "www-data" || echo "" ;;
    *) echo "www-data" ;;
  esac
}

# The group the target's own writers give an account's web paths there:
# wg-<account> once the account is converted there, www-data otherwise,
# derived on the target by the helper above, sent along with the question.
# Prints nothing and returns 1 when the target cannot be asked. Verbatim in
# xoct, xcopy and xmass.
# $1 = account on the target, $2 = target host.
_web_group_on_target() {
  local _a="${1}" _h="${2}" _o
  case "${_a}" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ -n "${_h}" ] || return 1
  _o=$( { declare -f _web_group_state _web_group
    printf '%s\n' "echo \"XMWG:\$(_web_group '${_a}')\""; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_h}" "bash -s" 2> /dev/null \
    | grep -m1 -x -E 'XMWG:[a-z0-9-]+')
  _o="${_o#XMWG:}"
  case "${_o}" in
    www-data|"wg-${_a}") echo "${_o}" ;;
    *) return 1 ;;
  esac
}

_web_group_policy() {
  # The account's web-group policy as bash reads its cnf, the file $1
  # (/root/.<account>.octopus.cnf): the last _WEB_GROUP assignment, with
  # export, quotes or a trailing comment. NO (opted out of the conversion)
  # or A (pinned at phase A) is printed; any other value, or none, prints
  # nothing. Verbatim in instgrp, xoct, xcopy and xmass: the gates, the
  # notes and the carry read the line the same way.
  local _l
  _l=$(grep -E "^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=" "${1}" 2> /dev/null | tail -n 1 \
    | sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=(NO|\"NO\"|'NO'|A|\"A\"|'A')([[:space:]]+#.*)?[[:space:]]*\$/\\2/p" \
    | tr -d "\"'")
  case "${_l}" in
    NO|A) printf '%s\n' "${_l}" ;;
  esac
  return 0
}

# The web-group facts of the account $1 on this box, one line for the
# helper below: "XMWF:<state>:<phase B>:<policy>:<armed>:<standby>", the
# state as _web_group_state prints it; YES when /root/.barracuda.cnf sets
# _WEB_GROUP_PHASE_B=YES (NO otherwise); the account's _WEB_GROUP policy
# (NO, A, or - for none); YES when the box carries the arm stamp a
# barracuda pass writes while _WEB_GROUP_ARM=YES (NO otherwise: nothing
# ever converts there); YES on a standby or a box being prepared as one
# (nothing converts there until its promotion). Sent to the target, never
# run here.
# shellcheck disable=SC2329
_web_group_facts_here() {
  local _s _b=NO _p _r=NO _sb=NO
  _s=$(_web_group_state "${1}")
  grep -qE "^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP_PHASE_B=[\"']?YES" /root/.barracuda.cnf 2> /dev/null && _b=YES
  _p=$(_web_group_policy "/root/.${1}.octopus.cnf")
  [ -s /var/log/boa/instgrp-web-arm.ready.txt ] && _r=YES
  { [ -e /root/.standby.cnf ] || [ -e /root/.standby.prep.cnf ]; } && _sb=YES
  echo "XMWF:${_s%% *}:${_b}:${_p:--}:${_r}:${_sb}"
}

# The facts above for the account $1 on the target $2, asked of the target
# itself: "<state>:<phase B>:<policy>:<armed>:<standby>". Prints nothing and
# returns 1 when the target cannot be asked. Verbatim in xoct, xcopy and
# xmass.
_web_group_facts_on_target() {
  local _a="${1}" _h="${2}" _o
  case "${_a}" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ -n "${_h}" ] || return 1
  _o=$( { declare -f _web_group_state _web_group_policy _web_group_facts_here
    printf '%s\n' "_web_group_facts_here '${_a}'"; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_h}" "bash -s" 2> /dev/null \
    | grep -m1 -x -E 'XMWF:(none|foreign|held|converted|phaseb):(YES|NO):(NO|A|-):(YES|NO):(YES|NO)')
  [ -n "${_o}" ] || return 1
  echo "${_o#XMWF:}"
}

# What a migration does not carry of the account's web-group state, told
# when the move takes effect: a NOTE each, never a refusal. $1 the account
# here, $2 the account on the target $3; $4 "cnf" for a tool with no cnf
# merge (xcopy), whose policy (_WEB_GROUP=NO or A) is named whenever the
# target's cnf lacks it; xoct's and xmass's merges carry it. Read here: the
# account's web-group state, its intent (a --phase-a pin, a revert in
# progress) and its policy; asked of the target: the facts above. A target
# that is not armed never converts; a standby converts only after its
# promotion. Verbatim in xoct, xcopy and xmass.
_wg_migration_notes() {
  local _a="${1}" _d="${2}" _h="${3}" _how="${4:-state}" _s _i="" _p _f _t _ts _tb _tp _ta _tsb
  local _when="" _ipin=NO
  _s=$(_web_group_state "${_a}" | cut -d' ' -f1)
  _f="/var/log/boa/instgrp-web.${_a}.txt"
  if [ -f "${_f}" ] && [ ! -L "${_f}" ] && [ "$(stat -c %u -- "${_f}" 2> /dev/null)" = "0" ]; then
    _i=$(timeout 10 dd if="${_f}" iflag=nofollow,nonblock bs=4096 count=1 status=none 2> /dev/null | head -n 1)
  fi
  case "${_i}" in
    target=*) ;;
    *) _i="" ;;
  esac
  _p=$(_web_group_policy "/root/.${_a}.octopus.cnf")
  [ "${_s}" = "none" ] && [ -z "${_i}" ] && [ -z "${_p}" ] && return 0
  if ! _t=$(_web_group_facts_on_target "${_d}" "${_h}"); then
    echo "NOTE: the web-group state of ${_d} on ${_h} could not be read; run 'instgrp webstatus ${_d}' there"
    return 0
  fi
  IFS=: read -r _ts _tb _tp _ta _tsb <<< "${_t}"
  [ "${_tsb}" = "YES" ] && _when=" after its promotion"
  case "${_s}:${_ts}" in
    converted:none|converted:held|converted:foreign|phaseb:none|phaseb:held|phaseb:foreign)
      if [ "${_ta}" != "YES" ]; then
        echo "NOTE: ${_a} uses its own web group here and ${_d} on ${_h} does not, and ${_h} is not armed for the web group (no _WEB_GROUP_ARM=YES stamp): it never converts there, its web paths stay in www-data until that box is armed"
      else
        echo "NOTE: ${_a} uses its own web group here and ${_d} on ${_h} does not: its web paths are in www-data there until that box converts it${_when}, by its own policy"
      fi
      ;;
  esac
  case " ${_i} " in
    *" pin=phase-a "*) _ipin=YES ;;
  esac
  if [ "${_ipin}" = "YES" ] && [ "${_p}" != "A" ]; then
    echo "NOTE: ${_a} is pinned at phase A here without _WEB_GROUP=A in /root/.${_a}.octopus.cnf, so the pin does not travel: run 'instgrp webconvert ${_a} --phase-a' here, which writes it"
  elif [ "${_p}" = "A" ] && [ "${_how}" = "cnf" ] && [ "${_tp}" != "A" ]; then
    echo "NOTE: ${_a} is pinned at phase A here (_WEB_GROUP=A) and /root/.${_d}.octopus.cnf on ${_h} does not say so: run 'instgrp webconvert ${_d} --phase-a' on ${_h}${_when}"
  fi
  if [ "${_p}" = "A" ] && [ "${_ts}" = "phaseb" ]; then
    echo "NOTE: ${_a} is pinned at phase A here and ${_d} on ${_h} is at phase B: run 'instgrp webconvert ${_d} --phase-a' on ${_h}${_when}"
  fi
  case "${_i}" in
    "target=none "*)
      echo "NOTE: a web-group revert of ${_a} is in progress here and does not travel: ${_d} converts on ${_h}${_when} by that box's policy unless its opt-out went with it; run 'instgrp webrevert ${_d}' on ${_h}${_when} to revert it there"
      ;;
  esac
  if [ "${_s}" = "phaseb" ] && [ "${_ta}" = "YES" ] && [ "${_tb}" != "YES" ] && [ "${_ts}" != "phaseb" ] \
    && [ "${_p}" != "A" ]; then
    echo "NOTE: ${_a} is at phase B here and ${_h} has _WEB_GROUP_PHASE_B off: ${_d} converts there to phase A only; run 'instgrp webconvert ${_d} --phase-b' on ${_h}${_when}"
  fi
  if [ "${_p}" = "NO" ]; then
    if [ "${_how}" = "cnf" ]; then
      [ "${_tp}" = "NO" ] \
        || echo "NOTE: ${_a} is opted out here (_WEB_GROUP=NO) and /root/.${_d}.octopus.cnf on ${_h} does not say so: run 'instgrp webrevert ${_d}' on ${_h}, which writes the opt-out there"
    elif [ "${_ts}" != "none" ]; then
      echo "NOTE: ${_a} is opted out here (_WEB_GROUP=NO), and ${_d} on ${_h} took its web group before the opt-out reached it: run 'instgrp webrevert ${_d}' on ${_h}"
    fi
  fi
  return 0
}

###
### Avoid too many questions
###
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
if [ -z "${TERM+x}" ]; then
  export TERM=vt100
fi

###-------------MIGRATION PROXY POLICY-###
###
### Per-ACCOUNT proxy policy, deliberately not per-box: accounts from one
### source can migrate to different targets, so a box-level flag cannot
### express what each account's customer should be told or which peer the
### target must keep trusting.
###
### The policy record is NOT stored in log/proxied.pid. That file is the
### migration STATE and three other tools own it: aegir2beoa-stage2 writes it
### as a freeze mutex and rm -f's it again, and xmass/xcopy rewrite it to a
### bare COMPLETE. Policy living there would be destroyed by an unrelated
### freeze cycle. It also cannot live under static/control, which is chowned
### to the client's SFTP user -- a customer could then choose the mode and
### rewrite the mail they are sent.
###
_MIG_CNF_NAME="log/migproxy.cnf"
_MIG_LOG_NAME="log/migproxy.log"
_MIG_BOX_MODE_FILE="/data/conf/migproxy_mode.txt"
_MIG_BOX_DEADLINE_FILE="/data/conf/migproxy_deadline.txt"
_MIG_LEGACY_ORPHAN="/data/conf/xmass_permanent_proxy.pid"
_MIG_TRUST_TOOL="/var/xdrago/migration_proxy_trust.sh"

### Parsed, never sourced: log/ is rsynced host to host, so this file WILL
### arrive from the peer, and sourcing a line that came over the network as
### root is not worth the convenience. log/ is oN's: read inside the real
### directory, never through a link or into a FIFO put at the name.
_mig_get() {
  local _f="$1" _k="$2"
  [ -r "${_f}" ] || return 1
  _xoct_read_in "${_f%/*}" "${_f##*/}" | grep -m1 "^${_k}=" | cut -d= -f2- | tr -d '\r\n'
}

_mig_valid_mode() {
  case "$1" in
    temporary|permanent|ha-switch|retired) return 0 ;;
    *) return 1 ;;
  esac
}
_mig_valid_ip()  { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
_mig_valid_date() { [[ "$1" =~ ^20[0-9]{2}-[01][0-9]-[0-3][0-9]$ ]]; }

### A record whose _MIG_HOST_IP is not one of this box's own addresses arrived
### by the log/ rsync. It is provenance for reporting, never a decision input.
_mig_is_mine() {
  local _hip
  _hip="$(_mig_get "$1" _MIG_HOST_IP)"
  _mig_valid_ip "${_hip}" || return 1
  hostname -I 2>/dev/null | tr ' ' '\n' | grep -qxF "${_hip}"
}

### This box's routable IPv4 identity -- what records are written with and the
### "old address" the client mails print. _MY_OWNIP (barracuda.cnf) is the
### authoritative value, matching the rest of the migration tooling; the
### hostname -I scan is only the fallback, because on a multi-homed box its
### first address can be a private one.
_mig_my_ip() {
  local _ip="${_MY_OWNIP}"
  if ! [[ "${_ip}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || [[ "${_ip}" =~ ^127\. ]]; then
    _ip="$(hostname -I 2>/dev/null | tr ' ' '\n' \
      | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
      | grep -vE '^127\.' | head -1)"
  fi
  printf '%s' "${_ip}"
}

### Every routable IPv4 this box holds, space-separated: the target must trust
### them all (the relay's egress interface is not always the primary address).
_mig_my_ips() {
  local _l
  _l="$(hostname -I 2>/dev/null | tr ' ' '\n' \
    | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
    | grep -vE '^127\.' | tr '\n' ' ')"
  _l="${_l%"${_l##*[![:space:]]}"}"
  [ -z "${_l}" ] && _l="$(_mig_my_ip)"
  printf '%s' "${_l}"
}

### Account names travel into remote paths and a remote heredoc; validate
### before any of that, fail-closed.
_mig_valid_acct() { [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]; }

### Normalise a deadline to an absolute date at WRITE time; a stored relative
### date would drift between the write and the mail. Empty stays empty. A date
### already in the past is refused: it would render a client mail promising
### "this arrangement ends on <date>" about a date that has been and gone.
_mig_norm_deadline() {
  local _in="$1" _out
  [ -z "${_in}" ] && { printf ''; return 0; }
  case "${_in}" in
    +[0-9]*d) _out="$(date -u -d "${_in%d} days" '+%Y-%m-%d' 2>/dev/null)" ;;
    *)        _out="$(date -u -d "${_in}" '+%Y-%m-%d' 2>/dev/null)" ;;
  esac
  _mig_valid_date "${_out}" || return 1
  [[ "${_out}" < "$(date -u '+%Y-%m-%d')" ]] && return 1
  printf '%s' "${_out}"
}

### LC_ALL=C is load-bearing: without it a locale leak puts a non-English
### month name into a customer email.
_mig_pretty_date() {
  [ -z "$1" ] && { printf ''; return 0; }
  LC_ALL=C date -u -d "$1" '+%-d %B %Y' 2>/dev/null
}

### A cutover that died between the retired touch/rm pair in a pre-mode xmass
### left the meaningless /data/conf/xmass_permanent_proxy.pid behind. Convert
### it once into the box default it was meant to express, so nobody reads
### stale residue as policy. Idempotent; an existing box default always wins.
_mig_sweep_legacy() {
  [ -e "${_MIG_LEGACY_ORPHAN}" ] || return 0
  if [ ! -s "${_MIG_BOX_MODE_FILE}" ]; then
    mkdir -p "$(dirname "${_MIG_BOX_MODE_FILE}")" 2>/dev/null
    echo permanent > "${_MIG_BOX_MODE_FILE}"
    echo "ALRT: legacy xmass permanent-proxy flag found; converted to box default 'permanent'"
  else
    echo "ALRT: legacy xmass permanent-proxy flag found; box default already declared, flag removed"
  fi
  rm -f "${_MIG_LEGACY_ORPHAN}"
}

### Resolve mode for an account, setting _MIG_MODE/_MIG_DEADLINE/_MIG_SOURCE.
### SETS GLOBALS: never call this inside $( ) or a pipeline, or the resolution
### is lost to the subshell and the caller silently proceeds on stale values.
### Source matters: "default" selects the neutral mail block and is what a mass
### cutover refuses, because one wrong mail is recoverable and a boxful is not.
### The deadline resolves independently over the same ladder: "everyone off
### this box by X" is a legitimate box-wide statement even where one account
### carries its own mode. An explicit --no-deadline is a value on that ladder
### too: the record stores it as "none", and _MIG_DEADLINE_NONE=YES says the
### ladder stopped on it. _MIG_DEADLINE itself stays empty for it, because
### every consumer tests, logs, compares and mails it as empty-means-none.
_mig_resolve() {
  local _root="$1" _cnf _m _d
  _cnf="${_root}/${_MIG_CNF_NAME}"
  _MIG_MODE=""; _MIG_DEADLINE=""; _MIG_SOURCE=""; _MIG_DEADLINE_NONE=""
  _mig_sweep_legacy

  ### A target-role record is the inbound half of the peer-record pair: it
  ### describes the PEER's proxy policy from the migration that brought this
  ### account here, not a mode declaration for this box as a future source.
  ### Without the role check a chained migration (target later becoming a
  ### source -- the HA mirror build) resolved the OLD migration's mode and
  ### deadline over the operator's explicit box default.
  if [ -r "${_cnf}" ] && _mig_is_mine "${_cnf}" \
    && [ "$(_mig_get "${_cnf}" _MIG_ROLE)" != "target" ]; then
    _m="$(_mig_get "${_cnf}" _MIG_MODE)"
    _d="$(_mig_get "${_cnf}" _MIG_DEADLINE)"
    if _mig_valid_mode "${_m}"; then
      _MIG_MODE="${_m}"
      _MIG_SOURCE="$(_mig_get "${_cnf}" _MIG_SCOPE)"
      [ "${_MIG_SOURCE}" = "account" ] || _MIG_SOURCE=box
      _mig_valid_date "${_d}" && _MIG_DEADLINE="${_d}"
      [ "${_d}" = "none" ] && _MIG_DEADLINE_NONE=YES
    else
      [ -n "${_m}" ] && echo "ALRT: ${_cnf}: invalid _MIG_MODE '${_m}' ignored"
    fi
  fi

  if [ -z "${_MIG_MODE}" ] && [ -r "${_MIG_BOX_MODE_FILE}" ]; then
    _m="$(head -n1 "${_MIG_BOX_MODE_FILE}" 2>/dev/null | tr -d '\r\n')"
    if _mig_valid_mode "${_m}"; then
      _MIG_MODE="${_m}"; _MIG_SOURCE=box
    fi
  fi

  ### A legacy empty deadline still takes the box default; an explicit none
  ### does not -- refilling it mailed an end date the operator had removed.
  if [ -n "${_MIG_MODE}" ] && [ -z "${_MIG_DEADLINE}" ] \
    && [ "${_MIG_DEADLINE_NONE}" != "YES" ] \
    && [ -r "${_MIG_BOX_DEADLINE_FILE}" ]; then
    _d="$(head -n1 "${_MIG_BOX_DEADLINE_FILE}" 2>/dev/null | tr -d '\r\n')"
    _mig_valid_date "${_d}" && _MIG_DEADLINE="${_d}"
  fi

  if [ -z "${_MIG_MODE}" ]; then
    _MIG_MODE=temporary
    _MIG_SOURCE=default
    echo "ALRT: ${_root}: no proxy mode declared; falling back to '${_MIG_MODE}'."
    echo "ALRT:   Declare it with: xoct proxy-mode $(basename "${_root}") <temporary|permanent|ha-switch>${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
  fi

  ### A date by which the customer must leave the switch point contradicts
  ### what a switch point is for.
  if [ "${_MIG_MODE}" = "ha-switch" ] && [ -n "${_MIG_DEADLINE}" ]; then
    echo "ALRT: ${_root}: ha-switch ignores the resolved deadline ${_MIG_DEADLINE}"
    _MIG_DEADLINE=""
  fi
  return 0
}

### Write the policy record. Root-owned 0600. log/ is oN's: the record is
### put inside the real directory as a fresh file, created root:root 0600
### through the handle that wrote it and renamed over the name, never
### written, chowned or chmodded by name or through a link put there.
### Optional $8 is the space-separated full peer IP list (_MIG_PEER_IPS): a
### relaying source can hold several routable addresses and the target's
### reconcile must keep trusting all of them, not just the primary.
_mig_write_record() {
  local _root="$1" _role="$2" _peer_ip="$3" _peer_oct="$4" _mode="$5" _scope="$6" _dl="$7" _peer_ips="$8" _rdl="$9"
  local _cnf="${_root}/${_MIG_CNF_NAME}"
  _mig_valid_mode "${_mode}" || { echo "ALRT: refusing to write invalid mode '${_mode}'"; return 1; }
  mkdir -p "${_root}/log" 2>/dev/null
  {
    echo "# BOA migration proxy policy. Managed by xoct/xmass. Do not edit by hand."
    echo "_MIG_ROLE=${_role}"
    echo "_MIG_HOST_IP=$(_mig_my_ip)"
    echo "_MIG_PEER_IP=${_peer_ip}"
    echo "_MIG_PEER_OCT=${_peer_oct}"
    echo "_MIG_MODE=${_mode}"
    echo "_MIG_SCOPE=${_scope}"
    ### Record form: a date, "none" (explicit, the resolvers stop on it) or
    ### empty (unset, the box default fills it).
    echo "_MIG_DEADLINE=${_dl}"
    ### The withdrawal date a retirement promised is its own key: a deadline
    ### on a retired record would be inherited by a later mode declaration
    ### and mailed inside the wrong arrangement block.
    [ -n "${_rdl}" ] && echo "_MIG_RETIRE_DATE=${_rdl}"
    [ -n "${_peer_ips}" ] && echo "_MIG_PEER_IPS=${_peer_ips}"
    echo "_MIG_STAMPED=$(date -u '+%Y-%m-%d')"
  } | _xoct_in_real_dir "${_cnf%/*}" _xoct_write_here "${_cnf##*/}" 077 \
    root:root || return 1
  return 0
}

### The bytes read from stdin appended to the name $1 through one handle
### opened O_WRONLY|O_APPEND|O_NOFOLLOW|O_NONBLOCK, and only once that handle
### is a regular file with one link, owned by root, mode 0600: a link, a
### FIFO, a hard link to another file or a file of another owner put at the
### name is never written. Status 1, nothing written, otherwise.
_XOCT_APPEND_PL='use Fcntl; my ($n) = @ARGV; local $/; my $d = <STDIN>; sysopen(my $h, $n, O_WRONLY|O_APPEND|O_NOFOLLOW|O_NONBLOCK) or exit 1; my @s = stat($h); exit 1 unless @s && -f _ && $s[3] == 1 && $s[4] == 0 && ($s[2] & 07777) == 0600; (print {$h} $d) or exit 1; close($h) or exit 1; exit 0'
### The line $2 added to ./$1 in the current (pinned) log directory, kept
### root's 0600 file: appended in place only through a handle that is one
### (_XOCT_APPEND_PL); anything else at the name is replaced by a fresh
### root:root 0600 file carrying its lines and the new one.
_mig_log_here() {
  if printf '%s\n' "${2}" | perl -e "${_XOCT_APPEND_PL}" "./${1}" 2> /dev/null; then
    return 0
  fi
  { _xoct_read_here "${1}" | awk 1; printf '%s\n' "${2}"; } \
    | _xoct_write_here "${1}" 077 root:root
}

### Append-only audit. The only place the answer to "what were they actually
### told, and when" lives; the re-notify decision reads its last mail line.
_mig_log() {
  local _root="$1" _tool="$2" _action="$3" _detail="$4" _mode="$5" _dl="$6" _peer="$7"
  local _lg="${_root}/${_MIG_LOG_NAME}"
  ### Every interpolated field is sanitised, not just the free-text one: the
  ### re-notify comparison parses this file by field position, so a stray
  ### pipe in any value would shift every later field.
  _detail="$(printf '%s' "${_detail}" | tr -cd '[:print:]' | tr -d '|' | cut -c1-120)"
  _mode="$(printf '%s' "${_mode}" | tr -cd '[:print:]' | tr -d '|' | cut -c1-20)"
  _dl="$(printf '%s' "${_dl}" | tr -cd '[:print:]' | tr -d '|' | cut -c1-10)"
  _peer="$(printf '%s' "${_peer}" | tr -cd '[:print:]' | tr -d '|' | cut -c1-45)"
  mkdir -p "${_root}/log" 2>/dev/null
  _xoct_in_real_dir "${_lg%/*}" _mig_log_here "${_lg##*/}" \
    "$(date -u '+%Y-%m-%dT%H:%M:%S')|${_tool}|${_action}|${_detail}|${_mode}|${_dl:--}|${_peer:--}"
  return 0
}

###-------------SYSTEM-----------------###

### Last promise actually mailed, as "mode|deadline" from the newest mail line
### in the account's migproxy.log; empty output if the client was never mailed.
### The uniform re-notify rule keys on this, which is why mail lines are only
### ever written after a confirmed send. With peers after $1 (the source
### role), only a line naming a peer of this box's moves counts
### (_xoct_source_peers), and never a notice this box sent as the target of
### the move that brought the account here (change-inbound, retire-inbound:
### it names the box the account came from, which a move back to that box
### makes a peer again); without them (the target role) every line.
_mig_last_mail() {
  local _l _r="$1" _p=""
  shift
  [ "$#" -gt 0 ] && _p=" $(_xoct_source_peers "${_r}" "$@") "
  _l="$(_xoct_read_in "${_r}/${_MIG_LOG_NAME%/*}" "${_MIG_LOG_NAME##*/}" \
    | grep '|mail|' | awk -F'|' -v n="$#" -v p="${_p}" 'n == 0 || ($4 !~ /-inbound$/ && index(p, " " $7 " "))' | tail -1)"
  [ -n "${_l}" ] || return 0
  printf '%s' "${_l}" | awk -F'|' '{ print $5 "|" $6 }'
}
### The peers whose notices count on the source for the account at $1: the
### ones after $1 (this move's target; the old one while a retarget is in
### flight) and every peer a set line of its log names (each target this box
### proxied the account to: after a retarget the client's real notices name
### the target before it), never one of this box's own addresses. log/
### travels with the account, and the notices of the move that brought it
### here name this box: they told the client nothing of a move from here.
### A policy change made here while this box was that move's target logs
### set-inbound, naming the box the account came from, which counts for
### nothing. Space separated.
_xoct_source_peers() {
  local _r="$1" _me
  shift
  _me=" $(_mig_my_ips) $(_mig_my_ip) "
  {
    printf '%s\n' "$@"
    _xoct_read_in "${_r}/${_MIG_LOG_NAME%/*}" "${_MIG_LOG_NAME##*/}" \
      | awk -F'|' '$3 == "set" { print $7 }'
  } | awk -v me="${_me}" 'NF && $0 != "-" && !index(me, " " $0 " ") && !s[$0]++ { printf "%s ", $0 }'
}
### True when the account at $1 was converted before its migration log
### recorded the notices: its log/proxied.pid is older than the log's first
### line, or there is no log. Its client was mailed then, unrecorded.
_xoct_proxied_before_log() {
  local _pt _first _ft
  _pt="$(_xoct_in_real_dir "${1}/log" stat -c %Y -- ./proxied.pid 2> /dev/null)"
  [[ "${_pt}" =~ ^[0-9]+$ ]] || return 1
  _first="$(_xoct_read_in "${1}/${_MIG_LOG_NAME%/*}" "${_MIG_LOG_NAME##*/}" \
    | head -n 1 | cut -d'|' -f1)"
  [ -n "${_first}" ] || return 0
  _ft="$(date -u -d "${_first}" +%s 2> /dev/null)"
  [[ "${_ft}" =~ ^[0-9]+$ ]] || return 1
  [ "${_pt}" -lt "${_ft}" ]
}
### True when the client of the account at $1 was really told of the
### completion: a real (mail, never testmail) completion line in its log
### naming a peer of this box's moves when peers follow $1
### (_xoct_source_peers; any line without them), or a conversion from before
### the log recorded one. A notice sent as the target is never such a line:
### it is logged change-inbound or retire-inbound.
_xoct_told_complete() {
  local _n _r="$1" _p=""
  shift
  [ "$#" -gt 0 ] && _p=" $(_xoct_source_peers "${_r}" "$@") "
  _n="$(_xoct_read_in "${_r}/${_MIG_LOG_NAME%/*}" "${_MIG_LOG_NAME##*/}" \
    | awk -F'|' -v n="$#" -v p="${_p}" '$3=="mail" && $4=="complete" && (n == 0 || index(p, " " $7 " ")) { c++ } END { print c+0 }')"
  [ "${_n:-0}" != "0" ] && return 0
  _xoct_proxied_before_log "${_r}"
}

### Per-account facts the policy mails are built from, for verbs that never
### pass through _migrate_prepare (proxy-mode, proxy-retire).
_mig_load_account_mail_facts() {
  local _root="$1" _a="$2"
  _THIS_HM_USER="${_a}"
  ### log/ is oN's: read inside the real directory, never through a link or
  ### into a FIFO put at the name
  _DOMAIN=""
  [ -e "${_root}/log/domain.txt" ] && _DOMAIN="$(_xoct_read_in "${_root}/log" domain.txt | tr -d '\n')"
  ### No stand-in for an account without an address: _xoct_mail_rcpt
  ### refuses the notice and names the cause.
  _xoct_client_address "${_root}" "${_a}"
}

### Compose the mode-selected client-mail blocks from the resolved policy
### (_MIG_MODE/_MIG_DEADLINE/_MIG_SOURCE). Sets _MIG_DNS_BLOCK (the forwarding
### arrangement), _MIG_COVERAGE_BLOCK (what the old address covers -- identical
### in every mode) and _MIG_ADDR_BLOCK (old/new address pair). $1 = context
### (complete|start|change|retire), $2 = the new system's IP, $3 = the old
### address (defaults to this box -- callers acting on a TARGET-role record
### must pass the peer here, or the customer is told to move DNS backwards).
_mig_build_mail_blocks() {
  local _ctx="$1" _new_ip="$2" _old_ip="$3" _pd=""
  [ -z "${_old_ip}" ] && _old_ip="$(_mig_my_ip)"
  ### A promise about a date that has already been and gone must never be
  ### mailed: a record can sit between declaration and send for months, so
  ### the write-time floor in _mig_norm_deadline is not enough on its own.
  if [ -n "${_MIG_DEADLINE}" ] \
    && [[ "${_MIG_DEADLINE}" < "$(date -u '+%Y-%m-%d')" ]]; then
    echo "ALRT: stored deadline ${_MIG_DEADLINE} has already passed; composing the"
    echo "ALRT: no-deadline variant -- set a new date (xoct proxy-mode ... --deadline=+Nd${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}})"
    _MIG_DEADLINE=""
  fi
  [ -n "${_MIG_DEADLINE}" ] && _pd="$(_mig_pretty_date "${_MIG_DEADLINE}")"

  _MIG_ADDR_BLOCK="YOUR OLD SYSTEM IP ADDRESS WAS: [${_old_ip}]
YOUR NEW SYSTEM IP ADDRESS IS:  [${_new_ip}]

In your DNS records, replace the first address with the second."

  _MIG_COVERAGE_BLOCK="What the old address covers, and what it does not

The old address forwards traffic only for the sites that were on it at the moment of the migration. Each of those was given its own forwarding entry, frozen exactly as it stood that day.

Anything you create from now on is not covered by it:

  - a new site installed on the new system,
  - a site cloned or renamed on the new system,
  - a new domain, subdomain or alias added to a site you already have.

For all of those, point DNS straight at the new address. There is nothing to wait for and nothing to switch over later. If one is pointed at the old address by mistake it will not load correctly, and on an https:// link the visitor's browser will also report a certificate problem, because the old address holds no certificate for a name it has never served."

  ### The retirement notice carries only the address pair; its own body text
  ### is composed by the sender (with or without a withdrawal date).
  if [ "${_ctx}" = "retire" ]; then
    _MIG_DNS_BLOCK=""
    _MIG_COVERAGE_BLOCK=""
    return 0
  fi

  ### xoct export can run before anyone has chosen a mode. Only a genuinely
  ### undeclared account gets the neutral start block; a declared mode is a
  ### promise and the start notice already carries it.
  if [ "${_ctx}" = "start" ] && [ "${_MIG_SOURCE}" = "default" ]; then
    _MIG_COVERAGE_BLOCK=""
    _MIG_DNS_BLOCK="Important: DNS for your sites

Your sites keep their current addresses throughout the migration. Once it is finished you will receive a second message with your new address and with the DNS instructions that apply to your account, including what happens to your old address and at what pace to move DNS across. Please do not change any DNS records until you have that message."
    return 0
  fi

  case "${_MIG_MODE}" in
    temporary)
      if [ -n "${_pd}" ]; then
        _MIG_DNS_BLOCK="Forwarding from your old address: temporary, until ${_pd}

The old address has been kept in service and is forwarding traffic for your existing sites to the new address, so nothing goes dark while DNS propagates. This arrangement ends on ${_pd}. Please make sure DNS for every existing site points at the new address before then. From that date the old address stops answering, and any name still pointing at it will stop reaching your site.

If you need more time, reply to this message and we will extend the date. There is no penalty for asking, and we would far rather move the date than have a site go dark."
      else
        _MIG_DNS_BLOCK="Forwarding from your old address: temporary

The old address has been kept in service and is forwarding traffic for your existing sites to the new address, so nothing goes dark while DNS propagates. This arrangement is temporary and will be withdrawn once the migration has settled; we will tell you before that happens. Please move DNS for your existing sites across in your own time, but please do not leave it indefinitely: once the old address is retired, any name still pointing at it stops reaching your site."
      fi
    ;;
    permanent)
      local _hdr="kept in place" _dlp=""
      if [ -n "${_pd}" ]; then
        _hdr="kept in place, with a date to work to"
        _dlp="

We do have one date to work to. Please have DNS for all your existing sites moved to the new address by ${_pd}."
      fi
      _MIG_DNS_BLOCK="Forwarding from your old address: ${_hdr}

The old address stays in service and keeps forwarding traffic for your existing sites to the new system. There is no cut-off date and no countdown, so there is no need to rush the DNS change. Move each site across at a normal pace, whenever it suits your own maintenance schedule.

Two things still make it worth finishing the move rather than leaving it indefinitely. A site served through the old address takes an extra network hop, so it is a little slower than one pointed straight at the new address. And, as set out below, only the sites that existed at migration time are covered, so you will be using the new address for anything new in any case. Bringing the rest across as you go keeps everything on one address.${_dlp}"
    ;;
    ha-switch)
      _MIG_DNS_BLOCK="Forwarding from your old address: your switch point

Your service now runs as a live pair, a main system and a live mirror. The old address has been kept in service as the switch point between the two, so if the main system has to be taken out of service, traffic arriving at that address moves to the mirror without you doing anything.

The old address is therefore part of the design rather than a leftover from the migration, and there is no need to move DNS away from it for your existing sites. If you would prefer the shortest possible path and are content to handle a switch-over yourself, you can point DNS at the new address directly; please let us know if you do, so that we can keep your records straight.

Either way, sites and domains added from now on are not on the switch. They are served directly by the new system at the address above, as set out below."
    ;;
    *)
      ### A retired (or unresolvable) policy has no honest forwarding story to
      ### tell; refusing here beats mailing prose the selector has no case for.
      echo "ALRT: no mail block for mode '${_MIG_MODE}'; refusing to compose"
      _MIG_DNS_BLOCK=""
      return 1
    ;;
  esac
  return 0
}

### True when $1 is one e-mail address, or several separated by single
### spaces, each a plain local part (letters, digits and . _ % + = ' -, a
### letter, a digit or _ first), '@' and a host name: the form the nightly
### and usage.sh mail. The address comes from the account's log/email.txt
### and is given to s-nail as its words: nothing else can read as an option
### there.
_xoct_email_ok() {
  local _w _re _q="'"
  _w="[A-Za-z0-9_][A-Za-z0-9._%+=${_q}-]*@[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?"
  _re="^${_w}( ${_w})*$"
  [[ "${1}" =~ ${_re} ]]
}
### $1 as a log line shows it: at most 120 bytes, non-printables as '?'.
_xoct_shown() {
  printf '%s' "${1:0:120}" | tr -c '[:print:]' '?'
}
### The account's client address as its own Octopus pass takes it: the words
### of log/email.txt when _xoct_email_ok takes them, otherwise the
### _CLIENT_EMAIL of root's cnf, which the pass keeps when the file holds no
### plain address and the nightly rewrites only from a file that does. Sets
### _CLIENT_EMAIL (empty when neither holds one), _XOCT_EMAIL_TXT (the file's
### text, one space between words) and _XOCT_EMAIL_SRC (log, cnf or none).
### $1 = the account's root, $2 = its name on this box.
_xoct_client_address() {
  local _root="$1" _acct="$2" _c=""
  _CLIENT_EMAIL=""
  _XOCT_EMAIL_TXT=""
  _XOCT_EMAIL_SRC=none
  if [ -e "${_root}/log/email.txt" ]; then
    _XOCT_EMAIL_TXT="$(_xoct_read_in "${_root}/log" email.txt | tr -s '[:space:]' ' ')"
    _XOCT_EMAIL_TXT="${_XOCT_EMAIL_TXT# }"
    _XOCT_EMAIL_TXT="${_XOCT_EMAIL_TXT% }"
    _XOCT_EMAIL_TXT=${_XOCT_EMAIL_TXT//\\\@/\@}
  fi
  if _xoct_email_ok "${_XOCT_EMAIL_TXT}"; then
    _CLIENT_EMAIL="${_XOCT_EMAIL_TXT}"
    _XOCT_EMAIL_SRC=log
    return 0
  fi
  if _mig_valid_acct "${_acct}" && [ -f "/root/.${_acct}.octopus.cnf" ]; then
    _c="$(grep -a '^_CLIENT_EMAIL=' "/root/.${_acct}.octopus.cnf" 2> /dev/null \
      | tail -n 1 | cut -c1-1024)"
    _c="${_c#_CLIENT_EMAIL=}"
    _c="${_c#\"}"
    _c="${_c%\"}"
    _c="$(printf '%s' "${_c}" | tr -s '[:space:]' ' ')"
    _c="${_c# }"
    _c="${_c% }"
    _c=${_c//\\\@/\@}
  fi
  if _xoct_email_ok "${_c}"; then
    _CLIENT_EMAIL="${_c}"
    _XOCT_EMAIL_SRC=cnf
  fi
  return 0
}
### Sets _MAIL_RCPT and _MAIL_BCC (the -b words, or none), the recipients of
### a client notice. With admail= that address alone, no copy to anyone: a
### test or canary run never mails a client. Otherwise the account's address
### (_xoct_client_address) with the operator's -b copy. An account with no
### plain address in either place gets no notice (status 1, a line naming
### the cause): a stand-in address used to take it unread.
_xoct_mail_rcpt() {
  _MAIL_RCPT=""
  _MAIL_BCC=()
  if [ -n "${_XOCT_ADMAIL}" ]; then
    _MAIL_RCPT="${_XOCT_ADMAIL}"
  elif _xoct_email_ok "${_CLIENT_EMAIL}"; then
    _MAIL_RCPT="${_CLIENT_EMAIL}"
    [ -n "${_BCC_EMAIL}" ] && _MAIL_BCC=(-b "${_BCC_EMAIL}")
  else
    echo "ALRT: ${_THIS_HM_USER}: no plain address in log/email.txt ('$(_xoct_shown "${_XOCT_EMAIL_TXT}")') or in _CLIENT_EMAIL of its cnf; no notice is sent"
    return 1
  fi
  return 0
}
### A test run's record (admail=), root's, in /data/conf: the address, in
### xoct_admail.<account>.txt. create under admail= puts it on the source for
### the account it moves and on the target for the account it installs;
### import under admail= puts it on its own box. While it exists, every verb
### for that account on that box except import refuses to run without
### admail= (_xoct_admail_gate), so one forgotten token cannot mail the
### client, and the cnf merge (create, every live transfer) and import keep
### the account's upgrade notice off there, token or not. go-live removes it
### on both boxes: that is how a canary goes live. The record create puts on
### the source carries a second line, _XOCT_ADMAIL_SRC_LINE: that canary's
### client mail is held on its target, so a hold on the source box never
### counts it as a user (_xoct_hold_users_here). A record already there is
### left as it is (one of a canary this box received stays a user of its
### hold until that test run goes live). The creates xmass runs put none
### (_XOCT_XMASS_RUN=YES): xmass keeps its own record of a test run of the
### whole box (_XOCT_XMASS_REC) and gates its cutover on it, and marks its
### target with one per source box (_XOCT_XMASS_MARKS), which a hold there
### counts as a user. Written 0644, the mode every Octopus pass gives each
### file in /data/conf (it holds a test address, nothing secret).
_XOCT_XMASS_REC=/data/conf/xmass_admail.txt
_XOCT_XMASS_MARKS='/data/conf/xmass_test_run.*.txt'
_XOCT_ADMAIL_SRC_LINE='_XOCT_ADMAIL_ROLE=source'
_xoct_admail_rec() {
  printf '/data/conf/xoct_admail.%s.txt' "$1"
}
### The first line of root's file $1, printable, at most 200 bytes.
_xoct_first_line() {
  head -n 1 "$1" 2> /dev/null | tr -cd '[:print:]' | cut -c1-200
}
### Puts the record of $1 on this box, the source of its move, when there is
### none. One already there is left as it is: without the source line the
### account came here in a test run that is still open, and it stays a user
### of this box's hold until that run's go-live removes it; with it, an
### earlier create of this canary put it. Status 1 when it cannot be put.
_xoct_admail_record_here() {
  local _f
  _f="$(_xoct_admail_rec "$1")"
  if [ -e "${_f}" ]; then
    if grep -qxF "${_XOCT_ADMAIL_SRC_LINE}" "${_f}" 2> /dev/null; then
      echo "INFO: admail=$(_xoct_first_line "${_f}") is recorded for $1 in ${_f}; kept: every later verb for $1 here refuses without admail="
    else
      echo "INFO: $1 came here in a test run still open (admail=$(_xoct_first_line "${_f}") in ${_f}): the record is kept, every later verb for $1 here refuses without admail=, and this box's mail hold counts it until that run's go-live"
    fi
    return 0
  fi
  if mkdir -p /data/conf \
    && ( umask 022; printf '%s\n' "${_XOCT_ADMAIL}" "${_XOCT_ADMAIL_SRC_LINE}" > "${_f}.tmp" ) \
    && mv -f "${_f}.tmp" "${_f}"; then
    echo "INFO: admail=${_XOCT_ADMAIL} recorded for $1 in ${_f}: every later verb for $1 here refuses without it"
    return 0
  fi
  echo "ALRT: admail= could not be recorded for $1 in ${_f}"
  return 1
}
### Without admail=, refuses (status 1, the way out named) an account whose
### record exists on this box, and every account while xmass's record of a
### test run of the whole box exists here: its own xoct calls carry the
### token, and a proxy-mode or proxy-retire without it would mail the clients
### of that run. With admail= it passes.
_xoct_admail_gate() {
  local _f _rec
  [ -n "${_XOCT_ADMAIL}" ] && return 0
  _f="$(_xoct_admail_rec "$1")"
  if [ -e "${_f}" ]; then
    _rec="$(_xoct_first_line "${_f}")"
    echo "ERROR: $1 is in a test run: admail=${_rec} is recorded in ${_f}"
    echo "ERROR: pass admail=${_rec} to this verb, or end the test run with"
    echo "ERROR: 'xoct go-live <account> <target-ip>' on the source box (it mails the client)"
    return 1
  fi
  _xoct_xmass_rec_gate
}
### Whether this run is xmass installing $1, a canary this box sends away in
### a test run still open, on its own target: an xmass run (_XOCT_XMASS_RUN)
### whose admail= is the address the canary's own record here holds, with
### the source line. The canary's export latch (exported.pid) belongs to its
### own move to its canary target; it does not stop the whole box from
### preparing a standing mirror around it.
_xoct_canary_carried() {
  local _f
  [ "${_XOCT_XMASS_RUN}" = "YES" ] && [ -n "${_XOCT_ADMAIL}" ] || return 1
  _f="$(_xoct_admail_rec "$1")"
  [ -f "${_f}" ] && [ ! -L "${_f}" ] || return 1
  grep -qxF "${_XOCT_ADMAIL_SRC_LINE}" "${_f}" 2> /dev/null || return 1
  [ "$(_xoct_first_line "${_f}")" = "${_XOCT_ADMAIL}" ]
}
### The box-wide half of it: without admail=, refuses (status 1, the way out
### named) while xmass's record of a test run of the whole box is here, or
### its mark of one that moves a box here (_XOCT_XMASS_MARKS). The sweep
### verbs ask it once, before their per-account loop. The completion notice
### go-live sends passes a mark (the account it ends left this box, the
### accounts that test run moves came to it) and, for an account xmass
### go-live ends, the record.
_xoct_xmass_rec_gate() {
  local _rec _m
  [ -n "${_XOCT_ADMAIL}" ] && return 0
  if [ -e "${_XOCT_XMASS_REC}" ]; then
    [ "${_XOCT_GO_LIVE}" = "YES" ] && [ "${_XOCT_XMASS_GOLIVE}" = "YES" ] && return 0
    _rec="$(_xoct_first_line "${_XOCT_XMASS_REC}")"
    echo "ERROR: this box is in an xmass test run: admail=${_rec} is recorded in ${_XOCT_XMASS_REC}"
    echo "ERROR: pass admail=${_rec} to this verb; the test run ends with 'xmass go-live <target-ip>'"
    echo "ERROR: once its cutover is done or while that target stands as this box's mirror (a pair"
    echo "ERROR: built as a test run); before its init a real move of the box starts again with"
    echo "ERROR: 'xmass prep-target <target-ip>' without admail= (it removes the record)"
    return 1
  fi
  [ "${_XOCT_GO_LIVE}" = "YES" ] && return 0
  for _m in ${_XOCT_XMASS_MARKS}; do
    [ -e "${_m}" ] || continue
    _rec="$(_xoct_first_line "${_m}")"
    echo "ERROR: this box is the target of an xmass test run: admail=${_rec} is recorded in ${_m}"
    echo "ERROR: pass admail=${_rec} to this verb, or end that test run on its source box ('xmass"
    echo "ERROR: go-live <this-box-ip>' once its cutover is done or while this box stands as its"
    echo "ERROR: mirror, 'xmass prep-target' without admail= before its init)"
    return 1
  done
  return 0
}
### A box that holds its clients' mail: /data/conf/client_mail_hold.txt,
### root's and 0644, holding one plain address, makes BOA's own senders on
### the box deliver every mail addressed to a client to that address alone.
### A test run under admail= puts it, holding that address, on the box its
### installs land on (the target of create, the box of import) when it is
### absent there; one holding another address is left as it is. go-live
### removes it where it holds the run's address and no other test run is
### recorded there (an xoct record, an xmass mark), and a real run (no
### admail=) refuses while it is there (_xoct_hold_gate), so a real move
### never leaves its client's mail held.
_XOCT_HOLD_FILE=/data/conf/client_mail_hold.txt
### The test runs recorded on this box whose client mail its hold holds,
### space separated (none: empty): xoct's records of the accounts this box
### received, and xmass's marks. A record carrying _XOCT_ADMAIL_SRC_LINE is
### a canary this box moves away: its mail is held on its target, not here.
### The go-live script run on the target counts the same way.
_xoct_hold_users_here() {
  local _f _l=""
  for _f in /data/conf/xoct_admail.*.txt ${_XOCT_XMASS_MARKS}; do
    [ -e "${_f}" ] || continue
    grep -qxF "${_XOCT_ADMAIL_SRC_LINE}" "${_f}" 2> /dev/null && continue
    _l="${_l} ${_f##*/}"
  done
  printf '%s' "${_l# }"
}
### Puts the hold on $1 (none: this box) for this run's admail=. Status 1
### when it cannot be read or put.
_xoct_hold_put() {
  local _h="$1" _sh _out _v
  _sh="_f=${_XOCT_HOLD_FILE}; if [ -e \"\${_f}\" ]; then head -n 1 \"\${_f}\" | tr -cd '[:print:]' | cut -c1-200; echo; echo HOLD-HAD; else mkdir -p /data/conf && ( umask 022; printf '%s\n' '${_XOCT_ADMAIL}' > \"\${_f}.tmp\" ) && chown root:root \"\${_f}.tmp\" && mv -f \"\${_f}.tmp\" \"\${_f}\" && echo HOLD-PUT; fi"
  if [ -n "${_h}" ]; then
    _out="$(ssh root@"${_h}" "${_sh}" 2> /dev/null)"
  else
    _out="$(bash -c "${_sh}" 2> /dev/null)"
  fi
  case "${_out}" in
    *HOLD-PUT*)
      echo "INFO: admail=: ${_XOCT_HOLD_FILE}${_h:+ on ${_h}} holds every client mail of that box for ${_XOCT_ADMAIL}"
      return 0
    ;;
    *HOLD-HAD*)
      _v="$(printf '%s\n' "${_out}" | head -n 1)"
      if [ "${_v}" = "${_XOCT_ADMAIL}" ]; then
        echo "INFO: admail=: ${_XOCT_HOLD_FILE}${_h:+ on ${_h}} already holds client mail for ${_XOCT_ADMAIL}"
      else
        echo "ALRT: ${_XOCT_HOLD_FILE}${_h:+ on ${_h}} holds client mail for another address (${_v}); left as it is"
      fi
      return 0
    ;;
  esac
  echo "ALRT: admail=: ${_XOCT_HOLD_FILE}${_h:+ on ${_h}} could not be read or put"
  return 1
}
### Without admail=, refuses (status 1, naming it) while the hold is on $1
### (none: this box): a real run would leave the moved client's mail held
### there. A probe of another box that cannot be read passes: the verb's own
### contact there reports it.
_xoct_hold_gate() {
  local _h="$1" _v
  [ -n "${_XOCT_ADMAIL}" ] && return 0
  if [ -n "${_h}" ]; then
    _v="$(ssh root@"${_h}" "if [ -e ${_XOCT_HOLD_FILE} ]; then head -n 1 ${_XOCT_HOLD_FILE} | tr -cd '[:print:]' | cut -c1-200; echo; echo HOLD-HAD; else echo HOLD-NONE; fi" 2> /dev/null)"
    case "${_v}" in
      *HOLD-HAD*) _v="$(printf '%s\n' "${_v}" | head -n 1)" ;;
      *) return 0 ;;
    esac
  else
    [ -e "${_XOCT_HOLD_FILE}" ] || return 0
    _v="$(_xoct_first_line "${_XOCT_HOLD_FILE}")"
  fi
  echo "ERROR: ${_h:-this box} holds its clients' mail for ${_v} (${_XOCT_HOLD_FILE}, put by a test run):"
  echo "ERROR: a real run (no admail=) would leave the moved client's mail held there. End the"
  echo "ERROR: test run first ('xoct go-live' after a canary; for a whole box 'xmass go-live' after"
  echo "ERROR: its cutover or on the mirror it built, 'xmass prep-target' without admail= before its"
  echo "ERROR: init), or remove the file by hand once no test run needs it"
  return 1
}
### The first Octopus pass after a move that would mail the account's
### upgrade notice sends none: the move carries the setup mail along, and the
### client has everything that notice says from the move itself. The
### account's one-pass marker, /data/conf/<account>_skip_upgrade_email.txt,
### root's, is put where the account is installed (create) and again where
### it is imported, when absent; that pass takes it away, and every later
### pass mails as the account's switch says. An account whose switch is NO
### gets none: no pass of it would send the notice, so the marker would stay
### and swallow the first notice after the switch is turned on, months later.
_xoct_upgrade_skip_file() {
  printf '/data/conf/%s_skip_upgrade_email.txt' "$1"
}
### The upgrade notice switch as the cnf $1 sets it, the way the Octopus pass
### reads it: NO only when the file says NO, otherwise YES (its default).
_xoct_upgrade_switch() {
  local _s
  _s="$(grep -a '^_SEND_UPGRADE_EMAIL=' "$1" 2> /dev/null | tail -n 1 | cut -d= -f2- | tr -d '"')"
  if [ "${_s}" = "NO" ]; then
    echo NO
  else
    echo YES
  fi
}
### Puts the marker of $1 on $2 (none: this box), naming the step $3.
_xoct_upgrade_skip_put() {
  local _a="$1" _h="$2" _f _sh _rc
  _f="$(_xoct_upgrade_skip_file "${_a}")"
  _sh="[ -e '${_f}' ] && exit 0; mkdir -p /data/conf && ( umask 022; printf '%s\n' 'xoct ${3} $(date -u '+%F %T') UTC' > '${_f}.tmp' ) && mv -f '${_f}.tmp' '${_f}'"
  if [ -n "${_h}" ]; then
    ssh root@"${_h}" "${_sh}" 2> /dev/null
    _rc=$?
  else
    bash -c "${_sh}" 2> /dev/null
    _rc=$?
  fi
  if [ "${_rc}" -ne 0 ]; then
    echo "ALRT: ${_f}${_h:+ on ${_h}} could not be put: the first Octopus pass there may mail ${_a}'s upgrade notice"
    return 1
  fi
  echo "INFO: ${_a}'s first Octopus pass${_h:+ on ${_h}} that would mail its upgrade notice sends none (${_f})"
  return 0
}
### Under admail= the account's upgrade notice is switched off where it is
### installed (_SEND_UPGRADE_EMAIL=NO, the operator's off-switch, in its cnf):
### the move brings the account's setup mail along, and the first Octopus pass
### there after it mails the notice to the account's own address. With $3 =
### record the same step puts the account's record there, which keeps it off
### (_xoct_admail_rec). $1 = the account there, $2 = the target (none: this
### box). Status 1 when the cnf is missing or cannot be rewritten.
_xoct_admail_upgrade_mail_off() {
  local _a="$1" _h="$2" _sh _rc _f
  _f="$(_xoct_admail_rec "${_a}")"
  _sh="_c=/root/.${_a}.octopus.cnf; [ -f \"\${_c}\" ] || exit 1; { grep -v '^_SEND_UPGRADE_EMAIL=' \"\${_c}\"; echo _SEND_UPGRADE_EMAIL=NO; } > \"\${_c}.admail\" && chmod 644 \"\${_c}.admail\" && mv -f \"\${_c}.admail\" \"\${_c}\""
  if [ "$3" = "record" ]; then
    _sh="${_sh} && mkdir -p /data/conf && ( umask 022; printf '%s\n' '${_XOCT_ADMAIL}' > '${_f}.tmp' ) && mv -f '${_f}.tmp' '${_f}'"
  fi
  if [ -n "${_h}" ]; then
    ssh root@"${_h}" "${_sh}" 2> /dev/null
    _rc=$?
  else
    bash -c "${_sh}" 2> /dev/null
    _rc=$?
  fi
  if [ "${_rc}" -ne 0 ]; then
    echo "ALRT: admail=: the upgrade notice of ${_a}${_h:+ on ${_h}} could not be switched off${3:+ and recorded}; its next Octopus pass there may mail the account's own address"
    return 1
  fi
  echo "INFO: admail=: the upgrade notice of ${_a}${_h:+ on ${_h}} is off (_SEND_UPGRADE_EMAIL=NO in /root/.${_a}.octopus.cnf)${3:+, kept off while ${_f} exists there}"
  return 0
}
### The tail of a sent notice's line: under admail= the account's own
### address was not mailed, and the migration log records the send as a
### test (testmail), which no later notice reads as what the client was told.
_xoct_mail_said() {
  [ -n "${_XOCT_ADMAIL}" ] && printf '%s' " (admail=; the account's own address was not mailed)"
  return 0
}
### Every sender sets _MAIL_SENT and only reports success when s-nail actually
### accepted the message: the mail log is the record of what the customer was
### told, and the old always-printed "sent OK" line meant a box without s-nail
### silently mailed nothing while the log claimed otherwise.
_send_notice_migration_complete() {
  _MAIL_SENT=NO
  _MAILX_TEST=$(s-nail -V 2>&1)
  if [[ "${_MAILX_TEST}" =~ "built for Linux" ]] && _xoct_mail_rcpt; then
  cat <<EOF | s-nail "${_MAIL_BCC[@]}" -s "IMPORTANT: Completed migration to ${_tgt} for ${_DOMAIN}" ${_MAIL_RCPT} && _MAIL_SENT=YES
Hello,

This is a notification to inform you that the migration of your Ægir hosting system has been successfully completed. Below are important details and instructions regarding the changes.

${_MIG_ADDR_BLOCK}

${_MIG_DNS_BLOCK}

${_MIG_COVERAGE_BLOCK}

---

Important Changes to Note:

1. New Ægir Control Panel URL
   Your Ægir Control Panel and SQL Adminer addresses follow the address change described above: replace the old server name with the new one in the addresses you use today.

2. Access Credentials
   All your access credentials remain the same: the Ægir Control Panel, SSH/SFTP and SQL passwords have been carried over to the new server.

3. SSH Key Transfer
   The main SSH account keys have been transferred.
   - SSH sub-accounts (Clients) are recreated automatically on the new server with their existing passwords and SSH keys.

4. Main SSH Account Directory
   The contents of your main SSH account’s home directory have NOT been migrated. Please download any necessary files from the old server.

5. Ægir Backend Key Update
   The public SSH key (USER.id_ed25519.pub) for the Ægir backend has changed. This is important if you use integration with a remote Git repository.

6. SSL Certificates
   SSL/Let’s Encrypt certificates have been migrated automatically, and renewals are handled on the new system.

7. Paused Cron Tasks
   All scheduled tasks were paused during migration and will resume within 1-3 hours.

8. Old Ægir Control Panel
   The old control panel has been disabled to secure proxy configurations.

---

Thank you for your cooperation during this migration. If you have any questions or need assistance, please feel free to reach out.

Kind regards,
The BOA Dev Team

EOF
  fi
  if [ "${_MAIL_SENT}" = "YES" ]; then
    echo "INFO: Migration complete notice sent to ${_MAIL_RCPT} [${_THIS_HM_USER}]: OK$(_xoct_mail_said)"
  else
    echo "ALRT: Migration complete notice NOT sent for ${_THIS_HM_USER} (no plain address, s-nail unavailable or send failed)"
  fi
}

_send_notice_migration_start() {
  _MAIL_SENT=NO
  _MAILX_TEST=$(s-nail -V 2>&1)
  if [[ "${_MAILX_TEST}" =~ "built for Linux" ]] && _xoct_mail_rcpt; then
  cat <<EOF | s-nail "${_MAIL_BCC[@]}" -s "STATUS: Running migration to ${_tgt} for ${_DOMAIN}" ${_MAIL_RCPT} && _MAIL_SENT=YES
Hello,

This notification is to inform you that the migration of your Ægir hosting system to the new platform has started.

YOUR NEW SYSTEM IP ADDRESS IS: [${_tgt}]

You will receive another message once the migration is complete, with the updated addresses and everything else you need to know.

Please do not run any tasks in your old Ægir Control Panel during this migration, as it may interfere with special proxy configurations set up to ensure service continuity.

${_MIG_DNS_BLOCK}

${_MIG_COVERAGE_BLOCK}

---

Important Changes to Note:

1. New Ægir Control Panel URL
   Your Ægir Control Panel and SQL Adminer addresses will follow the address change: replace the old server name with the new one in the addresses you use today.

2. Access Credentials
   All your access credentials will remain the same: the Ægir Control Panel, SSH/SFTP and SQL passwords are carried over to the new server.

3. SSH Key Transfer
   The main SSH account keys will be transferred.
   - SSH sub-accounts (Clients) will be recreated automatically on the new server with their existing passwords and SSH keys.

4. Main SSH Account Directory
   The contents of your main SSH account’s home directory will NOT be migrated. Please download any necessary files from the old server.

5. Ægir Backend Key Update
   The public SSH key (USER.id_ed25519.pub) for the Ægir backend will change. This is important if you use integration with a remote Git repository.

6. SSL Certificates
   SSL/Let’s Encrypt certificates will be migrated automatically, and renewals will be handled on the new system.

7. Paused Cron Tasks
   All scheduled tasks will be paused during migration and for an additional 1-3 hours afterward.

8. Old Ægir Control Panel
   The old control panel will be disabled to secure proxy configurations.

---

Thank you for your cooperation during this migration. If you have any questions or need assistance, please feel free to reach out.

Kind regards,
The BOA Dev Team

EOF
  fi
  if [ "${_MAIL_SENT}" = "YES" ]; then
    echo "INFO: Migration start notice sent to ${_MAIL_RCPT} [${_THIS_HM_USER}]: OK$(_xoct_mail_said)"
  else
    echo "ALRT: Migration start notice NOT sent for ${_THIS_HM_USER} (no plain address, s-nail unavailable or send failed)"
  fi
}

### Short follow-up when the forwarding arrangement itself changed; everything
### else from the completion notice still stands, so none of it is repeated.
_send_notice_migration_change() {
  _MAIL_SENT=NO
  _MAILX_TEST=$(s-nail -V 2>&1)
  if [[ "${_MAILX_TEST}" =~ "built for Linux" ]] && _xoct_mail_rcpt; then
  cat <<EOF | s-nail "${_MAIL_BCC[@]}" -s "IMPORTANT: Update to the forwarding arrangement for ${_DOMAIN}" ${_MAIL_RCPT} && _MAIL_SENT=YES
Hello,

This is a short follow-up to the migration message you received earlier. The forwarding arrangement for your old address has changed.

${_MIG_DNS_BLOCK}

${_MIG_COVERAGE_BLOCK}

${_MIG_ADDR_BLOCK}

Nothing else from the earlier message has changed, and no action is needed on the new system.

Kind regards,
The BOA Dev Team

EOF
  fi
  if [ "${_MAIL_SENT}" = "YES" ]; then
    echo "INFO: Forwarding change notice sent to ${_MAIL_RCPT} [${_THIS_HM_USER}]: OK$(_xoct_mail_said)"
  else
    echo "ALRT: Forwarding change notice NOT sent for ${_THIS_HM_USER} (no plain address, s-nail unavailable or send failed)"
  fi
}

### Withdrawal notice. With a date it announces the cut-off; without one it
### states the withdrawal as done -- the tool never switches forwarding off
### unattended, so the operator sends this at (or just before) the real act.
_send_notice_migration_retire() {
  _MAIL_SENT=NO
  local _pd="" _para1 _para2
  [ -n "${_MIG_RETIRE_DATE}" ] && _pd="$(_mig_pretty_date "${_MIG_RETIRE_DATE}")"
  if [ -n "${_pd}" ]; then
    _para1="The forwarding on your old address, which has been carrying traffic for the sites that were on it at the time of your migration, is being withdrawn on ${_pd}."
    _para2="Please make sure that every one of your domains points at the new address below before that date. After it, any domain still pointing at the old address will stop reaching your site."
  else
    _para1="The forwarding on your old address, which has been carrying traffic for the sites that were on it at the time of your migration, has now been withdrawn."
    _para2="From now on every domain must resolve to the new address below. If any of your domains still point at the old address, please update them now."
  fi
  _MAILX_TEST=$(s-nail -V 2>&1)
  if [[ "${_MAILX_TEST}" =~ "built for Linux" ]] && _xoct_mail_rcpt; then
  cat <<EOF | s-nail "${_MAIL_BCC[@]}" -s "NOTICE: forwarding from your old address is being withdrawn for ${_DOMAIN}" ${_MAIL_RCPT} && _MAIL_SENT=YES
Hello,

${_para1}

${_para2}

${_MIG_ADDR_BLOCK}

Nothing else about your account changes, and no data is affected.

Kind regards,
The BOA Dev Team

EOF
  fi
  if [ "${_MAIL_SENT}" = "YES" ]; then
    echo "INFO: Retirement notice sent to ${_MAIL_RCPT} [${_THIS_HM_USER}]: OK$(_xoct_mail_said)"
  else
    echo "ALRT: Retirement notice NOT sent for ${_THIS_HM_USER} (no plain address, s-nail unavailable or send failed)"
  fi
}

### The immutable flag set ($1 +) or cleared ($1 -) on the names $2 ... of
### the current (pinned) directory, each through one handle opened
### O_NOFOLLOW|O_NONBLOCK (FS_IOC_GETFLAGS/FS_IOC_SETFLAGS, the amd64/arm64
### numbers): only a directory, or a regular file with one link, is changed,
### so a link the account put at a name is never followed (chattr with a
### trailing slash follows one) and a hard link to another file is never
### locked or unlocked. Status 1 when any name was refused.
_XOCT_CHATTR_PL='use Fcntl; my ($op, @f) = @ARGV; my $rc = 0; for my $f (@f) { sysopen(my $h, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or do { $rc = 1; next }; my @s = stat($h); if (@s && (-d _ || (-f _ && $s[3] == 1))) { my $b = pack("L", 0); if (ioctl($h, 0x80086601, $b)) { my $fl = unpack("L", $b); $fl = $op eq "+" ? ($fl | 0x10) : ($fl & ~0x10); ioctl($h, 0x40086602, pack("L", $fl)) or $rc = 1; } else { $rc = 1 } } else { $rc = 1 } close($h); } exit $rc'
_xoct_chattr_here() {
  local _op="${1}"
  shift
  perl -e "${_XOCT_CHATTR_PL}" -- "${_op}" "$@" 2> /dev/null
}
### The same on the current (pinned) directory and every entry in it.
_xoct_chattr_all_here() {
  perl -e "${_XOCT_CHATTR_PL}" -- "${1}" . ./* 2> /dev/null
}

_enable_chattr() {
  _isTest="$1"
  _isTest=${_isTest//[^a-z0-9]/}
  if [ ! -z "${_isTest}" ] && [ -d "/home/$1/" ]; then
    # each directory entered as the real one (every name below /home a real
    # directory), the flag changed on "." there
    if [ "$1" != "${_THIS_HM_USER}.ftp" ]; then
      _xoct_in_real_dir "/home/$1" _xoct_chattr_here + .
    else
      _xoct_in_real_dir "/home/$1/platforms" _xoct_chattr_all_here +
    fi
    _xoct_in_real_dir "/home/$1/.drush" _xoct_chattr_here + .
    _xoct_in_real_dir "/home/$1/.drush/usr" _xoct_chattr_here + .
    _xoct_in_real_dir "/home/$1/.bazaar" _xoct_chattr_here + .
  fi
}

# The .ftp home is locked again when the run that unlocked it ends, on every
# exit the shell can trap: a refused or failed verb must not leave it
# unlocked until the next worker pass, which stays parked during a move.
_XOCT_CHATTR_OFF=""
_xoct_chattr_back() {
  [ "${_XOCT_CHATTR_OFF}" = "YES" ] || return 0
  _XOCT_CHATTR_OFF=""
  _enable_chattr "${_THIS_HM_USER}.ftp" &> /dev/null
  return 0
}

_disable_chattr() {
  _isTest="$1"
  _isTest=${_isTest//[^a-z0-9]/}
  if [ ! -z "${_isTest}" ] && [ -d "/home/$1/" ]; then
    # each directory entered as the real one (every name below /home a real
    # directory), the flag changed on "." there
    if [ "$1" != "${_THIS_HM_USER}.ftp" ]; then
      _xoct_in_real_dir "/home/$1" _xoct_chattr_here - .
    else
      _xoct_in_real_dir "/home/$1/platforms" _xoct_chattr_all_here -
    fi
    _xoct_in_real_dir "/home/$1/.drush" _xoct_chattr_here - .
    _xoct_in_real_dir "/home/$1/.drush/usr" _xoct_chattr_here - .
    # a CLI php.ini an earlier release left, for the ltd worker to remove
    _xoct_in_real_dir "/home/$1/.drush" _xoct_chattr_here - ./php.ini
    _xoct_in_real_dir "/home/$1/.bazaar" _xoct_chattr_here - .
  fi
}

### The --runner-wait option of a forced verify in an import's verify stage:
### what is left of one budget for the whole stage, set where the panel's
### hosting knows the option; nothing once 30 s or less is left, or without
### the option (hosting's own 30 s default applies then).
_xoct_runner_wait_opt() {
  local _w
  [ -n "${_XOCT_RUNNER_UNTIL}" ] || return 0
  _w=$(( _XOCT_RUNNER_UNTIL - $(date +%s) ))
  [ "${_w}" -gt 30 ] || return 0
  printf ' --runner-wait=%s' "${_w}"
}

_run_drush8_hmr_cmd() {
  su -s /bin/bash - ${_THIS_HM_USER} -c "drush8 @hostmaster $1"
  wait
}

_run_drush8_nosilent_cmd() {
  su -s /bin/bash - ${_THIS_HM_USER} -c "drush8 @${_Dom} $1"
  wait
}

_xoct_flush_caches_target() {
  # A migrated-in site can carry the source box's stale D8+ service container /
  # opcode caches. Rather than fragile per-site drush rebuilds (which fatal on
  # the D8+ Symfony/Drush patch state outside provision's context), flush HARD
  # at the infrastructure level -- the only treatment trusted against cache/
  # container poisoning: cold-restart Valkey (or Redis) to drop the object
  # cache, and restart every PHP-FPM master to drop opcache/APCu. Correct
  # per-site PHP version is preserved separately (multi-fpm.info).
  echo "INFO: cold cache flush on target (Valkey/Redis drop + PHP-FPM restart)"
  if [ -x "/etc/init.d/valkey-server" ]; then
    killall -9 valkey-server &> /dev/null
    rm -f /var/lib/valkey/* &> /dev/null
    service valkey-server start &> /dev/null
  elif [ -x "/etc/init.d/redis-server" ]; then
    killall -9 redis-server &> /dev/null
    rm -f /var/lib/redis/* &> /dev/null
    service redis-server start &> /dev/null
  fi
  local _f
  for _f in /etc/init.d/php*-fpm; do
    [ -x "${_f}" ] && service "$(basename "${_f}")" restart &> /dev/null
  done
}

_xoct_revert_converted_vhosts() {
  ### Put every vhost this run converted back to the state it was in before,
  ### which is BOTH halves: the :80 vhost from its dot-backup and the site's
  ### real :443 block, saved as .https.<dom> when the proxy template landed on
  ### top of it. Deleting https.<dom> alone is not a revert -- pre-conversion
  ### those sites were serving TLS, and the message that followed said the
  ### config was valid again, which was true for nginx and untrue for the
  ### customer. Its own function so a fixture can prove the pairing.
  local _vhd="$1"
  local _doms="$2"
  local _rvd
  for _rvd in ${_doms}; do
    [ -f "${_vhd}/.${_rvd}" ] || continue
    rm -f "${_vhd}/https.${_rvd}"
    if [ -f "${_vhd}/.https.${_rvd}" ]; then
      mv -f "${_vhd}/.https.${_rvd}" "${_vhd}/https.${_rvd}"
    fi
    mv -f "${_vhd}/.${_rvd}" "${_vhd}/${_rvd}"
  done
  return 0
}

### The rule renameaegirhost applies on the new box: a site whose name carries
### the old box hostname is renamed by replacing that hostname. Deferral and
### the renamed-site redirect both key on it, so the three never disagree.
_xoct_named_under_host() {
  [ -n "$2" ] && [ "$1" != "${1//$2/}" ]
}

### The renamed-site 301 needs both hostnames, and a whole-server move hands
### them over only in the environment (_XOCT_TARGET_FQDN, _XOCT_MY_FQDN);
### there is no flag. A later run without them -- a hand --repair, the
### --repair --retarget that follows a failover, a --renotify resend, or the
### --repair that is to convert the sites a --defer-host-named pass held --
### rendered those sites as plain proxies of their old names, which the
### renamed target never serves: its catch-all for every visitor. So when
### the caller named no hostnames and this account either answers a renamed
### site with a 301 already or still holds sites on the per-host gate, read
### them here: this box's own name, by the same lookup xmass uses, and the
### target's as it answers now, so a retarget points the redirects at the
### new box. The gate file only says that the account needs this; its
### content is the tenant's to write and is never used as a name. Called
### from the preflight once its own refusals have passed; a target whose
### name cannot be read refuses the run before anything is written.
_xoct_valid_host() {
  case "$1" in
    ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*) return 1 ;;
  esac
  return 0
}
_xoct_keep_renamed_redirects() {
  local _vd="${_USR}/config/server_master/nginx/vhost.d"
  local _hg="${_USR}/static/control/http-off-host.pid"
  local _why="" _tf _mf _n _trc=0
  ### Both names are written into nginx vhosts and sed replacements: one a
  ### caller hands over must be a hostname too, never merely non-empty.
  for _n in "${_XOCT_TARGET_FQDN}" "${_XOCT_MY_FQDN}"; do
    if [ -n "${_n}" ] && ! _xoct_valid_host "${_n}"; then
      echo "ERROR: ${_oct}: '${_n}' (from _XOCT_TARGET_FQDN/_XOCT_MY_FQDN) is not a hostname"
      exit 1
    fi
  done
  [ -n "${_XOCT_TARGET_FQDN}" ] && [ -n "${_XOCT_MY_FQDN}" ] && return 0
  [ -n "${_XOCT_DEFER_FQDN}" ] && return 0
  if [ -s "${_hg}" ] && [ ! -L "${_hg}" ]; then
    _why="it still holds sites on the per-host gate"
  elif grep -q -s -F "renamed site: redirect to its new name" "${_vd}"/* 2>/dev/null; then
    _why="it answers renamed sites with a 301"
  else
    return 0
  fi
  _mf="${_XOCT_MY_FQDN}"
  if [ -z "${_mf}" ]; then
    _mf=$(grep "remote_host" /var/aegir/.drush/server_master.alias.drushrc.php 2>/dev/null \
      | head -1 | sed "s/.*remote_host.*=>//; s/[' ,;]//g")
    _xoct_valid_host "${_mf}" || _mf=$(hostname -f 2>/dev/null | tr -d '\n')
    _xoct_valid_host "${_mf}" || _mf=""
  fi
  _tf="${_XOCT_TARGET_FQDN}"
  if [ -z "${_tf}" ]; then
    _xoct_learn_peer_host_key "${_tgt}"
    _tf=$(ssh -o ConnectTimeout=10 -o BatchMode=yes root@"${_tgt}" "hostname -f" 2>/dev/null)
    _trc=$?
    _tf=$(printf '%s\n' "${_tf}" | tail -n 1 | tr -d '\r')
    _xoct_valid_host "${_tf}" || _tf=""
  fi
  if [ -z "${_tf}" ] && [ "${_trc}" -ne 0 ]; then
    echo "ERROR: ${_oct}: ${_why}, and ${_tgt} does not let this box in to read its"
    echo "ERROR: hostname (ssh rc=${_trc}); the renamed sites' 301 needs it."
    _xoct_peer_trust_remedy "${_tgt}"
    exit 1
  fi
  if [ -z "${_tf}" ] || [ -z "${_mf}" ]; then
    echo "ERROR: ${_oct}: ${_why}, and the hostnames that keep its renamed sites"
    echo "ERROR: answering a 301 could not be read (target '${_tf}', this box '${_mf}')."
    echo "ERROR: Re-run the command exactly as typed, with both set in front of it:"
    echo "ERROR:   _XOCT_TARGET_FQDN=<hostname -f of ${_tgt}> _XOCT_MY_FQDN=<this box's hostname> xoct proxy ...${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
    exit 1
  fi
  _XOCT_TARGET_FQDN="${_tf}"
  _XOCT_MY_FQDN="${_mf}"
  echo "INFO: ${_oct}: ${_why}; its sites named under ${_XOCT_MY_FQDN} answer a 301 to the same name under ${_XOCT_TARGET_FQDN}"
}

### The prefix a printed re-run needs to keep those redirects; empty when
### this run had no hostnames to hand on.
_xoct_repair_env() {
  [ -n "${_XOCT_TARGET_FQDN}" ] && [ -n "${_XOCT_MY_FQDN}" ] \
    && printf '_XOCT_TARGET_FQDN=%s _XOCT_MY_FQDN=%s ' "${_XOCT_TARGET_FQDN}" "${_XOCT_MY_FQDN}"
  return 0
}

### Can the per-host gate (static/control/http-off-host.pid) hold this site
### on 503 while it stays local? A Grav or Textpattern vhost named under the
### box hostname carries its own test of the file. Drupal and Backdrop reach
### it through the global settings chain -- and the DEPLOYED include must
### carry the per-host block: it arrives with a system upgrade, this tool by
### its own channel, so either can be ahead of the other. A site the gate
### cannot hold is never deferred: left local and ungated it would keep
### taking writes into a database that has already moved.
_xoct_site_host_gateable() {
  local _usr="$1"
  local _dom="$2"
  local _vht="$3"
  local _sp
  ### The vhost and the settings.php are read inside their real directories
  ### with the bounded no-follow reader (config/ and the platform sites dir are
  ### oN's): a FIFO the account put at either name never blocks the operator
  ### run, and a link is never followed. site_path is confined to the account.
  ### A site whose platform path itself carries a link reads as empty here and
  ### is treated as not gateable -- it is then converted now, not deferred,
  ### which is the fail-safe direction (an ungated site never keeps taking
  ### writes into a database that has moved).
  _xoct_read_in "${_vht%/*}" "${_vht##*/}" | grep -q "http-off-host.pid" && return 0
  grep -q "http-off-host.pid" /data/conf/global/global-mode.inc 2>/dev/null || return 1
  ### The global chain matches the site's own name, as nginx hands it over.
  _xoct_read_in "${_vht%/*}" "${_vht##*/}" | grep -q "MAIN_SITE_NAME" || return 1
  _sp=$(_xoct_read_in "${_usr}/.drush" "${_dom}.alias.drushrc.php" \
    | grep "site_path'" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g")
  case "${_sp}/" in
    "${_usr}"/*) ;;
    *) return 1 ;;
  esac
  [ -n "${_sp}" ] && _xoct_read_in "${_sp}" settings.php | grep -q "global.inc"
}

### static/control is the account's main login's (and oN owns the rest of
### /data/disk/oN): it can put a link or a FIFO at any name there, or at
### control itself. Root reads and writes those names only through these,
### the ltd worker's rule. Run "$@" inside the real directory $1: below
### /data/disk and /home every name on the path must be a real directory;
### once entered, ./name stays there whatever is swapped.
_xoct_in_real_dir() {
  local _d="${1}" _want
  shift
  _want="$(_xoct_real_want "${_d}")"
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_want}" ] && "$@" )
}
### ./$1 in the current (pinned) directory: never through a link, never
### blocked on a FIFO, at most 1 MiB; empty for anything else.
_xoct_read_here() {
  timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock \
    bs=1048576 count=1 status=none 2> /dev/null
}
### The words of $1 that are host names (letters, digits, dots, dashes, a
### leading wildcard), space-separated; anything else is dropped. The words
### are split without file name expansion, so a wildcard name stays as is.
_xoct_host_words() {
  local _w _o=""
  local -a _ws
  IFS=$' \t\n' read -r -d '' -a _ws <<< "${1}"
  for _w in "${_ws[@]}"; do
    [[ "${_w}" =~ ^[A-Za-z0-9*][A-Za-z0-9.*-]*$ ]] || continue
    [ "${#_w}" -le 253 ] || continue
    _o="${_o} ${_w}"
  done
  printf '%s' "${_o# }"
}
### $2 in the real directory $1, read as _xoct_read_here reads it.
_xoct_read_in() {
  _xoct_in_real_dir "${1}" _xoct_read_here "${2}"
}
### The numeric uid and gid of owner:group $1 as "uid gid"; status 1, and
### nothing, when either does not resolve.
_xoct_owner_ids() {
  local _u _g
  _u="$(id -u -- "${1%%:*}" 2> /dev/null)"
  _g="$(getent group "${1#*:}" 2> /dev/null | cut -d: -f3)"
  [[ "${_u}" =~ ^[0-9]+$ ]] && [[ "${_g}" =~ ^[0-9]+$ ]] || return 1
  printf '%s %s\n' "${_u}" "${_g}"
}
### Shell text the target expands to the uid the login $1.ftp of this box
### lands on there when a copy maps owners by name: the target's uid for the
### name, else this box's uid. Only the login's: the files re-asserted with
### it (the PHP pins, the password store) are the login's own. Empty when it
### has no uid here.
_xoct_landed_uids_sh() {
  local _n="${1}.ftp" _i
  [[ "${1}" =~ ^[A-Za-z0-9._-]+$ ]] || return 0
  _i="$(id -u -- "${_n}" 2> /dev/null)"
  [[ "${_i}" =~ ^[0-9]+$ ]] || return 0
  printf '%s' "\$(id -u -- ${_n} 2> /dev/null || echo ${_i})"
}
### The file ./$1 (never there before) created with the bytes read from
### stdin, the owner $2:$3 (numeric; -1 keeps root's) and the read/write bits
### of the mode $4, all through the one handle that created it, opened
### O_EXCL|O_NOFOLLOW: nothing is ever chowned or chmodded by name in a
### directory the account can write (a hard link renamed over the name before
### a chown by name would hand another file to that owner).
_XOCT_PUT_PL='use Fcntl; my ($n, $u, $g, $m) = @ARGV; local $/; my $d = <STDIN>; sysopen(my $h, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; (print {$h} $d) or exit 1; chown($u, $g, $h) or exit 1; chmod(oct($m) & 0666, $h) or exit 1; close($h) or exit 1; exit 0'
### The owner $1:$2 (numeric; -1 leaves it) and the mode $3 (none when
### empty) re-asserted on each existing name ./$5 ... through one handle
### opened O_NOFOLLOW|O_NONBLOCK, and only when that handle is a regular file
### with one link whose owner is already $1 or one of the uids in the
### comma-separated $4: a link, a FIFO, a hard link to another file, or a
### file of some other identity (root's included: a root-only file renamed
### onto the name is never handed over) is left as it is, never handed to
### the account or chmodded. What root puts for the account is created with
### its final owner instead. No single quote in the text: it also travels
### inside the commands run on the target.
_XOCT_REASSERT_PL='use Fcntl; my ($u, $g, $m, $x, @f) = @ARGV; my %ok = map { $_ => 1 } ($u, split(/,/, $x)); for my $f (@f) { sysopen(my $h, $f, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or next; my @s = stat($h); if (@s && -f _ && $s[3] == 1 && $ok{$s[4]}) { chown($u, $g, $h) if $u >= 0; chmod(oct($m), $h) if length $m; } close($h); } exit 0'
### What the uid $1 owns in the current directory and below it, the
### directory itself included, handed to the uid $2 (the group kept), in one
### walk ($3 names the directory in its notices). Each entry is judged
### through one handle opened O_NOFOLLOW|O_NONBLOCK: only a directory, or a
### regular file with one link, whose handle still carries the uid $1 is
### changed, so a hard link to another file renamed over a name while the
### walk runs is never handed over; links, FIFOs and sockets are never
### opened. Every directory is entered by the walk itself through a
### no-follow handle, and only when the device and inode of the directory
### entered equal what lstat saw of the name: a directory swapped for a link
### or for another directory during the walk is refused, never followed.
### The walk returns through a handle on the parent, and stops when it
### cannot. No single quote in the text: the rename pass on the target
### carries it.
_XOCT_REOWN_PL='use Fcntl qw(:DEFAULT :mode); my ($f, $u, $r) = @ARGV; my $fl = O_RDONLY|O_NOFOLLOW|O_NONBLOCK; my %on; sub own { my ($n) = @_; sysopen(my $h, $n, $fl) or return; my @s = stat($h); chown($u, -1, $h) if @s && $s[4] == $f && (-d _ || (-f _ && $s[3] == 1)); close($h); } sub why { ($!{EMFILE} || $!{ENFILE}) ? ": too many directories open at once" : "" } sub walk { my ($p) = @_; my $here; sysopen($here, ".", $fl) or do { print "ALRT: $p not walked by the owner remap" . why() . "\n"; return }; my @h = stat($here); return if !@h || $on{"$h[0]:$h[1]"}; opendir(my $d, ".") or do { print "ALRT: $p not read by the owner remap" . why() . "\n"; return }; my @e = grep { $_ ne "." && $_ ne ".." } readdir($d); closedir($d); $on{"$h[0]:$h[1]"} = 1; for my $n (@e) { my @l = lstat($n) or next; my $dir = S_ISDIR($l[2]); own($n) if $l[4] == $f && ($dir || S_ISREG($l[2])); next unless $dir; my ($c, @w, $o); $o = sysopen($c, $n, $fl); if (!$o && why()) { print "ALRT: $p/$n not entered by the owner remap" . why() . "\n"; } elsif ($o && chdir($c) && (@w = stat(".")) && $w[0] == $l[0] && $w[1] == $l[1]) { close($c); walk("$p/$n"); } else { print "ALRT: $p/$n changed during the owner remap -- not entered\n"; } chdir($here) or do { print "ALRT: owner remap stopped in $p/$n: its parent cannot be entered again\n"; exit 1 }; } delete $on{"$h[0]:$h[1]"}; } own("."); walk($r); exit 0'
### ./$1 in the current (pinned) directory with the content $2 (0644), owned
### by $3 (owner:group; root's when empty or when it does not resolve): a
### fresh file put through _XOCT_PUT_PL, then renamed over the name, so a
### link or FIFO put there is replaced, never followed, and a reader (the 503
### gate) never finds the name missing.
_xoct_put_here() {
  local _t="./.${1}.put.$$.${RANDOM}" _ids="-1 -1"
  if [ -n "${3}" ]; then
    _ids="$(_xoct_owner_ids "${3}")" || _ids="-1 -1"
  fi
  rm -f -- "${_t}"
  if printf '%s\n' "${2}" \
    | perl -e "${_XOCT_PUT_PL}" "${_t}" "${_ids% *}" "${_ids#* }" 644 \
    && mv -f -T -- "${_t}" "./${1}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
### The 503 gate $1 (http-off.pid) with the TTL $2, created in the current
### (pinned) control directory when it is not a regular file there, owned by
### $3 (owner:group) from the start. True only when this call created it.
_xoct_gate_put_here() {
  [ -f "./${1}" ] && [ ! -L "./${1}" ] && return 1
  _xoct_put_here "${1}" "${2}" "${3}"
}
### ./$1 in the current (pinned) directory with exactly the bytes read from
### stdin, the mode the umask $2 leaves of 0666 (022 gives 0644, 077 0600),
### owned by $3 (owner:group; root's when empty or when it does not
### resolve) from the start, put as _xoct_put_here puts it.
_xoct_write_here() {
  local _t="./.${1}.put.$$.${RANDOM}" _ids="-1 -1" _m
  [[ "${2}" =~ ^[0-7]{3}$ ]] || return 1
  _m="$(printf '%o' $(( 0666 & ~0${2} )))"
  if [ -n "${3}" ]; then
    _ids="$(_xoct_owner_ids "${3}")" || _ids="-1 -1"
  fi
  rm -f -- "${_t}"
  if perl -e "${_XOCT_PUT_PL}" "${_t}" "${_ids% *}" "${_ids#* }" "${_m}" \
    && mv -f -T -- "${_t}" "./${1}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
### ./$1 in the current (pinned) directory as an empty marker (0644), put
### the same way: a link put at the name is replaced, never created through.
_xoct_touch_here() {
  _xoct_write_here "${1}" 022 < /dev/null
}
### ./control made a real directory, run inside the real static/: a link put
### at the name is removed, a missing directory created 0755.
_xoct_ctrl_dir_here() {
  [ -L ./control ] && rm -f ./control
  [ -d ./control ] || ( umask 022; mkdir -p ./control )
}
### ./$1 made a real directory in the current (pinned) parent: a link the
### account put at the name is removed, a missing directory created.
_xoct_realdir_here() {
  [ -L "./${1}" ] && rm -f -- "./${1}"
  [ -d "./${1}" ] || mkdir -p -- "./${1}"
}
### The whole regular file ./$1 of the current (pinned) directory streamed to
### stdout without following a link (unbounded, for a DB dump that may exceed
### the bounded reader): a link put at the name yields nothing, a FIFO never
### blocks past the read.
_xoct_cat_here() {
  dd if="./${1}" iflag=nofollow,nonblock status=none 2> /dev/null
}
### The hostmaster dump the command "$@" writes on stdout, captured into the
### current (pinned) src/ directory as a fresh exclusive file renamed over
### ./prev_hostmaster.sql: the command's exit code survives the pipe, a link
### the account put at the name is replaced (never written through), and a
### zero-byte result is refused so a re-run redumps.
_xoct_dump_hm_here() {
  local _t="./.prev_hostmaster.sql.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    umask 077
    "$@" | dd of="${_t}" conv=excl status=none 2> /dev/null ) \
    && [ -s "${_t}" ]; then
    mv -f -T -- "${_t}" ./prev_hostmaster.sql && return 0
  fi
  rm -f -- "${_t}"
  return 1
}
### The hostmaster dump never carries the dumping server's GTID state. By
### default (--set-gtid-purged=AUTO) a dump taken while GTID is on (every
### box an xmass run touched: BOA's my.cnf leaves it off, xmass_gtid.cnf
### turns it on) opens with SET @@SESSION.SQL_LOG_BIN=0 and sets
### @@GLOBAL.GTID_PURGED. Its import then fails on a box that shares that
### history (a move back, a failback, a chained move: ERROR 3546 on 8.x),
### and where it passes it stays out of that box's binary log, so a replica
### of the box never gets the panel. OFF writes neither. Sets _MYSQLDUMP_GTID
### to the option when the local mysqldump takes it: one that does not
### (MariaDB's) would refuse it and writes neither anyway, so it is asked,
### never assumed.
_mysqldump_gtid_opts() {
  _MYSQLDUMP_GTID=()
  if mysqldump --help 2> /dev/null | grep -q -- '--set-gtid-purged'; then
    _MYSQLDUMP_GTID=(--set-gtid-purged=OFF)
  fi
  return 0
}
### A site's database load is written to the binary log. myloader opens
### every session with SET SQL_LOG_BIN=0 unless told otherwise, so on a box
### running with the binary log on (every box an xmass run touched: BOA's
### my.cnf leaves it off, xmass_gtid.cnf turns it on) the load never
### reached a replica of the box, whose applier then stopped at the first
### replicated write to the tables it never got. --ignore-set=SQL_LOG_BIN
### drops that one session variable wherever it comes from (myloader's own
### default, or the packaged /etc/mydumper.cnf for a call without an option
### file); --enable-binlog is no substitute: that file sets it again, and
### the 0.19.3 line refuses the option. With the binary log off it changes
### nothing. Sets _MYLOADER_BINLOG to the option when the local myloader
### lists it, so a build without it gets its arguments as before.
_myloader_binlog_opts() {
  _MYLOADER_BINLOG=()
  if myloader --help 2>&1 | grep -qE -- '^[[:space:]]+--ignore-set([[:space:]]|=)'; then
    _MYLOADER_BINLOG=(--ignore-set=SQL_LOG_BIN)
  fi
  return 0
}
### A site's triggers, stored routines and events travel with its tables.
### mydumper writes none of them unless asked, so a site that kept them (a
### logging trigger, a function its queries call, a scheduled event) lost
### them on every move. Each keeps its DEFINER, the site's own database
### user: the import loads as root, and the target has that user under the
### same name before the load, so they run there with the site's rights, as
### here. Sets _MYDUMPER_OBJECTS to those of the three options the local
### mydumper lists, so a build without one gets its arguments as before.
_mydumper_objects_opts() {
  local _h _o
  _MYDUMPER_OBJECTS=()
  _h=$(mydumper --help 2>&1)
  for _o in --triggers --routines --events; do
    if printf '%s\n' "${_h}" | grep -qE -- "^[[:space:]]+(-[[:alpha:]],[[:space:]]+)?${_o}([[:space:]]|=|$)"; then
      _MYDUMPER_OBJECTS+=("${_o}")
    fi
  done
  return 0
}
### The regular file ./$1 of the current (pinned) directory copied, forced
### (no -u), to the same name in the real directory $3 on the target $2, $4
### the caller's rsync error option. A link is never carried and neither end
### resolves a name on its path through a link the account put there. Nothing
### travels when ./$1 is not a regular file.
_xoct_put_file_remote_here() {
  [ -f "./${1}" ] && [ ! -L "./${1}" ] || return 0
  _xoct_rsync -aEAX --no-links ${4} \
    --rsync-path="$(_xoct_rsync_path_in "${3}")" -e ssh \
    "./${1}" "root@${2}:./${1}"
}
### The entries of the current (pinned) directory the glob $3 names (empty:
### the directory's contents), expanded here, copied with the rsync options
### that follow into the real directory $2 on the target $1: neither end
### resolves a name on its path through a link the account put there.
_xoct_copy_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xoct_rsync "$@" --rsync-path="$(_xoct_rsync_path_in "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}

### The same rule on the target box: the commands $3 run there inside the
### real directory $2 (below /data/disk or /home every name on the path a
### real directory) of the target $1, where _rr reads a name as
### _xoct_read_here does, _rp puts one as _xoct_put_here does (empty when no
### content is given; $3 the owner:group it is created with, root's when
### empty) and _ro re-asserts owner:group $1 and mode $2 on names as
### _xoct_reassert_here does ($3 the further uids the names may carry).
### The target account is the tenant's as soon as its identity has
### travelled. Both perl texts are spliced in unquoted here, so each lands
### on the target inside single quotes.
_XOCT_REMOTE_CTRL_FN='_rr() { timeout 10 dd if="./${1}" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2> /dev/null; }
_rid() { local _u _g; _u="$(id -u -- "${1%%:*}" 2> /dev/null)"; _g="$(getent group "${1#*:}" 2> /dev/null | cut -d: -f3)"; case "${_u}:${_g}" in :*|*:|*[!0-9:]*) _u=-1; _g=-1 ;; esac; printf "%s %s\n" "${_u}" "${_g}"; }
_rp() { local _t="./.${1}.put.$$.${RANDOM}" _i="-1 -1"; [ -n "${3}" ] && _i="$(_rid "${3}")"; rm -f -- "${_t}"; if { [ -n "${2}" ] && printf "%s\n" "${2}"; true; } | perl -e '"'${_XOCT_PUT_PL}'"' "${_t}" "${_i% *}" "${_i#* }" 644 && mv -f -T -- "${_t}" "./${1}"; then return 0; fi; rm -f -- "${_t}"; return 1; }
_ro() { local _i; _i="$(_rid "${1}")"; shift; perl -e '"'${_XOCT_REASSERT_PL}'"' -- "${_i% *}" "${_i#* }" "$@" 2> /dev/null; }'
_xoct_remote_in() {
  local _a=/data/disk
  case "${2}" in /home/?*) _a=/home ;; esac
  ssh root@"${1}" "${_XOCT_REMOTE_CTRL_FN}
_w=\"\$(cd -P ${_a} 2> /dev/null && pwd -P)${2#"${_a}"}\"
cd -P -- \"${2}\" 2> /dev/null && [ \"\$(pwd -P)\" = \"\${_w}\" ] && { ${3}; }"
}
### The commands $3 inside the real static/control of the account $2 there.
_xoct_remote_ctrl() {
  _xoct_remote_in "${1}" "/data/disk/${2}/static/control" "${3}"
}
### An --rsync-path that starts the receiving rsync on the target inside the
### real directory $1 (below /data/disk, /home or /opt/user every name on
### the path a real directory), so the destination is given as ./ and never
### resolves through a link the account put there; the copy fails when $1 is
### not that directory.
_xoct_rsync_path_in() {
  local _a=/data/disk
  case "${1}" in
    /home/?*) _a=/home ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  printf '%s' "cd -P -- '${1}' && [ \"\$(pwd -P)\" = \"\$(cd -P ${_a} && pwd -P)${1#"${_a}"}\" ] && rsync"
}
### As _xoct_rsync_path_in, but the last name of $1 is made a real directory
### first (a link the account put there is removed, a missing directory
### created): for a leg whose target directory the install does not create.
_xoct_rsync_path_mk_in() {
  local _d="${1}" _a=/data/disk _p _n
  case "${_d}" in
    /home/?*) _a=/home ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  _p="${_d%/*}"
  _n="${_d##*/}"
  printf '%s' "_a=\"\$(cd -P ${_a} && pwd -P)\"; cd -P -- '${_p}' && [ \"\$(pwd -P)\" = \"\${_a}${_p#"${_a}"}\" ] && { [ -L './${_n}' ] && rm -f './${_n}'; [ -d './${_n}' ] || mkdir './${_n}'; } && cd -P -- './${_n}' && [ \"\$(pwd -P)\" = \"\${_a}${_d#"${_a}"}\" ] && rsync"
}
### The entries of the current (pinned) directory the glob $3 names copied
### into the real directory $2 on the target $1, as _xoct_copy_here does it,
### but the target directory is created when missing (a link there removed
### first). For legs whose target directory the install does not provide.
_xoct_copy_mk_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xoct_rsync "$@" --rsync-path="$(_xoct_rsync_path_mk_in "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
### Where the directory $1 resolves when every name on its path below
### /data/disk, /home or /opt/user (the client toolchain trees) is a real
### directory; elsewhere, its last name inside its resolved parent.
_xoct_real_want() {
  local _d="${1}" _a=""
  case "${_d}" in
    /home/?*) _a=/home ;;
    /data/disk/?*) _a=/data/disk ;;
    /opt/user/?*) _a=/opt/user ;;
  esac
  if [ -n "${_a}" ]; then
    printf '%s' "$(cd -P -- "${_a}" 2> /dev/null && pwd -P)${_d#"${_a}"}"
  else
    printf '%s' "$(cd -P -- "${_d%/*}" 2> /dev/null && pwd -P)/${_d##*/}"
  fi
}
### "$@" run inside the canonical directory $1, only once pwd -P lands
### exactly there.
_xoct_in_canon_dir() {
  local _d="${1}"
  shift
  case "${_d}" in
    /?*) ;;
    *) return 1 ;;
  esac
  ( cd -P -- "${_d}" 2> /dev/null && [ "$(pwd -P)" = "${_d}" ] && "$@" )
}
### The --rsync-path that starts the receiver inside the canonical directory
### $1 on the target, and only once pwd -P says it is there.
_xoct_canon_rpath() {
  local _q
  _q="$(_shq "${1}")"
  printf '%s' "cd -P -- '${_q}' && [ \"\$(pwd -P)\" = '${_q}' ] && rsync"
}
### Whether the canonical path $2 belongs to the account $1: its own tree,
### or its own part of an attached store, <mount>/files/<oN>/, the layout
### migratefs moves static/files to. Another account's tree or store, and
### anything else a link can name, never passes.
_xoct_own_path() {
  local _a="${1}" _p="${2}" _t _r
  case "${_a}" in
    ''|.|..|*/*) return 1 ;;
  esac
  case "${_p}" in
    /?*) ;;
    *) return 1 ;;
  esac
  case "${_p}/" in
    *//*|*/./*|*/../*) return 1 ;;
  esac
  _t="$(_xoct_real_want "/data/disk/${_a}")"
  if [ "${_t}" != "/${_a}" ]; then
    case "${_p}/" in
      "${_t}"/*) return 0 ;;
    esac
  fi
  case "${_p}" in
    /mnt/?*/files/?*)
      _r="${_p#/mnt/}"
      _r="${_r#*/}"
      case "${_r}/" in
        "files/${_a}"/*) return 0 ;;
      esac
      ;;
  esac
  return 1
}
### The canonical path $2 is the account $1's own ($3 = tree: its tree or
### store; uid: also anything owned by one of its identities, <oN>,
### <oN>.ftp or a sub-user <oN>.<name>).
_xoct_store_is_own() {
  local _o
  _xoct_own_path "${1}" "${2}" && return 0
  [ "${3}" = "uid" ] || return 1
  _o="$(stat -c '%U' -- "${2}" 2> /dev/null)" || return 1
  case "${_o}" in
    "${1}"|"${1}".?*) return 0 ;;
  esac
  return 1
}
### Run on the target with the account's name in $1: enter the real parent
### of $2, made as mkdir -p makes it, once the nearest existing name on the
### way and then the parent itself resolve into the account's own tree or
### store. Run in the shell that then acts on ./<last name>.
_xoct_own_parent_cd() {
  local _a="${1}" _p="${2%/*}" _e
  [ -n "${_p}" ] || return 1
  _e="${_p}"
  while [ -n "${_e}" ] && [ ! -e "${_e}" ]; do
    _e="${_e%/*}"
  done
  _xoct_own_path "${_a}" "$(cd -P -- "${_e:-/}" 2> /dev/null && pwd -P)" \
    || return 1
  mkdir -p -- "${_p}" 2> /dev/null
  cd -P -- "${_p}" 2> /dev/null || return 1
  _xoct_own_path "${_a}" "$(pwd -P)"
}
### Run there as above: make the directory $3 of the account $2 ready for a
### copy and print XOREAL with its canonical path. A link at the last name
### stays when it resolves into the account's own tree or store and $1 is
### keep (the backups mover's link); otherwise it gives way to a directory.
_xoct_own_dir_ready() {
  local _m="${1}" _a="${2}" _n="${3##*/}" _r
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xoct_own_parent_cd "${_a}" "${3}" || return 1
  if [ -L "./${_n}" ]; then
    _r="$(cd -P -- "./${_n}" 2> /dev/null && pwd -P)"
    if [ "${_m}" != "keep" ] || ! _xoct_own_path "${_a}" "${_r}"; then
      rm -f -- "./${_n}" || return 1
    fi
  elif [ -e "./${_n}" ] && [ ! -d "./${_n}" ]; then
    rm -f -- "./${_n}" || return 1
  fi
  [ -d "./${_n}" ] || mkdir -- "./${_n}" || return 1
  cd -P -- "./${_n}" 2> /dev/null || return 1
  _r="$(pwd -P)"
  _xoct_own_path "${_a}" "${_r}" || return 1
  printf 'XOREAL %s\n' "${_r}"
}
### Run there as above: put the link $2 -> $3 of the account $1 in place of
### whatever holds the name, inside its real parent.
_xoct_own_link_ready() {
  local _n="${2##*/}"
  case "${_n}" in
    ''|.|..) return 1 ;;
  esac
  _xoct_own_parent_cd "${1}" "${2}" || return 1
  if [ -L "./${_n}" ]; then
    rm -f -- "./${_n}"
  elif [ -d "./${_n}" ]; then
    rm -rf -- "./${_n}"
  elif [ -e "./${_n}" ]; then
    rm -f -- "./${_n}"
  fi
  ln -sfn -- "${3}" "./${_n}" || return 1
  printf 'XOREAL %s/%s\n' "$(pwd -P)" "${_n}"
}
### Run there as above: link the account $1's name $2 to its store entry $3
### only once $3 is a directory in the account's own tree or store, so a
### directory at $2 never gives way to a link that leads nowhere.
_xoct_own_store_link_ready() {
  _xoct_own_path "${1}" "$(cd -P -- "${3}" 2> /dev/null && pwd -P)" || return 1
  _xoct_own_link_ready "${1}" "${2}" "${3}"
}
### Run there: make the store copy's directory $1 under the attached mount
### and print XOREAL with its canonical path, only when no name below /mnt
### on the way is a link (checked before anything is made, and again after).
_xoct_real_mnt_dir() {
  local _d="${1}" _c _e
  case "${_d}/" in
    /mnt/?*/?*) ;;
    *) return 1 ;;
  esac
  case "${_d}/" in
    *//*|*/./*|*/../*) return 1 ;;
  esac
  _c="$(cd -P -- /mnt 2> /dev/null && pwd -P)" || return 1
  [ -n "${_c}" ] || return 1
  _e="${_d}"
  while [ -n "${_e}" ] && [ ! -e "${_e}" ]; do
    _e="${_e%/*}"
  done
  [ "$(cd -P -- "${_e:-/}" 2> /dev/null && pwd -P)" = "${_c}${_e#/mnt}" ] || return 1
  mkdir -p -- "${_d}" 2> /dev/null
  _c="${_c}${_d#/mnt}"
  cd -P -- "${_d}" 2> /dev/null || return 1
  [ "$(pwd -P)" = "${_c}" ] || return 1
  printf 'XOREAL %s\n' "${_c}"
}
### Run one of the placement helpers above as root on the box $1, with the
### helper's name and arguments after it; prints the canonical path its
### XOREAL line names and fails when there is none.
_xoct_tgt_place() {
  local _h="${1}" _out _x _args=""
  shift
  for _x in "$@"; do
    _args="${_args} '$(_shq "${_x}")'"
  done
  _out="$( { declare -f _xoct_real_want _xoct_own_path _xoct_own_parent_cd \
      _xoct_own_dir_ready _xoct_own_link_ready _xoct_own_store_link_ready \
      _xoct_real_mnt_dir
    printf '%s\n' '"$@"'; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=30 root@"${_h}" \
      "bash -s --${_args}" 2> /dev/null)"
  _out="$(printf '%s\n' "${_out}" | grep -m1 '^XOREAL /')"
  [ -n "${_out}" ] || return 1
  printf '%s' "${_out#XOREAL }"
}
### A transfer leg's source directory $1: true when it is a real directory
### to copy from. A missing one is skipped quietly; one that is not a real
### directory (a link on its path) is refused: nothing is followed, the dry
### run is not clean and a live transfer is not complete.
_xoct_leg_ok() {
  [ -e "${1}" ] || [ -L "${1}" ] || return 1
  _xoct_in_real_dir "${1}" true && return 0
  echo "DENY: ${1} is not a real directory (a link on its path) -- not followed, not copied"
  _XOCT_NOT_CLEAN=YES
  [ "${_MODE}" = "LIVE" ] && _XOCT_STORE_RC=1
  return 1
}
### backups/ or backup-exports/ ($5) of the account tree $1 carried to the
### account tree $2 on the target $3 ($4 the rsync error option). On a box
### whose files store sits on its own device the nightly moves both into
### static/files/.<name> and leaves a link: the store leg carries that
### content, so the link is reproduced on the target once the store copy is
### there, and only when it names one plain entry straight under
### static/files. Any other backups/ is copied from inside the real
### directory it resolves to when that is the account's own tree or store,
### into the target's backups/, whose mover link is kept when it resolves
### into the account's own tree or store there; anything else is refused.
### A backups/ link naming a path under /mnt is left to the /mnt link pass,
### which carries it once, fit-checked. backup-exports/ travels only as the
### mover link, as it always did.
_xoct_backups_leg() {
  local _u="${1}" _d="${2}" _h="${3}" _ie="${4}" _n="${5}" _l _b _r _to _rc
  _l="$(readlink "${_u}/${_n}" 2> /dev/null)"
  _b="${_l#"${_u}/static/files/"}"
  if [ -L "${_u}/${_n}" ] && [ "${_b}" != "${_l}" ] \
    && [[ "${_b}" =~ ^[A-Za-z0-9._-]+$ ]] \
    && [ "${_b}" != "." ] && [ "${_b}" != ".." ]; then
    if [ "${_MODE}" = "LIVE" ]; then
      if ! _xoct_tgt_place "${_h}" _xoct_own_store_link_ready "${_d##*/}" "${_d}/${_n}" \
        "${_d}/static/files/${_b}" > /dev/null; then
        echo "DENY: ${_d}/${_n} on ${_h} not linked to static/files/${_b} (no store copy of it there in the account's own tree or store)"
        _XOCT_NOT_CLEAN=YES
        _XOCT_STORE_RC=1
        return 1
      fi
    else
      echo "[DRY-PLAN] would link ${_d}/${_n} -> ${_d}/static/files/${_b} on ${_h}"
    fi
    return 0
  fi
  [ "${_n}" = "backups" ] || return 0
  [ -e "${_u}/${_n}" ] || [ -L "${_u}/${_n}" ] || return 0
  if [ -L "${_u}/${_n}" ]; then
    case "${_l}" in
      /mnt/*) return 0 ;;
    esac
  fi
  _r="$(cd -P -- "${_u}/${_n}" 2> /dev/null && pwd -P)"
  if [ -z "${_r}" ] || ! _xoct_own_path "${_u##*/}" "${_r}"; then
    echo "DENY: ${_u}/${_n} resolves to ${_r:-nothing}, outside the account's own tree and store -- not followed, not copied"
    _XOCT_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && _XOCT_STORE_RC=1
    return 1
  fi
  _to=""
  if [ "${_MODE}" = "LIVE" ]; then
    _to="$(_xoct_tgt_place "${_h}" _xoct_own_dir_ready keep "${_d##*/}" "${_d}/${_n}")"
    if [ -z "${_to}" ]; then
      echo "DENY: ${_d}/${_n} on ${_h} does not resolve into the account's own tree or store -- not copied"
      _XOCT_NOT_CLEAN=YES
      _XOCT_STORE_RC=1
      return 1
    fi
  fi
  ### an empty backups/ has nothing for the glob to name
  [ -n "$(_xoct_in_canon_dir "${_r}" find . -mindepth 1 -maxdepth 1 \
    -name '[!.]*' -print -quit 2> /dev/null)" ] || return 0
  # shellcheck disable=SC2086
  _xoct_in_canon_dir "${_r}" _xoct_copy_canon_here "${_h}" "${_to:-${_d}/${_n}}" '*' \
    -aEAXqu ${_ie} > /dev/null
  _rc=$?
  ### 24: files that vanished while the copy ran (a rotated backup)
  if [ "${_rc}" != "0" ] && [ "${_rc}" != "24" ] && [ "${_MODE}" = "LIVE" ]; then
    echo "DENY: ${_u}/${_n} copy to ${_h} failed (rc ${_rc})"
    _XOCT_NOT_CLEAN=YES
    _XOCT_STORE_RC=1
    return 1
  fi
  return 0
}
### As _xoct_copy_here, but the receiver starts in the canonical directory $2
### the target reported (see _xoct_tgt_place).
_xoct_copy_canon_here() {
  local _h="${1}" _d="${2}" _g="${3}"
  shift 3
  # shellcheck disable=SC2086
  _xoct_rsync "$@" --rsync-path="$(_xoct_canon_rpath "${_d}")" -e ssh \
    ./${_g} "root@${_h}:./"
}
### ./$1 in the current (pinned) directory put at ./$2 through sed "${@:3}".
### The source is read through one handle opened O_NOFOLLOW|O_NONBLOCK that
### must be a regular file with one link under 1 MiB; the owner, group and
### mode are taken from that same handle (the first line the reader prints),
### never from a stat by name, so a name swapped between the look and the
### read never lends its bytes another file's owner. The result is a fresh
### file with that numeric owner and the read/write bits of that mode,
### created, written, owned and moded through one handle opened
### O_EXCL|O_NOFOLLOW (the _XOCT_PUT_PL text), then renamed over ./$2:
### nothing is chowned or chmodded by name. Both perl texts stay in the
### function because it also runs on the target, shipped by declare -f. For
### a plain file this is what sed -i (and cp -a, with an empty program)
### wrote, without their reach through a link put at the name.
_xoct_sed_to() {
  local _s="${1}" _n="${2}" _t _u _g _m _h
  local _rd='use Fcntl; my ($n) = @ARGV; sysopen(my $h, $n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit 1; my @s = stat($h); exit 1 unless @s && -f _ && $s[3] == 1 && $s[7] < 1048576; my ($d, $r) = (""); while ($r = sysread($h, my $c, 65536)) { $d .= $c; exit 1 if length($d) >= 1048576; } exit 1 unless defined $r; close($h); binmode(STDOUT); printf("%d %d %o\n", $s[4], $s[5], $s[2] & 07777) or exit 1; (print $d) or exit 1; exit 0'
  local _pl='use Fcntl; my ($n, $u, $g, $m) = @ARGV; local $/; my $d = <STDIN>; sysopen(my $h, $n, O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600) or exit 1; (print {$h} $d) or exit 1; chown($u, $g, $h) or exit 1; chmod(oct($m) & 0666, $h) or exit 1; close($h) or exit 1; exit 0'
  shift 2
  _t="./.${_n}.sed.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    perl -e "${_rd}" "./${_s}" 2> /dev/null | {
      _h=""
      IFS=' ' read -r _u _g _m _h || exit 1
      [[ "${_u}" =~ ^[0-9]+$ ]] && [[ "${_g}" =~ ^[0-9]+$ ]] \
        && [[ "${_m}" =~ ^[0-7]+$ ]] && [ -z "${_h}" ] || exit 1
      sed "$@" | perl -e "${_pl}" "${_t}" "${_u}" "${_g}" "${_m}"
    } ) && mv -f -T -- "${_t}" "./${_n}"; then
    return 0
  fi
  rm -f -- "${_t}"
  return 1
}
### ./$1 rewritten in place by sed "${@:2}", as _xoct_sed_to does it.
_xoct_sed_here() {
  local _n="${1}"
  shift
  _xoct_sed_to "${_n}" "${_n}" "$@"
}
### ./$2 in the current (pinned) directory built from the template file $1
### (an absolute root-owned path) piped through sed "${@:4}" into a fresh
### file put through _XOCT_PUT_PL, 0600 and owned by $3 (owner:group; root's
### when it does not resolve) from the start, renamed over the name: a link
### put at the destination name is replaced, never written through as cp -a
### onto the name would, and nothing is chowned by name afterwards.
_xoct_tpl_to_here() {
  local _tpl="${1}" _n="${2}" _ids _t
  _ids="$(_xoct_owner_ids "${3}")" || _ids="-1 -1"
  shift 3
  _t="./.${_n}.put.$$.${RANDOM}"
  rm -f -- "${_t}"
  if ( set -o pipefail
    sed "$@" -- "${_tpl}" \
      | perl -e "${_XOCT_PUT_PL}" "${_t}" "${_ids% *}" "${_ids#* }" 600 ); then
    mv -f -T -- "${_t}" "./${_n}" && return 0
  fi
  rm -f -- "${_t}"
  return 1
}
### $1 as the directory root works in: itself when it is a real directory;
### when it is a link, the real directory it leads to, only when every link
### on the way is root's and every directory on the way, the last one
### included, is root's and writable by no one else, so no one but root can
### change where it leads or what is in it; nothing otherwise (exit 1). The
### shared store /data/all may be such a link. With a second argument "last"
### the last directory may be anyone's and open to others (the Octopus store
### check takes /data/disk/all back); none is given here.
_ROOT_REAL_PATH_PL='my ($p, $k) = @ARGV; if (!-l $p) { print $p if -d _; exit(-d _ ? 0 : 1); } my ($c, $n, @s) = ("", 0, stat("/")); exit 1 unless $p =~ m{^/} && @s && $s[4] == 0 && !($s[2] & 022); my @w = grep { length && $_ ne "." } split(m{/}, $p); while (@w) { my $e = shift(@w); if ($e eq "..") { $c =~ s{/[^/]*$}{}; next; } my @l = lstat("$c/$e") or exit 1; if (-l _) { exit 1 if $l[4] != 0 || ++$n > 40; my $t = readlink("$c/$e"); exit 1 unless defined $t; $c = "" if $t =~ m{^/}; unshift(@w, grep { length && $_ ne "." } split(m{/}, $t)); next; } exit 1 unless -d _ && (($l[4] == 0 && !($l[2] & 022)) || (defined $k && $k eq "last" && !@w)); $c .= "/$e"; } print($c eq "" ? "/" : $c); exit 0'
### $1, the real directory a link of root's at /data/all leads to
### (_ROOT_REAL_PATH_PL's answer), is the one the store may be kept in
### behind that link (exit 0) only when it is /data/disk/all, the directory
### named all directly in the real /data/disk, compared by device and inode
### with that name not followed, so a link put at it does not count; any
### other directory, or none, exit 1. Besides a real /data/all it is the
### one layout of the store BOA knows, and the one other store directory
### every PHP-FPM pool's open_basedir names. One text wherever it is defined
### (satellite.sh.inc, BOA.sh.txt, xoct, xcopy, manage_solr_config.sh,
### night.inc.sh).
_SAT_STORE_TARGET_PL='my @t = lstat(defined $ARGV[0] ? $ARGV[0] : ""); my @a = lstat("/data/disk/all"); exit((@t && @a && -d _ && $t[0] == $a[0] && $t[1] == $a[1]) ? 0 : 1)'
### chmod $1 on the regular files ./$2 ... of the current (pinned) directory
### WITHOUT following a link: a name swapped for a link is opened O_NOFOLLOW
### and skipped, so the mode is never applied to a link's target, and only a
### file with one link is changed, so a hard link to another file put at a
### name is skipped too. $1 = mode.
_XOCT_FCHMOD_PL='use Fcntl;
my $m = shift @ARGV;
for my $f (@ARGV) {
  sysopen(my $h, $f, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
  my @s = stat($h);
  chmod(oct($m), $h) if @s && -f _ && $s[3] == 1;
  close($h);
}'
_xoct_fchmod_here() {
  local _m="${1}"
  shift
  [ "$#" -gt 0 ] || return 0
  perl -e "${_XOCT_FCHMOD_PL}" "${_m}" "$@" 2> /dev/null
}
### Re-assert owner:group $1 and mode $2 (none when empty) on the regular
### file ./$3 of the current (pinned) directory through _XOCT_REASSERT_PL:
### only a regular file with one link, owned already by $1, is changed,
### through the handle that checked it, so a link, a hard link to another
### file or another identity's file (root's too) the account put at the name
### is never handed to the account or chmodded. $4 (optional): further uids,
### comma-separated, the file may carry and still be re-asserted. An owner
### that does not resolve changes no owner; the mode is still set on a file
### owned by one of the $4 uids.
_xoct_reassert_here() {
  local _own="${1}" _m="${2}" _n="${3}" _x="${4}" _ids
  _ids="$(_xoct_owner_ids "${_own}")" || _ids="-1 -1"
  perl -e "${_XOCT_REASSERT_PL}" -- "${_ids% *}" "${_ids#* }" "${_m}" "${_x}" \
    "./${_n}" 2> /dev/null
  return 0
}
### The same, run inside the real vhost.d directory $1. $2 owner:group, $3
### the vhost name, $4 the mode (default 600).
_xoct_vhd_reassert() {
  _xoct_in_real_dir "${1}" _xoct_reassert_here "${2}" "${4:-600}" "${3}"
}
### Whether the vhost $2 in the real vhost.d $1 holds the text $3, read as
### _xoct_read_in reads it: never through a link, never blocked on a FIFO.
_xoct_vh_has() {
  _xoct_read_in "${1}" "${2}" | grep -q -- "${3}"
}
### The account proves it owns a database by logging in as its own user and
### using it: BOA sets db_user == db_name, so a login as that user with that
### password can reach only databases the account really owns. $1 = db (==
### user), $2 = its password.
_xoct_cred_ok() {
  [ -n "$1" ] && [ -n "$2" ] \
    && mysql -u"$1" -p"$2" -h"${_SQL_CONNECT:-localhost}" \
      -P"${_THIS_DB_PORT:-3306}" --protocol=tcp -N -B \
      -e "USE \`$1\`" > /dev/null 2>&1
}
### A grant ON a database reads _ and % in its name as wildcards: `a_b`.*
### also covers aXb, with ALL there. A site user is granted its own name
### escaped, as provisioning grants it (grant_privileges); names reach here
### as [a-zA-Z0-9_] only, so _ is all there is to escape.
_xoct_db_grant_name() {
  printf '%s' "${1//_/\\_}"
}
### Once the exact grant is in place, a wildcard grant an earlier run left on
### the same name ($1, also the user) at the host $2 goes, as provisioning
### converges it (revoke_wildcard_db_grant): only when SHOW GRANTS lists it,
### and revoked as it is stored, its grant option too (a db-level REVOKE
### takes ALL and GRANT OPTION only as two statements; the second fails
### harmlessly where there was none).
_xoct_db_revoke_wildcard() {
  local _g
  [[ "${1}" == *_* ]] || return 0
  _g=$(mysql --silent -u root -h"${_SQL_CONNECT}" -P"${_THIS_DB_PORT}" --protocol=tcp \
    -N -B -e "SHOW GRANTS FOR '${1}'@'${2}'" 2> /dev/null)
  printf '%s\n' "${_g}" | grep -qF "ON \`${1}\`.* TO " || return 0
  mysql --silent -u root -h"${_SQL_CONNECT}" -P"${_THIS_DB_PORT}" --protocol=tcp \
    -e "REVOKE ALL PRIVILEGES ON \`${1}\`.* FROM '${1}'@'${2}'; \
        REVOKE GRANT OPTION ON \`${1}\`.* FROM '${1}'@'${2}';" &> /dev/null
}
### The real (non-link) subdirectory names of the current (pinned) directory,
### one per line: the glob expands here, never in a directory a link put in
### its place names.
_xoct_real_subdirs_here() {
  local _e
  for _e in ./*; do
    [ -d "${_e}" ] && [ ! -L "${_e}" ] && printf '%s\n' "${_e#./}"
  done
}
### clients/ ($1) is oN's: a link at clients itself, or at any client name, is
### never followed. Only a real client subdirectory is entered and only its
### own ./backups removed, then dangling links are pruned from inside the real
### clients/ so symlinks(1) cannot walk out through a swapped name.
_xoct_clean_clients() {
  local _cd="${1}" _c
  _xoct_in_real_dir "${_cd}" true || return 0
  _xoct_in_real_dir "${_cd}" _xoct_real_subdirs_here | while IFS= read -r _c; do
    [ -n "${_c}" ] || continue
    _xoct_in_real_dir "${_cd}/${_c}" rm -rf -- ./backups
  done
  _xoct_in_real_dir "${_cd}" symlinks -dr . &> /dev/null
}

### Write the per-host gate for one hostname. static/control is
### tenant-writable: the gate is read and rewritten inside the real
### directory, never through a link or FIFO put at either name. Its lines
### are carried only from a regular file with one link that is the
### account's or its .ftp login's (which the ltd worker hands static/control
### to), read through the handle that checked it: another file renamed onto
### the name (a root-only one included) lends no bytes to the rewrite. A
### rewrite is created owned by $2 (owner:group); a gate that already names
### the host keeps its bytes and gets its owner re-asserted as
### _xoct_reassert_here does it, so a hard link to another file put at the
### name is never handed to the account.
_XOCT_READ_OWN_PL='use Fcntl; my ($n, $x) = @ARGV; my %ok = map { $_ => 1 } split(/,/, $x); sysopen(my $h, $n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or exit 0; my @s = stat($h); exit 0 unless @s && -f _ && $s[3] == 1 && $s[7] < 1048576 && $ok{$s[4]}; my ($d, $r) = (""); while ($r = sysread($h, my $c, 65536)) { $d .= $c; exit 0 if length($d) >= 1048576; } exit 0 unless defined $r; binmode(STDOUT); print $d; exit 0'
_xoct_plant_host_gate() {
  local _usr="$1"
  local _oct_id="$2"
  local _grp="$3"
  local _fqdn="$4"
  _xoct_in_real_dir "${_usr}/static/control" \
    _xoct_host_gate_here "${_fqdn}" "${_oct_id}:${_grp}"
}
_xoct_host_gate_here() {
  local _t _f
  _f="$(id -u -- "${2%%:*}.ftp" 2> /dev/null)"
  _t="$(perl -e "${_XOCT_READ_OWN_PL}" -- ./http-off-host.pid \
    "$(id -u -- "${2%%:*}" 2> /dev/null),${_f}" 2> /dev/null)"
  if ! grep -q -x -F "${1}" <<< "${_t}"; then
    _t="$(printf '%s\n%s\n' "${_t}" "${1}" | sed '/^$/d')"
    _xoct_put_here http-off-host.pid "${_t}" "${2}" || return 1
  else
    _xoct_reassert_here "${2}" "" http-off-host.pid "${_f}"
  fi
  grep -q -x -F "${1}" <<< "$(_xoct_read_here http-off-host.pid)"
}

_xoct_ssl_material_missing() {
  ### Echo the cert files the HTTPS proxy template references that do NOT
  ### exist, named relative to the account root; empty output means the
  ### template can be written safely. Its own function so the gate can be
  ### proven by a fixture rather than by inspection -- B2 was precisely the
  ### case where inspection concluded a single openssl.key probe was enough.
  local _usr="$1"
  local _dom="$2"
  local _f
  local _out=""
  for _f in \
    "${_usr}/config/server_master/ssl.d/${_dom}/openssl.key" \
    "${_usr}/config/server_master/ssl.d/${_dom}/openssl_chain.crt" \
    "${_usr}/tools/le/certs/${_dom}/chain.pem" \
  ; do
    if [ ! -e "${_f}" ]; then
      _out="${_out} ${_f#${_usr}/}"
    fi
  done
  echo "${_out}"
}

_migrate_sites() {
  ### Group of the tree these vhost/control files live in -- derived from the
  ### PATH, because on a rename import ${_USR} is the destination account while
  ### ${_oct} still names the source; 'users' on an unconverted box, so the
  ### chowns below are unchanged there.
  _OCT_GRP=$(_acct_group "${_USR}")
  ### The account's own control panel is never a site of this loop. The old
  ### tool skipped it by accident of design -- no <fqdn>.alias existed for a
  ### panel, only hostmaster.alias -- until the ltd-users pass began planting
  ### a <fqdn> symlink to that alias, which made the panel look like a site
  ### here: on proxy it then got a proxy vhost, and the target never serves a
  ### source-named panel, so the panel answered 404 from the new box's
  ### catch-all and the source lost its own monitoring canary. Identify the
  ### panel by what it is (the hostmaster alias site_path), not by which
  ### alias files happen to exist. .drush is oN's: every alias is read inside
  ### the real directory, never through a link or into a FIFO put there.
  _HM_PANEL_FQDN=$(_xoct_read_in "${_USR}/.drush" hostmaster.alias.drushrc.php \
    | grep "site_path'" \
    | head -1 \
    | sed "s/.*=>//; s/[' ,;]//g")
  _HM_PANEL_FQDN=$(basename "${_HM_PANEL_FQDN}" 2>/dev/null)
  _HM_PANEL_FQDN=${_HM_PANEL_FQDN//[^a-zA-Z0-9.\-]/}
  _XOCT_PANEL_RESTORED=NO
  for _Site in `find ${_USR}/config/server_master/nginx/vhost.d -maxdepth 1 -mindepth 1 -type f | sort`
  do
    _Dom=`echo ${_Site} | cut -d'/' -f9 | awk '{ print $1}'`
    _Vht="${_USR}/config/server_master/nginx/vhost.d/${_Dom}"
    _Vhd="${_USR}/config/server_master/nginx/vhost.d/.${_Dom}"
    _Vhs="${_USR}/config/server_master/nginx/vhost.d/https.${_Dom}"
    if [ -n "${_HM_PANEL_FQDN}" ] && [ "${_Dom}" = "${_HM_PANEL_FQDN}" ]; then
      if [ "${_cmd}" = "proxy" ]; then
        ### A conversion by the earlier code proxied the panel and saved the
        ### real vhost as the dot-file; put it back so the panel serves
        ### locally again (the reload below applies it).
        if _xoct_vh_has "${_Vht%/*}" "${_Dom}" "Plain HTTP proxy (START)" \
          && [ -n "$(_xoct_read_in "${_Vhd%/*}" ".${_Dom}")" ] \
          && ! _xoct_vh_has "${_Vhd%/*}" ".${_Dom}" "Plain HTTP proxy (START)"; then
          ### vhost.d is oN's: restore and re-assert inside the real directory.
          _xoct_in_real_dir "${_Vht%/*}" mv -f -T -- "./.${_Dom}" "./${_Dom}"
          _xoct_vhd_reassert "${_Vht%/*}" "${_oct}:${_OCT_GRP}" "${_Dom}"
          _XOCT_PANEL_RESTORED=YES
          echo "INFO: control panel ${_Dom} on ${_oct}: local vhost restored (an earlier conversion had proxied it)"
        fi
        echo "INFO: control panel ${_Dom} on ${_oct} stays local in Drupal maintenance mode -- never proxied"
      fi
      continue
    fi
    ### A whole-server move relays the client-domain sites BEFORE the new box
    ### renames the sites named under this box's hostname. Those stay local
    ### and held on 503 by the per-host gate until the second pass (--repair,
    ### no defer flag) turns their old names into redirects. Skipped before
    ### the eligibility count, so an account holding nothing else is not read
    ### as a failed conversion. Only a site the gate can really hold, and only
    ### while its vhost is still the local one.
    if [ "${_cmd}" = "proxy" ] && [ -n "${_XOCT_DEFER_FQDN}" ] \
      && [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ] \
      && _xoct_named_under_host "${_Dom}" "${_XOCT_DEFER_FQDN}" \
      && ! _xoct_vh_has "${_Vht%/*}" "${_Dom}" "Plain HTTP proxy (START)"; then
      if _xoct_site_host_gateable "${_USR}" "${_Dom}" "${_Vht}"; then
        _XOCT_PROXY_DEFERRED="${_XOCT_PROXY_DEFERRED} ${_Dom}"
        echo "INFO: site ${_Dom} on ${_oct}: named under ${_XOCT_DEFER_FQDN}, deferred (stays local on 503 until it is renamed)"
        continue
      fi
      echo "ALRT: site ${_Dom} on ${_oct}: named under ${_XOCT_DEFER_FQDN} but the per-host gate cannot hold it -- converted now, not deferred"
    fi
    ### Every SITE past the panel skip is one the conversion is expected to
    ### touch; the verdict below tells "nothing to convert" apart from
    ### "nothing converted" by this count. The https.<dom> companions and the
    ### saved dot-files live in the same directory and are not sites: counting
    ### them made an account whose sites were all deferred read as "0
    ### converted of N" -- a failed conversion.
    case "${_Dom}" in
      https.*|.*) ;;
      *) _XOCT_PROXY_ELIGIBLE=$(( ${_XOCT_PROXY_ELIGIBLE:-0} + 1 )) ;;
    esac
    ### vhost.d is under config/, which belongs to oN: the owner and mode are
    ### re-asserted inside the real directory, through a no-follow handle on
    ### a regular file with one link that is already the account's -- a
    ### link, a hard link to another file, or a file of another owner (a
    ### root-only one included) the account put at either name is skipped,
    ### never handed to the account.
    if [ ! -z "${_oct}" ]; then
      _xoct_vhd_reassert "${_Vht%/*}" "${_oct}:${_OCT_GRP}" "${_Dom}"
      _xoct_vhd_reassert "${_Vht%/*}" "${_oct}:${_OCT_GRP}" ".${_Dom}"
    fi
    if [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ]; then
      echo Dom is ${_Dom}
      _Dir=$(_xoct_read_in "${_USR}/.drush" "${_Dom}.alias.drushrc.php" | grep "site_path'" | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,']//g")
      _Plr=$(_xoct_read_in "${_USR}/.drush" "${_Dom}.alias.drushrc.php" | grep "root'" | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,']//g")
      ### site_path comes from the account's own alias and points into its own
      ### tree: it is confined to the account and drushrc.php is read inside
      ### its real directory, so root reads and writes a site only there.
      ### _DIR_OK gates every db and drushrc step below; a refused site is
      ### counted as failed on import and export. The per-site values start
      ### empty on every pass, so no refusal ever names another site's.
      _DBN="" _DBU="" _DBP="" _DBP_LIT="" _DRC=""
      _DIR_OK=NO
      case "${_Dir}/" in
        "${_USR}"/*) _xoct_in_real_dir "${_Dir}" true && _DIR_OK=YES ;;
      esac
      [ "${_DIR_OK}" = "YES" ] \
        || echo "ALRT: site ${_Dom} on ${_oct}: site_path ${_Dir} is outside the account or not a real directory -- its db/drushrc steps are skipped"
      _OWN_DB=NO
      if { [ "${_cmd}" = "import" ] || [ "${_cmd}" = "export" ]; } \
        && [ "${_DIR_OK}" = "YES" ]; then
        _xoct_sql_maint_hold
        # drushrc.php is written with var_export(): each value is a single-quoted
        # literal in which only the quote and the backslash are escaped. Read the
        # whole file once inside its real directory, then parse the fields.
        _DRC=$(_xoct_read_in "${_Dir}" drushrc.php)
        _DBN=$(printf '%s\n' "${_DRC}" | grep "options\['db_name'\] = " | cut -d: -f2 | awk '{ print $3}' | sed "s/[\,';]//g")
        _DBN=${_DBN//[^a-zA-Z0-9_]/}
        _DBU=$(printf '%s\n' "${_DRC}" | sed -n "s/^\$options\['db_user'\][[:space:]]*=[[:space:]]*'\([^']*\)'.*/\1/p" | head -1)
        # Keep only what the generated-password charset admits for RE-CREATING
        # the user below; the raw literal is used only to prove ownership.
        _DBP_LIT=$(printf '%s\n' "${_DRC}" | sed -n 's/^[[:space:]]*\$options\[\x27db_passwd\x27\][[:space:]]*=[[:space:]]*\x27\(.*\)\x27;[[:space:]]*$/\1/p' \
          | head -1 | sed -e 's/\\\x27/\x27/g' -e 's/\\\\/\\/g')
        _DBP=${_DBP_LIT//[^a-zA-Z0-9_]/}
        echo "site ${_Dom} clean _DBN is ${_DBN}"
        ### A database is dumped, or loaded over, only when the site's own
        ### db_user equals db_name (BOA sets one user per site DB) and its
        ### credentials open it.
        if [ -n "${_DBN}" ] && [ "${_DBU}" = "${_DBN}" ] \
          && _xoct_cred_ok "${_DBN}" "${_DBP_LIT}"; then
          _OWN_DB=YES
        fi
      fi
      ### An import loads the sites before the rename (stage load) and
      ### verifies them after it (stage verify). A site is known across the
      ### rename by the device and inode of its directory, which the rename
      ### moves without copying: one the load stage saw only gets its verify
      ### here, when its load was clean; one it never saw is loaded and
      ### verified here as a single-stage import does. A site_path the load
      ### stage cannot enter is judged here, after the rename, which may
      ### reinstate it.
      _SIDN=""
      _SITE_SEEN=NO
      if [ "${_cmd}" = "import" ] && [ -n "${_XOCT_SITES_STAGE}" ] \
        && [ "${_DIR_OK}" = "YES" ]; then
        _SIDN=$(_xoct_in_real_dir "${_Dir}" stat -c %d:%i . 2> /dev/null)
        _SIDN=${_SIDN//[^0-9:]/}
        if [ "${_XOCT_SITES_STAGE}" = "verify" ] && [ -n "${_SIDN}" ]; then
          case " ${_XOCT_SEEN_DIRS} " in
            *" ${_SIDN} "*) _SITE_SEEN=YES ;;
          esac
        fi
      fi
      if [ "${_SITE_SEEN}" = "YES" ]; then
        _XOCT_MET_DIRS="${_XOCT_MET_DIRS} ${_SIDN}"
        case " ${_XOCT_LOADED_DIRS} " in
          *" ${_SIDN} "*)
            _run_drush8_hmr_cmd "hosting-task @${_Dom} verify --force$(_xoct_runner_wait_opt)"
            echo "INFO: site ${_Dom} verify on ${_oct} scheduled"
          ;;
          *)
            echo "ALRT: site ${_Dom} verify NOT scheduled on ${_oct}: db import did not complete"
          ;;
        esac
      elif [ "${_cmd}" = "import" ] && [ "${_DIR_OK}" != "YES" ] \
        && [ "${_XOCT_SITES_STAGE}" = "load" ]; then
        _XOCT_DEFERRED_N=$(( _XOCT_DEFERRED_N + 1 ))
        echo "INFO: site ${_Dom} on ${_oct}: site_path not entered before the rename; judged after it"
      elif [ "${_cmd}" = "import" ] && [ "${_DIR_OK}" != "YES" ]; then
        [ "${_XOCT_SITES_STAGE}" = "verify" ] && _XOCT_DEFER_MET=$(( _XOCT_DEFER_MET + 1 ))
        _XOCT_SITE_IMPORT_OK=NO
        _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
        _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_Dom}:site-path-refused"
        echo "ALRT: site ${_Dom} on ${_oct}: NOT imported (site_path refused)"
      elif [ "${_cmd}" = "import" ]; then
        [ "${_XOCT_SITES_STAGE}" = "load" ] && [ -n "${_SIDN}" ] \
          && _XOCT_SEEN_DIRS="${_XOCT_SEEN_DIRS} ${_SIDN}"
        [ "${_XOCT_SITES_STAGE}" = "verify" ] && _XOCT_DEFER_MET=$(( _XOCT_DEFER_MET + 1 ))
        if [ "${_DBP}" != "${_DBP_LIT}" ]; then
          echo "ALRT: site ${_Dom} db_passwd carries characters outside the generated-password charset; not re-created here, fix its credentials by hand"
          _DBP=""
        fi
        ### vhost.d is oN's: the saved dot-file is renamed over the live name
        ### inside the real directory, so a link at either name is never
        ### followed and the file is never moved into a linked directory.
        _xoct_in_real_dir "${_Vht%/*}" mv -f -T -- "./.${_Dom}" "./${_Dom}" 2> /dev/null
        if [ ! -z "${_dst}" ]; then
          _TGT_HM_USER="${_dst}"
        else
          _TGT_HM_USER="${_oct}"
        fi
        ### Derived inside the loop, right after the account it belongs to.
        _TGT_HM_GRP=$(_acct_group "${_TGT_HM_USER}")
        _xoct_vhd_reassert "${_Vht%/*}" "${_TGT_HM_USER}:${_TGT_HM_GRP}" "${_Dom}"
        ### db_host is rewritten to localhost inside the real directories, each
        ### as a fresh file renamed over the name (owner and mode kept), never
        ### through a link or FIFO the account put at drushrc.php or the vhost.
        _xoct_in_real_dir "${_Dir}" _xoct_sed_here drushrc.php \
          "s/\$options\['db_host'\] = '.*/\$options[\'db_host\'] = \'localhost\';/g"
        _xoct_in_real_dir "${_Vht%/*}" _xoct_sed_here "${_Dom}" \
          "s/.*fastcgi_param.*db_host.*;/  fastcgi_param db_host   localhost;/g"
        echo "INFO: site ${_Dom} db_host on ${_TGT_HM_USER} fixed"
        if [ ! -z "${_DBN}" ] && [ ! -z "${_DBP}" ]; then
          _DB_FRESH=NO
          if [ ! -d "/var/lib/mysql/${_DBN}" ]; then
            _DB_FRESH=YES
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
              mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges &> /dev/null
            else
              mysqladmin -u root flush-privileges &> /dev/null
            fi
            [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL3 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -uroot"
            if [ -e "/root/.my.proxysql_adm_pwd.txt" ]; then
              _PROXYSQL_PASSWORD=$(cat /root/.my.proxysql_adm_pwd.txt 2>/dev/null | tr -d '\n')
              mysql -uadmin -p${_PROXYSQL_PASSWORD} -h127.0.0.1 -P6032 --protocol=tcp<<PROXYSQL
DELETE FROM mysql_users WHERE username='${_DBN}';
DELETE FROM mysql_query_rules WHERE username='${_DBN}';
INSERT INTO mysql_users (username,password,default_hostgroup) VALUES ('${_DBN}','${_DBP}','10');
LOAD MYSQL USERS TO RUNTIME;
SAVE MYSQL USERS FROM RUNTIME;
SAVE MYSQL USERS TO DISK;
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_DBN}',10,1);
INSERT INTO mysql_query_rules (username,destination_hostgroup,active) VALUES ('${_DBN}',11,1);
LOAD MYSQL QUERY RULES TO RUNTIME;
SAVE MYSQL QUERY RULES TO DISK;
PROXYSQL
            fi
            _DBN_ESC=$(_xoct_db_grant_name "${_DBN}")
            mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -u root mysql<<EOFMYSQL
CREATE DATABASE ${_DBN} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${_DBN}'@'localhost';
CREATE USER IF NOT EXISTS '${_DBN}'@'%';
GRANT ALL ON \`${_DBN_ESC}\`.* TO '${_DBN}'@'localhost';
GRANT ALL ON \`${_DBN_ESC}\`.* TO '${_DBN}'@'%';
ALTER USER '${_DBN}'@'localhost' IDENTIFIED BY '${_DBP}';
ALTER USER '${_DBN}'@'%' IDENTIFIED BY '${_DBP}';
EOFMYSQL
            _xoct_db_revoke_wildcard "${_DBN}" localhost
            _xoct_db_revoke_wildcard "${_DBN}" %
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
              mysqladmin -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp flush-privileges &> /dev/null
            else
              mysqladmin -u root flush-privileges &> /dev/null
            fi
            echo "INFO: site ${_Dom} db setup on ${_oct} complete"
          else
            echo "ALRT: site ${_Dom} db ${_DBN} already exists!"
          fi
          ### A dump is loaded over a database this run did NOT just create
          ### only when the site proved it its own (_OWN_DB). A site with no
          ### dump (target-native) writes nothing, so it is left to the branch
          ### below unchanged.
          if [ -e "${_USR}/src/${_DBN}" ] \
            && [ "${_DB_FRESH}" != "YES" ] && [ "${_OWN_DB}" != "YES" ]; then
            _XOCT_SITE_IMPORT_OK=NO
            _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
            _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_DBN}:not-owned"
            echo "ALRT: site ${_Dom} db ${_DBN} exists but the account cannot prove it owns it -- NOT loaded"
          elif [ -e "${_USR}/src/${_DBN}" ]; then
            if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
              _SQL_CONNECT=127.0.0.1
              _THIS_DB_PORT=6033
            fi
            [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL4 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
            if [ -x "/usr/local/bin/mydumper" ]; then
              _MYQUICK_ITD=$(mydumper -V 2>&1 \
                | tr -d "\n" \
                | tr -d "," \
                | tr -d "v" \
                | cut -d" " -f2 \
                | awk '{ print $1}' 2>&1)
              _DB_V=$(mysql -V 2>&1 \
                | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
                | head -1 \
                | cut -d"." -f1,2)
              _MD_V=$(mydumper --version 2>&1 \
                | tr -d "\n" \
                | cut -d" " -f6 \
                | awk '{ print $1}' \
                | cut -d"-" -f1 \
                | awk '{ print $1}' \
                | sed "s/[\,']//g" 2>&1)
              if [ "${_DEBUG_MODE}" = "YES" ]; then
                echo "INFO: Installed MyQuick ${_MYQUICK_ITD} for ${_MD_V} (${_DB_V})"
              fi
            fi
            _XOCT_SITE_IMPORT_OK=NO
            ### src/ is oN's on the target: the dump directory is entered as a
            ### real directory of the account (never through a link swapped for
            ### its name), and myloader reads it as ./ from inside, so --directory
            ### can only name the proven directory.
            ### mydumper writes metadata into the outputdir as its LAST act;
            ### a transferred dir without it is a partial/hollow dump and
            ### loading it would silently restore an incomplete database.
            ### The load is binlogged, so a replica of this box gets it too.
            _myloader_binlog_opts
            if ! _xoct_in_real_dir "${_USR}/src/${_DBN}" test -e ./metadata; then
              _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
              _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db import SKIPPED on ${_oct}: no restorable dump (metadata missing in src/${_DBN})"
            elif _xoct_in_real_dir "${_USR}/src/${_DBN}" myloader \
              --database=${_DBN} \
              --host=localhost \
              --defaults-file=/root/.my.cnf \
              --port=3306 \
              --directory=. \
              --threads=4 \
              --drop-table=DROP \
              "${_MYLOADER_BINLOG[@]}" \
              --verbose=2; then
              _XOCT_SITE_IMPORT_OK=YES
              echo "INFO: site ${_Dom} db import on ${_oct} complete"
            else
              _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
              _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db import FAILED on ${_oct}"
            fi
          else
            ### No transferred dump. A target-native site (the account's own
            ### pre-existing dedicated site is the common shape) legitimately
            ### has none — its database already lives here. Counting it made
            ### every import onto a non-empty account end INCOMPLETE (rc 1,
            ### xmass parks): the false positive the first suite leg caught.
            ### Only a site with NEITHER a dump NOR a populated local
            ### database is a real import failure.
            _XOCT_LOCAL_TBLS=$(mysql --silent -u root -N -B -e \
              "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='${_DBN}'" 2>/dev/null | tr -d ' \n')
            if [[ "${_XOCT_LOCAL_TBLS}" =~ ^[0-9]+$ ]] && [ "${_XOCT_LOCAL_TBLS}" -gt "0" ]; then
              _XOCT_SITE_IMPORT_OK=YES
              echo "INFO: site ${_Dom} has no transferred dump; local db ${_DBN} already populated (${_XOCT_LOCAL_TBLS} tables) -- target-native site, left as-is"
            else
              _XOCT_SITE_IMPORT_OK=NO
              _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
              _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_DBN}"
              echo "ALRT: site ${_Dom} db failure: no dump in ${_USR}/src/${_DBN} AND local db ${_DBN} is empty/absent"
            fi
          fi
          ### A verify over a failed import regenerates settings/vhost around
          ### a database that is not there -- schedule it only for clean loads.
          ### Before the rename (stage load) a clean load is only recorded:
          ### its verify runs after the rename, under the site's name there.
          if [ "${_XOCT_SITE_IMPORT_OK}" != "YES" ]; then
            [ "${_XOCT_SITES_STAGE}" = "load" ] \
              || echo "ALRT: site ${_Dom} verify NOT scheduled on ${_oct}: db import did not complete"
          elif [ "${_XOCT_SITES_STAGE}" = "load" ]; then
            if [ -n "${_SIDN}" ]; then
              _XOCT_LOADED_DIRS="${_XOCT_LOADED_DIRS} ${_SIDN}"
              _XOCT_LOADED_NAMES="${_XOCT_LOADED_NAMES} ${_SIDN}=${_Dom}"
            fi
          elif [ -e "${_USR}/.drush/${_Dom}.alias.drushrc.php" ]; then
            _run_drush8_hmr_cmd "hosting-task @${_Dom} verify --force$(_xoct_runner_wait_opt)"
            echo "INFO: site ${_Dom} verify on ${_oct} scheduled"
          else
            echo "ALRT: site ${_Dom} verify failure due to missing ${_USR}/.drush/${_Dom}.alias.drushrc.php"
          fi
        else
          ### Counted: a site whose credentials cannot be parsed was NOT
          ### imported -- the run must not end 0 with imported.pid over it.
          _XOCT_SITE_IMPORT_OK=NO
          _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
          _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_Dom}:empty-db-credentials"
          echo "ALRT: site ${_Dom} db failure due to an empty database name (${_DBN:-empty}) or password ($([ -n "${_DBP}" ] && echo set || echo empty))"
        fi
      elif [ "${_cmd}" = "export" ]; then
        ###
        ### HTTP-off via global.inc: per-account pid file blocks all sites
        ### on this Octopus with a 503 response. File contents (integer
        ### seconds) override the default Nginx microcache TTL of 300s.
        ### Replaces readonlymode which is unavailable via system drush 8
        ### on Drupal 8+ and bypassed by commerce/API code paths.
        ###
        ### static/ is the account's, so control and the pid name can be
        ### links, and -e is false for a dangling one: control is made a real
        ### directory from inside the real static/ and the pid is put inside
        ### it as a fresh file, never created through a link.
        _xoct_in_real_dir "${_USR}/static" _xoct_ctrl_dir_here
        if _xoct_in_real_dir "${_USR}/static/control" \
          _xoct_gate_put_here http-off.pid 3600 "${_oct}:${_OCT_GRP}"; then
          echo "INFO: account ${_oct} http-off pid created"
        fi
        ###
        ### Purge the fastcgi speed cache so already-cached 200 responses
        ### do not mask the 503. Without this, anon-cached homepages and
        ### other hot URLs would keep being served fresh for up to the
        ### configured 200 TTL (default 10s, longer if the site bumped
        ### speed_booster_anon_cache_ttl). Box-wide purge is acceptable:
        ### microcache repopulates within seconds on live sites.
        ###
        if [ -d "/var/lib/nginx/speed" ]; then
          find /var/lib/nginx/speed -type f -delete &> /dev/null
          echo "INFO: account ${_oct} fastcgi speed cache purged"
        fi
        if [ -x "/usr/local/bin/mydumper" ]; then
          _MYQUICK_ITD=$(mydumper -V 2>&1 \
            | tr -d "\n" \
            | tr -d "," \
            | tr -d "v" \
            | cut -d" " -f2 \
            | awk '{ print $1}' 2>&1)
          _DB_V=$(mysql -V 2>&1 \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
            | head -1 \
            | cut -d"." -f1,2)
          _MD_V=$(mydumper --version 2>&1 \
            | tr -d "\n" \
            | cut -d" " -f6 \
            | awk '{ print $1}' \
            | cut -d"-" -f1 \
            | awk '{ print $1}' \
            | sed "s/[\,']//g" 2>&1)
          if [ "${_DEBUG_MODE}" = "YES" ]; then
            echo "INFO: Installed MyQuick ${_MYQUICK_ITD} for ${_MD_V} (${_DB_V})"
          fi
        fi
        ### Only a database the site proved its own is dumped (see _OWN_DB).
        if [ "${_DIR_OK}" != "YES" ]; then
          _XOCT_EXPORT_FAIL=$(( ${_XOCT_EXPORT_FAIL:-0} + 1 ))
          _XOCT_EXPORT_FAILED_DBS="${_XOCT_EXPORT_FAILED_DBS} ${_Dom}:site-path-refused"
          echo "ALRT: site ${_Dom} on ${_oct}: site_path refused -- NOT dumped"
        elif [ "${_OWN_DB}" != "YES" ]; then
          _XOCT_EXPORT_FAIL=$(( ${_XOCT_EXPORT_FAIL:-0} + 1 ))
          _XOCT_EXPORT_FAILED_DBS="${_XOCT_EXPORT_FAILED_DBS} ${_DBN:-${_Dom}}:not-owned"
          echo "ALRT: site ${_Dom} on ${_oct}: cannot prove ${_DBN:-its database} is the account's own -- NOT dumped"
        else
        ### src/ is oN's: the per-db directory is made a real directory here (a
        ### link the account put at its name is removed) and mydumper writes it
        ### as ./ from inside, so --clear can only act on the proven directory.
        _xoct_in_real_dir "${_USR}/src" _xoct_realdir_here "${_DBN}"
        ### Any non-transactional table makes mydumper abort the whole
        ### database unless --trx-tables=0 is passed; mirrors mysql_backup.sh.
        _NON_TRX_COUNT=$(mysql -u root -s -N -e "SELECT COUNT(*) FROM \
information_schema.TABLES WHERE TABLE_SCHEMA='${_DBN}' AND \
TABLE_TYPE='BASE TABLE' AND ENGINE IS NOT NULL AND \
ENGINE NOT IN ('InnoDB')" 2> /dev/null)
        _MYDUMPER_TRX_OPT=""
        if [[ "${_NON_TRX_COUNT}" =~ ^[0-9]+$ ]] && [[ "${_NON_TRX_COUNT}" -gt "0" ]]; then
          _MYDUMPER_TRX_OPT="--trx-tables=0"
        fi
        ### mydumper 1.x fixed the adaptive chunker (0.21.x truncated a chunk's
        ### file to 0 bytes when a split landed past the last existing key,
        ### exiting clean), so on 1.x tables are chunked and dumped in parallel
        ### again; older builds keep chunking off (--rows=-1). A fixed --rows=N
        ### walks a sparse key span to inode exhaustion; mirrors mysql_backup.sh.
        ### Probed per call and anchored on the banner line, as in the
        ### nightly: a stray line ahead of it cannot pass as a version.
        _MYDUMPER_ROWS_OPT="--rows=-1"
        _MYDUMPER_MAJOR=$(mydumper -V 2>&1 | grep -m1 "^mydumper v" | cut -d" " -f2 | tr -d "v" | cut -d"." -f1)
        case "${_MYDUMPER_MAJOR}" in
          [1-9]*) _MYDUMPER_ROWS_OPT="" ;;
        esac
        ### The site's triggers, routines and events go with its tables.
        _mydumper_objects_opts
        ### _MYDUMPER_TRX_OPT and _MYDUMPER_ROWS_OPT unquoted by design: empty must expand to no argument.
        if _xoct_in_real_dir "${_USR}/src/${_DBN}" mydumper ${_MYDUMPER_TRX_OPT} \
          --database=${_DBN} \
          --host=localhost \
          --defaults-file=/root/.my.cnf \
          --port=3306 \
          --outputdir=. \
          ${_MYDUMPER_ROWS_OPT} \
          "${_MYDUMPER_OBJECTS[@]}" \
          --build-empty-files \
          --threads=4 \
          --long-query-guard=900 \
          --clear \
          --verbose=2 \
          && _xoct_in_real_dir "${_USR}/src/${_DBN}" test -e ./metadata; then
          echo "INFO: site ${_Dom} db export on ${_oct} complete"
        else
          ### Counted, not just echoed: the run verdict must never stamp
          ### exported.pid over a failed or hollow site dump.
          _XOCT_EXPORT_FAIL=$(( ${_XOCT_EXPORT_FAIL:-0} + 1 ))
          _XOCT_EXPORT_FAILED_DBS="${_XOCT_EXPORT_FAILED_DBS} ${_DBN}"
          echo "ALRT: site ${_Dom} db export FAILED on ${_oct}"
        fi
        fi
      elif [ "${_cmd}" = "proxy" ]; then
        if { [ -e "${_USR}/log/exported.pid" ] \
          || { [ "${_XOCT_FORCE}" = "YES" ] \
          && [ -e "${_USR}/log/export_failed.pid" ]; }; } \
          && [ ! -z "${_tgt}" ]; then
          if [ ! -s "/var/xdrago/conf/proxy.conf" ] \
            && ! { [ -n "${_XOCT_TARGET_FQDN}" ] \
              && _xoct_named_under_host "${_Dom}" "${_XOCT_MY_FQDN}"; }; then
            ### Checked BEFORE the real vhost is moved aside: with the template
            ### gone the copy below fails quietly, the site is left with no :80
            ### server block at all and was still counted as converted. A
            ### renamed site's redirect is written inline and needs no template.
            _XOCT_PROXY_FAIL=$(( ${_XOCT_PROXY_FAIL:-0} + 1 ))
            echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed: /var/xdrago/conf/proxy.conf is missing or empty"
          elif [ -e "${_Vht}" ]; then
            ### On a repair ${_Vht} is already a proxy vhost, whose name list a
            ### previous repair could have narrowed. The saved real vhost is the
            ### authoritative source, so prefer it whenever it exists.
            _NMS_SRC="${_Vht}"
            if _xoct_vh_has "${_Vht%/*}" "${_Dom}" "Plain HTTP proxy (START)" \
              && [ -e "${_Vhd}" ]; then
              _NMS_SRC="${_Vhd}"
            fi
            ### vhost.d is oN's: the names are read inside the real directory,
            ### and only host-name words reach the server_name line built below.
            _NMS=`_xoct_read_in "${_NMS_SRC%/*}" "${_NMS_SRC##*/}" | grep "server_name" | sed "s/server_name//g; s/;//g" | sort | uniq | tr -d "\n" | sed "s/  / /g; s/  / /g; s/  / /g" | sort | uniq`
            _NMS="$(_xoct_host_words "${_NMS}")"
            ### B2: the template references THREE cert files unconditionally
            ### (openssl.key, openssl_chain.crt and the LE chain.pem), so every
            ### one of them must exist before it is written. nginx refuses to
            ### load a server block whose certificate file is missing, and the
            ### render is box-wide -- one account's partial cert dir fails
            ### `nginx -t` and takes the whole conversion down with it. Probing
            ### the key alone is inherited from the old tool (xboa-old:428-429)
            ### and has the same hole; what the rewrite added is a configtest
            ### and revert, which is recovery rather than prevention. A site
            ### that is missing any of the three cannot serve 443 whether or
            ### not the vhost is written, so skipping it costs nothing and is
            ### reported by name below.
            _SSL_MISSING=$(_xoct_ssl_material_missing "${_USR}" "${_Dom}")
            if [ -z "${_SSL_MISSING}" ] \
              && [ -e "/var/xdrago/conf/https_proxy_le.conf" ]; then
              ### Save the site's REAL https vhost before the proxy template
              ### lands on top of it, exactly as ${_Vht} is saved below. It was
              ### being overwritten with no backup, so the configtest revert
              ### could only delete https.<dom> and leave the site with NO 443
              ### server block at all -- while announcing "reverted to the
              ### pre-conversion vhosts", which was untrue for TLS. Preserve
              ### the FIRST copy only: on a repair pass ${_Vhs} is already the
              ### proxy template and would destroy the saved original.
              ### vhost.d is oN's: the save, the template render and the
              ### rewrites all run inside the real directory on ./names. The
              ### site's real https vhost is copied to the dot-backup as a fresh
              ### file, the proxy template is rendered into a fresh file (not
              ### cp -a onto the name then sed -i), and a link the account put
              ### at any name is replaced, never written or read through.
              if [ ! -f "${_Vhs%/*}/.https.${_Dom}" ]; then
                _xoct_in_real_dir "${_Vhs%/*}" _xoct_sed_to \
                  "https.${_Dom}" ".https.${_Dom}" ''
              fi
              _xoct_in_real_dir "${_Vhs%/*}" _xoct_tpl_to_here \
                /var/xdrago/conf/https_proxy_le.conf "https.${_Dom}" \
                "${_oct}:${_OCT_GRP}" \
                -e "s/.*server_name.*;/  server_name  ${_NMS};/g" \
                -e "s/_target_ip/${_tgt}/g" \
                -e "s/_oct_uid/${_oct}/g" \
                -e "s/_domain_name/${_Dom}/g"
              ### The renamed-site redirect (see the HTTP vhost below): keep
              ### the template's listen/TLS lines -- the old name still has
              ### its certificate here -- and answer every path with the 301
              ### instead of proxying to a name the target no longer serves.
              if [ -n "${_XOCT_TARGET_FQDN}" ] \
                && _xoct_named_under_host "${_Dom}" "${_XOCT_MY_FQDN}"; then
                _xoct_in_real_dir "${_Vhs%/*}" _xoct_sed_here "https.${_Dom}" \
                  -e "/^  location /,/^  }/d" \
                  -e "s|^  log_not_found .*|&\n  return 301                   \$scheme://${_Dom//${_XOCT_MY_FQDN}/${_XOCT_TARGET_FQDN}}\$request_uri;|"
              fi
              _xoct_vhd_reassert "${_Vhs%/*}" "${_oct}:${_OCT_GRP}" "https.${_Dom}"
            elif [ -d "${_USR}/config/server_master/ssl.d/${_Dom}" ]; then
              ### The silent shape behind the manual "confirm https.* vhosts
              ### exist" post-check: the site has SSL material but never went
              ### through hosting_le's symlink pass, so no HTTPS proxy vhost
              ### can be written. Count and name it -- the operator must see
              ### this in the conversion output, not discover dead 443 later.
              ### Name the file(s) actually missing: with the gate widened, a
              ### present openssl.key is no longer proof of what failed.
              _XOCT_PROXY_NOSSL="${_XOCT_PROXY_NOSSL} ${_Dom}"
              echo "ALRT: site ${_Dom} on ${_oct}: NO HTTPS proxy vhost written -- missing:${_SSL_MISSING}"
            fi
            ### Fail closed on TLS. When no HTTPS proxy vhost could be written,
            ### the site's REAL https vhost must not stay live beside the
            ### converted :80 one: the account gate is lifted below, so plain
            ### HTTP would reach the new box while HTTPS kept serving -- and
            ### taking writes into -- the local database that has already
            ### moved. Park it under the first-backup rule (the revert puts it
            ### back); HTTPS then fails at the handshake, visibly, which is
            ### what the report below tells the operator.
            if [ -f "${_Vhs}" ] \
              && ! _xoct_vh_has "${_Vhs%/*}" "https.${_Dom}" "Secure HTTPS proxy"; then
              ### Parked inside the real vhost.d, on ./names.
              if [ ! -f "${_Vhs%/*}/.https.${_Dom}" ]; then
                _xoct_in_real_dir "${_Vhs%/*}" mv -f -T -- \
                  "./https.${_Dom}" "./.https.${_Dom}"
              else
                _xoct_in_real_dir "${_Vhs%/*}" rm -f -- "./https.${_Dom}"
              fi
              case " ${_XOCT_PROXY_NOSSL} " in
                *" ${_Dom} "*) ;;
                *) _XOCT_PROXY_NOSSL="${_XOCT_PROXY_NOSSL} ${_Dom}" ;;
              esac
              echo "ALRT: site ${_Dom} on ${_oct}: its local HTTPS vhost is parked (saved as .https.${_Dom}) -- no HTTPS until the keys exist and a --repair runs"
            fi
            ### Preserve the FIRST backup only. On a repair pass ${_Vht} is
            ### already the proxy template, and mv -f would overwrite ${_Vhd}
            ### with it -- destroying the only surviving copy of the real vhost
            ### and with it any chance of reverting or re-harvesting the names.
            _VHT_IS_PROXY=NO
            _xoct_vh_has "${_Vht%/*}" "${_Dom}" "Plain HTTP proxy (START)" \
              && _VHT_IS_PROXY=YES
            if [ "${_VHT_IS_PROXY}" = "YES" ] && [ -e "${_Vhd}" ]; then
              echo "INFO: site ${_Dom} on ${_oct}: proxy vhost already in place, keeping saved ${_Vhd}"
            else
              _xoct_in_real_dir "${_Vht%/*}" mv -f -T -- "./${_Dom}" "./.${_Dom}"
              ### What THIS run moved aside for the first time: the only
              ### vhosts a failed configtest may put back on a repair pass.
              _XOCT_FIRST_BACKUP_DOMS="${_XOCT_FIRST_BACKUP_DOMS} ${_Dom}"
            fi
            ### A site named under THIS box's own hostname is renamed on the
            ### target by the cutover, so its old name no longer exists
            ### there: proxying it forwards to the target's catch-all. When
            ### the caller names the target's hostname -- which a whole-server
            ### move does only AFTER the renames -- the old name is answered
            ### with a 301 to the renamed site instead.
            ### The control panel is never proxied and is not a
            ### site of this loop. The redirect keeps HTTPS for a visitor
            ### who reached this port through the wildcard SSL front, which
            ### says so in X-Forwarded-Proto.
            _REDIR_TO=""
            if [ -n "${_XOCT_TARGET_FQDN}" ] \
              && _xoct_named_under_host "${_Dom}" "${_XOCT_MY_FQDN}"; then
              _REDIR_TO="${_Dom//${_XOCT_MY_FQDN}/${_XOCT_TARGET_FQDN}}"
            fi
            if [ -n "${_REDIR_TO}" ]; then
              ### Written as a fresh file inside the real vhost.d, owned by
              ### the account from the start, so a link the account put at
              ### the name is replaced, never written through.
              cat <<REDIR | _xoct_in_real_dir "${_Vht%/*}" _xoct_write_here "${_Dom}" 077 "${_oct}:${_OCT_GRP}"
###
### Plain HTTP proxy (START) -- renamed site: redirect to its new name
###
server {
  listen                       *:80;
  server_name                  ${_NMS};
  access_log                   off;
  log_not_found                off;
  set                          \$boa_visitor_scheme \$scheme;
  if (\$http_x_forwarded_proto = "https") {
    set                        \$boa_visitor_scheme "https";
  }
  return 301                   \$boa_visitor_scheme://${_REDIR_TO}\$request_uri;
}
###
### Plain HTTP proxy (END)
###
REDIR
              echo "INFO: site ${_Dom} on ${_oct}: renamed by the cutover, its old name answers 301 to ${_REDIR_TO}"
            else
              ### Rendered from the template into a fresh file inside the real
              ### vhost.d (not cp -a onto the name then sed -i).
              _xoct_in_real_dir "${_Vht%/*}" _xoct_tpl_to_here \
                /var/xdrago/conf/proxy.conf "${_Dom}" "${_oct}:${_OCT_GRP}" \
                -e "s/.*server_name.*;/  server_name  ${_NMS};/g" \
                -e "s/_target_ip/${_tgt}/g"
            fi
            _xoct_vhd_reassert "${_Vht%/*}" "${_oct}:${_OCT_GRP}" "${_Dom}"
            _XOCT_PROXY_OK=$(( ${_XOCT_PROXY_OK:-0} + 1 ))
            ### Remember what THIS run rewrote: a configtest failure must
            ### revert only these, never a previous conversion's vhosts.
            _XOCT_CONVERTED_DOMS="${_XOCT_CONVERTED_DOMS} ${_Dom}"
            echo "INFO: site ${_Dom} proxy conversion on ${_oct} complete"
          else
            ### Counted, not just echoed: the caller must never mail "migration
            ### complete" nor stamp proxied.pid over a failed conversion.
            _XOCT_PROXY_FAIL=$(( ${_XOCT_PROXY_FAIL:-0} + 1 ))
            echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed due to missing ${_Vht}"
          fi
        else
          _XOCT_PROXY_FAIL=$(( ${_XOCT_PROXY_FAIL:-0} + 1 ))
          echo "ALRT: site ${_Dom} proxy conversion on ${_oct} failed: missing log/exported.pid or empty tgt/${_tgt}"
          if [ -e "${_USR}/log/export_failed.pid" ]; then
            echo "ALRT: export_failed.pid is present -- re-run a clean 'xoct export${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}', or convert"
            echo "ALRT: anyway with 'xoct proxy ${_oct} ${_tgt} --force${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}' (accepts the partial export)"
          fi
        fi
      fi
    fi
  done
}

### A migrated account arrives carrying the SOURCE box's per-release FPM
### markers under static/control. Both boxes run the same release, so the
### target's manage_ltd_users reads .multi-fpm.<tree>.<xSrl>.pid as "pool
### set already built for this release" and never creates pools for the
### versions that exist only HERE -- exactly the interpreters prep-target's
### --fix-php just built for the carried per-site pins. .multi-nginx-fpm.pid
### gates the per-site $user_socket includes the same way. The result is a
### pinned site silently served by the account's DEFAULT pool, for good:
### nothing re-triggers until the release serial moves or the pin file's
### CONTENT changes. Clearing the markers hands the work back to the normal
### sweep. Two passes by design -- the include generator refuses to emit a
### site include until that pool's socket exists, so the pools must be built
### first. (.prev-multi-fpm.info is deliberately NOT touched: the sweep
### recreates it from the live file before diffing, so removing it proves
### nothing and only hides the real lever.)
### The carried FPM markers, removed in the current (pinned) control
### directory: the globs expand here, never in the caller's directory.
_xoct_rm_fpm_markers_here() {
  rm -f -- ./.multi-fpm.*.pid ./.single-fpm.*.pid ./.multi-nginx-fpm.pid
}
### The dumps in the current (pinned) src/ directory removed: the glob
### expands here, never in a directory a link put in its place names.
_xoct_rm_sql_dumps_here() {
  rm -f -- ./*.sql
}
_xoct_heal_fpm_pins() {
  local _acct="$1"
  local _root="/data/disk/${_acct}"
  local _ctl="${_root}/static/control"
  local _pin _dom _ver _missing="" _ltd=/var/xdrago/manage_ltd_users.sh
  ### the account's own directory, entered for real: never a link, and the
  ### pin file read without following one or opening a FIFO
  _xoct_in_real_dir "${_ctl}" true || return 0
  [ -e "${_ctl}/multi-fpm.info" ] || return 0
  ### Deletes only; nothing is created here, and the sweep re-chowns the
  ### .info files it touches -- so no root-owned residue is left behind in
  ### the account's control dir.
  _xoct_in_real_dir "${_ctl}" _xoct_rm_fpm_markers_here
  echo "INFO: cleared carried FPM pool markers for ${_acct}; rebuilding pinned pools"
  ### pre-mig parks the worker as .manage_ltd_users.sh.off until post-mig;
  ### import runs with cron stopped, so the parked copy is run here.
  [ -e "${_ltd}" ] || _ltd=/var/xdrago/.manage_ltd_users.sh.off
  if [ -e "${_ltd}" ]; then
    bash "${_ltd}" &> /dev/null
    ### The sockets exist now; re-arm the include generator for pass two.
    _xoct_in_real_dir "${_ctl}" rm -f -- ./.multi-nginx-fpm.pid
    bash "${_ltd}" &> /dev/null
  else
    _ltd=/var/xdrago/manage_ltd_users.sh
  fi
  ### Verify every pinned version really has a live pool socket, and name
  ### the ones that do not -- a silent wrong-interpreter site is the whole
  ### failure this heal exists to prevent.
  while read -r _dom _ver; do
    case "${_dom}" in ''|place.holder*) continue ;; esac
    [ -z "${_ver}" ] && continue
    _ver="${_ver//[^0-9]/}"
    [ -z "${_ver}" ] && continue
    if [ ! -S "/run/${_acct}.${_ver}.fpm.socket" ]; then
      _missing="${_missing} ${_dom}:${_ver}"
    fi
  done <<< "$(_xoct_read_in "${_ctl}" multi-fpm.info)"
  if [ ! -z "${_missing}" ]; then
    echo "ALRT: account ${_acct}: pinned PHP pool(s) NOT live after heal:${_missing}"
    echo "ALRT: those sites are being served by the account default pool --"
    echo "ALRT: check /opt/php<NN>/bin/php exists here and re-run:"
    echo "ALRT:   bash ${_ltd}"
  else
    echo "INFO: account ${_acct}: every pinned PHP pool is live"
  fi
}

_xoct_runtime_oct() {
  if [ "${_cmd}" = "import" ] && [ ! -z "${_dst}" ]; then
    echo "${_dst}"
  else
    echo "${_oct}"
  fi
}

# Group ownership on the target after a transfer, same-name or rename. rsync
# maps ids by NAME: the source account's private group (per-instance group
# model) has no name on the target unless the target account is converted
# too, so every path of the source tree lands in an unassigned numeric gid
# there; and the literal ':users' writes this tool still makes on the target
# (control files, the users store) are right only on an unconverted account.
# Re-group, on the target, every path of the account's roots that is in no
# group or in the box-wide group to the account's own group there ('users'
# until the target account is converted), group-only and symlink-safe, and
# drop a conversion marker carried from the source: it records the SOURCE
# box's conversion, and instgrp status would read it as a lie.
#
# Re-group an account's tree ON A REMOTE BOX after a copy landed there
# (transfer, sync, cutover): the copy carries this box's numeric gids, and
# on the destination those are no group at all or -- every box allocates
# account gids from the same system range -- ANOTHER account's group, whose
# identities could then read the copied credential files. instgrp reclaim
# does the whole pass where it is installed (every root incl. the sub-user
# homes and a relocated store, the marker rule, the DRIFT verdict); a
# destination without the tool gets the inline form over the same roots.
# The destination is converted when its account group exists and the
# backend or the shell identity carries it as primary (one identity that
# fell back to 'users' must not turn this into a flatten). Returns the
# pass's rc (0 clean, 2 drift left, 3 identities disagree, 4 deferred: a
# BOA run stayed live there for the whole bounded wait, so the inline form
# ran instead of the tool). Verbatim in xoct, xcopy and xmass.
# $1 = account on the destination, $2 = destination host.
_acct_regroup_remote() {
  local _X_A="$1" _X_H="$2" _X_RC
  [ -n "${_X_A}" ] && [ -n "${_X_H}" ] || return 0
  ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${_X_H}" "bash -s" <<REMOTE
_A='${_X_A}'
_DEFERRED=0
if [ -x /opt/local/bin/instgrp ]; then
  # A live run on the destination (its own octopus finisher, a tool
  # refresh) makes reclaim defer with rc 4 for a short window; wait it out,
  # bounded. When it never clears, the inline form below runs instead: a
  # destination carrying log/proxied.pid is never visited by the nightly
  # (owl.sh skips it), so the pass must complete here or not at all.
  _T=0
  while :; do
    # --force: the destination's own log/proxied.pid is its demotion artefact
    # from an earlier cutover (a failback), not "served from elsewhere"; the
    # tree this run just wrote is exactly what needs the file half, and the
    # tool's freeze gate would otherwise refuse it for good
    bash /opt/local/bin/instgrp reclaim "\${_A}" --force
    _R=\$?
    [ "\${_R}" = "4" ] || exit "\${_R}"
    [ "\${_T}" -lt 12 ] || { _DEFERRED=1; break; }
    _T=\$((_T + 1))
    sleep 15
  done
fi
_G=users
if getent group "\${_A}" > /dev/null 2>&1; then
  [ "\$(id -gn "\${_A}" 2>/dev/null)" = "\${_A}" ] && _G="\${_A}"
  [ "\$(id -gn "\${_A}.ftp" 2>/dev/null)" = "\${_A}" ] && _G="\${_A}"
fi
_MP=""; _N=0
for _M in /mnt/*; do
  [ -d "\${_M}" ] && mountpoint -q "\${_M}" 2>/dev/null && { _MP="\${_M}"; _N=\$((_N + 1)); }
done
[ "\${_N}" = "1" ] || _MP=""
_GI="\$(getent group "\${_G}" 2>/dev/null | cut -d: -f3)"
_WG="\$(getent group www-data 2>/dev/null | cut -d: -f3)"
case "\${_GI}" in ''|*[!0-9]*) _GI="" ;; esac
case "\${_WG}" in ''|*[!0-9]*) _WG=-1 ;; esac
# the account's own web group there, when it exists: its paths are the
# pools' and are never claimed (by number: find refuses an unknown name)
_XW="\$(getent group "wg-\${_A}" 2>/dev/null | cut -d: -f3)"
_WGX=()
case "\${_XW}" in ''|*[!0-9]*) _XW=-1 ;; *) _WGX=( ! -gid "\${_XW}" ) ;; esac
for _R in "/data/disk/\${_A}" "/home/\${_A}.ftp" /home/"\${_A}".* "/opt/user/gems/\${_A}" /opt/user/gems/"\${_A}".* "/opt/user/npm/\${_A}" /opt/user/npm/"\${_A}".* "\${_MP:+\${_MP}/files/\${_A}/static/files}"; do
  [ -n "\${_R}" ] && [ -d "\${_R}" ] && [ ! -L "\${_R}" ] || continue
  # the FPM pool users' homes (oN.web, oN.NN.web) are www-data's, never the
  # account's: the same root set the tool walks
  case "\${_R}" in /home/*.web) continue ;; esac
  # regrouped through a no-follow handle on each name inside the directory
  # find holds, never by name: only a directory, or a regular file with one
  # link, whose handle is still in none of those groups, so a hard link to
  # another file renamed in (or put there) is never regrouped; a link's own
  # group grants nothing and is left
  [ -n "\${_GI}" ] || continue
  find -P "\${_R}" ! -group "\${_G}" ! -group www-data ! -group root "\${_WGX[@]}" \( -type f -o -type d \) \
    -execdir perl -e 'use Fcntl; my (\$g, \$w, \$x) = splice(@ARGV, 0, 3); for my \$n (@ARGV) { sysopen(my \$h, \$n, O_RDONLY|O_NOFOLLOW|O_NONBLOCK) or next; my @s = stat(\$h); chown(-1, \$g, \$h) if @s && \$s[5] != \$g && \$s[5] != \$w && \$s[5] != \$x && \$s[5] != 0 && (-d _ || (-f _ && \$s[3] == 1)); close(\$h); } exit 0' -- "\${_GI}" "\${_WG}" "\${_XW}" {} + 2>/dev/null
done
# log/ is the account's own: the record is read and removed only inside the
# real directory, never through a link or into a FIFO put there
_W="\$(cd -P /data/disk 2>/dev/null && pwd -P)/\${_A}/log"
( cd -P -- "/data/disk/\${_A}/log" 2>/dev/null && [ "\$(pwd -P)" = "\${_W}" ] \
    && [ -f ./instance-group.txt ] || exit 0
  _GID=\$(getent group "\${_A}" 2>/dev/null | cut -d: -f3)
  { [ "\${_G}" = "\${_A}" ] \
    && timeout 10 dd if=./instance-group.txt iflag=nofollow,nonblock,fullblock \
      bs=1048576 count=1 status=none 2>/dev/null | grep -q " gid=\${_GID}\$"; } \
    || rm -f -- ./instance-group.txt )
if [ "\${_DEFERRED}" = "1" ]; then
  echo "INFO: target group pass for \${_A}: the tool deferred 13 times (a BOA run live there); the inline form ran instead, group \${_G}"
  exit 4
fi
echo "INFO: target group pass for \${_A}: group \${_G} (inline form, instgrp not installed there)"
exit 0
REMOTE
  _X_RC=$?
  [ "${_X_RC}" = "0" ] || echo "ALERT: target group pass for ${_X_A} on ${_X_H} returned ${_X_RC} (2 drift left, 3 identities disagree, 4 deferred (the inline form ran), 255 ssh); run 'instgrp status ${_X_A}' there"
  return "${_X_RC}"
}

_xoct_regroup_target_account() {
  _acct_regroup_remote "$1" "$2"
}

### On a rename the account's identities here map onto the destination's of
### the same suffix (<src> onto <dst>, <src>.ftp onto <dst>.ftp, a client's
### <src>.<name> onto <dst>.<name>): by name alone the copy would be owned by
### the target's own identity of the source's name (another tenant's) or by
### this box's numbers until the rename's owner pass (which re-owns <src>,
### <src>.ftp and the web users; a client login's files it leaves), and a
### run that stops before it leaves them so.
### An identity whose new name the target does not have (yet: a client's
### login comes with the limited-shell worker) maps onto <dst> itself, so the
### target's identities are asked; a list that cannot be read is refused,
### never guessed (a DENY, the dry run is not clean, a live run stops). The
### map names every identity: no wildcard, which an older rsync would hand
### to the receiving shell. Sets _XOCT_UMAP; empty when the names are the same.
_xoct_acct_umap() {   # 1 account here 2 account on the target 3 target
  local _n _t _have="" _m=""
  _XOCT_UMAP=""
  [ "${1}" != "${2}" ] || return 0
  if [[ "${1}" =~ ^[a-zA-Z0-9_-]+$ ]] && [[ "${2}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    _have=$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${3}" \
      "getent passwd | cut -d: -f1 | grep -E '^${2}(\.[a-zA-Z0-9._-]+)?\$' | sed 's/^/XMID:/'" \
      2>/dev/null | grep -x -E 'XMID:[a-zA-Z0-9._-]+' | cut -d: -f2)
  fi
  if ! grep -qxF -- "${2}" <<< "${_have}"; then
    echo "DENY: could not read the identities of ${2} on ${3}, or ${2} is not installed there yet; the copy of ${1} is never owned by a guessed name"
    _XOCT_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && exit 1
    return 1
  fi
  for _n in $(getent passwd | cut -d: -f1 | grep -E "^${1}(\.[a-zA-Z0-9._-]+)?$"); do
    _t="${2}${_n#"${1}"}"
    grep -qxF -- "${_t}" <<< "${_have}" || _t="${2}"
    _m="${_m:+${_m},}${_n}:${_t}"
  done
  _XOCT_UMAP="${_m}"
  return 0
}

### The account's own group here (its per-account group, while it holds
### one) maps onto the group the target account holds there: its own once
### converted there, 'users' until then. By name alone the copy lands in a
### group of that name there (another account's, or one held for a later
### one) or, where the name is absent, in this box's number, and a run that
### stops before its destination pass, or has none, leaves it so. Sets
### _XOCT_AMAP; empty when no group of the account's name exists here (a group
### that outlives its move back to 'users' is mapped too: its paths land
### where the destination pass would put them). An answer that cannot be
### read is refused, never guessed: a DENY, the dry run is not clean, a live
### run stops.
_xoct_acct_gmap() {   # 1 account here 2 account on the target 3 target
  local _g=""
  _XOCT_AMAP=""
  getent group "${1}" > /dev/null 2>&1 || return 0
  case "${2}" in
    ''|*[!a-z0-9-]*)
      echo "DENY: ${2} is not an account name; the paths of ${1}'s group never land in a guessed group"
      _XOCT_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && exit 1
      return 1
      ;;
    *)
      _g=$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${3}" \
        "getent group '${2}' > /dev/null 2>&1 && { [ \"\$(id -gn '${2}' 2>/dev/null)\" = '${2}' ] || [ \"\$(id -gn '${2}.ftp' 2>/dev/null)\" = '${2}' ]; } && echo 'XMAG:${2}' || echo 'XMAG:users'" \
        2>/dev/null | grep -m1 -x -E 'XMAG:[a-z0-9-]+' | cut -d: -f2)
      ;;
  esac
  case "${_g}" in
    "${2}"|users) _XOCT_AMAP="${1}:${_g}" ;;
    *)
      echo "DENY: could not read the group of ${2} on ${3}; the paths of ${1}'s group never land in a guessed group"
      _XOCT_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && exit 1
      return 1
      ;;
  esac
  return 0
}

### An account converted to its own web group here (its web paths in
### wg-<account>, private/ 02770/0660) must not land on a target whose tools
### predate the web group: their claim passes and nightly would hand those
### paths back. The target's instgrp, which the destination pass runs, is
### asked; an answer that cannot be read counts as no. While the account
### holds a web group here, its legs map it onto the one the target's
### writers give the target account (_XOCT_GMAP): by name alone its paths
### would land in a number that is no group there, or another account's;
### an answer that cannot be read is refused, never guessed.
### A refusal is a DENY: the dry run is not clean, a live run stops.
_xoct_webgroup_gate() {   # 1 account here 2 account on the target 3 target
  local _st _ans _wg
  _XOCT_GMAP=""
  _st=$(_web_group_state "${1}" | cut -d' ' -f1)
  [ "${_st}" = "none" ] && return 0
  case "${_st}" in
    converted|phaseb)
      _ans=$(ssh -o BatchMode=yes -o ConnectTimeout=15 root@"${3}" \
        "grep -q '^_web_group_state() {' /opt/local/bin/instgrp 2>/dev/null && echo XMWG-READY || echo XMWG-OLD" \
        2>/dev/null | grep -m1 -x -E 'XMWG-(READY|OLD)')
      if [ "${_ans}" != "XMWG-READY" ]; then
        echo "DENY: ${1} uses its own web group here, and the tools on ${3} predate it (or could not be asked); bring ${3} to this BOA release (barracuda AND octopus) first"
        _XOCT_NOT_CLEAN=YES
        [ "${_MODE}" = "LIVE" ] && exit 1
        return 1
      fi
      ;;
  esac
  _wg=$(_web_group_on_target "${2}" "${3}") || _wg=""
  if [ -z "${_wg}" ]; then
    echo "DENY: could not read the web group of ${2} on ${3}; the web paths of ${1} never land in a guessed group"
    _XOCT_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && exit 1
    return 1
  fi
  _XOCT_GMAP="wg-${1}:${_wg}"
  return 0
}

_xoct_rewrite_target_account_refs() {
  _X_SRC_OCT="$1"
  _X_DST_OCT="$2"
  _X_TGT_HOST="$3"
  _X_DST_USR="$4"
  _X_TGT_MNT="$5"

  if [ -z "${_X_SRC_OCT}" ] || [ -z "${_X_DST_OCT}" ] || [ -z "${_X_TGT_HOST}" ] || [ -z "${_X_DST_USR}" ]; then
    return 0
  fi
  if [ "${_X_SRC_OCT}" = "${_X_DST_OCT}" ]; then
    return 0
  fi
  case "${_X_DST_USR}" in
    "/data/disk/${_X_DST_OCT}") ;;
    *) return 0 ;;
  esac

  echo "INFO: rename mode active on target ${_X_TGT_HOST}: rewriting refs ${_X_SRC_OCT} -> ${_X_DST_OCT} in selected text configs"
  # Heredoc (not a nested one-liner) so the fpm socket-token rewrite -- which
  # carries literal double quotes -- stays readable. Local vars (_X_SRC_OCT
  # etc.) expand here before ssh; remote-only vars are \-escaped. A subdir.d
  # conf lives one level down, in its domain's directory. The account tree
  # is the tenant's on the target: every directory is entered as the real
  # one (every name from /data/disk down), each file is rewritten as
  # _xoct_sed_here does it (owner and mode kept, never through a link or
  # into a FIFO), and links and owners are changed with ./names inside the
  # directory find holds open. The source identities' uids on this box
  # (the FPM pool users <oN>.web and <oN>.NN.web as name:uid words) and the
  # target's attached mount go with it for the owner remap.
  local _X_SU _X_SF _X_SW="" _n _p _u _m _r
  _X_SU="$(id -u "${_X_SRC_OCT}" 2> /dev/null)"
  _X_SF="$(id -u "${_X_SRC_OCT}.ftp" 2> /dev/null)"
  [[ "${_X_SU}" =~ ^[0-9]+$ ]] || _X_SU=""
  [[ "${_X_SF}" =~ ^[0-9]+$ ]] || _X_SF=""
  while IFS=: read -r _n _p _u _r; do
    case "${_n}" in
      "${_X_SRC_OCT}.web") ;;
      "${_X_SRC_OCT}".*.web)
        _m="${_n#"${_X_SRC_OCT}".}"
        [[ "${_m%.web}" =~ ^[0-9]+$ ]] || continue
        ;;
      *) continue ;;
    esac
    [[ "${_u}" =~ ^[0-9]+$ ]] || continue
    _X_SW="${_X_SW}${_X_SW:+ }${_n}:${_u}"
  done <<< "$(getent passwd 2> /dev/null)"
  [[ "${_X_TGT_MNT}" =~ ^/mnt/[A-Za-z0-9._-]+$ ]] || _X_TGT_MNT=""
  ssh root@"${_X_TGT_HOST}" "bash -s" <<REMOTE
_SRC='${_X_SRC_OCT}'
_DST='${_X_DST_OCT}'
_SU='${_X_SU}'
_SF='${_X_SF}'
_SW='${_X_SW}'
_TM='${_X_TGT_MNT}'
$(declare -f _xoct_real_want _xoct_read_here _xoct_sed_to _xoct_sed_here)
_xo_in() {
  local _d="/data/disk/\${_DST}/\${1}" _w
  shift
  _w="\$(_xoct_real_want "\${_d}")"
  ( cd -P -- "\${_d}" 2>/dev/null && [ "\$(pwd -P)" = "\${_w}" ] && "\$@" )
}
_xo_rewrite_here() {
  local _F
  find . -maxdepth 1 -type f -name "\${1:-*}" 2>/dev/null | sort | while IFS= read -r _F; do
    _F="\${_F#./}"
    # The post.d fpm includes carry no /data/disk path -- only the account's
    # own \$user_socket "oN.NN" token -- so match that too, else a rename left
    # the source socket name and requests hit the WRONG account's FPM pool
    # (403/permission-denied) on any target that also has an account by the
    # source name. The account path ends at a slash or at the end of its
    # name, so o1 never rewrites a path of o10.
    _xoct_read_here "\${_F}" \
      | grep -qE "/data/disk/${_X_SRC_OCT}([^A-Za-z0-9._-]|\\\$)|/home/${_X_SRC_OCT}\.ftp|user_socket \"${_X_SRC_OCT}[.\"]" || continue
    _xoct_sed_here "\${_F}" -E \
      -e 's#/data/disk/${_X_SRC_OCT}([^A-Za-z0-9._-]|\$)#/data/disk/${_X_DST_OCT}\1#g' \
      -e 's#/home/${_X_SRC_OCT}\.ftp#/home/${_X_DST_OCT}.ftp#g' \
      -e 's#user_socket "${_X_SRC_OCT}\.#user_socket "${_X_DST_OCT}.#g' \
      -e 's#user_socket "${_X_SRC_OCT}"#user_socket "${_X_DST_OCT}"#g'
  done
}
_xo_subdirs_here() {
  find . -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sed 's|^\./||' | sort
}
_xo_in .drush _xo_rewrite_here '*.drushrc.php'
for _S in config/server_master/nginx/vhost.d config/server_master/nginx/pre.d \
  config/server_master/nginx/post.d config/server_master/nginx/subdir.d \
  config/server_master/nginx/platform.d config/ssl.d config/server_master/ssl.d; do
  _xo_in "\${_S}" _xo_rewrite_here
done
_xo_in config/server_master/nginx/subdir.d _xo_subdirs_here | while IFS= read -r _S; do
  case "\${_S}" in ''|*/*) continue ;; esac
  _xo_in "config/server_master/nginx/subdir.d/\${_S}" _xo_rewrite_here
done
# A static/ link naming the source tree is repointed as ./name inside the
# directory find holds, made by the link's own owner (setpriv), so root never
# changes an owner by name there (a hard link to another file renamed over
# the name between a new link and a chown by name would hand that file over)
# and never makes a link for the account: a root link is made again by root,
# one of another owner only by that owner, with no root group; one it cannot
# make there is left as it is and named. A link that vanished or cannot be
# read is skipped. The owner process gets no stdin: it must not hold this
# script's stream.
_xo_relink_here() {
  local _L _T _R _O _N
  for _L in "\$@"; do
    _T=\$(readlink -- "\${_L}" 2>/dev/null) || continue
    _R="\${_T#/data/disk/\${_SRC}/}"
    [ "\${_R}" != "\${_T}" ] || continue
    _N="/data/disk/\${_DST}/\${_R}"
    _O=\$(stat -c '%u:%g' -- "\${_L}" 2>/dev/null) || continue
    case "\${_O}" in
      0:[0-9]*)
        ln -sfn -T -- "\${_N}" "\${_L}" 2>/dev/null
        ;;
      [1-9]*:[1-9]*)
        setpriv --reuid="\${_O%%:*}" --regid="\${_O#*:}" --clear-groups \
          ln -sfn -T -- "\${_N}" "\${_L}" < /dev/null > /dev/null 2>&1 \
          || echo "ALRT: static link \${PWD}/\${_L#./} (owner \${_O}) not repointed: its owner cannot make it there"
        ;;
      *)
        echo "ALRT: static link \${PWD}/\${_L#./} (owner \${_O}) not repointed: no root link is made for another owner"
        ;;
    esac
  done
}
export _SRC _DST
export -f _xo_relink_here
find "/data/disk/\${_DST}/static" -type l -execdir bash -c '_xo_relink_here "\$@"' _ {} + 2>/dev/null
# Ownership: the copy maps owners by name, so what the source identities
# owned landed on their namesakes here, or on their bare source uids where
# this box has no such name; left so, the renamed account's files, quota and
# FTP belong to someone else. Only those owners are handed to the renamed
# identities (root's and www-data's files stay theirs), physically and never
# by name: one walk per tree and old owner enters each directory itself,
# only as the directory lstat saw there (one swapped for a link during the
# walk is refused), and a directory, or a regular file with one link, is
# re-owned only through a no-follow handle that still carries the old owner
# (a hard link to another file renamed over a name while the walk runs is
# never handed over); a link is made again by its new owner (one it cannot
# make there keeps the owner it landed with; a link's owner grants nothing
# on its target). The walk covers the account tree, the .ftp
# home and the account's part of the attached store, each entered as the
# real directory. An owner that is also one of the renamed identities here
# cannot be told apart from it and is left as copied. What the source's FPM
# pool users (<oN>.web, <oN>.NN.web) wrote since its last nightly landed the
# same way; it goes to the renamed account, as the nightly hands it over,
# in the account tree and its part of the store.
_XO_REOWN_PL='${_XOCT_REOWN_PL}'
# The links ./\$3 ... made again, pointing where they point, by the identity
# \$1 (their group kept), so no owner is ever changed by name: only a link
# the old owner uid \$2 still holds, and never with the root group (a link
# of another owner renamed onto the name does not lend its group to the
# process made as \$1). The process gets no stdin: it must not hold this
# script's stream.
_xo_relink_as() {
  local _n="\${1}" _f="\${2}" _L _T _o
  shift 2
  for _L in "\$@"; do
    _T=\$(readlink -- "\${_L}" 2>/dev/null) || continue
    _o=\$(stat -c '%u:%g' -- "\${_L}" 2>/dev/null) || continue
    case "\${_o}" in
      "\${_f}":[1-9]*) ;;
      *) continue ;;
    esac
    setpriv --reuid="\${_n}" --regid="\${_o#*:}" --clear-groups \
      ln -sfn -T -- "\${_T}" "\${_L}" < /dev/null > /dev/null 2>&1
  done
}
export -f _xo_relink_as
# What the uid \$1 owns in the current tree handed to the identity \$2: one
# walk for the directories and files, then the links in batches per
# directory.
_xo_reown() {
  local _n
  _n="\$(id -u -- "\${2}" 2>/dev/null)"
  case "\${_n}" in ''|*[!0-9]*) return 0 ;; esac
  perl -e "\${_XO_REOWN_PL}" -- "\${1}" "\${_n}" "\${PWD}" < /dev/null 2>/dev/null
  find -P . -user "\${1}" -type l \
    -execdir bash -c '_xo_relink_as "\$@"' _ "\${2}" "\${1}" {} + 2>/dev/null
}
_xo_landed() {
  local _u
  _u="\$(id -u "\${1}" 2>/dev/null)"
  [ -n "\${_u}" ] || _u="\${2}"
  case "\${_u}" in
    ''|0|*[!0-9]*) return 1 ;;
  esac
  printf '%s' "\${_u}"
}
# True when the uid \$1 is held here by an identity of the renamed account.
_xo_dst_ident() {
  local _n
  _n="\$(getent passwd "\${1}" 2>/dev/null | cut -d: -f1)"
  case "\${_n}" in
    "\${_DST}"|"\${_DST}".*) return 0 ;;
  esac
  return 1
}
_xo_remap_in() {
  ( cd -P -- "\${1}" 2>/dev/null && [ "\$(pwd -P)" = "\${2}" ] || exit 0
    # the walker holds one directory open per level: a deep tree gets the
    # whole hard limit, never the lower soft one
    ulimit -n "\$(ulimit -Hn)" 2>/dev/null
    [ -n "\${_RU}" ] && _xo_reown "\${_RU}" "\${_DST}"
    [ -n "\${_RF}" ] && _xo_reown "\${_RF}" "\${_DST}.ftp"
    if [ "\${3}" = "web" ]; then
      for _W in \${_RW}; do
        _xo_reown "\${_W}" "\${_DST}"
      done
    fi
    exit 0 )
}
_LU="\$(_xo_landed "\${_SRC}" "\${_SU}")"
_LF="\$(_xo_landed "\${_SRC}.ftp" "\${_SF}")"
_DU="\$(id -u "\${_DST}" 2>/dev/null)"
_DF="\$(id -u "\${_DST}.ftp" 2>/dev/null)"
_RU=""
_RF=""
if [ -z "\${_DU}" ] || [ -z "\${_DF}" ]; then
  echo "ALRT: \${_DST} or \${_DST}.ftp does not exist here -- owners left as copied"
else
  if [ -n "\${_LU}" ] && [ "\${_LU}" != "\${_DU}" ]; then
    if [ "\${_LU}" = "\${_DF}" ] || [ "\${_LU}" = "\${_LF}" ]; then
      echo "ALRT: files of \${_SRC} landed on uid \${_LU}, which another identity of this rename holds here -- left as copied"
    else
      _RU="\${_LU}"
    fi
  fi
  if [ -n "\${_LF}" ] && [ "\${_LF}" != "\${_DF}" ]; then
    if [ "\${_LF}" = "\${_DU}" ] || [ "\${_LF}" = "\${_LU}" ]; then
      echo "ALRT: files of \${_SRC}.ftp landed on uid \${_LF}, which another identity of this rename holds here -- left as copied"
    else
      _RF="\${_LF}"
    fi
  fi
fi
_RW=""
if [ -n "\${_DU}" ] && [ -n "\${_DF}" ]; then
  for _W in \${_SW}; do
    _L="\$(_xo_landed "\${_W%%:*}" "\${_W##*:}")" || continue
    [ "\${_L}" != "\${_DU}" ] && [ "\${_L}" != "\${_LU}" ] || continue
    case " \${_RW} " in *" \${_L} "*) continue ;; esac
    if [ "\${_L}" = "\${_LF}" ] || _xo_dst_ident "\${_L}"; then
      echo "ALRT: files of \${_W%%:*} landed on uid \${_L}, which another identity of this rename holds here -- left as copied"
    else
      _RW="\${_RW}\${_RW:+ }\${_L}"
    fi
  done
fi
_xo_remap_in "/data/disk/\${_DST}" "\$(cd -P /data/disk 2>/dev/null && pwd -P)/\${_DST}" web
_xo_remap_in "/home/\${_DST}.ftp" "\$(cd -P /home 2>/dev/null && pwd -P)/\${_DST}.ftp"
if [ -n "\${_TM}" ]; then
  _xo_remap_in "\${_TM}/files/\${_DST}" \
    "\$(cd -P /mnt 2>/dev/null && pwd -P)\${_TM#/mnt}/files/\${_DST}" web
fi
REMOTE
}

###-------------MIGRATION TARGET SEEDING----###
###
### Everything in this block exists to close the "wrong PHP / wrong identity
### after migration" class: a fresh target install is born on the box-default
### PHP with fresh client credentials, while the source account's real pins
### and identity live in /root/.<acct>.octopus.cnf, static/control/*.info and
### /etc/shadow -- none of which travelled before. The control files are the
### authoritative witnesses (BOA derives the cnf FROM fpm.info/cli.info, never
### the reverse, and manage_ltd_users converges pools from them within
### minutes), so the seeding order is: gate on installed PHP, install, merge
### the cnf, force the control files, carry the credentials.

### Normalise a PHP version token to the dotted form BOA control files use;
### prints nothing for a token that is not a known BOA PHP version.
_mig_php_norm() {
  local _t="${1//[^0-9.]/}"
  case "${_t}" in
    8.5|85) echo 8.5 ;;
    8.4|84) echo 8.4 ;;
    8.3|83) echo 8.3 ;;
    8.2|82) echo 8.2 ;;
    8.1|81) echo 8.1 ;;
    8.0|80) echo 8.0 ;;
    7.4|74) echo 7.4 ;;
    7.3|73) echo 7.3 ;;
    7.2|72) echo 7.2 ;;
    7.1|71) echo 7.1 ;;
    7.0|70) echo 7.0 ;;
    5.6|56) echo 5.6 ;;
  esac
}

### Union of PHP versions this account is pinned to: the account-level
### static/control/{fpm,cli}.info defaults, the per-site column of
### static/control/multi-fpm.info (dotted and shorthand forms both count --
### the consumer accepts both, so the gate must too), every line of
### static/control/cli-per-platform.info and the phpNN.info marker that
### steers the command line. The last two are read as websh reads them: the
### file's first 64 KiB and 200 lines, '#' opening a comment, a line counting
### only as "<folder> <version>", the version's digits only; the marker is
### the highest one whose PHP is installed here. A line whose version the
### target lacks is ignored there, which leaves that platform's tasks on the
### account-wide PHP, and websh refuses them when the platform's core cannot
### run on it.
_mig_php_versions_needed() {
  local _u="$1" _f _v _dom _rest _line _k _e _mk="" _txt _n _out=""
  ### read inside the account's real static/control, never through a link
  ### or into a FIFO put there
  for _f in fpm.info cli.info; do
    _v="$(_mig_php_norm "$(_xoct_read_in "${_u}/static/control" "${_f}" | tr -d ' \t\r\n')")"
    [ -n "${_v}" ] && _out="${_out} ${_v}"
  done
  if [ -e "${_u}/static/control/multi-fpm.info" ]; then
    while read -r _dom _v _rest; do
      ### place.holder.dont.remove is manage_ltd_users' filler line, not a
      ### site pin -- counting it would refuse migrations over a version no
      ### site actually uses.
      case "${_dom}" in \#*|""|place.holder.dont.remove) continue ;; esac
      _v="$(_mig_php_norm "${_v}")"
      [ -n "${_v}" ] && _out="${_out} ${_v}"
    done <<< "$(_xoct_read_in "${_u}/static/control" multi-fpm.info)"
  fi
  if [ -e "${_u}/static/control/cli-per-platform.info" ]; then
    _txt=""; _n=0
    _txt="$(_xoct_read_in "${_u}/static/control" cli-per-platform.info | head -c 65536)"
    while IFS= read -r _line; do
      _n=$(( _n + 1 ))
      [ "${_n}" -gt 200 ] && break
      _line="${_line%%#*}"
      read -r _k _v _rest <<< "${_line}"
      [ -n "${_k}" ] && [ -n "${_v}" ] && [ -z "${_rest}" ] || continue
      _v="$(_mig_php_norm "${_v//[!0-9]/}")"
      [ -n "${_v}" ] && _out="${_out} ${_v}"
    done <<< "${_txt}"
  fi
  if _xoct_in_real_dir "${_u}/static/control" true; then
    for _e in 56 70 71 72 73 74 80 81 82 83 84 85; do
      [ -e "${_u}/static/control/php${_e}.info" ] && [ -x "/opt/php${_e}/bin/php" ] && _mk="${_e}"
    done
  fi
  [ -n "${_mk}" ] && _out="${_out} $(_mig_php_norm "${_mk}")"
  echo "${_out}" | tr ' ' '\n' | sort -u | tr '\n' ' '
}

### The tree the TARGET runs, for target-side barracuda/octopus verbs; the
### local _tRee belongs to THIS box and a cross-tree migration must not push
### the source's tree through the target's licence gate.
_mig_target_tree() {
  local _t="$1" _tt
  _tt=$(ssh root@"${_t}" "boa info 2>/dev/null" 2>/dev/null \
    | grep -oE 'Barracuda BOA-[0-9.]+-(dev|lts|pro)' \
    | tail -1 \
    | grep -oE '(dev|lts|pro)$')
  if [ -z "${_tt}" ]; then
    echo "ALRT: could not detect the BOA tree on ${_t}; falling back to local '${_tRee}'" >&2
    _tt="${_tRee}"
  fi
  echo "${_tt}"
}

### Verify every needed PHP version is installed on the target -- the same
### /opt/phpNN/bin/php probe BOA's own fallback ladders use. A missing version
### is fatal by default, because served-on-the-wrong-PHP is the silent failure
### this whole step exists to prevent. With --fix-php the missing versions are
### appended to the target's _PHP_MULTI_INSTALL and one barracuda system run
### is driven remotely to build them (that run is long; expect ~30 minutes).
_xoct_php_coverage_gate() {
  local _u="$1" _t="$2" _need _v _sv _miss=""
  _need="$(_mig_php_versions_needed "${_u}")"
  [ -n "${_need// /}" ] || return 0
  echo "INFO: PHP versions required by $(basename "${_u}"): ${_need}"
  for _v in ${_need}; do
    _sv=${_v//[^0-9]/}
    if ! ssh root@"${_t}" "[ -x /opt/php${_sv}/bin/php ]" 2>/dev/null; then
      _miss="${_miss} ${_v}"
    fi
  done
  _miss="${_miss## }"
  [ -z "${_miss}" ] && return 0
  echo "ALRT: target ${_t} lacks PHP version(s) required by $(basename "${_u}"): ${_miss}"
  if [ "${_XOCT_FIX_PHP}" = "YES" ]; then
    _mig_fix_target_php "${_t}" "${_miss}" || return 1
    for _v in ${_miss}; do
      _sv=${_v//[^0-9]/}
      if ! ssh root@"${_t}" "[ -x /opt/php${_sv}/bin/php ]" 2>/dev/null; then
        echo "ERROR: PHP ${_v} still missing on ${_t} after the fix run"
        return 1
      fi
    done
    return 0
  fi
  echo "ERROR: a pinned PHP version missing on the target means every affected site"
  echo "ERROR: silently falls back to a different PHP after migration."
  echo "ERROR: Fix on the target: add '${_miss}' to _PHP_MULTI_INSTALL in /root/.barracuda.cnf"
  echo "ERROR: and run: barracuda up-<tree> system noscreen"
  echo "ERROR: Or re-run this command with --fix-php to do both automatically."
  return 1
}

### Extend the target's _PHP_MULTI_INSTALL with the missing versions and run
### one barracuda system pass there to build them. Idempotent: versions
### already listed are not repeated, and barracuda itself is safe to re-run.
_mig_fix_target_php() {
  local _t="$1" _add="$2" _cur _new _v _nv _tree
  # Normalise the fetched value token by token: the raw line may carry an
  # inline comment or quotes, and anything not a known PHP version must
  # never reach the remote root shell that rewrites the cnf.
  _cur=$(ssh root@"${_t}" "grep '^_PHP_MULTI_INSTALL=' /root/.barracuda.cnf 2>/dev/null" 2>/dev/null \
    | tail -1 | sed -E 's/^[^=]*=//; s/#.*$//; s/"//g' | tr -d '\n')
  _new=""
  for _v in ${_cur} ${_add}; do
    _nv="$(_mig_php_norm "${_v}")"
    [ -n "${_nv}" ] || continue
    case " ${_new} " in
      *" ${_nv} "*) : ;;
      *) _new="${_new} ${_nv}" ;;
    esac
  done
  _new="${_new## }"
  if [ -z "${_new}" ]; then
    echo "ALRT: computed empty _PHP_MULTI_INSTALL for ${_t}; refusing"
    return 1
  fi
  ### Belt-and-braces before the value reaches a remote sed: it is built only
  ### from _mig_php_norm output, so it can hold nothing but digits, dots and
  ### spaces -- assert that rather than trust it.
  case "${_new}" in
    *[!0-9.\ ]*) echo "ALRT: refusing to write a non-version _PHP_MULTI_INSTALL value"; return 1 ;;
  esac
  echo "INFO: setting _PHP_MULTI_INSTALL=\"${_new}\" on ${_t}"
  ### Rewrite in place (keeps the line with the comment that documents it);
  ### append only when the key is absent. The temp+size guard means a failed
  ### write can never blank the box's barracuda.cnf.
  ssh root@"${_t}" "_m=\$(stat -c %a /root/.barracuda.cnf 2>/dev/null); \
    if grep -q '^_PHP_MULTI_INSTALL=' /root/.barracuda.cnf; then \
      sed 's|^_PHP_MULTI_INSTALL=.*|_PHP_MULTI_INSTALL=\\\"${_new}\\\"|' \
        /root/.barracuda.cnf > /root/.barracuda.cnf.phpnew; \
    else \
      cp -af /root/.barracuda.cnf /root/.barracuda.cnf.phpnew \
      && echo '_PHP_MULTI_INSTALL=\"${_new}\"' >> /root/.barracuda.cnf.phpnew; \
    fi; \
    [ -s /root/.barracuda.cnf.phpnew ] \
    && chmod \${_m:-600} /root/.barracuda.cnf.phpnew \
    && mv -f /root/.barracuda.cnf.phpnew /root/.barracuda.cnf" \
    || { echo "ERROR: could not update _PHP_MULTI_INSTALL on ${_t}"; return 1; }
  _tree="$(_mig_target_tree "${_t}")"
  case "${_tree}" in
    dev|lts|pro) : ;;
    *) echo "ALRT: invalid tree token '${_tree}' -- refusing the remote barracuda run"; return 1 ;;
  esac
  echo "INFO: driving 'barracuda up-${_tree} system noscreen' on ${_t} to build the missing PHP set;"
  echo "INFO: this is a full system pass and typically takes ~30 minutes"
  ssh root@"${_t}" "barracuda up-${_tree} system noscreen" \
    || { echo "ERROR: barracuda system run on ${_t} returned non-zero"; return 1; }
  return 0
}

### Merge the account-portable octopus.cnf lines from the source cnf into the
### target's /root/.<dst>.octopus.cnf. A wholesale copy would carry the host
### axis (_MY_OWNIP, _LOCAL_NETWORK_IP, _THIS_DB_HOST/_PORT, _DOMAIN), which
### is re-derived target-correct when absent and actively harmful when copied,
### so only the listed keys travel, as whole lines, replace-or-append. The
### merge runs AFTER the target install on purpose: _satellite_cnf's
### existing-cnf branch re-derives the PHP pins from static/control/*.info,
### so a pre-install cnf alone would be overwritten -- the control-file
### seeding below is what makes the pins stick, and manage_ltd_users then
### converges the pools within minutes.
_xoct_push_target_octopus_cnf() {
  local _src="$1" _dst="$2" _t="$3"
  local _sCnf="/root/.${_src}.octopus.cnf"
  local _dCnf="/root/.${_dst}.octopus.cnf"
  local _rTmp="/root/.${_dst}.octopus.cnf.migrate-merge.tmp"
  local _rRun="/root/.${_dst}.octopus.cnf.migrate-merge.run"
  local _lTmp="/var/backups/.xoct.cnfmerge.$$.lines"
  local _lRun="/var/backups/.xoct.cnfmerge.$$.run"
  local _v _l _lst
  if [ ! -e "${_sCnf}" ]; then
    echo "ALRT: no ${_sCnf} on the source; the target account keeps its install-time defaults"
    return 0
  fi
  if ! ssh root@"${_t}" "[ -e ${_dCnf} ]" 2>/dev/null; then
    echo "ALRT: no ${_dCnf} on ${_t} (account not installed there yet?);"
    echo "ALRT: skipping the cnf merge -- run 'xoct create${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}' first, then re-run this step"
    return 1
  fi
  _lst="_PHP_FPM_VERSION _PHP_CLI_VERSION _PHP_FPM_WORKERS _PHP_FPM_TIMEOUT \
    _PHP_FPM_MAX_CHILDREN_FORCE _PHP_FPM_MEMORY_LIMIT_FORCE _PHP_FPM_RAM_PCT \
    _PHP_FPM_CPU_FACTOR _PHP_FPM_DENY _RESERVED_RAM _MY_OCTO_EMAIL \
    _CLIENT_EMAIL _CLIENT_OPTION _CLIENT_SUBSCR _CLIENT_CORES \
    _GHOST_PLATFORMS_CLEANUP _GHOST_VHOSTS_CLEANUP _GHOST_SITES_CLEANUP \
    _GHOST_SITE_FILES_CLEANUP _GHOST_ALIASES_CLEANUP _SEND_UPGRADE_EMAIL \
    _DEL_OLD_BACKUPS _DEL_OLD_TMP _DEL_OLD_EMPTY_PLATFORMS \
    _SQL_CONVERT _STRONG_PASSWORDS _BACKDROP_SUPPORT _GRAV_SUPPORT _TXP_SUPPORT _HOT_SAUCE \
    _USE_CURRENT _DL_MODE _FORCE_GIT_MIRROR _PLATFORMS_LIST \
    _AUTOPILOT _DNS_SETUP_TEST"
  echo "_USER=\"${_dst}\"" > "${_lTmp}"
  for _v in ${_lst}; do
    _l=$(grep "^${_v}=" "${_sCnf}" 2>/dev/null | tail -1)
    [ -n "${_l}" ] && printf '%s\n' "${_l}" >> "${_lTmp}"
  done
  ### Under admail= every merge (create, each live transfer) keeps the
  ### account's upgrade notice off there (_xoct_admail_upgrade_mail_off);
  ### so does the target itself while a test run's record names the account
  ### there (_xoct_admail_rec), token or not.
  if [ -n "${_XOCT_ADMAIL}" ]; then
    grep -v '^_SEND_UPGRADE_EMAIL=' "${_lTmp}" > "${_lTmp}.admail" \
      && mv -f "${_lTmp}.admail" "${_lTmp}" \
      && echo '_SEND_UPGRADE_EMAIL=NO' >> "${_lTmp}"
  fi
  # The web-group policy mirrors the source both ways, read as bash reads
  # it: _WEB_GROUP=NO (the opt-out) or _WEB_GROUP=A (the --phase-a pin)
  # travels as a plain line, and a source with neither removes a stale one
  # on the target, in any form (the merge otherwise keeps every line the
  # source lacks).
  _v=$(_web_group_policy "${_sCnf}")
  if [ -n "${_v}" ]; then
    printf '%s\n' "_WEB_GROUP=${_v}" >> "${_lTmp}"
  else
    printf '%s\n' "-_WEB_GROUP" >> "${_lTmp}"
  fi
  {
    echo '#!/bin/bash'
    echo "_cnf=\"${_dCnf}\""
    echo "_mrg=\"${_rTmp}\""
    echo "_adm=\"$(_xoct_admail_rec "${_dst}")\""
    cat <<'MERGESH'
[ -e "${_cnf}" ] || exit 1
[ -e "${_mrg}" ] || exit 1
while IFS= read -r _l; do
  case "${_l}" in
    -_WEB_GROUP|_WEB_GROUP=*)
      grep -vE "^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=" "${_cnf}" > "${_cnf}.mrgnew" 2>/dev/null
      [ "${_l}" = "-_WEB_GROUP" ] || printf '%s\n' "${_l}" >> "${_cnf}.mrgnew"
      mv -f "${_cnf}.mrgnew" "${_cnf}"
      continue
      ;;
    _*=*) : ;;
    *) continue ;;
  esac
  _k="${_l%%=*}"
  grep -v "^${_k}=" "${_cnf}" > "${_cnf}.mrgnew" 2>/dev/null
  printf '%s\n' "${_l}" >> "${_cnf}.mrgnew"
  mv -f "${_cnf}.mrgnew" "${_cnf}"
done < "${_mrg}"
if [ -e "${_adm}" ]; then
  grep -v '^_SEND_UPGRADE_EMAIL=' "${_cnf}" > "${_cnf}.mrgnew" 2>/dev/null
  echo '_SEND_UPGRADE_EMAIL=NO' >> "${_cnf}.mrgnew"
  mv -f "${_cnf}.mrgnew" "${_cnf}"
  echo "INFO: the upgrade notice stays off in ${_cnf}: a test run's record (${_adm})"
fi
chmod 644 "${_cnf}"
rm -f "${_mrg}"
MERGESH
  } > "${_lRun}"
  if ! rsync -a -e ssh "${_lTmp}" "root@${_t}:${_rTmp}" \
    || ! rsync -a -e ssh "${_lRun}" "root@${_t}:${_rRun}"; then
    echo "ALRT: could not stage the cnf merge on ${_t}"
    rm -f "${_lTmp}" "${_lRun}"
    return 1
  fi
  rm -f "${_lTmp}" "${_lRun}"
  if ssh root@"${_t}" "bash ${_rRun}; _rc=\$?; rm -f ${_rRun}; exit \${_rc}"; then
    echo "INFO: merged source octopus.cnf values into ${_dCnf} on ${_t}"
    return 0
  fi
  echo "ALRT: cnf merge on ${_t} failed; the target keeps its current ${_dCnf}"
  return 1
}

### Force the authoritative PHP pin witnesses over WITHOUT -u: the fresh
### target install wrote newer defaults that would shadow every -u sync, and
### these four files are exactly what _satellite_cnf and manage_ltd_users
### derive the cnf and the pools from.
_xoct_seed_target_control_pins() {
  local _sUsr="$1" _dUsr="$2" _dAcct="$3" _t="$4" _f
  # multi-fpm.info rides the file transfer too, but seed it here as well so
  # `create` leaves the target holding exactly the pin set the coverage gate
  # measured -- otherwise an operator who runs only `create` gets the
  # account-level pins and not the per-site ones. Site lines key on the
  # domain, which migration does not change, so the copy is valid early and
  # the transfer's forced copy converges it later either way.
  ### Only a regular file travels, from the real directory into the real
  ### directory: static/control and log/ are the account's on both boxes,
  ### and a link carried to the target, or one put on either path, would be
  ### followed there by root (the owner re-assert below, any later reader).
  for _f in static/control/fpm.info static/control/cli.info \
    static/control/multi-fpm.info log/fpm.txt log/cli.txt; do
    _xoct_in_real_dir "${_sUsr}/${_f%/*}" _xoct_put_file_remote_here \
      "${_f##*/}" "${_t}" "${_dUsr}/${_f%/*}" "${_ieni}"
  done
  ### multi-fpm.info gets the same owner as its two siblings. On a rename it
  ### arrives with the source's owner, a name the target may not hold, and
  ### renameaegirhost §2d rewrites it there, so it is not left to the
  ### transfer's owner remap, which runs later.
  ### The group is the account's group ON THE TARGET (its own once converted
  ### there, the box-wide one until then), asked of the target itself. The
  ### owner is re-asserted inside the real static/control there, through a
  ### no-follow handle, only on a regular file with one link that is already
  ### the login's, or the owner a copy of the source login's files lands on
  ### there: a name the source did not send may hold anything the target
  ### account put there, and a hard link to another file, or a root-only
  ### file renamed onto the name, is never handed over.
  _xoct_remote_in "${_t}" "${_dUsr}/static/control" \
    "_g=\$(id -gn ${_dAcct} 2> /dev/null); [ \"\${_g}\" = ${_dAcct} ] || _g=users; _ro ${_dAcct}.ftp:\${_g} '' \"$(_xoct_landed_uids_sh "${_sUsr##*/}")\" ./fpm.info ./cli.info ./multi-fpm.info" &> /dev/null
  return 0
}

### Carry the client shell identity so migration does not silently reset it:
### the main <acct>.ftp shadow hash and log/pass.txt (kept consistent as a
### pair), the sub-account password store /home/<acct>.ftp/users (whose
### carried entries manage_ltd_users now honours at sub-user creation), and
### each existing sub-user's shadow hash and .ssh where the target user
### already exists (later passes converge the rest). LIVE operations only --
### never call this from a DRY path or a proxy repair (a long-lived target's
### clients may have changed their passwords THERE since the migration).
### The regular files of the current (pinned) sub-account password store of
### the account $1, each put under the name it takes for the account $2
### into the real store directory on the target $3: a link is never sent,
### and the receiver never writes through one. The new name is read by a
### shell on the target (rsync before 3.2.4 sends it unescaped), so a name
### that is not shell-safe is refused.
_xoct_users_put_here() {
  local _e _n
  for _e in ./*; do
    [ -f "${_e}" ] && [ ! -L "${_e}" ] || continue
    _n="${_e#./}"
    case "${_n}" in
      ''|-*|*[!A-Za-z0-9._@+,=-]*)
        echo "ALRT: sub-account password store entry $(printf '%q' "${_n}") is not a shell-safe name -- not carried"
        continue
        ;;
    esac
    _n="${_n#"${1}".}"
    # shellcheck disable=SC2086
    _xoct_rsync -aEAX --no-links ${_ieni} \
      --rsync-path="$(_xoct_rsync_path_mk_in "/home/${2}.ftp/users")" -e ssh \
      "${_e}" "root@${3}:./${2}.${_n}"
  done
}
### Whether the sub-user $1 has a .ssh to carry: a real directory, or none
### (quietly); one that is not a real directory is reported and left.
_xoct_subuser_ssh_ok() {
  [ -e "/home/${1}/.ssh" ] || [ -L "/home/${1}/.ssh" ] || return 1
  _xoct_in_real_dir "/home/${1}/.ssh" true && return 0
  echo "ALRT: /home/${1}/.ssh is not a real directory -- not followed; its keys not carried"
  return 1
}
_xoct_sync_shell_credentials() {
  local _src="$1" _dst="$2" _t="$3"
  local _sUsr="/data/disk/${_src}" _dUsr="/data/disk/${_dst}"
  local _hash _d _n _e _set=NO
  _hash=$(getent shadow "${_src}.ftp" 2>/dev/null | cut -d: -f2)
  if [ -n "${_hash}" ] && [ "${_hash}" != "*" ] && [ "${_hash}" != "!" ]; then
    if ssh root@"${_t}" "getent passwd ${_dst}.ftp" &> /dev/null; then
      if printf '%s.ftp:%s\n' "${_dst}" "${_hash}" | ssh root@"${_t}" "chpasswd -e"; then
        _set=YES
        echo "INFO: carried ${_src}.ftp shell/SFTP password to ${_dst}.ftp on ${_t}"
      else
        echo "ALRT: could not set the carried password for ${_dst}.ftp on ${_t}"
      fi
    else
      echo "ALRT: user ${_dst}.ftp missing on ${_t}; password not carried yet (re-run converges)"
    fi
  fi
  ### pass.txt travels ONLY when the paired hash actually landed: it is what
  ### the client is shown, and shipping it after a failed chpasswd would
  ### advertise a password that does not work. A re-run converges both.
  ### log/ is oN's on both boxes: a regular file only, from the real
  ### directory into the real directory.
  if [ "${_set}" = "YES" ] && [ -e "${_sUsr}/log/pass.txt" ]; then
    _xoct_in_real_dir "${_sUsr}/log" _xoct_put_file_remote_here \
      pass.txt "${_t}" "${_dUsr}/log" "${_ieni}"
  elif [ -e "${_sUsr}/log/pass.txt" ]; then
    echo "ALRT: NOT carrying log/pass.txt for ${_dst} -- the shadow hash was not set on ${_t}"
  fi
  ### The store is keyed by FULL sub-user name, so a rename must rewrite the
  ### entry filenames -- an rsync of the directory would land <src>-named
  ### files that manage_ltd_users never looks for on the target. The store
  ### is the account's on both boxes: its regular files are sent from inside
  ### the real directory into the real one, and the owner and modes are set
  ### there without following a link put at any name.
  if [ -e "/home/${_src}.ftp/users" ] || [ -L "/home/${_src}.ftp/users" ]; then
    if _xoct_in_real_dir "/home/${_src}.ftp/users" true; then
      ssh root@"${_t}" "mkdir -p /home/${_dst}.ftp/users" &> /dev/null
      _xoct_in_real_dir "/home/${_src}.ftp/users" \
        _xoct_users_put_here "${_src}" "${_dst}" "${_t}"
      ### The group is the account's group ON THE TARGET (its own once
      ### converted there, the box-wide one until then), asked of the target
      ### itself: the two boxes are in different states for the length of a
      ### rollout. The directory is the one this shell holds ("."); each
      ### entry is re-asserted through a no-follow handle, only when it is a
      ### regular file with one link that is already the login's, or the
      ### owner the copy of the source's store lands on there, so a hard link
      ### to another file, or a root-only file (log/pass.txt) renamed into the
      ### store, is never handed over or chmodded.
      _xoct_remote_in "${_t}" "/home/${_dst}.ftp/users" \
        "_g=\$(id -gn ${_dst} 2>/dev/null); [ \"\$_g\" = ${_dst} ] || _g=users; chown -- ${_dst}.ftp:\$_g . 2>/dev/null; chmod 700 .; _ro ${_dst}.ftp:\$_g 600 \"$(_xoct_landed_uids_sh "${_src}")\" ./*; true" &> /dev/null
    else
      echo "ALRT: /home/${_src}.ftp/users is not a real directory -- not followed; its password store not carried"
    fi
  fi
  for _d in "${_sUsr}"/clients/*/; do
    [ -d "${_d}" ] || continue
    _n=$(basename "${_d}")
    # the name is read by a shell on the target
    case "${_n}" in
      ''|-*|*[!A-Za-z0-9._@+,=-]*) continue ;;
    esac
    getent passwd "${_src}.${_n}" &> /dev/null || continue
    _hash=$(getent shadow "${_src}.${_n}" 2>/dev/null | cut -d: -f2)
    [ -n "${_hash}" ] && [ "${_hash}" != "*" ] && [ "${_hash}" != "!" ] || continue
    if ssh root@"${_t}" "getent passwd ${_dst}.${_n}" &> /dev/null; then
      if printf '%s.%s:%s\n' "${_dst}" "${_n}" "${_hash}" | ssh root@"${_t}" "chpasswd -e"; then
        echo "INFO: carried sub-account password for ${_dst}.${_n} on ${_t}"
      else
        echo "ALRT: could not carry the sub-account password for ${_dst}.${_n} on ${_t}"
      fi
      ### The sub-user's keys: from the real directory into the real one.
      if _xoct_subuser_ssh_ok "${_src}.${_n}"; then
        _xoct_in_real_dir "/home/${_src}.${_n}/.ssh" _xoct_copy_mk_here "${_t}" \
          "/home/${_dst}.${_n}/.ssh" '' -aEAXqu ${_ieni}
      fi
    else
      ### The sub-user does not exist there yet: manage_ltd_users creates it
      ### from clients/ on its next pass (after post-mig while the target's
      ### runners are parked) and honours the carried store entry above, so
      ### the password converges. Its .ssh cannot be placed before the home
      ### exists -- stage it for the post-creation pass instead.
      if _xoct_subuser_ssh_ok "${_src}.${_n}"; then
        ssh root@"${_t}" "mkdir -p /var/backups/migrate-subuser-ssh/${_dst}.${_n}" &> /dev/null
        _xoct_in_real_dir "/home/${_src}.${_n}/.ssh" _xoct_rsync -aEAXqu ${_ieni} -e ssh \
          ./ "root@${_t}:/var/backups/migrate-subuser-ssh/${_dst}.${_n}/.ssh/"
        echo "INFO: sub-account ${_dst}.${_n} not created on ${_t} yet; password converges via the"
        echo "INFO: carried store, and its keys are staged at /var/backups/migrate-subuser-ssh/${_dst}.${_n}/.ssh"
      else
        echo "INFO: sub-account ${_dst}.${_n} not created on ${_t} yet; its carried password"
        echo "INFO: store entry makes it converge when manage_ltd_users creates it there"
      fi
    fi
  done
  return 0
}

### Bounded replacement for the historical fixed 8-minute wait before the
### enforced post-install upgrade: the in-flow auto-upgrade is settled once
### log/octopus_log.txt carries at least two lines (the same signal the
### golden-master runbook uses). On timeout proceed exactly as the fixed
### wait did.
_xoct_wait_target_install_settled() {
  local _dst="$1" _t="$2" _n _w=0
  local _max="${_XOCT_CREATE_MAX_WAIT:-900}"
  case "${_max}" in ''|*[!0-9]*) _max=900 ;; esac
  # With the in-flow auto-upgrade disabled the two-line signal never comes;
  # do not burn the whole ceiling waiting for it.
  if ssh root@"${_t}" "[ -e /root/.dont.upgrade.octopus.on.install.cnf ]" 2>/dev/null; then
    echo "INFO: in-flow auto-upgrade disabled on ${_t}; skipping the settle wait"
    return 0
  fi
  echo "INFO: waiting for the install on ${_t} to settle (octopus_log >= 2 lines, up to ${_max}s)"
  while [ "${_w}" -lt "${_max}" ]; do
    ### log/ is oN's there too: read inside the real directory, never
    ### through a link or into a FIFO put at the name
    _n=$(_xoct_remote_in "${_t}" "/data/disk/${_dst}/log" \
      '_rr octopus_log.txt | wc -l' 2>/dev/null | tr -d ' \n')
    case "${_n}" in ''|*[!0-9]*) _n=0 ;; esac
    if [ "${_n}" -ge 2 ]; then
      echo "INFO: install on ${_t} settled after ${_w}s"
      return 0
    fi
    sleep 30
    _w=$(( _w + 30 ))
  done
  echo "ALRT: install on ${_t} not settled after ${_max}s; proceeding anyway (legacy fixed-wait behaviour)"
  return 0
}

### Bounded wait until the TARGET holds no BOA run lock AND no armed
### run-upgrade.pid. Every account install leaves a background octopus run
### behind (the in-flow post-install upgrade, and the re-seeded run-upgrade.pid
### a create arms), so the next 'boa in-octopus' on the same target finds
### /run/boa_run.pid and the launcher refuses with "Another BOA installer is
### running" -- a refusal the create used to walk past and report complete.
### An ARMED pid counts as busy: the runner consumes it on its next tick, so a
### lock-free target with a pid armed is a pass that has not started yet (the
### third account of a prep-target met exactly that: quiet by the lock probe,
### refused seconds later by the pass the second account's seed had armed).
### Chained passes also leave lock-free gaps of a few seconds between them,
### so quiet must hold on two consecutive polls. Bounded; the caller fails
### when the box never goes quiet. Kept in step with xcopy's
### _xcopy_wait_target_quiet -- mirror any fix there.
_xoct_wait_target_quiet() {
  local _t="$1" _w=0 _busy _ok=0
  local _max="${_XOCT_TARGET_QUIET_MAX_WAIT:-1800}"
  case "${_max}" in ''|*[!0-9]*) _max=1800 ;; esac
  while [ "${_w}" -lt "${_max}" ]; do
    ### An armed run-upgrade.pid whose dispatcher is parked (a demoted
    ### target keeps every /var/xdrago/run-<acct> under /var/backups/off-run)
    ### is inert and not busy, as xmass's silence probe already reads it;
    ### counting it burnt the whole bound and refused the create. The same
    ### holds for every armed pid while the box's runner itself is parked
    ### (pre-mig's .runner.sh.off, held by the park marker until post-mig):
    ### nothing consumes them before post-mig, so a second account's create
    ### would wait out the bound on the first one's armed upgrade. Without
    ### the marker the next tools refresh brings the runner back, so the
    ### pid still counts.
    _busy=$(ssh root@"${_t}" "ls /run/boa_run.pid /run/boa_wait.pid /run/octopus_install_run.pid 2>/dev/null | tr '\n' ' '; { [ -e /run/boa_migration_park.pid ] && [ ! -e /var/xdrago/runner.sh ] && [ -e /var/xdrago/.runner.sh.off ]; } || for _f in /data/disk/*/static/control/run-upgrade.pid; do [ -e \"\${_f}\" ] || continue; _n=\${_f#/data/disk/}; _n=\${_n%%/*}; [ ! -e \"/var/xdrago/run-\${_n}\" ] && [ -e \"/var/backups/off-run/run-\${_n}\" ] && continue; printf '%s:armed ' \"\${_n}\"; done" 2>/dev/null)
    if [ -z "${_busy// /}" ]; then
      _ok=$(( _ok + 1 ))
      if [ "${_ok}" -ge 2 ]; then
        [ "${_w}" -gt 0 ] && echo "INFO: target ${_t} quiet after ${_w}s (two consecutive polls)"
        return 0
      fi
      sleep 15
      _w=$(( _w + 15 ))
      continue
    fi
    _ok=0
    [ "${_w}" -eq 0 ] && echo "INFO: a BOA run holds or is armed on ${_t} (${_busy}); waiting up to ${_max}s before the install"
    sleep 30
    _w=$(( _w + 30 ))
  done
  echo "ALRT: target ${_t} still busy after ${_max}s (${_busy}); not launching the install into a refusal"
  return 1
}

### Bounded wait until BOA's own heavyweight jobs are quiet on THIS box;
### replaces the runbook's "wait ~5 minutes" guess before an import.
_xoct_wait_boa_quiet() {
  local _w=0
  local _max="${_XOCT_QUIET_MAX_WAIT:-600}"
  case "${_max}" in ''|*[!0-9]*) _max=600 ;; esac
  while [ "${_w}" -lt "${_max}" ]; do
    if ! pgrep -f "[b]arracuda up|[o]ctopus up|[A]egirSetup" &> /dev/null; then
      return 0
    fi
    echo "INFO: waiting for a running barracuda/octopus/AegirSetup job to finish (${_w}s)"
    sleep 15
    _w=$(( _w + 15 ))
  done
  echo "ALRT: BOA jobs still running after ${_max}s; proceeding -- watch for task collisions"
  return 0
}

### The md5 lines of the seed witness set, before and after a create's seed,
### reduced to the names whose sum moved (a file that vanished or appeared
### counts as moved). Keys are the exact paths md5sum printed, so fpm.info
### and multi-fpm.info never alias each other.
### The seed witness set on the target: one "md5  path" line per file. The
### cnf line is the md5 of its SORTED lines, since the cnf merge rewrites a
### key by removing its line and appending it (a reorder is not a change).
_xoct_seed_witness() {   # 1 = account, 2 = target host
  local _u="$1" _t="$2"
  ### The account's files are summed as read inside their real directory,
  ### without following a link or blocking on a FIFO (static/control and
  ### log/ are the tenant's there too), in md5sum's own line shape; a name
  ### that is not a regular file there is absent.
  ssh root@"${_t}" "cd /data/disk/${_u} 2>/dev/null && { sort /root/.${_u}.octopus.cnf 2>/dev/null | md5sum | sed \"s#  -\\\$#  /root/.${_u}.octopus.cnf#\"; _w=\"\$(cd -P /data/disk 2>/dev/null && pwd -P)/${_u}\"; for _f in static/control/fpm.info static/control/cli.info static/control/multi-fpm.info log/fpm.txt log/cli.txt; do ( cd -P -- \"\${_f%/*}\" 2>/dev/null && [ \"\$(pwd -P)\" = \"\${_w}/\${_f%/*}\" ] && [ -f \"./\${_f##*/}\" ] && [ ! -L \"./\${_f##*/}\" ] && printf '%s  %s\n' \"\$(timeout 10 dd if=\"./\${_f##*/}\" iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2>/dev/null | md5sum | cut -d' ' -f1)\" \"\${_f}\" ); done; }" 2>/dev/null
}

_xoct_seed_witness_delta() {   # 1 = was, 2 = now (md5sum output, one line per file)
  local _key _w _n _out=""
  for _key in $(printf '%s\n%s\n' "$1" "$2" | awk 'NF == 2 && !seen[$2]++ {print $2}'); do
    _w=$(printf '%s\n' "$1" | awk -v k="${_key}" '$2 == k {print $1}')
    _n=$(printf '%s\n' "$2" | awk -v k="${_key}" '$2 == k {print $1}')
    [ "${_w}" = "${_n}" ] || _out="${_out}${_key##*/} "
  done
  _out="${_out% }"
  printf '%s' "${_out:-a witness set of a different shape}"
}

### The poured panel carries the source's password for its database server row;
### this box's instance user keeps its own, so every server verify (the rename's
### queue first) failed until the next Octopus pass re-synced it. The row takes
### the password this box set for the account (.<account>.pass.txt in the
### account root, read no-follow), under either the account's name or the
### source's (the rename maps the latter onto the former). Same text in xoct
### and xcopy.
_xoct_sync_panel_db_pass() {   # 1 account root 2 account here 3 source account 4 panel db
  local _p
  _p=$(_xoct_read_in "${1}" ".${2}.pass.txt" | head -1 | tr -d '\n')
  case "${_p}" in
    ""|*[!A-Za-z0-9+/=%@._-]*) return 1 ;;
  esac
  [ "${#_p}" -ge 9 ] || return 1
  mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp "${4}" \
    -e "UPDATE hosting_db_server SET db_passwd='${_p}' WHERE db_user IN ('${2}','${3}')" 2> /dev/null
}

_xoct_reconcile_panel_platform() {
  # Mirror of xmass step 12.5's panel platform drift handling (kept separate
  # by design -- mirror fixes, don't DRY). The imported hostmaster DB names
  # the SOURCE's panel platform path; an aged source usually sits on a
  # different distro/NNN than the freshly installed dest account (the panel
  # platform is rebuilt whenever the PHP pin changes). Left alone, the rename
  # queue's hostmaster verify regenerates aliases FROM the DB and the
  # migrated panel 404s from a hollow platform path. Retired platform trees
  # keep their code forever, so code presence at the imported number proves
  # nothing -- the LIVE panel is found by scanning for the unique site dir
  # that carries drushrc.php + settings.php on a code-bearing platform, and
  # the DB row is repointed only when that platform differs. Runs on the
  # TARGET between the DB import and renameaegirhost, so the account axis is
  # still SOURCE-named in the DB: only the platform number is corrected here
  # (kept under the source root -- renameaegirhost's account pass remaps the
  # root). Non-zero return means the panel cannot be resolved and the import
  # must not ride out as a success.
  local _dest_root="$1"
  local _src_acct="$2"
  local _hdb="$3"
  local _db_plat _dest_plat _tree _cand _found _n _new_plat _new_src_form
  local _fqdn _chk _nup _stored_db _pw _f _lit _vhf _vhd_dir
  _fqdn=$(hostname -f 2>/dev/null | tr -d '\n')
  _fqdn=${_fqdn//[^a-zA-Z0-9.-]/}
  if [ -z "${_fqdn}" ]; then
    echo "ALRT: no system FQDN; cannot resolve the live panel platform"
    return 1
  fi
  _db_plat=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp -N -B ${_hdb} -e "SELECT p.publish_path FROM \
    hosting_platform p JOIN hosting_site s ON s.platform=p.nid \
    JOIN hosting_context c ON c.nid=s.nid WHERE c.name='hostmaster' \
    LIMIT 1" 2>/dev/null)
  _db_plat=${_db_plat//[^a-zA-Z0-9\/._-]/}
  if [ -z "${_db_plat}" ]; then
    echo "ALRT: cannot read the hostmaster platform path from ${_hdb}; cannot reconcile the panel"
    return 1
  fi
  _dest_plat="${_db_plat/#\/data\/disk\/${_src_acct}\//${_dest_root}\/}"
  _tree="${_dest_root}/aegir/distro"
  _found=""
  _n=0
  for _cand in "${_tree}"/*/sites/*"${_fqdn}"*; do
    [ -f "${_cand}/drushrc.php" ] || continue
    [ -f "${_cand}/settings.php" ] || continue
    [ -e "$(dirname "$(dirname "${_cand}")")/index.php" ] || continue
    _found="${_cand}"
    _n=$(( _n + 1 ))
  done
  if [ "${_n}" != "1" ]; then
    echo "ALRT: ${_n} candidate live panels under ${_tree} match ${_fqdn} -- refusing to guess"
    return 1
  fi
  _new_plat=$(dirname "$(dirname "${_found}")")
  _chk=${_new_plat//[^a-zA-Z0-9\/._-]/}
  if [ "${_chk}" != "${_new_plat}" ]; then
    echo "ALRT: live panel platform path carries unexpected characters: ${_new_plat}"
    return 1
  fi
  # The live panel's stored credentials must name the DB the dump actually
  # landed in: a panel rebuild between create and import replaces the panel
  # DB, leaving drushrc/settings naming the dropped one -- renameaegirhost
  # then cannot locate the live DB (its own fallback scan needs dest-form
  # publish_path rows that only exist AFTER its account remap). Same
  # credential rewire xmass 12.5 does, applied only on a mismatch.
  # The site dir under aegir/distro is oN's: read and rewrite every credential
  # file inside its real directory, never through a link or into a FIFO the
  # account put at settings.php, drushrc.php or a vhost name. Each file is put
  # back as a fresh file with its own owner and mode (a root-owned settings.php
  # is silently skipped by drush/PHP), never chowned or chmodded by name.
  _stored_db=$(_xoct_read_in "${_found}" drushrc.php \
    | grep "options\['db_name'\]" \
    | head -1 | sed "s/.*=//; s/[' ,;]//g")
  _stored_db=${_stored_db//[^a-zA-Z0-9_]/}
  if [ -n "${_stored_db}" ] && [ "${_stored_db}" != "${_hdb}" ]; then
    _pw=$(od -An -N8 -tx8 /dev/urandom | tr -d " \n" | cut -c1-14)
    if [ -z "${_pw}" ]; then
      echo "ALRT: could not generate a password for the panel credential heal"
      return 1
    fi
    mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp \
      -e "CREATE USER IF NOT EXISTS '${_hdb}'@'localhost' IDENTIFIED BY '${_pw}'; \
          ALTER USER '${_hdb}'@'localhost' IDENTIFIED BY '${_pw}'; \
          GRANT ALL ON \`$(_xoct_db_grant_name "${_hdb}")\`.* TO '${_hdb}'@'localhost'; \
          CREATE USER IF NOT EXISTS '${_hdb}'@'%' IDENTIFIED BY '${_pw}'; \
          ALTER USER '${_hdb}'@'%' IDENTIFIED BY '${_pw}'; \
          GRANT ALL ON \`$(_xoct_db_grant_name "${_hdb}")\`.* TO '${_hdb}'@'%'; \
          FLUSH PRIVILEGES;" 2>/dev/null
    _xoct_db_revoke_wildcard "${_hdb}" localhost
    _xoct_db_revoke_wildcard "${_hdb}" %
    for _f in settings.php drushrc.php; do
      _xoct_in_real_dir "${_found}" test -f "./${_f}" || continue
      # A cloaked settings.php carries no literal credential lines -- it reads
      # them from the vhost or the sibling drushrc.php -- so the rewrite below
      # legitimately matches nothing there and must not be asserted.
      _lit=YES
      if ! _xoct_read_in "${_found}" "${_f}" | grep -q "^ *'database' => [\"'][^\"']*[\"']," \
        && ! _xoct_read_in "${_found}" "${_f}" | grep -q "^\$options\['db_name'\] = '"; then
        _lit=NO
      fi
      _xoct_in_real_dir "${_found}" _xoct_sed_here "${_f}" \
        -e "s#^\( *'database' => \)[\"'][^\"']*[\"'],#\1\"${_hdb}\",#" \
        -e "s#^\( *'username' => \)[\"'][^\"']*[\"'],#\1\"${_hdb}\",#" \
        -e "s#^\( *'password' => \)[\"'][^\"']*[\"'],#\1\"${_pw}\",#" \
        -e "s#^\(\$options\['db_name'\] = \)'[^']*';#\1'${_hdb}';#" \
        -e "s#^\(\$options\['db_user'\] = \)'[^']*';#\1'${_hdb}';#" \
        -e "s#^\(\$options\['db_passwd'\] = \)'[^']*';#\1'${_pw}';#"
      if [ "${_lit}" = "YES" ] && ! _xoct_read_in "${_found}" "${_f}" | grep -q "${_hdb}"; then
        echo "ALRT: panel credential heal did not land in ${_found}/${_f}"
        return 1
      fi
    done
    # A cloaked panel reads its web credentials from the vhost, not from
    # settings.php, so the rewire has to land there too or the panel keeps
    # authenticating as the dropped DB until the next render.
    _vhd_dir="${_dest_root}/config/server_master/nginx/vhost.d"
    for _vhf in "$(basename "${_found}")" "https.$(basename "${_found}")"; do
      _xoct_in_real_dir "${_vhd_dir}" test -f "./${_vhf}" || continue
      _xoct_in_real_dir "${_vhd_dir}" _xoct_sed_here "${_vhf}" \
        -e "s#^\( *fastcgi_param  *db_name  *\)[^;]*;#\1${_hdb};#" \
        -e "s#^\( *fastcgi_param  *db_user  *\)[^;]*;#\1${_hdb};#" \
        -e "s#^\( *fastcgi_param  *db_passwd  *\)[^;]*;#\1${_pw};#"
    done
    echo "PANEL-NOTE: live panel credentials healed ${_stored_db} -> ${_hdb} in ${_found}"
  fi
  if [ "${_new_plat}" = "${_dest_plat}" ]; then
    return 0
  fi
  _new_src_form="${_new_plat/#${_dest_root}\//\/data\/disk\/${_src_acct}\/}"
  echo "PANEL-NOTE: imported panel platform ${_db_plat} is not the live panel on this box; adopting ${_new_plat} (distro number diverged source vs target)"
  _nup=$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
    --protocol=tcp -N -B ${_hdb} -e "UPDATE hosting_platform SET \
    publish_path='${_new_src_form}' WHERE publish_path='${_db_plat}'; \
    SELECT ROW_COUNT();" 2>/dev/null | tail -1)
  if [ "${_nup}" = "1" ]; then
    echo "PANEL-NOTE: hostmaster platform row repointed ${_db_plat} -> ${_new_src_form} in ${_hdb} (rows=1)"
    return 0
  fi
  echo "ALRT: panel platform repoint matched ${_nup:-no} row(s) in ${_hdb} -- the panel would 404 after the rename"
  return 1
}

### NB: no migration read-only mode here on purpose. The historical runbook
### step appended box-wide read-only settings to global-extra.inc, which
### froze EVERY account on the source, did not survive a BOA system pass,
### and on most site shapes froze nothing. The export step's own per-account
### 503 gate (static/control/http-off.pid) is what actually quiesces writes
### for the export window.

### The db_name line of the panel site $1's drushrc.php, as found: read
### inside the real site directory, so a link or a FIFO at the name, or a
### link in the account's part of the path, gives nothing. The callers keep
### only [a-zA-Z0-9_] of it.
_xoct_panel_db_line() {
  _xoct_read_in "${1}" drushrc.php \
    | grep "options\['db_name'\] = " \
    | cut -d: -f2 \
    | awk '{ print $3}' \
    | sed "s/[\,';]//g"
}

### What import needs before it touches anything: the account installed here,
### the transferred panel dump, the source hostname export recorded (the
### rename pins OLD from it; this box's own server_master alias names this
### box), and a hostmaster alias naming a panel site this box really has,
### whose drushrc.php names the panel database. Each gap used to skip the
### whole panel import silently and still lift the 503 gate and exit 0.
### Refused here instead, before cron, chattr or any file of the account is
### changed.
_xoct_import_precheck() {
  local _why="" _hdb=""
  if [ ! -e "${_USR}/config/includes/nginx_vhost_common.conf" ]; then
    _why="${_THIS_HM_USER} is not installed on this box; run 'xoct create ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}' on the source first"
  elif [ ! -e "${_USR}/src/prev_hostmaster.sql" ]; then
    _why="${_USR}/src/prev_hostmaster.sql is missing; export and transfer have not completed"
  elif [ -z "$(_xoct_read_in "${_USR}/log" sourcefqdn.txt | tr -cd 'a-zA-Z0-9.-')" ]; then
    _why="${_USR}/log/sourcefqdn.txt is missing or empty; on the source run 'xoct reset-state ${_oct}', then export and transfer again"
  elif [ -z "${_THIS_HM_SITE}" ] || [ ! -e "${_THIS_HM_SITE}/drushrc.php" ]; then
    _why="the hostmaster alias names ${_THIS_HM_SITE:-no site_path}, which has no drushrc.php on this box"
  else
    _hdb="$(_xoct_panel_db_line "${_THIS_HM_SITE}")"
    _hdb="${_hdb//[^a-zA-Z0-9_]/}"
    if [ -z "${_hdb}" ]; then
      _why="${_THIS_HM_SITE}/drushrc.php names no panel database (no db_name line, or not a regular file inside a real directory)"
    fi
  fi
  [ -z "${_why}" ] && return 0
  echo "ERROR: import for ${_oct}: ${_why}"
  echo "ERROR: nothing was imported and nothing on this box was changed; fix the cause and re-run"
  return 1
}

# The source's web-group policy, seeded into the new account's cnf on the
# target before its install, so the arm that install runs (INIT) leaves the
# account alone there (_WEB_GROUP=NO, the opt-out) or takes it to phase A
# only (_WEB_GROUP=A, the --phase-a pin): the source's value as a plain
# line (the file made, root 0600, when absent), a _WEB_GROUP line in any
# form removed when the source has neither. Only while the name is free
# there: otherwise the install refuses it, and the line would land in
# another account's cnf. What was written is taken back when the install
# does not happen.
# 1 = account here 2 = account on the target 3 = target
_XOCT_WG_SEED=""
_XOCT_WG_SEEDV=""
_xoct_wg_seed() {
  local _v
  _XOCT_WG_SEED=""
  _v=$(_web_group_policy "/root/.${1}.octopus.cnf")
  case "${_v}" in
    NO|A) ;;
    *) _v=- ;;
  esac
  _XOCT_WG_SEEDV="${_v}"
  # the names expand here on purpose: the remote side gets them as text
  # shellcheck disable=SC2029
  _XOCT_WG_SEED=$(ssh root@"${3}" "getent passwd ${2} > /dev/null 2>&1 && exit 0
    _c=/root/.${2}.octopus.cnf
    _re='^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP='
    if [ ${_v} != - ]; then
      if [ ! -e \${_c} ]; then
        ( umask 077; printf '_WEB_GROUP=${_v}\\n' > \${_c} ) && echo made
      elif [ \"\$(grep -E \"\${_re}\" \${_c} | tail -n 1)\" != '_WEB_GROUP=${_v}' ]; then
        grep -vE \"\${_re}\" \${_c} > \${_c}.wgseed
        printf '_WEB_GROUP=${_v}\\n' >> \${_c}.wgseed && mv -f \${_c}.wgseed \${_c} && echo line
      fi
    elif [ -e \${_c} ] && grep -qE \"\${_re}\" \${_c}; then
      grep -vE \"\${_re}\" \${_c} > \${_c}.wgseed && mv -f \${_c}.wgseed \${_c}
    fi" 2> /dev/null)
  case "${_XOCT_WG_SEED}" in
    made|line) echo "INFO: the source's _WEB_GROUP=${_v} put into /root/.${2}.octopus.cnf on ${3} before its install" ;;
  esac
  return 0
}
# 1 = account on the target 2 = target
_xoct_wg_unseed() {
  case "${_XOCT_WG_SEED}:${_XOCT_WG_SEEDV}" in
    made:*)
      # shellcheck disable=SC2029
      ssh root@"${2}" "rm -f /root/.${1}.octopus.cnf" 2> /dev/null
      ;;
    line:NO|line:A)
      # the seed left its own line as the only _WEB_GROUP one
      # shellcheck disable=SC2029
      ssh root@"${2}" "_c=/root/.${1}.octopus.cnf; grep -vE '^[[:space:]]*(export[[:space:]]+)?_WEB_GROUP=' \${_c} > \${_c}.wgseed && mv -f \${_c}.wgseed \${_c}" 2> /dev/null
      ;;
  esac
  _XOCT_WG_SEED=""
  return 0
}

### A create marks the account it installed on the target: a root-only file
### naming this box and the source account, put only after the install
### succeeded. A later create goes on into an account the target already
### holds (no install, the seed again) only under that marker, so an
### unrelated account that carries the name is never seeded, and its LE
### config and control pids are never removed. The marker also records the
### account's uid there and the inode and birth time of /data/disk/<account>,
### read on the target when it is put: an account made again under the name
### usually gets its old uid back (adduser hands out the lowest free one) but
### a directory born later, so a marker left from the first is not trusted
### for it; no device number, which can change at a reboot. Same text in
### xoct and xcopy: a marker either tool put is read by both.
_xoct_create_marker() {   # 1 = account on the target
  printf '/root/.%s.migration-create.txt' "${1}"
}
### This box as the marker names it: hostname -f, nothing when that is not
### a hostname.
_xoct_create_src_host() {
  local _h
  _h="$(hostname -f 2> /dev/null | tr -d '\n')"
  case "${_h}" in
    ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*) return 1 ;;
  esac
  printf '%s' "${_h}"
}
### The one line that tells an operator how to adopt $2 on $3 as the
### account this box created for $1, when it really is.
_xoct_create_adopt_hint() {   # 1 = account here 2 = account on the target 3 = target 4 = this box
  echo "INFO: to adopt ${2} on ${3} as this migration's, run there: (umask 077; printf '_MIG_CREATE_SRC_HOST=%s\n_MIG_CREATE_SRC_OCT=%s\n_MIG_CREATE_TGT_UID=%s\n_MIG_CREATE_TGT_INODE=%s\n' ${4} ${1} \"\$(id -u ${2})\" \"\$(stat -c %i:%W /data/disk/${2})\" > $(_xoct_create_marker "${2}"))"
}
### Returns when the target $3 holds no account $2 (no passwd entry: what
### the install itself refuses on), or holds it under a marker naming this
### box and the source account $1, and the uid and /data/disk/$2 the account
### has there now; _XOCT_CREATE_HELD is YES in that case.
### With --adopt a held account is taken without the marker (ADOPT), and
### the marker is put for it once the create goes on: xmass passes it, since
### its targets hold accounts no create made (a fresh install's o1, a
### demoted failback box's own). Anything else refuses the create before it
### changes anything there: an account held without that marker, a marker
### that cannot be read, a probe that answers neither way. Read-only on the
### target.
_xoct_create_owner_gate() {   # 1 = account here 2 = account on the target 3 = target
  local _h _f _held _mark _mh _mo _mu _mi _nu _ni
  _XOCT_CREATE_HELD=""
  if [[ ! "${1}" =~ ^[a-zA-Z0-9._-]+$ ]] || [[ ! "${2}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "ALRT: refusing create: invalid account name '${1}'/'${2}'"
    exit 1
  fi
  if ! _h="$(_xoct_create_src_host)"; then
    echo "ALRT: refusing create: this box's hostname -f is not a hostname the create marker can name"
    exit 1
  fi
  _f="$(_xoct_create_marker "${2}")"
  _held=$(ssh root@"${3}" "if getent passwd ${2} > /dev/null 2>&1; then echo HELD; else echo FREE; fi" 2> /dev/null)
  case "${_held}" in
    FREE) return 0 ;;
    HELD) : ;;
    *)
      echo "ALRT: refusing create: could not read whether ${3} holds an account named ${2}"
      exit 1
      ;;
  esac
  ### The account's uid and /data/disk/$2 as they are now are printed before
  ### the marker, so a first match can only take these real values.
  _mark=$(ssh root@"${3}" "printf '_MIG_CREATE_NOW_UID=%s\n_MIG_CREATE_NOW_INODE=%s\n' \"\$(id -u ${2} 2> /dev/null)\" \"\$(stat -c %i:%W /data/disk/${2} 2> /dev/null)\"; [ -f ${_f} ] && [ ! -L ${_f} ] && [ \"\$(stat -c %u ${_f})\" = 0 ] && timeout 10 dd if=${_f} iflag=nofollow,nonblock,fullblock bs=65536 count=1 status=none" 2> /dev/null)
  _nu=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_NOW_UID=' | cut -d= -f2-)
  _ni=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_NOW_INODE=' | cut -d= -f2-)
  _mh=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_SRC_HOST=' | cut -d= -f2-)
  _mo=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_SRC_OCT=' | cut -d= -f2-)
  _mu=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_TGT_UID=' | cut -d= -f2-)
  _mi=$(printf '%s\n' "${_mark}" | grep -m1 '^_MIG_CREATE_TGT_INODE=' | cut -d= -f2-)
  if [ "${_mh}" = "${_h}" ] && [ "${_mo}" = "${1}" ] \
    && [[ "${_nu}" =~ ^[0-9]+$ ]] && [ "${_mu}" = "${_nu}" ] \
    && [[ "${_ni}" =~ ^[0-9]+:[0-9]+$ ]] && [ "${_mi}" = "${_ni}" ]; then
    _XOCT_CREATE_HELD=YES
    return 0
  fi
  if [ "${_XOCT_CREATE_ADOPT}" = "YES" ]; then
    _XOCT_CREATE_HELD=ADOPT
    return 0
  fi
  echo "DENY: ${3} already holds an account named ${2} that this migration did not create; nothing was changed there"
  if [ "${_mh}" = "${_h}" ] && [ "${_mo}" = "${1}" ] && [ -n "${_mu}${_mi}" ]; then
    echo "INFO: the create marker there was put for an earlier ${2}: the uid or /data/disk/${2} it records is not the account's now"
  fi
  _xoct_create_adopt_hint "${1}" "${2}" "${3}" "${_h}"
  exit 1
}
### The marker put on the target $3 for its account $2, installed for the
### source account $1: a fresh root 0600 file written through one no-follow
### handle (_XOCT_PUT_PL), then renamed over the name. The account's uid and
### the inode and birth time of /data/disk/$2 are read there in the same
### command; no
### marker is put when either cannot be read.
_xoct_create_mark() {   # 1 = account here 2 = account on the target 3 = target
  local _h _f _ts
  _h="$(_xoct_create_src_host)" || return 1
  _f="$(_xoct_create_marker "${2}")"
  _ts="$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2> /dev/null)"
  ssh root@"${3}" "_u=\$(id -u ${2} 2> /dev/null); _i=\$(stat -c %i:%W /data/disk/${2} 2> /dev/null); case \"\${_u}/\${_i}\" in *[!0-9:/]*) exit 1 ;; [0-9]*/[0-9]*:[0-9]*) : ;; *) exit 1 ;; esac; _t=/root/.${2}.migration-create.put.\$\$; rm -f -- \"\${_t}\"; printf '%s\n' '# Put by create: the account this migration installed here.' '_MIG_CREATE_SRC_HOST=${_h}' '_MIG_CREATE_SRC_OCT=${1}' \"_MIG_CREATE_TGT_UID=\${_u}\" \"_MIG_CREATE_TGT_INODE=\${_i}\" '_MIG_CREATE_STAMPED=${_ts}' | perl -e '${_XOCT_PUT_PL}' \"\${_t}\" 0 0 600 && mv -f -T -- \"\${_t}\" ${_f} && exit 0; rm -f -- \"\${_t}\"; exit 1"
}

_migrate_prepare() {
  # The watchdog stands down for the database verbs (_xoct_sql_maint_hold);
  # released at the end of this function, or by the EXIT trap.
  case "${_cmd}" in
    import|export) _xoct_sql_maint_hold ;;
  esac
  _THIS_HM_USER=$(_xoct_runtime_oct)
  _USR=/data/disk/${_THIS_HM_USER}
  ### .drush and log/ are oN's: read inside the real directories, never
  ### through a link or into a FIFO put at a name there
  _THIS_HM_SITE=$(_xoct_read_in "${_USR}/.drush" hostmaster.alias.drushrc.php \
    | grep "site_path'" \
    | cut -d: -f2 \
    | awk '{ print $3}' \
    | sed "s/[\,']//g")
  echo _THIS_HM_USER ${_THIS_HM_USER}
  echo _USR ${_USR}
  echo _THIS_HM_SITE ${_THIS_HM_SITE}
  ### _DOMAIN is otherwise assigned only in the import+fix branch, so every
  ### proxy/export notice has gone out with an empty subject tail. Read the
  ### per-account stamp here, alongside the other facts the mails are built from.
  if [ -e "${_USR}/log/domain.txt" ]; then
    _DOMAIN=$(_xoct_read_in "${_USR}/log" domain.txt)
    _DOMAIN=`echo -n ${_DOMAIN} | tr -d "\n"`
  fi
  if [ -e "${_USR}/log/option.txt" ]; then
    _CLIENT_OPTION=$(_xoct_read_in "${_USR}/log" option.txt)
    _CLIENT_OPTION=`echo -n ${_CLIENT_OPTION} | tr -d "\n"`
  fi
  if [ -e "${_USR}/log/cores.txt" ]; then
    _CLIENT_CORES=$(_xoct_read_in "${_USR}/log" cores.txt)
    _CLIENT_CORES=`echo -n ${_CLIENT_CORES} | tr -d "\n"`
  fi
  if [ -e "${_USR}/log/subscr.txt" ]; then
    _CLIENT_SUBSCR=$(_xoct_read_in "${_USR}/log" subscr.txt)
    _CLIENT_SUBSCR=`echo -n ${_CLIENT_SUBSCR} | tr -d "\n"`
  fi
  ### No stand-in address: the eligibility gate has refused create, export
  ### and pretransfer of an account with no plain address in log/email.txt
  ### or its cnf, and a notice to one is refused by _xoct_mail_rcpt.
  _xoct_client_address "${_USR}" "${_THIS_HM_USER}"
  if [ "${_XOCT_EMAIL_SRC}" = "cnf" ]; then
    echo "INFO: log/email.txt holds '$(_xoct_shown "${_XOCT_EMAIL_TXT}")', not a plain address: the client address is _CLIENT_EMAIL of /root/.${_THIS_HM_USER}.octopus.cnf, as the account's Octopus pass takes it"
  fi

  [ -z "${_THIS_DB_PORT}" ] && _THIS_DB_PORT=3306
  [ -z "${_CLIENT_OPTION}" ] && _CLIENT_OPTION=EDGE
  [ -z "${_CLIENT_SUBSCR}" ] && _CLIENT_SUBSCR=M
  [ -z "${_CLIENT_CORES}" ]  && _CLIENT_CORES=1

  echo "_CLIENT_EMAIL is ${_CLIENT_EMAIL//[^[:print:]]/?}"
  [ -n "${_XOCT_ADMAIL}" ] \
    && echo "INFO: admail=${_XOCT_ADMAIL}: every client notice of this run goes there alone; the account keeps its own address"
  echo "_THIS_HM_USER is ${_THIS_HM_USER}"
  echo "_CLIENT_OPTION is ${_CLIENT_OPTION}"
  echo "_CLIENT_SUBSCR is ${_CLIENT_SUBSCR}"
  echo "_CLIENT_CORES is ${_CLIENT_CORES}"

  if [ "${_cmd}" = "export" ] && [ ! -z "${_CLIENT_EMAIL}" ]; then
    ### The start notice carries the resolved forwarding promise where one is
    ### already declared, and the neutral wait-for-instructions block where the
    ### resolver falls back to the built-in default. Only a real send writes a
    ### mail line, and a neutral mail logs mode "-" so the first later promise
    ### correctly reads as a change.
    ### One notice per account+target: withholding exported.pid made re-running
    ### export the documented recovery, and every retry entered this block --
    ### dedupe on the recorded mail line (field 7 = peer), so a later migration
    ### to a DIFFERENT target still notifies. reset-state clears nothing here
    ### by design: the log is the audit trail of what the client was told.
    _XOCT_START_MAILED=$(_xoct_read_in "${_USR}/log" migproxy.log \
      | awk -F'|' -v t="${_tgt}" \
      '$3=="mail" && $4=="start" && $7==t { c++ } END { print c+0 }')
    if [ "${_XOCT_START_MAILED:-0}" != "0" ]; then
      echo "INFO: migration start notice already sent for ${_oct} to ${_tgt}; not re-mailing"
    else
      _mig_resolve "${_USR}"
      ### A refused compose must never fall through to a send with an empty
      ### forwarding block.
      if _mig_build_mail_blocks start "${_tgt}"; then
        _send_notice_migration_start
        if [ "${_MAIL_SENT}" = "YES" ]; then
          _XOCT_START_MODE="${_MIG_MODE}"
          [ "${_MIG_SOURCE}" = "default" ] && _XOCT_START_MODE="-"
          _mig_log "${_USR}" xoct "${_XOCT_MAIL_ACT}" start "${_XOCT_START_MODE}" "${_MIG_DEADLINE}" "${_tgt}"
        fi
      else
        echo "ALRT: start notice NOT sent: mail blocks refused to compose (see above)"
      fi
    fi
  fi

  if [ "${_cmd}" = "import" ] && [ ! -e "${_USR}/log/imported.pid" ]; then
    _xoct_import_precheck || exit 1
  fi
  ### The panel site is the account's: drushrc.php is read inside its real
  ### directory, never through a link or into a FIFO. Read before anything
  ### below changes the box, so the refusal that follows leaves it as it was.
  if [ -e "${_THIS_HM_SITE}/drushrc.php" ]; then
    _HDB=$(_xoct_panel_db_line "${_THIS_HM_SITE}")
    echo "raw _HDB is ${_HDB}"
    _HDB=${_HDB//[^a-zA-Z0-9_]/}
    echo "clean _HDB is ${_HDB}"
  else
    echo "no ${_THIS_HM_SITE}/drushrc.php found"
  fi
  ### The precheck read the same name; a drushrc.php swapped since then
  ### must not skip the panel import below and still lift the 503 gate.
  ### Refused before chattr, the task queue, cron or the gate is touched.
  if [ "${_cmd}" = "import" ] && [ ! -e "${_USR}/log/imported.pid" ] \
    && [ -z "${_HDB}" ]; then
    echo "ERROR: import for ${_oct}: ${_THIS_HM_SITE}/drushrc.php names no panel database"
    echo "ERROR: nothing was imported and nothing on this box was changed; fix the cause and re-run"
    exit 1
  fi
  ### The account's upgrade notice goes off on this box, before the first
  ### pass that follows the import, under admail= (recorded here too) or
  ### while a test run's record names the account here, token or not: the
  ### transfer brought the setup mail that pass would send.
  if [ "${_cmd}" = "import" ]; then
    if [ -n "${_XOCT_ADMAIL}" ]; then
      _xoct_admail_upgrade_mail_off "${_THIS_HM_USER}" "" record
      _xoct_hold_put ""
    elif [ -e "$(_xoct_admail_rec "${_THIS_HM_USER}")" ]; then
      echo "INFO: ${_THIS_HM_USER} came in a test run ($(_xoct_admail_rec "${_THIS_HM_USER}")): its upgrade notice stays off"
      _xoct_admail_upgrade_mail_off "${_THIS_HM_USER}"
    fi
    if [ -z "${_XOCT_ADMAIL}" ] && [ -e "${_XOCT_HOLD_FILE}" ]; then
      echo "ALRT: this box holds its clients' mail for $(_xoct_first_line "${_XOCT_HOLD_FILE}") (${_XOCT_HOLD_FILE}, put by a"
      echo "ALRT: test run): ${_THIS_HM_USER}'s client is not mailed from here while it is there"
    fi
    ### A move's first pass here that would mail the upgrade notice sends
    ### none (create put the marker; put again when a pass took it since),
    ### unless the account's switch here is NO and no test run's record
    ### names it (a canary's NO is the test's: go-live sets the source's).
    if [ "$(_xoct_upgrade_switch "/root/.${_THIS_HM_USER}.octopus.cnf")" != "NO" ] \
      || [ -e "$(_xoct_admail_rec "${_THIS_HM_USER}")" ]; then
      _xoct_upgrade_skip_put "${_THIS_HM_USER}" "" import
    fi
  fi

  su -s /bin/bash ${_THIS_HM_USER} -c "drush8 cc drush" &> /dev/null
  wait
  _XOCT_CHATTR_OFF=YES
  _disable_chattr ${_THIS_HM_USER}.ftp &> /dev/null
  rm -rf /home/${_THIS_HM_USER}.ftp/drush-backups
  _run_drush8_hmr_cmd "sqlq \"DELETE FROM hosting_task WHERE task_type='delete' AND task_status='-1'\""
  _run_drush8_hmr_cmd "sqlq \"DELETE FROM hosting_task WHERE task_type='delete' AND task_status='0' AND executed='0'\""
  ### clients/ belongs to oN: enter only real client subdirectories and
  ### remove only their own backups, then prune dangling links from inside
  ### the real clients/ -- never rm -rf or symlinks -dr through a link the
  ### account put at clients or at a client name.
  _xoct_clean_clients "${_USR}/clients"
  ### The .ftp home is the account's: the dangling-link prune runs inside
  ### the real home.
  if [ -d "/home/${_THIS_HM_USER}.ftp" ]; then
    _xoct_in_real_dir "/home/${_THIS_HM_USER}.ftp" symlinks -dr . &> /dev/null
    rm -f /home/${_THIS_HM_USER}.ftp/{.profile,.bash_logout,.bash_profile,.bashrc}
  fi
  ### src/ belongs to oN: make it a real directory (a link the account put at
  ### the name is removed) so the dump below cannot be steered elsewhere.
  _xoct_in_real_dir "${_USR}" _xoct_realdir_here src
  if [ "${_cmd}" = "export" ] \
    && [ ! -z "${_HDB}" ] \
    && [ ! -e "${_USR}/src/prev_hostmaster.sql" ] \
    && [ ! -e "${_USR}/log/exported.pid" ]; then
      # Full hostmaster DB dump. renameaegirhost rewrites the source host/IP
      # across the entire DB on import and its task queue regenerates db-host
      # and alias entries, so a per-table allowlist (which silently dropped any
      # unlisted or newly added schema table) is no longer needed.
      # Written into the real src/ as a fresh file renamed over the name, so a
      # link the account put at prev_hostmaster.sql (even a dangling one, past
      # the -e guard above) is replaced, never followed to create its target.
      _mysqldump_gtid_opts
      [ "${#_MYSQLDUMP_GTID[@]}" -eq 0 ] \
        && echo "INFO: this mysqldump takes no --set-gtid-purged: its dump carries no GTID state"
      if _xoct_in_real_dir "${_USR}/src" _xoct_dump_hm_here \
        mysqldump -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp \
        "${_MYSQLDUMP_GTID[@]}" \
        --single-transaction \
        --quick \
        --no-autocommit \
        --skip-add-locks \
        --no-tablespaces \
        --hex-blob ${_HDB}; then
        _XOCT_HM_DUMP_OK=YES
      else
        _XOCT_HM_DUMP_OK=NO
      fi
    _run_drush8_hmr_cmd "variable-set --always-set maintenance_mode 1"
    ### The panel serves anonymous pages from Drupal's page cache and a
    ### variable change alone leaves the cached front page in place, so the
    ### hold is invisible until the next cache clear: flush it here.
    _run_drush8_hmr_cmd "cache-clear all" &> /dev/null
    ### The redirect pre-creates the file, so the old existence test read a
    ### failed mysqldump as success and stamped exported.pid over a zero-byte
    ### or truncated panel dump. Demand rc=0 AND a non-empty file.
    if [ "${_XOCT_HM_DUMP_OK}" = "YES" ] \
      && [ -s "${_USR}/src/prev_hostmaster.sql" ]; then
      echo "INFO: hostmaster ${_oct} db export complete"
      # Record the source FQDN for the import-side rename. The target keeps
      # its own server_master alias (the transfer never sends this one), so
      # renameaegirhost's auto-detection there would read OLD==NEW and
      # silently no-op while the imported DB still holds this FQDN.
      # Recording it here pins OLD deterministically (and keeps an aborted
      # rename re-runnable after §3 already rewrote the aliases); import
      # refuses without it. Travels with the log/ transfer sync.
      # The alias is read and the record put inside the real .drush and
      # log/ (both oN's), never through a link put at either name.
      _SRC_FQDN=$(_xoct_read_in "${_USR}/.drush" server_master.alias.drushrc.php \
        | grep "remote_host" \
        | head -1 \
        | sed "s/.*remote_host.*=>//; s/[' ,;]//g")
      _SRC_FQDN=${_SRC_FQDN//[^a-zA-Z0-9.\-]/}
      [ -z "${_SRC_FQDN}" ] && _SRC_FQDN=$(hostname -f 2>/dev/null | tr -d '\n')
      printf '%s' "${_SRC_FQDN}" \
        | _xoct_in_real_dir "${_USR}/log" _xoct_write_here sourcefqdn.txt 022
      ### exported.pid is stamped by the run verdict AFTER _migrate_sites,
      ### and only when every site dump completed -- the marker now means
      ### "this account's export is restorable", not "a dump was attempted".
    else
      ### Remove the debris so a re-run redumps from scratch instead of
      ### skipping the hostmaster block on the pre-created file.
      _xoct_in_real_dir "${_USR}/src" rm -f -- ./prev_hostmaster.sql
      echo "ALRT: hostmaster ${_oct} db export FAILED (mysqldump error or empty dump)"
      exit 1
    fi
  fi
  _XOCT_SITES_STAGE=""
  _XOCT_SEEN_DIRS=""
  _XOCT_LOADED_DIRS=""
  _XOCT_LOADED_NAMES=""
  _XOCT_MET_DIRS=""
  _XOCT_RUNNER_UNTIL=""
  _XOCT_DEFERRED_N=0
  _XOCT_DEFER_MET=0
  if [ "${_cmd}" = "import" ] \
    && [ -e "${_USR}/config/includes/nginx_vhost_common.conf" ] \
    && [ ! -z "${_HDB}" ] \
    && [ -e "${_USR}/src/prev_hostmaster.sql" ] \
    && [ ! -e "${_USR}/log/imported.pid" ]; then
    ### Target-side quiesce, previously a hand-typed runbook step: BOA's own
    ### background jobs must not fight the hostmaster import and the rename
    ### queue. Cron comes back via post-mig. Devuan trap: 'service cron stop'
    ### does not always stop it -- use the init script plus pkill, verified.
    /etc/init.d/cron stop &> /dev/null || service cron stop &> /dev/null
    pkill -x cron &> /dev/null
    if pgrep -x cron &> /dev/null; then
      echo "ALRT: cron still running after stop attempt; check manually"
    fi
    [ -e "/data/all/cpuinfo" ] && _xoct_in_real_dir \
      "$(_s="$(perl -e "${_ROOT_REAL_PATH_PL}" -- /data/all 2> /dev/null)" \
        && perl -e "${_SAT_STORE_TARGET_PL}" -- "${_s}" > /dev/null 2>&1 \
        && echo "${_s}" || echo /data/all)" \
      _xoct_fchmod_here 644 ./cpuinfo
    _xoct_wait_boa_quiet
    if [ ! -z "${_dst}" ] && [ "${_oct}" != "${_dst}" ]; then
      echo "INFO: rename mode import for source ${_oct} into target account ${_dst}"
      [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL5R -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
    else
      [ -e "/root/.my.cluster_root_pwd.txt" ] && echo "SQL6 -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp"
    fi
    # The alias-derived _HDB can name a DB an enforced upgrade has already
    # replaced: a dest panel rebuilt between create and import (new panel DB
    # created, old one dropped) leaves the on-disk alias stale, and the dump
    # would then pour into a nonexistent DB with the import riding on. The
    # pre-mig runner park holds create's armed upgrade until post-mig, so
    # this is the shape of a park that lapsed (24 h ceiling, reboot) or was
    # never taken on this box, no longer the norm. Resolution order: the
    # recorded decision from a previous (possibly partial) import run,
    # then the alias-derived name, then a
    # dest-form panel scan (the 12.5 way), then the already-poured shape (a
    # partial run leaves the live DB holding SOURCE-form rows, invisible to
    # the dest-form scan — its hostmaster front names the recorded source
    # FQDN, which nothing else on the box can carry). The winner is recorded
    # so the printed recovery path stays deterministic. log/ is oN's: its
    # records are read and put inside the real directory, never through a
    # link or into a FIFO put at the name.
    if [ -s "${_USR}/log/panel_db.txt" ]; then
      _HDB_REC=$(_xoct_read_in "${_USR}/log" panel_db.txt | tr -d "\n")
      _HDB_REC=${_HDB_REC//[^a-zA-Z0-9_]/}
      if [ -n "${_HDB_REC}" ] && [ -n "$(mysql --silent -u root -h${_SQL_CONNECT} \
          -P${_THIS_DB_PORT} --protocol=tcp -N -B \
          -e "SHOW DATABASES LIKE '${_HDB_REC}'" 2>/dev/null)" ]; then
        [ "${_HDB_REC}" != "${_HDB}" ] \
          && echo "PANEL-NOTE: using the recorded panel DB ${_HDB_REC} (alias-derived ${_HDB} superseded)"
        _HDB="${_HDB_REC}"
      fi
    fi
    if [ -z "$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
        --protocol=tcp -N -B -e "SHOW DATABASES LIKE '${_HDB}'" 2>/dev/null)" ]; then
      _SRC_FRONT=""
      if [ -s "${_USR}/log/sourcefqdn.txt" ]; then
        _SRC_FRONT="${_oct}.$(_xoct_read_in "${_USR}/log" sourcefqdn.txt | tr -d "\n")"
        _SRC_FRONT=${_SRC_FRONT//[^a-zA-Z0-9.-]/}
      fi
      _HDB_LIVE=""
      _HDB_POURED=""
      for _HC in $(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
          --protocol=tcp -N -B -e "SHOW DATABASES" 2>/dev/null \
        | grep -vE "^(information_schema|performance_schema|mysql|sys)$"); do
        case "${_HC}" in *[!A-Za-z0-9_]*) continue ;; esac
        if [ -n "$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
            --protocol=tcp -N -B "${_HC}" -e "SELECT name FROM hosting_context \
            WHERE name='server_master' LIMIT 1" 2>/dev/null)" ]; then
          if [ -n "$(mysql --silent -u root -h${_SQL_CONNECT} -P${_THIS_DB_PORT} \
              --protocol=tcp -N -B "${_HC}" -e "SELECT publish_path FROM \
              hosting_platform WHERE publish_path LIKE '${_USR}/%' LIMIT 1" 2>/dev/null)" ]; then
            if [ -n "${_HDB_LIVE}" ]; then
              echo "ERROR: multiple live panel DBs match ${_USR} (${_HDB_LIVE}, ${_HC}) — refusing to guess"
              exit 1
            fi
            _HDB_LIVE="${_HC}"
          elif [ -n "${_SRC_FRONT}" ] && [ -n "$(mysql --silent -u root \
              -h${_SQL_CONNECT} -P${_THIS_DB_PORT} --protocol=tcp -N -B "${_HC}" \
              -e "SELECT n.title FROM node n JOIN hosting_context c ON c.nid=n.nid \
              WHERE c.name='hostmaster' AND n.title='${_SRC_FRONT}' LIMIT 1" 2>/dev/null)" ]; then
            if [ -n "${_HDB_POURED}" ]; then
              echo "ERROR: multiple DBs carry the source panel front ${_SRC_FRONT} (${_HDB_POURED}, ${_HC}) — refusing to guess"
              exit 1
            fi
            _HDB_POURED="${_HC}"
          fi
        fi
      done
      if [ -n "${_HDB_LIVE}" ]; then
        echo "PANEL-NOTE: alias-derived panel DB ${_HDB} is gone (panel rebuilt since create); importing into live panel DB ${_HDB_LIVE}"
        _HDB="${_HDB_LIVE}"
      elif [ -n "${_HDB_POURED}" ]; then
        echo "PANEL-NOTE: alias-derived panel DB ${_HDB} is gone; resuming into ${_HDB_POURED} (already carries the source panel front from a previous run)"
        _HDB="${_HDB_POURED}"
      else
        echo "ERROR: alias-derived panel DB ${_HDB} does not exist and no live panel DB"
        echo "ERROR: matches ${_USR} — the dest account has no importable panel; re-run"
        echo "ERROR: 'xoct create ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}' first"
        exit 1
      fi
    fi
    printf '%s' "${_HDB}" \
      | _xoct_in_real_dir "${_USR}/log" _xoct_write_here panel_db.txt 022
    ### src/ is oN's on the target: the dump is streamed from inside the real
    ### directory, never through a link, and fed with --binary-mode, so the
    ### client runs no \! or system command from the dump. pipefail keeps a
    ### streaming failure (a link) from passing as a clean load.
    if ! ( set -o pipefail
      _xoct_in_real_dir "${_USR}/src" _xoct_cat_here prev_hostmaster.sql \
        | mysql --binary-mode --silent -u root -h${_SQL_CONNECT} \
          -P${_THIS_DB_PORT} --protocol=tcp ${_HDB} ); then
      echo "ERROR: hostmaster dump import into ${_HDB} FAILED — this import is INCOMPLETE"
      echo "ERROR: nothing was renamed; fix the cause, then re-run the FULL import"
      exit 1
    fi
    ### The panel keeps the front page its dump carries, node included.
    ### The source-role latches travelled here inside the account's log/
    ### tree. Left in place they block this box from ever being a source
    ### itself: create refuses "already created" on exported.pid and export
    ### refuses "already exported" -- exactly the chained shape a staged
    ### fleet move needs (old box -> new primary -> HA mirror). A completed
    ### import starts a fresh lifecycle here, so the latches of the
    ### migration that ENDED with this import are cleared with the stamp. A
    ### proxy-failed.pid (an older source shipped it) goes too: this box
    ### serves the account now, and the marker would park its dispatcher.
    _xoct_in_real_dir "${_USR}/log" rm -f -- ./exported.pid ./transferred.pid \
      ./export_failed.pid ./proxy-failed.pid
    _xoct_in_real_dir "${_USR}/log" _xoct_touch_here imported.pid
    if ! _xoct_reconcile_panel_platform "${_USR}" "${_oct}" "${_HDB}"; then
      echo "ERROR: panel platform reconciliation failed for ${_USR} — this import is INCOMPLETE"
      echo "ERROR: the imported DB names a hostmaster platform this box cannot serve; continuing"
      echo "ERROR: would leave the migrated control panel dead after the rename queue runs"
      echo "ERROR: recovery — fix the cause the ALRT above names, then re-run the FULL import:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xoct import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
      exit 1
    fi
    if ! _xoct_sync_panel_db_pass "${_USR}" "${_THIS_HM_USER}" "${_oct}" "${_HDB}"; then
      echo "ALRT: the panel's database server password was not synced for ${_THIS_HM_USER}: its server"
      echo "ALRT: verify fails until the next Octopus pass (check ${_USR}/.${_THIS_HM_USER}.pass.txt)"
    fi

    if [ "${_fix}" = "fix" ]; then
      _DOMAIN=$(_xoct_read_in "${_USR}/log" domain.txt)
      _DOMAIN=`echo -n ${_DOMAIN} | tr -d "\n"`

      _vSet="variable-set --always-set"
      _run_drush8_hmr_cmd "${_vSet} hosting_client_send_welcome 0" &> /dev/null
    fi

    ### The sites' databases and their users, the account's PHP pools and the
    ### lifted 503 gate all come before the rename: its queue verifies every
    ### renamed site and its serving gate then probes each one, and a site
    ### whose database user does not exist yet fails that verify, as a site
    ### without a live pool, or behind the gate, fails the probe for its whole
    ### wait. The verify of each clean load is scheduled after the rename,
    ### under the site's name there (the second _migrate_sites below). A
    ### failed rename puts the gate back.
    _XOCT_SITES_STAGE=load
    _migrate_sites
    _xoct_heal_fpm_pins "${_THIS_HM_USER}"
    _XOCT_GATE_LIFTED=""
    if _xoct_in_real_dir "${_USR}/static/control" test -f ./http-off.pid; then
      _XOCT_GATE_TTL=$(_xoct_read_in "${_USR}/static/control" http-off.pid | tr -cd '0-9' | cut -c1-9)
      _xoct_in_real_dir "${_USR}/static/control" rm -f -- ./http-off.pid
      _XOCT_GATE_LIFTED=YES
      if [ -d "/var/lib/nginx/speed" ]; then
        find /var/lib/nginx/speed -type f -delete &> /dev/null
      fi
      echo "INFO: account ${_THIS_HM_USER} 503 gate lifted for the rename's serving check"
    fi

    ###
    ### Rename all source-hostname references in this Aegir instance to the
    ### FQDN of the current (target) server. renameaegirhost:
    ###   §1  old hostname: pinned via --force-old from log/sourcefqdn.txt
    ###       (recorded at export; this box keeps its own server_master
    ###       alias, so auto-detection and a partial-rename re-run would
    ###       both no-op at OLD==NEW)
    ###   §2  detects new hostname from system FQDN (hostname -f)
    ###   §3  rewrites .drush/*.alias.drushrc.php files
    ###   §4  rewrites + renames nginx vhost files in config/server_master/
    ###   §5  renames the source FQDN inside the Aegir DB with serialize-safe
    ###       targeted statements (identity rows by hosting_context nid,
    ###       varchar REPLACE sweeps, unserialize/replace/re-serialize pass
    ###       over the variable table); keeps a plain backup dump
    ###   §6  reloads nginx
    ###   §7  runs the Aegir task queue 5 times (cc drush + server verify +
    ###       hosting-dispatch + hosting-tasks) to regenerate all on-disk
    ###       aliases, vhosts, and db-host entries from the updated DB
    ### Must run AFTER all structural SQL fixes above (hosting_context,
    ### node types, platform paths, etc.) because §7 regenerates everything
    ### from the DB state those fixes shaped.
    ###
    _RAH_OLD=""
    if [ -s "${_USR}/log/sourcefqdn.txt" ]; then
      _RAH_OLD=$(_xoct_read_in "${_USR}/log" sourcefqdn.txt | tr -d "\n")
      _RAH_OLD=${_RAH_OLD//[^a-zA-Z0-9.\-]/}
    fi
    # Rename-mode import (source account lands under a different target
    # account): ride the ACCOUNT axis in the same run, else the imported DB
    # keeps /data/disk/<src> paths and the <src>-named panel identity and
    # the first DB-driven regeneration re-stamps them over the transfer-time
    # fixes.
    _RAH_ACCT=""
    if [ ! -z "${_dst}" ] && [ "${_oct}" != "${_dst}" ]; then
      _RAH_ACCT=" --old-account ${_oct} --new-account ${_dst}"
    fi
    if [ ! -z "${_RAH_OLD}" ]; then
      renameaegirhost --aegir-root "${_USR}" --force-old "${_RAH_OLD}"${_RAH_ACCT}
      _RAH_RC=$?
    else
      # Unreachable past _xoct_import_precheck. Auto-detection would read
      # this box's own server_master alias (OLD==NEW) and rename nothing.
      echo "ERROR: log/sourcefqdn.txt names no source hostname; not renaming"
      _RAH_RC=1
    fi
    if [ "${_RAH_RC}" -ne 0 ]; then
      if [ "${_XOCT_GATE_LIFTED}" = "YES" ]; then
        ### the put refuses a gate file already there: judged by what is
        ### there after it
        _xoct_in_real_dir "${_USR}/static" _xoct_ctrl_dir_here \
          && _xoct_in_real_dir "${_USR}/static/control" \
            _xoct_gate_put_here http-off.pid "${_XOCT_GATE_TTL:-3600}" \
            "${_THIS_HM_USER}:$(_acct_group "${_USR}")"
        if _xoct_in_real_dir "${_USR}/static/control" test -f ./http-off.pid; then
          echo "INFO: account ${_THIS_HM_USER} 503 gate put back"
        else
          echo "ALRT: account ${_THIS_HM_USER} 503 gate could NOT be put back (static/control/http-off.pid): its sites serve from this box"
        fi
        ### what the probes cached while the gate was lifted goes with it
        if [ -d "/var/lib/nginx/speed" ]; then
          find /var/lib/nginx/speed -type f -delete &> /dev/null
        fi
      fi
      echo "ERROR: renameaegirhost failed (rc=${_RAH_RC}) for ${_USR} — this import is INCOMPLETE"
      echo "ERROR: every import step after the rename was skipped: the site verifies, the cache"
      echo "ERROR: flush, the pinned PHP pool rebuild for the renamed sites and the 503-gate"
      echo "ERROR: removal (static/control/http-off.pid) — the imported panel and sites stay"
      echo "ERROR: 503-gated until the import tail runs"
      echo "ERROR: recovery — fix the cause, then re-run the FULL import:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xoct import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
      echo "ERROR: (safe: re-imports the same already-transferred dump, redoes rename + tail)"
      echo "ERROR: to iterate on the rename failure alone first (convergent, safe to re-run):"
      echo "ERROR:   renameaegirhost --aegir-root ${_USR} --force-old ${_RAH_OLD:-<source-fqdn>}${_RAH_ACCT}"
      echo "ERROR: the full import re-run above is still required to finish the skipped tail"
      exit 1
    fi

  fi
  if [ "${_cmd}" = "create" ]; then
    if [ ! -z "${_dst}" ]; then
      _TGT_HM_USER="${_dst}"
    else
      _TGT_HM_USER="${_oct}"
    fi
    ### These values are interpolated into a remote root shell; log/ arrives
    ### over the network on a chained migration, so validate before use.
    if ! _mig_valid_acct "${_oct}" || ! _mig_valid_acct "${_TGT_HM_USER}"; then
      echo "ALRT: refusing create: invalid account name '${_oct}'/'${_TGT_HM_USER}'"
      exit 1
    fi
    ### While the account holds its own group here, _xoct_acct_gmap refuses a
    ### destination name outside [a-z0-9-]: refused here, before anything is
    ### installed, not after the install.
    if getent group "${_oct}" > /dev/null 2>&1; then
      case "${_TGT_HM_USER}" in
        ''|*[!a-z0-9-]*)
          echo "ALRT: refusing create: '${_TGT_HM_USER}' is not an account name the group map can carry"
          exit 1
          ;;
      esac
    fi
    ### The install takes one address: an account whose address is a list
    ### is installed with the first, and the transfer carries the account's
    ### own log/email.txt over the install's copy, so the target keeps the
    ### list as it is.
    _XOCT_INSTALL_EMAIL="${_CLIENT_EMAIL%% *}"
    if ! printf '%s' "${_XOCT_INSTALL_EMAIL}" | grep -qE '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'; then
      echo "ALRT: refusing create: client email '${_XOCT_INSTALL_EMAIL//[^[:print:]]/?}' failed validation"
      exit 1
    fi
    if [ "${_XOCT_INSTALL_EMAIL}" != "${_CLIENT_EMAIL}" ]; then
      echo "INFO: the account's address is a list: installed with its first address, the transfer carries the list in log/email.txt as it is"
    fi
    ### The plan stamps come from log/ files that arrive over the network on
    ### a chained migration and are spliced into a remote root command --
    ### strip them to their legal alphabets and refuse when nothing is left.
    _CLIENT_OPTION=${_CLIENT_OPTION//[^a-zA-Z0-9]/}
    _CLIENT_SUBSCR=${_CLIENT_SUBSCR//[^a-zA-Z0-9]/}
    _CLIENT_CORES=${_CLIENT_CORES//[^0-9]/}
    if [ -z "${_CLIENT_OPTION}" ] || [ -z "${_CLIENT_SUBSCR}" ] || [ -z "${_CLIENT_CORES}" ]; then
      echo "ALRT: refusing create: plan stamps failed validation (option/subscr/cores)"
      exit 1
    fi
    ### A test run is recorded here before the target is touched, so a create
    ### that stops half way still holds every later verb to the token. Not in
    ### the creates xmass runs: its own record holds its cutover.
    if [ -n "${_XOCT_ADMAIL}" ] && [ "${_XOCT_XMASS_RUN}" != "YES" ]; then
      _xoct_admail_record_here "${_oct}" || exit 1
    fi
    if [ ! -z "${_CLIENT_EMAIL}" ] \
      && [ ! -z "${_TGT_HM_USER}" ] \
      && [ ! -z "${_CLIENT_OPTION}" ] \
      && [ ! -z "${_CLIENT_SUBSCR}" ] \
      && [ ! -z "${_CLIENT_CORES}" ]; then
      ### An account the target already holds is this migration's only
      ### under its create marker: asked before --fix-php or anything else
      ### changes the target.
      _xoct_create_owner_gate "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      ### The pinned PHP set must exist on the target BEFORE anything is
      ### installed or seeded there; a missing version means silent fallback
      ### to a different PHP on the migrated sites.
      _xoct_php_coverage_gate "${_USR}" "${_tgt}" || exit 1
      ### Install from the TARGET's own tree: a cross-tree migration must not
      ### push the source's tree through the target's licence gate.
      _TGT_TREE="$(_mig_target_tree "${_tgt}")"
      case "${_TGT_TREE}" in
        dev|lts|pro) : ;;
        *)
          echo "ALRT: invalid tree token '${_TGT_TREE}' from the target probe; refusing create"
          exit 1
        ;;
      esac
      if [ "${_TGT_TREE}" != "${_tRee}" ]; then
        echo "ALRT: source tree is ${_tRee} but target ${_tgt} runs ${_TGT_TREE}; installing for ${_TGT_TREE}"
      fi
      ### A ProxySQL source account must be born ProxySQL-wired on the
      ### target, not retro-fitted: in-oct is in-octopus plus that wiring.
      _IN_VERB=in-octopus
      if [ -e "/data/conf/${_oct}_use_proxysql.txt" ]; then
        _IN_VERB=in-oct
        echo "INFO: source account uses ProxySQL; installing with 'boa in-oct'"
      fi
      ### Asked again: the PHP pass above can run for half an hour.
      _xoct_create_owner_gate "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      ### Under admail= the target holds its clients' mail for that address
      ### before anything is installed there (xmass puts it for its own
      ### creates); a create that cannot put it, refuses.
      if [ -n "${_XOCT_ADMAIL}" ] && [ "${_XOCT_XMASS_RUN}" != "YES" ]; then
        _xoct_hold_put "${_tgt}" || exit 1
      fi
      ### Existence keyed on what only a real INSTALL produces: log/cores.txt
      ### alone is force-copied by the transfer path, so it would let an
      ### out-of-order run seed config onto a bare rsync tree.
      _TGT_PRESENT=$(ssh root@${_tgt} "getent passwd ${_TGT_HM_USER} >/dev/null 2>&1 \
        && [ -e /root/.${_TGT_HM_USER}.octopus.cnf ] \
        && [ -e /data/disk/${_TGT_HM_USER}/config/includes/nginx_vhost_common.conf ] \
        && echo PRESENT" 2>/dev/null)
      if [ "${_TGT_PRESENT}" = "PRESENT" ] \
        && { [ "${_XOCT_CREATE_HELD}" = "YES" ] || [ "${_XOCT_CREATE_HELD}" = "ADOPT" ]; }; then
        ### Idempotent re-run: skip the expensive install, still re-seed the
        ### config and credentials below so a repeated create converges.
        ### Only under this migration's marker, or adopted (--adopt, which
        ### puts it); an account that appeared since the gate goes to the
        ### install, which refuses the name.
        echo "INFO: account ${_TGT_HM_USER} already installed on ${_tgt}; skipping install, re-seeding config"
        if [ "${_XOCT_CREATE_HELD}" = "ADOPT" ]; then
          echo "INFO: account ${_TGT_HM_USER} on ${_tgt} adopted for this migration (--adopt)"
          if ! _xoct_create_mark "${_oct}" "${_TGT_HM_USER}" "${_tgt}"; then
            echo "ALRT: the create marker for ${_TGT_HM_USER} could not be put on ${_tgt}; a re-run of this create without --adopt will refuse the account"
            _xoct_create_adopt_hint "${_oct}" "${_TGT_HM_USER}" "${_tgt}" "$(_xoct_create_src_host)"
          fi
        fi
      else
        ### The install's welcome mail would hand the client a brand-new
        ### password that the credential carry below immediately replaces
        ### with their existing one -- suppress it for this install only,
        ### preserving any operator-set marker. An unreadable probe means
        ### "unknown": never touch, never remove someone else's marker.
        _xoct_wait_target_quiet "${_tgt}" || exit 1
        _SILENT_MARKER=NO
        _SILENT_PROBE=$(ssh root@${_tgt} "[ -e /root/.silent.update.cnf ] && echo YES || echo NO" 2>/dev/null)
        if [ "${_SILENT_PROBE}" = "NO" ]; then
          if ssh root@${_tgt} "touch /root/.silent.update.cnf"; then
            _SILENT_MARKER=YES
          fi
        elif [ -z "${_SILENT_PROBE}" ]; then
          echo "ALRT: could not probe the mail-suppression marker on ${_tgt};"
          echo "ALRT: the install may mail a welcome password that the credential carry replaces"
        fi
        ### Under admail= the install must not mail the client at all: with
        ### no marker held there, nothing is installed.
        if [ -n "${_XOCT_ADMAIL}" ] && [ "${_SILENT_MARKER}" != "YES" ] \
          && [ "${_SILENT_PROBE}" != "YES" ]; then
          echo "ALRT: refusing create under admail=: the mail-suppression marker could not be put on ${_tgt},"
          echo "ALRT: so the install would mail its welcome to the account's own address; nothing was installed"
          exit 1
        fi
        ### The marker must come off even if the install dies, or the target
        ### stays silent for every later BOA mail on the box. This handler
        ### REPLACES the single-flight lock's own cleanup for the install
        ### window, so it must release the lock too -- otherwise an interrupt
        ### here leaves ${_XOCT_LOCK_FILE} behind with a dead owner. The
        ### signal handler exits (bash would otherwise resume at the next
        ### statement and run the rest of the create unlocked); exiting runs
        ### the EXIT handler, which does the removals.
        trap '_xoct_chattr_back; [ "${_SILENT_MARKER}" = "YES" ] && ssh root@'"${_tgt}"' "rm -f /root/.silent.update.cnf" &> /dev/null; rm -f "${_XOCT_LOCK_FILE}"' EXIT
        trap 'exit 130' INT TERM HUP
        _xoct_wg_seed "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
        ssh root@${_tgt} "/opt/local/bin/boa ${_IN_VERB} ${_XOCT_INSTALL_EMAIL} ${_TGT_HM_USER} ${_TGT_TREE} ${_CLIENT_OPTION} ${_CLIENT_SUBSCR} ${_CLIENT_CORES} noscreen"
        _INSTALL_RC=$?
        if [ "${_SILENT_MARKER}" = "YES" ]; then
          ### The runner takes the marker off when it starts a queued
          ### upgrade: one that did so during the install let the welcome go.
          _SILENT_AFTER=$(ssh root@${_tgt} "[ -e /root/.silent.update.cnf ] && echo YES || echo NO" 2>/dev/null)
          if [ "${_SILENT_AFTER}" = "NO" ]; then
            echo "ALRT: the mail-suppression marker was gone from ${_tgt} when the install ended (a queued"
            echo "ALRT: upgrade run takes it off): the install's welcome may have reached the account's own address"
          fi
          ssh root@${_tgt} "rm -f /root/.silent.update.cnf"
          _SILENT_MARKER=NO
        fi
        ### The launcher exits 1 without installing when a run lock is held
        ### or the name is taken (and the install can die for its own
        ### reasons): prove the account exists before seeding anything, never
        ### report a refusal complete. An account refused as taken reads as
        ### born too, so the launcher's own success counts as well.
        _TGT_BORN=$(ssh root@${_tgt} "getent passwd ${_TGT_HM_USER} >/dev/null 2>&1 \
          && [ -e /root/.${_TGT_HM_USER}.octopus.cnf ] \
          && [ -s /data/disk/${_TGT_HM_USER}/log/octopus_log.txt ] \
          && echo BORN" 2>/dev/null)
        if [ "${_INSTALL_RC}" != "0" ] || [ "${_TGT_BORN}" != "BORN" ]; then
          _xoct_wg_unseed "${_TGT_HM_USER}" "${_tgt}"
          echo "ALRT: install of ${_TGT_HM_USER} on ${_tgt} did not happen (launcher rc=${_INSTALL_RC});"
          echo "ALRT: read the launcher output above -- re-run this create once ${_tgt} is quiet"
          exit 1
        fi
        ### Restore the single-flight lock's cleanup (see _take_verb_lock) --
        ### a bare `trap -` here would orphan ${_XOCT_LOCK_FILE} for the whole
        ### rest of the run.
        trap '_xoct_chattr_back; rm -f "${_XOCT_LOCK_FILE}"' EXIT
        trap 'rm -f "${_XOCT_LOCK_FILE}"; exit 130' INT TERM HUP
        if ! _xoct_create_mark "${_oct}" "${_TGT_HM_USER}" "${_tgt}"; then
          echo "ALRT: the create marker for ${_TGT_HM_USER} could not be put on ${_tgt}; a re-run of this create will refuse the account"
          _xoct_create_adopt_hint "${_oct}" "${_TGT_HM_USER}" "${_tgt}" "$(_xoct_create_src_host)"
        fi
        ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/.ctrl/ssl-demo-mode.pid"
        ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/config"
        ssh root@${_tgt} "/bin/rm -f /data/disk/${_TGT_HM_USER}/tools/le/config.sh"
      fi
      if [ -e "/data/conf/${_oct}_use_proxysql.txt" ]; then
        ssh root@${_tgt} "mkdir -p /data/conf && echo ProxySQL > /data/conf/${_TGT_HM_USER}_use_proxysql.txt"
      fi
      ### Let the install's own background octopus run settle BEFORE seeding:
      ### it reads and rewrites the very cnf and control files seeded below,
      ### so seeding first would race it (the historical fixed wait sat here
      ### for the same reason).
      _xoct_wait_target_install_settled "${_TGT_HM_USER}" "${_tgt}"
      ### The seeding legs below map the account's group and, on a rename,
      ### its identities (no destination pass follows create). Asked before
      ### anything is seeded: a refusal then leaves the whole seed, and the
      ### witness below, to the re-run.
      _xoct_acct_gmap "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      _xoct_acct_umap "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      ### Post-install seeding: merge the portable cnf values, force the
      ### authoritative control-file pins, carry the client credentials.
      ### What the target holds BEFORE the seed rewrites it: the cnf (its
      ### lines sorted -- the merge below removes a key's line and appends
      ### it, so a byte identity would read a reorder as a change) and every
      ### control witness the seed lands (md5 over the set), a run-upgrade.pid
      ### an earlier create armed that the runner has not consumed yet, and
      ### what the last pass actually configured (its octopus_log line). They
      ### decide below whether the enforced upgrade still has work to do.
      ### Taken before the cnf merge: taken after it, a changed cnf value
      ### could never arm the pass that applies it.
      _TGT_SEED_WAS=$(_xoct_seed_witness "${_TGT_HM_USER}" "${_tgt}")
      _TGT_ARMED_WAS=$(ssh root@${_tgt} "[ -e /data/disk/${_TGT_HM_USER}/static/control/run-upgrade.pid ] && echo YES" 2>/dev/null)
      _TGT_LAST_PASS=$(_xoct_remote_in "${_tgt}" "/data/disk/${_TGT_HM_USER}/log" \
        '_rr octopus_log.txt | tail -1' 2>/dev/null)
      _TGT_FPM_RUN=$(printf '%s' "${_TGT_LAST_PASS}" | grep -oE 'FPM [0-9.]+' | awk '{print $2}')
      _TGT_CLI_RUN=$(printf '%s' "${_TGT_LAST_PASS}" | grep -oE 'CLI [0-9.]+' | awk '{print $2}')
      ### Post-install seeding: merge the portable cnf values, force the
      ### authoritative control-file pins, carry the client credentials.
      _xoct_push_target_octopus_cnf "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      ### After the merge, which carries the source's switch: under admail=
      ### a target that keeps the notice on refuses the create, before the
      ### transfer can bring the setup mail it would send. The record put
      ### there with it keeps it off through every later merge and import.
      if [ -n "${_XOCT_ADMAIL}" ]; then
        if [ "${_XOCT_XMASS_RUN}" = "YES" ]; then
          _xoct_admail_upgrade_mail_off "${_TGT_HM_USER}" "${_tgt}" || exit 1
        else
          _xoct_admail_upgrade_mail_off "${_TGT_HM_USER}" "${_tgt}" record || exit 1
        fi
      fi
      ### Every move, test or real: the account's first pass there that would
      ### mail its upgrade notice sends none (_xoct_upgrade_skip_file), unless
      ### the account's switch here is NO, which the merge carries there.
      if [ "$(_xoct_upgrade_switch "/root/.${_oct}.octopus.cnf")" = "NO" ]; then
        echo "INFO: ${_oct}'s upgrade notice is off here (_SEND_UPGRADE_EMAIL=NO): no one-pass marker is put on ${_tgt}"
      else
        _xoct_upgrade_skip_put "${_TGT_HM_USER}" "${_tgt}" create
      fi
      _XOCT_GMAP="${_XOCT_AMAP}"
      _xoct_seed_target_control_pins "${_USR}" "/data/disk/${_TGT_HM_USER}" "${_TGT_HM_USER}" "${_tgt}"
      _xoct_sync_shell_credentials "${_oct}" "${_TGT_HM_USER}" "${_tgt}"
      _XOCT_GMAP=""
      _XOCT_UMAP=""
      ### Verify the pins actually took (catches the availability-fallback
      ### downgrade class at the cheapest possible moment).
      for _pinVar in _PHP_FPM_VERSION _PHP_CLI_VERSION; do
        _SRC_PIN=$(grep "^${_pinVar}=" /root/.${_oct}.octopus.cnf 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '"')
        [ -n "${_SRC_PIN}" ] || continue
        _TGT_PIN=$(ssh root@${_tgt} "grep '^${_pinVar}=' /root/.${_TGT_HM_USER}.octopus.cnf 2>/dev/null" 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '"')
        if [ "${_SRC_PIN}" != "${_TGT_PIN}" ]; then
          echo "ALRT: ${_pinVar} differs after seeding: source=${_SRC_PIN} target=${_TGT_PIN}"
        fi
      done
      ### The enforced upgrade exists to make the target's next octopus pass
      ### apply what the seed just wrote. Arm it only when a pass still has
      ### work to do: the seed changed the cnf or any control witness on the
      ### target (the cnf merge carries ~35 values a pass consumes, not only
      ### the PHP pins), an earlier create's pid is still armed and must not
      ### be dropped by the cleanup below, the last pass recorded a different
      ### FPM or CLI than the seeded pin (read from the .info witnesses that
      ### travelled, the cnf only as fallback), or no pass has recorded
      ### anything yet. The previous guard keyed on log/upgrademail.txt, which
      ### the silent install never writes, so every repeated create re-armed a
      ### full pass on a converged account and the target never went quiet
      ### between prep-target runs.
      ### one version, dotted or two-digit, as the target's pass records it
      _SRC_FPM_PIN="$(_mig_php_norm "$(_xoct_read_in "${_USR}/static/control" fpm.info | tr -d ' \t\r\n')")"
      [ -n "${_SRC_FPM_PIN}" ] || _SRC_FPM_PIN=$(grep "^_PHP_FPM_VERSION=" /root/.${_oct}.octopus.cnf 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '"')
      _SRC_CLI_PIN="$(_mig_php_norm "$(_xoct_read_in "${_USR}/static/control" cli.info | tr -d ' \t\r\n')")"
      [ -n "${_SRC_CLI_PIN}" ] || _SRC_CLI_PIN=$(grep "^_PHP_CLI_VERSION=" /root/.${_oct}.octopus.cnf 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '"')
      _TGT_SEED_NOW=$(_xoct_seed_witness "${_TGT_HM_USER}" "${_tgt}")
      _ARM_UPGRADE=NO
      _ARM_WHY=""
      if [ "${_TGT_ARMED_WAS}" = "YES" ]; then
        _ARM_UPGRADE=YES; _ARM_WHY="an earlier create's upgrade is still armed"
      elif [ "${_TGT_SEED_WAS}" != "${_TGT_SEED_NOW}" ]; then
        ### Name the witness: a converged account that re-arms on every
        ### repeated create is a loop nobody can break from "the cnf or a
        ### control witness" alone (a rig re-armed one pinned account that
        ### way and the log could not say which file kept moving).
        _ARM_UPGRADE=YES; _ARM_WHY="the seed changed: $(_xoct_seed_witness_delta "${_TGT_SEED_WAS}" "${_TGT_SEED_NOW}")"
      elif [ -z "${_TGT_FPM_RUN}" ] || [ -z "${_TGT_CLI_RUN}" ]; then
        _ARM_UPGRADE=YES; _ARM_WHY="no pass has recorded FPM/CLI yet"
      elif [ -n "${_SRC_FPM_PIN}" ] && [ "${_SRC_FPM_PIN}" != "${_TGT_FPM_RUN}" ]; then
        _ARM_UPGRADE=YES; _ARM_WHY="last pass ran FPM ${_TGT_FPM_RUN}, pin is ${_SRC_FPM_PIN}"
      elif [ -n "${_SRC_CLI_PIN}" ] && [ "${_SRC_CLI_PIN}" != "${_TGT_CLI_RUN}" ]; then
        _ARM_UPGRADE=YES; _ARM_WHY="last pass ran CLI ${_TGT_CLI_RUN}, pin is ${_SRC_CLI_PIN}"
      fi
      ### Stale-pid cleanup FIRST, then the enforced-upgrade trigger: the
      ### historical order deleted the run-upgrade.pid it had just created.
      ### The account's 503 gate is no stale pid: a fresh install has none,
      ### and an account that has one (a returning old active fenced after a
      ### promotion by hand, an import that failed and put its gate back) is
      ### held on purpose -- the import's own tail and the cutover's
      ### promotion lift it, never a create.
      _xoct_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" 'for _p in ./*.pid; do [ "${_p}" = ./http-off.pid ] || rm -f -- "${_p}"; done'
      if [ "${_ARM_UPGRADE}" = "YES" ]; then
        ### Both put fresh, owned by the main login from the start as the
        ### queue's own writer leaves them (the group asked of the target
        ### itself), so the account can still edit its platform list in
        ### place and no name is chowned after the rename.
        _xoct_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" \
          "_g=\$(id -gn ${_TGT_HM_USER} 2> /dev/null); [ \"\${_g}\" = ${_TGT_HM_USER} ] || _g=users; _rp platforms.info \"\$(_rr platforms.info; echo UP)\" ${_TGT_HM_USER}.ftp:\${_g}; _rp run-upgrade.pid '' ${_TGT_HM_USER}.ftp:\${_g}"
        echo "INFO: enforced upgrade armed on ${_tgt} for ${_TGT_HM_USER}: ${_ARM_WHY}"
        ### A demoted box (the failback target, or any ex-active whose
        ### dispatcher was parked under /var/backups/off-run) has nothing to
        ### consume the trigger, and octopus itself refuses a proxied account
        ### ("skipping: proxied (served elsewhere)"), so the seeded PHP set
        ### cannot be applied there before the promotion -- whose cleanup
        ### also defuses every armed pid as stale. Mark this one as the
        ### migration's own: the promotion keeps it and the cutover re-arms
        ### it at its end, so the restored dispatcher applies the seed on its
        ### first quiet tick on the box that serves again.
        if ssh root@${_tgt} "[ ! -e /var/xdrago/run-${_TGT_HM_USER} ] && [ -e /var/backups/off-run/run-${_TGT_HM_USER} ]" 2>/dev/null; then
          _xoct_remote_ctrl "${_tgt}" "${_TGT_HM_USER}" '_rp run-upgrade.xmass'
          echo "INFO: ${_TGT_HM_USER}'s dispatcher is parked on ${_tgt} (a demoted box refuses octopus passes); the seeded upgrade is deferred to the promotion -- the cutover re-arms it once the box serves again"
        fi
      else
        echo "INFO: ${_TGT_HM_USER} on ${_tgt} already runs FPM ${_TGT_FPM_RUN} / CLI ${_TGT_CLI_RUN} and the seed changed nothing; no upgrade armed"
      fi
      echo "INFO: new octopus ${_TGT_HM_USER} setup on ${_tgt} complete"
    else
      echo "ALRT: new octopus ${_TGT_HM_USER} setup on ${_tgt} failed because of missing arguments"
      exit 1
    fi
  fi
  ### An import whose sites were loaded before the rename schedules their
  ### verifies here; any other import loads and verifies here, as before.
  if [ "${_cmd}" = "import" ] && [ "${_XOCT_SITES_STAGE}" = "load" ]; then
    _XOCT_SITES_STAGE=verify
    ### The rename's own queue can still hold the instance's task runner
    ### when the verifies start; a forced verify waits for it up to this
    ### long, where the panel's hosting knows the option (30 s by default,
    ### then the task is left for the next dispatch, after post-mig).
    _XOCT_HOST_INC="${_THIS_HM_SITE%/sites/*}/profiles/hostmaster/modules/aegir/hosting"
    if _xoct_read_in "${_XOCT_HOST_INC}" hosting.drush.inc | grep -q "'runner-wait' => array"; then
      _XOCT_RUNNER_UNTIL=$(( $(date +%s) + 600 ))
    fi
  fi
  if [ "${_cmd}" = "import" ] \
    || [ "${_cmd}" = "export" ] \
    || [ "${_cmd}" = "proxy" ]; then
    _migrate_sites
  fi
  if [ "${_cmd}" = "export" ]; then
    if [ "${_XOCT_EXPORT_FAIL:-0}" != "0" ]; then
      ### Parsed never sourced. Travels with the log/ transfer sync, so the
      ### import side refuses on it even when the operator skips the source
      ### side gate. log/ is oN's: the markers are put and removed inside the
      ### real directory, never through a link put at the name.
      {
        echo "failed=${_XOCT_EXPORT_FAIL}"
        echo "dbs=${_XOCT_EXPORT_FAILED_DBS# }"
        echo "time=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
      } | _xoct_in_real_dir "${_USR}/log" _xoct_write_here export_failed.pid 022
      echo "ALRT: export for ${_oct}: ${_XOCT_EXPORT_FAIL} site database export(s) FAILED:${_XOCT_EXPORT_FAILED_DBS}"
      echo "ERROR: NOT stamping exported.pid; transfer and import will refuse this account"
      echo "ERROR: fix the cause, then re-run 'xoct export ${_oct} ${_tgt}${_dst:+ ${_dst}}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}'"
      echo "ERROR: (site dumps are redone in place; the hostmaster dump is kept)"
      _XOCT_RUN_FAIL=YES
    elif [ -s "${_USR}/src/prev_hostmaster.sql" ]; then
      _xoct_in_real_dir "${_USR}/log" rm -f -- ./export_failed.pid
      _xoct_in_real_dir "${_USR}/log" _xoct_touch_here exported.pid
      echo "INFO: export for ${_oct}: every site database dump completed; exported.pid stamped"
    fi
  fi
  if [ "${_cmd}" = "import" ]; then
    ###
    ### The export-time 503 gate travels inside static/control with the
    ### account transfer, and nothing on the target removed it, so imported
    ### accounts stayed on 503 indefinitely (the pid content is a cache TTL
    ### for the 503 response, not a self-expiry). The account imported onto
    ### THIS box is ready to serve now; the source keeps its own copy until
    ### the proxy step replaces it there.
    ###
    _xoct_in_real_dir "${_USR}/static/control" rm -f -- ./http-off.pid
    if [ -d "/var/lib/nginx/speed" ]; then
      find /var/lib/nginx/speed -type f -delete &> /dev/null
    fi
    ### Every site loaded before the rename must have been met after it,
    ### under its name there: one the rename left unreachable (its alias or
    ### vhost not moved) got no verify, and the import is not complete.
    for _SIDN in ${_XOCT_LOADED_DIRS}; do
      case " ${_XOCT_MET_DIRS} " in
        *" ${_SIDN} "*) continue ;;
      esac
      _Dom=$(printf '%s\n' ${_XOCT_LOADED_NAMES} | grep -m1 "^${_SIDN}=" | cut -d= -f2-)
      _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + 1 ))
      _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} ${_Dom:-${_SIDN}}:not-found-after-rename"
      echo "ALRT: site ${_Dom:-${_SIDN}} on ${_oct}: loaded before the rename but not found after it; no verify"
    done
    ### and every site whose site_path the load stage could not enter must
    ### have been judged after it
    if [ "${_XOCT_DEFERRED_N}" -gt "${_XOCT_DEFER_MET}" ]; then
      _XOCT_IMPORT_FAIL=$(( ${_XOCT_IMPORT_FAIL:-0} + _XOCT_DEFERRED_N - _XOCT_DEFER_MET ))
      _XOCT_IMPORT_FAILED_DBS="${_XOCT_IMPORT_FAILED_DBS} deferred-not-found-after-rename"
      echo "ALRT: $(( _XOCT_DEFERRED_N - _XOCT_DEFER_MET )) site(s) whose site_path could not be entered before the rename were not found after it"
    fi
    # Harsh cache flush so any migrated D8+ site drops the source box's stale
    # container and bootstraps clean on this box.
    _xoct_flush_caches_target
    # Carried FPM markers would leave every pinned site on the default pool.
    _xoct_heal_fpm_pins "${_THIS_HM_USER}"
    if [ "${_XOCT_IMPORT_FAIL:-0}" != "0" ]; then
      {
        echo "failed=${_XOCT_IMPORT_FAIL}"
        echo "dbs=${_XOCT_IMPORT_FAILED_DBS# }"
        echo "time=$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
      } | _xoct_in_real_dir "${_USR}/log" _xoct_write_here import_failed.pid 022
      echo "ALRT: import for ${_oct}: ${_XOCT_IMPORT_FAIL} site database import(s) FAILED or SKIPPED:${_XOCT_IMPORT_FAILED_DBS}"
      echo "ERROR: their verifies were NOT scheduled; sites with clean loads were imported normally"
      echo "ERROR: recovery -- fix the cause (re-export/re-transfer the failed dumps if hollow), then:"
      echo "ERROR:   rm ${_USR}/log/imported.pid"
      echo "ERROR:   xoct import ${_oct} ${_tgt:-<target-ip>}${_dst:+ ${_dst}}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
      echo "ERROR: (safe: the full import re-run re-imports from the same transferred dumps)"
      _XOCT_RUN_FAIL=YES
    else
      _xoct_in_real_dir "${_USR}/log" rm -f -- ./import_failed.pid
    fi
  fi
  _xoct_sql_maint_release
  echo Done ${_cmd} for ${_USR}
  _xoct_chattr_back
}

# --- storage-aware store relocation (attached /mnt vs root, source vs target) ------
#
# A store directory (static/files, arch, or a legacy /mnt-anchored symlink) is
# transferred to the target honouring BOTH sides' disk reality:
#   source on a mount (symlink -> /mnt/...) + target HAS a mount -> MIRROR onto the
#       target mount and re-point the link there (even if root has room)
#   source on a mount + target has NO mount                      -> DE-REFERENCE to a
#       real dir on the target root
#   source a real dir on root                                    -> keep a real dir on
#       root; use the target mount only as a fallback if root cannot fit it
# DENY (non-zero) only when: a source symlink is dangling (attached disk not mounted),
# the target has MULTIPLE /mnt mounts, or the store fits nowhere.

# Print the target's single attached mountpoint under /mnt, "MULTI" if more than one,
# or nothing if none. Same detection migratefs + the lshell FTP-jail use.
# Prints "MULTI" (more than one), the single mountpoint path, or "NONE" (zero mounts).
# Empty output therefore means ONLY that the ssh query itself failed -> caller aborts,
# so a transient ssh hiccup never silently downgrades a mirror to a root de-reference.
_xoct_detect_target_mnt() {
  ssh root@"$1" 'p=$(stat -c "%d" /mnt 2>/dev/null); n=0; h=""; for m in /mnt/*; do [ -d "$m" ] || continue; if mountpoint -q "$m" 2>/dev/null || { [ -n "$p" ] && [ "$(stat -c "%d" "$m" 2>/dev/null)" != "$p" ]; }; then h="$m"; n=$((n+1)); fi; done; if [ "$n" -gt 1 ]; then echo MULTI; elif [ "$n" -eq 1 ]; then printf "%s" "$h"; else echo NONE; fi'
}

# Resolve the target's attached mount into _TGT_MNT ("" = none), aborting the run on a
# failed query, an empty target host, or more than one mount. $1 = target host.
_xoct_resolve_target_mnt() {
  local _raw
  if [ -z "$1" ]; then
    echo "ERROR: empty target host — refusing"
    exit 1
  fi
  _raw="$(_xoct_detect_target_mnt "$1")"
  case "${_raw}" in
    MULTI)
      echo "ERROR: target $1 has multiple /mnt mounts; BOA supports a single attached mount — refusing"
      exit 1
      ;;
    NONE) _TGT_MNT="" ;;
    "")
      echo "ERROR: could not query /mnt on target $1 (ssh failed?) — refusing"
      exit 1
      ;;
    *) _TGT_MNT="${_raw}" ;;
  esac
}

# 0 if the target filesystem that would host <dest> (nearest existing ancestor) has
# room for <needKB>. Unknown size or unknown avail -> assume ok (do not block).
# --- DRY/live gate (autosymlink --batch model, keyed per account+target) -----------
# Default is a read-only DRY run that records CLEAN/NOT_CLEAN; --live proceeds only if
# the last run for THIS account+target was a CLEAN DRY, then invalidates it so one dry
# can never arm two lives.
_xoct_state_file() {
  local _key
  _key="$(printf '%s_%s' "$1" "$2" | tr -c 'A-Za-z0-9._-' '_')"
  printf '/var/log/boa/xoct.migrate.%s.state' "${_key}"
}
_xoct_write_state() {   # 1 oct 2 tgt 3 status 4 mode
  local _sf; _sf="$(_xoct_state_file "$1" "$2")"
  mkdir -p /var/log/boa 2>/dev/null
  { echo "_LAST_MODE=$4"; echo "_LAST_STATUS=$3"; echo "_LAST_TS=$(date '+%Y-%m-%d %H:%M:%S')"; } > "${_sf}"
}
_xoct_require_clean_dry() {   # 1 oct 2 tgt -- exit unless last run was a CLEAN DRY
  local _sf _m _s; _sf="$(_xoct_state_file "$1" "$2")"
  if [ ! -f "${_sf}" ]; then
    echo "ERROR: --live requires a prior CLEAN dry run for ${1} -> ${2}; run without --live first"
    exit 1
  fi
  _m=$(grep '^_LAST_MODE=' "${_sf}" | head -n1 | cut -d= -f2-)
  _s=$(grep '^_LAST_STATUS=' "${_sf}" | head -n1 | cut -d= -f2-)
  if [ "${_m}" != "DRY" ] || [ "${_s}" != "CLEAN" ]; then
    echo "ERROR: --live needs the last run for ${1} -> ${2} to be a CLEAN dry run (got mode=${_m:-none} status=${_s:-none}); re-run the dry run and clear any DENY first"
    exit 1
  fi
  _xoct_write_state "$1" "$2" "LIVE" "LIVE"   # consume the clean-dry token
}
_xoct_finalize_dry() {   # 1 oct 2 tgt
  if [ "${_XOCT_NOT_CLEAN}" = "NO" ]; then
    echo "[DRY] CLEAN: no blocking issues. Re-run the same command with --live to perform the migration."
    _xoct_write_state "$1" "$2" "CLEAN" "DRY"
  else
    echo "[DRY] NOT CLEAN: see DENY line(s) above. --live is refused until resolved."
    _xoct_write_state "$1" "$2" "NOT_CLEAN" "DRY"
  fi
}
# Mode-aware rsync: performs the transfer in LIVE, only reports it in DRY.
_xoct_rsync() {
  if [ "${_MODE}" = "LIVE" ]; then
    # Trailing (after "$@") is deliberate: callers pass -a/-aEAX which implies
    # -D; rsync honours the LAST matching option, so these must follow -a to
    # actually drop device/fifo/socket nodes. Never transfer specials.
    # _XOCT_GMAP maps the account's own group and its web group (see
    # _xoct_acct_gmap, _xoct_webgroup_gate); _XOCT_UMAP its identities on a
    # rename (see _xoct_acct_umap).
    rsync "$@" ${_XOCT_GMAP:+"--groupmap=${_XOCT_GMAP}"} ${_XOCT_UMAP:+"--usermap=${_XOCT_UMAP}"} --no-devices --no-specials
  else
    echo "[DRY-PLAN] would rsync: $*"
  fi
}

# Solr indices can be large; fold them into the disk-space gate. Checks that <src>
# fits at its target destination dir (which follows the target's /var/solrN symlink
# onto a mount, or lands on root). Returns 0 if it fits (or src absent), 1 + DENY +
# NOT_CLEAN otherwise. Placement is unchanged (data-only rsync) — this only gates.
_xoct_solr_check() {   # 1 src  2 target-dest-dir  3 label
  local _sz
  [ -e "$1" ] || return 0
  # -L: a symlink operand (e.g. a backups dir relocated into the store)
  # measures 0 with plain du, which waves the fit gate through unmeasured.
  _sz="$(du -skL "$1" 2>/dev/null | awk '{print $1}')"
  _xoct_target_fits "${_tgt}" "$2" "${_sz}" && return 0
  echo "DENY: $3: ${_sz:-?}K does not fit at target $2 — free space and retry"
  _XOCT_NOT_CLEAN=YES
  return 1
}

_xoct_target_fits() {
  local _av _q
  _q="$(_shq "$2")"
  _av=$(ssh root@"$1" "p='${_q}'; while [ -n \"\$p\" ] && [ \"\$p\" != / ] && [ ! -d \"\$p\" ]; do p=\$(dirname \"\$p\"); done; df -Pk \"\$p\" 2>/dev/null | awk 'NR==2{print \$4}'" 2>/dev/null)
  if [ -z "$3" ] || [ -z "${_av}" ]; then return 0; fi
  [ "${_av}" -ge "$3" ]
}

# Single-quote-escape a value for safe embedding in a remote 'single-quoted' ssh arg
# (covers a legacy path that might contain a quote).
_shq() { printf "%s" "$1" | sed "s/'/'\\\\''/g"; }

# De-reference: real dir at <dstRoot> on the target root; rsync the contents in.
# Returns non-zero if the copy fails (caller denies). The copy leaves from
# inside the resolved source directory ($2, canonical). With an account ($5)
# the target directory is made inside a real parent in that account's own
# tree or store, and the receiver starts only in the directory it reported.
_xoct_put_on_root() {
  local _th="$1" _real="$2" _dstRoot="$3" _ie="$4" _acct="$5" _q _dreal
  if [ -n "${_acct}" ]; then
    _dreal="$(_xoct_tgt_place "${_th}" _xoct_own_dir_ready dir "${_acct}" "${_dstRoot}")"
    if [ -z "${_dreal}" ]; then
      echo "DENY: ${_dstRoot} on the target does not resolve into ${_acct}'s own tree or store -- nothing copied"
      return 3
    fi
    # the store is files/ and private/: the web group map rides it too
    if ! _xoct_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
      ${_XOCT_GMAP:+"--groupmap=${_XOCT_GMAP}"} ${_XOCT_UMAP:+"--usermap=${_XOCT_UMAP}"} \
      --rsync-path="$(_xoct_canon_rpath "${_dreal}")" -e ssh ./ root@"${_th}":./; then
      echo "DENY: rsync to ${_dstRoot} on target root failed"
      return 3
    fi
    return 0
  fi
  _q="$(_shq "${_dstRoot}")"
  ssh root@"${_th}" "if [ -L '${_q}' ]; then rm -f '${_q}'; elif [ -e '${_q}' ] && [ ! -d '${_q}' ]; then rm -f '${_q}'; fi; mkdir -p '${_q}'"
  if ! _xoct_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
    ${_XOCT_GMAP:+"--groupmap=${_XOCT_GMAP}"} ${_XOCT_UMAP:+"--usermap=${_XOCT_UMAP}"} -e ssh ./ root@"${_th}":"${_dstRoot}/"; then
    echo "DENY: rsync to ${_dstRoot} on target root failed"
    return 3
  fi
}

# Mirror: rsync contents to <mntDest> on the target mount, then make <dstRoot> a symlink
# to it. The store ends up on the mount AND stays on the source, so a stale prior copy
# at <dstRoot> (e.g. an earlier de-reference to root now being moved onto a freshly
# attached disk) is safe to replace once the mount copy is confirmed. Returns non-zero
# on any failure (caller denies); the remote replace is fenced to /data/disk.
# The copy leaves from inside the resolved source directory ($2, canonical).
# With an account ($7) the mount copy lands only in a directory no link on
# the way leads to, and the link is placed inside the real parent of
# <dstRoot>, which must lie in that account's own tree or store.
_xoct_put_on_mount() {
  local _th="$1" _real="$2" _mntDest="$3" _dstRoot="$4" _ie="$5" _lbl="$6" _acct="$7"
  local _qm _qd _mreal
  _qm="$(_shq "${_mntDest}")"; _qd="$(_shq "${_dstRoot}")"
  if [ -n "${_acct}" ]; then
    _mreal="$(_xoct_tgt_place "${_th}" _xoct_real_mnt_dir "${_mntDest}")"
    if [ -z "${_mreal}" ]; then
      echo "DENY: ${_lbl}: ${_mntDest} on the target is not a real directory under its mount -- nothing copied"
      return 3
    fi
    if ! _xoct_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
      ${_XOCT_GMAP:+"--groupmap=${_XOCT_GMAP}"} ${_XOCT_UMAP:+"--usermap=${_XOCT_UMAP}"} \
      --rsync-path="$(_xoct_canon_rpath "${_mreal}")" -e ssh ./ root@"${_th}":./; then
      echo "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed; target link left untouched"
      return 3
    fi
    if [ -z "$(_xoct_tgt_place "${_th}" _xoct_own_link_ready "${_acct}" "${_dstRoot}" "${_mntDest}")" ]; then
      echo "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target (its parent is not ${_acct}'s own there)"
      return 3
    fi
    return 0
  fi
  ssh root@"${_th}" "mkdir -p '${_qm}'"
  if ! _xoct_in_canon_dir "${_real}" rsync -aEAXqu --no-devices --no-specials ${_ie} \
    ${_XOCT_GMAP:+"--groupmap=${_XOCT_GMAP}"} ${_XOCT_UMAP:+"--usermap=${_XOCT_UMAP}"} -e ssh ./ root@"${_th}":"${_mntDest}/"; then
    echo "DENY: ${_lbl}: rsync to target mount ${_mntDest} failed; target link left untouched"
    return 3
  fi
  if ! ssh root@"${_th}" "d='${_qd}'; case \"\$d\" in /data/disk/*) : ;; *) echo 'refuse: dstRoot outside /data/disk'; exit 9 ;; esac; if [ -L \"\$d\" ]; then rm -f \"\$d\"; elif [ -d \"\$d\" ]; then rm -rf \"\$d\"; elif [ -e \"\$d\" ]; then rm -f \"\$d\"; fi; mkdir -p \"\$(dirname \"\$d\")\"; ln -sfn '${_qm}' \"\$d\""; then
    echo "DENY: ${_lbl}: could not place symlink ${_dstRoot} -> ${_mntDest} on target"
    return 3
  fi
}

# Storage-aware transfer of one store. Args:
#   1 source path  2 dest path on target root  3 mount-relative dest ("" => derive)
#   4 target host  5 target mount ("path"|""|"MULTI")  6 ieni  7 label
#   8 the account whose store this is ("" for a box tree such as arch)
#   9 what the account's store may resolve to: tree (its own tree or its
#     store under <mount>/files/<oN>/, the default) or uid (also anything
#     its identities own)
# The source is resolved once and copied from inside that real directory;
# an account's store that resolves anywhere else is refused, never followed.
_xoct_handle_store() {
  local _src="$1" _dstRoot="$2" _mntRel="$3" _th="$4" _tm="$5" _ie="$6" _lbl="$7"
  local _acct="$8" _rule="${9:-tree}" _dacct=""
  local _real _link _sz _onMnt=NO _mntDest="" _act="" _reason="" _rc=0

  if [ ! -e "${_src}" ] && [ ! -L "${_src}" ]; then
    return 0
  fi
  if [ -n "${_acct}" ]; then
    _dacct="${_dstRoot#/data/disk/}"
    _dacct="${_dacct%%/*}"
  fi

  # --- classify + resolve the source ---
  if [ "${_tm}" = "MULTI" ]; then
    _act=DENY; _reason="target has multiple /mnt mounts; cannot choose one"
  elif [ -n "${_acct}" ] && { [ "${_dstRoot}" = "/data/disk/${_dacct}" ] \
    || [ "${_dstRoot#/data/disk/}" = "${_dstRoot}" ]; }; then
    _act=DENY; _reason="${_dstRoot} is not a path inside an account on the target"
  elif [ -L "${_src}" ]; then
    _link="$(readlink "${_src}" 2>/dev/null)"
    _real="$(readlink -f "${_src}" 2>/dev/null)"
    if [ -z "${_real}" ] || [ ! -d "${_real}" ]; then
      _act=DENY; _reason="${_src} is a dangling symlink (attached disk not mounted?)"
    elif [ -n "${_acct}" ] && ! _xoct_store_is_own "${_acct}" "${_real}" "${_rule}"; then
      _act=DENY; _reason="${_src} resolves to ${_real}, outside ${_acct}'s own tree and store -- not followed"
    else
      case "${_link}" in /mnt/*) _onMnt=YES ;; esac
    fi
  elif [ -d "${_src}" ]; then
    _real="$(cd -P -- "${_src}" 2>/dev/null && pwd -P)"
    if [ -z "${_real}" ]; then
      _act=DENY; _reason="${_src} cannot be entered"
    elif [ -n "${_acct}" ] && ! _xoct_store_is_own "${_acct}" "${_real}" "${_rule}"; then
      _act=DENY; _reason="${_src} resolves to ${_real}, outside ${_acct}'s own tree and store -- not followed"
    fi
  else
    return 0
  fi

  # --- decide (mirror / root / deny), source-shape preferred, space-checked ---
  if [ -z "${_act}" ]; then
    _sz="$(du -sk "${_real}" 2>/dev/null | awk '{print $1}')"
    if [ -z "${_mntRel}" ] && [ "${_onMnt}" = "YES" ]; then
      _mntRel="${_real#/mnt/*/}"
      # On a rename the account's own part of the store takes the new name.
      # A path under another name's part (an old-named path left by an
      # earlier rename) lands under files/<oN>/legacy/<name>/ in the
      # account's own part, never in a store an account of that name may
      # hold on the target.
      if [ -n "${_acct}" ] && [ -n "${_dacct}" ]; then
        case "${_mntRel}/" in
          "files/${_acct}/"*) _mntRel="files/${_dacct}${_mntRel#"files/${_acct}"}" ;;
          "files/${_dacct}/"*) ;;
          files/?*/*) _mntRel="files/${_dacct}/legacy/${_mntRel#files/}" ;;
        esac
      fi
    fi
    [ -n "${_tm}" ] && [ -n "${_mntRel}" ] && _mntDest="${_tm}/${_mntRel}"
    if [ "${_onMnt}" = "YES" ] && [ -n "${_mntDest}" ]; then
      if _xoct_target_fits "${_th}" "${_mntDest}" "${_sz}"; then _act=MIRROR
      elif _xoct_target_fits "${_th}" "${_dstRoot}" "${_sz}"; then _act=ROOT
      else _act=DENY; _reason="does not fit on target mount (${_mntDest}) nor root (${_dstRoot})"; fi
    else
      if _xoct_target_fits "${_th}" "${_dstRoot}" "${_sz}"; then _act=ROOT
      elif [ -n "${_mntDest}" ]; then _act=MIRROR
      else _act=DENY; _reason="does not fit on target root (${_dstRoot}) and no usable target mount"; fi
    fi
  fi

  # --- execute per mode: DRY reports the plan + flags NOT CLEAN on any deny; LIVE acts ---
  case "${_act}" in
    DENY)
      echo "DENY: ${_lbl}: ${_reason} — free space / fix and retry"
      _XOCT_NOT_CLEAN=YES
      [ "${_MODE}" = "LIVE" ] && return 3
      return 0
      ;;
    MIRROR)
      if [ "${_MODE}" = "LIVE" ]; then
        _xoct_put_on_mount "${_th}" "${_real}" "${_mntDest}" "${_dstRoot}" "${_ie}" "${_lbl}" "${_dacct}" \
          || { _rc=$?; _XOCT_NOT_CLEAN=YES; return "${_rc}"; }
        echo "INFO: ${_lbl}: mirrored to target mount ${_mntDest}, symlinked ${_dstRoot}"
      else
        echo "[DRY-PLAN] ${_lbl}: would mirror onto target mount ${_mntDest} and symlink ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
    ROOT)
      if [ "${_MODE}" = "LIVE" ]; then
        _xoct_put_on_root "${_th}" "${_real}" "${_dstRoot}" "${_ie}" "${_dacct}" \
          || { _rc=$?; _XOCT_NOT_CLEAN=YES; return "${_rc}"; }
        echo "INFO: ${_lbl}: real dir on target root ${_dstRoot}"
      else
        echo "[DRY-PLAN] ${_lbl}: would place real dir on target root ${_dstRoot} (source ${_sz:-?}K)"
      fi
      ;;
  esac
  return 0
}

# Catch-all: any symlink (besides static/files, handled explicitly) whose OWN target
# is /mnt/... gets the same storage-aware treatment, so non-standard legacy links are
# never left dangling on the target. Sets _XOCT_STORE_RC on any DENY. On a rename a
# link into the account's own part of the store (<mount>/files/<oN>/...) lands under
# the new name there; one into another name's part lands under
# <mount>/files/<oN>/legacy/<name>/. A link is carried only when it resolves into
# the account's own tree or store, or to content one of its identities owns (an
# old-named path left by an earlier rename); anything else is a DENY.
_xoct_catchall_mnt_symlinks() {
  local _root="$1" _dstRoot="$2" _th="$3" _tm="$4" _ie="$5"
  local _l _lt _rel _dl
  while IFS= read -r _l; do
    [ -n "${_l}" ] || continue
    [ "${_l}" = "${_root}/static/files" ] && continue
    _lt="$(readlink "${_l}" 2>/dev/null)"
    case "${_lt}" in /mnt/*) : ;; *) continue ;; esac
    _rel="${_l#"${_root}"/}"
    _dl="${_dstRoot}/${_rel}"
    _xoct_handle_store "${_l}" "${_dl}" "" "${_th}" "${_tm}" "${_ie}" "legacy symlink ${_rel}" \
      "${_root##*/}" uid || _XOCT_STORE_RC=$?
  done <<EOF
$(find "${_root}" -type l 2>/dev/null)
EOF
}

_xoct_transfer_static_symlink_safe() {
  _X_SRC_USR="$1"
  _X_TGT_HOST="$2"
  _X_DST_USR="$3"
  _X_IENI="$4"
  _X_TGT_MNT="$5"

  _X_SRC_STATIC="${_X_SRC_USR}/static"
  _X_DST_STATIC="${_X_DST_USR}/static"
  _X_DST_STATIC_FILES="${_X_DST_USR}/static/files"
  _X_DST_ACCT="$(basename "${_X_DST_USR}")"

  if [ ! -d "${_X_SRC_STATIC}" ]; then
    return 0
  fi

  echo "INFO: Static sync pass 1/2 (preserve symlinks, exclude static/files)"
  mkdir -p "${_X_SRC_USR}/static"
  ### static/ is the account's on both boxes: the copy runs from inside the
  ### real directory with a relative source, and the receiving rsync starts
  ### inside the real static/ on the target, so neither end resolves static/
  ### through a link put in its place. A static/ that is not a real
  ### directory here is never followed, and the transfer is not complete.
  if ! _xoct_in_real_dir "${_X_SRC_STATIC}" true; then
    echo "DENY: ${_X_SRC_STATIC} is not a real directory -- not followed; static/ not copied"
    _XOCT_NOT_CLEAN=YES
    [ "${_MODE}" = "LIVE" ] && _XOCT_STORE_RC=1
    return 1
  fi
  _xoct_in_real_dir "${_X_SRC_STATIC}" _xoct_copy_here "${_X_TGT_HOST}" \
    "${_X_DST_STATIC}" '' -aEAXqu ${_X_IENI} --exclude=/files

  # The static sync uses -u (skip-newer), but `xoct create` on the target just
  # wrote FRESH default control files (newer mtime) that shadow the migrated
  # ones -> every migrated site loses its PHP-version pins and silently falls
  # back to the target's install-time default. The per-site multi-fpm.info
  # lines key on the site domain (unchanged by migration/rename), and the
  # account-level fpm.info/cli.info are the AUTHORITATIVE witnesses BOA
  # derives the octopus.cnf and the pools from (_satellite_cnf and
  # manage_ltd_users both read .info -> rewrite cnf, never the reverse), so
  # all three are directly valid on the target: force them over WITHOUT -u.
  # The create step already gated on the pinned versions being installed on
  # the target, so the forced pins cannot strand a site without a pool.
  # Only regular files, from the real control directory into the real
  # control directory on the target: a pin that is a link, or a control on
  # either box that is one, is never carried or written through.
  local _pin
  for _pin in multi-fpm.info fpm.info cli.info; do
    _xoct_in_real_dir "${_X_SRC_USR}/static/control" _xoct_put_file_remote_here \
      "${_pin}" "${_X_TGT_HOST}" "${_X_DST_STATIC}/control" "${_X_IENI}"
  done

  echo "INFO: Static sync pass 2/2 (materialize/mirror static/files per target disk reality)"
  # Canonical mount layout uses the DEST account name, so a rename lands correctly.
  _xoct_handle_store \
    "${_X_SRC_USR}/static/files" \
    "${_X_DST_STATIC_FILES}" \
    "files/${_X_DST_ACCT}/static/files" \
    "${_X_TGT_HOST}" "${_X_TGT_MNT}" "${_X_IENI}" \
    "static/files (${_X_DST_ACCT})" "${_X_SRC_USR##*/}" || _XOCT_STORE_RC=$?
}

###-------------MIGRATION PROXY VERBS----###

### Octopus account dirs under /data/disk, system dirs excluded (same
### EXCLUSION list as the xmass enumerator, deliberately without its
### eligibility filter: this feeds the policy table, and a broken account's
### policy state is exactly what the operator needs to see).
_mig_list_accounts() {
  local _d
  for _d in $(find /data/disk -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort); do
    _d="$(basename "${_d}")"
    case "${_d}" in
      arch|all|lost+found|lostfound|backups|codebases-cleanup|legacy|xusage) continue ;;
    esac
    echo "${_d}"
  done
}

### The requirement-6 answer: one table says what each account's customer will
### be told and what they were last told. Read-only -- no sweep, no fallback.
_mig_render_table() {
  local _a _root _cnf _m _d _s _p _lt _flag _lastline
  printf '%-10s %-11s %-12s %-8s %-24s %s\n' \
    account mode deadline scope peer "last told"
  for _a in "$@"; do
    _root="/data/disk/${_a}"; _cnf="${_root}/${_MIG_CNF_NAME}"
    _m="-"; _d="-"; _s="default"; _p="-"; _flag=""
    if [ -r "${_cnf}" ]; then
      if _mig_is_mine "${_cnf}"; then
        _m="$(_mig_get "${_cnf}" _MIG_MODE)"
        _mig_valid_mode "${_m}" || _m="-"
        _d="$(_mig_get "${_cnf}" _MIG_DEADLINE)"
        [ "${_m}" = "retired" ] && _d="$(_mig_get "${_cnf}" _MIG_RETIRE_DATE)"
        ### "none" is an explicit --no-deadline, which no box default fills;
        ### "-" is unset and takes the box default's date, if there is one.
        _mig_valid_date "${_d}" || [ "${_d}" = "none" ] || _d="-"
        _s="$(_mig_get "${_cnf}" _MIG_SCOPE)"
        [ "${_s}" = "account" ] || _s=box
        _p="$(_mig_get "${_cnf}" _MIG_PEER_IP)/$(_mig_get "${_cnf}" _MIG_PEER_OCT)"
        [ "${_p}" = "/" ] && _p="-"
      else
        _flag=" [foreign record ignored]"
      fi
    fi
    _lt="(never)"
    _lastline="$(_xoct_read_in "${_root}/${_MIG_LOG_NAME%/*}" "${_MIG_LOG_NAME##*/}" \
      | grep '|mail|' | tail -1)"
    [ -n "${_lastline}" ] \
      && _lt="$(printf '%s' "${_lastline}" | awk -F'|' '{ print $5 "/" $6 " on " substr($1,1,10) }')"
    if [ -e "${_root}/log/proxied.pid" ] && [ "${_m}" = "-" ]; then
      _flag=" [ALRT: undeclared]"
    fi
    printf '%-10s %-11s %-12s %-8s %-24s %s%s\n' \
      "${_a}" "${_m}" "${_d}" "${_s}" "${_p}" "${_lt}" "${_flag}"
  done
  if [ -s "${_MIG_BOX_MODE_FILE}" ]; then
    echo "box default: $(head -n1 "${_MIG_BOX_MODE_FILE}" 2>/dev/null)$( [ -s "${_MIG_BOX_DEADLINE_FILE}" ] && printf ' (deadline %s)' "$(head -n1 "${_MIG_BOX_DEADLINE_FILE}" 2>/dev/null)" )"
  fi
  [ -e "${_MIG_LEGACY_ORPHAN}" ] \
    && echo "ALRT: legacy xmass permanent-proxy flag present; the next set or proxy run converts it to a box default"
  return 0
}

### Soonest certificate expiry across the account's proxy-served certs. The
### proxy serves THIS box's certificates and proxied accounts stop renewing
### (owl.sh and the fleet LE sweep both skip them). With the certificate
### mirror present that date is only informational -- the mirror pulls each
### renewed pair back from the target daily; without the mirror it is a real
### service horizon, so its absence is the loud case.
_xoct_warn_proxy_cert_horizon() {
  local _root="$1" _c _r _end _soon="" _soon_dom=""
  for _c in "${_root}"/config/server_master/ssl.d/*/openssl.crt; do
    [ -e "${_c}" ] || continue
    # ssl.d is the account's: the certificate is reached through the links
    # the Let's Encrypt layout makes, resolved once, accepted only inside
    # the account's own tree or store, and read inside that real directory,
    # never into a FIFO.
    _r="$(readlink -f -- "${_c}" 2>/dev/null)"
    [ -n "${_r}" ] && _xoct_own_path "${_root##*/}" "${_r%/*}" || continue
    _end=$(_xoct_in_canon_dir "${_r%/*}" _xoct_read_here "${_r##*/}" \
      | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    [ -n "${_end}" ] || continue
    _end=$(date -u -d "${_end}" '+%Y-%m-%d' 2>/dev/null)
    [ -n "${_end}" ] || continue
    if [ -z "${_soon}" ] || [[ "${_end}" < "${_soon}" ]]; then
      _soon="${_end}"; _soon_dom="$(basename "$(dirname "${_c}")")"
    fi
  done
  [ -n "${_soon}" ] || return 0
  if [ -x "/var/xdrago/migration_proxy_certs.sh" ] \
    && grep -q "migration_proxy_certs" /var/spool/cron/crontabs/root 2>/dev/null; then
    echo "INFO: proxied certificates refresh daily from the target (migration_proxy_certs.sh);"
    echo "INFO: soonest local expiry ${_soon} (${_soon_dom}) -- the mirror renews it before that date"
  elif [ -x "/var/xdrago/migration_proxy_certs.sh" ]; then
    echo "ALRT: migration_proxy_certs.sh is present but NOT SCHEDULED (no root crontab line);"
    echo "ALRT: soonest certificate expiry ${_soon} (${_soon_dom}) -- add the daily 06:45 line"
    echo "ALRT: (a barracuda up-* run or the BOA fetch pass restores it) or the mirror never runs"
  else
    echo "ALRT: soonest certificate expiry ${_soon} (${_soon_dom}) and the certificate mirror"
    echo "ALRT: /var/xdrago/migration_proxy_certs.sh is MISSING on this box -- a long-lived proxy"
    echo "ALRT: will serve expired certificates after that date. The mirror ships with the"
    echo "ALRT: current release: run 'barracuda up-<tree> system noscreen' here, or copy the"
    echo "ALRT: script from the target (it arrives there the same way)"
  fi
}

### Write the peer's half of the policy record over ssh. The peer's own
### reconcile decides teardown from records whose _MIG_HOST_IP it owns, so the
### pushed record carries the PEER's address as its identity, this box as the
### peer field(s), and the local account name for tracing.
### set -e on the remote side: without it the exit status is the trailing
### loop's and a truncated write (full disk) would pass the fail-closed gate.
### log/ is the account's on the peer too: the record is read and put inside
### the real directory, read without following a link or opening a FIFO and
### put as a fresh file, created root:root 0600 through the handle that
### wrote it (_XOCT_PUT_PL) and renamed over the name; nothing is chowned
### by name there.
### rc 7 = the peer owns a SOURCE-role record for that account (it has since
### become a source itself, chained migration); callers decide whether that is
### fatal (fresh conversion: yes) or an alert (late policy edits: no).
### Args: 1 peer-ip 2 peer-acct 3 role 4 mode 5 scope 6 deadline in record
### form (a date, "none" or empty) 7 src-acct
_xoct_push_peer_record() {
  local _pip="$1" _pacct="$2" _prole="$3" _pmode="$4" _pscope="$5" _pdl="$6" _psrc="$7" _prdl="$8"
  local _my _myall
  if ! _mig_valid_acct "${_pacct}" || ! _mig_valid_acct "${_psrc}"; then
    echo "ALRT: refusing peer record push: invalid account name '${_pacct}'/'${_psrc}'"
    return 1
  fi
  _my="$(_mig_my_ip)"
  _myall="$(_mig_my_ips)"
  _xoct_learn_peer_host_key "${_pip}"
  _XOCT_PUSH_ERR=""
  local _perr="/var/backups/.xoct.pusherr.$$"
  ssh root@"${_pip}" "bash -s" 2>"${_perr}" <<PEERREC
set -e
mkdir -p "/data/disk/${_pacct}/log" 2>/dev/null || true
_w="\$(cd -P /data/disk && pwd -P)/${_pacct}/log"
cd -P -- "/data/disk/${_pacct}/log"
[ "\$(pwd -P)" = "\${_w}" ]
_old="\$(timeout 10 dd if=./migproxy.cnf iflag=nofollow,nonblock,fullblock bs=1048576 count=1 status=none 2>/dev/null || true)"
if printf '%s\\n' "\${_old}" | grep -qx "_MIG_ROLE=source" \\
  && hostname -I 2>/dev/null | tr ' ' '\\n' \\
     | grep -qxF "\$(printf '%s\\n' "\${_old}" | grep -m1 '^_MIG_HOST_IP=' | cut -d= -f2-)"; then
  # This box authored its own SOURCE record for the account (it migrated on
  # somewhere else); an inbound push must not destroy its outbound policy.
  exit 7
fi
_t="./.migproxy.cnf.put.\$\$.\${RANDOM}"
rm -f -- "\${_t}"
perl -e '${_XOCT_PUT_PL}' "\${_t}" 0 0 600 <<'RECEOF' || { rm -f -- "\${_t}"; exit 1; }
# BOA migration proxy policy. Managed by xoct/xmass. Do not edit by hand.
_MIG_ROLE=${_prole}
_MIG_HOST_IP=${_pip}
_MIG_PEER_IP=${_my}
_MIG_PEER_OCT=${_psrc}
_MIG_MODE=${_pmode}
_MIG_SCOPE=${_pscope}
_MIG_DEADLINE=${_pdl}
${_prdl:+_MIG_RETIRE_DATE=${_prdl}}
_MIG_PEER_IPS=${_myall}
_MIG_STAMPED=$(date -u '+%Y-%m-%d')
RECEOF
mv -f -T -- "\${_t}" ./migproxy.cnf
# The addresses this box relays from, kept where only root writes: the
# promoted box carries a peer's reach only for addresses root recorded.
for _a in ${_my} ${_myall}; do
  grep -qxF -- "\${_a}" /root/.migration.peer.addrs 2>/dev/null \
    || ( umask 077; printf '%s\\n' "\${_a}" >> /root/.migration.peer.addrs ) \
    || true
done
PEERREC
  local _prc=$?
  ### The remote stderr is what names the cause a refusal must show (a host
  ### key, a refused connection, a full disk); keep its first line.
  _XOCT_PUSH_ERR="$(grep -vE '^(@|Warning:|WARNING)' "${_perr}" 2>/dev/null | grep -m1 . | tr -d '\r')"
  [ -s "${_perr}" ] && [ "${_prc}" != "0" ] && [ "${_prc}" != "7" ] && cat "${_perr}" >&2
  rm -f "${_perr}"
  return "${_prc}"
}

### Run reconcile on a peer so its trust set follows the record just pushed.
### A missing tool on the peer is tolerated (older BOA); a reconcile that runs
### and fails must propagate, or the callers' failure branches can never fire.
_xoct_peer_reconcile() {
  ssh root@"$1" \
    "if [ -x '${_MIG_TRUST_TOOL}' ]; then '${_MIG_TRUST_TOOL}' reconcile; else echo 'reconcile tool absent on peer (older BOA); trust left as found'; fi" \
    2>/dev/null
}

### What THIS box can arrange for itself before the first ssh to a peer it has
### never met: the retarget after a promotion is exactly that case -- the
### promoted mirror is a box this proxy holds no host key for, and the push
### died as 'Host key verification failed' with nothing naming the cause.
### Mirrors _xmass_prepare_target_reach in xmass (master and satellite copies
### stay in step, not DRY-ed). The trust the PEER must grant is not fixable
### from here; the refusal names it instead.
_xoct_learn_peer_host_key() {
  local _p="$1"
  _mig_valid_ip "${_p}" || return 0
  ssh-keygen -F "${_p}" > /dev/null 2>&1 && return 0
  mkdir -p /root/.ssh
  chmod 700 /root/.ssh
  ssh-keyscan -H -T 10 "${_p}" >> /root/.ssh/known_hosts 2>/dev/null
  if ssh-keygen -F "${_p}" > /dev/null 2>&1; then
    echo "INFO: learned the host key for peer ${_p}"
  else
    echo "ALRT: could not learn the host key for ${_p} -- unreachable on 22?"
  fi
  return 0
}

### The peer did not take the record. The branch below is fail-closed for
### more than one cause (a truncated write on a full disk trips it too), so
### enumerate rather than assert: after a promotion the USUAL cause is that
### the box does not let this proxy in yet -- the cutover carries the
### demoted box's inbound proxies' reach forward, an older one did not.
### Never tell the operator to pre-wire the SERVING trust: xoct wires that
### itself once the push lands, and a hand-wired entry is one no record
### accounts for.
_xoct_peer_trust_remedy() {
  local _p="$1" _me
  _me="$(_mig_my_ips)"
  echo "ERROR: peer ${_p} did not accept the record${_XOCT_PUSH_ERR:+ (ssh said: ${_XOCT_PUSH_ERR})}."
  echo "ERROR: After a promotion the usual cause is that ${_p} does not let this proxy in yet"
  echo "ERROR: (a cutover older than the reach carry). Three checks ON ${_p}, then re-run here:"
  echo "ERROR:   1. this box's /root/.ssh/id_ed25519.pub is in its /root/.ssh/authorized_keys"
  echo "ERROR:   2. csf -a <each of: ${_me}>   # this box's addresses, for the control-plane ssh"
  echo "ERROR:   3. free disk under /data/disk there -- the record write is fail-closed on a truncated file"
}

### Wire the migration-proxy trust on the TARGET (never on this source box:
### the proxy only makes outbound connections to the target, and a source-side
### whitelist would just orphan when the source is later repurposed). Mirrors
### _xmass_setup_migration_proxy_trust in xmass -- master and satellite copies
### stay in step, not DRY-ed. --permanent covers ha-switch too: for trust and
### teardown ha-switch behaves exactly as permanent; it differs only in the
### client notification.
_xoct_wire_target_proxy_trust() {
  local _realip="/var/xdrago/migration_proxy_realip.sh"
  local _src_ips _perm=""
  _src_ips="$(_mig_my_ips)"
  [ "${_MIG_MODE}" != "temporary" ] && _perm="--permanent"
  [ -x "/var/xdrago/cloudflare_realip.sh" ] \
    && /var/xdrago/cloudflare_realip.sh >/dev/null 2>&1
  if [ -x "${_MIG_TRUST_TOOL}" ] && [ -x "${_realip}" ]; then
    scp -q "${_MIG_TRUST_TOOL}" "${_realip}" root@"${_tgt}":/var/xdrago/ 2>/dev/null \
      && ssh root@"${_tgt}" "chmod 0755 '${_MIG_TRUST_TOOL}' '${_realip}'" 2>/dev/null
  fi
  if ssh root@"${_tgt}" "[ -x '${_MIG_TRUST_TOOL}' ]" 2>/dev/null; then
    echo "INFO: trusting migration proxy ${_src_ips// /, } on target ${_tgt} (realip + csf)"
    ssh root@"${_tgt}" "${_MIG_TRUST_TOOL} trust ${_src_ips} ${_perm}" \
      || echo "ALRT: migration_proxy_trust setup returned non-zero on target ${_tgt}"
  else
    echo "ALRT: skipping target trust: ${_MIG_TRUST_TOOL} missing on target ${_tgt} -- realip/csf NOT wired;"
    echo "ALRT: real-client bans and per-site ip_access will not work through the proxy"
  fi
}

### Resolve and freeze this account's proxy policy BEFORE any vhost is
### touched: write the local source record, push the matching target record to
### the peer, and wire the TARGET-side trust so the very first relayed request
### is attributed to the real client. Fail closed on an unreachable peer: a
### peer that cannot take the record now is a peer whose reconcile would later
### decide teardown from a stale or absent one.
_xoct_proxy_preflight() {
  local _cnf _old_peer _rec_dl
  _cnf="${_USR}/${_MIG_CNF_NAME}"
  _XOCT_PROXY_OK=0
  _XOCT_PROXY_FAIL=0
  _XOCT_PROXY_ELIGIBLE=0
  _XOCT_PROXY_DEFERRED=""
  _XOCT_FIRST_BACKUP_DOMS=""
  _XOCT_WAS_PROXIED=NO
  [ -e "${_USR}/log/proxied.pid" ] && _XOCT_WAS_PROXIED=YES
  _XOCT_PEER_ACCT="${_dst:-${_oct}}"
  if ! _mig_valid_acct "${_XOCT_PEER_ACCT}" || ! _mig_valid_acct "${_oct}"; then
    echo "ERROR: invalid account name '${_oct}'/'${_XOCT_PEER_ACCT}'"
    exit 1
  fi
  if ! _mig_valid_ip "${_tgt}"; then
    echo "ERROR: proxy requires a target IPv4 address (got '${_tgt}')"
    exit 1
  fi
  if [ "${_XOCT_PROXY_RETARGET}" = "YES" ] && [ "${_XOCT_PROXY_REPAIR}" != "YES" ]; then
    echo "ERROR: --retarget is only valid together with --repair"
    exit 1
  fi

  ### A typo in an IP must not silently repoint a live account's traffic.
  ### Role-gated: only a SOURCE-role record is this box's own outbound proxy
  ### record. An inbound target-role record (this box was migrated ONTO
  ### earlier) must never trip the retarget refusal, or a chained B-to-C
  ### migration aborts every account at cutover with the sites already 503.
  _XOCT_OLD_PEER=""
  _XOCT_OLD_PEER_OCT=""
  if [ -r "${_cnf}" ] && _mig_is_mine "${_cnf}"; then
    if [ "$(_mig_get "${_cnf}" _MIG_ROLE)" = "source" ]; then
      _old_peer="$(_mig_get "${_cnf}" _MIG_PEER_IP)"
      if _mig_valid_ip "${_old_peer}" && [ "${_old_peer}" != "${_tgt}" ]; then
        if [ "${_XOCT_PROXY_RETARGET}" != "YES" ]; then
          echo "ERROR: this account's proxy record points at ${_old_peer}, not ${_tgt}"
          echo "ERROR: a changed target IP must be explicit; if the repoint is intended, re-run:"
          echo "ERROR:   xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}} --repair --retarget${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
          exit 1
        fi
        _XOCT_OLD_PEER="${_old_peer}"
        _XOCT_OLD_PEER_OCT="$(_mig_get "${_cnf}" _MIG_PEER_OCT)"
      fi
    else
      echo "ALRT: ${_oct}: superseding an inbound target-role record (this box was itself"
      echo "ALRT: migrated onto earlier -- chained migration). The single-record model"
      echo "ALRT: cannot express both roles: if the upstream proxy chain must keep working,"
      echo "ALRT: keep its trust by hand: ${_MIG_TRUST_TOOL} trust $(_mig_get "${_cnf}" _MIG_PEER_IP) --permanent"
    fi
  fi

  ### After the refusals above, before anything is written.
  _xoct_keep_renamed_redirects

  _mig_resolve "${_USR}"
  if [ "${_MIG_MODE}" = "retired" ]; then
    echo "ERROR: ${_oct}: proxy policy is retired; declare a mode first:"
    echo "ERROR:   xoct proxy-mode ${_oct} <temporary|permanent|ha-switch>${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
    exit 1
  fi
  ### Scope records HOW the mode was chosen: an explicit flag on this
  ### invocation is a per-account instruction; everything else stays a
  ### box-derived value a later sweep may overwrite.
  _XOCT_SCOPE=box
  [ "${_MIG_SOURCE}" = "account" ] && _XOCT_SCOPE=account
  if [ -n "${_XOCT_MODE_FLAG}" ]; then
    if ! _mig_valid_mode "${_XOCT_MODE_FLAG}" || [ "${_XOCT_MODE_FLAG}" = "retired" ]; then
      echo "ERROR: invalid --proxy-mode '${_XOCT_MODE_FLAG}' (temporary|permanent|ha-switch)"
      exit 1
    fi
    _MIG_MODE="${_XOCT_MODE_FLAG}"
    _MIG_SOURCE=flag
    _XOCT_SCOPE=account
  fi
  ### Neither deadline flag keeps what the resolver found, an explicit none
  ### included; a date replaces a none, --no-deadline records one.
  if [ "${_XOCT_NO_DEADLINE}" = "YES" ]; then
    _MIG_DEADLINE=""
    _MIG_DEADLINE_NONE=YES
  elif [ -n "${_XOCT_DEADLINE_FLAG}" ]; then
    if ! _MIG_DEADLINE="$(_mig_norm_deadline "${_XOCT_DEADLINE_FLAG}")"; then
      echo "ERROR: invalid --deadline '${_XOCT_DEADLINE_FLAG}' (YYYY-MM-DD or +Nd, today or later)"
      exit 1
    fi
    _MIG_DEADLINE_NONE=""
  fi
  if [ "${_MIG_MODE}" = "ha-switch" ] && [ -n "${_MIG_DEADLINE}" ]; then
    echo "ALRT: ha-switch ignores the resolved deadline ${_MIG_DEADLINE}"
    _MIG_DEADLINE=""
  fi
  if [ "${_MIG_MODE}" != "temporary" ]; then
    _xoct_warn_proxy_cert_horizon "${_USR}"
  fi
  if [ "${_MIG_MODE}" = "ha-switch" ]; then
    echo "ALRT: ha-switch: the client mail asserts a live mirror with automatic failover;"
    echo "ALRT: this tool cannot verify one exists -- confirm the pair is real first"
  fi

  echo "INFO: ${_oct}: proxy mode ${_MIG_MODE}${_MIG_DEADLINE:+ (deadline ${_MIG_DEADLINE})}${_MIG_DEADLINE_NONE:+ (no deadline)} [source: ${_MIG_SOURCE}]"

  ### Both records carry the none, or the peer's copy (and this one) would
  ### read as unset and be refilled on the next resolution.
  _rec_dl="${_MIG_DEADLINE}"
  [ -z "${_rec_dl}" ] && [ "${_MIG_DEADLINE_NONE}" = "YES" ] && _rec_dl=none
  _xoct_push_peer_record "${_tgt}" "${_XOCT_PEER_ACCT}" target \
    "${_MIG_MODE}" "${_XOCT_SCOPE}" "${_rec_dl}" "${_oct}"
  case "$?" in
    0) : ;;
    7)
      echo "ERROR: peer ${_tgt} owns a SOURCE-role record for ${_XOCT_PEER_ACCT}: it has since"
      echo "ERROR: migrated that account onward itself -- proxying to it would relay into a"
      echo "ERROR: box that no longer serves the account; refusing"
      exit 1
    ;;
    *)
      echo "ERROR: could not write the policy record on peer ${_tgt} -- refusing to proxy"
      _xoct_peer_trust_remedy "${_tgt}"
      exit 1
    ;;
  esac
  _mig_write_record "${_USR}" source "${_tgt}" "${_XOCT_PEER_ACCT}" \
    "${_MIG_MODE}" "${_XOCT_SCOPE}" "${_rec_dl}" || exit 1
  _mig_log "${_USR}" xoct set "${_XOCT_SCOPE}" "${_MIG_MODE}" "${_MIG_DEADLINE}" "${_tgt}"
  _xoct_wire_target_proxy_trust
}

### Uniform notification rule, shared by every policy verb: mail the change
### body whenever the promise differs from the last one actually mailed;
### --renotify forces, --no-notify suppresses and logs the suppression. A
### client never mailed anything gets nothing here -- the completion notice at
### proxy time is the first promise -- and an account not yet CONVERTED gets
### nothing either: before proxied.pid exists no forwarding arrangement is in
### force, so a "the arrangement has changed" follow-up would be false (the
### start notice alone having been sent is not a forwarding promise).
### $5 = the record's role: on a target-role record the old/new addresses
### swap, because the customer's NEW system is THIS box and the old address
### is the peer.
_xoct_policy_notify() {
  local _a="$1" _mode="$2" _dl="$3" _peer="$4" _role="$5"
  local _root="/data/disk/${_a}" _last _new_ip _old_ip _kind=change
  ### On the source only the notices of this box's moves count (a log carried
  ### from the move that brought the account here holds that move's); the
  ### target reads its log as it is.
  if [ "${_role}" = "target" ]; then
    _last="$(_mig_last_mail "${_root}")"
  else
    _last="$(_mig_last_mail "${_root}" "${_peer}")"
  fi
  if [ "${_XOCT_NO_NOTIFY}" = "YES" ]; then
    if [ -n "${_last}" ] && [ "${_last}" != "${_mode}|${_dl:--}" ]; then
      _mig_log "${_root}" xoct skip change-suppressed "${_mode}" "${_dl}" "${_peer}"
      echo "ALRT: ${_a}: promise changed but the notice was suppressed by --no-notify (logged);"
      echo "ALRT: the client's last mailed arrangement is now stale"
    fi
    return 0
  fi
  if [ ! -e "${_root}/log/proxied.pid" ] && [ "${_XOCT_RENOTIFY}" != "YES" ]; then
    echo "INFO: ${_a}: not yet converted; the completion notice at proxy time carries this promise"
    return 0
  fi
  if [ "${_XOCT_RENOTIFY}" != "YES" ]; then
    if [ -z "${_last}" ]; then
      echo "INFO: ${_a}: client never mailed yet; nothing to correct"
      return 0
    fi
    if [ "${_last}" = "${_mode}|${_dl:--}" ]; then
      echo "INFO: ${_a}: client already told exactly this; not re-sending"
      return 0
    fi
  fi
  if [ -z "${_peer}" ]; then
    echo "ALRT: ${_a}: no peer recorded; cannot compose the change notice (it names the new address)"
    return 0
  fi
  ### A notice sent here as the target names the box the account came from:
  ### logged change-inbound, which the source-side readers never count, so it
  ### is no notice of a later move of the account back to that box.
  if [ "${_role}" = "target" ]; then
    _new_ip="$(_mig_my_ip)"; _old_ip="${_peer}"
    _kind=change-inbound
  else
    _new_ip="${_peer}"; _old_ip="$(_mig_my_ip)"
  fi
  _mig_load_account_mail_facts "${_root}" "${_a}"
  _MIG_MODE="${_mode}"; _MIG_DEADLINE="${_dl}"; _MIG_SOURCE=account
  _mig_build_mail_blocks change "${_new_ip}" "${_old_ip}" || return 0
  _send_notice_migration_change
  if [ "${_MAIL_SENT}" = "YES" ]; then
    _mig_log "${_root}" xoct "${_XOCT_MAIL_ACT}" "${_kind}" "${_mode}" "${_dl}" "${_peer}"
  else
    echo "ALRT: ${_a}: change notice NOT sent; re-run with --renotify when mail works"
  fi
}

### Apply one account's policy change: freeze the new (mode, deadline) into
### the local record, propagate it to the peer record FIRST (the peer's
### reconcile decides teardown from ITS copy, so a change that stays local
### flips that decision the wrong way under a live proxy), then notify when
### the promise changed.
_xoct_apply_policy() {
  local _a="$1" _mode="$2" _scope="$3"
  local _root="/data/disk/${_a}" _cnf _role=source _peer="" _peer_oct="" _dl="" _oldscope="" _oldmode="" _peer_ips=""
  local _dl_none="" _rec_dl
  ### An account in a test run changes nothing without its admail=: the
  ### change notice below would reach the client.
  _xoct_admail_gate "${_a}" || return 1
  _cnf="${_root}/${_MIG_CNF_NAME}"
  if [ -r "${_cnf}" ] && _mig_is_mine "${_cnf}"; then
    _role="$(_mig_get "${_cnf}" _MIG_ROLE)"
    [ "${_role}" = "target" ] || _role=source
    _peer="$(_mig_get "${_cnf}" _MIG_PEER_IP)"
    _mig_valid_ip "${_peer}" || _peer=""
    _peer_oct="$(_mig_get "${_cnf}" _MIG_PEER_OCT)"
    _oldscope="$(_mig_get "${_cnf}" _MIG_SCOPE)"
    _oldmode="$(_mig_get "${_cnf}" _MIG_MODE)"
    _dl="$(_mig_get "${_cnf}" _MIG_DEADLINE)"
    [ "${_dl}" = "none" ] && _dl_none=YES
    _mig_valid_date "${_dl}" || _dl=""
    _peer_ips="$(_mig_get "${_cnf}" _MIG_PEER_IPS)"
  fi
  ### A box-wide sweep never overwrites a per-account pin (requirement 5).
  if [ "${_scope}" = "box" ] && [ "${_oldscope}" = "account" ] \
    && [ "${_XOCT_FORCE_PINNED}" != "YES" ]; then
    echo "PIN ${_a}: mode pinned per account (${_oldmode}${_dl:+ until ${_dl}}${_dl_none:+, no deadline}) -- box sweep not applied (--force-pinned overrides)"
    return 0
  fi
  ### Deadline: explicit flag wins; --no-deadline records an explicit none;
  ### otherwise keep the record's own (a date, or that none), else the box
  ### default. --force-pinned lets a sweep replace a pinned MODE only: its
  ### deadline follows these same rules.
  if [ "${_XOCT_NO_DEADLINE}" = "YES" ]; then
    _dl=""
    _dl_none=YES
  elif [ -n "${_XOCT_DEADLINE_FLAG}" ]; then
    if ! _dl="$(_mig_norm_deadline "${_XOCT_DEADLINE_FLAG}")"; then
      echo "ERROR: invalid --deadline '${_XOCT_DEADLINE_FLAG}' (YYYY-MM-DD or +Nd, today or later)"
      exit 1
    fi
    _dl_none=""
  elif [ -z "${_dl}" ] && [ "${_dl_none}" != "YES" ] \
    && [ -r "${_MIG_BOX_DEADLINE_FILE}" ]; then
    _dl="$(head -n1 "${_MIG_BOX_DEADLINE_FILE}" 2>/dev/null | tr -d '\r\n')"
    _mig_valid_date "${_dl}" || _dl=""
  fi
  if [ "${_mode}" = "ha-switch" ] && [ -n "${_dl}" ]; then
    echo "ALRT: ${_a}: ha-switch ignores the deadline ${_dl}"
    _dl=""
  fi
  if [ "${_mode}" != "temporary" ] && [ -e "${_root}/log/proxied.pid" ]; then
    _xoct_warn_proxy_cert_horizon "${_root}"
  fi
  if [ "${_mode}" = "ha-switch" ]; then
    echo "ALRT: ${_a}: the client mail asserts a live mirror with automatic failover;"
    echo "ALRT: this tool cannot verify one exists -- confirm the pair is real first"
  fi
  ### Both records store the none; the log, the mail and the re-notify
  ### comparison keep reading an empty deadline as none.
  _rec_dl="${_dl}"
  [ -z "${_rec_dl}" ] && [ "${_dl_none}" = "YES" ] && _rec_dl=none
  ### Peer propagation first, fail closed PER ACCOUNT (a --all sweep must not
  ### abort half-applied on one unreachable peer -- the caller collects the
  ### failures and exits non-zero at the end). Source-authored records only:
  ### on a target the record is this box's own reconcile input, goes nowhere.
  if [ "${_role}" = "source" ] && [ -n "${_peer}" ]; then
    _xoct_push_peer_record "${_peer}" "${_peer_oct:-${_a}}" target \
      "${_mode}" "${_scope}" "${_rec_dl}" "${_a}"
    case "$?" in
      0)
        _xoct_peer_reconcile "${_peer}" \
          || echo "ALRT: ${_a}: reconcile on peer ${_peer} failed; run ${_MIG_TRUST_TOOL} reconcile there"
      ;;
      7)
        ### The peer moved on (its record for this account is its own
        ### source-role one): its teardown decisions no longer key on this
        ### account, so the local change may proceed.
        echo "ALRT: ${_a}: peer ${_peer} has migrated this account onward (chained); its"
        echo "ALRT: record was left untouched -- verify its trust by hand if the chain matters"
      ;;
      *)
        echo "ERROR: ${_a}: peer ${_peer} unreachable -- policy NOT changed (a change that does"
        echo "ERROR: not reach the peer record flips its teardown decision the wrong way)"
        return 1
      ;;
    esac
  fi
  ### A target-role rewrite must carry the _MIG_PEER_IPS list forward: it is
  ### the source's full address set and reconcile trusts from it.
  _mig_write_record "${_root}" "${_role}" "${_peer}" "${_peer_oct:-${_a}}" \
    "${_mode}" "${_scope}" "${_rec_dl}" "${_peer_ips}" || return 1
  ### A set line names a box this box moved the account to, whose notices
  ### count on the source (_xoct_source_peers); on a target-role record the
  ### peer is the box the account came from, so the line is set-inbound.
  if [ "${_role}" = "target" ]; then
    _mig_log "${_root}" xoct set-inbound "${_scope}" "${_mode}" "${_dl}" "${_peer}"
  else
    _mig_log "${_root}" xoct set "${_scope}" "${_mode}" "${_dl}" "${_peer}"
  fi
  echo "INFO: ${_a}: proxy mode set to ${_mode}${_dl:+ (deadline ${_dl})}${_dl_none:+ (no deadline)} [${_scope}]"
  ### On a TARGET record the change affects THIS box's own trust set.
  if [ "${_role}" = "target" ] && [ -x "${_MIG_TRUST_TOOL}" ]; then
    "${_MIG_TRUST_TOOL}" reconcile \
      || echo "ALRT: local reconcile returned non-zero"
  fi
  _xoct_policy_notify "${_a}" "${_mode}" "${_dl}" "${_peer}" "${_role}"
  return 0
}

_xoct_proxy_mode() {
  local _sel="$1" _mode="$2" _accts _a _scope
  if [ -z "${_sel}" ]; then
    echo "Usage: xoct proxy-mode {oN|--all} [temporary|permanent|ha-switch]"
    echo "       [--deadline=YYYY-MM-DD|+Nd|--no-deadline] [--force-pinned] [--renotify|--no-notify]"
    echo "       (no mode = print the per-account policy table, change nothing)"
    exit 1
  fi
  if [ "${_sel}" = "--all" ]; then
    _accts="$(_mig_list_accounts)"
    if [ -z "${_accts}" ]; then
      echo "INFO: no Octopus accounts under /data/disk"
      exit 0
    fi
  else
    if [ ! -d "/data/disk/${_sel}" ]; then
      echo "ERROR: no such account dir /data/disk/${_sel}"
      exit 1
    fi
    _accts="${_sel}"
  fi
  ### A --proxy-mode=/--mode= flag spelling is accepted as the mode too;
  ### silently rendering the table instead of setting would be the worst
  ### possible reading of that invocation.
  [ -z "${_mode}" ] && [ -n "${_XOCT_MODE_FLAG}" ] && _mode="${_XOCT_MODE_FLAG}"
  if [ -z "${_mode}" ]; then
    if [ -n "${_XOCT_DEADLINE_FLAG}${_XOCT_NO_DEADLINE}" ]; then
      echo "ERROR: a deadline change must restate the mode, e.g.:"
      echo "ERROR:   xoct proxy-mode ${_sel} temporary --deadline=+30d${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
      exit 1
    fi
    ### Unquoted on purpose: _accts is a space/newline-separated account list.
    # shellcheck disable=SC2086
    _mig_render_table ${_accts}
    exit 0
  fi
  if ! _mig_valid_mode "${_mode}" || [ "${_mode}" = "retired" ]; then
    if [ "${_mode}" = "retired" ]; then
      echo "ERROR: use: xoct proxy-retire ${_sel}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
    else
      echo "ERROR: invalid mode '${_mode}' (temporary|permanent|ha-switch)"
    fi
    exit 1
  fi
  ### A box that holds its clients' mail for a test run takes no real
  ### policy change: the change notices would be held too; nor does one in
  ### xmass's test run (asked once here, not per account).
  _xoct_hold_gate "" || exit 1
  _xoct_xmass_rec_gate || exit 1
  _mig_sweep_legacy
  ### A single-account set is a per-account operator instruction (a pin); the
  ### --all form is a box-wide statement that never overwrites a pin. Per-
  ### account failures collect rather than aborting a half-applied sweep.
  _scope=account
  [ "${_sel}" = "--all" ] && _scope=box
  local _failed=""
  for _a in ${_accts}; do
    _xoct_apply_policy "${_a}" "${_mode}" "${_scope}" || _failed="${_failed} ${_a}"
  done
  if [ -n "${_failed}" ]; then
    echo "ALRT: policy NOT changed for:${_failed}"
    echo "ALRT: fix the cause above (peer reachability, a test run's admail=) and re-run for those accounts"
    exit 1
  fi
  exit 0
}

_xoct_retire_one() {
  local _a="$1" _wdl="$2"
  local _root="/data/disk/${_a}" _cnf _role _peer _peer_oct _scope _mode _peer_ips
  local _new_ip _old_ip _kind=retire
  ### An account in a test run is not retired without its admail=: the
  ### withdrawal notice would reach the client.
  _xoct_admail_gate "${_a}" || return 1
  _cnf="${_root}/${_MIG_CNF_NAME}"
  if [ ! -r "${_cnf}" ] || ! _mig_is_mine "${_cnf}"; then
    echo "INFO: ${_a}: no local proxy policy record; nothing to retire"
    return 0
  fi
  _mode="$(_mig_get "${_cnf}" _MIG_MODE)"
  if [ "${_mode}" = "retired" ]; then
    echo "INFO: ${_a}: already retired"
    return 0
  fi
  _role="$(_mig_get "${_cnf}" _MIG_ROLE)"
  [ "${_role}" = "target" ] || _role=source
  _peer="$(_mig_get "${_cnf}" _MIG_PEER_IP)"
  _mig_valid_ip "${_peer}" || _peer=""
  _peer_oct="$(_mig_get "${_cnf}" _MIG_PEER_OCT)"
  _scope="$(_mig_get "${_cnf}" _MIG_SCOPE)"
  [ "${_scope}" = "account" ] || _scope=box
  _peer_ips="$(_mig_get "${_cnf}" _MIG_PEER_IPS)"
  if [ "${_role}" = "source" ] && [ -n "${_peer}" ]; then
    _xoct_push_peer_record "${_peer}" "${_peer_oct:-${_a}}" target \
      retired "${_scope}" "" "${_a}" "${_wdl}"
    case "$?" in
      0)
        _xoct_peer_reconcile "${_peer}" \
          || echo "ALRT: ${_a}: reconcile on peer ${_peer} failed; run ${_MIG_TRUST_TOOL} reconcile there"
      ;;
      7)
        echo "ALRT: ${_a}: peer ${_peer} has migrated this account onward (chained); its"
        echo "ALRT: record was left untouched"
      ;;
      *)
        echo "ERROR: ${_a}: peer ${_peer} unreachable -- NOT retiring (the target would keep"
        echo "ERROR: trusting a peer that no longer proxies to it); retry when reachable"
        return 1
      ;;
    esac
  fi
  ### The withdrawal date the customer was promised is part of the record, not
  ### only of the mail: without it the policy table could not show when a
  ### retired proxy is due to go. It travels as its own key.
  _mig_write_record "${_root}" "${_role}" "${_peer}" "${_peer_oct:-${_a}}" \
    retired "${_scope}" "" "${_peer_ips}" "${_wdl}" || return 1
  _mig_log "${_root}" xoct retire "${_scope}" retired "${_wdl}" "${_peer}"
  echo "INFO: ${_a}: proxy policy retired"
  if [ "${_role}" = "target" ] && [ -x "${_MIG_TRUST_TOOL}" ]; then
    "${_MIG_TRUST_TOOL}" reconcile \
      || echo "ALRT: local reconcile returned non-zero"
  fi
  ### The prose promised "we will tell you before that happens", so the
  ### retirement notice mails BY DEFAULT; --no-notify suppresses (logged).
  if [ "${_XOCT_NO_NOTIFY}" = "YES" ]; then
    _mig_log "${_root}" xoct skip retire-suppressed retired "${_wdl}" "${_peer}"
    echo "ALRT: ${_a}: retirement notice suppressed by --no-notify (logged)"
    return 0
  fi
  if [ -z "${_peer}" ]; then
    echo "ALRT: ${_a}: no peer recorded; cannot compose the retirement notice"
    return 0
  fi
  ### On the source, only a client its log shows as really told of a move
  ### from this box (a real notice naming a peer of its moves, this one's or
  ### the one before a retarget; never a test run's) is told of
  ### the withdrawal: after a test run the client was never told. One
  ### converted before the log recorded the notices was told then. The
  ### target's log never holds that notice (the source sends it, and xmass
  ### none at the start), so a retire there, the failover route when the
  ### source is gone, mails the client; a test run there is refused above
  ### (its record, xmass's mark) and by the box's mail hold.
  if [ "${_role}" = "source" ] && [ -z "$(_mig_last_mail "${_root}" "${_peer}")" ] \
    && ! _xoct_proxied_before_log "${_root}"; then
    echo "INFO: ${_a}: this box's migration log holds no notice the client received; no withdrawal notice is sent"
    return 0
  fi
  ### On a target-role record the customer's NEW system is THIS box and the
  ### old address is the peer; the notice is logged retire-inbound (see
  ### _xoct_policy_notify).
  if [ "${_role}" = "target" ]; then
    _new_ip="$(_mig_my_ip)"; _old_ip="${_peer}"
    _kind=retire-inbound
  else
    _new_ip="${_peer}"; _old_ip="$(_mig_my_ip)"
  fi
  _mig_load_account_mail_facts "${_root}" "${_a}"
  _MIG_RETIRE_DATE="${_wdl}"
  _MIG_MODE=retired; _MIG_DEADLINE=""
  _mig_build_mail_blocks retire "${_new_ip}" "${_old_ip}"
  _send_notice_migration_retire
  if [ "${_MAIL_SENT}" = "YES" ]; then
    _mig_log "${_root}" xoct "${_XOCT_MAIL_ACT}" "${_kind}" retired "${_wdl}" "${_peer}"
  else
    echo "ALRT: ${_a}: retirement notice NOT sent (mail unavailable); the client was NOT told"
  fi
  return 0
}

_xoct_proxy_retire() {
  local _sel="$1" _accts _a _wdl=""
  if [ -z "${_sel}" ]; then
    echo "Usage: xoct proxy-retire {oN|--all} [--deadline=YYYY-MM-DD|+Nd] [--no-notify]"
    exit 1
  fi
  if [ "${_sel}" = "--all" ]; then
    _accts="$(_mig_list_accounts)"
    if [ -z "${_accts}" ]; then
      echo "INFO: no Octopus accounts under /data/disk"
      exit 0
    fi
  else
    if [ ! -d "/data/disk/${_sel}" ]; then
      echo "ERROR: no such account dir /data/disk/${_sel}"
      exit 1
    fi
    _accts="${_sel}"
  fi
  if [ -n "${_XOCT_DEADLINE_FLAG}" ]; then
    if ! _wdl="$(_mig_norm_deadline "${_XOCT_DEADLINE_FLAG}")"; then
      echo "ERROR: invalid --deadline '${_XOCT_DEADLINE_FLAG}' (YYYY-MM-DD or +Nd, today or later)"
      exit 1
    fi
  fi
  ### A box that holds its clients' mail for a test run takes no real
  ### retirement: the withdrawal notices would be held too; nor does one in
  ### xmass's test run (asked once here, not per account).
  _xoct_hold_gate "" || exit 1
  _xoct_xmass_rec_gate || exit 1
  local _failed=""
  for _a in ${_accts}; do
    _xoct_retire_one "${_a}" "${_wdl}" || _failed="${_failed} ${_a}"
  done
  echo "INFO: records marked retired; the nginx proxy vhosts are left in place -- withdraw"
  echo "INFO: service by decommissioning this box (or removing the vhosts) once DNS is confirmed moved"
  if [ -n "${_failed}" ]; then
    echo "ALRT: NOT retired:${_failed} -- fix the cause above (peer reachability, a test run's admail=) and re-run"
    exit 1
  fi
  exit 0
}

### go-live {o1} {target-ip} [{o2}], on the source: a canary moved under
### admail= becomes the real move. The test run's records go on both boxes
### (_xoct_admail_rec), and the box-level mail hold (_XOCT_HOLD_FILE) where
### it holds the run's address and no other test run is recorded (an xoct
### record, an xmass mark); the target account's upgrade switch takes the
### source's value again (its one-pass marker goes with a NO); and a proxied
### account whose client was never really told of the completion gets the
### completion notice now (the --repair --renotify path of proxy), also
### while a hold kept for another test run is there. The target goes first:
### a step that cannot reach it leaves the source's record, so the account
### stays held to its test until a re-run finishes. Each step reads before
### it changes anything, so a re-run is a no-op. Without {o2} the target
### account is the one this move's policy record names (source role, this
### target its peer), else {o1} when the target holds a create marker naming
### this box and {o1}; otherwise it refuses before anything changes (a
### renamed canary before proxy: the target's own {o1} is another account,
### and a test-run record of {o1} there can be another box's canary).
### Refused while xmass's record of a test run of the whole box is here,
### unless xmass go-live runs it.
_xoct_go_live() {
  local _dA _rec="" _sw _sh _out _l _left _chk="" _src=""
  if [ -n "${_XOCT_ADMAIL}" ]; then
    echo "ERROR: go-live takes no admail=: it ends the test run and mails the client"
    exit 1
  fi
  if [ -z "${_oct}" ] || [ -z "${_tgt}" ] || ! _mig_valid_acct "${_oct}" \
    || [ ! -d "/data/disk/${_oct}" ] || ! _mig_valid_ip "${_tgt}"; then
    echo "Usage: xoct {go-live} {o1} {target-ip} {o2} (source vms, ends a canary run under admail=)"
    exit 1
  fi
  if [ -n "${_dst}" ] && ! _mig_valid_acct "${_dst}"; then
    echo "ERROR: invalid target account name '${_dst}'"
    exit 1
  fi
  if [ -e "${_XOCT_XMASS_REC}" ] && [ "${_XOCT_XMASS_GOLIVE}" != "YES" ]; then
    echo "ERROR: this box is in an xmass test run (${_XOCT_XMASS_REC}); go-live ends a canary"
    echo "ERROR: moved with xoct. 'xmass go-live <target-ip>' ends the whole-box test run once"
    echo "ERROR: its cutover is done, or while that target stands as this box's mirror; before its"
    echo "ERROR: init, a real move of the box starts again with 'xmass prep-target <target-ip>'"
    echo "ERROR: without admail=, which removes the record"
    exit 1
  fi
  _USR="/data/disk/${_oct}"
  _THIS_HM_USER="${_oct}"
  _dA="${_dst}"
  ### Only this move's record names the account there: a source-role record
  ### whose peer is this target (a target-role one is the record of an
  ### earlier move that brought the account here).
  if [ -z "${_dA}" ] && [ -r "${_USR}/${_MIG_CNF_NAME}" ] \
    && _mig_is_mine "${_USR}/${_MIG_CNF_NAME}" \
    && [ "$(_mig_get "${_USR}/${_MIG_CNF_NAME}" _MIG_ROLE)" != "target" ] \
    && [ "$(_mig_get "${_USR}/${_MIG_CNF_NAME}" _MIG_PEER_IP)" = "${_tgt}" ]; then
    _dA="$(_mig_get "${_USR}/${_MIG_CNF_NAME}" _MIG_PEER_OCT)"
    _mig_valid_acct "${_dA}" || _dA=""
  fi
  if [ -z "${_dA}" ]; then
    _dA="${_oct}"
    _chk=YES
    _src="$(_xoct_create_src_host)" || _src=""
  fi
  [ -z "${_dst}" ] && [ "${_dA}" != "${_oct}" ] && _dst="${_dA}"
  [ -e "$(_xoct_admail_rec "${_oct}")" ] && _rec="$(_xoct_first_line "$(_xoct_admail_rec "${_oct}")")"
  _sw="$(_xoct_upgrade_switch "/root/.${_oct}.octopus.cnf")"
  echo "INFO: go-live for ${_oct} (${_dA} on ${_tgt})${_rec:+: ending the test run under admail=${_rec}}"
  ### The account names and the host name are checked above and the address
  ### is one plain address (it was admail='s), so each goes into the remote
  ### line as is.
  _sh="_a='${_dA}'; _o1='${_oct}'; _sw='${_sw}'; _rec='${_rec}'; _chk='${_chk}'; _src='${_src}'; _r=/data/conf/xoct_admail.\${_a}.txt; _h=${_XOCT_HOLD_FILE}; _c=/root/.\${_a}.octopus.cnf; _k=/data/conf/\${_a}_skip_upgrade_email.txt; _tr=''
if [ -n \"\${_chk}\" ]; then
  _m=/root/.\${_a}.migration-create.txt
  if ! { [ -n \"\${_src}\" ] && [ -f \"\${_m}\" ] && [ ! -L \"\${_m}\" ] && grep -qxF \"_MIG_CREATE_SRC_HOST=\${_src}\" \"\${_m}\" && grep -qxF \"_MIG_CREATE_SRC_OCT=\${_o1}\" \"\${_m}\"; }; then echo NAME-UNKNOWN; exit 0; fi
fi
if [ -e \"\${_r}\" ]; then _tr=\$(head -n 1 \"\${_r}\" | tr -cd '[:print:]' | cut -c1-200); rm -f \"\${_r}\" || { echo REC-STUCK; exit 1; }; echo \"REC-GONE \${_tr}\"; else echo REC-NONE; fi
if [ -e \"\${_h}\" ]; then
  _hv=\$(head -n 1 \"\${_h}\" | tr -cd '[:print:]' | cut -c1-200)
  _more=''; for _o in /data/conf/xoct_admail.*.txt ${_XOCT_XMASS_MARKS}; do [ -e \"\${_o}\" ] || continue; grep -qxF '${_XOCT_ADMAIL_SRC_LINE}' \"\${_o}\" 2> /dev/null && continue; _more=\"\${_more} \${_o##*/}\"; done
  if [ -n \"\${_more}\" ]; then echo \"HOLD-KEPT \${_hv}\${_more}\"
  elif [ -n \"\${_hv}\" ] && { [ \"\${_hv}\" = \"\${_rec}\" ] || [ \"\${_hv}\" = \"\${_tr}\" ]; }; then rm -f \"\${_h}\" || { echo HOLD-STUCK; exit 1; }; echo HOLD-GONE
  else echo \"HOLD-OTHER \${_hv}\"; fi
else echo HOLD-NONE; fi
if [ -f \"\${_c}\" ]; then
  _cur=\$(grep -a '^_SEND_UPGRADE_EMAIL=' \"\${_c}\" | tail -n 1 | cut -d= -f2- | tr -d '\"')
  if [ \"\${_cur}\" = \"\${_sw}\" ]; then echo \"SW-SAME \${_cur}\"
  else { grep -v '^_SEND_UPGRADE_EMAIL=' \"\${_c}\"; echo \"_SEND_UPGRADE_EMAIL=\${_sw}\"; } > \"\${_c}.golive\" && chmod 644 \"\${_c}.golive\" && mv -f \"\${_c}.golive\" \"\${_c}\" || { echo SW-STUCK; exit 1; }; echo \"SW-SET \${_cur:-unset}\"; fi
else echo SW-NOCNF; fi
if [ \"\${_sw}\" = NO ] && [ -e \"\${_k}\" ]; then rm -f \"\${_k}\" || { echo SKIP-STUCK; exit 1; }; echo SKIP-GONE; fi
echo GOLIVE-TARGET-OK"
  _out="$(ssh root@"${_tgt}" "${_sh}" 2> /dev/null)"
  if [ "${_out}" = "NAME-UNKNOWN" ]; then
    echo "ERROR: ${_tgt} holds no create marker naming this box and ${_oct}, and no policy record here"
    echo "ERROR: names the account there: its ${_oct} may be another account (a renamed canary before"
    echo "ERROR: proxy; a test run record of ${_oct} there can be another box's canary). Nothing was"
    echo "ERROR: changed. Name the target account:"
    echo "ERROR:   xoct go-live ${_oct} ${_tgt} <o2>"
    exit 1
  fi
  while IFS= read -r _l; do
    case "${_l}" in
      "REC-GONE "*) echo "INFO: ${_tgt}: removed $(_xoct_admail_rec "${_dA}") (admail=${_l#REC-GONE })" ;;
      REC-NONE) echo "INFO: ${_tgt}: no test run recorded for ${_dA}" ;;
      HOLD-GONE) echo "INFO: ${_tgt}: removed ${_XOCT_HOLD_FILE}: the box mails its clients again" ;;
      "HOLD-KEPT "*)
        _left="${_l#HOLD-KEPT }"
        echo "INFO: ${_tgt}: ${_XOCT_HOLD_FILE} (${_left%% *}) kept: another test run is recorded there (${_left#* }); ${_dA}'s client mail from there stays held until the last one ends"
      ;;
      "HOLD-OTHER "*) echo "ALRT: ${_tgt}: ${_XOCT_HOLD_FILE} holds client mail for ${_l#HOLD-OTHER }, which no test run of ${_dA} recorded; left as it is" ;;
      HOLD-NONE) : ;;
      "SW-SAME "*) echo "INFO: ${_tgt}: ${_dA}'s upgrade switch is already the source's (${_l#SW-SAME })" ;;
      "SW-SET "*) echo "INFO: ${_tgt}: ${_dA}'s upgrade switch set to the source's ${_sw} (was ${_l#SW-SET })" ;;
      SW-NOCNF) echo "ALRT: ${_tgt}: no /root/.${_dA}.octopus.cnf there; its upgrade switch was not set" ;;
      SKIP-GONE) echo "INFO: ${_tgt}: removed $(_xoct_upgrade_skip_file "${_dA}"): with the switch NO no pass would take it" ;;
    esac
  done <<< "${_out}"
  case "${_out}" in
    *GOLIVE-TARGET-OK*) : ;;
    *)
      echo "ERROR: go-live could not finish on ${_tgt} (unreachable, or a file there could not be changed);"
      echo "ERROR: nothing here was changed: re-run 'xoct go-live ${_oct} ${_tgt}${_dst:+ ${_dst}}' once it answers"
      exit 1
    ;;
  esac
  if [ -e "$(_xoct_admail_rec "${_oct}")" ]; then
    if ! rm -f "$(_xoct_admail_rec "${_oct}")"; then
      echo "ERROR: could not remove $(_xoct_admail_rec "${_oct}")"
      exit 1
    fi
    echo "INFO: removed $(_xoct_admail_rec "${_oct}"): every verb for ${_oct} here mails the client again"
  fi
  if [ -e "${_XOCT_HOLD_FILE}" ] && [ -n "${_rec}" ] \
    && [ "$(_xoct_first_line "${_XOCT_HOLD_FILE}")" = "${_rec}" ]; then
    _left="$(_xoct_hold_users_here)"
    if [ -n "${_left}" ]; then
      echo "INFO: ${_XOCT_HOLD_FILE} kept here: another test run is recorded on this box (${_left})"
    elif rm -f "${_XOCT_HOLD_FILE}"; then
      echo "INFO: removed ${_XOCT_HOLD_FILE} here: this box mails its clients again"
    fi
  fi
  if [ ! -e "${_USR}/log/proxied.pid" ]; then
    echo "INFO: ${_oct} is not proxied yet: 'xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}}' converts it and sends the completion notice"
    exit 0
  fi
  if _xoct_told_complete "${_USR}" "${_tgt}"; then
    echo "INFO: ${_oct}: its client was told of the completion; nothing to send"
    exit 0
  fi
  echo "INFO: ${_oct}: its client never had the completion notice: sending it (xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}} --repair --renotify)"
  _cmd=proxy
  _XOCT_PROXY_REPAIR=YES
  _XOCT_RENOTIFY=YES
  _XOCT_NO_NOTIFY=""
  _XOCT_GO_LIVE=YES
  _migrate_init
}

_migrate_init() {
  _RUNTIME_OCT=$(_xoct_runtime_oct)
  _USR=/data/disk/${_RUNTIME_OCT}
  if [ "${_oct}" = "arch" ] \
    || [ "${_oct}" = "all" ] \
    || [ "${_oct}" = "lost+found" ] \
    || [ "${_oct}" = "lostfound" ] \
    || [ "${_oct}" = "backups" ] \
    || [ "${_oct}" = "codebases-cleanup" ]; then
    echo "_USR ${_oct} is not eligible for migration: system dir"
    exit 1
  fi
  if [ ! -e "${_USR}/tools/le/dehydrated" ] && [ "${_oct}" != "shared" ]; then
    echo
    echo "ERROR: This version of xoct migration tool supports only BOA-3.2.2 or newer"
    echo "ERROR: Please upgrade ${_oct} instance to current BOA head before trying again"
    echo "Bye."
    echo
    exit 1
  fi
  if [ -e "/data/conf/${_USR}_use_proxysql.txt" ]; then
    _SQL_CONNECT=127.0.0.1
    _THIS_DB_PORT=6033
  fi
  if [ "${_oct}" = "xusage" ]; then
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} start"
    if [ -e "/var/log/boa/usage" ]; then
      _xoct_rsync -aEAXq ${_ieni} -e ssh /var/log/boa/usage/* root@${_tgt}:/var/log/boa/usage/
      echo "INFO: ${_cmd} for ${_oct} /var/log/boa/usage complete"
    fi
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} complete"
  elif [ "${_oct}" = "shared" ]; then
    echo "INFO: ${_cmd} for ${_oct} to ${_tgt} start"
    # Refuse an empty target: an empty ssh host resolves to localhost, so the arch
    # step's remote mkdir/rm would run against THIS (source) box and could delete the
    # live arch symlink. Never proceed with the shared sync without a real target.
    # Resolve the target's attached mount (aborts on empty/unreachable/multi-mount).
    _xoct_resolve_target_mnt "${_tgt}"
    # --live requires a prior CLEAN dry run for this shared+target.
    [ "${_MODE}" = "LIVE" ] && _xoct_require_clean_dry "${_oct}" "${_tgt}"
    _XOCT_STORE_RC=0
    if [ -d "/data/all" ] && [ ! -L "/data/all" ]; then
      _xoct_rsync -aEAXqu ${_ieni} -e ssh /data/all  root@${_tgt}:/data/
      echo "INFO: ${_cmd} for ${_oct} /data/all complete"
    fi
    if [ -d "/data/disk/all" ]; then
      _xoct_rsync -aEAXqu ${_ieni} -e ssh /data/disk/all  root@${_tgt}:/data/
      echo "INFO: ${_cmd} for ${_oct} /data/disk/all complete"
    fi
    # arch: storage-aware -- mirror onto the target mount, or de-reference to root,
    # per the target's disk reality (canonical layout <mount>/files/system/arch).
    _xoct_handle_store "/data/disk/arch" "/data/disk/arch" "files/system/arch" \
      "${_tgt}" "${_TGT_MNT}" "${_ieni}" "arch" || _XOCT_STORE_RC=$?
    if [ "${_XOCT_STORE_RC:-0}" != "0" ]; then
      echo "ERROR: ${_cmd} for ${_oct}: arch could not be placed on the target (see DENY above); refusing"
      exit 1
    fi
    ### A Solr leg that does not fit is a HARD STOP, as it is in xmass and as
    ### it was in the old tool, which always ran the rsync so a space problem
    ### surfaced loudly on the console. Skipping it and carrying on migrates
    ### the account WITHOUT its search indices and still finishes "clean":
    ### nothing in the LIVE path ever reads _XOCT_NOT_CLEAN.
    if [ -e "/opt/solr4" ]; then
      if ! _xoct_solr_check "/opt/solr4" "/opt" "solr4"; then
        echo "ERROR: solr4 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to migrate ${_oct} without its search indices"
        exit 1
      fi
      _xoct_rsync -aEAXq ${_ieni} -e ssh /opt/solr4 root@${_tgt}:/opt/
      echo "INFO: ${_cmd} for ${_oct} /opt/solr4 complete"
    fi
    if [ -e "/var/solr7/data" ]; then
      if ! _xoct_solr_check "/var/solr7/data" "/var/solr7" "solr7"; then
        echo "ERROR: solr7 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to migrate ${_oct} without its search indices"
        exit 1
      fi
      _xoct_rsync -aEAXq ${_ieni} -e ssh /var/solr7/data root@${_tgt}:/var/solr7/
      echo "INFO: ${_cmd} for ${_oct} /var/solr7/data complete"
    fi
    if [ -e "/var/solr9/data" ]; then
      if ! _xoct_solr_check "/var/solr9/data" "/var/solr9" "solr9"; then
        echo "ERROR: solr9 data does not fit on the target — free space and re-run"
        echo "ERROR: refusing to migrate ${_oct} without its search indices"
        exit 1
      fi
      _xoct_rsync -aEAXq ${_ieni} -e ssh /var/solr9/data root@${_tgt}:/var/solr9/
      echo "INFO: ${_cmd} for ${_oct} /var/solr9/data complete"
    fi
    if [ -e "/var/www/static" ]; then
      _xoct_rsync -aEAXq ${_ieni} -e ssh /var/www/static root@${_tgt}:/var/www/
      echo "INFO: ${_cmd} for ${_oct} /var/www/static complete"
    fi
    if [ -e "/etc/bind" ]; then
      _xoct_rsync -aEAXq ${_ieni} -e ssh /etc/bind root@${_tgt}:/etc/
      echo "INFO: ${_cmd} for ${_oct} /etc/bind complete"
    fi
    if [ -e "/var/log/boa/usage" ]; then
      _xoct_rsync -aEAXq ${_ieni} -e ssh /var/log/boa/usage root@${_tgt}:/var/log/boa/
      echo "INFO: ${_cmd} for ${_oct} /var/log/boa/usage complete"
    fi
    if [ -e "/data/disk/legacy" ]; then
      echo "INFO: ${_cmd} for ${_oct} /data/disk/legacy start"
      _xoct_rsync -aEAXq ${_ieni} -e ssh /data/disk/legacy root@${_tgt}:/data/disk/
      echo "INFO: ${_cmd} for ${_oct} /data/disk/legacy complete"
    fi
    if [ "${_MODE}" = "LIVE" ]; then
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} complete"
    else
      _xoct_finalize_dry "${_oct}" "${_tgt}"
    fi
  else
    _RUNTIME_OCT=$(_xoct_runtime_oct)
    _USR=/data/disk/${_RUNTIME_OCT}
    ### Who the account belongs to, read before the target is contacted: its
    ### client address as its own Octopus pass takes it (_xoct_client_address).
    ### One of the hosted service's own addresses, in log/email.txt or as that
    ### address, marks an internal account, which a move of one account
    ### refuses at its start (create, export, pretransfer), as xcopy does. A
    ### move of every account of the box carries them all and says so with
    ### _XOCT_BOX_MOVE=YES: xmass sets it for its creates, and an operator
    ### moving a whole box account by account with xoct sets it on those three
    ### verbs. An account with no plain address in either place is refused at
    ### the same verbs: it would be installed and mailed under an address
    ### nobody reads, where a stand-in used to be put. transfer, import and
    ### proxy refuse neither, so a move under way is never stopped half way.
    _xoct_client_address "${_USR}" "${_RUNTIME_OCT}"
    _XOCT_EMAIL_CLASS=OK
    for _xe in "${_XOCT_EMAIL_TXT}" "${_CLIENT_EMAIL}"; do
      if [ "${_xe}" = "inbox@boa.io" ] \
        || [[ "${_xe}" == *"emaylx@"* ]] \
        || [[ "${_xe}" == *"mixomax@"* ]] \
        || [[ "${_xe}" == *"@omega8.cc"* ]]; then
        _XOCT_EMAIL_CLASS=OUR
      fi
    done
    if [ "${_XOCT_EMAIL_CLASS}" = "OK" ] && [ -z "${_CLIENT_EMAIL}" ]; then
      _XOCT_EMAIL_CLASS=BAD
    fi
    _XOCT_START_VERB=NO
    case "${_cmd}" in
      create|export|pretransfer) _XOCT_START_VERB=YES ;;
    esac
    ### A test run's record (_xoct_admail_rec) holds every verb for the
    ### account here to its admail=, before anything else is asked; import
    ### keeps to it by itself (the upgrade notice stays off).
    if [ "${_cmd}" != "import" ] && ! _xoct_admail_gate "${_RUNTIME_OCT}"; then
      exit 1
    fi
    ### So does a box that holds its clients' mail for a test run
    ### (_XOCT_HOLD_FILE): this one for every verb but import (which says
    ### so), and the target of a verb that writes there or moves the
    ### account's service to it. Not the completion notice go-live sends: a
    ### hold go-live keeps is there for another test run still recorded on
    ### that box, and refusing the notice would release none of it.
    if [ "${_cmd}" != "import" ] && [ "${_XOCT_GO_LIVE}" != "YES" ] \
      && ! _xoct_hold_gate ""; then
      exit 1
    fi
    case "${_cmd}" in
      create|pretransfer|transfer|proxy)
        if [ "${_XOCT_GO_LIVE}" != "YES" ] && _mig_valid_ip "${_tgt}" \
          && ! _xoct_hold_gate "${_tgt}"; then
          exit 1
        fi
      ;;
    esac
    if [ "${_oct}" = "arch" ] \
      || [ "${_oct}" = "all" ] \
      || [ "${_oct}" = "lost+found" ] \
      || [ "${_oct}" = "lostfound" ] \
      || [ "${_oct}" = "backups" ] \
      || [ "${_oct}" = "codebases-cleanup" ]; then
      echo "_USR ${_oct} is not eligible for migration: system dir"
      exit 1
    elif [ ! -e "${_USR}/log/cores.txt" ] \
      || [ ! -e "${_USR}/log/option.txt" ] \
      || [ ! -e "${_USR}/log/email.txt" ]; then
      echo "_USR ${_oct} is not eligible for migration: broken"
      exit 1
    elif [ -e "${_USR}/log/CANCELLED" ]; then
      echo "_USR ${_oct} is not eligible for migration: cancelled"
      exit 1
    elif [ -e "${_USR}/log/proxied.pid" ] && [ "${_cmd}" != "proxy" ]; then
      echo "_USR ${_oct} is not eligible for migration: already migrated"
      exit 1
    elif [ "${_cmd}" = "create" ] && [ -e "${_USR}/log/exported.pid" ] \
      && ! _xoct_canary_carried "${_RUNTIME_OCT}"; then
      echo "_USR ${_oct} is not eligible for migration: already created"
      exit 1
    elif [ "${_cmd}" = "export" ] && [ -e "${_USR}/log/exported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already exported"
      exit 1
    elif [ "${_cmd}" = "transfer" ] && [ -e "${_USR}/log/transferred.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already transferred"
      exit 1
    elif [ "${_cmd}" = "transfer" ] && [ -e "${_USR}/log/export_failed.pid" ] \
      && [ "${_XOCT_FORCE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: export incomplete"
      echo "ALRT: log/export_failed.pid is present -- the last export left FAILED site dumps:"
      _xoct_read_in "${_USR}/log" export_failed.pid | sed "s/^/ALRT:   /"
      echo "INFO: re-run 'xoct export${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}' after fixing the cause, or pass --force to transfer anyway"
      exit 1
    elif [ "${_cmd}" = "import" ] && [ -e "${_USR}/log/export_failed.pid" ] \
      && [ "${_XOCT_FORCE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: export incomplete"
      echo "ALRT: log/export_failed.pid travelled with this account -- the source export left FAILED site dumps:"
      _xoct_read_in "${_USR}/log" export_failed.pid | sed "s/^/ALRT:   /"
      echo "INFO: fix and re-run export + transfer on the source, or pass --force to import anyway"
      exit 1
    elif [ "${_cmd}" = "import" ] && [ -e "${_USR}/log/imported.pid" ]; then
      echo "_USR ${_oct} is not eligible for migration: already imported"
      exit 1
    elif [ "${_cmd}" = "proxy" ] \
      && [ -e "${_USR}/log/proxied.pid" ] \
      && [ "${_XOCT_PROXY_REPAIR}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: already proxied"
      echo "INFO: to repoint or repair this account's proxy, re-run with --repair"
      exit 1
    elif [ "${_XOCT_START_VERB}" = "YES" ] && [ "${_XOCT_EMAIL_CLASS}" = "OUR" ] \
      && [ "${_XOCT_BOX_MOVE}" != "YES" ]; then
      echo "_USR ${_oct} is not eligible for migration: internal only"
      echo "INFO: a move of one account leaves the hosted service's own accounts where they are;"
      echo "INFO: when every account of this box moves with xoct, carry this one too with:"
      echo "INFO:   _XOCT_BOX_MOVE=YES xoct ${_cmd} ${_oct} ${_tgt}${_dst:+ ${_dst}}${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
      echo "INFO: (on create, export and pretransfer; transfer, import and proxy need no flag)"
      exit 1
    elif [ "${_XOCT_START_VERB}" = "YES" ] && [ "${_XOCT_EMAIL_CLASS}" = "BAD" ]; then
      echo "_USR ${_oct} is not eligible for migration: no plain address in log/email.txt ('$(_xoct_shown "${_XOCT_EMAIL_TXT}")') or in _CLIENT_EMAIL of /root/.${_RUNTIME_OCT}.octopus.cnf"
      echo "INFO: set the client's address as _CLIENT_EMAIL in /root/.${_RUNTIME_OCT}.octopus.cnf and re-run"
      exit 1
    else
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} start"
      if [ "${_XOCT_FORCE}" = "YES" ] && [ -e "${_USR}/log/export_failed.pid" ]; then
        if [ "${_cmd}" = "transfer" ] || [ "${_cmd}" = "import" ]; then
          echo "ALRT: --force: proceeding although log/export_failed.pid marks FAILED site dumps"
        fi
      fi
      if [ "${_cmd}" = "transfer" ] || [ "${_cmd}" = "pretransfer" ]; then
        if [ ! -z "${_dst}" ]; then
          _DST=/data/disk/${_dst}
        else
          _DST=/data/disk/${_oct}
        fi
        # Resolve the target's attached mount (aborts on empty/unreachable/multi-mount).
        _xoct_resolve_target_mnt "${_tgt}"
        # The account's web group: refused on a target whose tools predate
        # it, mapped onto the target account's otherwise (before the token
        # below is consumed, so a refusal never costs another dry run).
        _xoct_webgroup_gate "${_oct}" "${_DST##*/}" "${_tgt}"
        # and its own group, on every leg ahead of the web group's
        _xoct_acct_gmap "${_oct}" "${_DST##*/}" "${_tgt}"
        _xoct_acct_umap "${_oct}" "${_DST##*/}" "${_tgt}"
        _XOCT_GMAP="${_XOCT_AMAP}${_XOCT_AMAP:+${_XOCT_GMAP:+,}}${_XOCT_GMAP}"
        # --live requires a prior CLEAN dry run for this account+target.
        [ "${_MODE}" = "LIVE" ] && _xoct_require_clean_dry "${_oct}" "${_tgt}"
        _XOCT_STORE_RC=0
        if [ -e "${_USR}" ]; then
          ### distro/ and src/ belong to oN on both boxes: each leg expands its
          ### glob inside the real source directory and the receiver writes
          ### inside the real target directory (created when missing), so a link
          ### the account put at either name is never followed or written through.
          ### A leg whose source is not a real directory is refused (DENY) by
          ### _xoct_leg_ok, never skipped quietly.
          _xoct_leg_ok "${_USR}/distro" \
            && _xoct_in_real_dir "${_USR}/distro" _xoct_copy_mk_here "${_tgt}" \
              "${_DST}/distro" '*' -aEAXqu ${_ieni}
          _xoct_leg_ok "${_USR}/src" \
            && _xoct_in_real_dir "${_USR}/src" _xoct_copy_mk_here "${_tgt}" \
              "${_DST}/src" '*' -aEAXqu ${_ieni}
          _xoct_transfer_static_symlink_safe "${_USR}" "${_tgt}" "${_DST}" "${_ieni}" "${_TGT_MNT}"
          #
          _DST_ACCT=$(basename "${_DST}")
          # The sub-account password store must land BEFORE clients/ does:
          # manage_ltd_users creates sub-users from clients/ on its first
          # pass that sees them (import's pool rebuild for an account with
          # per-site PHP pins, else once post-mig ends the pre-mig park),
          # and honours a pre-existing store entry (the carried password)
          # only if it is already there. Forced (no -u): the target's fresh
          # install must never shadow the carried credentials.
          # The store is the account's: sent from inside the real directory
          # into the real directory on the target (made when missing).
          _xoct_leg_ok "/home/${_oct}.ftp/users" \
            && _xoct_in_real_dir "/home/${_oct}.ftp/users" _xoct_copy_mk_here \
              "${_tgt}" "/home/${_DST_ACCT}.ftp/users" '' -aEAX ${_ieni}
          ### clients/ is oN's on both boxes: pinned both ends, target made real.
          _xoct_leg_ok "${_USR}/clients" \
            && _xoct_in_real_dir "${_USR}/clients" _xoct_copy_mk_here "${_tgt}" \
              "${_DST}/clients" '*' -aEAXqu ${_ieni} &> /dev/null
          # instance-group.txt records the SOURCE box's conversion (its gid);
          # it must never travel, the destination pass writes its own, and
          # web-group-notes.txt names the source box's web-group state.
          ### log/ is oN's on both boxes: copied from inside the real
          ### directory into the real directory, the glob expanded there.
          ### The account's own log/email.txt goes over the install's copy
          ### after it (one address, newer, so the -u leg keeps it): the
          ### target keeps the client's address, or list, exactly as it is.
          if _xoct_leg_ok "${_USR}/log"; then
            _xoct_in_real_dir "${_USR}/log" _xoct_copy_here "${_tgt}" "${_DST}/log" '*' \
              -aEAXqu ${_ieni} --exclude=instance-group.txt --exclude=proxy-failed.pid \
              --exclude=web-group-notes.txt
            _xoct_in_real_dir "${_USR}/log" _xoct_put_file_remote_here \
              email.txt "${_tgt}" "${_DST}/log" "${_ieni}"
          fi
          ### static/control is the tenant's on both boxes: a control that is
          ### a link is never followed (the glob this replaces expanded
          ### through it); a real one travels by its top-level entries, from
          ### inside it into the real control directory on the target. Its
          ### subdirectories came with the static pass above and are never
          ### entered here by name.
          if [ -L "${_USR}/static/control" ]; then
            echo "ALRT: ${_USR}/static/control is a symlink -- not followed; no control file of ${_oct} travels"
          elif [ -d "${_USR}/static/control" ]; then
            _xoct_in_real_dir "${_USR}/static/control" _xoct_copy_here "${_tgt}" \
              "${_DST}/static/control" '' -aEAXqu ${_ieni} --exclude='*/' &> /dev/null
          fi
          #
          ### backups/ and backup-exports/ follow the nightly's store layout
          ### (see _xoct_backups_leg). undo/ is oN's on both boxes: pinned both
          ### ends, the target directory made real (the installer does not).
          _xoct_backups_leg "${_USR}" "${_DST}" "${_tgt}" "${_ieni}" backups
          _xoct_backups_leg "${_USR}" "${_DST}" "${_tgt}" "${_ieni}" backup-exports
          _xoct_leg_ok "${_USR}/undo" \
            && _xoct_in_real_dir "${_USR}/undo" _xoct_copy_mk_here "${_tgt}" \
              "${_DST}/undo" '*' -aEAXqu ${_ieni} &> /dev/null
          # The account's SSH keys: from the real directory into the real one.
          _xoct_leg_ok "/home/${_oct}.ftp/.ssh" \
            && _xoct_in_real_dir "/home/${_oct}.ftp/.ssh" _xoct_copy_mk_here \
              "${_tgt}" "/home/${_DST_ACCT}.ftp/.ssh" '' -aEAXqu ${_ieni}

          # Client-installed toolchains live outside /data/disk in the lshell
          # jail's writable trees and never travelled before -- migrate AS-IS.
          # The parents are sticky and world-writable, so each leaf is its
          # owner's to replace: pinned as the account legs are.
          _xoct_leg_ok "/opt/user/gems/${_oct}.ftp" \
            && _xoct_in_real_dir "/opt/user/gems/${_oct}.ftp" _xoct_copy_mk_here \
              "${_tgt}" "/opt/user/gems/${_DST_ACCT}.ftp" '' -aEAXqu ${_ieni}
          _xoct_leg_ok "/opt/user/npm/${_oct}.ftp" \
            && _xoct_in_real_dir "/opt/user/npm/${_oct}.ftp" _xoct_copy_mk_here \
              "${_tgt}" "/opt/user/npm/${_DST_ACCT}.ftp" '' -aEAXqu ${_ieni}

          # Re-converge the octopus.cnf and the client credentials on every
          # LIVE transfer: source-side changes since create (a PHP pin move,
          # a password rotation, new sub-accounts) must reach the target
          # before cutover. Never in DRY -- these mutate the target. The PHP
          # coverage gate re-runs first, because the pins forced by the
          # static pass above must never name a version the target lacks.
          if [ "${_MODE}" = "LIVE" ]; then
            if ! _xoct_php_coverage_gate "${_USR}" "${_tgt}"; then
              echo "ERROR: ${_cmd} for ${_oct}: target PHP coverage failed AFTER the file sync;"
              echo "ERROR: NOT marking the transfer complete -- fix the target PHP set and re-run"
              exit 1
            fi
            _xoct_push_target_octopus_cnf "${_oct}" "${_DST_ACCT}" "${_tgt}"
            _xoct_sync_shell_credentials "${_oct}" "${_DST_ACCT}" "${_tgt}"
          fi

          # The target keeps its own panel aliases (hostmaster, hm and
          # server_master). Import reads the hostmaster alias to find the
          # panel it pours into, and drives drush @hostmaster, before the
          # rename rewrites anything: a source copy that won the -u mtime
          # race named a site_path the target does not have, so the whole
          # panel import was skipped, and its server_master sent drush to
          # the source host. The rename pins OLD from log/sourcefqdn.txt,
          # never from these aliases. The source platform_* and per-site
          # aliases still travel. Exact names: an rsync pattern without a
          # slash or wildcard must match the whole final name. .drush is
          # oN's on both boxes: copied from inside the real directory into
          # the real directory, the glob expanded there.
          _xoct_leg_ok "${_USR}/.drush" \
            && _xoct_in_real_dir "${_USR}/.drush" _xoct_copy_here "${_tgt}" \
              "${_DST}/.drush" '*.alias.drushrc.php' -aEAXqu ${_ieni} \
              --exclude=hostmaster.alias.drushrc.php \
              --exclude=hm.alias.drushrc.php \
              --exclude=server_master.alias.drushrc.php

          ### config/ and tools/ belong to oN on both boxes: every leg below
          ### expands its glob inside the real source directory and the receiver
          ### writes inside the real target directory (created when missing), so
          ### a link the account put at a directory name is never followed or
          ### written through. Subdirectories below the top level are still
          ### walked by rsync as it finds them.
          _xoct_leg_ok "${_USR}/config/server_master/nginx/vhost.d" \
            && _xoct_in_real_dir "${_USR}/config/server_master/nginx/vhost.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/vhost.d" '*' \
              -aEAXqu ${_ieni} --exclude=host8.biz --exclude=boa.io --exclude=aegir.cc

          _xoct_leg_ok "${_USR}/config/server_master/nginx/pre.d" \
            && _xoct_in_real_dir "${_USR}/config/server_master/nginx/pre.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/pre.d" '*' \
              -aEAXqu ${_ieni} &> /dev/null

          _xoct_leg_ok "${_USR}/config/server_master/nginx/post.d" \
            && _xoct_in_real_dir "${_USR}/config/server_master/nginx/post.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/post.d" '*' \
              -aEAXqu ${_ieni} &> /dev/null

          _xoct_leg_ok "${_USR}/config/server_master/nginx/subdir.d" \
            && _xoct_in_real_dir "${_USR}/config/server_master/nginx/subdir.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/subdir.d" '*' \
              -aEAXqu ${_ieni} &> /dev/null

          _xoct_leg_ok "${_USR}/config/server_master/nginx/platform.d" \
            && _xoct_in_real_dir "${_USR}/config/server_master/nginx/platform.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/server_master/nginx/platform.d" '*' \
              -aEAXqu ${_ieni} &> /dev/null

          _xoct_leg_ok "${_USR}/config/ssl.d" \
            && _xoct_in_real_dir "${_USR}/config/ssl.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/ssl.d" '*' \
              -aEAXqu ${_ieni} &> /dev/null

          _xoct_leg_ok "${_USR}/config/server_master/ssl.d" \
            && _xoct_in_real_dir "${_USR}/config/server_master/ssl.d" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/config/server_master/ssl.d" '*' \
              -aEAXqu ${_ieni} &> /dev/null

          _xoct_leg_ok "${_USR}/tools" \
            && _xoct_in_real_dir "${_USR}/tools" \
              _xoct_copy_mk_here "${_tgt}" "${_DST}/tools" 'le' \
              -aEAXqu ${_ieni} &> /dev/null

          # Catch-all: fix any OTHER /mnt-anchored symlink in the account tree that the
          # rsync -a passes above transferred as a bare (dangling-on-target) link.
          _xoct_catchall_mnt_symlinks "${_USR}" "${_DST}" "${_tgt}" "${_TGT_MNT}" "${_ieni}"

          if [ "${_XOCT_STORE_RC:-0}" != "0" ]; then
            echo "ERROR: ${_cmd} for ${_oct}: a store/symlink could not be placed on the target (see DENY above); NOT marking transfer complete"
            exit 1
          fi

          # What the move does not carry of the web-group state (a pin, a
          # revert in progress, phase B onto a box with it off, an opt-out
          # that arrived after the target converted): named once the copy is
          # there, never a refusal.
          [ "${_cmd}" = "transfer" ] && _wg_migration_notes "${_oct}" "${_DST##*/}" "${_tgt}" state

          if [ "${_MODE}" = "LIVE" ]; then
            if [ ! -z "${_dst}" ] && [ "${_dst}" != "${_oct}" ]; then
              _xoct_rewrite_target_account_refs "${_oct}" "${_dst}" "${_tgt}" "${_DST}" "${_TGT_MNT}"
            fi
            _xoct_regroup_target_account "${_dst:-${_oct}}" "${_tgt}"
            echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} complete"
            # Only the real transfer marks the account migrated -- pretransfer
            # shares this completion path (warm-up rsync while the account is
            # still live) and marking it here made the documented
            # pretransfer -> export -> transfer sequence self-blocking at the
            # transferred.pid eligibility gate.
            if [ "${_cmd}" = "transfer" ]; then
              ### A transfer that passed the export gate means the source's
              ### export is clean now -- a stale export_failed.pid that
              ### travelled with an earlier --force transfer must not wedge
              ### the import on the target forever.
              ### log/ is oN's on both boxes: removed and stamped inside the
              ### real directory, never through a link put there.
              if [ ! -e "${_USR}/log/export_failed.pid" ]; then
                _xoct_remote_in "${_tgt}" "${_DST}/log" 'rm -f -- ./export_failed.pid' &> /dev/null
              fi
              _xoct_in_real_dir "${_USR}/log" _xoct_touch_here transferred.pid
            fi
          else
            _xoct_finalize_dry "${_oct}" "${_tgt}"
          fi
        fi
      else
        # shellcheck disable=SC1091
        [ -e "/root/.${_oct}.octopus.cnf" ] && source /root/.${_oct}.octopus.cnf
        ### Policy resolution, record writes, peer push and target trust all
        ### happen BEFORE any vhost is touched; a peer that cannot take the
        ### record refuses the whole conversion.
        if [ "${_cmd}" = "proxy" ]; then
          _xoct_proxy_preflight
        fi
        ### We are using max verbose mode by default
        _migrate_prepare
          ### _NOW=$(date +%y%m%d-%H%M)
          ### mkdir -p /var/log/boa/migrate
          ### _migrate_prepare >/var/log/boa/migrate/migrate-${_oct}-${_cmd}-${_NOW}.log 2>&1
        if [ "${_cmd}" = "proxy" ]; then
          ### A failed conversion must never mail "complete" nor stamp the
          ### account migrated: any per-site failure, or zero converted sites
          ### where there were sites to convert, leaves proxied.pid absent and
          ### exits non-zero so callers (xmass step 16) can see it. Re-running
          ### after the cause is fixed converges: converted sites are kept and
          ### the saved vhost backups are never overwritten. An account that
          ### holds nothing but its control panel has nothing to convert: it
          ### is converted by definition (the panel stays local in maintenance
          ### mode), so it is stamped, its gate is released and the client is
          ### told that the panel moved -- a live cutover once left such an
          ### account 503-gated on the source for a "0 site(s) converted".
          if [ "${_XOCT_PROXY_ELIGIBLE:-0}" = "0" ] && [ "${_XOCT_PROXY_FAIL:-0}" = "0" ]; then
            if [ -n "${_XOCT_PROXY_DEFERRED}" ]; then
              echo "INFO: nothing to proxy for ${_oct} yet: every site is deferred -- treated as converted"
            else
              echo "INFO: nothing to proxy for ${_oct}: the account holds only its control panel -- treated as converted"
            fi
          fi
          ### The per-host gate goes up BEFORE anything is reloaded or lifted:
          ### a deferred site must never be reachable ungated. A gate that
          ### cannot be written refuses the run with the account gate intact.
          if [ -n "${_XOCT_PROXY_DEFERRED}" ]; then
            if ! _xoct_plant_host_gate "${_USR}" "${_oct}" "${_OCT_GRP}" "${_XOCT_DEFER_FQDN}"; then
              echo "ERROR: could not write ${_USR}/static/control/http-off-host.pid for the deferred sites"
              _xoct_revert_converted_vhosts \
                "${_USR}/config/server_master/nginx/vhost.d" \
                "${_XOCT_FIRST_BACKUP_DOMS}"
              echo "ERROR: ${_oct} was NOT converted; the vhosts this run converted are back as found"
              exit 1
            fi
          fi
          if [ "${_XOCT_PROXY_FAIL:-0}" != "0" ] || { [ "${_XOCT_PROXY_OK:-0}" = "0" ] && [ "${_XOCT_PROXY_ELIGIBLE:-0}" != "0" ]; }; then
            echo "ALRT: proxy conversion for ${_oct}: ${_XOCT_PROXY_OK:-0} site(s) converted, ${_XOCT_PROXY_FAIL:-0} failed"
            echo "ERROR: NOT stamping proxied.pid and NOT mailing the client; fix the cause and re-run"
            if [ -n "${_XOCT_OLD_PEER}" ]; then
              ### The record already points at the new target; without this
              ### hint the abandoned one would be findable only in migproxy.log.
              echo "ALRT: retarget was in flight: the abandoned target ${_XOCT_OLD_PEER} still trusts"
              echo "ALRT: this proxy; when the repoint completes (or is given up), run there:"
              echo "ALRT:   ${_MIG_TRUST_TOOL} reconcile"
            fi
            exit 1
          fi
          ### Fail-closed reload: a bad render must leave nginx on the OLD
          ### config with the 503 gate still up, never half-applied. The
          ### certificate mirror set the configtest-gated precedent.
          if nginx -t &> /dev/null; then
            service nginx reload
          else
            ### Revert, do not merely refuse to reload: a config that fails
            ### configtest sitting on disk is a box-wide outage waiting for
            ### the next unrelated reload or restart. Put every vhost this
            ### run converted back to its saved original, then prove the
            ### restored state passes before reporting.
            echo "ALRT: nginx -t failed after the proxy conversion for ${_oct}"
            nginx -t 2>&1 | tail -5
            if [ "${_XOCT_WAS_PROXIED}" = "YES" ]; then
              ### A repair: the saved dot-file is the ORIGINAL local vhost,
              ### not the working proxy vhost this run replaced, so there is
              ### nothing correct to revert to -- restoring it would serve
              ### the account locally against a database that lives on the
              ### target. Leave it and make the danger explicit instead.
              ### What this run converted for the FIRST time is the
              ### exception: those vhosts were local (and gated) when it
              ### started, so putting them back is exactly the state before
              ### the run -- and it is the usual cause, since they are the
              ### only files this pass wrote from scratch.
              if [ -n "${_XOCT_FIRST_BACKUP_DOMS}" ]; then
                _xoct_revert_converted_vhosts \
                  "${_USR}/config/server_master/nginx/vhost.d" \
                  "${_XOCT_FIRST_BACKUP_DOMS}"
                echo "ALRT: put back the vhosts this run converted for the first time:${_XOCT_FIRST_BACKUP_DOMS}"
              fi
              if nginx -t &> /dev/null; then
                echo "INFO: the config is valid again; nginx was NOT reloaded and nothing was lifted"
              else
                echo "ERROR: this was a --repair, so the saved vhost is the pre-migration ORIGINAL"
                echo "ERROR: and restoring it would serve this account against the OLD local database."
                echo "ERROR: nginx has NOT been reloaded and still runs the previous, working config,"
                echo "ERROR: but the invalid files are on disk: the next reload or restart on this box"
                echo "ERROR: (including an unrelated one) will fail. Fix the reported error NOW, then:"
                echo "ERROR:   nginx -t && service nginx reload"
              fi
            else
              ### A first conversion: reverting to the saved originals is
              ### exactly the pre-conversion state, so restore what THIS run
              ### rewrote and prove the config is valid again.
              _xoct_revert_converted_vhosts \
                "${_USR}/config/server_master/nginx/vhost.d" \
                "${_XOCT_CONVERTED_DOMS}"
              if nginx -t &> /dev/null; then
                echo "INFO: reverted to the pre-conversion vhosts; nginx config is valid again"
              else
                echo "ERROR: the config is STILL invalid after the revert -- inspect nginx -t output"
                echo "ERROR: before any reload or restart of nginx on this box"
              fi
            fi
            echo "ERROR: ${_oct} was NOT converted. Fix the reported error, then re-run:"
            echo "ERROR:   $(_xoct_repair_env)xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}} --repair${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
            exit 1
          fi
          if [ -n "${_XOCT_PROXY_NOSSL}" ]; then
            echo "ALRT: converted WITHOUT an HTTPS proxy vhost (certificate material missing):${_XOCT_PROXY_NOSSL}"
            echo "ALRT: HTTPS via the old address will fail for those sites; once the keys exist,"
            echo "ALRT: re-run: $(_xoct_repair_env)xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}} --repair${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
          fi
          if [ -n "${_XOCT_PROXY_DEFERRED}" ]; then
            echo "INFO: deferred, still local and held on 503 by the per-host gate:${_XOCT_PROXY_DEFERRED}"
            echo "INFO: once they are renamed on the new box, convert them with:"
            echo "INFO:   xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}} --repair${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
          fi
          ###
          ### Every site on this account now answers from a proxy or redirect
          ### vhost, or is held by the per-host gate written above, so the
          ### account-wide 503 short-circuit is no longer needed. Remove the
          ### per-account pid file and purge any lingering cached 503
          ### responses from the speed cache so post-migration traffic to the
          ### proxy vhost is unaffected. A pass that deferred nothing is the
          ### full conversion: the per-host gate has nothing left to hold.
          ###
          _xoct_in_real_dir "${_USR}/static/control" rm -f -- ./http-off.pid
          if [ -z "${_XOCT_PROXY_DEFERRED}" ] && [ -z "${_XOCT_DEFER_FQDN}" ]; then
            _xoct_in_real_dir "${_USR}/static/control" rm -f -- ./http-off-host.pid
          fi
          if [ -d "/var/lib/nginx/speed" ]; then
            find /var/lib/nginx/speed -type f -delete &> /dev/null
          fi
          ### The panel stays online here as the box's monitoring canary, in
          ### Drupal's own maintenance mode: clients can no longer log in or
          ### queue tasks against a database that now lives on the target,
          ### while an admin still can. Set at this point, not at export as
          ### the old tool did: in the xmass flow the export path is never
          ### reached, and set before promotion it would replicate INTO the
          ### new production panel. Here the source has stopped replicating.
          _run_drush8_hmr_cmd "variable-set --always-set maintenance_mode 1" 2>&1 | tail -1
          ### Flush the panel's page cache too, or anonymous visitors keep
          ### getting the cached pre-hold front page instead of the 503.
          _run_drush8_hmr_cmd "cache-clear all" &> /dev/null
          ### Notify: a first conversion always sends the completion notice; a
          ### repair keeps quiet unless the promise itself changed (or
          ### --renotify). --no-notify suppresses either, and the suppression
          ### is logged because the mail log is the record of what the
          ### customer was actually told.
          _mig_build_mail_blocks complete "${_tgt}"
          _XOCT_DO_MAIL=NO
          _XOCT_MAIL_KIND=complete
          if [ "${_XOCT_WAS_PROXIED}" = "YES" ]; then
            ### The follow-up opens "a short follow-up to the migration
            ### message you received earlier": a client never really told of
            ### the completion (a test run's notice went to admail=, the
            ### first one failed or was suppressed) gets the completion
            ### notice instead. One converted before the log recorded the
            ### notices was told then (_xoct_told_complete).
            _XOCT_MAIL_KIND=change
            _xoct_told_complete "${_USR}" "${_tgt}" ${_XOCT_OLD_PEER:+"${_XOCT_OLD_PEER}"} \
              || _XOCT_MAIL_KIND=complete
            _XOCT_LAST_MAIL="$(_mig_last_mail "${_USR}" "${_tgt}" ${_XOCT_OLD_PEER:+"${_XOCT_OLD_PEER}"})"
            if [ "${_XOCT_RENOTIFY}" = "YES" ]; then
              _XOCT_DO_MAIL=YES
            elif [ -n "${_XOCT_LAST_MAIL}" ] \
              && [ "${_XOCT_LAST_MAIL}" != "${_MIG_MODE}|${_MIG_DEADLINE:--}" ]; then
              _XOCT_DO_MAIL=YES
            fi
          else
            _XOCT_DO_MAIL=YES
          fi
          if [ "${_XOCT_NO_NOTIFY}" = "YES" ] && [ "${_XOCT_DO_MAIL}" = "YES" ]; then
            _XOCT_DO_MAIL=NO
            _mig_log "${_USR}" xoct skip "${_XOCT_MAIL_KIND}-suppressed" "${_MIG_MODE}" "${_MIG_DEADLINE}" "${_tgt}"
            echo "INFO: client notice suppressed by --no-notify (logged)"
          fi
          if [ "${_XOCT_DO_MAIL}" = "YES" ]; then
            if [ "${_XOCT_MAIL_KIND}" = "complete" ]; then
              _send_notice_migration_complete
            else
              _send_notice_migration_change
            fi
            if [ "${_MAIL_SENT}" = "YES" ]; then
              _mig_log "${_USR}" xoct "${_XOCT_MAIL_ACT}" "${_XOCT_MAIL_KIND}" "${_MIG_MODE}" "${_MIG_DEADLINE}" "${_tgt}"
            else
              echo "ALRT: resend later with: $(_xoct_repair_env)xoct proxy ${_oct} ${_tgt}${_dst:+ ${_dst}} --repair --renotify${_XOCT_ADMAIL:+ admail=${_XOCT_ADMAIL}}"
            fi
          fi
          ### A repair never re-stamps; the stamp is migration STATE owned by
          ### this first successful conversion. log/ is oN's: stamped and
          ### cleared inside the real directory, never through a link.
          if [ ! -e "${_USR}/log/proxied.pid" ]; then
            _xoct_in_real_dir "${_USR}/log" _xoct_put_here proxied.pid COMPLETE
          fi
          ### A cutover that could not convert this account marked it so that
          ### BOA kept its dispatcher parked and octopus skipped it; converted
          ### now, it is proxied and proxied.pid keeps both.
          if [ -e "${_USR}/log/proxy-failed.pid" ]; then
            _xoct_in_real_dir "${_USR}/log" rm -f -- ./proxy-failed.pid
            echo "INFO: ${_oct}: converted after a failed cutover conversion; proxy-failed.pid removed"
          fi
          ### Park this account's dispatcher NOW, in the same breath as the
          ### conversion. BOA parks it on the proxied.pid marker, but only
          ### on its next pass -- and a single tick inside that window runs
          ### the account's Ægir queue, whose pending Verify regenerates the
          ### site vhosts straight from the database and silently UNDOES the
          ### proxy: the old box quietly resumes serving its own stale copy
          ### to everyone still resolving to it. Observed live: conversion at
          ### :45, dispatcher tick at :50, both vhosts back to fastcgi.
          ### Same destination BOA itself uses, so its own housekeeping stays
          ### authoritative afterwards.
          if [ -e "/var/xdrago/run-${_THIS_HM_USER}" ]; then
            mkdir -p /var/backups/off-run
            mv -f "/var/xdrago/run-${_THIS_HM_USER}" /var/backups/off-run/ 2>/dev/null \
              && echo "INFO: parked the ${_THIS_HM_USER} dispatcher; its queue can no longer regenerate the proxy vhosts"
          fi
          ### Retarget: the abandoned target must stop trusting this proxy.
          ### Best-effort by design ("where reachable"): the repoint itself
          ### must not be blocked by an old box that is already half gone.
          if [ -n "${_XOCT_OLD_PEER}" ]; then
            if _xoct_push_peer_record "${_XOCT_OLD_PEER}" "${_XOCT_OLD_PEER_OCT:-${_oct}}" \
              target retired box "" "${_oct}" \
              && _xoct_peer_reconcile "${_XOCT_OLD_PEER}"; then
              echo "INFO: released migration-proxy trust on abandoned target ${_XOCT_OLD_PEER}"
            else
              echo "ALRT: could not release trust on abandoned target ${_XOCT_OLD_PEER}; when it is"
              echo "ALRT: reachable, run there: ${_MIG_TRUST_TOOL} reconcile"
            fi
          fi
        fi
      fi
      if [ "${_XOCT_RUN_FAIL}" = "YES" ]; then
        ### Truthful run verdict: per-site ALRT lines above already name the
        ### failures; callers (xmass step 13, harnesses) key on the rc.
        echo "ALRT: ${_cmd} for ${_oct} to ${_tgt} ${_dst} INCOMPLETE -- see ALRT/ERROR lines above"
        exit 1
      fi
      echo "INFO: ${_cmd} for ${_oct} to ${_tgt} ${_dst} complete"
      exit 0
    fi
  fi
}

### pre-mig key exchange. The source publishes its root public key on its
### undefined vhost and the target fetches it over plain HTTP, so the target
### trusts it only when its fingerprint equals the one the source printed,
### carried across by the operator as --key-fp. Anything else answering on
### that name, or a stale key another box still serves there, would
### otherwise be granted root on the target.
_XOCT_KEY_LINE_RE='^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp[0-9]+|sk-ssh-ed25519@openssh\.com) [A-Za-z0-9+/]+=*( |$)'

### The form 'ssh-keygen -l -E sha256' prints: SHA256: and 43 base64
### characters. A pasted '=' pad is accepted and dropped before comparing.
_xoct_valid_key_fp() {
  [[ "$1" =~ ^SHA256:[A-Za-z0-9+/]{43}=?$ ]]
}

_xoct_print_key_fp() {
  local _fp
  _fp=$(ssh-keygen -l -E sha256 -f /root/.ssh/id_ed25519.pub 2>/dev/null \
    | awk '{print $2; exit}')
  if _xoct_valid_key_fp "${_fp}"; then
    echo "INFO: published key fingerprint: ${_fp}"
    echo "INFO: on the target run: xoct pre-mig ${_hName} --key-fp=${_fp}"
  else
    echo "ALRT: could not read the fingerprint of /root/.ssh/id_ed25519.pub;"
    echo "ALRT: the target's pre-mig needs it: ssh-keygen -l -E sha256 -f /root/.ssh/id_ed25519.pub"
  fi
}

### Target side, run before anything is parked: sets _XOCT_SRC_KEY to the one
### fetched key line whose fingerprint is --key-fp, or refuses with nothing
### added to authorized_keys.
_xoct_fetch_source_key() {
  local _kf="/root/.ssh/auth_undefined_keys.txt" _kc _krc _kl _fp _seen=""
  _XOCT_SRC_KEY=""
  case "${_hst}" in
    ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*)
      echo "ERROR: pre-mig on the target needs the source's hostname, got '${_hst}'"
      return 1
      ;;
  esac
  if [ -z "${_XOCT_KEY_FP}" ]; then
    echo "ERROR: pre-mig on the target needs --key-fp=SHA256:..., the fingerprint"
    echo "ERROR: 'xoct pre-mig ${_hst}' printed on ${_hst}; nothing was changed here"
    return 1
  fi
  if ! _xoct_valid_key_fp "${_XOCT_KEY_FP}"; then
    echo "ERROR: --key-fp '${_XOCT_KEY_FP}' is not a SHA256 key fingerprint"
    echo "ERROR: (SHA256: and 43 base64 characters); nothing was changed here"
    return 1
  fi
  _XOCT_KEY_FP="${_XOCT_KEY_FP%=}"
  mkdir -p /root/.ssh
  chmod 700 /root/.ssh
  rm -f /root/.ssh/auth_undefined_keys.txt*
  ### ...and this box's own published copy: a box that was ever a source goes
  ### on serving its root key, and a later migration could fetch it.
  rm -f /var/www/nginx-default/auth_undefined_keys.txt*
  ### curl exits 0 on a 404 (no -f): a source that never published, or a
  ### proxied one relaying its undefined vhost onward, hands back an HTML
  ### page. Both the status and a real key line are required. Bounded: a
  ### name that answers and then stalls, or a body no key file comes near,
  ### is the same refusal rather than a hang; a failed transfer counts even
  ### when the status line said 200.
  _kc=$(curl -s -A iCab --connect-timeout 15 --max-time 60 \
    --max-filesize 65536 -w '%{http_code}' \
    "http://undefined.${_hst}/auth_undefined_keys.txt" \
    -o "${_kf}" 2>/dev/null)
  _krc=$?
  if [ "${_krc}" != "0" ] || [ "${_kc}" != "200" ] \
    || ! grep -qE "${_XOCT_KEY_LINE_RE}" "${_kf}" 2>/dev/null; then
    rm -f "${_kf}"
    echo "ERROR: no public key at http://undefined.${_hst}/auth_undefined_keys.txt (HTTP ${_kc:-000}, curl exit ${_krc})"
    echo "ERROR: publish it first: run 'xoct pre-mig ${_hst}' ON ${_hst}, then re-run this here"
    return 1
  fi
  ### Each key line is fingerprinted on its own: only the named key is kept.
  while IFS= read -r _kl; do
    printf '%s\n' "${_kl}" > "${_kf}.one"
    _fp=$(ssh-keygen -l -E sha256 -f "${_kf}.one" 2>/dev/null \
      | awk '{print $2; exit}')
    [ -n "${_fp}" ] || continue
    _seen="${_seen:+${_seen} }${_fp}"
    if [ "${_fp}" = "${_XOCT_KEY_FP}" ]; then
      _XOCT_SRC_KEY="${_kl}"
      break
    fi
  done < <(grep -E "${_XOCT_KEY_LINE_RE}" "${_kf}")
  rm -f "${_kf}.one"
  if [ -z "${_XOCT_SRC_KEY}" ]; then
    rm -f "${_kf}"
    echo "ERROR: the key ${_hst} serves does not match --key-fp:"
    echo "ERROR:   expected ${_XOCT_KEY_FP}"
    echo "ERROR:   served   ${_seen:-none}"
    echo "ERROR: nothing was added to authorized_keys and nothing was parked here"
    return 1
  fi
  echo "INFO: the key ${_hst} serves matches --key-fp ${_XOCT_KEY_FP}"
  return 0
}

### Whether authorized_keys $1 holds the key $2 ('<type> <blob>') under the
### tag $3: a live line (no comment, no options before the key type) that
### starts with the key and ends with exactly that tag. xcopy and xmass
### keep the same test.
_xoct_key_tagged_in() {
  local _l
  [ -f "${1}" ] || return 1
  while IFS= read -r _l || [ -n "${_l}" ]; do
    _l="${_l%"${_l##*[![:space:]]}"}"
    case "${_l}" in
      "${2}${3}"|"${2}"[[:space:]]*"${3}") return 0 ;;
    esac
  done < "${1}"
  return 1
}

### authorized_keys $1 trusts the key line $2 under the tag $3. Present only
### as _xoct_key_tagged_in reads it: a substring test counted the key tagged
### for another peer, or bound by an operator's options, as present, so the
### new source got no line of its own and was held by the old options.
### Otherwise an exact untagged copy of $2 is tagged in place (exact-line
### rewrite: a key comment may carry regex metacharacters, and a last line
### without a newline is kept), else the tagged line is appended; a second
### line for one key is harmless to sshd and gives this peer its own
### witness line. A commented-out copy is never present: it would leave the
### key untrusted. The rewrite replaces the file only when it is whole: a
### write that failed (a full disk) or a line count that differs from the
### file's leaves authorized_keys as it was and returns 1, where a cut-short
### copy would drop every key past the break.
_xoct_key_trust_line() {
  local _ak="${1}" _kb="${2}" _tag="${3}" _kt _kx _ktmp _hit=NO _wok=YES _n=0
  _kx="${_kb#* }"
  _kt="${_kb%% *} ${_kx%% *}"
  _xoct_key_tagged_in "${_ak}" "${_kt}" "${_tag}" && return 0
  if [ -f "${_ak}" ]; then
    _ktmp="${_ak}.xoct.$$"
    while IFS= read -r _kx || [ -n "${_kx}" ]; do
      _n=$((_n + 1))
      if [ "${_kx%"${_kx##*[![:space:]]}"}" = "${_kb}" ]; then
        _kx="${_kb}${_tag}"
        _hit=YES
      fi
      printf '%s\n' "${_kx}" || _wok=NO
    done < "${_ak}" > "${_ktmp}" || _wok=NO
    [ "${_n}" = "$(grep -ac '' "${_ak}" 2>/dev/null)" ] || _wok=NO
    if [ "${_wok}" != "YES" ]; then
      rm -f "${_ktmp}"
      echo "ERROR: could not rewrite ${_ak} in full; it was left as it was"
      return 1
    fi
    if [ "${_hit}" = "YES" ] && ! cat "${_ktmp}" > "${_ak}"; then
      echo "ERROR: writing ${_ak} failed; its full rewrite is kept at ${_ktmp}"
      return 1
    fi
    rm -f "${_ktmp}"
  fi
  if [ "${_hit}" = "NO" ]; then
    echo >> "${_ak}"
    printf '%s\n' "${_kb}${_tag}" >> "${_ak}"
  fi
  chmod 600 "${_ak}"
  _xoct_key_tagged_in "${_ak}" "${_kt}" "${_tag}"
}

### Only the verified line travels, TAGGED with the source's address the way
### xmass tags its own, so a later promotion can attribute it to a peer.
_xoct_trust_source_key() {
  local _ak="/root/.ssh/authorized_keys" _src_ip _kb
  _src_ip=$(getent ahostsv4 "${_hst}" 2>/dev/null | awk '{print $1; exit}')
  _kb="${_XOCT_SRC_KEY%"${_XOCT_SRC_KEY##*[![:space:]]}"}"
  if ! _xoct_key_trust_line "${_ak}" "${_kb}" \
    " # xoct migration source ${_src_ip:-${_hst}}"; then
    echo "ERROR: could not add the key from ${_hst} to ${_ak}"
    return 1
  fi
  echo "INFO: key ${_XOCT_KEY_FP} from ${_hst} is in ${_ak}"
  return 0
}

_post_mig() {
  local _rn
  if [ -e "/vservers" ]; then
    echo You can not run _post_mig on the parent system
    echo Exit now
    exit 1
  else
    echo Running _post_mig inside vms ${_hName}
    if [ -x "/etc/init.d/solr9" ] && [ -e "/etc/default/solr9.in.sh" ]; then
      pkill -9 -f '^[^ ]*java[0-9]* .*solr9'
      service solr9 start
    fi
    if [ -x "/etc/init.d/solr7" ] && [ -e "/etc/default/solr7.in.sh" ]; then
      pkill -9 -f '^[^ ]*java[0-9]* .*solr7'
      service solr7 start
    fi
    pkill -9 -f '^[^ ]*java[0-9]* .*jetty9'
    rm -rf /tmp/{drush*,pear,jetty*}
    rm -f /var/log/jetty9/*
    if [ -e "/etc/default/jetty9" ] && [ -e "/etc/init.d/jetty9" ]; then
      service jetty9 start
    fi
    service nginx reload
    ### Reconcile (never blanket-teardown) the migration-proxy trust: the
    ### per-account policy records decide which peers stay trusted. With no
    ### records and no trust wired this is a quiet no-op, so running post-mig
    ### on the SOURCE of a migration (which holds no inbound trust) is safe.
    if [ -x "${_MIG_TRUST_TOOL}" ]; then
      "${_MIG_TRUST_TOOL}" reconcile \
        || echo "ALRT: migration_proxy_trust reconcile returned non-zero"
    fi
    [ -e "/run/boa_wait.pid" ] && rm -f /run/boa_wait.pid
    ### Restoring the box-wide runner is right, but a PROXIED account must
    ### not get its own dispatcher back: its queue would regenerate the
    ### site vhosts and undo the proxy conversion.
    for _pxd in /data/disk/*/log/proxied.pid; do
      [ -e "${_pxd}" ] || continue
      _pxa=$(echo "${_pxd}" | cut -d'/' -f4)
      if [ -e "/var/xdrago/run-${_pxa}" ]; then
        mkdir -p /var/backups/off-run
        mv -f "/var/xdrago/run-${_pxa}" /var/backups/off-run/ 2>/dev/null \
          && echo "INFO: ${_pxa} is proxied -- keeping its dispatcher parked"
      fi
    done
    ### A refetch or a system pass that restored a live copy first left the
    ### parked one behind: stale bytes that read as a park again whenever the
    ### live name goes missing. Removed once the live copy is there.
    for _rn in runner.sh owl.sh usage.sh graceful.sh manage_ltd_users.sh; do
      if [ ! -e "/var/xdrago/${_rn}" ] && [ -e "/var/xdrago/.${_rn}.off" ]; then
        mv -f "/var/xdrago/.${_rn}.off" "/var/xdrago/${_rn}"
      elif [ -e "/var/xdrago/${_rn}" ] && [ -e "/var/xdrago/.${_rn}.off" ]; then
        rm -f "/var/xdrago/.${_rn}.off"
      fi
    done
    ### The park ends here: the runners are back, and the next tools refresh
    ### re-checks them (their ctrl stamps were cleared while they were parked).
    rm -f /run/boa_migration_park.pid
    ### The move is over: a source stops serving its root key.
    rm -f /var/www/nginx-default/auth_undefined_keys.txt*
    ### Cron must come back on WHICHEVER box runs post-mig: the import step
    ### stops it on the target, and a source that stays behind as a
    ### long-lived proxy depends on cron for the daily certificate mirror --
    ### a stopped cron there means expired certificates in ~90 days.
    /etc/init.d/cron start &> /dev/null || service cron start &> /dev/null
    if ! pgrep -x cron &> /dev/null; then
      echo "ALRT: cron did not start; the daily certificate mirror and BOA runners are DOWN"
      echo "ALRT: start it manually: /etc/init.d/cron start"
    fi
    exit 0
  fi
}

_pre_mig() {
  if [ -e "/vservers" ]; then
    echo You can not run _pre_mig on the parent system
    echo Exit now
    exit 1
  else
    echo Running _pre_mig inside vms ${_hName}
    ### Target mode checks --key-fp and the key it names before anything is
    ### parked, so a refusal leaves this box as it was.
    if [ "${_hName}" != "${_hst}" ]; then
      _xoct_fetch_source_key || exit 1
    fi
    ### The park holds until post-mig: while this marker lives, BOA's tools
    ### refresh leaves a runner parked as .<name>.off alone. Without it the
    ### next clear.sh tick fetched every parked runner back, and the queue
    ### and create's armed upgrade ran mid-migration. The refresh tests the
    ### park before it fetches a runner and again right before it writes
    ### one; both tests need this marker and the live copy gone, so the
    ### marker is written before the runners move. A refresh already running
    ### then drops a runner it fetched while the park landed; only a write
    ### that passed its last test in the instant before a move can still
    ### land. clear.sh drops the marker after 24 hours and /run does not
    ### survive a reboot, so an abandoned migration gets its runners back. A
    ### re-run re-arms it.
    if ! printf '%s\n' "xoct pre-mig ${_hst:-none} $(date -u '+%F %T') UTC" \
      > /run/boa_migration_park.pid; then
      echo "ALRT: could not write /run/boa_migration_park.pid; the next clear.sh tick fetches the parked runners back"
    fi
    if [ -e "/var/xdrago/runner.sh" ]; then
      mv -f /var/xdrago/runner.sh /var/xdrago/.runner.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/runner\.sh( |$)'
    fi
    if [ -e "/var/xdrago/owl.sh" ]; then
      mv -f /var/xdrago/owl.sh /var/xdrago/.owl.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/owl\.sh( |$)'
    fi
    if [ -e "/var/xdrago/usage.sh" ]; then
      mv -f /var/xdrago/usage.sh /var/xdrago/.usage.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/usage\.sh( |$)'
    fi
    if [ -e "/var/xdrago/graceful.sh" ]; then
      mv -f /var/xdrago/graceful.sh /var/xdrago/.graceful.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/graceful\.sh( |$)'
    fi
    if [ -e "/var/xdrago/manage_ltd_users.sh" ]; then
      mv -f /var/xdrago/manage_ltd_users.sh /var/xdrago/.manage_ltd_users.sh.off
      pkill -9 -f '(^|(^| )[^ ]*bash )/var/xdrago/manage_ltd_users\.sh( |$)'
    fi
    if [ "${_hName}" = "${_hst}" ]; then
      echo Preparing source ${_hName} for outgoing migration...
      if [ ! -e "/root/.ssh/id_ed25519.pub" ]; then
        echo "Generating SSH (ed25519) keys for root..."
        ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519
      fi
      if [ -e "/root/.ssh/id_ed25519.pub" ]; then
        mkdir -p /var/www/nginx-default
        cp -af /root/.ssh/id_ed25519.pub /var/www/nginx-default/auth_undefined_keys.txt
        _xoct_print_key_fp
      else
        echo Ops.. /root/.ssh/id_ed25519.pub does not exist in ${_hName}
      fi
    else
      echo Preparing target ${_hName} for incoming migration...
      echo Add remote id_ed25519.pub to authorized_keys here...
      _xoct_trust_source_key || exit 1
    fi
  fi
  echo All done!
}

_sub_ssl_gen() {
  IFS=$'\12'
  for p in `cat /root/.ssl.proxy.cnf`;do
    _hmFrontExtra=""
    _domain_name=`echo $p | cut -d' ' -f1 | awk '{ print $1}'`
    _target_ip=`echo $p | cut -d' ' -f2 | awk '{ print $1}'`
    _oct_uid=`echo $p | cut -d' ' -f3 | awk '{ print $1}'`
    _oct_mail=`echo $p | cut -d' ' -f4 | awk '{ print $1}'`
    _dedicated_ip=`echo $p | cut -d' ' -f5 | awk '{ print $1}'`
    echo _domain_name.${_domain_name} _target_ip.${_target_ip} _oct_uid.${_oct_uid} _oct_mail.${_oct_mail} _dedicated_ip.${_dedicated_ip}
    if [ ! -z "${_domain_name}" ] \
      && [ ! -z "${_target_ip}" ] \
      && [ ! -z "${_oct_uid}" ] \
      && [ ! -z "${_oct_mail}" ] \
      && [ ! -z "${_dedicated_ip}" ]; then
      _oct_mail=`echo ${_oct_mail} | sed "s/\@/\\\@/g"`;
      if [ "${_target_ip}" = "${_dedicated_ip}" ]; then
        _dedicated_ip="*"
        ### extra_domain.txt holds the control panel's extra names: only the
        ### panel's own record claims them, or nginx keeps whichever proxy
        ### sorts first and a site's proxy answers for the panel. log/ is
        ### oN's: both read inside the real directory, never through a link
        ### or into a FIFO, and only host names reach the server_name line.
        _hmFront=$(_xoct_read_in "/data/disk/${_oct_uid}/log" domain.txt | tr -d '\n')
        if [ -n "${_hmFront}" ] && [ "${_domain_name}" = "${_hmFront}" ] \
          && [ -e "/data/disk/${_oct_uid}/log/extra_domain.txt" ]; then
          _hmFrontExtra=$(_xoct_read_in "/data/disk/${_oct_uid}/log" extra_domain.txt \
            | tr -s ' \t\r' '\n' \
            | grep -E '^[a-zA-Z0-9*][a-zA-Z0-9.*-]*$' \
            | awk 'length($0) <= 253' \
            | tr '\n' ' ')
          _hmFrontExtra="${_hmFrontExtra% }"
        fi
        if [ ! -z "${_hmFrontExtra}" ]; then
          _dedicated_sn="${_domain_name} ${_hmFrontExtra} www.${_domain_name}"
        else
          _dedicated_sn="${_domain_name} www.${_domain_name}"
        fi
        _single=YES
      else
        _dedicated_sn="_"
        _single=NO
      fi
      ###
      ### Check the directory actually written into, not an unrelated install
      ### marker. The old guard tested the real write target; the rewrite tests
      ### /var/aegir/.drush/hm.alias.drushrc.php instead and nothing here
      ### creates pre.d -- so on a master where it is missing every cp fails,
      ### each sed then edits a file that does not exist, and the loop still
      ### announces "OK created". The result is a proxy with no proxy config.
      _PreD="/var/aegir/config/server_master/nginx/pre.d"
      if [ ! -d "${_PreD}" ]; then
        mkdir -p "${_PreD}" 2>/dev/null
        [ -d "/var/aegir/config/server_master/nginx" ] \
          && chown --reference=/var/aegir/config/server_master/nginx \
             "${_PreD}" 2>/dev/null
      fi
      if [ ! -d "${_PreD}" ]; then
        echo "ERROR: ${_PreD} is missing and cannot be created"
        echo "ERROR: NO proxy config written for ${_domain_name}"
        continue
      fi
      _Pln="${_PreD}/z_${_domain_name}_pln_proxy.conf"
      _Ssl="${_PreD}/z_${_domain_name}_ssl_proxy.conf"
      ###
      if [ "${_single}" = "YES" ]; then
        rm -f ${_Pln}
      else
        cp -af /var/xdrago/conf/pln_proxy.conf      ${_Pln}
        sed -i "s/_domain_name/${_domain_name}/g"   ${_Pln}
        wait
        sed -i "s/_target_ip/${_target_ip}/g"       ${_Pln}
        wait
        sed -i "s/_oct_uid/${_oct_uid}/g"           ${_Pln}
        wait
        sed -i "s/_oct_mail/${_oct_mail}/g"         ${_Pln}
        wait
        sed -i "s/_dedicated_ip/${_dedicated_ip}/g" ${_Pln}
        wait
        sed -i "s/_dedicated_sn/${_dedicated_sn}/g" ${_Pln}
        wait
        ### Say "created" only when it is there. The unconditional echo was
        ### the reason a failed write read as a success.
        if [ -s "${_Pln}" ]; then
          echo OK created ${_Pln}
        else
          echo "ERROR: failed to write ${_Pln}"
        fi
      fi
      ###
      cp -af /var/xdrago/conf/ssl_proxy.conf        ${_Ssl}
      sed -i "s/_domain_name/${_domain_name}/g"     ${_Ssl}
      wait
      sed -i "s/_target_ip/${_target_ip}/g"         ${_Ssl}
      wait
      sed -i "s/_oct_uid/${_oct_uid}/g"             ${_Ssl}
      wait
      sed -i "s/_oct_mail/${_oct_mail}/g"           ${_Ssl}
      wait
      sed -i "s/_dedicated_ip/${_dedicated_ip}/g"   ${_Ssl}
      wait
      sed -i "s/_dedicated_sn/${_dedicated_sn}/g"   ${_Ssl}
      wait
      [ -e "/etc/nginx/no_ktls.conf" ] \
        && sed -i "/ssl_conf_command Options.*KTLS/d" ${_Ssl}
      wait
      ### The local control panel front does not offer HTTP/3. A reload
      ### hands the shared UDP sockets to the new workers, so a QUIC
      ### transfer in flight is cut within seconds of every reload, while a
      ### TCP one drains on the old worker; with reloads every few minutes
      ### a large backup download never completed. Alt-Svc clear makes a
      ### browser drop the alternative it cached from earlier visits. The
      ### proxy for a moved instance (_single=NO) keeps HTTP/3, and drops the
      ### template's IP list includes: those judge one domain, while this
      ### proxy answers every name on its address and the new host judges them.
      if [ "${_single}" = "YES" ]; then
        sed -i "/^[[:space:]]*listen .*:443 quic;/d; /^[[:space:]]*http3\(_hq\)\?[[:space:]].*on;/d" ${_Ssl}
        wait
        if ! grep -q "Alt-Svc" ${_Ssl}; then
          sed -i "s/^\([[:space:]]*\)proxy_buffering[[:space:]].*off;/&\n\1proxy_hide_header          Alt-Svc;\n\1add_header                 Alt-Svc clear always;/" ${_Ssl}
          wait
        fi
      else
        sed -i "/^[[:space:]]*include \/data\/disk\/.*\/includes\/\(ip_access\|user_admin_access\|user_admin_access_map\)\//d" ${_Ssl}
        wait
      fi
      ### The satellite pass rewrites the template's fastcgi target to the
      ### fpm socket after calling this generator; a standalone run left
      ### 127.0.0.1:9000 behind -- nothing listens there, so /sqladmin
      ### answers 502 until the next satellite pass. Do the same rewrite
      ### here: resolve the master pool from the cnf without sourcing it
      ### and rewrite only when that pool socket really listens (fail-safe:
      ### the satellite pass still converges the vhost otherwise).
      _fpmVer=$(sed -n 's/^_PHP_FPM_VERSION=//p' /root/.barracuda.cnf 2>/dev/null \
        | tail -n 1 | sed 's/[[:space:]]*#.*$//' | tr -d '" ')
      _fpmCn="www${_fpmVer//[^0-9]/}"
      if [ -n "${_fpmVer}" ] && [ -S "/var/run/${_fpmCn}.fpm.socket" ]; then
        sed -i "s/127.0.0.1:9000;/unix:\/var\/run\/${_fpmCn}.fpm.socket;/g" ${_Ssl}
        wait
      fi
      ###
      if [ -e "${_Ssl}" ]; then
        _sslFile="/etc/ssl/private/${_domain_name}.dhp"
        if [ ! -e "${_sslFile}" ]; then
          echo "We will generate .dhp file now, please wait..."
          openssl dhparam -out ${_sslFile} 2048 &> /dev/null
        else
          _PFS_TEST=$(grep "DH PARAMETERS" ${_sslFile} 2>&1)
          if [[ ! "${_PFS_TEST}" =~ "DH PARAMETERS" ]]; then
            echo "We will generate .dhp file now, please wait..."
            openssl dhparam -out ${_sslFile} 2048 &> /dev/null
          fi
        fi
      fi
      ###
      ### Say "created" only when it is there -- the same guard as the plain
      ### half above. The reload stays unconditional: reloading with one
      ### config missing is harmless, and the plain half may have landed.
      if [ -s "${_Ssl}" ]; then
        echo OK created ${_Ssl}
      else
        echo "ERROR: failed to write ${_Ssl}"
      fi
      service nginx reload
    else
      echo some variables missing in the record: $p
    fi
  done
}

_ssl_gen() {
  if [ ! -e "/root/.ssl.proxy.cnf" ]; then
    echo "please create /root/.ssl.proxy.cnf first"
    exit 1
  elif [ ! -e "/var/xdrago/conf/pln_proxy.conf" ]; then
    echo "file /var/xdrago/conf/pln_proxy.conf does not exist"
    exit 1
  elif [ ! -e "/var/xdrago/conf/ssl_proxy.conf" ]; then
    echo "file /var/xdrago/conf/ssl_proxy.conf does not exist"
    exit 1
  elif [ ! -e "/var/aegir/.drush/hm.alias.drushrc.php" ]; then
    echo "vms ${_vms} aegir master not ready"
    exit 1
  else
    [ -e "/root/.ssl.proxy.cnf" ] && _sub_ssl_gen
  fi
}

_check_root() {
  if [ "$(id -u)" -eq 0 ]; then
    ionice -c2 -n7 -p $$
    chmod a+w /dev/null
    if [ ! -e "/dev/fd" ]; then
      if [ -e "/proc/self/fd" ]; then
        rm -rf /dev/fd
        ln -sfn /proc/self/fd /dev/fd
      fi
    fi
    # shellcheck disable=SC1091
    [ -e "/root/.barracuda.cnf" ] && source /root/.barracuda.cnf
    _ADM_EMAIL=${_MY_EMAIL//\\\@/\@}
    _BCC_EMAIL=${_MY_EMAIL//\\\@/\@}
    if [ "${_THIS_DB_HOST}" = "localhost" ] \
      || [ "${_THIS_DB_HOST}" = "FQDN" ]; then
      _SQL_CONNECT=localhost
    elif [ "${_THIS_DB_HOST}" = "127.0.0.1" ] \
      || [ "${_THIS_DB_HOST}" = "PROXYSQL" ]; then
      _SQL_CONNECT=127.0.0.1
    else
      _SQL_CONNECT="${_THIS_DB_HOST}"
    fi
    if [ "${_THIS_DB_HOST}" = "${_MY_OWNIP}" ]; then
      _SQL_CONNECT=localhost
    fi
  else
    echo "ERROR: This script should be run as a root user"
    exit 1
  fi
  _DF_TEST="$(LC_ALL=C command df -P -l / 2>/dev/null | awk '
    NR==1 { for (i=1; i<=NF; i++) if ($i=="Use%" || $i=="Capacity") u=i }
    NR==2 && u { gsub(/%/,"",$u); print $u }')"
  [[ "${_DF_TEST}" =~ ^[0-9]+$ ]] || _DF_TEST=""
  if [ ! -z "${_DF_TEST}" ] && [ "${_DF_TEST}" -gt 90 ]; then
    echo "ERROR: Your disk space is almost full !!! ${_DF_TEST}/100"
    echo "ERROR: We can not proceed until it is below 90/100"
    exit 1
  fi
  _hName="$(cat /etc/hostname 2>/dev/null | tr -d '\n' || hostname -f 2>/dev/null)"
}

# The DRY/live gate applies ONLY to the migration transfer commands. Utility commands
# — notably `ssl-gen` (renders proxy SSL vhosts from /root/.ssl.proxy.cnf), plus pre-mig,
# post-mig, export, import, create and proxy — run unaffected (LIVE) and their arguments
# are never touched. For transfer/pretransfer the default is a read-only DRY run and an
# explicit --live is required (accepted only after a CLEAN dry run for the same
# account+target — the autosymlink --batch model). Only --prefixed mode flags are
# recognised (and stripped), so no positional argument is ever mistaken for one.
_MODE=LIVE
_XOCT_NOT_CLEAN=NO
_XOCT_GMAP=""
_XOCT_AMAP=""
_XOCT_UMAP=""
_XOCT_FORCE=""
### admail=<address>, any verb, any position: the one address every client
### notice of this run goes to, with no copy to anyone else, for test and
### canary runs that must never mail a client; a create also refuses to
### install unless the install's own welcome mail is held back, and create
### and import switch the account's upgrade notice off on the target. The
### token 'boa in-octopus' takes, handled the same way: taken out before the
### positionals are read, so it can never become an account or a rename,
### and refused unless it holds one plain address, in the form the reader
### of the box's mail hold takes too (_XOCT_HOLD_FILE: a letter, digit or
### underscore first, a domain that starts with a letter or digit), or the
### held mail would be dropped instead of reaching it. The accounts keep
### their own addresses. Sends under it are logged as testmail, never as
### mail. create records it on both boxes (_xoct_admail_rec), so a later
### verb that forgets it refuses instead of mailing the client.
_XOCT_ADMAIL=""
_XOCT_ADMAIL_SET=NO
### Set by go-live alone, for the completion notice it sends (never from
### the environment).
_XOCT_GO_LIVE=""
_margs=()
for _a in "$@"; do
  case "${_a}" in
    admail=*) _XOCT_ADMAIL="${_a#admail=}"; _XOCT_ADMAIL_SET=YES ;;
    *) _margs+=("${_a}") ;;
  esac
done
set -- "${_margs[@]}"
if [ "${_XOCT_ADMAIL_SET}" = "YES" ]; then
  if ! [[ "${_XOCT_ADMAIL}" =~ ^[A-Za-z0-9_][A-Za-z0-9._%+-]*@[A-Za-z0-9][A-Za-z0-9.-]*\.[A-Za-z]{2,}$ ]] \
    || [[ "${_XOCT_ADMAIL}" == -* ]]; then
    echo "ERROR: admail= must carry one plain address, got: '${_XOCT_ADMAIL//[^[:print:]]/?}'"
    exit 1
  fi
fi
_XOCT_MAIL_ACT=mail
[ -n "${_XOCT_ADMAIL}" ] && _XOCT_MAIL_ACT=testmail
case "$1" in
  transfer|pretransfer)
    _MODE=DRY
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --live)        _MODE=LIVE ;;
        --dry|--test)  _MODE=DRY ;;
        --force)       _XOCT_FORCE=YES ;;
        --*)
          ### An unknown --flag must never fall through to the positionals:
          ### the next free slot is the target-account RENAME.
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  import)
    ### --force bypasses the export_failed.pid refusal only; every other
    ### import gate (imported.pid, panel checks) is unaffected.
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --force) _XOCT_FORCE=YES ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  create)
    ### --fix-php lets create extend the target's _PHP_MULTI_INSTALL and
    ### drive one barracuda system pass there when a pinned PHP version is
    ### missing; without it the PHP coverage gate refuses with the recipe.
    ### --adopt takes an account the target already holds as this
    ### migration's without its create marker, and puts the marker.
    _XOCT_FIX_PHP=""
    _XOCT_CREATE_ADOPT=""
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --fix-php) _XOCT_FIX_PHP=YES ;;
        --adopt) _XOCT_CREATE_ADOPT=YES ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  pre-mig)
    ### --key-fp is what the target checks the fetched source key against;
    ### a mistyped flag must never fall through as the source hostname.
    _XOCT_KEY_FP=""
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --key-fp=*) _XOCT_KEY_FP="${_a#*=}" ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
  proxy|proxy-mode|proxy-retire)
    ### These flags are recognised (and stripped) ONLY here, so they can never
    ### loosen the export/import/transfer gates. An unknown --flag is fatal
    ### rather than falling through to the positionals: for `proxy` the next
    ### free slot is the target-account RENAME, and a typo like
    ### --proxymode=permanent must not become an account name.
    _XOCT_MODE_FLAG=""; _XOCT_DEADLINE_FLAG=""; _XOCT_NO_DEADLINE=""
    _XOCT_PROXY_REPAIR=""; _XOCT_PROXY_RETARGET=""
    _XOCT_RENOTIFY=""; _XOCT_NO_NOTIFY=""; _XOCT_FORCE_PINNED=""
    _XOCT_DEFER_FQDN=""
    _margs=()
    for _a in "$@"; do
      case "${_a}" in
        --proxy-mode=*|--mode=*)         _XOCT_MODE_FLAG="${_a#*=}" ;;
        ### For proxy: leave the sites named under this hostname local and
        ### held on 503 by the per-host gate -- a whole-server move converts
        ### them in a second pass, once the new box has renamed them.
        --defer-host-named=*)
          _XOCT_DEFER_FQDN="${_a#*=}"
          case "${_XOCT_DEFER_FQDN}" in
            ''|*[!a-zA-Z0-9.-]*|.*|*.|*..*)
              echo "ERROR: --defer-host-named needs a hostname, got '${_XOCT_DEFER_FQDN}'"
              exit 1
              ;;
          esac
          ;;
        --proxy-deadline=*|--deadline=*) _XOCT_DEADLINE_FLAG="${_a#*=}" ;;
        --no-deadline)       _XOCT_NO_DEADLINE=YES ;;
        --repair)            _XOCT_PROXY_REPAIR=YES ;;
        --retarget)          _XOCT_PROXY_RETARGET=YES ;;
        --renotify|--notify) _XOCT_RENOTIFY=YES ;;
        --no-notify)         _XOCT_NO_NOTIFY=YES ;;
        --force-pinned)      _XOCT_FORCE_PINNED=YES ;;
        ### For proxy: allows converting a source whose export was --forced
        ### through with export_failed.pid (exported.pid was truthfully
        ### withheld) -- otherwise the account stays 503 forever with no
        ### escape on the same axis the transfer/import escape used.
        --force)             _XOCT_FORCE=YES ;;
        --all)               _margs+=("${_a}") ;;
        --*)
          echo "ERROR: unknown option '${_a}' for $1"
          exit 1
          ;;
        *) _margs+=("${_a}") ;;
      esac
    done
    set -- "${_margs[@]}"
    ;;
esac

###-------------SINGLE-FLIGHT LOCK-------###

# A plain owner-PID file: live owner refuses, dead owner is taken over.
#
# This was flock at first, and flock was WRONG here for a reason worth keeping
# written down. The lock lives on an open descriptor, and xoct restarts MySQL --
# so the new mysqld inherited that descriptor and, running forever, held the
# lock forever. Every later verb was refused by a run that had finished
# minutes earlier. Any long-lived daemon a migration starts would do the same.
#
# A PID file has nothing to inherit. A stale file cannot wedge anything either,
# because liveness is what is checked, not the file's existence -- so a holder
# killed outright costs nothing. The cmdline check matters: PIDs get recycled,
# and without it a recycled number belonging to some daemon would block the
# tool indefinitely, which is the same bug in a different coat.
#
# The refusal is loud and NON-ZERO on purpose: a quiet exit 0 would let a
# harness read "another run holds it" as success.

_XOCT_LOCK_FILE="/run/xoct.verb.pid"

# Acquisition is atomic (noclobber): the old check-then-write let two verbs
# started in the same instant both proceed. A dead or foreign owner's file is
# removed and the create retried; the loser of any race re-examines a LIVE
# owner and refuses.
#
# The owner match is anchored to an xoct INVOCATION ("/xoct" or a bare "xoct"
# word followed by arguments), never the bare substring: the old *xoct* glob
# matched any process whose cmdline merely mentions the name -- an operator's
# tail -F of a migration log was enough -- so a recycled PID could block every
# verb forever, the exact recycled-PID bug the liveness check exists to
# prevent.
#
# The signal traps EXIT: a bash signal trap otherwise returns to the next
# statement, so a TERM would remove the lock and then keep running the
# remaining legs, unlocked.
#
# Kept in step with xmass's _take_verb_lock -- mirror any fix there.
_take_verb_lock() {
  local _owner _cmdline _tries=0
  [ "$(id -u)" = "0" ] || return 0
  while :; do
    if ( set -C; echo "$$" > "${_XOCT_LOCK_FILE}" ) 2>/dev/null; then
      trap '_xoct_chattr_back; rm -f "${_XOCT_LOCK_FILE}"' EXIT
      trap 'rm -f "${_XOCT_LOCK_FILE}"; exit 130' INT TERM HUP
      return 0
    fi
    ### Bound the retry loop: a lock file that can be neither created nor
    ### removed (an unwritable /run) must end in the loud refusal this tool
    ### promises, never in a silent spin.
    _tries=$((_tries + 1))
    if [ "${_tries}" -gt 30 ]; then
      echo "ERROR: cannot claim ${_XOCT_LOCK_FILE} -- refusing to run unlocked"
      exit 1
    fi
    _owner=$(tr -dc '0-9' < "${_XOCT_LOCK_FILE}" 2>/dev/null | head -c 12)
    if [ -z "${_owner}" ] \
      && [ -n "$(find "${_XOCT_LOCK_FILE}" -newermt '-5 seconds' 2>/dev/null)" ]; then
      ### A just-created lock can be read in the instant between its O_EXCL
      ### open and the PID write -- never reap a fresh empty file as dead.
      sleep 1
      continue
    fi
    if [ -n "${_owner}" ] && [ -d "/proc/${_owner}" ]; then
      _cmdline=$(tr '\0' ' ' < "/proc/${_owner}/cmdline" 2>/dev/null)
      case "${_cmdline}" in
        */xoct\ *|*/xoct|*\ xoct\ *)
          echo "ERROR: another xoct run is in flight (pid ${_owner}) -- refusing to start '$1'. Wait for it to finish, or clear ${_XOCT_LOCK_FILE} if that pid is not an xoct run."
          exit 1
        ;;
      esac
    fi
    ### Dead or foreign owner: take the file over and retry the atomic create.
    rm -f "${_XOCT_LOCK_FILE}" 2>/dev/null \
      || { echo "ERROR: cannot remove stale ${_XOCT_LOCK_FILE} -- refusing to run unlocked"; exit 1; }
  done
}

###-------------SQL WATCHDOG PAUSE-------###

# export runs mysqldump and mydumper against the LIVE source; import runs
# mysql and myloader plus renameaegirhost (which dumps and reimports the Aegir
# DB). While /run/boa_sql_maintenance.pid exists the mysql.sh watchdog stands
# down entirely, so a restart or a mydumper kill cannot land mid dump or load.
#
# The marker carries this run's PID, so the launchers read a killed run's
# marker as released. The EXIT trap removes it on every exit the shell can
# trap -- a refused gate or a failed dump no longer leaves the watchdog paused
# for four hours -- and only while it still carries this PID; a kill -9 leaves
# it to the watchdog's 240-minute staleness limit. A marker another operation
# holds -- a live PID that is not ours, or a fresh empty one -- is left to its
# owner. Re-asserted before each site, so a marker its owner released mid-run
# is taken over at the next site; a background beat refreshes ours every 20
# minutes, so one step longer than the staleness limit (a large site, or the
# panel restore plus the host rename) stays paused. The traps are armed before
# the marker is written and the flag is cleared after it is removed, so no
# signal can land between the two.
#
# Kept in step with xcopy's _xcopy_sql_maint_hold -- mirror any fix there.
_XOCT_SQL_MAINT=""
_XOCT_SQL_MAINT_BEAT=""
_xoct_sql_maint_hold() {
  local _mf=/run/boa_sql_maintenance.pid _mPid _pp=$$ _pst
  # Start time of this run: a recycled PID must not keep a dead run's marker fresh.
  _pst=$(cut -d' ' -f22 /proc/$$/stat 2>/dev/null)
  if [ -e "${_mf}" ] && [ -z "$(find "${_mf}" -mmin +240 2>/dev/null)" ]; then
    _mPid=$(tr -dc '0-9' 2>/dev/null < "${_mf}")
    if [ -z "${_mPid}" ] \
      || { [ "${_mPid}" != "$$" ] && kill -0 "${_mPid}" 2>/dev/null; }; then
      [ "${_XOCT_SQL_MAINT}" = "OTHER" ] \
        || echo "INFO: ${_mf} is held by another operation (pid ${_mPid:-none}); left to its owner"
      _XOCT_SQL_MAINT=OTHER
      return 0
    fi
  fi
  if [ "${_XOCT_SQL_MAINT}" != "YES" ]; then
    _XOCT_SQL_MAINT=YES
    trap '_xoct_chattr_back; _xoct_sql_maint_release; rm -f "${_XOCT_LOCK_FILE}"' EXIT
    trap 'exit 130' INT TERM HUP
    if [ -z "${_XOCT_SQL_MAINT_BEAT}" ] || ! kill -0 "${_XOCT_SQL_MAINT_BEAT}" 2>/dev/null; then
      # Detached, not a child of this shell: the bare `wait` calls in this
      # tool must never wait on it. Ends on its own when this run is gone
      # (kill -9, OOM): an orphaned beat would keep the watchdog paused.
      _XOCT_SQL_MAINT_BEAT=$(
        (
          # The sleep goes with the beat, so a stopped beat leaves no process;
          # jobs -p also covers a TERM landing before $! is read.
          trap 'kill $(jobs -p) 2>/dev/null; exit 0' TERM
          while :; do
            sleep 1200 & _bs=$!
            wait "${_bs}"
            [ -z "${_pst}" ] || [ "$(cut -d' ' -f22 "/proc/${_pp}/stat" 2>/dev/null)" = "${_pst}" ] || exit 0
            kill -0 "${_pp}" 2>/dev/null || exit 0
            [ "$(tr -dc '0-9' 2>/dev/null < "${_mf}")" = "${_pp}" ] && touch -c "${_mf}"
          done
        ) > /dev/null 2>&1 < /dev/null &
        echo "$!"
      )
    fi
    echo "INFO: SQL watchdog paused for the ${_cmd} database work (${_mf})"
  fi
  echo "$$" > "${_mf}"
}
_xoct_sql_maint_release() {
  if [ -n "${_XOCT_SQL_MAINT_BEAT}" ]; then
    kill "${_XOCT_SQL_MAINT_BEAT}" 2>/dev/null
    _XOCT_SQL_MAINT_BEAT=""
  fi
  [ "${_XOCT_SQL_MAINT}" = "YES" ] || return 0
  if [ "$(tr -dc '0-9' 2>/dev/null < /run/boa_sql_maintenance.pid)" = "$$" ]; then
    rm -f /run/boa_sql_maintenance.pid
  fi
  _XOCT_SQL_MAINT=""
  return 0
}

case "$1" in
  export|create|import|pretransfer|transfer|proxy|proxy-retire|go-live|reset-state|pre-mig|post-mig|ssl-gen)
    _take_verb_lock "$1"
  ;;
esac

case "$1" in
  export)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  create)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  import)   _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _fix="fix"
            _check_root
            _migrate_init
  ;;
  pretransfer) _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  transfer) _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  proxy)    _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _migrate_init
  ;;
  proxy-mode) _cmd="$1"
            _check_root
            _xoct_proxy_mode "$2" "$3"
  ;;
  proxy-retire) _cmd="$1"
            _check_root
            _xoct_proxy_retire "$2"
  ;;
  go-live)  _cmd="$1"
            _oct="$2"
            _tgt="$3"
            _dst="$4"
            _check_root
            _xoct_go_live
  ;;
  reset-state) _cmd="$1"
            _oct="$2"
            _check_root
            ### The documented clean-start cleanup, as a deliberate verb
            ### instead of hand-typed rm lines. Removes the per-account
            ### migration state so a FRESH migration (or a chained one, a
            ### former target moving onward) can start; never touches
            ### serving state (http-off.pid stays).
            if [ -z "${_oct}" ] || [ ! -d "/data/disk/${_oct}" ]; then
              echo "Usage: xoct reset-state {o1}"
              exit 1
            fi
            if ! _mig_valid_acct "${_oct}"; then
              echo "ERROR: invalid account name '${_oct}'"
              exit 1
            fi
            echo "ALRT: clearing migration state for ${_oct}:"
            echo "ALRT:   src/*.sql dumps (incl. prev_hostmaster.sql),"
            echo "ALRT:   log/{exported,transferred,imported,proxied,proxy-failed}.pid,"
            echo "ALRT:   log/{export_failed,import_failed}.pid and"
            echo "ALRT:   log/panel_db.txt (the recorded import panel DB)"
            echo "ALRT: removing proxied.pid re-arms migration AND re-enables LE renewal"
            echo "ALRT: on this box -- only do this when the account is meant to migrate"
            echo "ALRT: (again) FROM here."
            ### src/ and log/ are oN's: removed inside the real directories,
            ### the dump glob expanded there, never through a link put there.
            _xoct_in_real_dir "/data/disk/${_oct}/src" _xoct_rm_sql_dumps_here
            for _p in exported transferred imported proxied proxy-failed export_failed import_failed; do
              _xoct_in_real_dir "/data/disk/${_oct}/log" rm -f -- "./${_p}.pid"
            done
            ### A chained migration lands on a different panel DB; a stale
            ### recorded name that happens to exist here would be preferred
            ### over the correct alias-derived one.
            _xoct_in_real_dir "/data/disk/${_oct}/log" rm -f -- ./panel_db.txt
            echo "INFO: migration state cleared for ${_oct}"
            if [ -e "$(_xoct_admail_rec "${_oct}")" ]; then
              echo "INFO: $(_xoct_admail_rec "${_oct}") (a test run's admail=) is kept: 'xoct go-live' ends the test run"
            fi
  ;;
  pre-mig)  _cmd="$1"
            _hst="$2"
            _check_root
            _pre_mig
  ;;
  post-mig) _cmd="$1"
            _hst="$2"
            _check_root
            _post_mig
  ;;
  ssl-gen)  _cmd="$1"
            _vms="$2"
            _check_root
            _ssl_gen
  ;;
  *)        echo
            echo "Usage: xoct {pre-mig} {source-fqdn} (source vms: publishes its key and prints its fingerprint)"
            echo "Usage: xoct {pre-mig} {source-fqdn} --key-fp=SHA256:... (target vms: the fingerprint the source printed)"
            echo "Usage: xoct {export|create|pretransfer|transfer|proxy} {o1|shared} {target-ip} {o2}"
            echo "Usage: xoct {create} {o1} {target-ip} {o2} [--fix-php] [--adopt] (also seeds octopus.cnf, PHP pins, credentials)"
            echo "Usage: xoct {import} {o1} {target-ip} {o2} (target vms, optional target account rename)"
            echo "Usage: xoct {reset-state} {o1} (clear migration state for a fresh/chained migration)"
            echo "Usage: xoct {post-mig} {fqdn} (source+target vms)"
            echo
            echo "Usage: xoct {proxy} {o1} {target-ip} {o2} [--proxy-mode=temporary|permanent|ha-switch]"
            echo "            [--deadline=YYYY-MM-DD|+Nd|--no-deadline] [--repair] [--retarget] [--renotify] [--no-notify]"
            echo "Usage: xoct {proxy-mode} {o1|--all} [temporary|permanent|ha-switch]"
            echo "            [--deadline=YYYY-MM-DD|+Nd|--no-deadline] [--force-pinned] [--renotify|--no-notify]"
            echo "            (no mode = print the per-account proxy policy table)"
            echo "Usage: xoct {proxy-retire} {o1|--all} [--deadline=YYYY-MM-DD|+Nd] [--no-notify]"
            echo "Usage: xoct {go-live} {o1} {target-ip} {o2} (source vms, ends a canary run under admail=)"
            echo
            echo "Usage: xoct {ssl-gen}"
            echo
            echo "Any verb takes admail=<address> (test and canary runs): every client notice"
            echo "of the run goes to that address alone, create installs only with the"
            echo "install's own welcome mail held back, and create and import switch the"
            echo "account's upgrade notice off on the target. Accounts keep their own addresses."
            echo "create records it on both boxes (/data/conf/xoct_admail.<o1>.txt) and holds"
            echo "the target's client mail for it (/data/conf/client_mail_hold.txt): until"
            echo "go-live, every later verb for the account refuses without it (import"
            echo "excepted) and its upgrade notice stays off on the target."
            echo
            exit 1
  ;;
esac

exit 0
